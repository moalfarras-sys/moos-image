<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MoRemotePersonal</AssemblyName>
    <RootNamespace>MoRemote</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- The fallback needs only PNG/JPEG raster conversion, not ImageSharp's
         TIFF/normalization paths. Pinned MIT Skia includes both Linux RIDs. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../agent/Core/Logging.cs" Link="Core/Logging.cs" />
    <Compile Include="../agent/Core/AccessTicketStore.cs" Link="Core/AccessTicketStore.cs" />
    <Compile Include="../agent/Core/UploadSessionStore.cs" Link="Core/UploadSessionStore.cs" />
    <Compile Include="../agent/Core/FileService.cs" Link="Core/FileService.cs" />
    <Compile Include="../agent/Core/InputSequenceGuard.cs" Link="Core/InputSequenceGuard.cs" />
    <Compile Include="../agent/Core/H264RecoveryQueue.cs" Link="Core/H264RecoveryQueue.cs" />
    <Compile Include="../agent/Core/HostBudget.cs" Link="Core/HostBudget.cs" />
    <Compile Include="../agent/Core/NetworkGuard.cs" Link="Core/NetworkGuard.cs" />
    <Compile Include="../agent/Core/SessionStreamLease.cs" Link="Core/SessionStreamLease.cs" />
    <Compile Include="../agent/Core/Security.cs" Link="Core/Security.cs" />
    <Compile Include="../agent/Core/SessionState.cs" Link="Core/SessionState.cs" />
    <Compile Include="../agent/Core/TlsManager.cs" Link="Core/TlsManager.cs" />
    <Compile Include="../agent/Core/UserSettings.cs" Link="Core/UserSettings.cs" />
    <Compile Include="../agent/Web/AgentServices.cs" Link="Web/AgentServices.cs" />
    <Compile Include="../agent/Web/StreamSession.cs" Link="Web/StreamSession.cs" />
    <Compile Include="../agent/Web/ShellFreshness.cs" Link="Web/ShellFreshness.cs" />
    <Compile Include="../agent/Web/WebApi.cs" Link="Web/WebApi.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../agent/wwwroot/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="mo-remote-portal.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="mo_remote_eis.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
