[Unit]
Description=Mo Remote Personal
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
# Keep the desktop awake while remote access is enabled. Screen capture is not
# possible after KDE locks the Wayland session.
ExecStart=/bin/sh -c 'export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(basename "$(find "%t" -maxdepth 1 -type s -name "wayland-*" -print -quit)")}"; exec /usr/bin/systemd-inhibit --what=sleep:idle --who=MoRemotePersonal --why=Remote-access-availability --mode=block @APP@/MoRemotePersonal'
Restart=on-failure
RestartSec=3
Environment=DOTNET_EnableDiagnostics=0
Environment=YDOTOOL_SOCKET=/tmp/.ydotool_socket
# A user service does not reliably inherit the graphical-session environment.
# Spectacle and wl-clipboard need these values to connect to KDE Wayland/DBus;
# without them Qt falls back to XCB and screen capture crashes.
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=QT_QPA_PLATFORM=wayland

[Install]
WantedBy=default.target
