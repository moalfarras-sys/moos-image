# Normalize all text files to LF — shell scripts and YAML break with CRLF
# (this repo is edited on Windows; enforce LF in git regardless).
* text=auto eol=lf

# Binary assets — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.iso binary
*.gz binary
*.zst binary

# Vendored upstream fonts and their notices keep their exact upstream bytes: the lock and the
# shipped font manifest record those bytes (Tajawal's OFL.txt has CRLF line endings).
fonts/meyar-family/upstream-tajawal/** -text
system_files/usr/share/fonts/meyar/OFL-Tajawal.txt -text
