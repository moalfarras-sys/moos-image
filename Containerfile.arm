# =============================================================================
# MoOS ARM — the aarch64 bootc image (moos-arm)
# =============================================================================
#
# WHY A SECOND CONTAINERFILE
#   The x86_64 image builds FROM ghcr.io/ublue-os/kinoite-main:44. That tag is
#   published for amd64 only — it has no arm64 manifest at all — so no build
#   flag can make the main Containerfile produce an ARM image. This one starts
#   from Fedora's own bootc base, which does ship aarch64, and brings up Plasma
#   itself.
#
#   The MoOS identity is NOT duplicated. system_files/ is copied verbatim from
#   the same tree the x86 editions use: the UI2 look-and-feel, every QML surface,
#   the icon and theme trees, the Plymouth boot animation, the service units, Mo
#   AI. That tree contains no compiled binaries, so it is the same bytes on both
#   architectures and the two editions cannot drift apart in how they look.
#
# WHAT THIS IS FOR
#   * Oracle Cloud, Ampere A1 (VM.Standard.A1.Flex) — the Always Free aarch64
#     allowance currently totals 2 OCPU and 12 GB. See
#     docs/MOOS_ARM_ORACLE.md for the storage-cost boundary.
#   * UTM on Apple silicon (hardware virtualisation) and on iPhone/iPad.
#   * Any aarch64 UEFI machine.
#
# BUILD
#   Natively on an arm64 machine or runner:
#       podman build -f Containerfile.arm -t moos-arm:latest .
#   Under emulation from x86 (slow — hours, not minutes):
#       podman build --platform linux/arm64 -f Containerfile.arm -t moos-arm .
#   CI does the former: .github/workflows/build-arm.yml runs on ubuntu-24.04-arm.
#
# THEN, to get something Oracle can import:
#       bootc-image-builder --type qcow2   (see the workflow; it is arm64-native)
# =============================================================================

FROM quay.io/fedora/fedora-bootc:44 AS base

# -----------------------------------------------------------------------------
# ctx: build scripts are bind-mounted, never copied, so they do not ship.
# -----------------------------------------------------------------------------
FROM scratch AS ctx
COPY build_files /
COPY tests/qml/motion-review.qml /motion-review.qml
# Mira's still-face probe: build-arm.sh draws the image's own /usr/lib/mira/app with it. It is her
# test file (the stage below runs the same probe as a suite), never shipped.
COPY mira/test_visual_tier.py /mira/test_visual_tier.py

# Exactly the same native participation client as all x86 editions.
FROM base AS community-build
COPY community/ /src/community/
RUN python3 -B /src/community/stage_client.py /src/community /out/community

# P5.8: exact vendor Plasma rebuild; only the logout transaction is corrected.
FROM base AS plasma-logout-build
RUN dnf5 -y install --setopt=install_weak_deps=False gcc-c++ rpm-build cpio patch \
    'dnf5-command(builddep)' python3 curl plasma-workspace
COPY build_files/plasma_logout/build.sh build_files/plasma_logout/logout-transaction.patch /src/
RUN bash /src/build.sh prepare
RUN bash /src/build.sh compile
COPY build_files/plasma_logout/rpms.py build_files/plasma_logout/native-proof.cpp build_files/plasma_logout/native-proof.sh /src/
RUN dnf5 -y install --setopt=install_weak_deps=False dbus-daemon \
    && python3 /src/rpms.py collect /work/plasma-logout-rpmbuild/RPMS /out \
    && bash /src/native-proof.sh

# Same reviewed vendor source and fix, compiled natively on the ARM runner.
FROM base AS plymouth-build
RUN dnf5 -y install --setopt=install_weak_deps=False gcc libasan rpm-build cpio patch \
    'dnf5-command(builddep)' python3 plymouth-core-libs
COPY build_files/build_plymouth_fix.sh build_files/plymouth_rpms.py /src/
COPY build_files/plymouth/frame-lifetime.patch /src/frame-lifetime.patch
COPY build_files/plymouth/frame-lifetime-native.c /src/frame-lifetime-native.c
COPY build_files/verify_plymouth_package.py /src/verify_plymouth_package.py
COPY scripts/review/plymouth-frame-lifetime.py /src/plymouth-frame-lifetime.py
RUN bash /src/build_plymouth_fix.sh
COPY build_files/plymouth/script-parser.c build_files/verify_plymouth_script.py /src/
COPY system_files/usr/share/plymouth/themes/moos/moos.script /src/moos.script
RUN python3 /src/verify_plymouth_script.py

# Keep a pristine copy of the shared MoOS filesystem overlay. Fedora packages
# are installed during build-arm.sh and may replace session/default files that
# were copied earlier. Re-applying this mounted snapshot after the last package
# transaction makes the final bytes MoOS-owned instead of depending on RPM
# transaction order.
FROM scratch AS system-files
COPY system_files /

# -----------------------------------------------------------------------------
# moos-qml-shell — the one C++ binary MoOS compiles itself: the QML host that
# gives every pure-QML MoOS app a real Wayland app_id.
#
# Compiled in a throwaway stage FROM the same base, exactly as the x86 build
# does, and for the same two reasons: the final image receives only the stripped
# binary and never the compiler, and the Qt6/KF6 sonames it links against are
# the ones the shipped image actually carries.
#
# The source has no architecture-specific code and no -march flags, so this is a
# straight native aarch64 compile.
# -----------------------------------------------------------------------------
FROM base AS qmlshell-build
COPY --from=ctx /moos-qml-shell.cpp /src/moos-qml-shell.cpp
COPY --from=ctx /build_moos_qml_shell.sh /src/build_moos_qml_shell.sh
COPY moos-settings-kcm/ /src/moos-settings-kcm/
RUN dnf5 -y install gcc-c++ qt6-qtbase-devel qt6-qtdeclarative-devel \
        kf6-kdbusaddons-devel kf6-kwindowsystem-devel \
        cmake extra-cmake-modules kf6-kcmutils-devel kf6-ki18n-devel python3 \
    && bash /src/build_moos_qml_shell.sh /src/moos-qml-shell.cpp /out/moos-qml-shell \
    && cmake -S /src/moos-settings-kcm -B /src/moos-settings-kcm-build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DMOOS_KCM_CONTRACT_CHECK=ON \
    && cmake --build /src/moos-settings-kcm-build --parallel 2 \
    && DESTDIR=/out/kcm cmake --install /src/moos-settings-kcm-build

# The status contract, EXECUTED before the modules may enter the image. The real status
# helper publishes in a private runtime directory; the C++ contract every module compiles
# in (moos-settings-contract-check, built above from the same source and never installed)
# must accept that document and refuse each broken copy with the reason the pages show.
# The helper, its modules and their data sit at their image paths in this throwaway stage.
FROM qmlshell-build AS kcm-contract
COPY system_files/usr/libexec/moos-settings-status /usr/libexec/moos-settings-status
COPY system_files/usr/lib/moos/ /usr/lib/moos/
COPY system_files/usr/share/moos/*.json /usr/share/moos/
RUN python3 /src/moos-settings-kcm/tools/check_status_contract.py \
        /src/moos-settings-kcm-build/bin/moos-settings-contract-check \
        /usr/libexec/moos-settings-status /src/moos-settings-kcm/src/moosbackend.cpp

# Mo PC Remote is managed .NET plus the architecture-neutral Portal/PipeWire
# helper. Publish the real linux-arm64 host; an x64 self-contained bundle would
# fail before Main() on Oracle or UTM.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS moremote-build
WORKDIR /src
COPY moremote/ ./
RUN dotnet run --project tests/MoRemote.Tests -c Release --nologo
RUN dotnet run --project tests/MoRemote.Linux.Input.Tests -c Release --nologo
RUN dotnet run --project tests/MoRemote.Stream.Tests -c Release --nologo
RUN dotnet publish agent-linux/MoRemoteLinux.csproj -c Release -r linux-arm64 \
    --self-contained true -o /out

# Flutter does not publish a Linux ARM64 SDK archive. Its native-host path is a
# pinned stable Git tag, which downloads matching arm64 engine artifacts on the
# native runner. Build against Fedora 44's libmpv, just like the x86 bundle.
FROM registry.fedoraproject.org/fedora:44 AS moplayer-build
ARG FLUTTER_VERSION=3.47.4
RUN dnf -y install --setopt=install_weak_deps=False \
        clang cmake ninja-build pkgconf-pkg-config gtk3-devel mpv-libs-devel \
        xz zip unzip git curl file which findutils \
    && dnf clean all
RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" \
        https://github.com/flutter/flutter.git /opt/flutter
ENV PATH="/opt/flutter/bin:${PATH}"
# Flutter's universal cache contains a Gradle-wrapper tarball stamped with
# Google-internal uid/gid values.  A rootless Podman user namespace cannot
# chown to those unmapped IDs, even though Linux desktop never uses Gradle.
# GNU tar honours this for Flutter's own extraction subprocesses.
ENV TAR_OPTIONS="--no-same-owner"
RUN git config --global --add safe.directory /opt/flutter \
    && flutter config --no-analytics --enable-linux-desktop >/dev/null \
    && flutter precache --linux --no-universal \
    && flutter --version
WORKDIR /src
COPY moplayer/ ./
RUN flutter pub get \
    && flutter analyze --no-fatal-infos \
    && flutter test \
    && flutter build linux --release \
    && mkdir -p /out \
    && cp -r build/linux/arm64/release/bundle/. /out/
RUN test -x /out/moplayer \
    && test -f /out/data/icudtl.dat \
    && test -d /out/data/flutter_assets \
    && file /out/moplayer | grep -q 'ARM aarch64' \
    || { echo "GATE FAIL: native ARM64 MoPlayer bundle is incomplete or wrong-architecture"; exit 1; }

# -----------------------------------------------------------------------------
# Mira — the MoOS assistant (Mo AI's app, with Mo AI's services as her executor).
#
# The same stage as the x86 Containerfile's mira-build, and for the same reason it is built FROM
# this edition's own base: her suites run against exactly the aarch64 Python and Qt the image
# ships (build-arm.sh installs the same RPMs in the final image). The packages Fedora 44 lacks or
# ships too old come from the same mira/packaging/requirements.lock, which carries the cp314
# aarch64 manylinux hashes beside the x86_64 ones, so --require-hashes resolves native wheels here
# and nothing else. The final image receives only the runtime tree and those packages.
#
# Until this stage existed the shared /usr/bin/moai (system_files) found no /usr/lib/mira on ARM
# and kept launching the classic QML app: one assistant on x86, another on the Oracle A1.
#
# Two differences from x86, both confined to this throwaway stage:
#   * fedora-bootc is a bare base with no fontconfig and no fonts, where kinoite-main carries
#     both. Qt's offscreen text needs a real face; Mira's own is IBM Plex Sans Arabic, which
#     build-arm.sh installs in the final image in any case.
#   * everything here runs on Qt Quick's software scene graph, the one every ARM session runs
#     (/etc/environment.d/60-moos-arm-llvmpipe.conf) and build-arm.sh's image gate uses, so the
#     window this stage proves is the window the A1 will draw. That scene graph draws no
#     ShaderEffect, and her aura, face portal and nebula are shaders: MiraCore, Avatar and Nebula
#     draw the still face there instead, and the face probe (test_visual_tier) fails the stage when
#     the portal or an avatar comes out empty. A PNG that merely exists once passed with no face.
# -----------------------------------------------------------------------------
FROM base AS mira-build
RUN dnf5 -y install --setopt=install_weak_deps=False python3-pip python3-pyside6 python3-numpy \
        python3-jeepney python3-httpx python3-websockets python3-requests python3-cryptography \
        fontconfig ibm-plex-sans-arabic-fonts \
    && dnf5 clean all
WORKDIR /src/mira
COPY mira/ ./
# Mo AI's tool schemas and the settings registry they read, at their tree layout: Mira declares
# whatever the image declares, and her tests check exactly that set.
COPY system_files/usr/lib/moai/moai_tool_schemas.py /src/system_files/usr/lib/moai/moai_tool_schemas.py
COPY system_files/usr/lib/moos/moos_settings_destinations.py /src/system_files/usr/lib/moos/moos_settings_destinations.py
COPY system_files/usr/share/moos/settings-destinations.json /src/system_files/usr/share/moos/settings-destinations.json
RUN python3 -m pip install --no-cache-dir --disable-pip-version-check --no-input --require-hashes \
        --no-deps --only-binary=:all: --no-compile --target /out/site -r packaging/requirements.lock \
    && rm -rf /out/site/bin /out/site/share /out/site/bench /out/site/examples
# Her own suites, the same list as x86: among them the visual tier that decides how still she stays
# on a machine that draws without a GPU (every Oracle A1) and proves the still face is drawn there,
# her place in Plasma, the agent approvals, the chat history, her moos:// routes and each page of
# her window. The x86 Containerfile runs the same list; tests/test_moos_arm.py keeps the two from
# drifting apart.
# PySide/Qt leaves process-global state behind between modules.  Running the whole suite in one
# interpreter eventually crashed the native ARM builder during Qt teardown, before unittest could
# print which module failed.  Keep every module fail-closed, but give each one a fresh Qt process.
RUN mkdir -p /tmp/mira-home/.cache \
    && export HOME=/tmp/mira-home PYTHONPATH=/out/site PYTHONDONTWRITEBYTECODE=1 \
        QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    && for module in \
        test_tools test_brain test_controller test_qml test_companion test_systools \
        test_live_voice_local test_mira_memory test_group_lights test_moai_agent_link test_visual_tier test_initial_language \
        test_kde_integration test_inbox test_chat_ui test_moos_routes test_page_pc test_page_apps \
        test_page_system test_page_workbench test_page_connect test_page_brain \
        test_lumen test_lumen_hue test_lumen_sync test_homehub test_homesetup test_page_lumen; do \
        if python3 -X faulthandler -s -m unittest -v "$module"; then :; else \
            status=$?; echo "Mira suite $module exited with status $status" >&2; exit "$status"; \
        fi; \
    done
# Her tree as the image receives it, proved from the staged copy itself and never from /src/mira,
# which holds files the stage can forget (it once shipped without pages/, every suite green). Every
# page module must import from it; then her window must open with a clean log, and her face must be
# drawn. The log is written to a file and searched there: a QML warning, a page that failed to
# import (the controller prints «Mira pages:») or a traceback is a window that opened broken, which
# an exit status of 0 and a non-empty PNG cannot see. build-arm.sh repeats all three on the image.
RUN set -eu; \
    sh packaging/stage.sh /src/mira /out/app; \
    cd /out/app; \
    export HOME=/tmp/mira-home PYTHONPATH=/out/site PYTHONDONTWRITEBYTECODE=1 QT_QPA_PLATFORM=offscreen \
        QT_QUICK_BACKEND=software; \
    python3 -s -c 'import pages, chat_ui, kde_integration; missing = sorted({n for n, _ in pages.PAGES} - {m.__name__.rpartition(".")[2] for m in pages.modules()}); assert not missing, "page modules that do not import from the staged tree: %s" % missing' \
        || { echo "GATE FAIL: the staged Mira cannot import her pages"; exit 1; }; \
    MIRA_TEST_MODE=1 MIRA_INSTANCE=mira-build timeout 25 python3 -s app.py --capture=/tmp/mira-shot.png \
        --capture-delay=3000 >/tmp/mira-smoke.log 2>&1 \
        || { cat /tmp/mira-smoke.log; echo "GATE FAIL: the staged Mira did not open her window"; exit 1; }; \
    cat /tmp/mira-smoke.log; \
    test -s /tmp/mira-shot.png || { echo "GATE FAIL: the staged Mira saved no capture"; exit 1; }; \
    if grep -nE '^Mira pages:|\.qml:[0-9]+:([0-9]+:)? |ReferenceError|TypeError|Unable to assign|^Traceback ' \
            /tmp/mira-smoke.log; then \
        echo "GATE FAIL: the staged Mira opened with the faults above"; exit 1; \
    fi; \
    python3 -s /src/mira/test_visual_tier.py --face-probe /out/app \
        || { echo "GATE FAIL: the staged Mira draws no face on the software scene graph"; exit 1; }

# -----------------------------------------------------------------------------
# The image
# -----------------------------------------------------------------------------
FROM base

ARG IMAGE_NAME=moos-arm

LABEL org.opencontainers.image.title="MoOS ARM" \
      org.opencontainers.image.description="MoOS for aarch64 — the MoOS UI Liquid Glass desktop on Oracle Cloud Ampere, UTM and any ARM64 UEFI machine" \
      org.opencontainers.image.vendor="Moalfarras" \
      org.opencontainers.image.source="https://github.com/moalfarras-sys/moos-image"

# The complete MoOS identity, byte-identical to the x86 editions.
COPY system_files/ /
COPY --from=qmlshell-build /out/moos-qml-shell /usr/bin/moos-qml-shell
COPY --from=kcm-contract /out/kcm/usr/ /usr/
COPY --from=moremote-build /out/ /usr/lib/mo-remote/
COPY moremote/Logo.png /usr/share/icons/hicolor/512x512/apps/moos-pc-remote.png
COPY --from=moplayer-build /out/ /usr/lib/moplayer/
# Mira: /usr/lib/mira/app is her runtime tree, /usr/lib/mira/site the pinned packages only she
# imports (PYTHONPATH in /usr/bin/mira) — the same two paths as x86. They lie outside system_files,
# so build-arm.sh's final overlay restore leaves them alone.
COPY --from=mira-build /out/app/ /usr/lib/mira/app/
COPY --from=mira-build /out/site/ /usr/lib/mira/site/
COPY --from=community-build /out/community/ /usr/lib/moos-community/community/

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=system-files,source=/,target=/moos-overlay \
    --mount=type=bind,from=plymouth-build,source=/out,target=/plymouth-rpms \
    --mount=type=bind,from=plasma-logout-build,source=/out,target=/plasma-logout-rpms \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    MOOS_IMAGE_NAME="${IMAGE_NAME}" bash /ctx/build-arm.sh

# The result must be a well-formed, deployable bootc container: clean /var, a
# valid ostree layout, a kernel present. Cheap insurance before anything is
# pushed or written to a disk image.
RUN bootc container lint

LABEL org.opencontainers.image.documentation="https://github.com/moalfarras-sys/moos-image/blob/main/docs/MOOS_ARM_ORACLE.md" \
      io.artifacthub.package.readme-url="https://raw.githubusercontent.com/moalfarras-sys/moos-image/main/docs/MOOS_ARM_ORACLE.md" \
      io.artifacthub.package.logo-url="https://raw.githubusercontent.com/moalfarras-sys/moos-image/main/system_files/usr/share/pixmaps/moos-logo.png"
