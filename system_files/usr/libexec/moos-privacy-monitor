#!/usr/bin/env python3
"""MoOS Privacy Monitor.

Inspects PipeWire streams in real-time to detect active hardware and capture usage:
- Camera (Video/Source capture)
- Microphone (Audio/Source capture)
- Screen share (kwin_wayland screencast / portal capture)

Publishes atomic status tokens into $XDG_RUNTIME_DIR/moos-privacy/ for instant,
zero-polling consumption by the MoOS Island plasmoid (org.moos.island).

It follows the graph through ONE long-lived `pw-dump --monitor` instead of asking for a new dump
every 1.5 s. Read GraphFeed before changing that back.
"""

from __future__ import annotations

import argparse
import codecs
import json
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import time
from typing import Any
import urllib.parse

# Without a live feed (no `pw-dump --monitor`, or PipeWire is restarting) this is the old loop.
POLL_SECONDS = 1.5
# With one: an authoritative full read, so a delta this file mis-merged cannot outlive a minute.
RESYNC_SECONDS = 60.0
# Starting a capture is a burst of events (client, node, ports, link, state). Let it land.
SETTLE_SECONDS = 0.2
# How long a feed that died is left alone before it is tried again.
FEED_RETRY_SECONDS = 30.0
# A change is published twice, this far apart. See Watch.step.
RETOUCH_SECONDS = 1.0
# One array of the monitor's output is the whole graph at most (~220 kB on a desktop). Text that
# has grown far past that without closing is not JSON that is still arriving.
FEED_BUFFER_LIMIT = 8 * 1024 * 1024


def get_runtime_dir() -> Path:
    env_runtime = os.environ.get("XDG_RUNTIME_DIR")
    if env_runtime:
        return Path(env_runtime) / "moos-privacy"
    return Path(f"/run/user/{os.getuid()}/moos-privacy")


def sanitize_app_name(raw: str, pid: int | None = None) -> str:
    if not raw and pid:
        try:
            cmd = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\x00")
            if cmd and cmd[0]:
                raw = Path(cmd[0].decode("utf-8", errors="replace")).name
        except (OSError, ValueError):
            pass

    if not raw:
        return ""

    name = raw.strip()
    lower = name.lower()
    if "mo-remote-portal" in lower or (pid and is_process_mo_remote(pid)):
        return "Mo PC Remote"
    if "chrome" in lower:
        return "Google Chrome"
    if "chromium" in lower:
        return "Chromium"
    if "firefox" in lower:
        return "Firefox"
    if "telegram" in lower:
        return "Telegram"
    if "discord" in lower:
        return "Discord"
    if "obs" in lower:
        return "OBS Studio"
    if "kwin" in lower:
        # The compositor is the SOURCE of a screen cast, never the app watching it. When no
        # consumer could be resolved the honest label is "an app", not a component's name.
        return ""
    if "python" in lower and pid:
        try:
            cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\x00", b" ").decode("utf-8", errors="replace")
            if "mo-remote" in cmdline:
                return "Mo PC Remote"
        except (OSError, ValueError):
            pass

    return name


def is_process_mo_remote(pid: int) -> bool:
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", errors="replace")
        return "mo-remote" in cmdline
    except (OSError, ValueError):
        return False


def partition_dump(objects: list[Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    """Split one full pw-dump into (nodes, links, clients) by each object's interface type."""
    wanted: dict[str, list[dict[str, Any]]] = {"Node": [], "Link": [], "Client": []}
    for item in objects:
        if isinstance(item, dict):
            kind = str(item.get("type", "")).rsplit(":", 1)[-1]
            if kind in wanted:
                wanted[kind].append(item)
    return wanted["Node"], wanted["Link"], wanted["Client"]


def full_dump() -> list[Any] | None:
    """The whole graph from ONE one-shot pw-dump, or None when PipeWire did not answer."""
    try:
        res = subprocess.run(["pw-dump"], capture_output=True, text=True, check=False, timeout=3)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            if isinstance(data, list):
                return data
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError):
        pass
    return None


def query_pipewire() -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    """Query PipeWire nodes, links and clients with ONE pw-dump.

    It used to be three filtered dumps per round; measured on pipewire 1.6.8 that is 12 ms a
    round against 4 ms for one full dump carrying the same objects. This is `--once` and the
    fallback loop; a running session reads GraphFeed instead.
    """
    return partition_dump(full_dump() or [])


class GraphFeed:
    """PipeWire's object graph, kept current by ONE long-lived `pw-dump --monitor`.

    WHY NOT A POLL. The poll looked free and was measured as free: 0.66% of a core on an x86
    desktop. On the Oracle A1 (2 vCPU, read from the unit's cgroup on 2026-10-04, 61 h after
    boot) it had used 52.1 CPU-minutes — more than kwin_wayland's 50.1, and the largest cost of
    anything MoOS itself keeps running. 145,000 processes were spawned to learn, almost every
    time, that nothing had changed.

    And it is not only its own cost. Every pw-dump is a client that connects and leaves, which is
    three events for every other client's registry. A client that is not reading them — and Mo PC
    Remote leaked 67 of those, see close_pipewire_fd() in its portal helper — makes the daemon
    queue them for ever: pipewire grew by about 12 MiB an hour on that machine with nobody
    connected, to 570 MiB.

    WHAT THE FEED IS. `pw-dump --monitor` prints the whole graph once and then one JSON array per
    change: each changed object again in full, and `{"id": N, "info": null}` for one that went
    away. It flushes each array, so through a pipe an event arrives when it happens (measured: a
    client's own events were readable by the time it had exited). An idle desktop therefore costs
    nothing, and a capture is published within SETTLE_SECONDS instead of within 1.5 s.

    WHAT IT IS NOT. It is not trusted alone. Once every RESYNC_SECONDS the loop takes one ordinary
    full dump and replaces what this object holds, and if the feed ends the loop goes back to the
    poll until it can be started again. The privacy chip may be late; it may not be wrong for long.
    """

    COMMAND = ("pw-dump", "--monitor", "--no-colors")

    def __init__(self) -> None:
        self.proc: subprocess.Popen[bytes] | None = None
        self.objects: dict[Any, dict[str, Any]] = {}
        self._text = ""
        self._utf8 = codecs.getincrementaldecoder("utf-8")(errors="replace")
        self._json = json.JSONDecoder()

    def start(self) -> bool:
        self.stop()
        try:
            self.proc = subprocess.Popen(self.COMMAND, stdin=subprocess.DEVNULL,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            self.proc = None
            return False
        os.set_blocking(self.proc.stdout.fileno(), False)
        return True

    def stop(self) -> None:
        proc, self.proc = self.proc, None
        self._text = ""
        self._utf8.reset()
        if proc is None:
            return
        try:
            proc.terminate()
            proc.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            try:
                proc.kill()
                proc.wait(timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                pass
        if proc.stdout is not None:
            proc.stdout.close()

    def alive(self) -> bool:
        return self.proc is not None

    def replace(self, objects: list[Any]) -> None:
        """Take a one-shot dump as the truth."""
        self.objects = {o.get("id"): o for o in objects if isinstance(o, dict) and "id" in o}

    def apply(self, array: list[Any]) -> None:
        for item in array:
            if not isinstance(item, dict) or "id" not in item:
                continue
            if item.get("info") is None:
                self.objects.pop(item["id"], None)
            else:
                self.objects[item["id"]] = item

    def feed(self, text: str) -> bool:
        """Take whatever arrived; apply every array that is complete. True when one was."""
        self._text += text
        changed = False
        while True:
            pending = self._text.lstrip()
            if not pending:
                self._text = ""
                break
            try:
                array, end = self._json.raw_decode(pending)
            except json.JSONDecodeError:
                self._text = pending            # the rest of this array has not arrived yet
                break
            self._text = pending[end:]
            if isinstance(array, list):
                self.apply(array)
                changed = True
        return changed

    def wait(self, timeout: float) -> bool:
        """Sleep until the graph changes or `timeout` passes. True when it changed.

        A feed that ended, or that is sending something which is not JSON, is stopped here; the
        caller sees alive() go false and falls back to the poll."""
        if self.proc is None or self.proc.stdout is None:
            return False
        fd = self.proc.stdout.fileno()
        try:
            ready, _, _ = select.select([fd], [], [], max(0.0, timeout))
        except (OSError, ValueError):
            self.stop()
            return False
        if not ready:
            return False
        changed = False
        while True:
            try:
                chunk = os.read(fd, 65536)
            except BlockingIOError:
                break
            except OSError:
                chunk = b""
            if not chunk:                       # EOF: pw-dump left, usually with PipeWire
                self.stop()
                return changed
            changed = self.feed(self._utf8.decode(chunk)) or changed
            if len(self._text) > FEED_BUFFER_LIMIT:
                self.stop()
                return changed
        return changed

    def snapshot(self) -> list[dict[str, Any]]:
        return list(self.objects.values())


def analyze_streams(
    nodes: list[dict[str, Any]],
    links: list[dict[str, Any]],
    clients: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    """Determine active privacy streams from PipeWire state."""
    client_map: dict[int, dict[str, Any]] = {}
    for c in clients:
        cid = c.get("id")
        props = c.get("info", {}).get("props", {})
        app = props.get("application.name") or props.get("application.process.binary") or ""
        pid = props.get("application.process.id")
        client_map[cid] = {"app": app, "pid": pid}

    node_map: dict[int, dict[str, Any]] = {}
    sources: dict[int, dict[str, Any]] = {}

    for n in nodes:
        nid = n.get("id")
        if not nid:
            continue
        info = n.get("info", {})
        props = info.get("props", {})
        cid = props.get("client.id")
        client_info = client_map.get(cid, {}) if cid else {}
        media_class = props.get("media.class", "")
        media_name = props.get("media.name", "")
        node_name = props.get("node.name", "")
        state = info.get("state", "")
        app = props.get("application.name") or client_info.get("app") or node_name
        pid = props.get("application.process.id") or client_info.get("pid")

        entry = {
            "id": nid,
            "media_class": media_class,
            "media_name": media_name,
            "node_name": node_name,
            "state": state,
            "app": sanitize_app_name(app, pid),
            "pid": pid,
            "client_id": cid,
        }
        node_map[nid] = entry
        if media_class in {"Audio/Source", "Video/Source"} or "screencast" in media_name:
            sources[nid] = entry

    # Map active links
    active_links: list[tuple[int, int]] = []
    for l in links:
        info = l.get("info", {})
        state = info.get("state", "")
        props = info.get("props", {})
        out_node = props.get("link.output.node")
        in_node = props.get("link.input.node")
        if out_node and in_node and state == "active":
            active_links.append((out_node, in_node))

    active_streams: list[dict[str, Any]] = []

    # 1. Screen sharing
    for nid, node in node_map.items():
        if node["state"] != "running":
            continue
        is_screen = False
        app_name = node["app"]
        target_node = nid

        if "screencast" in node["media_name"].lower() or "screencast" in node["node_name"].lower():
            is_screen = True
            for out_id, in_id in active_links:
                if out_id == nid and in_id in node_map:
                    app_name = node_map[in_id]["app"]
                    target_node = in_id
                    break
        elif node["media_class"] == "Stream/Output/Video" and "kwin" in node["node_name"].lower():
            is_screen = True
            for out_id, in_id in active_links:
                if out_id == nid and in_id in node_map:
                    app_name = node_map[in_id]["app"]
                    target_node = in_id
                    break

        if is_screen:
            active_streams.append({
                "type": "screen",
                "app": app_name,
                "node_id": target_node,
                "source_node": nid,
                "pid": node_map.get(target_node, {}).get("pid"),
            })

    # 2. Camera streams
    for nid, node in node_map.items():
        if node["state"] != "running":
            continue
        if node["media_class"] == "Stream/Input/Video":
            linked_source = False
            for out_id, in_id in active_links:
                if in_id == nid and out_id in sources:
                    if sources[out_id]["media_class"] == "Video/Source":
                        linked_source = True
                        break
            if linked_source or ("screencast" not in node["media_name"].lower()
                                and not any(s["node_id"] == nid for s in active_streams if s["type"] == "screen")):
                active_streams.append({
                    "type": "camera",
                    "app": node["app"],
                    "node_id": nid,
                    "pid": node["pid"],
                })

    # 3. Microphone streams
    for nid, node in node_map.items():
        if node["state"] != "running":
            continue
        if node["media_class"] == "Stream/Input/Audio":
            active_streams.append({
                "type": "mic",
                "app": node["app"],
                "node_id": nid,
                "pid": node["pid"],
            })

    return active_streams


def token_name(stream: dict[str, Any], index: int) -> str:
    """`active-<type>-<node>-<app>`: the Island reads this NAME, never the file.

    plasmashell's Qt refuses a local XMLHttpRequest, so W5's chip could not read the JSON body and
    always said "Application". "-" separates fields, so it is written %2D inside the app name;
    the name is clipped so the token stays a legal file name for any UTF-8 app title.
    """
    node = re.sub(r"[^0-9A-Za-z]", "", str(stream.get("node_id", index))) or str(index)
    app = str(stream.get("app") or "")
    encoded = urllib.parse.quote(app, safe="").replace("-", "%2D")
    while len(encoded.encode("ascii")) > 150:
        app = app[:-1]
        encoded = urllib.parse.quote(app, safe="").replace("-", "%2D")
    return f"active-{stream['type']}-{node}" + (f"-{encoded}" if encoded else "")


def write_tokens(streams: list[dict[str, Any]], target_dir: Path) -> None:
    """Atomically write active stream tokens into target directory."""
    target_dir.mkdir(parents=True, exist_ok=True)
    current_tokens = set()

    for idx, stream in enumerate(streams):
        filename = token_name(stream, idx)
        current_tokens.add(filename)
        filepath = target_dir / filename
        tmp_path = target_dir / f".{filename}.tmp"

        payload = json.dumps(stream, ensure_ascii=False).encode("utf-8")
        tmp_path.write_bytes(payload)
        tmp_path.replace(filepath)

    for existing in target_dir.glob("active-*"):
        if existing.name not in current_tokens:
            try:
                existing.unlink()
            except OSError:
                pass


def cleanup(target_dir: Path) -> None:
    if target_dir.exists():
        for f in target_dir.glob("active-*"):
            try:
                f.unlink()
            except OSError:
                pass


def main() -> int:
    parser = argparse.ArgumentParser(description="MoOS Privacy Monitor")
    parser.add_argument("--once", action="store_true", help="Run once and exit")
    parser.add_argument("--dir", type=Path, help="Override target runtime directory")
    args = parser.parse_args()

    target_dir = args.dir or get_runtime_dir()

    def handle_sig(sig: int, frame: Any) -> None:
        cleanup(target_dir)
        sys.exit(0)

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)

    if args.once:
        streams = analyze_streams(*query_pipewire())
        write_tokens(streams, target_dir)
        print(json.dumps(streams, ensure_ascii=False, indent=2))
        return 0

    watch = Watch(GraphFeed(), target_dir)
    try:
        while True:
            watch.step()
    finally:
        watch.feed.stop()


class Watch:
    """The session-long loop, one round at a time so a test can drive it."""

    def __init__(self, feed: GraphFeed, target_dir: Path) -> None:
        self.feed = feed
        self.target_dir = target_dir
        self.published: list[dict[str, Any]] | None = None
        self.retry_at = 0.0
        self.resync_at = 0.0
        self.retouch_at: float | None = None

    def step(self) -> None:
        feed = self.feed
        now = time.monotonic()

        # THE SECOND DOORBELL. The Island learns of a token from its FolderListModel, whose worker
        # is woken by a condition variable: a directory event that arrives while it is still
        # reading wakes nobody, and the change waits for the NEXT event. Publishing a token is
        # itself such a burst (a temporary file, then a rename over the name). When this program
        # rewrote every token each 1.5 s the next event was never far away; now that it writes only
        # on a change, a lost one would leave the privacy chip wrong until the minute's resync. So
        # every change is written once more a second later: same names, a fresh event.
        if self.retouch_at is not None and now >= self.retouch_at:
            self.retouch_at = None
            if self.published is not None:
                write_tokens(self.published, self.target_dir)
            return                              # one thing per round; the next one waits

        if not feed.alive() and now >= self.retry_at:
            self.retry_at = now + FEED_RETRY_SECONDS
            feed.start()
            self.resync_at = 0.0                # a new feed starts from a full read

        if not feed.alive():
            # No feed: exactly what this program did before it had one.
            self.published = analyze_streams(*query_pipewire())
            write_tokens(self.published, self.target_dir)
            time.sleep(POLL_SECONDS)
            return

        resynced = now >= self.resync_at
        if resynced:
            full = full_dump()
            if full is not None:
                feed.replace(full)
            self.resync_at = now + RESYNC_SECONDS
            feed.wait(0)                        # anything newer than that read goes on top of it
        elif feed.wait(min(self.resync_at, self.retouch_at or self.resync_at) - now):
            feed.wait(SETTLE_SECONDS)           # the rest of the burst
        else:
            return                              # the resync or the doorbell is due, or the feed ended

        streams = analyze_streams(*partition_dump(feed.snapshot()))
        # A resync rewrites the tokens even when nothing changed, so a runtime directory that was
        # cleaned under us is repaired within a minute. A graph event that changes no stream —
        # nearly all of them — writes nothing, and the Island's folder watch stays quiet.
        if resynced or streams != self.published:
            if streams != self.published:
                self.retouch_at = time.monotonic() + RETOUCH_SECONDS
            write_tokens(streams, self.target_dir)
            self.published = streams


if __name__ == "__main__":
    sys.exit(main())
