#!/usr/bin/env bash
# moos-verify-origin — put a MoOS install back on the signed update train.
#
# WHY THIS EXISTS
#
# MoOS signs every image with cosign and the installed system is supposed to
# enforce that signature for life. Whether it actually does comes down to one
# string in the deployment's origin file:
#
#   container-image-reference=ostree-image-signed:registry:ghcr.io/…   ← verified
#   container-image-reference=ostree-unverified-registry:ghcr.io/…     ← NOT
#
# `bootc switch` was already caught writing the unverified form (see
# Git history from 2026-07-16 records how `moai-do install-nvidia` silently turned a machine that
# enforced signatures into one that verified nothing, for the rest of the
# install's life, because the origin persists). That path now passes
# --enforce-container-sigpolicy and a gate holds it there.
#
# The cloud conversion path reintroduced the same defect from a direction no
# gate was watching. `system-reinstall-bootc` — the tool MOOS_CLOUD_PLAN §2(أ)
# recommends, and the one that converted the maintainer's own server — runs
# `bootc install to-existing-root` with a hardcoded argument list. Version
# 1.16.4 has no --enforce-container-sigpolicy and no passthrough for one
# (verified by inspecting the binary). So every machine converted that way boots
# MoOS, takes updates from the MoOS registry, and checks the signature on none
# of them.
#
# That cannot be fixed in the converter alone, because the converter has already
# run on the machines that have the problem. So the image repairs itself: this
# runs at boot, and the one thing it does is rebind an unverified origin to the
# signed transport.
#
# WHY IT READS A FILE AND NOT `bootc status`
#
# Because `bootc status` does not expose this. On an unverified install it
# reports transport "registry" and an image ref that looks entirely correct —
# byte-identical output to a verified one. The origin file is the only place the
# truth is written down, which is precisely why nobody noticed for as long as
# nobody did.
set -euo pipefail

REGISTRY_PREFIX="ghcr.io/moalfarras-sys/"
UNVERIFIED_PREFIX="ostree-unverified-registry:"
DEPLOY_ROOT="${MOOS_ORIGIN_DEPLOY_ROOT:-/ostree/deploy}"
RPM_OSTREE="${MOOS_ORIGIN_RPM_OSTREE:-rpm-ostree}"
BOOTC="${MOOS_ORIGIN_BOOTC:-bootc}"
RETRY_DELAY="${MOOS_ORIGIN_RETRY_DELAY:-30}"

log() { printf 'moos-verify-origin: %s\n' "$*"; }

# Not a bootc system (a container build, a test chroot) — nothing to do, and
# certainly nothing to fail over.
command -v "$BOOTC" >/dev/null 2>&1 || { log "no bootc — not a deployed system, skipping"; exit 0; }
[ -d "$DEPLOY_ROOT" ]             || { log "no deployment root — not a deployed system, skipping"; exit 0; }
command -v "$RPM_OSTREE" >/dev/null 2>&1 || {
    log "ERROR: rpm-ostree is missing, so the booted deployment cannot be audited"
    exit 1
}

if ! status="$("$RPM_OSTREE" status --json 2>/dev/null)" || [ -z "$status" ]; then
    log "ERROR: rpm-ostree status returned no deployment data"
    exit 1
fi

booted="$(jq -r '
    first(.deployments[]? | select(.booted == true)) as $d
    | [$d.osname, $d.checksum, ($d.serial | tostring)]
    | @tsv
' <<<"$status" 2>/dev/null || true)"
IFS=$'\t' read -r stateroot checksum serial <<<"$booted"

# Refuse malformed path components before using status output in a pathname.
# These are root-owned rpm-ostree fields, but an audit tool should still fail
# closed instead of ever wandering outside the deployment root.
if ! [[ "$stateroot" =~ ^[A-Za-z0-9._-]+$ ]] \
        || ! [[ "$checksum" =~ ^[0-9a-f]{64}$ ]] \
        || ! [[ "$serial" =~ ^[0-9]+$ ]]; then
    log "ERROR: could not identify the booted rpm-ostree deployment"
    exit 1
fi

origin="${DEPLOY_ROOT}/${stateroot}/deploy/${checksum}.${serial}.origin"
[ -r "$origin" ] || { log "ERROR: origin file not readable: ${origin}"; exit 1; }

ref="$(sed -n 's/^container-image-reference=//p' "$origin" | head -1)"
[ -n "$ref" ] || { log "ERROR: no container-image-reference in ${origin}"; exit 1; }

case "$ref" in
    "${UNVERIFIED_PREFIX}${REGISTRY_PREFIX}"*) ;;
    "${UNVERIFIED_PREFIX}"*)
        # Unverified, but pointed somewhere that is not the MoOS registry. The
        # owner built or retagged this deliberately; rebinding it to a policy
        # keyed on the MoOS public key would brick their next update. Say so and
        # stop — loudly enough to be found, quietly enough not to fail the boot.
        log "WARNING: origin is unverified and not a MoOS image: ${ref}"
        log "         leaving it alone — a custom image is the owner's to police."
        exit 0 ;;
    *)
        log "origin already enforces the signature policy — nothing to do"
        exit 0 ;;
esac

# bootc expects the image reference, not rpm-ostree's transport prefix. Derive
# it from the origin we just proved is the unverified MoOS origin; do not trust a
# second, potentially divergent status field.
image="${ref#${UNVERIFIED_PREFIX}}"
image="${image#docker://}"
[ -n "$image" ] || { log "ERROR: unverified origin has no image reference"; exit 1; }

log "origin is UNVERIFIED: ${ref}"
log "rebinding to the signed transport for ${image}"

# `bootc switch` REPLACES the origin, which is the whole point here: it is the
# only supported way to change the reference of an existing install. With
# --enforce-container-sigpolicy it writes the signed form, and every later
# `bootc upgrade` inherits it.
#
# This stages a deployment; it takes effect on the next boot. That is acceptable
# — the alternative is editing the origin file by hand, which leaves ostree's
# own metadata disagreeing with it.
#
# The retries are for a boot where the network has not settled: network-online
# is a hint, not a guarantee, and a DNS failure here is transient, not a
# signature problem. Three tries over ~90s, then report honestly.
attempt=1
while [ "$attempt" -le 3 ]; do
    if "$BOOTC" switch --enforce-container-sigpolicy "$image"; then
        log "origin rebound — this machine now verifies its updates"
        log "the change applies on the next reboot"
        exit 0
    fi
    log "attempt ${attempt}/3 failed"
    attempt=$((attempt + 1))
    [ "$attempt" -le 3 ] && sleep "$RETRY_DELAY"
done

# Three failures with the network up is not a blip. A machine taking unverified
# updates from a public registry should be visible in `systemctl --failed`, not
# discovered months later by someone reading an origin file.
log "ERROR: could not rebind the origin after 3 attempts."
log "       this machine is still taking UNVERIFIED updates from ${image}."
log "       fix by hand: sudo bootc switch --enforce-container-sigpolicy ${image}"
exit 1
