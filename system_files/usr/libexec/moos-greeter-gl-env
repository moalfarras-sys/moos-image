#!/usr/bin/env bash
# moos-greeter-gl-env — select reliable GL for the NVIDIA-edition login greeter.
#
# The NVIDIA edition force-loads the proprietary driver for real hardware. In a
# QEMU proof VM (or an installer/rescue session on non-NVIDIA hardware) has no
# /dev/nvidia*. Preserve any working DRM render node and use llvmpipe only when
# no GPU device exists. The greeter's KWin user unit consumes this tiny env file.
set -eu

envfile="${MOOS_GREETER_GL_ENV:-/run/moos/plasmalogin-kwin.env}"
devroot="${MOOS_GREETER_DEV_ROOT:-/dev}"
arch="${MOOS_GREETER_ARCH:-$(uname -m)}"
mkdir -p "$(dirname "$envfile")" 2>/dev/null || true

# A real NVIDIA node or any non-ARM DRM render node already gives KWin a
# hardware-backed EGL device. This includes Intel/AMD hybrid graphics and the
# virtio-gpu/VirGL device used by release VMs. Forcing llvmpipe in that case
# leaves the compositor active but its mapped scanout black.
if [ "$arch" != aarch64 ] && {
    compgen -G "${devroot}/nvidia*" >/dev/null 2>&1 \
        || compgen -G "${devroot}/dri/renderD*" >/dev/null 2>&1;
}; then
    rm -f "$envfile"
    exit 0
fi

# ARM virt greeters need vgem before KWin probes DRM; modules-load may not have
# finished when plasmalogin starts.
if [ "$arch" = aarch64 ]; then
    modprobe vgem 2>/dev/null || true
    # plasma-login-manager starts this helper as root before it launches the
    # unprivileged greeter user. udev owns the persistent policy; this ACL is a
    # bounded fallback for a virtio node that was created before the image's
    # rule database became active. A headless cloud host has no nodes here and
    # correctly continues to the virtual-output launcher.
    shopt -s nullglob
    drm_nodes=("${devroot}"/dri/card* "${devroot}"/dri/renderD*)
    for drm_node in "${drm_nodes[@]}"; do
        /usr/bin/setfacl -m u:plasmalogin:rw "$drm_node"
    done
    unset -v drm_node drm_nodes
fi

{
    printf 'LIBGL_ALWAYS_SOFTWARE=1\n'
    if [ "$arch" != aarch64 ]; then
        printf '__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json\n'
        printf 'MESA_LOADER_DRIVER_OVERRIDE=llvmpipe\n'
    fi
    printf 'GALLIUM_DRIVER=llvmpipe\n'
} >"$envfile"
exit 0
