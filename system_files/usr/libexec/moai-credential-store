#!/usr/bin/env python3
"""Private local credential storage for Mo AI.

MoOS deliberately does not start a desktop keyring.  The cloud API key therefore
lives in one app-private XDG data file instead of config.json or KWallet.  The
parent directory is 0700, the file is 0600, writes are atomic, and reads refuse
symlinks and non-regular files.
"""

import os
import stat
import sys
import tempfile
from pathlib import Path

MAX_SECRET_BYTES = 64 * 1024


def credential_path() -> Path:
    override = os.environ.get("MOAI_CREDENTIAL_FILE")
    if override:
        return Path(override)
    data_home = os.environ.get("XDG_DATA_HOME")
    if not data_home:
        data_home = os.path.join(Path.home(), ".local", "share")
    return Path(data_home) / "moai" / "private" / "cloud-api-key"


def prepare_parent(path: Path) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise OSError("credential directory is not a real directory")
    os.chmod(path.parent, 0o700)


def read_secret(path: Path) -> bytes:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError("credential is not a regular file")
        if info.st_size > MAX_SECRET_BYTES:
            raise OSError("credential is too large")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "rb", closefd=False) as handle:
            return handle.read(MAX_SECRET_BYTES + 1)
    finally:
        os.close(fd)


def write_secret(path: Path, value: bytes) -> None:
    if not value or len(value) > MAX_SECRET_BYTES or b"\0" in value:
        raise ValueError("credential must be 1..65536 bytes without NUL")
    prepare_parent(path)
    fd, temporary = tempfile.mkstemp(prefix=".cloud-api-key.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb", closefd=False) as handle:
            handle.write(value)
            handle.flush()
            os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(temporary, path)
        os.chmod(path, 0o600)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"get", "set", "has", "clear"}:
        print("usage: moai-credential-store get|set|has|clear", file=sys.stderr)
        return 2
    action = sys.argv[1]
    path = credential_path()
    try:
        if action == "set":
            value = sys.stdin.buffer.read(MAX_SECRET_BYTES + 1)
            write_secret(path, value)
            return 0
        if action == "clear":
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            return 0
        value = read_secret(path)
        if action == "has":
            return 0 if value else 1
        sys.stdout.buffer.write(value)
        return 0
    except FileNotFoundError:
        return 1
    except (OSError, ValueError) as error:
        print(f"moai-credential-store: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
