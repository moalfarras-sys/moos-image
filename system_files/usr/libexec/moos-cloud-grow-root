#!/usr/bin/env bash
# Grow the physical bootc sysroot after a cloud provider enlarges the disk.
#
# cloud-init's stock growpart/resizefs modules inspect `/`.  On a bootc system
# `/` is composefs, not the writable btrfs filesystem, so they skip the real
# partition and warn about a fictitious `/dev/composefs`.  The writable disk is
# mounted at `/sysroot`; resolve that mount to its block partition and grow the
# partition and btrfs filesystem explicitly.
set -euo pipefail

log() { printf 'moos-cloud-grow-root: %s\n' "$*"; }

source_device="$(findmnt -nro SOURCE /sysroot 2>/dev/null || true)"
# A subvolume source is reported as /dev/vda3[/root].
source_device="${source_device%%\[*}"

if [ -z "$source_device" ] || [ ! -b "$source_device" ]; then
    log "cannot resolve /sysroot to a block partition (${source_device:-none})"
    exit 1
fi

partition="$(lsblk -dnro PARTN "$source_device" 2>/dev/null | tr -d '[:space:]')"
parent="$(lsblk -dnro PKNAME "$source_device" 2>/dev/null | tr -d '[:space:]')"
if [ -z "$partition" ] || [ -z "$parent" ] || ! [[ "$partition" =~ ^[0-9]+$ ]]; then
    log "unsupported sysroot layout: source=$source_device parent=${parent:-none} partition=${partition:-none}"
    exit 1
fi

disk="/dev/${parent}"
if [ ! -b "$disk" ]; then
    log "parent disk does not exist: $disk"
    exit 1
fi

grow_output=""
if ! grow_output="$(growpart "$disk" "$partition" 2>&1)"; then
    # cloud-utils returns non-zero for NOCHANGE on some releases.  That is the
    # normal result after the first boot and must remain idempotent.
    case "$grow_output" in
        *NOCHANGE*) ;;
        *)
            log "partition growth failed: $grow_output"
            exit 1
            ;;
    esac
fi
log "${grow_output:-partition already spans the disk}"

# Btrfs can grow online.  Resize the physical sysroot, never composefs `/`.
btrfs filesystem resize max /sysroot
log "btrfs sysroot now spans the available partition"
