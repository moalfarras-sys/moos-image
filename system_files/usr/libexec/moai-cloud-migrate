#!/usr/bin/env python3
"""Retire Mo AI local inference and migrate its own config to free cloud only.

Runs unprivileged before the gateway. Keeps private one-time backups and model
files. Does not read or change the owner's standalone Hermes/coding tools.
"""
import json
import os
import copy
from pathlib import Path
import subprocess
import sys
import tempfile
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib/moai'))
import moai_cloud_policy as policy


def atomic_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.moai-cloud-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as handle:
            json.dump(data, handle, indent=2)
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)


def _provider_selection(cloud):
    """Return (provider, base, model, name) for a supported saved cloud node.

    The cloud-only migration predates billed catalogue providers.  Comparing
    every saved node with OpenRouter's base erased a valid OpenCode Zen key on
    every login.  Provider identity lives in Mo AI's state file; validate that
    explicit choice against the shared policy instead of guessing from a URL.
    """
    provider = policy.selected_provider() or 'openrouter-free'
    bases = {'openrouter-free': policy.BASE, 'openrouter-paid': policy.BASE,
             **policy.PAID_PROVIDERS}
    base = bases.get(provider)
    if not base or str(cloud.get('baseUrl', '')).rstrip('/') != base:
        return None
    for item in cloud.get('models', []):
        if not isinstance(item, dict):
            continue
        model = item.get('id')
        try:
            policy.validate_selection(provider, model)
        except ValueError:
            continue
        return provider, base, model, str(item.get('name') or model)
    # A historical OpenRouter node may carry a paid/local model while the
    # cloud-only migration moves it to the explicit zero-price router.  The
    # credential still belongs to the same service and must survive that model
    # correction.  Billed providers have no universally safe fallback model.
    if provider == 'openrouter-free':
        return provider, base, policy.DEFAULT_MODEL, 'Mo AI Free Cloud'
    return None


def _recover_provider_backup(path, provider):
    """Recover a key erased by the old migration, only for an exact match."""
    if provider not in policy.PAID_PROVIDERS:
        return None
    backup = path.with_name(path.name + '.before-free-cloud')
    try:
        data = json.loads(backup.read_text())
        cloud = ((data.get('models') or {}).get('providers') or {}).get('cloud') or {}
    except (OSError, ValueError, TypeError, AttributeError):
        return None
    selection = _provider_selection(cloud)
    if selection and selection[0] == provider and cloud.get('apiKey'):
        return copy.deepcopy(cloud)
    return None


def migrate(path):
    if not path.exists(): return
    data=json.loads(path.read_text())
    original=json.loads(json.dumps(data))
    if path.name == 'openclaw.json':
        providers=data.setdefault('models',{}).setdefault('providers',{})
        cloud=providers.get('cloud',{})
        choice = _provider_selection(cloud)
        selected_provider = policy.selected_provider() or 'openrouter-free'
        if choice is None:
            recovered = _recover_provider_backup(path, selected_provider)
            if recovered is not None:
                cloud = recovered
                choice = _provider_selection(cloud)
        if choice is None:
            cloud={}
            choice=('openrouter-free', policy.BASE, policy.DEFAULT_MODEL,
                    'Mo AI Free Cloud')
        _, selected_base, selected, selected_name = choice
        providers.clear()
        cloud.update(baseUrl=selected_base,api='openai-completions',
                     models=[{'id':selected,'name':selected_name}])
        providers['cloud']=cloud
        defaults=data.setdefault('agents',{}).setdefault('defaults',{})
        defaults['model']={'primary':'cloud/'+selected,'fallbacks':[]}
        defaults['models']={'cloud/'+selected:{}}
        for key in ('imageModel','heartbeat'):
            defaults.pop(key,None)
        # No paid auxiliary inference or local speech models through Mo AI.
        data.setdefault('messages',{})['tts']={'auto':'off'}
        data.setdefault('tools',{}).setdefault('media',{})['audio']={'enabled':False}
    else:
        data['mode']='cloud'
        data['cloud_base']=policy.BASE
        data['cloud_wire']='openai'
        if not (policy.free_model(data.get('cloud_model')) or
                policy.selected_cost_policy() == 'paid' and policy.valid_model(data.get('cloud_model'))):
            data['cloud_model']=policy.DEFAULT_MODEL
    if data==original: return
    backup=path.with_name(path.name+'.before-free-cloud')
    if not backup.exists(): atomic_json(backup,original)
    atomic_json(path,data)


def main():
    home=Path.home()
    for filename in (home/'.openclaw/openclaw.json',home/'.config/moai/config.json'):
        migrate(filename)
    units=('moai.service','moai-brain.service','ollama.service',
           'speaches.service','moai-speech.service',
           'moai-idle.service','moai-idle.timer','moos-ensure-brain.service','moos-ensure-brain.timer')
    subprocess.run(['systemctl','--user','stop',*units],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=30)
    subprocess.run(['systemctl','--user','mask',*units],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=30)


if __name__=='__main__': main()
