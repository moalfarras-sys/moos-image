#!/usr/bin/bash
# Keep Flatpak's automatic user update honest while recovering from a known,
# transient Flathub failure mode: a malformed/static delta can exceed libostree's
# decompression limit even though the complete object is valid.  Retry once
# without static deltas; any real network, signature, or repository failure still
# exits non-zero and remains visible to systemd.
set -euo pipefail

flatpak_bin="${MOOS_FLATPAK_BIN:-/usr/bin/flatpak}"

"$flatpak_bin" --user uninstall --unused -y --noninteractive

if ! "$flatpak_bin" --user update -y --noninteractive; then
    echo "MoOS: Flatpak delta update failed; retrying from complete objects." >&2
    "$flatpak_bin" --user update --no-static-deltas -y --noninteractive
fi

"$flatpak_bin" --user repair
