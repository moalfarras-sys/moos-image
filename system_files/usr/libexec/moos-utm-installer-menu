#!/usr/bin/env bash
# moos-utm-installer-menu — MoOS UTM recovery menu (tty1 + serial friendly)
set -euo pipefail

export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
STATUS_FILE="/run/moos-utm-installer-status"
LOG="/var/log/moos-utm-installer-menu.log"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG"; }

pick_target_disk() {
    /usr/libexec/moos-utm-net-install --print-target 2>/dev/null || true
}

target_has_moos() {
    local dev="$1"
    [ -n "$dev" ] && lsblk -rnpo FSTYPE "$dev" 2>/dev/null | grep -qx btrfs
}

show_status() {
    local msg="$1"
    printf '%s\n' "$msg" >"$STATUS_FILE"
    printf '\n%s\n\n' "$msg" >/dev/console 2>/dev/null || true
    log "$msg"
}

network_ok() {
    nmcli -t -f STATE general 2>/dev/null | grep -qx connected
}

wait_network() {
    show_status "MoOS Installer\n\nWaiting for network..."
    for _ in $(seq 1 60); do
        network_ok && { show_status "MoOS Installer\n\nNetwork: OK"; return 0; }
        sleep 2
    done
    show_status "MoOS Installer\n\nNetwork: FAILED — check UTM Emulated networking"
    return 1
}

boot_installed() {
    local target
    target="$(pick_target_disk || true)"
    [ -n "$target" ] || { whiptail --msgbox "No target disk found." 10 60 2>/dev/null || true; return 1; }
    if ! target_has_moos "$target"; then
        whiptail --msgbox "Target disk has no MoOS installation yet." 10 60 2>/dev/null || true
        return 1
    fi
    show_status "MoOS Installer\n\nBooting installed MoOS..."
    if command -v efibootmgr >/dev/null 2>&1; then
        entry=$(efibootmgr 2>/dev/null | awk -F'\*' '/Boot[0-9]+/ {print $1}' | head -1 | tr -d 'Boot' || true)
        [ -n "$entry" ] && efibootmgr -n "$entry" >/dev/null 2>&1 || true
    fi
    systemctl reboot
}

run_install() {
    local mode="${1:-install}"
    wait_network || return 1
    show_status "MoOS Installer\n\nChecking latest signed MoOS ARM..."
    if [ "$mode" = reinstall ]; then
        MOOS_UTM_ALLOW_REINSTALL=1 /usr/libexec/moos-utm-net-install
    else
        /usr/libexec/moos-utm-net-install
    fi
}

run_repair() {
    wait_network || return 1
    show_status "MoOS Installer\n\nRepair: re-verifying signed origin..."
    MOOS_UTM_REPAIR=1 /usr/libexec/moos-utm-net-install
}

main_menu() {
    local target has_moos=0 choice
    target="$(pick_target_disk || true)"
    target_has_moos "$target" && has_moos=1

    while true; do
        if [ "$has_moos" -eq 1 ]; then
            choice=$(whiptail --backtitle "MoOS Installer" --title "MoOS UTM" \
                --menu "Choose an action:" 18 72 6 \
                1 "Boot installed MoOS" "" \
                2 "Install latest signed MoOS" "" \
                3 "Repair" "" \
                4 "Reinstall (erase target)" "" \
                3>&1 1>&2 2>&3) || choice=1
        else
            choice=$(whiptail --backtitle "MoOS Installer" --title "MoOS UTM" \
                --menu "Choose an action:" 16 72 4 \
                2 "Install latest signed MoOS" "" \
                3 "Repair" "" \
                5 "Shell / serial debug" "" \
                3>&1 1>&2 2>&3) || choice=2
        fi

        case "$choice" in
            1) boot_installed ;;
            2)
                run_install install
                whiptail --msgbox "Installation complete.\nRebooting into MoOS..." 10 60 2>/dev/null || true
                systemctl reboot
                ;;
            3) run_repair; whiptail --msgbox "Repair finished." 8 50 2>/dev/null || true ;;
            4)
                whiptail --yesno "Reinstall will ERASE MoOS on the target disk.\n\nContinue?" 12 60 2>/dev/null \
                    && run_install reinstall && systemctl reboot
                ;;
            5) whiptail --msgbox "Use UTM Terminal (serial). Login: moos" 10 60 2>/dev/null || true ;;
            *) return 0 ;;
        esac
    done
}

mkdir -p "$(dirname "$LOG")" /run
: >"$LOG"
show_status "MoOS Installer\n\nStarting..."

if [ -e /dev/tty1 ] && command -v whiptail >/dev/null 2>&1; then
    exec >/dev/tty1 2>&1 </dev/tty1
    printf 'MOOS_UTM_INSTALLER_MENU_READY\n' >/dev/ttyAMA0 2>/dev/null || true
    main_menu
else
    show_status "MoOS Installer\n\nUse serial terminal.\nRun: sudo moos-utm-net-install"
    exec /usr/libexec/moos-utm-net-install
fi
