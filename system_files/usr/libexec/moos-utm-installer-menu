#!/usr/bin/env bash
# moos-utm-installer-menu — MoOS UTM recovery menu (tty1 + serial friendly)
set -euo pipefail

export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
STATUS_FILE="/run/moos-utm-installer-status"
LOG="/var/log/moos-utm-installer-menu.log"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG"; }

pick_target_disk() {
    /usr/libexec/moos-utm-net-install --print-target 2>/dev/null || true
}

target_has_data() {
    local dev="$1" layout
    [ -n "$dev" ] || return 1
    layout="$(lsblk -rnpo TYPE,FSTYPE "$dev" 2>/dev/null)" || return 2
    awk '$1 == "part" || NF > 1 { occupied = 1 }
         END { exit !occupied }' <<<"$layout"
}

show_status() {
    local msg="$1"
    printf '%s\n' "$msg" >"$STATUS_FILE"
    printf '\n%s\n\n' "$msg" >/dev/console 2>/dev/null || true
    log "$msg"
}

network_ok() {
    nmcli -t -f STATE general 2>/dev/null | grep -qx connected
}

wait_network() {
    show_status "MoOS Installer\n\nWaiting for network..."
    for _ in $(seq 1 60); do
        network_ok && { show_status "MoOS Installer\n\nNetwork: OK"; return 0; }
        sleep 2
    done
    show_status "MoOS Installer\n\nNetwork: FAILED — check UTM Shared networking"
    return 1
}

boot_installed() {
    local target entry line firmware
    local -a entries=()
    target="$(pick_target_disk || true)"
    [ -n "$target" ] || { whiptail --msgbox "No target disk found." 10 60 2>/dev/null || true; return 1; }
    if ! target_has_data "$target"; then
        whiptail --msgbox "لم يتم التعرف على نظام مثبت | No installed target was identified." 10 60 2>/dev/null || true
        return 1
    fi
    # A Btrfs partition is not MoOS identity. Never select the first firmware
    # entry (often this recovery image), or strip valid hexadecimal B digits.
    if command -v efibootmgr >/dev/null 2>&1 && firmware="$(efibootmgr 2>/dev/null)"; then
        while IFS= read -r line; do
            if [[ "$line" =~ ^Boot([[:xdigit:]]{4})\*?[[:space:]]+MoOS([[:space:]]|$) ]]; then
                entries+=("${BASH_REMATCH[1]}")
            fi
        done <<<"$firmware"
    fi
    if [ "${#entries[@]}" -ne 1 ]; then
        whiptail --msgbox "اختر قرص النظام من إعدادات إقلاع UTM.\nNo unique MoOS firmware entry; select the installed disk in UTM boot settings." 12 72 2>/dev/null || true
        return 1
    fi
    entry="${entries[0]}"
    efibootmgr -n "$entry" >/dev/null 2>&1 || {
        whiptail --msgbox "تعذر اختيار الإقلاع | Firmware boot selection failed." 10 60 2>/dev/null || true
        return 1
    }
    show_status "MoOS Installer\n\nBooting installed MoOS..."
    systemctl reboot
}

run_install() {
    local mode="${1:-install}"
    wait_network || return 1
    show_status "MoOS Installer\n\nChecking latest signed MoOS ARM..."
    if [ "$mode" = reinstall ]; then
        MOOS_UTM_ALLOW_REINSTALL=1 /usr/libexec/moos-utm-net-install
    else
        /usr/libexec/moos-utm-net-install
    fi
}

main_menu() {
    local target has_data=0 choice layout_status
    target="$(pick_target_disk || true)"
    if target_has_data "$target"; then
        has_data=1
    else
        layout_status=$?
        if [ "$layout_status" -ne 1 ]; then
            whiptail --msgbox "تعذرت قراءة القرص | Target layout could not be read; no action taken." 10 72 2>/dev/null || true
            return 1
        fi
    fi

    while true; do
        if [ "$has_data" -eq 1 ]; then
            choice=$(whiptail --backtitle "MoOS Installer" --title "MoOS UTM" \
                --menu "اختر إجراءً | Choose an action:" 18 72 6 \
                1 "إقلاع MoOS من UEFI | Boot MoOS firmware entry" "" \
                2 "Install latest signed MoOS" "" \
                4 "إعادة التثبيت: مسح القرص | Reinstall (erase target)" "" \
                3>&1 1>&2 2>&3) || return 0
        else
            choice=$(whiptail --backtitle "MoOS Installer" --title "MoOS UTM" \
                --menu "اختر إجراءً | Choose an action:" 16 72 4 \
                2 "Install latest signed MoOS" "" \
                5 "Shell / serial debug" "" \
                3>&1 1>&2 2>&3) || return 0
        fi

        case "$choice" in
            1) boot_installed || return 1 ;;
            2)
                if run_install install; then
                    whiptail --msgbox "اكتمل التثبيت | Installation complete.\nRebooting into MoOS..." 10 60 2>/dev/null || true
                    systemctl reboot
                else
                    whiptail --msgbox "التثبيت لم يكتمل | Installation did not complete.\nCheck the installer log before retrying." 10 60 2>/dev/null || true
                fi
                ;;
            4)
                whiptail --yesno "Reinstall will ERASE MoOS on the target disk.\n\nContinue?" 12 60 2>/dev/null \
                    && run_install reinstall && systemctl reboot
                ;;
            5) whiptail --msgbox "Use UTM Terminal (serial). Login: moos" 10 60 2>/dev/null || true ;;
            *) return 0 ;;
        esac
    done
}

mkdir -p "$(dirname "$LOG")" /run
: >"$LOG"
show_status "MoOS Installer\n\nStarting..."

if [ -e /dev/tty1 ] && command -v whiptail >/dev/null 2>&1; then
    exec >/dev/tty1 2>&1 </dev/tty1
    main_menu
else
    show_status "MoOS Installer\n\nUse serial terminal.\nRun: sudo moos-utm-net-install"
    exec /usr/libexec/moos-utm-net-install
fi
