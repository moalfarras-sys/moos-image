#!/usr/bin/env bash
# Re-emit block change events after the real-root udev daemon is ready.
#
# The initramfs discovers the OSTree root, but on some aarch64 virt machines
# the switch-root coldplug completes without recreating filesystem UUID links
# for the separate boot and EFI partitions.  Their correct fstab device units
# then expire even though the partitions are already present.  Triggering a
# change event here makes the running udev database publish those links before
# local-fs mount jobs begin; this is event-driven and does not extend a broken
# device timeout.
set -euo pipefail

[ "$(uname -m)" = aarch64 ] || exit 0

udevadm trigger --type=devices --subsystem-match=block --action=change \
    --wait-daemon=30 --settle

check_links() {
    local missing=0 spec where _rest link
    while read -r spec where _rest; do
        case "$where" in /boot|/boot/efi) ;; *) continue ;; esac
        case "$spec" in
            UUID=*) link="/dev/disk/by-uuid/${spec#UUID=}" ;;
            PARTUUID=*) link="/dev/disk/by-partuuid/${spec#PARTUUID=}" ;;
            /dev/disk/by-uuid/*|/dev/disk/by-partuuid/*) link="$spec" ;;
            *) continue ;;
        esac
        if [ ! -e "$link" ]; then
            printf 'moos-arm-block-coldplug: %s still lacks %s\n' "$where" "$link" >&2
            missing=1
        fi
    done < /etc/fstab
    return "$missing"
}

if check_links; then
    exit 0
fi

# Slow virt disks can miss the first change event window (QEMU boot proof saw
# dev-disk-by-uuid units hit the 45s default before links existed).
udevadm trigger --type=devices --subsystem-match=block --action=change \
    --wait-daemon=30 --settle
sleep 2
check_links
