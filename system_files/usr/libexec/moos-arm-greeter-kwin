#!/usr/bin/env bash
# Pick the ARM greeter backend from the display hardware that actually exists.
#
# A phone/UTM VM exposes a connected virtio connector and must render to it.
# A display-less VPS exposes no connector and needs KWin's virtual backend so
# the login manager can still start without inventing a physical screen.
set -eu

kwin_args=(
    --no-lockscreen
    --no-global-shortcuts
    --no-kactivities
    --inputmethod plasma-keyboard
    --locale1
)

# A QEMU/UTM virtio display can legitimately report its connector as
# "disconnected" when the host frontend is headless.  The framebuffer is still
# present (QEMU's monitor screendump reads it, and UTM attaches its view later),
# so treating that status as "no display" launches KWin on a private virtual
# output and leaves the real framebuffer black.  A genuinely display-less VPS
# has no connector node at all.  Wait briefly for DRM coldplug, then use the DRM
# backend whenever a connector exists, regardless of its current status text.
for _attempt in $(seq 1 50); do
    for status in /sys/class/drm/card*-*/status; do
        [ -e "$status" ] || continue
        exec /usr/bin/kwin_wayland "${kwin_args[@]}"
    done
    sleep 0.1
done

exec /usr/bin/kwin_wayland "${kwin_args[@]}" --virtual --width 1920 --height 1080
