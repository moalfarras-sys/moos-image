#!/usr/bin/env bash
# Pick the ARM greeter backend from the display hardware that actually exists.
#
# A phone/UTM VM exposes a connected virtio connector and must render to it.
# A display-less VPS exposes no connector and needs KWin's virtual backend so
# the login manager can still start without inventing a physical screen.
#
# The greeter's KWin runs as the unprivileged `plasmalogin` user (uid 969). On a
# local VM the virtio DRM node defaults to `root:video` 0660 and udev applies the
# world-readable rule from build-arm.sh only AFTER the node appears — KWin probing
# the node before that loses the race and logs "Failed to open drm node: No such
# file or directory", leaving the framebuffer black while plasmalogin.service
# still reports active. So: confirm a connector exists (the VPS-distinguishing
# probe the build gate checks), THEN wait for the real /dev/dri node to exist AND
# be openable by this user before exec'ing KWin, naming it explicitly.
set -eu

kwin_args=(
    --no-lockscreen
    --no-global-shortcuts
    --no-kactivities
    --inputmethod plasma-keyboard
    --locale1
)

# 1) Distinguish a connected UTM display from a connector-less headless VPS.
#    A QEMU/UTM virtio display can legitimately report its connector as
#    "disconnected" when the host frontend is headless; the framebuffer is still
#    present (QEMU's monitor screendump reads it, and UTM attaches its view
#    later). So connector PRESENCE — not the status text — selects DRM, and a
#    genuinely display-less VPS (no connector node at all) gets --virtual.
has_connector=0
for _attempt in $(seq 1 50); do
    for status in /sys/class/drm/card*-*/status; do
        [ -e "$status" ] || continue
        has_connector=1
        break 2
    done
    sleep 0.1
done

# 2) Wait for the real DRM node to exist and be openable by this user. The udev
#    rule grants it world-readable mode, and membership in the video/render
#    groups is the fallback path; either way do not start KWin until the node is
#    both present and readable, or the first probe loses the race against udev.
dri_node=""
for _attempt in $(seq 1 150); do
    for candidate in /dev/dri/card0 /dev/dri/card1 /dev/dri/renderD128; do
        [ -e "$candidate" ] || continue
        if [ -r "$candidate" ]; then
            dri_node="$candidate"
            break 2
        fi
    done
    sleep 0.2
done

if [ "$has_connector" -eq 1 ] && [ -n "$dri_node" ]; then
    # KWin selects its DRM device from KWIN_DRM_DEVICES (this KWin has no
    # drm-device CLI flag); pointing it at the node we just confirmed is
    # present and readable avoids the "Failed to open drm node" race and the black
    # frame. Export it so the exec inherits it.
    export KWIN_DRM_DEVICES="$dri_node"
    exec /usr/bin/kwin_wayland "${kwin_args[@]}"
fi

# No usable DRM node appeared (a genuinely display-less VPS, or a node KWin still
# cannot open). Keep the login manager alive on a private virtual output rather
# than dying — the boot proof only requires graphical.target to be reachable
# there, not a real framebuffer.
exec /usr/bin/kwin_wayland "${kwin_args[@]}" --virtual --width 1920 --height 1080
