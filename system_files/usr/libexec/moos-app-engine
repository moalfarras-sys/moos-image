#!/usr/bin/python3
"""Which MoOS engine runs this file, is it ready, and what do we CALL it?

One resolver over /usr/share/moos/app-engines.json, so the file-manager runner,
App Drop, Mo Store and Mo AI all answer those three questions the same way.
Before this existed each of them decided separately, and they disagreed: the
image installs wine on every desktop edition precisely so "any .exe the user
downloads actually runs" (build.sh, _core_power), while the runner knew only
about Bottles and offered to download it — on a machine that could already run
the file.

Read-only by contract. It never installs, never launches and never writes: it
answers, and the caller decides. That keeps the single privileged executor
(moai-do) the only thing that changes a machine.

  moos-app-engine resolve <file>   what runs this, and is it ready
  moos-app-engine list             every engine and its state
  moos-app-engine name <engine>    the words to show a person

Output is JSON on stdout. Exit 0 when an engine is resolved, 3 when the file
belongs to no engine, 2 on usage error.
"""
from __future__ import annotations

import json
import os
import shutil
import stat
import struct
import subprocess
import sys
from pathlib import Path

REGISTRY = Path(os.environ.get("MOOS_APP_ENGINES",
                               "/usr/share/moos/app-engines.json"))


def load() -> dict:
    try:
        document = json.loads(REGISTRY.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        print(json.dumps({"error": f"unreadable engine registry: {error}"}))
        raise SystemExit(2)
    if document.get("schema") != 1:
        print(json.dumps({"error": "unsupported engine registry schema"}))
        raise SystemExit(2)
    return document


def flatpak_present(reference: str) -> bool:
    """Installed for this user or system-wide. Absent is not an error."""
    if not shutil.which("flatpak"):
        return False
    try:
        return subprocess.run(
            ["flatpak", "info", reference],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=15).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def waydroid_initialized() -> bool:
    """Installed is not ready: the Android system image is a separate download.

    `waydroid status` says "not initialized" in its own words when the image was
    never fetched. Anything else means it can take a package.
    """
    try:
        result = subprocess.run(["waydroid", "status"], capture_output=True,
                                text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return False
    return "not initialized" not in (result.stdout + result.stderr).lower()


READY_CHECKS = {"initialized": waydroid_initialized}


def pe_architecture(target: str | Path) -> str:
    """Read only the DOS/COFF header, never execute or load a downloaded file.

    Nonblocking open plus fstat also makes a FIFO/device supplied to this public
    read-only CLI harmless. An extension is routing, never architecture evidence.
    """
    try:
        fd = os.open(target, os.O_RDONLY | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode):
                return "unknown"
            dos = stream.read(64)
            if len(dos) != 64 or dos[:2] != b"MZ":
                return "unknown"
            offset = struct.unpack_from("<I", dos, 60)[0]
            if offset < 64 or offset > info.st_size - 26:
                return "unknown"
            stream.seek(offset)
            header = stream.read(26)
            if len(header) != 26 or header[:4] != b"PE\0\0":
                return "unknown"
            machine = struct.unpack_from("<H", header, 4)[0]
            optional_size = struct.unpack_from("<H", header, 20)[0]
            if optional_size < 2 or offset + 24 + optional_size > info.st_size:
                return "unknown"
            magic = struct.unpack_from("<H", header, 24)[0]
            return {(0x14c, 0x10b): "x86", (0x8664, 0x20b): "x86_64",
                    (0xaa64, 0x20b): "arm64"}.get((machine, magic), "unknown")
    except (OSError, ValueError):
        return "unknown"


def wine_x86_payload() -> str:
    """Recognize classic multilib AND new WoW64, without launching a runtime.

    No i686 RPM does not mean no PE32 support. New WoW64 uses 64-bit Unix
    libraries with i386 PE DLLs. These are payload checks, not a compatibility
    claim; mapping permissions, drivers and each application still need testing.
    Unfamiliar user-installed layouts are unknown rather than falsely blocked.
    """
    executable = shutil.which("wine")
    if not executable:
        return "missing"
    if Path(executable).resolve().parent != Path("/usr/bin"):
        return "unknown"
    roots = (Path("/usr/lib/wine"), Path("/usr/lib64/wine"),
             Path("/usr/lib64/wine-wow64/wine"))
    for root in roots:
        if pe_architecture(root / "i386-windows/ntdll.dll") != "x86":
            continue
        if (root / "i386-unix/ntdll.so").is_file():
            return "classic"
        if (pe_architecture(root / "x86_64-windows/wow64.dll") == "x86_64"
                and pe_architecture(root / "x86_64-windows/wow64cpu.dll") == "x86_64"
                and (root / "x86_64-unix/ntdll.so").is_file()):
            return "wow64"
    return "missing"


def file_preflight(target: str, chosen: dict | None) -> dict:
    architecture = pe_architecture(target)
    answer = {"architecture": architecture, "status": "unknown"}
    if architecture != "x86" or not chosen or chosen["id"] != "wine":
        return answer
    payload = wine_x86_payload()
    answer["payload"] = payload
    if payload in ("classic", "wow64"):
        answer["status"] = "available"
    elif payload == "missing":
        answer.update(status="blocked", code="missing-windows-x86-runtime", reason={
            "en": "This is a 32-bit Windows program. This MoOS installation is missing the files needed to run it. Nothing was launched. Try a 64-bit version of the app or check for a MoOS update.",
            "ar": "هذا برنامج ويندوز 32-بت. تنقص هذا التثبيت من MoOS ملفات تشغيله. لم يُشغّل أي شيء. جرّب نسخة 64-بت من التطبيق أو تحقّق من تحديث MoOS.",
        })
    return answer


def runtime_state(runtime: dict) -> dict:
    """Present (can this machine run it at all) and ready (can it take a file)."""
    carrier = runtime.get("carrier")
    if carrier == "flatpak":
        present = flatpak_present(runtime["id"])
    elif carrier == "image":
        present = bool(shutil.which(runtime.get("probe") or runtime["id"]))
    else:
        present = False
    ready = present
    check = runtime.get("ready")
    if present and check:
        probe = READY_CHECKS.get(check)
        ready = bool(probe and probe())
    return {
        "id": runtime["id"],
        "carrier": carrier,
        "sandboxed": bool(runtime.get("sandboxed")),
        "present": present,
        "ready": ready,
        # Why the caller may have to ask before using this one.
        "needs_setup": bool(present and not ready),
    }


def describe(engine: dict, target: str | None = None) -> dict:
    runtimes = [runtime_state(runtime) for runtime in engine.get("runtimes", [])]
    # Best-first is the file's order, already written sandboxed-first. The first
    # READY runtime wins; a runtime that is present but not ready is the reason
    # to offer setup rather than to fail.
    chosen = next((r for r in runtimes if r["ready"]), None)
    pending = next((r for r in runtimes if r["needs_setup"]), None)
    provision = engine.get("provision") or {}
    preflight = file_preflight(target, chosen) if target and engine["id"] == "windows" else None
    if preflight and preflight["status"] == "blocked":
        chosen = None
        pending = None
    return {
        "engine": engine["id"],
        "name": engine["name"],
        "runtimes": runtimes,
        "chosen": chosen,
        "ready": chosen is not None,
        # True when something IS installed but needs a one-time download. The
        # caller must ask first; an OS that fetches a gigabyte because a file was
        # double-clicked is not trustworthy.
        "needs_setup": chosen is None and pending is not None,
        "provision_route": provision.get("route"),
        "preflight": preflight,
    }


def engine_for(document: dict, target: str) -> dict | None:
    suffix = Path(target).suffix.lstrip(".").lower()
    if not suffix:
        return None
    for engine in document.get("engines", []):
        claims = engine.get("claims", {})
        if suffix in [str(value).lower() for value in claims.get("extensions", [])]:
            return engine
    return None


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    document = load()
    action = argv[1]

    if action == "list":
        print(json.dumps(
            {"engines": [describe(engine) for engine in document.get("engines", [])],
             "unsupported": document.get("unsupported", [])},
            ensure_ascii=False))
        return 0

    if action == "name":
        if len(argv) != 3:
            return 2
        for engine in document.get("engines", []) + document.get("unsupported", []):
            if engine["id"] == argv[2]:
                print(json.dumps(engine["name"], ensure_ascii=False))
                return 0
        return 3

    if action == "resolve":
        if len(argv) != 3:
            return 2
        engine = engine_for(document, argv[2])
        if engine is None:
            print(json.dumps({"engine": None}, ensure_ascii=False))
            return 3
        print(json.dumps(describe(engine, argv[2]), ensure_ascii=False))
        return 0

    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
