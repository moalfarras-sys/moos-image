#!/usr/bin/env python3
"""Publish the read-only live state the MoOS System Settings modules show.

The kcm_moos* modules (moos-settings-kcm/) run this helper and read the one
private, atomic JSON document it writes; they validate schema, product and age
and bind only its fields. This helper is the small, read-only boundary: it
gathers a fixed set of facts, never accepts a command or a destination path from
the UI, and normalises identity values at the source (kernelLabel,
editionLabel, archLabel, sessionLabel) so no page can show a packager's build tag
or an image address as a product name. When launched with --watch-pid it
refreshes cheap session facts every ten seconds and the immutable-deployment
facts once per minute.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import time
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib/moos"))
import moos_hardware as hardware
# What each update brought: one reader, shared with the after-update notification.
from moos_whats_new import whats_new_state


def runtime_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        base = Path(runtime) / "moos-settings"
    else:
        cache = os.environ.get("XDG_CACHE_HOME")
        if not cache:
            home = os.environ.get("HOME")
            cache = str(Path(home) / ".cache") if home else "/tmp"
        base = Path(cache) / "moos-settings"
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        base.chmod(0o700)
    except OSError:
        pass
    return base / "status.json"


def command(argv: list[str], timeout: float = 1.5) -> str:
    try:
        result = subprocess.run(
            argv,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
            env={**os.environ, "LC_ALL": "C"},
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


# Fixed destinations mirror moos-open; the regression gate checks both directions.
DESTINATIONS = {
    # MoOS's own page, not the desktop's: that one prints the versions of the toolkit and
    # desktop projects MoOS is built from, under their names (identity contract).
    'about': ('moos-settings', '--section=about'),
    'accessibility': ('systemsettings', 'kcm_access'),
    # Mo AI is part of MoOS's front door: What's new sends a person there to try it.
    'assistant': ('moai',),
    'accounts': ('systemsettings', 'kcm_kaccounts'),
    'audio': ('systemsettings', 'kcm_pulseaudio'),
    'autostart': ('systemsettings', 'kcm_autostart'),
    'bluetooth': ('systemsettings', 'kcm_bluetooth'),
    'default-apps': ('systemsettings', 'kcm_componentchooser'),
    'display': ('systemsettings', 'kcm_kscreen'),
    'energy': ('systemsettings', 'kcm_powerdevilprofilesconfig'),
    'file-search': ('systemsettings', 'kcm_baloofile'),
    'firmware-security': ('kinfocenter', 'kcm_firmware_security'),
    'fonts': ('systemsettings', 'kcm_fonts'),
    'full': ('systemsettings',),
    'hotspot': ('systemsettings', 'kcm_mobile_hotspot'),
    'keyboard': ('systemsettings', 'kcm_keyboard'),
    'lock': ('systemsettings', 'kcm_screenlocker'),
    'mouse': ('systemsettings', 'kcm_mouse'),
    'network': ('systemsettings', 'kcm_networkmanagement'),
    'night-light': ('systemsettings', 'kcm_nightlight'),
    'notifications': ('systemsettings', 'kcm_notifications'),
    'permissions': ('systemsettings', 'kcm_app-permissions'),
    'printers': ('systemsettings', 'kcm_printer_manager'),
    'recovery': ('moos-settings', '--section=recovery'),
    'region': ('systemsettings', 'kcm_regionandlang'),
    'remote': ('moos-settings', '--section=remote'),
    'storage': ('kinfocenter', 'kcm_block_devices'),
    'store': ('moos-store',),
    'system-monitor': ('plasma-systemmonitor',),
    'telemetry': ('systemsettings', 'kcm_feedback'),
    'desktop': ('moos-desktop-edit',),
    'themes': ('moos-theme-picker',),
    'time': ('systemsettings', 'kcm_clock'),
    'touchpad': ('systemsettings', 'kcm_touchpad'),
    'update': ('moos-settings', '--section=update'),
    'usb': ('kinfocenter', 'kcm_usb'),
    'users': ('systemsettings', 'kcm_users'),
    'wallpaper': ('moos-theme-picker',),
    'whats-new': ('moos-settings', '--section=whats-new'),
}


def destinations_state() -> dict[str, bool]:
    # Query Qt's installation, not one architecture-specific plugin directory.
    plugins = command(["qtpaths6", "--query", "QT_INSTALL_PLUGINS"])
    modules = {p.stem for p in (Path(plugins) / "plasma/kcms").rglob("*.so")} if plugins else set()
    return {
        route: bool(shutil.which(argv[0])) and (
            len(argv) == 1 or argv[1].startswith("--") or argv[1] in modules)
        for route, argv in DESTINATIONS.items()
    }


def human_bytes(value: int) -> str:
    units = ("B", "KB", "MB", "GB", "TB")
    amount = float(max(0, value))
    for unit in units:
        if amount < 1024 or unit == units[-1]:
            return f"{amount:.0f} {unit}" if unit != "GB" else f"{amount:.1f} {unit}"
        amount /= 1024
    return "—"


def read_first(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def memory_state() -> dict[str, object]:
    values: dict[str, int] = {}
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            key, raw = line.split(":", 1)
            match = re.search(r"\d+", raw)
            if match:
                values[key] = int(match.group()) * 1024
    except (OSError, ValueError):
        pass
    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable", 0)
    used = max(0, total - available)
    return {
        "total": human_bytes(total),
        "used": human_bytes(used),
        "percent": round(used * 100 / total) if total else 0,
    }


def storage_state() -> dict[str, object]:
    try:
        usage = shutil.disk_usage("/var")
    except OSError:
        return {"total": "—", "free": "—", "percent": 0}
    used = max(0, usage.total - usage.free)
    return {
        "total": human_bytes(usage.total),
        "free": human_bytes(usage.free),
        "percent": round(used * 100 / usage.total) if usage.total else 0,
    }


# These aliases keep the state API stable while sharing the hardware authority.
cpu_name = hardware.cpu_name
gpu_name = hardware.gpu_name


def network_state() -> dict[str, object]:
    raw = command(["nmcli", "-t", "-f", "STATE,CONNECTIVITY", "general"])
    state, _, connectivity = raw.partition(":")
    connected = state.startswith("connected")
    known = bool(state and connectivity)
    active = command(["nmcli", "-t", "-f", "TYPE,NAME", "connection", "show", "--active"])
    label = ""
    for line in active.splitlines():
        kind, _, name = line.partition(":")
        if kind in {"802-11-wireless", "wifi", "802-3-ethernet", "ethernet"} and name:
            label = name.replace(r"\:", ":")
            break
    return {
        "known": known,
        "connectivity": connectivity if known else "unknown",
        "connected": connected,
        "full": connectivity == "full",
        "label": label,
    }


def bluetooth_state() -> dict[str, object]:
    raw = command(["bluetoothctl", "show"])
    available = bool(raw)
    powered = bool(re.search(r"^\s*Powered:\s+yes\s*$", raw, re.MULTILINE))
    return {"available": available, "powered": powered}


def audio_state() -> dict[str, object]:
    raw = command(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    match = re.search(r"Volume:\s*([0-9.]+)", raw)
    volume = round(float(match.group(1)) * 100) if match else 0
    return {"available": bool(match), "volume": volume, "muted": "[MUTED]" in raw}


def battery_state() -> dict[str, object]:
    for battery in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        capacity = read_first(battery / "capacity")
        if capacity.isdigit():
            return {
                "available": True,
                "percent": int(capacity),
                "state": read_first(battery / "status").lower(),
            }
    return {"available": False, "percent": 0, "state": ""}


# ── Identity, normalised once, here ─────────────────────────────────────────
# Every consumer binds these labels, never the raw values: `uname -r` continues with
# the packager's build tag (`-200.fc44.x86_64`), which would put another
# distribution's name on MoOS's own page, and an image name is an address, not a
# product name.
EDITION_LABELS = {
    "moos": {"ar": "MoOS للحواسيب", "en": "MoOS Desktop"},
    "moos-nvidia": {"ar": "MoOS لبطاقات NVIDIA", "en": "MoOS for NVIDIA graphics"},
    "moos-cloud": {"ar": "MoOS السحابي", "en": "MoOS Cloud"},
    "moos-arm": {"ar": "MoOS لمعالجات ARM", "en": "MoOS for ARM"},
}
ARCH_LABELS = {
    "x86_64": {"ar": "64 بت · x86", "en": "64-bit · x86"},
    "aarch64": {"ar": "64 بت · ARM", "en": "64-bit · ARM"},
}


def kernel_label(release: object) -> str:
    """The kernel's own number ("Linux 7.2.7"), or "" when there is none."""
    match = re.match(r"(\d+\.\d+(?:\.\d+)?)", release) if isinstance(release, str) else None
    return f"Linux {match.group(1)}" if match else ""


def edition_label(edition: object) -> dict[str, str]:
    """Which MoOS this is, in words, or nothing at all for an unknown image."""
    return dict(EDITION_LABELS.get(edition, {"ar": "", "en": ""})) if isinstance(edition, str) else {"ar": "", "en": ""}


def arch_label(arch: object) -> dict[str, str]:
    text = arch if isinstance(arch, str) else ""
    return dict(ARCH_LABELS.get(text, {"ar": text, "en": text}))


def session_label(session: object) -> dict[str, str]:
    # The desktop is MoOS's; the display protocol is named only when it is the old one.
    if session == "x11":
        return {"ar": "سطح مكتب MoOS · X11", "en": "MoOS desktop · X11"}
    return {"ar": "سطح مكتب MoOS", "en": "MoOS desktop"}


def state_directory() -> Path:
    configured = os.environ.get("XDG_STATE_HOME")
    base = Path(configured) if configured and Path(configured).is_absolute() else Path.home() / ".local/state"
    return base / "moos"


# ── Applications: the record moos-flatpak-update publishes ──────────────────
APP_UPDATE_STATES = {"ok", "failed", "running"}
APP_ID = re.compile(r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+){2,}\Z")
# A run that has said "running" for this long died without saying so.
APP_UPDATE_RUNNING_LIMIT = 3 * 3600
# Why an application did not update, as a person needs it: a closed set of kinds the
# Update page words in both languages. The updater's own sentence is English and may
# name the machinery underneath; the page keeps it for "Copy details" and never shows
# it. The first kind whose pattern matches wins; the order puts a cause before the
# symptom it produces (a full disk also breaks the download).
FAILURE_KINDS: tuple[tuple[str, re.Pattern[str]], ...] = (
    ("space", re.compile(r"no space left|not enough (?:disk )?space|insufficient (?:disk )?space|enospc|disk (?:is )?full")),
    ("signature", re.compile(r"gpg|signature|not signed|unsigned")),
    ("network", re.compile(r"resolv|unable to connect|failed to connect|could not connect|connection|timed? ?out"
                           r"|network is unreachable|status 5[0-9][0-9]\b|tls|ssl|certificate|proxy")),
    ("missing", re.compile(r"status 404\b|not found|no such ref|end.of.life|no longer (?:available|offered)"
                           r"|nothing matches|no remote refs")),
    ("damaged", re.compile(r"delta|checksum|corrupt|truncated|mismatch")),
    ("permission", re.compile(r"permission denied|not permitted|not allowed|authori[sz]")),
)


def failure_kind(reason: str) -> str:
    text = reason.lower()
    return next((kind for kind, pattern in FAILURE_KINDS if pattern.search(text)), "other")


def apps_state(path: Path | None = None) -> dict[str, object]:
    """Read the per-user application-update record without inventing one.

    A missing, oversized, malformed or future-dated record is "not known": the page
    then says no update was recorded yet, never that the apps are current.
    """
    unknown: dict[str, object] = {"known": False, "state": "", "updated": 0, "failures": []}
    path = path or state_directory() / "app-updates.json"
    try:
        if path.stat().st_size > 65536:
            return unknown
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return unknown
    if not isinstance(record, dict) or record.get("schema") != 1:
        return unknown
    updated, state = record.get("updated"), record.get("state")
    if (not isinstance(updated, int) or isinstance(updated, bool) or updated <= 0
            or updated > time.time() + 300 or state not in APP_UPDATE_STATES):
        return unknown
    failures = []
    raw = record.get("failures", [])
    for item in raw[:20] if isinstance(raw, list) else []:
        if (isinstance(item, dict) and isinstance(item.get("app"), str)
                and len(item["app"]) <= 255 and APP_ID.match(item["app"])
                and isinstance(item.get("reason"), str)):
            reason = " ".join(item["reason"].split())[:200]
            failures.append({"app": item["app"], "kind": failure_kind(reason), "reason": reason})
    if state == "running" and time.time() - updated > APP_UPDATE_RUNNING_LIMIT:
        state = "interrupted"
    return {"known": True, "state": state, "updated": updated, "failures": failures}


def update_state(path: Path = Path("/run/moos/update-state.json")) -> dict[str, object]:
    """Read the updater's single published state machine without resolving it here.

    Settings is a read-only front door. A missing or stale record means that no recent
    check is known; it must never make a network request or invent an update result.
    """
    try:
        if path.stat().st_size > 131072:
            raise ValueError("oversized update state")
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, json.JSONDecodeError):
        record = None
    valid_states = {
        "current", "available", "replace-staged", "staged",
        "blocked-downgrade", "busy", "unknown",
    }
    if not isinstance(record, dict) or record.get("schema") != 1:
        return {"known": False, "state": "", "event": "", "updated": 0,
                "latestVersion": ""}
    updated = record.get("updated")
    state = record.get("state")
    age = time.time() - updated if isinstance(updated, int) and not isinstance(updated, bool) else 901
    if (not isinstance(updated, int) or isinstance(updated, bool) or updated <= 0
            or age < -5 or age > 900 or state not in valid_states):
        return {"known": False, "state": "", "event": "", "updated": 0,
                "latestVersion": ""}
    return {
        "known": True,
        "state": state,
        "event": str(record.get("event", "")),
        "updated": updated,
        "latestVersion": str(record.get("latest_version", "")),
    }


def remote_state() -> dict[str, object]:
    """Cheap user-service facts for the native Settings front door."""
    available = bool(shutil.which("mo-pc-remote"))
    return {
        "available": available,
        "active": available and command(
            ["systemctl", "--user", "is-active", "mo-remote-personal.service"]
        ) == "active",
        "enabled": available and command(
            ["systemctl", "--user", "is-enabled", "mo-remote-personal.service"]
        ) == "enabled",
        "failed": available and command(
            ["systemctl", "--user", "is-failed", "mo-remote-personal.service"]
        ) == "failed",
        # moos-fast-remote's own journal: the file exists exactly while Fast Remote is on.
        "fast": available and (state_directory() / "fast-remote.on").is_file(),
    }


def deployment_state() -> dict[str, object]:
    raw = command(["rpm-ostree", "status", "--json"], timeout=4)
    try:
        deployments = json.loads(raw).get("deployments", [])
        if not isinstance(deployments, list) or not all(isinstance(d, dict) for d in deployments):
            deployments = []
    except (json.JSONDecodeError, AttributeError):
        deployments = []
    booted_index = next((index for index, item in enumerate(deployments)
                         if item.get("booted")), None)
    booted = deployments[booted_index] if booted_index is not None else {}
    staged = next((item for item in deployments if item.get("staged")), {})
    # The system this machine ran BEFORE its last update: the deployment kept for rollback.
    previous = next((item for item in deployments
                     if not item.get("booted") and not item.get("staged")), {})
    # The default boot entry can be ahead of the running deployment. A staged
    # upgrade also sorts ahead, but is not a queued rollback (see moos-rollback).
    ahead = ([item for item in deployments[:booted_index] if not item.get("staged")]
             if booted_index is not None else [])
    rollback_queued = bool(ahead)
    if rollback_queued:
        rollback_target = ahead[0]
    elif booted_index is not None:
        rollback_target = next(
            (item for item in deployments[booted_index + 1:] if not item.get("staged")), {}
        )
    else:
        rollback_target = {}
    previous_built = previous.get("timestamp")
    reference = str(booted.get("container-image-reference", ""))
    digest = str(booted.get("container-image-reference-digest", ""))
    edition = re.search(
        r"/moalfarras-sys/(moos(?:-nvidia|-cloud|-arm)?)(?=[@:]|$)", reference)
    built = booted.get("timestamp")
    return {
        # Which MoOS this is, and when that image was built. Both come from the booted
        # deployment's own record; an unknown origin answers "" / 0, never a guess.
        "edition": edition.group(1) if edition else "",
        "builtAt": built if isinstance(built, int) and not isinstance(built, bool) and built > 0 else 0,
        "version": str(booted.get("version", "—")),
        "digest": digest[7:19] if digest.startswith("sha256:") else "",
        "known": bool(booted and reference),
        "signed": bool(re.fullmatch(
            r"ostree-image-signed:docker://ghcr\.io/moalfarras-sys/"
            r"(?:moos|moos-nvidia|moos-cloud|moos-arm)"
            r"(?:@sha256:[0-9a-f]{64}|:[A-Za-z0-9][A-Za-z0-9._-]*)", reference
        )),
        "staged": bool(staged),
        "stagedVersion": str(staged.get("version", "")),
        "previousVersion": str(previous.get("version", "")),
        "previousBuiltAt": (previous_built if isinstance(previous_built, int)
                            and not isinstance(previous_built, bool) and previous_built > 0 else 0),
        "rollback": sum(
            1 for item in deployments if not item.get("booted") and not item.get("staged")
        ),
        "rollbackQueued": rollback_queued,
        "rollbackTarget": str(rollback_target.get("version", "")),
    }


def dynamic_state() -> dict[str, object]:
    try:
        uptime = int(float(read_first(Path("/proc/uptime")).split()[0]))
    except (ValueError, IndexError):
        uptime = 0
    return {
                "uptimeSeconds": uptime,
        "network": network_state(),
        "bluetooth": bluetooth_state(),
        "audio": audio_state(),
        "battery": battery_state(),
        "memory": memory_state(),
        "update": update_state(),
        "remote": remote_state(),
        "apps": apps_state(),
    }


def full_state() -> dict[str, object]:
    deployment = deployment_state()
    kernel = command(["uname", "-r"]) or "—"
    arch = os.uname().machine
    session = os.environ.get("XDG_SESSION_TYPE", "")
    return {
        "schema": 1,
        "product": "MoOS",
        "hostname": command(["hostname", "-s"]) or "MoOS",
        "kernel": kernel,
        "kernelLabel": kernel_label(kernel),
        "editionLabel": edition_label(deployment.get("edition")),
        "arch": arch,
        "archLabel": arch_label(arch),
        "session": session,
        "sessionLabel": session_label(session),
        "cpu": cpu_name(),
        "gpu": gpu_name(),
        "storage": storage_state(),
        "deployment": deployment,
        "whatsNew": whats_new_state(int(deployment.get("previousBuiltAt") or 0)),
        "destinations": destinations_state(),
        **dynamic_state(),
    }


def publish(path: Path, state: dict[str, object]) -> None:
    fd, temporary = tempfile.mkstemp(prefix=".status-", suffix=".json", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({**state, "generatedAt": int(time.time())}, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def process_start(pid: int) -> str:
    try:
        # /proc/PID/stat fields after the final ')' begin at field 3; starttime
        # is field 22, therefore index 19 in this suffix.
        suffix = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").rsplit(")", 1)[1]
        return suffix.split()[19]
    except (OSError, IndexError):
        return ""


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--watch-pid", type=int)
    args = parser.parse_args()

    path = runtime_path()
    state = full_state()
    publish(path, state)
    if not args.watch_pid:
        return 0

    start = process_start(args.watch_pid)
    if not start:
        return 0
    cycle = 0
    while process_start(args.watch_pid) == start:
        time.sleep(10)
        if process_start(args.watch_pid) != start:
            break
        cycle += 1
        if cycle % 6 == 0:
            state = full_state()
        else:
            state.update(dynamic_state())
        publish(path, state)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
