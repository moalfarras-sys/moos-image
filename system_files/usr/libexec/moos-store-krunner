#!/usr/bin/python3
"""moos-store-krunner — Mo Store in Plasma's search bar (KRunner D-Bus runner).

WHY: typing "gimp", "libreoffice" or "واتساب" into MoOS Search used to find nothing unless the app
was already installed. Discover's own AppStream runner is switched off on purpose (it opened a
second, hidden store; see /etc/xdg/krunnerrc). This runner answers from Mo Store's own local
index instead — Linux apps, web apps, Windows programs and Android apps alike — and a chosen
result opens that app's page in Mo Store.

Safety: this runner only SUGGESTS and only OPENS A PAGE. Nothing is installed from the search bar:
the install button, its review and its consent stay in Mo Store. A chosen id is looked up again
in the index before anything starts, and Mo Store is started with one argv element, never a shell.

Cost: started on demand by D-Bus activation, it reads the local index once (re-read only when the
file changes), never touches the network, and exits after ten idle minutes.
"""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

SERVICE = "org.moos.StoreRunner"
PATH = "/runner"
ICON = "moos-store"
STORE = "/usr/bin/moos-store"
IDLE_SECONDS = 600
LIMIT = 5
ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{1,254}$")
# KRunner match types (KRunner::QueryMatch::Type).
POSSIBLE, EXACT = 30, 100

INTERFACE = """<node>
  <interface name="org.kde.krunner1">
    <method name="Actions"><arg type="a(sss)" direction="out"/></method>
    <method name="Match">
      <arg name="query" type="s" direction="in"/>
      <arg type="a(sssida{sv})" direction="out"/>
    </method>
    <method name="Run">
      <arg name="matchId" type="s" direction="in"/>
      <arg name="actionId" type="s" direction="in"/>
    </method>
    <method name="Config"><arg type="a{sv}" direction="out"/></method>
    <method name="Teardown"/>
  </interface>
</node>"""

# Arabic is matched the way people type it: no diacritics or tatweel, every alef the same,
# ta marbuta like ha, alef maqsura like ya, and either kind of digit.
_MARKS = re.compile("[ؐ-ًؚ-ٰٟۖ-ۭـ​-‏⁦-⁩]")
_FOLD = str.maketrans({"أ": "ا", "إ": "ا", "آ": "ا", "ٱ": "ا", "ى": "ي", "ئ": "ي", "ؤ": "و",
                       "ة": "ه", "٠": "0", "١": "1", "٢": "2", "٣": "3", "٤": "4", "٥": "5",
                       "٦": "6", "٧": "7", "٨": "8", "٩": "9"})
_SPACE = re.compile(r"[\s _.\-+/()|·]+")


def fold(text: object) -> str:
    if not isinstance(text, str):
        return ""
    text = _MARKS.sub("", text.lower()).translate(_FOLD)
    return _SPACE.sub(" ", text).strip()


def arabic_session() -> bool:
    for name in ("LC_ALL", "LC_MESSAGES", "LANG", "LANGUAGE"):
        value = os.environ.get(name, "")
        if value:
            return value.startswith("ar")
    return False


def index_path() -> Path:
    cache = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    return Path(cache) / "moos-store" / "index.json"


class Index:
    """A compact search table built from Mo Store's index; reloaded when the file changes."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.stamp: tuple[int, int] | None = None
        self.rows: list[dict] = []
        self.by_id: dict[str, dict] = {}

    def refresh(self) -> None:
        try:
            info = self.path.stat()
        except OSError:
            self.stamp, self.rows, self.by_id = None, [], {}
            return
        stamp = (info.st_mtime_ns, info.st_size)
        if stamp == self.stamp:
            return
        try:
            with self.path.open(encoding="utf-8") as handle:
                document = json.load(handle)
        except (OSError, ValueError):
            return
        rows = []
        for app in document.get("apps", []) if isinstance(document, dict) else []:
            if not isinstance(app, dict):
                continue
            app_id = app.get("id")
            if not isinstance(app_id, str) or not ID_PATTERN.fullmatch(app_id):
                continue
            if app.get("installed") or app.get("installable") is False:
                continue
            english = app.get("en") or (app.get("name") if not app.get("ar") else "") or app_id
            arabic = app.get("ar") or ""
            summary_en = app.get("desc_en") or (app.get("summary") if not app.get("desc_ar") else "")
            summary_ar = app.get("desc_ar") or ""
            rows.append({
                "id": app_id,
                "en": str(english)[:80],
                "ar": str(arabic)[:80],
                "summary_en": str(summary_en or "")[:140],
                "summary_ar": str(summary_ar or "")[:140],
                # A reverse-DNS id ends in the name people use: org.gimp.GIMP, com.valvesoftware.Steam.
                "names": [name for name in {fold(english), fold(arabic), fold(app.get("name")),
                                            fold(app_id.rsplit(".", 1)[-1]) if "." in app_id else ""}
                          if name],
                "about": fold(" ".join(str(part) for part in (summary_en, summary_ar,
                                                               app.get("developer") or "")))[:400],
                "curated": bool(app.get("curated")),
                "verified": bool(app.get("verified")),
            })
        self.rows = rows
        self.by_id = {row["id"]: row for row in rows}
        self.stamp = stamp


def score(row: dict, query: str) -> float:
    best = 0.0
    for name in row["names"]:
        if name == query:
            best = max(best, 1.0)
        elif name.startswith(query):
            best = max(best, 0.86)
        elif any(word.startswith(query) for word in name.split()):
            best = max(best, 0.74)
        elif query in name:
            best = max(best, 0.6)
    if best == 0.0 and len(query) >= 4 and query in row["about"]:
        best = 0.32
    if best:
        best += 0.04 * row["curated"] + 0.02 * row["verified"]
    return best


def match(index: Index, query: str) -> list[tuple]:
    text = fold(query)
    if len(text) < 2 or len(text) > 120:
        return []
    index.refresh()
    scored = [(score(row, text), row) for row in index.rows]
    scored = [item for item in scored if item[0] > 0]
    scored.sort(key=lambda item: (-item[0], item[1]["en"].lower()))
    arabic = arabic_session()
    results = []
    for relevance, row in scored[:LIMIT]:
        name = (row["ar"] or row["en"]) if arabic else row["en"]
        summary = (row["summary_ar"] or row["summary_en"]) if arabic else row["summary_en"]
        label = f"ثبّت «{name}» من متجر MoOS" if arabic else f"Get {name} from Mo Store"
        subtext = summary or ("متجر MoOS" if arabic else "Mo Store")
        kind = EXACT if relevance >= 1.0 else POSSIBLE
        results.append(("app:" + row["id"], label, ICON, kind, min(relevance, 1.0), subtext))
    return results


def open_page(app_id: str) -> None:
    subprocess.Popen([STORE, f"--app={app_id}"], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def run(index: Index, match_id: str) -> bool:
    """Open the chosen app's page. KRunner hands the id back as a string: check it again."""
    if not isinstance(match_id, str) or not match_id.startswith("app:"):
        return False
    app_id = match_id[len("app:"):]
    if not ID_PATTERN.fullmatch(app_id):
        return False
    index.refresh()
    if app_id not in index.by_id:
        return False
    open_page(app_id)
    return True


def main() -> int:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    index = Index(index_path())
    node = Gio.DBusNodeInfo.new_for_xml(INTERFACE)
    loop = GLib.MainLoop()
    last_call = [time.monotonic()]

    def on_call(_connection, _sender, _path, _interface, method, parameters, invocation):
        last_call[0] = time.monotonic()
        if method == "Match":
            rows = [(mid, label, icon, kind, relevance, {"subtext": GLib.Variant("s", subtext)})
                    for mid, label, icon, kind, relevance, subtext
                    in match(index, parameters.unpack()[0])]
            invocation.return_value(GLib.Variant("(a(sssida{sv}))", (rows,)))
        elif method == "Run":
            run(index, parameters.unpack()[0])
            invocation.return_value(None)
        elif method == "Actions":
            invocation.return_value(GLib.Variant("(a(sss))", ([],)))
        elif method == "Config":
            invocation.return_value(GLib.Variant("(a{sv})", ({},)))
        else:
            invocation.return_value(None)

    def on_bus(connection, _name):
        register = getattr(connection, "register_object_with_closures2", None)
        if register is not None:
            register(PATH, node.interfaces[0], on_call, None, None)
        else:
            connection.register_object(PATH, node.interfaces[0], on_call, None, None)

    def idle_check():
        if time.monotonic() - last_call[0] > IDLE_SECONDS:
            loop.quit()
            return False
        return True

    Gio.bus_own_name(Gio.BusType.SESSION, SERVICE, Gio.BusNameOwnerFlags.NONE,
                     on_bus, None, lambda *_args: loop.quit())
    GLib.timeout_add_seconds(60, idle_check)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
