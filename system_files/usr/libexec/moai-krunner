#!/usr/bin/python3
"""moai-krunner — Mo AI in Plasma's search bar (KRunner D-Bus runner).

WHY: MoOS is built on Plasma, and the owner wants Plasma itself to feel like
MoOS's own, clever shell. Typing "volume 40", "السطوع 70", "لقطة شاشة" or
"dark mode" into the search bar now offers the change as a result, and any
question can be handed to Mo AI in one step.

Safety: this runner only SUGGESTS. Nothing happens until the user picks a
result. Every control result is a fixed moos:// route from a closed grammar
(moos-open validates it again, and Wi-Fi off still asks first); a question is
passed to Mo AI as one argv element, never through a shell.
"""
import base64
import os
import re
import subprocess
import sys
from pathlib import Path

SERVICE = "org.moos.MoAIRunner"
PATH = "/runner"
EXACT, POSSIBLE = 100, 30
# Every icon is a MoOS-owned asset, so no result ever shows a missing-icon glyph.
ASK_ICON = "moos-moai"

INTERFACE = """<node>
  <interface name="org.kde.krunner1">
    <method name="Actions"><arg type="a(sss)" direction="out"/></method>
    <method name="Match">
      <arg name="query" type="s" direction="in"/>
      <arg type="a(sssida{sv})" direction="out"/>
    </method>
    <method name="Run">
      <arg name="matchId" type="s" direction="in"/>
      <arg name="actionId" type="s" direction="in"/>
    </method>
    <method name="Config"><arg type="a{sv}" direction="out"/></method>
    <method name="Teardown"/>
  </interface>
</node>"""

ARABIC_DIGITS = str.maketrans("٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹", "01234567890123456789")
TO = r"(?:\s+(?:to|الى|إلى))?"
PERCENT = r"\s*[%٪]?"
THEMES = ("dark", "light", "nova", "amethyst", "midnight", "aurora", "auto")
ON = ("on", "شغل", "شغّل", "تشغيل")
OFF = ("off", "اطفئ", "أطفئ", "اطفي", "ايقاف", "إيقاف")
ARRANGE_AR = {"نصفين": "halves", "نصفان": "halves", "أثلاث": "thirds", "اثلاث": "thirds",
              "أرباع": "quarters", "ارباع": "quarters", "رئيسية": "main",
              "وسط": "centre", "المنتصف": "centre", "بالمنتصف": "centre"}
ARRANGE_LABEL = {"halves": ("Arrange windows: halves", "رتّب النوافذ نصفين"),
                 "thirds": ("Arrange windows: thirds", "رتّب النوافذ أثلاثاً"),
                 "quarters": ("Arrange windows: quarters", "رتّب النوافذ أرباعاً"),
                 "main": ("Arrange windows: main and two", "نافذة رئيسية ونافذتان"),
                 "centre": ("Centre this window", "النافذة في المنتصف")}
MOTION_AR = {"ثابتة": "still", "هادئة": "gentle", "حية": "alive", "حيّة": "alive"}
CLARITY_AR = {"شفاف": "clear", "متوازن": "balanced", "صلب": "solid", "معتم": "solid"}
# Every route a rule can build is written out whole, so the set this runner may open can be
# read straight from its source (tests/verify_user_experience.py does exactly that).
ARRANGE_ROUTE = {"halves": "control/arrange/halves", "thirds": "control/arrange/thirds",
                 "quarters": "control/arrange/quarters", "main": "control/arrange/main",
                 "centre": "control/arrange/centre"}
MOTION_ROUTE = {"still": "control/motion/still", "gentle": "control/motion/gentle",
                "alive": "control/motion/alive"}
CLARITY_ROUTE = {"clear": "control/clarity/clear", "balanced": "control/clarity/balanced",
                 "solid": "control/clarity/solid"}
MIC = r"(?:mic|microphone)"
MIC_AR = r"(?:المايك|الميكروفون|الميكرفون|المايكروفون)"


def _arrange(match):
    word = (match.group(1) or match.group(2) or "halves").replace("center", "centre")
    return ARRANGE_AR.get(word, word)

# (pattern, route builder, English label, Arabic label, icon). Every route this
# runner can produce is one of these shapes and nothing else.
RULES = [
    (rf"^(?:volume|sound|vol|الصوت|صوت){TO}\s+(100|[0-9]{{1,2}}){PERCENT}$",
     lambda m: f"control/volume/{int(m.group(1))}",
     lambda m: f"Volume {int(m.group(1))}%", lambda m: f"الصوت {int(m.group(1))}%", "moos-volume-symbolic"),
    (r"^(?:volume up|sound up|louder|ارفع الصوت|علي الصوت|علّي الصوت)$",
     lambda m: "control/volume/up", lambda m: "Volume up", lambda m: "ارفع الصوت", "moos-volume-symbolic"),
    (r"^(?:volume down|sound down|quieter|اخفض الصوت|أخفض الصوت|وطي الصوت|وطّي الصوت)$",
     lambda m: "control/volume/down", lambda m: "Volume down", lambda m: "اخفض الصوت", "moos-volume-symbolic"),
    (r"^(?:mute|اكتم الصوت|كتم الصوت|اكتم|كتم)$",
     lambda m: "control/mute", lambda m: "Mute", lambda m: "كتم الصوت", "moos-volume-off-symbolic"),
    (r"^(?:unmute|الغاء الكتم|إلغاء الكتم)$",
     lambda m: "control/unmute", lambda m: "Unmute", lambda m: "إلغاء الكتم", "moos-volume-symbolic"),
    (rf"^(?:brightness|السطوع|سطوع){TO}\s+(100|[1-9][0-9]|[5-9]){PERCENT}$",
     lambda m: f"control/brightness/{int(m.group(1))}",
     lambda m: f"Brightness {int(m.group(1))}%", lambda m: f"السطوع {int(m.group(1))}%", "moos-sun-symbolic"),
    (r"^(?:brightness up|brighter|زد السطوع|ارفع السطوع)$",
     lambda m: "control/brightness/up", lambda m: "Brightness up", lambda m: "زد السطوع", "moos-sun-symbolic"),
    (r"^(?:brightness down|dimmer|خفف السطوع|خفّف السطوع|اخفض السطوع)$",
     lambda m: "control/brightness/down", lambda m: "Brightness down", lambda m: "خفّف السطوع", "moos-sun-symbolic"),
    (r"^(?:night light|night mode|الضوء الليلي|الوضع الليلي)(?:\s+(?:on|شغل|شغّل|تشغيل))?$",
     lambda m: "control/night-light/on", lambda m: "Night light on", lambda m: "شغّل الضوء الليلي", "moos-moon-symbolic"),
    (r"^(?:night light|night mode|الضوء الليلي|الوضع الليلي)\s+(?:off|اطفئ|أطفئ|اطفي|ايقاف|إيقاف)$",
     lambda m: "control/night-light/off", lambda m: "Night light off", lambda m: "أطفئ الضوء الليلي", "moos-moon-symbolic"),
    (r"^(?:screenshot|screen shot|لقطة شاشة|لقطه شاشه|صورة الشاشة|صوره الشاشه)$",
     lambda m: "control/screenshot", lambda m: "Take a screenshot", lambda m: "التقط لقطة شاشة", "moos-camera-symbolic"),
    (r"^(?:dark mode|dark theme|الوضع الداكن|المظهر الداكن|داكن)$",
     lambda m: "theme/dark", lambda m: "Dark mode", lambda m: "الوضع الداكن", "moos-ui-symbolic"),
    (r"^(?:light mode|light theme|الوضع الفاتح|المظهر الفاتح|فاتح)$",
     lambda m: "theme/light", lambda m: "Light mode", lambda m: "الوضع الفاتح", "moos-ui-symbolic"),
    (r"^(?:bluetooth|البلوتوث|بلوتوث)\s+(on|off|شغل|شغّل|اطفئ|أطفئ)$",
     lambda m: "control/bluetooth/on" if m.group(1) in ("on", "شغل", "شغّل") else "control/bluetooth/off",
     lambda m: "Bluetooth " + ("on" if m.group(1) in ("on", "شغل", "شغّل") else "off"),
     lambda m: "شغّل البلوتوث" if m.group(1) in ("on", "شغل", "شغّل") else "أطفئ البلوتوث", "moos-bluetooth-symbolic"),
    (r"^(?:wifi|wi-fi|الواي فاي|واي فاي)\s+(on|off|شغل|شغّل|اطفئ|أطفئ)$",
     lambda m: "control/wifi/on" if m.group(1) in ("on", "شغل", "شغّل") else "control/wifi/off",
     lambda m: "Wi-Fi " + ("on" if m.group(1) in ("on", "شغل", "شغّل") else "off (asks first)"),
     lambda m: "شغّل الواي فاي" if m.group(1) in ("on", "شغل", "شغّل") else "أطفئ الواي فاي (يسأل أولاً)", "moos-wifi-symbolic"),
    # ── SPEC D4: the desktop's own actions ──────────────────────────────────
    (r"^(?:do not disturb|dnd)(?:\s+(on|off))?$"
     r"|^(?:وضع\s+)?عدم\s+(?:الإزعاج|الازعاج)(?:\s+(شغل|شغّل|تشغيل|اطفئ|أطفئ|اطفي|ايقاف|إيقاف))?$",
     lambda m: "control/dnd/off" if (m.group(1) or m.group(2)) in OFF else "control/dnd/on",
     lambda m: "Do not disturb " + ("off" if (m.group(1) or m.group(2)) in OFF else "on"),
     lambda m: "أطفئ عدم الإزعاج" if (m.group(1) or m.group(2)) in OFF else "شغّل عدم الإزعاج",
     "moos-notification-symbolic"),
    (r"^لا\s+تزعجني$",
     lambda m: "control/dnd/on", lambda m: "Do not disturb on", lambda m: "شغّل عدم الإزعاج",
     "moos-notification-symbolic"),
    (rf"^(?:mute\s+(?:the\s+)?{MIC}|{MIC}\s+(?:off|mute))$|^(?:اكتم|كتم)\s+{MIC_AR}$",
     lambda m: "control/mic/mute", lambda m: "Mute the microphone", lambda m: "اكتم الميكروفون",
     "moos-microphone-symbolic"),
    (rf"^(?:unmute\s+(?:the\s+)?{MIC}|{MIC}\s+(?:on|unmute))$"
     rf"|^(?:(?:الغاء|إلغاء)\s+كتم|شغل|شغّل)\s+{MIC_AR}$",
     lambda m: "control/mic/unmute", lambda m: "Unmute the microphone", lambda m: "شغّل الميكروفون",
     "moos-microphone-symbolic"),
    (r"^(?:(?:next|switch)\s+(?:keyboard\s+)?layout|switch\s+keyboard(?:\s+layout)?)$"
     r"|^(?:بدّل|بدل|غيّر|غير|تبديل|تغيير)\s+(?:لغة\s+)?(?:الكيبورد|لوحة المفاتيح|لغة الكتابة)$",
     lambda m: "control/keyboard-layout/next", lambda m: "Next keyboard layout",
     lambda m: "بدّل لغة لوحة المفاتيح", "moos-keyboard-symbolic"),
    (r"^(?:overview|window overview|show (?:all )?windows)$|^(?:نظرة عامة|عرض النوافذ|اعرض النوافذ|كل النوافذ)$",
     lambda m: "control/window/overview", lambda m: "Window overview",
     lambda m: "نظرة عامة على النوافذ", "moos-grid-symbolic"),
    (r"^(?:grid view|desktop grid|all desktops)$|^(?:شبكة أسطح المكتب|كل أسطح المكتب)$",
     lambda m: "control/window/grid", lambda m: "Desktop grid", lambda m: "شبكة أسطح المكتب",
     "moos-grid-symbolic"),
    (r"^show (?:the )?desktop$|^(?:اظهر|أظهر|إظهار|اظهار)\s+سطح\s+المكتب$",
     lambda m: "control/window/show-desktop", lambda m: "Show the desktop",
     lambda m: "أظهر سطح المكتب", "moos-home-symbolic"),
    (r"^(?:arrange|tile)(?:\s+(?:the\s+)?windows)?(?:\s+(?:in\s+|as\s+)?(halves|thirds|quarters|main|centre|center))?$"
     r"|^(?:رتب|رتّب|ترتيب)(?:\s+النوافذ)?(?:\s+(نصفين|نصفان|أثلاث|اثلاث|أرباع|ارباع|رئيسية|وسط|المنتصف|بالمنتصف))?$",
     lambda m: ARRANGE_ROUTE[_arrange(m)],
     lambda m: ARRANGE_LABEL[_arrange(m)][0], lambda m: ARRANGE_LABEL[_arrange(m)][1],
     "moos-grid-symbolic"),
    (r"^(next|previous)\s+desktop$|^سطح\s+المكتب\s+(التالي|السابق)$",
     lambda m: ("control/desktop/next" if (m.group(1) or m.group(2)) in ("next", "التالي")
                else "control/desktop/previous"),
     lambda m: ("Next" if (m.group(1) or m.group(2)) in ("next", "التالي") else "Previous") + " desktop",
     lambda m: "سطح المكتب " + ("التالي" if (m.group(1) or m.group(2)) in ("next", "التالي") else "السابق"),
     "moos-arrow-symbolic"),
    (r"^(?:wallpaper\s+)?motion\s+(still|gentle|alive)$|^(?:الحركة|حركة الخلفية)\s+(ثابتة|هادئة|حية|حيّة)$",
     lambda m: MOTION_ROUTE[m.group(1) or MOTION_AR[m.group(2)]],
     lambda m: "Wallpaper motion: " + (m.group(1) or MOTION_AR[m.group(2)]),
     lambda m: "حركة الخلفية: " + (m.group(2) or {v: k for k, v in MOTION_AR.items()}[m.group(1)]),
     "moos-wave-symbolic"),
    (r"^(?:glass\s+)?clarity\s+(clear|balanced|solid)$|^(?:وضوح\s+الزجاج|الزجاج)\s+(شفاف|متوازن|صلب|معتم)$",
     lambda m: CLARITY_ROUTE[m.group(1) or CLARITY_AR[m.group(2)]],
     lambda m: "Glass clarity: " + (m.group(1) or CLARITY_AR[m.group(2)]),
     lambda m: "وضوح الزجاج: " + (m.group(2) or {v: k for k, v in CLARITY_AR.items()}[m.group(1)]),
     "moos-diamond-symbolic"),
    (r"^(?:power saver|power saving|battery saver)(?:\s+mode)?$|^(?:وضع\s+)?توفير\s+(?:الطاقة|البطارية)$",
     lambda m: "control/power-profile/power-saver", lambda m: "Power saver",
     lambda m: "وضع توفير الطاقة", "moos-battery-symbolic"),
    (r"^(?:performance|high performance)(?:\s+mode)?$|^(?:وضع\s+)?الأداء(?:\s+العالي)?$",
     lambda m: "control/power-profile/performance", lambda m: "Performance mode",
     lambda m: "وضع الأداء", "moos-bolt-symbolic"),
    (r"^balanced(?:\s+(?:power|mode))$|^(?:الوضع|وضع)\s+المتوازن$|^طاقة\s+متوازنة$",
     lambda m: "control/power-profile/balanced", lambda m: "Balanced power",
     lambda m: "الوضع المتوازن", "moos-bolt-symbolic"),
]


def _settings_pages():
    """(token, label) of every page Mo AI may open: the ONE settings registry (SPEC D3).

    An unreadable registry offers no settings result; every other result still works.
    """
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib/moos"))
    try:
        import moos_settings_destinations as destinations
    except ImportError:
        return ()
    finally:
        sys.path.pop(0)
    registry = destinations.safe_load(
        Path(__file__).resolve().parent.parent / "share/moos/settings-destinations.json")
    return tuple((token, registry[token]["label"]) for token in destinations.moai_tokens(registry))


SETTINGS_PAGES = _settings_pages()


def _settings_rule(token, label):
    en, ar = re.escape(label["en"].lower()), re.escape(label["ar"].lower())
    pattern = (rf"^(?:open\s+)?(?:the\s+)?{en}\s+settings$|^settings\s+{en}$"
               rf"|^(?:افتح\s+)?(?:إعدادات|اعدادات)\s+{ar}$")
    return (pattern, lambda m, t=token: f"settings/{t}",
            lambda m, l=label: f"Open settings: {l['en']}",
            lambda m, l=label: f"افتح إعدادات: {l['ar']}", "moos-settings-symbolic")


RULES += [_settings_rule(token, label) for token, label in SETTINGS_PAGES]
RULES = [(re.compile(pattern), route, en, ar, icon) for pattern, route, en, ar, icon in RULES]

ALLOWED_ROUTE = re.compile(
    r"^(?:control/volume/(?:100|[0-9]{1,2}|up|down)|control/mute|control/unmute"
    r"|control/brightness/(?:100|[1-9][0-9]|[5-9]|up|down)|control/night-light/(?:on|off)"
    r"|control/screenshot|control/bluetooth/(?:on|off)|control/wifi/(?:on|off)"
    r"|control/dnd/(?:on|off)|control/mic/(?:mute|unmute)|control/keyboard-layout/next"
    r"|control/window/(?:overview|grid|show-desktop)"
    r"|control/arrange/(?:halves|thirds|quarters|main|centre)"
    r"|control/desktop/(?:next|previous)|control/motion/(?:still|gentle|alive)"
    r"|control/clarity/(?:clear|balanced|solid)"
    r"|control/power-profile/(?:power-saver|balanced|performance)"
    r"|theme/(?:" + "|".join(THEMES) + r")"
    + "".join(f"|settings/{re.escape(token)}" for token, _label in SETTINGS_PAGES) + r")$")
ASK_PREFIX = re.compile(r"^(?:ask|ai|mo ?ai|اسأل|اسال|سؤال)\s*[:،,]?\s+", re.IGNORECASE)


def arabic_session():
    language = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return language.split(".")[0].split("_")[0] in ("ar", "fa", "he", "ur")


def normalize(query):
    text = (query or "").translate(ARABIC_DIGITS).strip().lower()
    return re.sub(r"\s+", " ", text)


def encode(question):
    return base64.urlsafe_b64encode(question.encode("utf-8")).decode("ascii").rstrip("=")


def decode(token):
    padded = token + "=" * (-len(token) % 4)
    return base64.urlsafe_b64decode(padded.encode("ascii")).decode("utf-8")


def match(query):
    """Return [(id, text, icon, type, relevance, subtext)] for one KRunner query."""
    text = normalize(query)
    if len(text) < 2 or len(text) > 500:
        return []
    arabic = arabic_session()
    results = []
    for pattern, route, en, ar, icon in RULES:
        found = pattern.match(text)
        if found:
            target = route(found)
            if ALLOWED_ROUTE.match(target):
                label = ar(found) if arabic else en(found)
                results.append(("route:" + target, label, icon, EXACT, 1.0,
                                "Mo AI · تحكّم بالجهاز" if arabic else "Mo AI · control this computer"))
            break
    question = ASK_PREFIX.sub("", (query or "").strip(), count=1)
    explicit = question != (query or "").strip()
    asks = explicit or text.endswith(("?", "؟")) or len(text.split()) >= 4
    if asks and len(question.strip()) >= 2:
        question = question.strip()[:2000]
        label = ("اسأل Mo AI: " if arabic else "Ask Mo AI: ") + question
        results.append(("ask:" + encode(question), label, ASK_ICON,
                        EXACT if explicit else POSSIBLE, 0.9 if explicit else 0.4,
                        "Mo AI · سؤال" if arabic else "Mo AI · question"))
    return results


def open_route(route):
    subprocess.Popen(["xdg-open", "moos://" + route], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def ask(question):
    subprocess.Popen(["moai", "--panel", "chat", "--ask", question], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def run(match_id):
    """Perform a chosen result. Ids are re-validated: KRunner hands back strings."""
    if match_id.startswith("route:"):
        route = match_id[len("route:"):]
        if not ALLOWED_ROUTE.match(route):
            return False
        open_route(route)
        return True
    if match_id.startswith("ask:"):
        try:
            question = decode(match_id[len("ask:"):]).strip()
        except (ValueError, UnicodeDecodeError):
            return False
        if not question or len(question) > 2000:
            return False
        ask(question)
        return True
    return False


def main():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    node = Gio.DBusNodeInfo.new_for_xml(INTERFACE)
    loop = GLib.MainLoop()

    def on_call(_connection, _sender, _path, _interface, method, parameters, invocation):
        if method == "Match":
            matches = [(mid, label, icon, kind, relevance, {"subtext": GLib.Variant("s", subtext)})
                       for mid, label, icon, kind, relevance, subtext in match(parameters.unpack()[0])]
            invocation.return_value(GLib.Variant("(a(sssida{sv}))", (matches,)))
        elif method == "Run":
            run(parameters.unpack()[0])
            invocation.return_value(None)
        elif method == "Actions":
            invocation.return_value(GLib.Variant("(a(sss))", ([],)))
        elif method == "Config":
            invocation.return_value(GLib.Variant("(a{sv})", ({},)))
        else:
            invocation.return_value(None)

    def on_bus(connection, _name):
        # PyGObject deprecated register_object in favour of the closures2 form;
        # use it where present so the session journal stays free of warnings.
        register = getattr(connection, "register_object_with_closures2", None)
        if register is not None:
            register(PATH, node.interfaces[0], on_call, None, None)
        else:
            connection.register_object(PATH, node.interfaces[0], on_call, None, None)

    Gio.bus_own_name(Gio.BusType.SESSION, SERVICE, Gio.BusNameOwnerFlags.NONE,
                     on_bus, None, lambda *_args: loop.quit())
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
