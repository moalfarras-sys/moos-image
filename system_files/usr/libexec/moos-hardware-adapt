#!/usr/bin/env bash
# moos-hardware-adapt — MoOS "plants itself" into the machine it is installed on.
#
# On an image-based OS (bootc/ostree) MOST hardware adaptation is already baked
# into the image or handled by static config + udev (CPU microcode is early-loaded
# from the prebuilt initramfs, GPU mesa drivers ship in the image, TRIM is the
# weekly fstrim.timer, the I/O scheduler is a static udev rule, base zram comes
# from zram-generator-defaults). This service does ONLY the small, curated set of
# SAFE runtime tweaks that genuinely depend on the specific machine — the exact
# division of labour Bazzite's hardware-setup uses. It is deliberately narrow:
# it must never be able to brick or overheat a machine (see the DO-NOT list below).
#
# WHAT IT WILL NEVER DO (the anti-brick / anti-overheat contract):
#   * flash/apply BIOS/UEFI/device firmware (only refresh metadata + surface it)
#   * raise power/thermal limits, undervolt/overclock, or set custom fan curves
#   * disable thermal throttling
#   * compile or install GPU drivers at runtime (NVIDIA is a build-time image
#     variant — runtime only ADVISES a rebase)
#   * write CPU microcode (early-loaded from the initramfs already)
#   * apply arbitrary kernel args (none here; kargs stay hand-curated in the image)
#   * touch Secure Boot keys, the bootloader, or the partition/LUKS layout
#   * co-install conflicting power daemons (tuned-ppd is the Fedora default; keep it)
#
# IDEMPOTENT & RE-RUNNABLE: state lives in /etc/moos/hardware-adapt.state, keyed on
# a revision number AND the booted image name. A `bootc switch`/rebase or a bumped
# HW_REV re-triggers; an ordinary boot no-ops in milliseconds. Test-overridable via
# MOOS_HW_STATE / MOOS_HW_SYSFS / MOOS_HW_DRYRUN so the gate can exercise it.
set -uo pipefail

# Bumped 1 -> 2 on 2026-07-27. Two reasons, both of which need the adaptation to
# actually run again on machines that have already been stamped: booted_image() was
# returning "" (see below), and section 3's balanced default had therefore never
# re-asserted itself on a desktop that had drifted onto tuned's `powersave`.
HW_REV=3

STATE="${MOOS_HW_STATE:-/etc/moos/hardware-adapt.state}"
SYS="${MOOS_HW_SYSFS:-/sys}"
DRYRUN="${MOOS_HW_DRYRUN:-0}"
LOG="${MOOS_HW_LOG:-/run/moos-hardware-adapt.log}"

log() {
    echo "moos-hardware-adapt: $*"
    # Append to the log only when its directory is writable (it is /run on a real
    # system; skip silently on a host without /run so a dry-run stays quiet).
    [ -d "$(dirname "$LOG")" ] && [ -w "$(dirname "$LOG")" ] || return 0
    printf '%s %s\n' "$(date -u '+%FT%TZ' 2>/dev/null || echo now)" "$*" >>"$LOG" 2>/dev/null || true
}
do_run() { if [ "$DRYRUN" = "1" ]; then log "DRYRUN: $*"; else "$@" >>"$LOG" 2>&1 || log "warn: '$*' failed (non-fatal)"; fi; }

# ── idempotency ──────────────────────────────────────────────────────────────
booted_image() {
    # The image this deployment runs, so a rebase re-adapts.
    #
    # This used to read `bootc status --json` at .status.booted.image.image.image.
    # On a real MoOS deployment that path does not exist: `status.booted.image` comes
    # back as an EMPTY object, so the expression raised and the `except` printed "".
    # The stamp therefore degenerated to `rev=1 image=` on every machine — which
    # matches itself forever, so a rebase NEVER re-triggered adaptation. Checked on
    # the maintainer's desktop 2026-07-27: /etc/moos/hardware-adapt.state contained
    # literally `rev=1 image=`, and the unit had logged "already adapted" at every
    # boot since install. The image half of the key has never once done its job.
    #
    # rpm-ostree's `container-image-reference` IS populated, and it is the same field
    # `moai-do`'s do_update already reads to identify the booted edition. Use that.
    # It carries the digest, so each new signed image is a new stamp — exactly the
    # "a rebase re-adapts" behaviour the key was written for.
    rpm-ostree status --json 2>/dev/null | python3 -c 'import json,sys
try:
    for d in json.load(sys.stdin).get("deployments", []):
        if d.get("booted"):
            print(d.get("container-image-reference","") or ""); break
    else:
        print("")
except Exception: print("")' 2>/dev/null || echo ""
}
want_stamp="rev=${HW_REV} image=$(booted_image)"
if [ -r "$STATE" ] && grep -qxF "$want_stamp" "$STATE" 2>/dev/null; then
    log "already adapted for this revision+image — nothing to do"
    exit 0
fi
log "adapting (rev ${HW_REV}) …"

# ── detections (read-only) ───────────────────────────────────────────────────
cpu_vendor="$(grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}')"
mem_kb="$(grep -m1 '^MemTotal:' /proc/meminfo 2>/dev/null | awk '{print $2}')"
mem_kb="${mem_kb:-0}"
# MemTotal is always a little below the physical RAM (firmware/kernel reserve), so a
# plain floor reads 8 GiB as 7 and 32 as 31, dropping the machine into the wrong zram
# tier at every power-of-two boundary. Round to the nearest GiB (add half a GiB first).
mem_gib=$(( (mem_kb + 524288) / 1024 / 1024 ))
chassis="$(hostnamectl chassis 2>/dev/null || echo unknown)"
have_battery=0
for b in "$SYS"/class/power_supply/BAT*; do [ -e "$b" ] && have_battery=1 && break; done
gpu_vendors=""
for v in "$SYS"/bus/pci/devices/*/vendor; do
    [ -r "$v" ] || continue
    class="$(cat "${v%vendor}class" 2>/dev/null)"
    case "$class" in 0x03*) gpu_vendors="${gpu_vendors} $(cat "$v" 2>/dev/null)" ;; esac
done
has_nvidia=0; case "$gpu_vendors" in *0x10de*) has_nvidia=1 ;; esac
has_intel_gpu=0; case "$gpu_vendors" in *0x8086*) has_intel_gpu=1 ;; esac
booted_img="$(booted_image)"
is_nvidia_edition=0; case "$booted_img" in *moos-nvidia*) is_nvidia_edition=1 ;; esac

log "cpu=${cpu_vendor:-?} ram=${mem_gib}GiB chassis=${chassis} battery=${have_battery} gpu_nvidia=${has_nvidia} gpu_intel=${has_intel_gpu} edition=${booted_img:-?}"

# ── 1. Intel CPU → thermald (proactive overheat prevention). AMD relies on
#       amd-pstate + firmware passive throttling, which is always on. ──────────
if [ "$cpu_vendor" = "GenuineIntel" ]; then
    if systemctl list-unit-files thermald.service >/dev/null 2>&1; then
        do_run systemctl enable --now thermald.service
        log "Intel CPU: thermald enabled"
    else
        log "Intel CPU: thermald not installed (skipping)"
    fi
else
    # Never enable thermald on AMD — it is Intel-specific.
    log "non-Intel CPU: leaving thermal management to the kernel/firmware (correct)"
fi

# ── 2. RAM-tiered zram — never touches disk, worst case is OOM not corruption,
#       fully reversible (a config file). Sized by installed RAM. ─────────────
#
# APPLY DISCIPLINE (learned the hard way on a fresh install's FIRST boot):
# a bare `systemctl restart systemd-zram-setup@zram0` right after boot stops the
# just-started dev-zram0.swap and re-starts it inside systemd's default rate-limit
# window — the swap unit trips `start-limit-hit`, every later setup retry dies with
# EBUSY on comp_algorithm (the device is already sized), and the install's first
# boot ends with two failed units and NO swap. So: (a) skip the whole apply when
# the config we would write is already on disk, and (b) when we do apply, stop the
# stack cleanly, reload generators, CLEAR the start-limit counters with
# reset-failed, and issue ONE start request for the swap (it pulls setup in via
# Requires=). Verified in QEMU: the storm reproduces with the old sequence and
# does not with this one.
if [ "$mem_gib" -gt 0 ]; then
    zconf="/etc/systemd/zram-generator.conf"
    if [ "$mem_gib" -lt 8 ]; then zsize="ram"          # low RAM: compression buys real headroom
    elif [ "$mem_gib" -lt 32 ]; then zsize="min(ram, 8192)"
    else zsize="min(ram / 2, 16384)"; fi
    zwant="$(printf '# Written by moos-hardware-adapt (RAM tier: %sGiB). Reversible.\n[zram0]\nzram-size = %s\ncompression-algorithm = zstd\n' \
        "$mem_gib" "$zsize")"
    if [ "$DRYRUN" = "1" ]; then
        log "DRYRUN would write ${zconf}: zram-size=${zsize}"
    elif [ -r "$zconf" ] && [ "$(cat "$zconf" 2>/dev/null)" = "$zwant" ]; then
        log "zram already sized for ${mem_gib}GiB (${zsize}) — leaving the running swap alone"
    else
        mkdir -p /etc/systemd 2>/dev/null || true
        printf '%s\n' "$zwant" > "$zconf" 2>/dev/null && log "zram sized for ${mem_gib}GiB: ${zsize}" \
            || log "warn: could not write ${zconf}"
        # vm.min_free_kbytes ~1% of RAM (Bazzite pattern) — keeps a reclaim buffer.
        minfree=$(( mem_kb / 100 ))
        printf '# Written by moos-hardware-adapt. Reversible.\nvm.min_free_kbytes = %s\n' "$minfree" \
            > /etc/sysctl.d/90-moos-hardware.conf 2>/dev/null || true
        # Apply it THIS boot. This service runs After=systemd-sysctl.service, which
        # already applied the earlier config and will NOT re-read the new file until
        # next boot; `systemctl daemon-reload` only reloads UNIT files, not sysctls.
        do_run sysctl --system
        do_run systemctl stop dev-zram0.swap systemd-zram-setup@zram0.service
        do_run systemctl daemon-reload
        do_run systemctl reset-failed dev-zram0.swap systemd-zram-setup@zram0.service
        do_run systemctl start dev-zram0.swap
        # Say out loud whether swap actually came back — a silent OFF swap is the bug.
        if [ "$(systemctl is-active dev-zram0.swap 2>/dev/null)" = "active" ]; then
            log "zram swap re-activated cleanly"
        else
            log "warn: dev-zram0.swap is $(systemctl is-active dev-zram0.swap 2>/dev/null || echo unknown) after re-size"
        fi
    fi
fi

# ── 3. Chassis-aware default power profile. Desktops with NO battery get
#       'balanced' as the sane default; laptops/handhelds keep 'balanced' and let
#       KDE PowerDevil switch to power-saver on battery. NEVER force performance
#       silently, NEVER disable tuned/ppd. ────────────────────────────────────
#
#       Why this is worth re-asserting, measured on the maintainer's desktop
#       (i5-14400F, no battery) on 2026-07-27: the machine was sitting on tuned's
#       `powersave` profile, and had been for 13 consecutive boots. That profile
#       sets `boost=0` — Turbo OFF — so:
#
#           /sys/devices/system/cpu/intel_pstate/no_turbo   = 1
#           /sys/.../cpu0/cpufreq/scaling_max_freq          = 2500000   (2.5 GHz)
#           energy_performance_preference                   = power
#
#       On a part whose turbo is 4.7 GHz that is a hard 47% cut to the single-core
#       ceiling. Measured single-thread benchmark before/after switching to
#       balanced: 0.594s -> 0.314s, i.e. 1.9x. Under an all-core load the cores
#       went from pinned at the 2.5 GHz cap to ~3.95 GHz sustained. It also sets
#       `vm.laptop_mode=5` and SATA `alpm=med_power_with_dipm` — writeback delay
#       and link-power latency on a DESKTOP's boot SSD.
#
#       None of that is a MoOS setting; a person can select Power Save in Plasma's
#       power widget and tuned-ppd maps it straight onto this profile. That is
#       their right, and this is still not "force performance": `balanced` leaves
#       turbo available and lets the DE manage it. What changed is that the default
#       now genuinely re-asserts after an update instead of being stamped out on
#       first boot forever.
if command -v tuned-adm >/dev/null 2>&1; then
    do_run tuned-adm profile balanced
    log "tuned default profile: balanced (the DE switches on battery)"
fi

# ── 4. NVIDIA GPU on the BASE edition → SURFACE a rebase suggestion (never
#       install drivers at runtime on an atomic system). Written where Mo AI /
#       the welcome can read it. ─────────────────────────────────────────────
notice_dir="/run/moos"
mkdir -p "$notice_dir" 2>/dev/null || true
if [ "$has_nvidia" = 1 ] && [ "$is_nvidia_edition" = 0 ]; then
    printf 'nvidia-rebase\n' > "${notice_dir}/hardware-notice" 2>/dev/null || true
    log "NVIDIA GPU on the base edition — suggest rebasing to moos-nvidia (advice only, no runtime driver install)"
else
    rm -f "${notice_dir}/hardware-notice" 2>/dev/null || true
fi

# ── 5. Intel GPU → a harmless per-session renderer hint (Bazzite pattern) so
#       GTK apps use the GL renderer, which is smoother on Intel. Env drop-in,
#       trivially reversible, affects rendering only. ────────────────────────
if [ "$has_intel_gpu" = 1 ]; then
    if [ "$DRYRUN" = "1" ]; then
        log "DRYRUN would set GSK_RENDERER=gl for Intel GPU"
    else
        mkdir -p /etc/environment.d 2>/dev/null || true
        printf '# Written by moos-hardware-adapt (Intel GPU). Reversible.\nGSK_RENDERER=gl\n' \
            > /etc/environment.d/90-moos-intel-gpu.conf 2>/dev/null && log "Intel GPU: GSK_RENDERER=gl" || true
    fi
fi

# ── 6. Firmware: refresh LVFS METADATA only (never apply). Surfacing the count
#       to the user is Mo AI's job; applying requires explicit consent. ───────
if systemctl list-unit-files fwupd-refresh.timer >/dev/null 2>&1; then
    do_run systemctl enable fwupd-refresh.timer
    log "fwupd-refresh.timer enabled (metadata only — updates are never auto-applied)"
fi

# ── 7. DDC/CI: do not spend six seconds asking a screen that cannot answer ───
#
# plasma-powerdevil was the slowest unit of the maintainer's login by a wide
# margin — measured 6.575s, with the next unit at 3.266s — and all of it was
# libddcutil walking the I2C buses looking for a monitor that speaks DDC/CI.
# The screen on that desk is a Philips TV: `ddcutil detect --brief` answers
# "Invalid display". So the session waited six seconds, every login, for a
# conversation that was never going to happen.
#
# POWERDEVIL_NO_DDCUTIL is powerdevil's own switch (present in the shipped
# libpowerdevilcore), so this is configuration, not a fork. It is NOT set
# blindly: a machine whose monitor DOES speak DDC/CI must keep hardware
# brightness control, which is a real feature. Probe once per HW_REV, and write
# the drop-in only when the probe finds nothing — plug a DDC-capable monitor in
# later and the next revision bump re-probes and removes it.
#
# Laptops are unaffected either way: their panel uses the kernel backlight, a
# different powerdevil path entirely.
_ddc_dropin=/etc/systemd/user/plasma-powerdevil.service.d/50-moos-ddc.conf
if command -v ddcutil >/dev/null 2>&1; then
    if timeout 30 ddcutil detect --brief 2>/dev/null | grep -qE '^Display [0-9]'; then
        # A real DDC/CI display answered: make sure a stale opt-out is gone.
        if [ -e "$_ddc_dropin" ]; then
            do_run rm -f "$_ddc_dropin"
            log "DDC/CI: a display answered — brightness control restored"
        else
            log "DDC/CI: a display answered — leaving powerdevil untouched"
        fi
    else
        if [ "$DRYRUN" != "1" ]; then
            mkdir -p "$(dirname "$_ddc_dropin")" 2>/dev/null || true
            printf '# Written by moos-hardware-adapt: no DDC/CI display answered on this\n# machine, and probing for one cost 6.5s of every login. Reversible —\n# delete this file (or attach a DDC-capable monitor and bump HW_REV).\n[Service]\nEnvironment=POWERDEVIL_NO_DDCUTIL=1\n' \
                > "$_ddc_dropin" 2>/dev/null || log "warn: could not write ${_ddc_dropin}"
        fi
        log "DDC/CI: no display answered — powerdevil will skip the probe (saves ~6s per login)"
    fi
else
    log "DDC/CI: ddcutil not present — nothing to probe"
fi

# ── record state (idempotency) ───────────────────────────────────────────────
if [ "$DRYRUN" != "1" ]; then
    mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
    printf '%s\n' "$want_stamp" > "$STATE" 2>/dev/null || log "warn: could not write state ${STATE}"
fi
log "hardware adaptation complete"
exit 0
