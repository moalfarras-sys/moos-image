#!/usr/bin/env python3
# moai-control — tiny localhost control API for Mo AI's IN-APP settings.
#
# The pure-QML app can't write files, so this small always-on user service lets
# the in-app Settings page read and change the brain config (local vs cloud,
# provider base URL, model, API key) and switch the model services — all over
# 127.0.0.1:8079 via XHR. The API KEY is only ever RECEIVED (POST) and stored
# chmod 600 in ~/.config/moai/config.json; GET never returns it (only has_key).
# Stdlib only.
import json, os, subprocess, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CFG_DIR = os.path.expanduser("~/.config/moai")
CFG = os.path.join(CFG_DIR, "config.json")
PORT = int(os.environ.get("MOAI_CONTROL_PORT", "8079"))


def load():
    try:
        with open(CFG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save(d):
    os.makedirs(CFG_DIR, exist_ok=True)
    with open(CFG, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False, indent=2)
    os.chmod(CFG, 0o600)


def sysctl(*args):
    try:
        subprocess.run(["systemctl", "--user", *args], check=False, timeout=20)
    except Exception:
        pass


def brain_online():
    try:
        return urllib.request.urlopen(
            "http://127.0.0.1:8080/v1/models", timeout=1).status == 200
    except Exception:
        return False


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        # No Access-Control-Allow-Origin on purpose: the pure-QML XHR client is
        # not a browser and needs none; omitting it means a real browser page
        # cannot read our responses cross-origin.
        self.end_headers()
        try:
            self.wfile.write(body)
        except Exception:
            pass

    def _guard(self):
        # CSRF/cross-origin defense for this state-changing localhost API. A
        # browser cannot set a custom header without a CORS preflight, which we
        # never approve (no OPTIONS handler, no ACAO) — so requiring this header
        # blocks any web page the user visits from driving the service. The QML
        # client sets it directly (not subject to CORS).
        if self.headers.get("X-Moai-Control") != "1":
            self._send(403, {"error": "forbidden"})
            return False
        origin = self.headers.get("Origin")
        if origin and origin != "null" \
                and "127.0.0.1" not in origin and "localhost" not in origin:
            self._send(403, {"error": "bad origin"})
            return False
        return True

    def do_GET(self):
        if not self._guard():
            return
        if self.path.startswith("/config"):
            c = load()
            self._send(200, {
                "mode": c.get("mode", "local"),
                "cloud_base": c.get("cloud_base", ""),
                "cloud_model": c.get("cloud_model", ""),
                "has_key": bool(c.get("cloud_key")),
            })
        elif self.path.startswith("/status"):
            self._send(200, {"online": brain_online()})
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b"{}"   # drain first (keep-alive safe)
        if not self._guard():
            return
        # Reject the CORS "simple request" path (text/plain) that skips preflight.
        if "application/json" not in (self.headers.get("Content-Type") or ""):
            return self._send(415, {"error": "content-type must be application/json"})
        if not self.path.startswith("/config"):
            return self._send(404, {"error": "not found"})
        try:
            data = json.loads(raw)
        except Exception:
            return self._send(400, {"error": "bad json"})
        cur = load()
        mode = "cloud" if data.get("mode") == "cloud" else "local"
        out = {
            "mode": mode,
            "cloud_base": data.get("cloud_base", cur.get("cloud_base", "")),
            "cloud_model": data.get("cloud_model", cur.get("cloud_model", "")),
            # Keep the existing key when the form leaves the field blank.
            "cloud_key": data.get("cloud_key") or cur.get("cloud_key", ""),
        }
        save(out)
        # Local and cloud both serve on 8080 — only one may run.
        if mode == "cloud":
            sysctl("disable", "--now", "moai.service")
            sysctl("enable", "--now", "moai-cloud.service")
        else:
            sysctl("disable", "--now", "moai-cloud.service")
        self._send(200, {"ok": True, "mode": mode})


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()
