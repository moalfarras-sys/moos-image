#!/usr/bin/env python3
# moai-control — localhost state + control API for Mo AI.
#
# Mo AI is a pure-QML app: it has no Process API, cannot exec, and cannot write
# files. This small always-on user service is its ONLY way to learn about the
# machine and change its own config. It is deliberately not a general-purpose
# bridge — it exposes a fixed set of read-only reads plus one config write. Any
# action that CHANGES the system goes through moos-open -> moai-do instead, so
# it keeps its confirmation + Polkit prompt.
#
# The API KEY is only ever RECEIVED (POST) and stored in Mo AI's private XDG data
# file; GET never returns it (only has_key). Stdlib only.
#
#   GET  /config   brain config (mode, base, model, has_key)
#   GET  /status   {"online": bool}  — can the DEFAULT brain answer right now
#   GET  /quick    CHEAP poll: brains + remote + agents. Safe every few seconds.
#   GET  /models   the REAL models this machine can route to (see below)
#   GET  /scan     full snapshot incl. the cached device plan.
#   GET  /search?q=…  Flathub app search (this is Mo AI's App Centre).
#   POST /config   set the DEFAULT mode/base/model/key.
import json, os, re, shutil, subprocess, sys, tempfile, threading, time
import urllib.error, urllib.parse, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# A base URL is expected to carry its API version ("…/v1", "…/v1beta/openai").
VERSIONED = re.compile(r"/v\d[\w.]*(/|$)")

# "ollama://library/qwen3:4b" — strip the transport, keep the name.
SCHEME = re.compile(r"^[a-z0-9+.-]+://")

CFG_DIR = os.path.expanduser("~/.config/moai")
CFG = os.path.join(CFG_DIR, "config.json")
CREDENTIAL_STORE = os.environ.get(
    "MOAI_CREDENTIAL_STORE", "/usr/libexec/moai-credential-store")
MOOS_DIR = os.path.expanduser("~/.config/moos")
ENV_FILE = os.path.join(MOOS_DIR, "moai.env")
PORT = int(os.environ.get("MOAI_CONTROL_PORT", "8079"))
MAX_BODY_BYTES = 1024 * 1024
CONFIG_LOCK = threading.RLock()

# The brain lives behind ONE always-on front door on 8080 (moai-gateway), which
# routes each request to the local brain on 8081 or to the cloud provider. See
# moai-gateway for the contract; these two numbers must agree with it.
GATEWAY_PORT = int(os.environ.get("MOAI_GATEWAY_PORT", "8080"))
GATEWAY_UNIT = "moai-gateway.service"
RAMALAMA_UNIT = "moai.service"
OLLAMA_UNITS = ("ollama.service", "moai-brain.service")
ALLOWED_LOCAL_UNITS = (RAMALAMA_UNIT, *OLLAMA_UNITS)
_requested_local_unit = os.environ.get("MOAI_LOCAL_UNIT", RAMALAMA_UNIT)
LOCAL_UNIT = (_requested_local_unit if _requested_local_unit in ALLOWED_LOCAL_UNITS
              else RAMALAMA_UNIT)
_derived_backend = "ollama" if LOCAL_UNIT in OLLAMA_UNITS else "ramalama"
_requested_backend = os.environ.get("MOAI_LOCAL_BACKEND", _derived_backend)
LOCAL_BACKEND = (_requested_backend
                 if _requested_backend in ("ollama", "ramalama")
                 and (_requested_backend == _derived_backend)
                 else _derived_backend)
try:
    LOCAL_PORT = int(os.environ.get(
        "MOAI_LOCAL_PORT", "11434" if LOCAL_BACKEND == "ollama" else "8081"))
except (TypeError, ValueError):
    LOCAL_PORT = 11434 if LOCAL_BACKEND == "ollama" else 8081
DEFAULT_LOCAL_MODEL = os.environ.get(
    "MOAI_LOCAL_MODEL",
    "default" if LOCAL_BACKEND == "ollama" else "ollama://qwen2.5:7b-instruct")

ANTHROPIC_VERSION = "2023-06-01"

REMOTE_UNIT = "mo-remote-personal.service"

# See moai-gateway: Python's default "Python-urllib/3.x" User-Agent is answered
# with 403 (Cloudflare "error code: 1010") by a large share of AI providers.
USER_AGENT = "MoOS-MoAI/1.0 (+https://github.com/moalfarras-sys/moos-image)"

# ── Cloud brains Mo AI can use ───────────────────────────────────────────────
#
# `wire` is the protocol the provider actually speaks — "openai" for the
# chat/completions dialect (OpenAI, OpenRouter, Gemini's OpenAI-compatible
# endpoint, and any private gateway), "anthropic" for Claude's native
# /v1/messages, which moai-gateway translates.
#
# `model` is a CHEAP default on purpose. The point of the cloud brain is to
# answer questions about a desktop, not to be the largest model available, and
# the user pays for every token.
#
# No API keys here, ever. A key lives in Mo AI's private XDG data store and
# nowhere else — not in this file, not in config.json, and not in the repository.
PROVIDERS = [
    {"id": "moagent", "name": "Mo Agent (خاص | private)",
     "base": "https://api.synterolink.com/v1", "wire": "openai",
     "model": "gpt-5.4-mini",
     "hint": "وكيلك الخاص | your own agent endpoint"},
    {"id": "openai", "name": "OpenAI",
     "base": "https://api.openai.com/v1", "wire": "openai",
     "model": "gpt-5.4-mini",
     "hint": "platform.openai.com/api-keys"},
    {"id": "anthropic", "name": "Claude (Anthropic)",
     "base": "https://api.anthropic.com/v1", "wire": "anthropic",
     "model": "claude-haiku-4-5-20251001",
     "hint": "console.anthropic.com — Haiku هو الأرخص"},
    {"id": "gemini", "name": "Google Gemini",
     "base": "https://generativelanguage.googleapis.com/v1beta/openai",
     "wire": "openai", "model": "gemini-2.0-flash",
     "hint": "aistudio.google.com/apikey — Flash هو الأرخص"},
    {"id": "openrouter", "name": "OpenRouter (كل النماذج | every model)",
     "base": "https://openrouter.ai/api/v1", "wire": "openai",
     "model": "google/gemini-2.0-flash-001",
     "hint": "openrouter.ai/keys — مفتاح واحد لكل المزوّدين"},
    {"id": "custom", "name": "أخرى | Other (OpenAI-compatible)",
     "base": "", "wire": "openai", "model": "",
     "hint": "أي خادم يتكلم /v1/chat/completions"},
]


def load() -> dict:
    """Load the Mo AI settings configuration, under a file lock."""
    with CONFIG_LOCK:
        try:
            with open(CFG, encoding="utf-8") as f:
                data = json.load(f)
                # One-time migration from the pre-v3 plaintext format. Store the
                # credential in private XDG data, then immediately rewrite config
                # without it. Never log the value.
                had_legacy_key = "cloud_key" in data
                legacy = data.pop("cloud_key", "")
                if legacy and not store_secret(legacy):
                    # Keep the legacy file intact if private storage is temporarily
                    # unavailable; deleting a real credential would lose user data.
                    data["cloud_key"] = legacy
                elif had_legacy_key:
                    # Rewrite even when the old value is empty. This permanently
                    # removes the plaintext credential field from pre-v3 configs.
                    save(data)
                return data
        except (OSError, ValueError):
            return {}


def save(d: dict) -> None:
    """Save the Mo AI settings configuration, under a file lock."""
    with CONFIG_LOCK:
        os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
        os.chmod(CFG_DIR, 0o700)
        fd, tmp_name = tempfile.mkstemp(prefix=".config.json.", dir=CFG_DIR)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(d, f, ensure_ascii=False, indent=2)
                f.write("\n")
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp_name, 0o600)
            os.replace(tmp_name, CFG)
            directory_fd = os.open(CFG_DIR, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        finally:
            try:
                os.unlink(tmp_name)
            except FileNotFoundError:
                pass


def credential_store(action, value=None):
    """Invoke the moai-credential-store utility to get or set private values."""
    try:
        return subprocess.run(
            [CREDENTIAL_STORE, action], input=value, capture_output=True,
            text=True, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def get_secret():
    """Retrieve the cloud API key from the local credential store."""
    result = credential_store("get")
    return result.stdout.rstrip("\n") if result and result.returncode == 0 else ""


def store_secret(value):
    """Save the cloud API key to the local credential store."""
    result = credential_store("set", value=value)
    return bool(result and result.returncode == 0)


def sysctl(*args: str) -> None:
    """Execute a systemctl command asynchronously on the local user session."""
    try:
        subprocess.run(["systemctl", "--user", *args], check=False, timeout=20,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def http_ok(url, timeout=1.5):
    """Check if an HTTP endpoint returns a 2xx response."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status == 200
    except Exception:
        return False


def gateway_online() -> bool:
    """Is the front door up? /healthz answers from local knowledge only — it must
    never reach out to a provider, because this is polled every few seconds."""
    return http_ok("http://127.0.0.1:%d/healthz" % GATEWAY_PORT)


def local_online() -> bool:
    """Is the local brain actually serving? Ask it, on ITS port — not 8080, which
    now belongs to the gateway and would answer yes on behalf of nobody."""
    return http_ok("http://127.0.0.1:%d/v1/models" % LOCAL_PORT)


# get_secret() is a subprocess, and /quick runs every few seconds. Cache the
# yes/no (never the value).
_cloud_lock = threading.Lock()
_cloud_cache = {"ready": False, "ts": 0.0}
CLOUD_TTL = 6.0


def cloud_ready() -> bool:
    """A cloud brain is configured: a base URL and a key in private storage.

    Deliberately NOT a live call to the provider. The old probe made a real
    network round trip to /v1/models with a 1-second timeout, every 4 seconds,
    from a poll loop — most providers do not answer that fast, so a perfectly
    good cloud brain reported itself offline. "Test connection" in Settings is
    the honest liveness check, and it is the one that sends a real request.
    """
    with _cloud_lock:
        if time.monotonic() - _cloud_cache["ts"] < CLOUD_TTL:
            return _cloud_cache["ready"]
    ready = bool((load().get("cloud_base") or "").strip()) and bool(get_secret())
    with _cloud_lock:
        _cloud_cache["ready"] = ready
        _cloud_cache["ts"] = time.monotonic()
    return ready


def brain_online() -> bool:
    """Can the DEFAULT brain answer right now?"""
    mode = load().get("mode")
    if mode == "cloud":
        return cloud_ready()
    if mode == "hybrid":
        return local_online() or cloud_ready()
    return local_online()


def short_model(name):
    """`ollama://library/qwen3:4b` → `qwen3:4b`. Same rule as
    moai-gateway's — RamaLama rewrites `ollama://x` to `ollama://library/x`, so a
    raw string compare says two names for the same weights are different."""
    n = SCHEME.sub("", (name or "").strip())
    if n.startswith("library/"):
        n = n[len("library/"):]
    return n


def comparable_model(name):
    """Comparison-only spelling: Ollama reports ``name:latest`` even when the
    request used ``name``.  Keep the exact API name for requests and labels, but
    treat those two spellings as one model when marking the default."""
    name = short_model(name)
    return name[:-len(":latest")] if name.endswith(":latest") else name


def same_model(left, right):
    return comparable_model(left) == comparable_model(right)


def env_model():
    """The model the local unit will actually serve. moai.env is the unit's
    EnvironmentFile and outranks its Environment= line, so read the file that
    decides rather than the default we ship."""
    if LOCAL_BACKEND == "ollama":
        # Ollama selects a model per request; moai.env belongs exclusively to
        # RamaLama and must never be allowed to change the Ollama default.
        return DEFAULT_LOCAL_MODEL
    try:
        with open(ENV_FILE, encoding="utf-8") as f:
            for line in f:
                if line.startswith("MOAI_MODEL="):
                    value = line.split("=", 1)[1].strip()
                    if value:
                        return value
    except Exception:
        pass
    return DEFAULT_LOCAL_MODEL


def ollama_request(path, method="GET", payload=None, timeout=20):
    """Call the selected Ollama API on loopback.  Model ids remain JSON values;
    they are never interpolated into a command line."""
    body = (json.dumps(payload).encode("utf-8") if payload is not None else None)
    req = urllib.request.Request(
        "http://127.0.0.1:%d%s" % (LOCAL_PORT, path),
        data=body, method=method)
    if body is not None:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=timeout) as response:
        raw = response.read()
        return json.loads(raw.decode("utf-8", "replace")) if raw else {}


def ensure_local_api(timeout=20):
    """Wake the selected, allowlisted engine for model management."""
    if local_online():
        return True
    sysctl("start", LOCAL_UNIT)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if local_online():
            return True
        time.sleep(0.5)
    return False


def ollama_models():
    if not ensure_local_api():
        return []
    try:
        data = ollama_request("/api/tags", timeout=12)
    except (urllib.error.URLError, OSError, ValueError):
        return []
    out = []
    for item in data.get("models", []) if isinstance(data, dict) else []:
        if not isinstance(item, dict):
            continue
        name = short_model(item.get("name") or item.get("model") or "")
        if not name:
            continue
        inputs = ["text"]
        try:
            shown = ollama_request("/api/show", method="POST",
                                    payload={"model": name}, timeout=4)
            capabilities = shown.get("capabilities", []) \
                if isinstance(shown, dict) else []
            if isinstance(capabilities, list) and "vision" in capabilities:
                inputs.append("image")
        except Exception:
            # Capability uncertainty is text-only. Sending a private image to
            # an unverified model is never an acceptable optimistic fallback.
            pass
        out.append({"name": name, "size": int(item.get("size") or 0),
                    "input": inputs})
    return out


def ensure_front_door():
    """8080 is the gateway's; the configured local engine owns its own port.

    Shipping the corrected unit file is NOT enough, and this is the whole reason
    this function exists:

      • ~/.config/moos/moai.env is moai.service's EnvironmentFile, so its
        MOAI_PORT OUTRANKS the unit's Environment=. Every machine that has ever
        run `moai-start` carries one that says 8080 — the port the front door now
        owns. Left alone, the local brain would come up on top of the gateway and
        one of the two would fail to bind.
      • the gateway used to be OPT-IN (moai-cloud.service, enabled only while the
        user was in cloud mode). It is the only door now, so it must be on for
        everybody, including the users who once turned it off.
      • a machine that moved to Ollama may still have moai.service enabled from
        the old RamaLama setup. Starting both engines on one GPU is never valid;
        the retired engine then restart-loops forever against Ollama's model and
        port. An explicit MOAI_LOCAL_UNIT selects one engine and retires the other.

    Repaired here — in the always-on service, on every start — rather than behind
    a once-per-revision migration marker: a marker cannot notice that the state it
    fixed has drifted back.
    """
    fixed_port = False
    fixed_model = False
    if LOCAL_UNIT == RAMALAMA_UNIT:
        try:
            if os.path.isfile(ENV_FILE):
                with open(ENV_FILE, encoding="utf-8") as f:
                    lines = f.read().splitlines()
                out, seen = [], False
                for line in lines:
                    if line.startswith("MOAI_PORT="):
                        seen = True
                        if line.strip() != "MOAI_PORT=%d" % LOCAL_PORT:
                            line = "MOAI_PORT=%d" % LOCAL_PORT
                            fixed_port = True
                    elif line.strip() == "MOAI_MODEL=ollama://qwen3:4b-instruct":
                        # This tag never existed in Ollama's registry. Migrate
                        # only the exact shipped mistake; every custom model is
                        # user-owned and remains byte-for-byte untouched.
                        line = "MOAI_MODEL=ollama://qwen2.5:7b-instruct"
                        fixed_model = True
                    out.append(line)
                if not seen:
                    out.insert(0, "MOAI_PORT=%d" % LOCAL_PORT)
                    fixed_port = True
                if fixed_port or fixed_model:
                    tmp = ENV_FILE + ".new"
                    with open(tmp, "w", encoding="utf-8") as f:
                        f.write("\n".join(out) + "\n")
                    os.chmod(tmp, 0o600)
                    os.replace(tmp, ENV_FILE)
        except Exception:
            pass
    else:
        # MOAI_LOCAL_UNIT is an explicit engine choice. A stale enable symlink
        # for RamaLama survives image updates and makes it retry every few
        # seconds even though the gateway correctly talks to Ollama. Stop and
        # disable only that known legacy unit; never act on an arbitrary name.
        for retired in ALLOWED_LOCAL_UNITS:
            if retired != LOCAL_UNIT:
                sysctl("disable", "--now", retired)

    # A local brain that is RUNNING on the old port is still holding 8080. Move it
    # before asking the gateway to bind there.
    if (fixed_port or fixed_model) and user_unit_active(RAMALAMA_UNIT):
        sysctl("restart", LOCAL_UNIT)

    # The retired opt-in unit. Its enable symlink survives an image update and
    # would leave systemd complaining about a unit that no longer exists.
    try:
        stale = os.path.expanduser(
            "~/.config/systemd/user/default.target.wants/moai-cloud.service")
        if os.path.islink(stale):
            os.remove(stale)
            sysctl("daemon-reload")
    except Exception:
        pass

    sysctl("enable", "--now", GATEWAY_UNIT)


def command_exists(name):
    """Is this command installed for THIS user?

    shutil.which() alone is not enough here, and the gap was user-visible: a systemd
    USER service inherits a minimal PATH — measured live on this machine, moai-control
    runs with PATH=/usr/local/sbin:/usr/local/bin:/usr/bin and no ~/.local/bin. But
    ~/.local/bin is exactly where `moai-do install-codex|install-claude|install-opencode`
    put their tools (`npm install --global --prefix ~/.local`). So Mo AI installed an
    agent and then reported that same agent as NOT installed, for ever — /quick answered
    {"codex": false, "claude": false, "opencode": false} with all three sitting in
    ~/.local/bin and on the user's own interactive PATH.

    So: ask PATH, then ask the directory we ourselves install into. (moos-store-index's
    nonflatpak_installed() already checks that directory directly, which is why the Store
    got this right while Mo AI did not.)
    """
    if shutil.which(name) is not None:
        return True
    return os.access(os.path.expanduser(f"~/.local/bin/{name}"), os.X_OK)


def user_unit_active(name):
    try:
        return subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", name],
            timeout=4, check=False).returncode == 0
    except Exception:
        return False


# ── Installed Flatpaks ───────────────────────────────────────────────────────
# One `flatpak list` instead of one `flatpak info` per app: the per-app form was
# ~9 subprocesses (5s timeout each) on every /scan, which is what made the panel
# feel slow. Cached for a few seconds so a burst of requests costs one call.
_apps_lock = threading.Lock()
_apps_cache = {"ids": set(), "ts": 0.0}
APPS_TTL = 8.0


def installed_apps():
    with _apps_lock:
        if time.monotonic() - _apps_cache["ts"] < APPS_TTL:
            return _apps_cache["ids"]
    ids = set()
    try:
        out = subprocess.run(
            ["flatpak", "list", "--app", "--columns=application"],
            capture_output=True, text=True, timeout=15, check=False)
        if out.returncode == 0:
            ids = {line.strip() for line in out.stdout.splitlines() if line.strip()}
    except Exception:
        pass
    with _apps_lock:
        _apps_cache["ids"] = ids
        _apps_cache["ts"] = time.monotonic()
    return ids


# ── The device plan ──────────────────────────────────────────────────────────
# moos-device-plan shells out to lspci/fwupdmgr/flatpak and can take tens of
# seconds. Calling it inline made /scan a 45-second endpoint, so the UI could
# not poll it and every panel that needed hardware state blocked on it. It is
# refreshed on a background thread instead, and every request is served from
# cache — stale data for a few minutes is correct here (hardware does not change
# faster than that), a 45-second UI freeze never is.
_plan_lock = threading.Lock()
_plan_cache = {"data": None, "ts": 0.0}
PLAN_INTERVAL = 180.0


def refresh_plan():
    try:
        plan = subprocess.run(["moos-device-plan", "--compact"],
                              capture_output=True, text=True, timeout=90)
        if plan.returncode == 0 and plan.stdout.strip():
            data = json.loads(plan.stdout)
            with _plan_lock:
                _plan_cache["data"] = data
                _plan_cache["ts"] = time.monotonic()
    except (OSError, subprocess.SubprocessError, ValueError):
        pass  # a machine without the detector still gets the generic scan


def plan_worker():
    while True:
        refresh_plan()
        time.sleep(PLAN_INTERVAL)


def cached_plan():
    with _plan_lock:
        return _plan_cache["data"]


def disk_usage():
    """Free space on the filesystem that actually holds the data.

    NOT "/" — on a bootc/OSTree system "/" is a read-only composefs overlay and
    statvfs reports it as a ~60 MB filesystem that is 100% full, so the old code
    here reported 0 GB of 0 GB and the Hardware Centre showed "?" for storage on
    every MoOS machine it ever ran on. The real filesystem is the one mounted at
    /sysroot, which /var is part of. moai-do already knew this (`fs="/var"` in
    do_optimize); this did not.
    """
    for path in ("/sysroot", "/var", "/"):
        try:
            du = shutil.disk_usage(path)
        except OSError:
            continue
        if du.total > 0:
            return {"total_gb": du.total // (1024 ** 3),
                    "free_gb": du.free // (1024 ** 3)}
    return {}


def _first_line(path, prefix):
    try:
        with open(path) as f:
            for line in f:
                if line.startswith(prefix):
                    return line.split(":", 1)[1].strip() if ":" in line else \
                           line.split("=", 1)[1].strip().strip('"')
    except Exception:
        pass
    return ""


def remote_state():
    """Mo PC Remote and the two services it cannot work without.

    ONE definition, used by both /quick and /scan. They must agree: the UI polls
    /quick every few seconds and merges the result into the snapshot it got from
    /scan, so a /quick that answered with a smaller dict than /scan would silently
    ERASE the missing keys a few seconds after the panel opened. It did exactly
    that — Mo AI showed PipeWire and the portal as "Down" on a machine where both
    were plainly running.
    """
    return {
        "active": user_unit_active(REMOTE_UNIT),
        "pipewire": user_unit_active("pipewire.service"),
        "portal": user_unit_active("xdg-desktop-portal.service"),
    }


def agent_state():
    return {"codex": command_exists("codex"),
            "claude": command_exists("claude"),
            "opencode": command_exists("opencode")}


def quick() -> dict:
    """The cheap poll. No subprocess that can block — safe every few seconds.

    `online` still means "the DEFAULT brain can answer", which is what it always
    meant. `brains` is what the per-conversation picker needs: the app chooses a
    route per request now, so whether it is "online" depends on WHICH route the
    user has chosen, and only the app knows that.
    """
    return {
        "online": brain_online(),
        "brains": {
            "gateway": gateway_online(),
            "local": local_online(),
            "cloud": cloud_ready(),
        },
        "remote": remote_state(),
        "agents": agent_state(),
    }


def scan() -> dict:
    """Read-only system snapshot. The device plan comes from cache (see above)."""
    info = {"os": _first_line("/etc/os-release", "PRETTY_NAME=") or "MoOS",
            "cpu": _first_line("/proc/cpuinfo", "model name"),
            "cores": os.cpu_count()}
    try:
        # Brand + de-leak the kernel string the Hardware panel shows. os.uname()
        # returns e.g. "7.1.4-202.fc44.x86_64"; the ".fc44.x86_64" suffix is a
        # Fedora/arch identity leak on a user-visible surface (the identity
        # contract keeps that name out of everything the owner looks at). Strip it
        # to the clean upstream version — the running kernel, module tree and
        # NVIDIA kmod are untouched; only the label the user reads changes.
        info["kernel"] = os.uname().release.split(".fc")[0]
    except Exception:
        info["kernel"] = ""
    try:
        kb = _first_line("/proc/meminfo", "MemTotal")  # "16384000 kB"
        info["mem_gb"] = round(int(kb.split()[0]) / 1024 / 1024) if kb else 0
    except Exception:
        info["mem_gb"] = 0
    info["disk"] = disk_usage()
    try:
        out = subprocess.run(
            ["bash", "-lc", "lspci 2>/dev/null | grep -iE 'vga|3d|display' || true"],
            capture_output=True, text=True, timeout=6).stdout.strip()
        info["gpu"] = "; ".join(l.split(":", 2)[-1].strip()
                                for l in out.splitlines()) if out else ""
    except Exception:
        info["gpu"] = ""
    info["desktop"] = os.environ.get("XDG_CURRENT_DESKTOP", "")

    # One read-only inventory powers the Device, Apps, Compatibility, Remote and
    # Developer panels in Mo AI. Keep it factual: the UI must not infer
    # "installed" from an icon or from a package we merely recommend.
    have = installed_apps()
    info["apps"] = {app_id: (app_id in have) for app_id in (
        "io.github.kolunmi.Bazaar", "org.mozilla.firefox", "org.videolan.VLC",
        "org.libreoffice.LibreOffice", "com.github.tchx84.Flatseal",
        "com.valvesoftware.Steam", "com.usebottles.bottles",
        "org.kde.kdeconnect", "com.google.AndroidStudio",
        # The recommended camera — without it the Camera card can never flip to
        # "Installed" the way every other recommended app does.
        "org.gnome.Snapshot",
    )}
    info["compatibility"] = {
        "waydroid": command_exists("waydroid"),
        "kvm": os.access("/dev/kvm", os.R_OK | os.W_OK),
        "steam": "com.valvesoftware.Steam" in have,
        "bottles": "com.usebottles.bottles" in have,
        "kdeconnect": "org.kde.kdeconnect" in have,
    }
    info["remote"] = remote_state()
    info["agents"] = agent_state()

    # The device plan is the same detector the old Hardware Centre used: GPU +
    # driver status, PCI devices with no driver bound, firmware the kernel failed
    # to load, pending fwupd updates, and the missing recommended apps — each
    # already paired with the ONE allowed moai-do action that repairs it.
    #
    # Folding it in here is what lets Mo AI be the device centre instead of a chat
    # box next to one: it opens a conversation already knowing this machine has an
    # NVIDIA card running nouveau, rather than waiting to be asked to look.
    plan = cached_plan()
    if plan is not None:
        info["device_plan"] = plan
    else:
        info["device_plan_pending"] = True   # first refresh still running
    return info


# ── The models Mo AI can actually route to ───────────────────────────────────
#
# THERE IS NO TIER TABLE HERE, AND THERE MUST NEVER BE ONE. The user's provider is
# whatever they configured — right now a private endpoint — and the only way to
# know what it serves is to ASK IT: GET <base>/v1/models with the stored key
# (Anthropic's native API answers the same path with x-api-key + anthropic-version).
# A hardcoded "small / medium / large" list would be an invented menu of models
# that may not exist on the user's account, and picking one would 404 in their face.
#
# If the provider does not implement /models we return an EMPTY cloud list and say
# why. The UI then falls back to the model the user typed into Settings, which is
# the one model we do know is real.

MODELS_TTL = 60.0
_models_lock = threading.Lock()
_models_cache = {"data": None, "ts": 0.0, "sig": None}

# ── Curated LOCAL starters ────────────────────────────────────────────────────
# The no-invented-menu rule above is about the CLOUD: a provider's account can
# 404 a model we made up. These are different in kind — fixed registry tags that
# the selected local engine pulls onto THIS machine, so nothing here can 404 on
# an account, and the picker states the download size before anything happens.
# Without this list a fresh install shows exactly ONE local option and the
# owner rightly asked where the choices were (2026-07-17).
#
# Selection rule: light enough for any MoOS machine (smallest runs CPU-only),
# smart enough to drive moai-do, and EVERY entry handles Arabic AND English —
# the bilingual UI is pointless behind a monolingual brain.
#
# EVERY entry below was MEASURED on this hardware through the real gateway, in
# Arabic, on a real repair question ("جهاز لينكس صار بطيء — أعطني أوامر فحص") —
# not chosen from a leaderboard (2026-07-17):
#   qwen3:1.7b        answered in Arabic with three real commands. Terse: it drops
#                     the "explain each" half of the ask. Right for a weak machine.
#   qwen2.5:7b-instruct is the measured fast, non-thinking MoOS default.
#   qwen3:4b        is the real Ollama tag (there is no qwen3:4b-instruct tag).
#   qwen3:8b          the best Arabic of everything tried — correct commands AND
#                     correct explanations. Wants a real GPU; the size says so.
# REJECTED, and why (so nobody re-adds them on a hunch):
#   qwen2.5-coder:7b  excellent code (clean one-liners), but its ARABIC is broken:
#                     it emitted "الملفات الممكدة" (not a phrase) and invented an
#                     `lsof -m` flag that does not exist. A coder brain that cannot
#                     hold a sentence in Arabic fails MoOS's bilingual contract.
#   gemma3:4b         shipped 2026-07-17 on the strength of a "broadest knowledge
#                     and languages" claim NOBODY had tested. Replaced by qwen3:8b,
#                     which was tested. "Ran here and survived" is the bar.
#
# `id` is the shared comparison key. The RamaLama adapter adds its required
# `ollama://` transport; the Ollama adapter sends the same id as JSON.
RECOMMENDED_LOCAL = [
    {"id": "qwen3:1.7b", "size_gb": 1.4,
     "note": "الأخف — يعمل على أي جهاز حتى بلا كرت شاشة | lightest — runs anywhere, even CPU-only"},
    {"id": "qwen3:4b", "size_gb": 2.5,
     "note": "التوازن الموصى به — ذكي وسريع | the recommended balance — smart and quick"},
    {"id": "qwen2.5:7b-instruct", "size_gb": 4.7,
     "note": "عقل MoOS السريع بلا تفكير مخفي | MoOS fast instruct brain, no hidden thinking"},
    {"id": "qwen3:8b", "size_gb": 4.9,
     "note": "الأقوى للعربية والكود والصيانة — يحتاج كرت شاشة | strongest Arabic, code and repair — wants a GPU"},
]

# ── The one-tap download the picker promises ─────────────────────────────────
#
# The picker has said "تحميل بضغطة | one-tap download" under every un-pulled
# starter since the catalog shipped, and the tap did NOT download: a chat routed
# to a missing brain came back from moai-gateway with "Pull it first: ramalama
# pull <x>" — a terminal instruction, on the one desktop whose whole promise is
# that you never need the terminal. The label was true about the intent and false
# about the machine. This is that missing half.
#
# Deliberately NOT in moai-gateway: it is right that a CHAT MESSAGE never starts
# a multi-gigabyte download (its refusal stays). A download is an explicit act the
# user asks for and watches — so it lives here, on the control API the picker
# already speaks, with progress the picker can draw.
#
# ALLOWLIST, not a passthrough: only an id in RECOMMENDED_LOCAL can be pulled.
# Ollama receives it as JSON; RamaLama receives one fixed argv element, never an
# interpolated command. The allowlist is what makes both paths safe by
# construction — the same contract moai-do holds for its fixed actions.
STORE = os.path.expanduser("~/.local/share/ramalama/store")

_pull_lock = threading.Lock()
_pull = {"model": "", "state": "idle", "percent": 0, "error": ""}


def store_bytes():
    """Bytes RamaLama's store holds right now.

    Progress comes from measuring this, NOT from parsing `ramalama pull` output:
    with stdout on a pipe rather than a TTY, that output carries no percentage at
    all (verified — the captured log has "Downloading qwen3" and nothing more).
    Blobs are shared per model FAMILY (every qwen3 variant lands under one
    directory), so a per-model size is not attributable; the whole-store delta
    during a serialised pull is. It costs ~1 ms on Btrfs.
    """
    total = 0
    for root, _dirs, files in os.walk(STORE):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total


def pull_worker(model_id, size_gb):
    if LOCAL_BACKEND == "ollama":
        try:
            if not ensure_local_api():
                raise RuntimeError("local model server did not start")
            req = urllib.request.Request(
                "http://127.0.0.1:%d/api/pull" % LOCAL_PORT,
                data=json.dumps({"model": model_id, "stream": True}).encode("utf-8"),
                method="POST", headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=1800) as response:
                for raw in response:
                    if not raw.strip():
                        continue
                    event = json.loads(raw.decode("utf-8", "replace"))
                    if event.get("error"):
                        raise RuntimeError(str(event["error"]))
                    total = int(event.get("total") or 0)
                    completed = int(event.get("completed") or 0)
                    if total:
                        with _pull_lock:
                            _pull["percent"] = min(int(completed * 100 / total), 99)
            with _pull_lock:
                _pull.update(state="done", percent=100, error="")
        except Exception as exc:
            with _pull_lock:
                _pull.update(state="error", error=str(exc))
        with _models_lock:
            _models_cache["data"] = None
        return

    start = store_bytes()
    expected = max(int(size_gb * 1e9), 1)
    try:
        proc = subprocess.Popen(
            ["ramalama", "pull", "ollama://" + model_id],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    except Exception as exc:
        with _pull_lock:
            _pull.update(state="error", error=str(exc))
        return
    while proc.poll() is None:
        grown = max(store_bytes() - start, 0)
        with _pull_lock:
            # Never show 100% while the process still runs: the last bytes are
            # verification and linking, and a bar that sits full while nothing
            # visibly happens reads as a hang.
            _pull["percent"] = min(int(grown * 100 / expected), 99)
        time.sleep(2.0)
    out = (proc.stdout.read() or "") if proc.stdout else ""
    with _pull_lock:
        if proc.returncode == 0:
            _pull.update(state="done", percent=100, error="")
        else:
            # Say what actually failed. The last non-empty line is RamaLama's own
            # message (no disk, no network, bad tag) and beats a generic string.
            tail = [ln for ln in out.replace("\r", "\n").splitlines() if ln.strip()]
            _pull.update(state="error",
                         error=tail[-1].strip() if tail else "pull failed")
    with _models_lock:                     # the picker must see it as pulled now
        _models_cache["data"] = None


def start_pull(model_id):
    """Begin a download. Returns the state dict the picker polls."""
    known = {r["id"]: r for r in RECOMMENDED_LOCAL}
    if model_id not in known:
        return {"state": "error", "error": "unknown model", "percent": 0,
                "model": ""}
    with _pull_lock:
        if _pull["state"] == "running":
            return dict(_pull)             # already downloading — report, do not queue
        _pull.update(model=model_id, state="running", percent=0, error="")
        state = dict(_pull)
    threading.Thread(target=pull_worker,
                     args=(model_id, known[model_id]["size_gb"]),
                     daemon=True).start()
    return state


def delete_model(model_id):
    """Remove a locally-pulled model. Safe by construction: the id must match the
    selected engine's live inventory. Ollama receives it as JSON; RamaLama as one
    fixed argv element. The default brain cannot be deleted out from under a
    running conversation.
    """
    model_id = (model_id or "").strip()
    installed = {m["label"] for m in local_models() if m.get("pulled")}
    if model_id not in installed:
        return {"ok": False, "error": "not an installed local model | ليس نموذجًا محلّيًا مثبّتًا"}
    if same_model(model_id, env_model()):
        return {"ok": False,
                "error": "this is the active brain — switch to another first "
                         "| هذا هو العقل الفعّال — بدّله أولًا"}
    try:
        if LOCAL_BACKEND == "ollama":
            if not ensure_local_api():
                return {"ok": False, "error": "local model server did not start"}
            ollama_request("/api/delete", method="DELETE",
                           payload={"model": model_id}, timeout=120)
            result = None
        else:
            result = subprocess.run(
                ["ramalama", "rm", "ollama://" + model_id],
                capture_output=True, text=True, timeout=120, check=False)
    except Exception as exc:
        return {"ok": False, "error": str(exc)}
    with _models_lock:                     # the picker must see it gone now
        _models_cache["data"] = None
    if result is None or result.returncode == 0:
        return {"ok": True}
    tail = [ln for ln in (result.stderr or result.stdout or "").replace("\r", "\n").splitlines()
            if ln.strip()]
    return {"ok": False, "error": tail[-1].strip() if tail else "delete failed"}


_ANSI = re.compile(r"\x1b\[[0-9;]*m")


def diagnose_system():
    """Run moos-selfcheck --quiet (which prints only the BROKEN checks plus the
    count summary) and return a structured health report the UI renders, plus the
    safe moai-do repairs worth offering. This step is READ-ONLY: it reasons about
    what is wrong, it does not change anything. Every fix is a separate, explicit
    moai-do action the user still confirms behind Polkit — the same allowlist
    contract as everywhere else. Nothing here ever runs a free-form command.
    """
    issues, ok_n, fail_n = [], 0, 0
    try:
        r = subprocess.run(["moos-selfcheck", "--quiet"],
                           capture_output=True, text=True, timeout=45, check=False)
        for raw in (r.stdout + "\n" + r.stderr).splitlines():
            s = _ANSI.sub("", raw).strip()
            if not s:
                continue
            m = re.search(r"(\d+)\s+broken,\s+(\d+)\s+passed", s)
            if m:
                fail_n, ok_n = int(m.group(1)), int(m.group(2))
                continue
            m = re.search(r"(\d+)\s+checks passed", s)
            if m:
                ok_n = int(m.group(1))
                continue
            if s.startswith("✗"):
                fail_n += 1
                issues.append(s.lstrip("✗").strip())
    except Exception as exc:
        issues.append("تعذّر تشغيل الفحص | could not run selfcheck: %s" % exc)
        fail_n = fail_n or 1
    # The curated, SAFE repair menu — read-only diagnostics first, then the
    # maintenance actions. Each id is a real moai-do action (confirm + Polkit);
    # the UI opens moos://do/<id>, it never composes a command.
    # Keep this list and the app's own defaultRepairs (apps/moai/main.qml) in step. The UI
    # shows defaultRepairs until a diagnosis returns, then REPLACES it with this one — so an
    # action present only in the app disappears the moment the user presses "افحص الآن",
    # which is exactly what happened to the three rescue/diagnostic actions below.
    fixes = [
        {"id": "diagnose-services", "label": "الخدمات الفاشلة | Failed services", "read": True},
        {"id": "check-drivers",     "label": "الكرت والتعريف | GPU & drivers",    "read": True},
        {"id": "inspect-boot",      "label": "حالة الإقلاع | Boot status",         "read": True},
        {"id": "net-doctor",        "label": "تشخيص الشبكة | Network doctor",      "read": True},
        {"id": "gpu-report",        "label": "ذاكرة كرت الشاشة | GPU memory",      "read": True},
        {"id": "fix-audio",         "label": "إصلاح الصوت | Fix audio",            "read": False},
        {"id": "optimize",          "label": "تنظيف وتحرير مساحة | Clean & free space", "read": False},
        {"id": "rollback",          "label": "الرجوع لنسخة سابقة | Roll back",     "read": False},
        {"id": "update",            "label": "تحديث MoOS | Update MoOS",           "read": False},
    ]
    return {"healthy": fail_n == 0, "ok": ok_n, "fail": fail_n,
            "issues": issues, "fixes": fixes}


def local_models():
    """Every model the selected engine has pulled, and the default local route.

    RamaLama/llama.cpp serves one model and requires a restart to switch. Ollama
    genuinely honours the request model, so every pulled row is routable and the
    ``serving`` marker means "plain local/default", not "the only model usable".
    """
    served = short_model(env_model())
    out, seen = [], set()
    if LOCAL_BACKEND == "ollama":
        for item in ollama_models():
            name = short_model(item.get("name") or "")
            if not name or name in seen:
                continue
            seen.add(name)
            out.append({"id": "local:" + name, "label": name,
                        "pulled": True, "serving": same_model(name, served),
                        "size_gb": round((item.get("size") or 0) / 1e9, 1),
                        "input": item.get("input") or ["text"]})
    else:
        try:
            result = subprocess.run(["ramalama", "list", "--json"],
                                    capture_output=True, text=True, timeout=25, check=False)
            if result.returncode == 0:
                for item in json.loads(result.stdout or "[]"):
                    name = short_model(item.get("name") or "")
                    if not name or name in seen:
                        continue
                    seen.add(name)
                    out.append({"id": "local:" + name, "label": name,
                                "pulled": True, "serving": same_model(name, served),
                                "size_gb": round((item.get("size") or 0) / 1e9, 1)})
        except Exception:
            pass
    served_starter = next(
        (rec for rec in RECOMMENDED_LOCAL if same_model(rec["id"], served)),
        None,
    )
    if (served and served_starter is not None
            and not any(same_model(served, name) for name in seen)):
        # Show a missing configured route only when the one-tap downloader can
        # actually fetch it. Ollama's synthetic `default` alias and arbitrary
        # custom names are not pull allowlist entries; exposing either as a Get
        # row creates a button that can only answer "unknown model".
        seen.add(served)
        out.insert(0, {"id": "local:" + served, "label": served,
                       "pulled": False, "serving": True,
                       "size_gb": served_starter["size_gb"],
                       "note": served_starter["note"]})
    # The curated starters: anything not already on the machine joins the list
    # as a one-tap download; anything already pulled just inherits its note.
    for rec in RECOMMENDED_LOCAL:
        name = rec["id"]
        matching = next((existing for existing in seen
                         if same_model(existing, name)), None)
        if matching is not None:
            for row in out:
                if same_model(row["label"], name) and not row.get("note"):
                    row["note"] = rec["note"]
            continue
        seen.add(name)
        out.append({"id": "local:" + name, "label": name,
                    "pulled": False, "serving": False,
                    "size_gb": rec["size_gb"], "note": rec["note"]})
    return out


def cloud_models(cfg):
    """Ask the CONFIGURED PROVIDER what it serves. Returns (models, error)."""
    base = (cfg.get("cloud_base") or "").strip().rstrip("/")
    wire = (cfg.get("cloud_wire") or "openai").lower()
    configured = (cfg.get("cloud_model") or "").strip()
    key = get_secret()
    if not base or not key:
        return [], "لا يوجد مزوّد أو مفتاح | no provider or API key configured"
    if not VERSIONED.search(base):
        base += "/v1"

    req = urllib.request.Request(base + "/models", method="GET")
    req.add_header("User-Agent", USER_AGENT)
    for name, value in (
            {"x-api-key": key, "anthropic-version": ANTHROPIC_VERSION}
            if wire == "anthropic" else {"Authorization": "Bearer " + key}).items():
        req.add_header(name, value)

    try:
        with urllib.request.urlopen(req, timeout=12) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        return [], ("المزوّد لا يقدّم قائمة نماذج (%d) | this provider has no model "
                    "list (%d) — اكتب اسم النموذج في الإعدادات | type the model name "
                    "in Settings" % (e.code, e.code))
    except Exception as e:
        return [], "تعذّر جلب قائمة النماذج | could not fetch the model list: %s" % e

    items = data.get("data") if isinstance(data, dict) else data
    if not isinstance(items, list):
        return [], "ردّ غير مفهوم من المزوّد | unexpected reply from the provider"

    out, seen = [], set()
    for item in items:
        inputs = ["text"]
        if isinstance(item, dict):
            model_id = (item.get("id") or item.get("name") or "").strip()
            label = (item.get("display_name") or "").strip() or model_id
            advertised = item.get("input") or item.get("modalities") or []
            if isinstance(advertised, list) and any(
                    str(value).lower() in ("image", "vision")
                    for value in advertised):
                inputs.append("image")
        else:
            model_id = str(item).strip()
            label = model_id
        if not model_id or model_id in seen:
            continue
        seen.add(model_id)
        out.append({"id": "cloud:" + model_id, "label": label,
                    "serving": model_id == configured, "input": inputs})
    return out, ""


def models() -> dict:
    cfg = load()
    mode = cfg.get("mode") if cfg.get("mode") in ("local", "cloud", "hybrid") else "local"
    configured = (cfg.get("cloud_model") or "").strip()

    # Bust the cache when the provider changes, not only when the clock runs out.
    sig = (mode, cfg.get("cloud_base", ""), cfg.get("cloud_wire", ""), configured)
    with _models_lock:
        if (_models_cache["data"] is not None and _models_cache["sig"] == sig
                and time.monotonic() - _models_cache["ts"] < MODELS_TTL):
            return _models_cache["data"]

    local = local_models()
    cloud, cloud_error = cloud_models(cfg)

    # A provider with no /models still has the model the user configured, and we
    # know that one is real because they typed it and can Test it. Offer it.
    if configured and not any(m["id"] == "cloud:" + configured for m in cloud):
        cloud.insert(0, {"id": "cloud:" + configured, "label": configured,
                         "serving": True})

    if mode == "hybrid":
        default = "hybrid"
    elif mode == "cloud":
        default = "cloud:" + configured if configured else "cloud"
    else:
        default = next((m["id"] for m in local if m["serving"]), "local")

    out = {"local": local, "cloud": cloud, "cloud_error": cloud_error,
           "default": default, "mode": mode}
    with _models_lock:
        _models_cache["data"] = out
        _models_cache["ts"] = time.monotonic()
        _models_cache["sig"] = sig
    return out


# ── App search — this is Mo AI's App Centre ──────────────────────────────────
# Flathub's public search API, with `flatpak search` as the offline fallback.
# Returns app ids only; INSTALLING one is not done here — the UI hands the id to
# moos://apps/install/<id>, which runs `moai-do install <id>`: confirmation,
# Polkit, and the same id validation. Searching is read-only and unprivileged;
# installing is not, and the two must not share a code path.
FLATHUB_SEARCH = "https://flathub.org/api/v2/search"


def flathub_search(query):
    body = json.dumps({"query": query, "filters": []}).encode("utf-8")
    req = urllib.request.Request(
        FLATHUB_SEARCH, data=body, method="POST",
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=8) as r:
        hits = json.loads(r.read().decode("utf-8")).get("hits", [])
    out = []
    for h in hits[:24]:
        app_id = h.get("app_id") or ""
        if not app_id:
            continue
        out.append({
            "id": app_id,
            "name": h.get("name") or app_id,
            "summary": h.get("summary") or "",
            "icon": h.get("icon") or "",
            "verified": bool(h.get("verification_verified")),
            "installs": h.get("installs_last_month") or 0,
        })
    return out


def flatpak_search(query):
    """Offline fallback: the local appstream index."""
    out = []
    try:
        r = subprocess.run(
            ["flatpak", "search", "--columns=application,name,description", query],
            capture_output=True, text=True, timeout=20, check=False)
        if r.returncode != 0:
            return out
        for line in r.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) < 2 or not parts[0].strip():
                continue
            out.append({
                "id": parts[0].strip(),
                "name": parts[1].strip() or parts[0].strip(),
                "summary": (parts[2].strip() if len(parts) > 2 else ""),
                "icon": "", "verified": False, "installs": 0,
            })
    except Exception:
        pass
    return out[:24]


# ── The need → known-good-app decision layer ─────────────────────────────────
# Flathub's ranking answers "what is popular", not "what works on THIS desktop", and on
# MoOS those are different questions. Searching "camera" puts
# io.github.cosmic_utils.camera on top: it installs cleanly, then panics on Plasma
# (it hunts com.system76.Cosmic* D-Bus services that do not exist here). The user's
# camera "did not work" while the webcam, libcamera and the install were all fine.
#
# That is a whole bug family — a desktop-mismatched Flatpak (COSMIC/GNOME-only) that
# installs and then crashes on KDE — and it is invisible to a search that only reads
# popularity. So MoOS answers the NEED, not the keyword: a small table of apps that are
# native to this desktop, ranked first and labelled, plus an honest warning on the ones
# built for another desktop entirely.
#
# The bar for a row here, CORRECTED on 2026-07-13 after the first version of this table
# shipped a broken pick: not "is it KDE-native" but **was it launched on this machine and
# did it hold**. Those are not the same test, and the difference cost the user their camera
# twice. `verified` means someone ran it here and watched it survive; `note` says WHY, so a
# pick is auditable rather than a matter of taste. A KDE-native app that crashes is worse
# than a GTK one that works — the user does not care whose toolkit it is.
#
# THE ROW THAT PROVED IT. This table's first camera was org.kde.kamoso, marked `verified`
# because it had been seen to open. It opens — and then **segfaults after 15-45 seconds**,
# inside GStreamer's camerabin (libgstcamerabin → gobject), silently, with no message at
# all. Reproduced twice on 2026-07-13, and NOT a VRAM problem: it dies just the same with
# 6.5 GB free on the card, while `gst-launch-1.0 v4l2src` grabs a clean 1280x720 frame from
# the very same webcam. So "it opened once" is not verification; MoOS shipped a recommended
# app that crashes, which is exactly the failure this whole table exists to prevent.
#
# The camera is org.gnome.Snapshot now: GTK4, but it talks to the hardware through the XDG
# camera portal (which xdg-desktop-portal-kde implements — it prompts for consent, as it
# should), so there is no foreign shell or D-Bus service for it to miss. Verified live on
# this machine: live viewfinder, shutter, no crash. GNOME-branded is fine; COSMIC is not,
# and the distinction is not tribal — a COSMIC app wants com.system76.Cosmic* services that
# genuinely do not exist here, while a GTK app on portals wants nothing MoOS does not have.
KNOWN_GOOD = [
    {"keywords": ["camera", "webcam", "كاميرا", "ويب كام", "تصوير"],
     "id": "org.gnome.Snapshot", "name": "Camera (Snapshot)", "verified": True,
     "note": "تعمل عبر بوّابة الكاميرا — مُختبَرة حيّة على هذا الجهاز (kamoso تنهار بعد ثوانٍ) | "
             "works through the XDG camera portal, verified live here (kamoso segfaults in seconds)"},
    {"keywords": ["video player", "media player", "movie", "mkv", "فيديو", "مشغل", "أفلام"],
     "id": "org.kde.haruna", "name": "Haruna", "verified": True,
     "note": "مشغّل KDE الأصلي (mpv) — يشحن مع MoOS | KDE-native player (mpv), ships with MoOS"},
    {"keywords": ["image viewer", "photo", "picture", "صور", "عارض"],
     "id": "org.kde.gwenview", "name": "Gwenview", "verified": True,
     "note": "عارض صور KDE — يشحن مع MoOS | KDE's image viewer, ships with MoOS"},
    {"keywords": ["music", "audio player", "موسيقى", "أغاني"],
     "id": "org.kde.elisa", "name": "Elisa", "verified": False,
     "note": "مشغّل موسيقى KDE أصلي (Qt) | KDE-native music player (Qt)"},
    {"keywords": ["text editor", "code editor", "محرر", "نصوص"],
     "id": "org.kde.kate", "name": "Kate", "verified": False,
     "note": "محرّر KDE الأصلي | KDE's own editor (Qt)"},
    {"keywords": ["paint", "draw", "رسم", "تصميم"],
     "id": "org.kde.krita", "name": "Krita", "verified": False,
     "note": "رسم رقمي KDE أصلي (Qt) | KDE-native digital painting (Qt)"},
    {"keywords": ["video edit", "montage", "مونتاج", "تحرير فيديو"],
     "id": "org.kde.kdenlive", "name": "Kdenlive", "verified": False,
     "note": "محرّر فيديو KDE أصلي (Qt) | KDE-native video editor (Qt)"},
]

# Not a blocklist — the user may still install any of these. It is a label, because an app
# that is going to crash the moment it opens should say so BEFORE the download, not after.
# The rule is the app's own targeting, not a judgement about its quality: a COSMIC app is
# built against System76's shell services, and they do not exist on Plasma.
def desktop_mismatch(app_id):
    low = app_id.lower()
    if "cosmic" in low:
        return ("مصمّم لسطح COSMIC — قد ينهار على MoOS (KDE) | "
                "built for the COSMIC desktop — may crash on MoOS (KDE)")
    return ""


def decide(results, query, have):
    """Rank the desktop-native answer to the user's NEED first, and label the mismatches."""
    low = " " + query.lower() + " "
    pick = next((e for e in KNOWN_GOOD
                 if any(k in low for k in e["keywords"])), None)

    for r in results:
        r["recommended"] = False
        r["note"] = desktop_mismatch(r["id"])

    if not pick:
        return results

    # Prefer Flathub's own metadata for the pick when the search already found it —
    # a hand-written summary would go stale.
    existing = next((r for r in results if r["id"] == pick["id"]), None)
    rec = existing or {
        "id": pick["id"], "name": pick["name"], "summary": "",
        "icon": "", "verified": False, "installs": 0,
    }
    rec["installed"] = pick["id"] in have
    rec["recommended"] = True
    rec["note"] = pick["note"]
    return [rec] + [r for r in results if r["id"] != pick["id"]]


def search_apps(query):
    query = (query or "").strip()
    if not query:
        return {"results": [], "source": "none"}
    source = "flathub"
    try:
        results = flathub_search(query)
    except Exception:
        results = flatpak_search(query)
        source = "local"
    have = installed_apps()
    for r in results:
        r["installed"] = r["id"] in have
    results = decide(results, query, have)
    return {"results": results, "source": source}


# ── "Test connection" — the whole point of which is that it cannot be faked ──
#
# A settings page that saves a key and says "Saved ✓" tells the user nothing: the
# base URL may be wrong, the key may be dead, the model may not exist, or the
# provider may be behind a CDN that refuses us. So this actually SENDS a request
# and reports what came back — the model's own reply, or the provider's own error.
def test_cloud(base: str, model: str, wire: str, key: str) -> dict:
    base = (base or "").rstrip("/")
    wire = (wire or "openai").lower()
    if not base:
        return {"ok": False, "error": "لا يوجد رابط | no base URL"}
    if not key:
        return {"ok": False, "error": "لا يوجد مفتاح | no API key"}
    if not VERSIONED.search(base):
        base += "/v1"

    probe = "Reply with exactly: OK"
    if wire == "anthropic":
        url = base + "/messages"
        payload = {"model": model, "max_tokens": 16,
                   "messages": [{"role": "user", "content": probe}]}
        headers = {"x-api-key": key, "anthropic-version": "2023-06-01"}
    else:
        url = base + "/chat/completions"
        payload = {"model": model, "max_tokens": 16,
                   "messages": [{"role": "user", "content": probe}]}
        headers = {"Authorization": "Bearer " + key}

    req = urllib.request.Request(
        url, data=json.dumps(payload).encode("utf-8"), method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("User-Agent", USER_AGENT)
    for name, value in headers.items():
        req.add_header(name, value)

    try:
        with urllib.request.urlopen(req, timeout=45) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:200]
        if e.code in (401, 403):
            return {"ok": False, "error": "المفتاح مرفوض | key rejected (%d): %s"
                                          % (e.code, detail)}
        if e.code == 404:
            return {"ok": False, "error": "الرابط أو النموذج غير موجود | not found: %s"
                                          % url}
        return {"ok": False, "error": "خطأ %d | %s" % (e.code, detail)}
    except Exception as e:
        return {"ok": False, "error": "تعذّر الوصول | could not reach it: %s" % e}

    # Read the reply out of whichever shape came back, and report the cost, since
    # the user is paying per token and some gateways inject a large hidden prompt.
    try:
        if wire == "anthropic":
            reply = "".join(b.get("text") or "" for b in data.get("content", [])
                            if b.get("type") == "text")
            usage = data.get("usage") or {}
            used = {"in": usage.get("input_tokens", 0),
                    "out": usage.get("output_tokens", 0)}
        else:
            reply = (data["choices"][0]["message"]["content"] or "").strip()
            usage = data.get("usage") or {}
            used = {"in": usage.get("prompt_tokens", 0),
                    "out": usage.get("completion_tokens", 0)}
    except Exception:
        return {"ok": False,
                "error": "ردّ غير مفهوم | unexpected reply: %s" % json.dumps(data)[:180]}

    return {"ok": True, "reply": reply[:120],
            "model": data.get("model") or model, "usage": used}


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        # No Access-Control-Allow-Origin on purpose: the pure-QML XHR client is
        # not a browser and needs none; omitting it means a real browser page
        # cannot read our responses cross-origin.
        self.end_headers()
        try:
            self.wfile.write(body)
        except Exception:
            pass

    def _reject(self, code, message):
        # The rejection happens before reading a request body. Close the socket
        # so unread bytes cannot be parsed as another keep-alive request.
        self.close_connection = True
        self._send(code, {"error": message})

    def _foreign_origin(self):
        origin = self.headers.get("Origin")
        if not origin:
            return False
        try:
            parsed = urllib.parse.urlsplit(origin)
            port = parsed.port
        except ValueError:
            return True
        expected_port = getattr(self.server, "server_port", PORT)
        return not (
            parsed.scheme == "http"
            and parsed.hostname in ("127.0.0.1", "localhost", "::1")
            and port == expected_port
            and parsed.username is None
            and parsed.password is None
            and not parsed.path
            and not parsed.query
            and not parsed.fragment
        )

    def _guard(self):
        # CSRF/cross-origin defense for this localhost API. A browser cannot set
        # a custom header without a CORS preflight, which we never approve (no
        # OPTIONS handler, no ACAO) — so requiring this header blocks any web
        # page the user visits from driving the service. The QML client sets it
        # directly (not subject to CORS).
        if self.headers.get("X-Moai-Control") != "1":
            self._reject(403, "forbidden")
            return False
        if self._foreign_origin():
            self._reject(403, "bad origin")
            return False
        return True

    def do_GET(self):
        if not self._guard():
            return
        path = urllib.parse.urlparse(self.path)
        route = path.path
        if route == "/providers":
            self._send(200, {"providers": PROVIDERS})
        elif route == "/config":
            c = load()
            self._send(200, {
                "mode": c.get("mode", "local"),
                "cloud_base": c.get("cloud_base", ""),
                "cloud_model": c.get("cloud_model", ""),
                "cloud_wire": c.get("cloud_wire", "openai"),
                "has_key": bool(get_secret()),
            })
        elif route == "/status":
            self._send(200, {"online": brain_online()})
        elif route == "/quick":
            self._send(200, quick())
        elif route == "/models":
            self._send(200, models())
        elif route == "/diagnose":
            # Read-only: reason about system health via moos-selfcheck and return
            # the safe repair menu. The repairs themselves are moos://do/<id>.
            self._send(200, diagnose_system())
        elif route == "/pull":
            # Polled by the picker while a starter downloads.
            with _pull_lock:
                self._send(200, dict(_pull))
        elif route == "/scan":
            self._send(200, scan())
        elif route == "/search":
            q = urllib.parse.parse_qs(path.query).get("q", [""])[0]
            self._send(200, search_apps(q))
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if not self._guard():
            return
        media_type = (self.headers.get("Content-Type") or "").split(
            ";", 1
        )[0].strip().lower()
        if media_type != "application/json":
            return self._reject(415, "content-type must be application/json")
        if self.headers.get("Transfer-Encoding"):
            return self._reject(400, "transfer encoding is not supported")
        lengths = self.headers.get_all("Content-Length") or []
        if len(lengths) != 1:
            return self._reject(411, "one content length is required")
        try:
            n = int(lengths[0])
            if n < 0:
                raise ValueError
        except (TypeError, ValueError):
            return self._reject(400, "bad content length")
        if n > MAX_BODY_BYTES:
            return self._reject(413, "request body too large")
        raw = self.rfile.read(n) or b"{}"
        try:
            data = json.loads(raw)
        except Exception:
            return self._send(400, {"error": "bad json"})
        if not isinstance(data, dict):
            return self._send(400, {"error": "json body must be an object"})
        route = urllib.parse.urlparse(self.path).path

        # /test — try the provider for real, without saving anything. The key may
        # come from the form (the user is still typing it) or from private
        # storage (it is already saved and the field was left blank).
        if route == "/test":
            return self._send(200, test_cloud(
                data.get("cloud_base", ""),
                data.get("cloud_model", ""),
                data.get("cloud_wire", "openai"),
                data.get("cloud_key") or get_secret()))

        # /pull — download a curated starter brain. The picker's "one-tap
        # download" label finally has a machine behind it.
        if route == "/pull":
            return self._send(200, start_pull((data.get("model") or "").strip()))

        # /delete — remove a model the selected engine actually lists, never the
        # default brain. Nothing user-typed reaches a shell; Ollama receives the
        # validated name as JSON and RamaLama receives one fixed argv element.
        if route == "/delete":
            return self._send(200, delete_model(data.get("model") or ""))

        if route != "/config":
            return self._send(404, {"error": "not found"})
        requested_mode = data.get("mode")
        mode = requested_mode if requested_mode in ("local", "cloud", "hybrid") else "local"
        key = data.get("cloud_key") or ""
        if key and not store_secret(key):
            return self._send(503, {"error": "Mo AI private storage is unavailable"})
        # One read-modify-write transaction: ThreadingHTTPServer may receive two
        # settings saves together, and neither may overwrite fields from a
        # newer request using a stale snapshot.
        with CONFIG_LOCK:
            cur = load()
            out = {
                "mode": mode,
                "cloud_base": data.get("cloud_base", cur.get("cloud_base", "")),
                "cloud_model": data.get("cloud_model", cur.get("cloud_model", "")),
                "cloud_wire": data.get("cloud_wire", cur.get("cloud_wire", "openai")),
            }
            save(out)

        # This used to `systemctl disable --now` one brain and `enable --now` the
        # other, because both listened on 8080. They no longer do: the gateway owns
        # 8080 and routes each REQUEST, so `mode` is now only the DEFAULT for a
        # request that does not name a brain. Nothing is bounced, nothing is torn
        # down mid-conversation, and the local brain is left exactly as the user
        # left it — the gateway starts it on demand if a request routes to it.
        with _models_lock:                 # the provider may have changed
            _models_cache["data"] = None
        with _cloud_lock:
            _cloud_cache["ts"] = 0.0
        # `enable` (no --now) is enough: the unit is already WantedBy=default.target,
        # so starting it here too just races the boot activation for the port. Only
        # start it if it is not already running, to avoid a double-bind at boot.
        if not user_unit_active(GATEWAY_UNIT):
            sysctl("enable", "--now", GATEWAY_UNIT)
        else:
            sysctl("enable", GATEWAY_UNIT)
        self._send(200, {"ok": True, "mode": mode})

    def do_OPTIONS(self):
        # No CORS grant: foreign browser pages cannot obtain permission for the
        # X-Moai-Control header required by every route.
        self._reject(405, "method not allowed")


if __name__ == "__main__":
    ensure_front_door()
    threading.Thread(target=plan_worker, daemon=True).start()
    srv = None
    # See moai-gateway: a boot-time bind race must back off, not crash.
    deadline = time.time() + 60
    while srv is None:
        try:
            srv = ThreadingHTTPServer(("127.0.0.1", PORT), H)
        except OSError as e:
            if e.errno == 98 and time.time() < deadline:
                sys.stderr.write("moai-control: port %d busy, retrying in 2s (%s)\n" % (PORT, e))
                sys.stderr.flush()
                time.sleep(2)
                continue
            raise
    srv.serve_forever()
