#!/usr/bin/env bash
# moos-apply-theme — apply the full MoOS UI2 Global Theme once per user.
#
# WHY: /etc/xdg/kdeglobals sets [KDE] LookAndFeelPackage=org.moos.ui2, but
# Plasma 6 only AUTO-applies a subset of a default Global Theme (color scheme,
# icons) on a fresh login — it does NOT apply the wallpaper, splash, or the
# rest of the "look". So a freshly-created INSTALLED user lands on a half-Breeze
# desktop that does not look like MoOS. This runs once on first login and
# explicitly applies the whole thing (colors + wallpaper + splash).
#
# Separate marker from moos-firstrun on purpose: a system that was already
# installed (and whose user already saw moos-firstrun) still gets the theme
# applied on the first login AFTER a `bootc upgrade` that ships this file.
set -uo pipefail

# Versioned marker: bump THEME_REV whenever the MoOS UI assets change so a later
# `bootc upgrade` re-applies the new look exactly once for EXISTING users (a
# fixed marker would skip every revision after the first). Old markers are
# cleaned up so they don't accumulate.
# 22: apply the unified MoOS visual system to existing users: rebuilt Plasma
#     controls and Aurorae chrome, first-party icons, exact GTK/GSettings pins,
#     balanced blur, localized RTL clock, and the refreshed 4K wallpaper pair.
# 23: the dock's own revision. The rim art is repaired (a malformed corner path
#     dropped a stray turquoise line into the dock, and the rim died at the
#     corner/side seam), task tiles finally show which apps are OPEN, and the
#     clock is PUT BACK: rev 22's migration only rewrote an existing
#     org.kde.plasma.digitalclock into the MoOS clock, so a panel that had no
#     clock at all — the maintainer's — silently stayed clockless.
# 24: Aurorae frames changed (flat maximized bar, centred buttons, no blur mask),
#     and the tray hide-list changed — the remote-control indicator is UNHIDDEN
#     (a security signal that must surface when Active) and the video bridge
#     gained its Arabic Id. The rev bump re-runs the tray collapse so existing
#     sessions get the corrected list, and restarts the shell over the new art.
# 26: palette-matched Tidal Cut icon overlays plus the refined Launcher/control
#     states. Re-apply once so existing users stop carrying the shared light
#     symbolic fallback in dark/accent themes.
# 27: the nine first-party application marks are redrawn and baked per palette.
#     Existing sessions must drop ~/.local/share/icons overrides of those marks
#     (and of MoOSUI2*/hicolor moos-* trees left by live previews) — otherwise
#     XDG_DATA_HOME keeps showing the retired Breeze-blue geometry forever while
#     every gate on /usr stays green.
# 28: lock-screen wallpaper becomes part of the theme contract for EXISTING users.
#     The v27 marker short-circuited on theme_intact() before checking the lock
#     wallpaper, so only fresh users received it. Re-apply once, then require an
#     exact package match: NovaLight is not Nova merely because one name prefixes
#     the other.
# 29: the application marks gain the 9-layer liquid-glass plate (rebaked into all
#     14 palette overlays) and the launcher's session strip gains working hover
#     tooltips plus honest logout/switch-user glyphs. Existing sessions must drop
#     home icon previews AND home shadows of the first-party MoOS plasmoids —
#     a ~/.local/share/plasma/plasmoids/org.moos.brand left by a live preview
#     outranks /usr forever and no earlier revision cleaned that class.
# 30: the Horizon Bar becomes TWO glass slabs. A single floating panel cannot
#     centre the task area (Plasma has no flexible spacer and the system zone
#     outweighs the brand button by ~450 physical px, measured), so the roles
#     split into a CENTERED dock capsule (brand + tasks — the true screen centre
#     at every task count) and a CORNER system capsule (tray + clock), and the
#     keyboard/language indicator is pinned into the tray's always-shown list.
#     All bar structure now lives in moos-bar-apply (single source:
#     /usr/share/moos/moos-bar.conf), which does the split, the tray pin, one
#     guarded plasmashell restart and a live readback of its own.
# 31: the shadow cleanup loop now covers ALL 16 family desktop themes, not just
#     the base MoOSUI2/MoOSUI2Light. A live preview of any family member
#     (e.g. MoOSUI2Nova) left a shadow under ~/.local/share/plasma/desktoptheme/
#     that outranked /usr and froze the user on a stale theme while every gate
#     stayed green — the same trap rev 29 fixed for plasmoids. Tasks SVG
#     hover/focus states are refined: subtle underline indicators replace the
#     bordered rectangles that read as "boxes" on the panel.
# 32: the last two boxes are gone from the shipped art — the frame Plasma's shell
#     paints behind an OPEN panel applet (widgets/tabbar.svg `*-active-tab`, a
#     0.84 slab with a 0.88 accent rim) and the flat tile every task state filled
#     behind its icon. This rev exists for the SVG CACHE: Plasma serves
#     ~/.cache/plasma_theme_<Theme>.kcache and ~/.cache/ksvg-elements, so new art
#     under a frozen OSTree /usr does not reach the screen until those are
#     purged, which only happens inside this once-per-revision migration. Without
#     the bump an updated machine keeps rendering the boxes and every gate stays
#     green — the exact class of trap rev 29 and 31 were written for.
# 33: the bar is ONE capsule again. Rev 30 split it into a centred dock capsule
#     and a corner system capsule to win the true screen centre for the task
#     area; on the real machine that ships as two detached pieces of glass with
#     a wide gap and the clock marooned in the corner, and the owner rejected it
#     on sight. moos-bar-apply no longer splits — it MERGES every bottom panel
#     into one and orders the applets from moos-bar.conf. This rev is what makes
#     an already-split desktop converge: the merge is file surgery on the
#     appletsrc and only runs inside this once-per-revision migration.
# 34: motion is sized to the machine. moos-visual-tier probes the render node,
#     GPU driver, cores, memory and panel size, classifies the host as flagship
#     / balanced / essential, and writes the matching KWin + Kirigami profile.
#     Until now every MoOS install ran the profile tuned on a discrete-GPU 4K
#     desktop, including cloud hosts with no render node at all.
# 35: the tray gets shorter and the context island arrives. shownItems drops from
#     six forced icons to four (bluetooth and brightness move to auto, where they
#     surface only when they have something to say); org.moos.island joins
#     extraItems — KNOWN to the tray but never forced — so Plasma's own
#     ActiveStatus/PassiveStatus decides, and the island appears only while a
#     player is actually playing. Verified live against a real MPRIS2 service on
#     the session bus: one mark appears, and disappears with the player.
# 36: the launcher's favourites grid assembles instead of appearing — each tile
#     arrives a beat after the one before it (24 ms, capped at 11 steps), and the
#     entrance now replays on EVERY open instead of once per session. This rev
#     exists because the change is shipped QML: OSTree pins /usr mtimes, Qt's
#     qmlcache is keyed on mtime, and without the bump plasmashell keeps
#     executing the compiled OLD widget after the upgrade.
# 37: the dock becomes a material and the home button becomes a button. The
#     glass ramp spanned 0.15 of alpha — measured on the shipped NovaLight panel
#     it travelled #C2DAE6 -> #AECDD8 under an almost constant alpha, which is a
#     wash, not glass. The range is doubled (0.50..0.86 dark, 0.58..0.88 light):
#     more frost shows at the top, the bottom carries the icons. And the MoOS
#     button was literally color "transparent" at rest — the one control wearing
#     the system's name was invisible until the pointer found it; it now rests at
#     highlight 0.10.
# 38: the launcher grid becomes a grid of CARDS, and the light dock keeps its
#     depth through the family wash. App tiles were "transparent" until hovered
#     — the same defect the home button had — so the grid read as loose icons
#     floating in an empty pane. They now rest on the TEXT colour at 0.05, which
#     is the one value that lifts a card off its surface on a light theme AND a
#     dark one, and they lift 2 px on hover. Grid icons 44 -> 52.
#
#     The light panel ramp was being flattened by the family wash: mixing the
#     three panel roles 55% toward a near-white tint pulled top, middle and
#     bottom toward the same colour, so the base's 34 luminance steps collapsed
#     to 13 and the dock rendered as flat paint. The wash now moves WHERE the
#     dock sits without changing HOW FAR it travels.
# 39: AMPLITUDE. Revs 32-38 were all correct and all invisible, and the reason
#     was one habit: every value was chosen in the 0.05..0.12 band, which over
#     pale glass renders as 5-11 luminance steps. A person needs roughly 15 to
#     register that anything changed. Measured on the running dock, the home
#     button's resting pill was ELEVEN steps against bare glass — present in the
#     code, absent to the eye. It is 0.24 now and measures 21.5. The launcher's
#     tile cards go 0.05 -> 0.11 and their hover 0.14 -> 0.24 for the same
#     reason. Nothing visual ships from here without that measurement.
THEME_REV=39
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir" 2>/dev/null || true
marker="${state_dir}/moos-ui2-theme-applied.v${THEME_REV}"

# Plasma can launch the same autostart entry twice while session restore is
# settling. Two migrations removing/recreating the same applet are not
# idempotent while they overlap, so only one instance may own this revision.
if command -v flock >/dev/null 2>&1; then
    lock_dir="${XDG_RUNTIME_DIR:-$state_dir}"
    mkdir -p "$lock_dir" 2>/dev/null || true
    if exec 9>"${lock_dir}/moos-theme.lock"; then
        flock -n 9 || exit 0
    fi
fi

# MoOS now ships TWO looks, and they are equally legitimate. Everything below that
# asks "is the desktop still MoOS?" must accept either — a user who chose Light and
# gets dragged back to Dark on every login has not been protected, they have been
# overruled.
DARK_LNF="org.moos.ui2"
LIGHT_LNF="org.moos.ui2.light"
DARK_DECO="__aurorae__svg__MoOSUI2"
LIGHT_DECO="__aurorae__svg__MoOSUI2Light"
# The extended MoOS theme family (same UI2 engine, own palettes). A member the
# user picked is a durable choice — the login repair PRESERVES it, it does not
# drag it back to Dark. Their assets are derived from the LNF suffix (nova ->
# MoOSUI2Nova), so one branch covers all four.
NOVA_LNF="org.moos.ui2.nova"
AMETHYST_LNF="org.moos.ui2.amethyst"
MIDNIGHT_LNF="org.moos.ui2.midnight"
AURORA_LNF="org.moos.ui2.aurora"
NOVA_LIGHT_LNF="org.moos.ui2.nova.light"
AMETHYST_LIGHT_LNF="org.moos.ui2.amethyst.light"
AURORA_LIGHT_LNF="org.moos.ui2.aurora.light"
DAYLIGHT_LNF="org.moos.ui2.midnight.light"
GAMING_LNF="org.moos.ui2.gaming"
DEV_LNF="org.moos.ui2.dev"
STUDY_LNF="org.moos.ui2.study"
GAMING_LIGHT_LNF="org.moos.ui2.gaming.light"
DEV_LIGHT_LNF="org.moos.ui2.dev.light"
STUDY_LIGHT_LNF="org.moos.ui2.study.light"

# UI1 remains installed as an explicit rollback. It counts as intact after the
# UI2 migration marker exists, so `moos-theme ui1-dark|ui1-light` is a durable
# user choice rather than something the login repair immediately overwrites.

log="${XDG_CACHE_HOME:-$HOME/.cache}/moos-apply-theme.log"
mkdir -p "$(dirname "$log")" 2>/dev/null || true

# What the desktop is ACTUALLY wearing right now. Empty (or no kreadconfig6) means
# "cannot tell" — say so, and let the caller fall back to trusting the marker rather
# than re-applying the theme on every single login.
current_lookandfeel() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null
}

# The decoration is checked separately because it can be wrong on its own: it lives in a
# different file, and ~/.config/kdedefaults/kwinrc can hold Breeze's while the Global
# Theme still reads org.moos.nova. A "Nova" desktop wearing Breeze title bars is exactly
# the state every install shipped in, and it must count as drift.
current_decoration() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme 2>/dev/null
}

current_scheme() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null
}

current_style() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null
}

current_icons() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null
}

# The desktop wallpaper is the MoOS SCENE plugin (org.moos.ui2.wallpaper):
# wallpaper image + the Tidal Glass dashboard, painted as one layer BELOW the
# Folder View icons. "Complete" means every desktop containment runs the scene
# plugin AND its Image config points at the expected wallpaper package.
desktop_wallpapers_complete() {
    local expected="$1" result desktops matching config
    if command -v gdbus >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        result="$(timeout 4s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var expected = "'"$expected"'";
                var ds = desktops();
                var matching = 0;
                for (var i = 0; i < ds.length; i++) {
                    ds[i].currentConfigGroup = ["Wallpaper", "org.moos.ui2.wallpaper", "General"];
                    var image = String(ds[i].readConfig("Image", ""));
                    if (ds[i].wallpaperPlugin == "org.moos.ui2.wallpaper"
                            && image.indexOf(expected) >= 0) { matching++; }
                }
                print("desktops=" + ds.length + ";matching=" + matching);
            ' 2>/dev/null)" || result=""
        result="$(printf '%s\n' "$result" \
            | grep -oE 'desktops=[1-9][0-9]*;matching=[0-9]+' | head -n1)"
        if [ -n "$result" ]; then
            desktops="${result#desktops=}"
            desktops="${desktops%%;*}"
            matching="${result##*matching=}"
            [ "$desktops" = "$matching" ]
            return
        fi
    fi

    config="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
    [ -r "$config" ] || return 1
    awk -v expected="$expected" '
        /^\[Containments\]\[[^]]+\]\[Wallpaper\]\[org\.moos\.ui2\.wallpaper\]\[General\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            split(section, parts, "\\]\\[")
            containment = parts[1]
            mode = "wallpaper"
            next
        }
        /^\[Containments\]\[[^]]+\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            sub(/\]$/, "", section)
            containment = section
            mode = "containment"
            next
        }
        /^\[/ { mode = ""; next }
        mode == "containment" && /^plugin=/ {
            rootPlugin[containment] = substr($0, 8)
            next
        }
        mode == "containment" && /^wallpaperplugin=/ {
            wallPlugin[containment] = substr($0, 17)
            next
        }
        mode == "wallpaper" && /^Image=/ {
            image[containment] = substr($0, 7)
            next
        }
        END {
            desktops = 0
            matching = 0
            for (id in rootPlugin) {
                if (rootPlugin[id] == "org.kde.panel") { continue }
                desktops++
                if (wallPlugin[id] == "org.moos.ui2.wallpaper" \
                        && index(image[id], expected) > 0) { matching++ }
            }
            exit !(desktops > 0 && matching == desktops)
        }
    ' "$config" 2>/dev/null
}

# Point every desktop containment at the MoOS scene: the wallpaper plugin that
# carries the dashboard bento below the icons. Also removes the RETIRED desktop
# applets (the bento used to be org.moos.ui2.dashboard, and before that
# org.moos.nova.deskclock — as widgets they always sat ON TOP of the icons) and
# keeps the Folder View icons right-aligned, opposite the bento. Idempotent,
# one D-Bus turn, safe on the live ISO — the scene cannot cover anything.
apply_desktop_scene() {
    local image="$1" result
    command -v gdbus >/dev/null 2>&1 || return 1
    command -v timeout >/dev/null 2>&1 || return 1
    result="$(timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var IMAGE = "'"$image"'";
            var ds = desktops();
            var incomplete = (ds.length === 0);
            for (var i = 0; i < ds.length; i++) {
                var d = ds[i];
                try {
                    d.currentConfigGroup = ["General"];
                    d.writeConfig("alignment", "1");
                    d.writeConfig("sortMode", "1");
                    var ws = d.widgets();
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == "org.moos.ui2.dashboard"
                                || ws[j].type == "org.moos.nova.deskclock") {
                            ws[j].remove();
                        }
                    }
                    d.wallpaperPlugin = "org.moos.ui2.wallpaper";
                    d.currentConfigGroup = ["Wallpaper", "org.moos.ui2.wallpaper", "General"];
                    d.writeConfig("Image", IMAGE);
                    d.reloadConfig();
                } catch (e) { incomplete = true; }
            }
            print(incomplete ? "scene-incomplete" : "scene-ready");
        ' 2>>"$log")" || return 1
    case "$result" in *scene-ready*) return 0 ;; *) return 1 ;; esac
}

current_lockscreen_wallpaper() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group org.kde.image --group General --key Image 2>/dev/null
}

# Prefer the running containments, then fall back to Plasma's persisted source
# of truth when autostart arrives before the shell's scripting endpoint. The
# invariant is PER CONTAINMENT: every desktop runs the MoOS scene wallpaper
# (which carries the bento BELOW the icons) and carries ZERO of the retired
# desktop-applet generations. A global check is wrong as soon as a second
# monitor or Activity adds another legitimate desktop containment.
current_scene_state() {
    local result config
    if command -v gdbus >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        result="$(timeout 4s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var ds = desktops();
                var sceneEach = ds.length > 0;
                for (var i = 0; i < ds.length; i++) {
                    var stale = 0;
                    var ws = ds[i].widgets();
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == "org.moos.nova.deskclock") { stale++; }
                        if (ws[j].type == "org.moos.ui2.dashboard") { stale++; }
                    }
                    if (stale > 0
                            || ds[i].wallpaperPlugin != "org.moos.ui2.wallpaper") {
                        sceneEach = false;
                    }
                }
                var state = sceneEach ? "scene-each" : "mixed";
                print("desktops=" + ds.length + ";state=" + state);
            ' 2>/dev/null)" || result=""
        # A responsive shell can still answer before it has created any desktop
        # containments. Never accept that transient empty result as real state;
        # let the persisted parser below decide instead.
        result="$(printf '%s\n' "$result" \
            | grep -oE 'desktops=[1-9][0-9]*;state=(scene-each|mixed)' \
            | head -n1)"
        if [ -n "$result" ]; then
            printf '%s\n' "${result##*state=}"
            return 0
        fi
    fi

    config="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
    [ -r "$config" ] || return 1
    # Parse only direct applets of top-level desktop containments. Nested tray
    # applets and panels also carry plugin= keys and must not enter this count.
    # The parser intentionally returns failure when no persisted desktop exists:
    # "zero desktops" is startup uncertainty, never a valid completed theme.
    awk '
        /^\[Containments\]\[[^]]+\]\[Applets\]\[[^]]+\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            split(section, parts, "\\]\\[")
            containment = parts[1]
            mode = "applet"
            next
        }
        /^\[Containments\]\[[^]]+\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            sub(/\]$/, "", section)
            containment = section
            mode = "containment"
            next
        }
        /^\[/ { mode = ""; next }
        mode == "containment" && /^plugin=/ {
            plugin = substr($0, 8)
            rootPlugin[containment] = plugin
            next
        }
        mode == "containment" && /^wallpaperplugin=/ {
            wallPlugin[containment] = substr($0, 17)
            next
        }
        mode == "applet" && /^plugin=org\.moos\.nova\.deskclock$/ {
            stale[containment]++
            next
        }
        mode == "applet" && /^plugin=org\.moos\.ui2\.dashboard$/ {
            stale[containment]++
            next
        }
        END {
            desktops = 0
            sceneEach = 1
            for (id in rootPlugin) {
                if (rootPlugin[id] == "org.kde.panel") { continue }
                desktops++
                if ((stale[id] + 0) != 0) { sceneEach = 0 }
                if (wallPlugin[id] != "org.moos.ui2.wallpaper") { sceneEach = 0 }
            }
            if (desktops == 0) { exit 2 }
            if (sceneEach) { print "scene-each" }
            else { print "mixed" }
        }
    ' "$config" 2>/dev/null
}

# The marker means "this revision was applied once". It does NOT mean the desktop still
# LOOKS like MoOS, and those two came apart the moment Plasma started rewriting
# LookAndFeelPackage behind our back (see defuse_automatic_lookandfeel below). An
# apply-once marker on a desktop that has silently reverted to Breeze is precisely the
# thing that keeps it Breeze: the repair exists, and its own marker disables it.
#
# So the marker is honoured only while the look is intact. If it is not, this run repairs
# it however many times it has run before — that is the whole point.
# Which MoOS look is the user wearing, if any? "Intact" means the look-and-feel is
# one of ours AND the decoration is the one that belongs to it. A Nova Light
# desktop wearing the dark decoration is drift just as much as a Breeze one is.
theme_intact() {
    local lnf="$1" deco="$2" scheme style icons cursor scene
    local expected_deco expected_scheme expected_style expected_icons expected_cursor expected_scene
    scheme="$(current_scheme)" || return 1
    style="$(current_style)" || return 1
    icons="$(current_icons)" || return 1
    scene="$(current_scene_state)" || return 1

    case "$lnf" in
        "$DARK_LNF")
            expected_deco="$DARK_DECO"; expected_scheme=MoOSUI2Dark
            expected_style=MoOSUI2; expected_icons=MoOSUI2
            expected_cursor=MoOS
            expected_scene=scene-each
            ;;
        "$LIGHT_LNF")
            expected_deco="$LIGHT_DECO"; expected_scheme=MoOSUI2Light
            expected_style=MoOSUI2Light; expected_icons=MoOSUI2Light
            expected_cursor=MoOSDark
            expected_scene=scene-each
            ;;
        "$NOVA_LNF"|"$AMETHYST_LNF"|"$MIDNIGHT_LNF"|"$AURORA_LNF")
            local fam="${lnf##*.}"; local Fam="${fam^}"   # nova -> Nova
            expected_deco="__aurorae__svg__MoOSUI2${Fam}"
            expected_scheme="MoOSUI2${Fam}"; expected_style="MoOSUI2${Fam}"
            expected_icons="$expected_style"; expected_cursor=MoOS
            expected_scene=scene-each
            ;;
        "$NOVA_LIGHT_LNF"|"$AMETHYST_LIGHT_LNF"|"$AURORA_LIGHT_LNF")
            local fam="${lnf%.light}"; fam="${fam##*.}"; local Fam="${fam^}"
            expected_deco="__aurorae__svg__MoOSUI2${Fam}Light"
            expected_scheme="MoOSUI2${Fam}Light"; expected_style="MoOSUI2${Fam}Light"
            expected_icons="$expected_style"; expected_cursor=MoOSDark
            expected_scene=scene-each
            ;;
        "$DAYLIGHT_LNF")
            expected_deco=__aurorae__svg__MoOSUI2Daylight
            expected_scheme=MoOSUI2Daylight; expected_style=MoOSUI2Daylight
            expected_icons="$expected_style"; expected_cursor=MoOSDark
            expected_scene=scene-each
            ;;
        "$GAMING_LNF"|"$DEV_LNF"|"$STUDY_LNF")
            case "$lnf" in
                "$GAMING_LNF") local Fam=Arena ;;
                "$DEV_LNF") local Fam=Forge ;;
                *) local Fam=Scholar ;;
            esac
            expected_deco="__aurorae__svg__MoOSUI2${Fam}"
            expected_scheme="MoOSUI2${Fam}"; expected_style="MoOSUI2${Fam}"
            expected_icons="$expected_style"; expected_cursor=MoOS
            expected_scene=scene-each
            ;;
        "$GAMING_LIGHT_LNF"|"$DEV_LIGHT_LNF"|"$STUDY_LIGHT_LNF")
            case "$lnf" in
                "$GAMING_LIGHT_LNF") local Fam=ArenaLight ;;
                "$DEV_LIGHT_LNF") local Fam=ForgeLight ;;
                *) local Fam=ScholarLight ;;
            esac
            expected_deco="__aurorae__svg__MoOSUI2${Fam}"
            expected_scheme="MoOSUI2${Fam}"; expected_style="MoOSUI2${Fam}"
            expected_icons="$expected_style"; expected_cursor=MoOSDark
            expected_scene=scene-each
            ;;
        *) return 1 ;;
    esac

    # The cursor is part of the look (a white pointer on Tidal Light's mint is
    # unreadable), and cursor drift used to be invisible to this readback — the
    # marker stayed green while the pointer stayed wrong. An EMPTY value is not
    # drift (a fresh user may simply not have the key yet; the LNF defaults
    # cover them); only a conflicting explicit value is.
    cursor="$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme 2>/dev/null)" || cursor=""

    [ "$deco" = "$expected_deco" ] \
        && [ "$scheme" = "$expected_scheme" ] \
        && [ "$style" = "$expected_style" ] \
        && [ "$icons" = "$expected_icons" ] \
        && { [ -z "$cursor" ] || [ "$cursor" = "$expected_cursor" ]; } \
        && [ "$scene" = "$expected_scene" ]
}

# Completion is stricter than steady-state integrity: a user may deliberately
# replace their wallpaper later, but the first revision apply may only mark
# itself done after both desktop and lock-screen received the requested package.
theme_complete() {
    local lnf="$1" deco="$2" wallpaper_package="$3" lockscreen
    theme_intact "$lnf" "$deco" || return 1
    desktop_wallpapers_complete "$wallpaper_package" || return 1
    lockscreen="$(current_lockscreen_wallpaper)" || return 1
    [ "$lockscreen" = "$wallpaper_package" ]
}

# Which one should a repair restore? Whichever the user last chose. Only when the
# desktop has drifted to something that is not MoOS at all do we impose the
# default. Re-applying Dark to someone who deliberately picked Light would make
# this script the bug it exists to fix.
target_lnf() {
    local current completed
    if [ "$#" -ge 1 ]; then
        current="$1"
    else
        current="$(current_lookandfeel)"
    fi
    if [ "$#" -ge 2 ]; then
        completed="$2"
    elif [ -e "$marker" ]; then
        completed=true
    else
        completed=false
    fi

    # MoOS ships a FAMILY of looks now (the Graphite/Tidal base pair plus nova,
    # amethyst, midnight, aurora, gaming, dev, study — each with a light sibling:
    # 16 installed Global Themes). ANY of them is a deliberate user choice and must
    # be PRESERVED on a self-heal — the source of truth for "is this a real theme"
    # is whether its package is on disk, not a hand-kept list here (that list is
    # exactly what silently drifted and dragged gaming/dev/study/*-light back to
    # Dark). Only a look that is NOT an installed MoOS package (an old Nova/UI1, a
    # Fedora look, or Breeze) resolves to the dark default — the one guaranteed to
    # exist. Plasma does not error on a missing theme, it silently serves Breeze,
    # so the on-disk check is what keeps a stale name from persisting.
    case "$current" in
        org.moos.ui2|org.moos.ui2.*)
            # LNF_ROOT is overridable so the gate can point the existence check at
            # the in-tree packages; at runtime it defaults to the installed path.
            if [ -d "${LNF_ROOT:-/usr/share/plasma/look-and-feel}/$current" ]; then
                echo "$current"
            else
                echo "$DARK_LNF"
            fi
            ;;
        *) echo "$DARK_LNF" ;;
    esac
}

# Disarm Plasma's day/night Look-and-Feel switch BEFORE applying anything — otherwise it
# is free to undo this run's work at the next sunrise.
#
# The switch keeps its two targets in [KDE] Default{Light,Dark}LookAndFeel and resolves
# them BY NAME when it fires. If the named package is not installed, Plasma does not fall
# back to the configured LookAndFeelPackage — it falls back to BREEZE, and it persists
# that choice into the user's kdeglobals, which outranks /etc/xdg for good.
#
# This is not hypothetical, it is the bug this revision exists for. Users created under
# Fedora's kde-settings carried AutomaticLookAndFeel=true with
# DefaultLightLookAndFeel=org.fedoraproject.fedora.desktop. MoOS then removed Fedora's
# look-and-feel packages (a machine called MoOS should not offer another distribution's
# themes). The system default still said org.moos.nova and the image still shipped it —
# but on the first boot after that upgrade the switch resolved a package that no longer
# existed, and the desktop came up Breeze Dark.
#
# MoOS now ships a matched light/dark pair, so the switch gets POINTED AT THEM instead
# of being deleted. Whichever way it fires, it lands on MoOS.
#
# AutomaticLookAndFeel itself is left exactly as the user set it. Arming it is the
# user's call (`moos-theme auto`); all this guarantees is that if it IS armed, it
# cannot reach a non-MoOS theme.
#
# IT MUST RUN ABOVE THE MARKER GATE, AND IT DID NOT. Its own comment claimed it "runs
# before anything else applies"; the call sat ~70 lines BELOW the `exit 0` that fires
# whenever the marker exists and the look is intact — i.e. on every ordinary login. So
# on the maintainer's own machine the switch kept a target written back when UI1 WAS the
# light theme: DefaultLightLookAndFeel=org.moos.ui.light, with the switch armed. At
# sunrise Plasma resolved the light half by name, and the desktop was pulled to UI1 —
# nobody chose that. Worse, the pull is self-ratifying: target_lnf() reads UI1 + a
# completed marker as "an explicit rollback", so every later repair preserved it, and
# the wallpaper and dashboard (which a Plasma theme switch does not carry) stayed UI2 —
# a UI2 desktop wearing a UI1 face. An intact look TODAY says nothing about where the
# switch will land TOMORROW, which is exactly why this cannot live behind that gate.
# It is idempotent and costs two kreadconfig6 calls; there is no reason to guard it.
pin_lookandfeel_switch_targets() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 0
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0

    local want key val
    for key in DefaultLightLookAndFeel DefaultDarkLookAndFeel; do
        if [ "$key" = "DefaultLightLookAndFeel" ]; then want="$LIGHT_LNF"; else want="$DARK_LNF"; fi

        # Never point the switch at a package that is not on disk — that is the
        # exact failure that put every MoOS desktop into Breeze Dark.
        if [ ! -d "/usr/share/plasma/look-and-feel/$want" ]; then
            val="$(kreadconfig6 --file kdeglobals --group KDE --key "$key" 2>/dev/null)"
            [ -n "$val" ] && kwriteconfig6 --file kdeglobals --group KDE --key "$key" --delete 2>/dev/null \
                && echo "dropped ${key}=${val}: ${want} is not installed" >>"$log" 2>/dev/null
            continue
        fi

        val="$(kreadconfig6 --file kdeglobals --group KDE --key "$key" 2>/dev/null)"
        [ "$val" = "$want" ] && continue
        kwriteconfig6 --file kdeglobals --group KDE --key "$key" "$want" 2>/dev/null \
            && echo "pinned ${key}=${want} (was '${val:-unset}')" >>"$log" 2>/dev/null
    done
    return 0
}
pin_lookandfeel_switch_targets

# The event sounds, the same trap and the same gate. [Sounds] is NOT in the entry set
# LookAndFeelManager applies, so it writes nothing to kdedefaults — and the user's own
# kdeglobals, carrying Theme=freedesktop from the Breeze/Fedora defaults they were created
# under, outranks both the theme's declaration and /etc/xdg/kdeglobals.
#
# This reconcile existed, and the comment beside it said the MoOS sound theme "has shipped
# since day one and has never once played". It still had not: the write lived ~400 lines
# below the marker gate, so it only ran on a real apply, and the drift it repairs happens
# AFTER one (Plasma's own Sound settings rewrite the key). The proof is a failed unit on
# this machine every boot: plasma-startupsound exits 1 with canberra "File or data not
# found" — it is looking up desktop-login in `freedesktop`, which has no such sound, while
# /usr/share/sounds/moos/stereo/desktop-login.oga sits there unplayed.
#
# Two idempotent kwriteconfig calls. Nothing about them needs a heavy re-apply to be
# allowed to run, so they no longer live behind one.
pin_sound_theme() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    kwriteconfig6 --file kdeglobals --group Sounds --key Theme moos 2>/dev/null || return 0
    kwriteconfig6 --file kdeglobals --group Sounds --key Enable true 2>/dev/null || return 0
    return 0
}
pin_sound_theme

# User-local Plasma data outranks /usr/share and can be created by a preview at
# any time, including after THEME_REV was applied. Reconcile the complete set of
# MoOS-owned packages on every invocation, before the marker fast path. Move
# shadows to a dated quarantine so preview work remains recoverable while the
# official image copy becomes authoritative again. The operation is idempotent:
# an absent source is ignored and unrelated user packages are never inspected.
quarantine_moos_data_shadows() {
    local user_share="${XDG_DATA_HOME:-$HOME/.local/share}"
    local system_share="${MOOS_SYSTEM_SHARE:-/usr/share}"
    local stamp backup rel source target
    stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
    backup="${user_share}/MoOS/theme-shadow-backups/${stamp}"

    while IFS= read -r -d '' source; do
        rel="${source#${user_share}/}"
        target="${system_share}/${rel}"
        [ -e "$target" ] || continue
        mkdir -p "${backup}/$(dirname "$rel")" 2>/dev/null || continue
        if mv -- "$source" "${backup}/${rel}" 2>/dev/null; then
            echo "quarantined user shadow ${rel} in ${backup}" >>"$log" 2>/dev/null || true
        fi
    done < <(
        for root in \
            "${user_share}/plasma/plasmoids/org.moos."* \
            "${user_share}/plasma/desktoptheme/MoOSUI2"* \
            "${user_share}/plasma/look-and-feel/org.moos.ui2"* \
            "${user_share}/aurorae/themes/MoOSUI2"* \
            "${user_share}/color-schemes/MoOSUI2"* \
            "${user_share}/konsole/MoOSUI2"* \
            "${user_share}/wallpapers/MoOSUI2"* \
            "${user_share}/icons/MoOSUI2"*; do
            [ -e "$root" ] || continue
            printf '%s\0' "$root"
        done
    )
}

# This must precede the marker exit below. A preview can create a new shadow
# after a successful revision apply, and waiting for a revision bump leaves the
# running desktop on the preview forever.
quarantine_moos_data_shadows

# Read the value the desktop scene is actually configured with (first desktop):
# prefer the running shell, fall back to the persisted file. Empty = cannot tell.
current_desktop_wallpaper_value() {
    local result config
    if command -v gdbus >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        result="$(timeout 4s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var ds = desktops();
                if (ds.length > 0) {
                    ds[0].currentConfigGroup = ["Wallpaper", "org.moos.ui2.wallpaper", "General"];
                    print("WPV:" + ds[0].readConfig("Image", ""));
                }
            ' 2>/dev/null)" || result=""
        # gdbus prints a D-Bus tuple and quotes strings with SINGLE quotes:
        #     ('WPV:/usr/share/wallpapers/MoOSUI2Arena',)
        # Excluding only `"` therefore captured the trailing `',)` as part of the
        # path, so the readback could never equal the package it had just written.
        # Measured on the Cloud host: every login logged
        #   steady-state: desktop wallpaper '…/MoOSUI2Arena',)' != '…/MoOSUI2Arena' — healing
        # and re-applied a scene that was already correct — a reconcile that can
        # never converge, forever, on a value that was never drifted.
        result="$(printf '%s\n' "$result" | grep -oE "WPV:[^'\"]*" | head -n1)"
        if [ -n "$result" ]; then
            printf '%s\n' "${result#WPV:}"
            return 0
        fi
    fi
    config="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
    [ -r "$config" ] || return 1
    awk -F= '
        /^\[Containments\]\[[^]]+\]\[Wallpaper\]\[org\.moos\.ui2\.wallpaper\]\[General\]$/ { hit = 1; next }
        /^\[/ { hit = 0 }
        hit && $1 == "Image" { print $2; exit }
    ' "$config"
}

# Which wallpaper package belongs to a MoOS look. Mirrors the main apply table;
# returns 1 for a non-MoOS look (never guess).
lnf_wallpaper_package() {
    local rest="${1#org.moos.ui2}" fam light=""
    rest="${rest#.}"
    case "$rest" in *.light) light="Light"; rest="${rest%.light}" ;; esac
    case "$rest" in
        "")        [ -n "$light" ] || { echo /usr/share/wallpapers/MoOSUI2Graphite; return 0; } ;;
        light)     echo /usr/share/wallpapers/MoOSUI2Tide; return 0 ;;
        nova)      fam=Nova ;;
        amethyst)  fam=Amethyst ;;
        midnight)  fam=Midnight ;;
        aurora)    fam=Aurora ;;
        daylight)  echo /usr/share/wallpapers/MoOSUI2Daylight; return 0 ;;
        gaming)    fam=Arena ;;
        dev)       fam=Forge ;;
        study)     fam=Scholar ;;
        *)         return 1 ;;
    esac
    [ -n "$fam" ] || return 1
    echo "/usr/share/wallpapers/MoOSUI2${fam}${light}"
}

# STEADY-STATE wallpaper reconcile — runs on EVERY login, even when the marker
# says this revision already applied. Plasma flushes its in-memory config on
# shutdown, and one lost race (or a second compositor for the same account) can
# quietly put ANOTHER MoOS package back on a themed desktop; seen live on the
# Cloud host, where a Scholar-Light session woke up wearing Graphite again after
# a reboot despite a green marker. The rule: a MoOSUI2 *package* that is not the
# active theme's package is drift and heals; anything else (a custom image file
# the user picked on purpose) is a durable choice and is never touched.
reconcile_wallpaper_drift() {
    local pkg current lock attempt
    pkg="$(lnf_wallpaper_package "$1")" || return 0
    # A Global Theme rebuild can recreate containments after kdeglobals is
    # written. Poll the live per-containment readback and repair only while the
    # scene is not ready; this converges on the actual shell state and avoids a
    # blind rewrite on every login.
    for attempt in 1 2 3 4 5; do
        if desktop_wallpapers_complete "$pkg"; then
            break
        fi
        current="$(current_desktop_wallpaper_value)" || current=""
        case "${current%/}" in
            /usr/share/wallpapers/MoOSUI2*|"")
                echo "wallpaper scene not ready (attempt ${attempt}/5): '${current:-unset}' != '${pkg}'" >>"$log" 2>/dev/null || true
                apply_desktop_scene "$pkg" || true
                ;;
        esac
        desktop_wallpapers_complete "$pkg" && break
        sleep 1
    done
    lock="$(current_lockscreen_wallpaper)" || lock=""
    case "${lock%/}" in
        "$pkg"|"") ;;
        /usr/share/wallpapers/MoOSUI2*)
            echo "steady-state: lock wallpaper '${lock}' != '${pkg}' — healing" >>"$log" 2>/dev/null || true
            command -v kwriteconfig6 >/dev/null 2>&1 && kwriteconfig6 --file kscreenlockerrc \
                --group Greeter --group Wallpaper --group org.kde.image --group General \
                --key Image "$pkg" 2>/dev/null || true
            ;;
    esac
    return 0
}

migration_completed=false
if [ -e "$marker" ]; then
    migration_completed=true
    lnf="$(current_lookandfeel)" || exit 0   # cannot tell → trust the marker, as before
    deco="$(current_decoration)" || exit 0
    if theme_intact "$lnf" "$deco"; then
        reconcile_wallpaper_drift "$lnf"
        exit 0
    fi
    echo "=== moos-apply-theme $(date -u '+%FT%TZ') === SELF-HEAL: look-and-feel='${lnf:-unset}' decoration='${deco:-unset}'" >>"$log" 2>/dev/null || true
    # A SELF-HEAL inside the same THEME_REV used to leave the tray marker in
    # place, which suppressed the one guarded plasmashell restart — so the
    # tray/dock writes landed in the file while the running shell kept drawing
    # the old model until logout (the exact Plasma 6.7 reloadConfig() failure
    # this script documents). A repair that the user cannot see is not a repair:
    # drop the bar marker too so this heal may restart the shell once, like a
    # fresh apply. (moos-tray-collapsed is the retired pre-split marker.)
    rm -f "${state_dir}/moos-bar-applied.v${THEME_REV}" 2>/dev/null || true
    rm -f "${state_dir}/moos-tray-collapsed.v${THEME_REV}" 2>/dev/null || true
else
    echo "=== moos-apply-theme $(date -u '+%FT%TZ') ===" >>"$log" 2>/dev/null || true
fi

mkdir -p "$state_dir" 2>/dev/null || true
rm -f "${state_dir}"/moos-theme-applied "${state_dir}"/moos-theme-applied.v* \
      "${state_dir}"/moos-ui2-theme-applied.v* 2>/dev/null || true
# Drop bar-apply markers from older revisions too, so a new THEME_REV restarts the
# shell once to rebuild the two-slab bar. Only the current v${THEME_REV} marker is
# kept below (and the retired tray marker is purged for good).
find "${state_dir}" -maxdepth 1 \( -name 'moos-bar-applied.v*' -o -name 'moos-tray-collapsed.v*' \) \
    ! -name "moos-bar-applied.v${THEME_REV}" -delete 2>/dev/null || true

# Autostart can fire before the Plasma shell / session D-Bus is ready. Wait for
# plasmashell so the apply tools actually take effect. Do NOT rely on `qdbus`:
# Qt6 renamed it (qdbus6/qdbus-qt6) and Plasma 6 no longer pulls the Qt5 one, so
# a plain `qdbus` probe can be permanently absent → the loop would burn the full
# 40 s on EVERY first login and lose the readiness guarantee. Prefer busctl
# (ships with systemd) / gdbus (ships with glib2), which are always present.
plasma_ready() {
    if command -v busctl >/dev/null 2>&1; then
        busctl --user call org.kde.plasmashell /PlasmaShell \
            org.freedesktop.DBus.Peer Ping >/dev/null 2>&1 && return 0
    fi
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 && return 0
    fi
    for q in qdbus6 qdbus-qt6 qdbus; do
        command -v "$q" >/dev/null 2>&1 \
            && "$q" org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0
    done
    return 1
}
for _ in $(seq 1 40); do plasma_ready && break; sleep 1; done

# Drop the rendered-SVG caches BEFORE applying. Plasma memoises every FrameSvg
# element it has ever rasterised, keyed by theme name — and on an OSTree system
# the shipped SVG's mtime does not move when the file's content changes across a
# `bootc upgrade`, so a stale cache can outlive the artwork it was baked from and
# the user keeps seeing the OLD dock. Same class of bug as the qmlcache freeze
# the launchers already work around. Cheap to rebuild, so just delete them.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
rm -rf "${cache_dir}/ksvg-elements" \
       "${cache_dir}"/plasma_theme_*.kcache \
       "${cache_dir}"/plasma-svgelements* \
       "${cache_dir}/icon-cache.kcache" 2>/dev/null || true

# The QML disk cache is the same trap, and it hides a WIDGET rather than a colour.
#
# OSTree pins every mtime under /usr to the epoch, and Qt's qmlcache is keyed on mtime — so
# a rebuilt plasmoid whose QML changed byte for byte still looks "unchanged" to the cache,
# and plasmashell keeps executing the compiled OLD widget after the upgrade. moos-ui-migrate
# purges these, but only once, behind a permanent marker: it will never run again on this
# machine, so it cannot carry a new widget in. This runs once per THEME_REV, which is exactly
# the cadence at which MoOS's own QML changes.
rm -rf "${cache_dir}/qmlcache" \
       "${cache_dir}/plasmashell/qmlcache" \
       "${cache_dir}/kwin/qmlcache" 2>/dev/null || true
find "${cache_dir}" -mindepth 2 -maxdepth 2 -type d -name qmlcache \
    -exec rm -rf -- {} + 2>/dev/null || true

# Home icon overrides are the SAME class of trap as ~/.config/kdedefaults: they
# outrank /usr in XDG_DATA_DIRS, and a live preview (or an earlier THEME_REV that
# planted a fallback) leaves them forever. THEME_REV 27 ships the redrawn
# first-party application marks baked per palette; if the home tree still holds
# the retired geometry — often still painted with Breeze's #3daee9 — the dock
# and launcher keep showing that while every image gate stays green. Drop only
# the MoOS-owned overlay trees and moos-* / moplayer names under hicolor; never
# touch third-party icon themes the user may have installed.
local_icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
if [ -d "$local_icons" ]; then
    find "$local_icons" -maxdepth 1 -type d \( \
            -name 'MoOSUI2' -o -name 'MoOSUI2Light' -o -name 'MoOSUI2*' \
        \) -exec rm -rf -- {} + 2>/dev/null || true
    find "$local_icons/hicolor" -type f \( \
            -name 'moos-*' -o -name 'moplayer.*' -o -name 'org.moos.*' \
        \) -delete 2>/dev/null || true
    # Empty size dirs left behind are harmless; the icon cache must not keep
    # pointing at files we just removed.
    rm -f "${local_icons}/hicolor/icon-theme.cache" \
          "${cache_dir}/icon-cache.kcache" 2>/dev/null || true
fi

# A home shadow of a FIRST-PARTY MoOS plasmoid is the same trap one directory
# over: ~/.local/share/plasma/plasmoids/org.moos.* outranks /usr in the package
# search path, so a live-preview copy keeps executing last month's launcher —
# tooltips, glyphs and all — while every image gate stays green. Only the
# MoOS-owned ids are dropped; third-party widgets the user installed stay put.
local_plasmoids="${XDG_DATA_HOME:-$HOME/.local/share}/plasma/plasmoids"
for moos_widget in org.moos.brand org.moos.heroclock org.moos.nova.clock; do
    rm -rf "${local_plasmoids:?}/${moos_widget}" 2>/dev/null || true
done

# ksycoca — the menu/launcher/service database — is the SAME mtime trap one level
# up: OSTree pins every /usr mtime to the epoch, so a .desktop that was renamed
# across a `bootc upgrade` (Discover -> "Mo Store" is exactly this) looks unchanged
# to ksycoca, and the menu keeps serving the old name and icon. A full,
# non-incremental rebuild ignores mtimes and reads the files, so this revision's
# .desktop and icon changes actually reach the user. Runs only on a real apply
# (this whole body does), so it is not a per-login cost.
command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental >>"$log" 2>&1 || true

# Revision 21 expands Baloo from the inherited media-folder profile to the
# user's whole visible HOME. Ask the already-running daemon to re-read the new
# /etc/xdg/baloofilerc; a fresh login would pick it up naturally, but an update
# must not require another logout before launcher file results become complete.
if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session --dest org.kde.baloo --object-path / \
        --method org.kde.baloo.main.updateConfig >>"$log" 2>&1 || true
fi
command -v balooctl6 >/dev/null 2>&1 && balooctl6 check >>"$log" 2>&1 || true

applied=0

# Repair the look the user is ACTUALLY on. Dark is only the default, not the
# verdict — see target_lnf().
want_lnf="$(target_lnf "$(current_lookandfeel)" "$migration_completed")"
case "$want_lnf" in
    "$LIGHT_LNF")
        want_scheme=MoOSUI2Light
        want_style=MoOSUI2Light
        want_deco="$LIGHT_DECO"
        want_icons=MoOSUI2Light
        want_konsole=MoOSUI2Light.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUI2Tide
        # The scene plugin resolves the master itself, but the migration gate
        # (verify_user_experience.py) greps this file for the exact wallpaper paths
        # as proof the dark/light masters are wired — keep them literal here.
        want_wallpaper=${want_wallpaper_package}/contents/images/3840x2160.jpg
        want_gtk_dark=false
        want_cursor=MoOSDark
        ;;
    "$DARK_LNF")
        want_scheme=MoOSUI2Dark
        want_style=MoOSUI2
        want_deco="$DARK_DECO"
        want_icons=MoOSUI2
        want_konsole=MoOSUI2.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUI2Graphite
        want_wallpaper=${want_wallpaper_package}/contents/images_dark/3840x2160.jpg
        want_gtk_dark=true
        want_cursor=MoOS
        ;;
    "$NOVA_LNF"|"$AMETHYST_LNF"|"$MIDNIGHT_LNF"|"$AURORA_LNF")
        # One branch, four looks: the assets follow the LNF suffix. All members
        # are dark-canvas, while their symbolic overlay carries this palette's
        # own ink/accent/status roles and inherits the broad dark vocabulary.
        want_fam="${want_lnf##*.}"; want_Fam="${want_fam^}"   # nova -> Nova
        want_scheme="MoOSUI2${want_Fam}"
        want_style="MoOSUI2${want_Fam}"
        want_deco="__aurorae__svg__MoOSUI2${want_Fam}"
        want_icons="$want_style"
        want_konsole="MoOSUI2${want_Fam}.profile"
        want_wallpaper_package="/usr/share/wallpapers/MoOSUI2${want_Fam}"
        want_wallpaper="${want_wallpaper_package}/contents/images_dark/3840x2160.jpg"
        want_gtk_dark=true
        want_cursor=MoOS
        ;;
    "$NOVA_LIGHT_LNF"|"$AMETHYST_LIGHT_LNF"|"$AURORA_LIGHT_LNF")
        # Light siblings of the accent families: light canvas, dark cursor and
        # their own palette-matched symbolic overlay on the broad light icons.
        want_fam="${want_lnf%.light}"; want_fam="${want_fam##*.}"; want_Fam="${want_fam^}Light"
        want_scheme="MoOSUI2${want_Fam}"
        want_style="MoOSUI2${want_Fam}"
        want_deco="__aurorae__svg__MoOSUI2${want_Fam}"
        want_icons="$want_style"
        want_konsole="MoOSUI2${want_Fam}.profile"
        want_wallpaper_package="/usr/share/wallpapers/MoOSUI2${want_Fam}"
        want_wallpaper="${want_wallpaper_package}/contents/images/3840x2160.jpg"
        want_gtk_dark=false
        want_cursor=MoOSDark
        ;;
    "$DAYLIGHT_LNF")
        # Midnight's light sibling is named "Daylight" (not MidnightLight).
        want_scheme=MoOSUI2Daylight
        want_style=MoOSUI2Daylight
        want_deco=__aurorae__svg__MoOSUI2Daylight
        want_icons="$want_style"
        want_konsole=MoOSUI2Daylight.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUI2Daylight
        want_wallpaper=${want_wallpaper_package}/contents/images/3840x2160.jpg
        want_gtk_dark=false
        want_cursor=MoOSDark
        ;;
    "$GAMING_LNF"|"$DEV_LNF"|"$STUDY_LNF")
        # Purpose-built dark editions: gaming->Arena, dev->Forge, study->Scholar.
        case "$want_lnf" in
            "$GAMING_LNF") want_Fam=Arena ;;
            "$DEV_LNF") want_Fam=Forge ;;
            *) want_Fam=Scholar ;;
        esac
        want_scheme="MoOSUI2${want_Fam}"
        want_style="MoOSUI2${want_Fam}"
        want_deco="__aurorae__svg__MoOSUI2${want_Fam}"
        want_icons="$want_style"
        want_konsole="MoOSUI2${want_Fam}.profile"
        want_wallpaper_package="/usr/share/wallpapers/MoOSUI2${want_Fam}"
        want_wallpaper="${want_wallpaper_package}/contents/images_dark/3840x2160.jpg"
        want_gtk_dark=true
        want_cursor=MoOS
        ;;
    "$GAMING_LIGHT_LNF"|"$DEV_LIGHT_LNF"|"$STUDY_LIGHT_LNF")
        case "$want_lnf" in
            "$GAMING_LIGHT_LNF") want_Fam=ArenaLight ;;
            "$DEV_LIGHT_LNF") want_Fam=ForgeLight ;;
            *) want_Fam=ScholarLight ;;
        esac
        want_scheme="MoOSUI2${want_Fam}"
        want_style="MoOSUI2${want_Fam}"
        want_deco="__aurorae__svg__MoOSUI2${want_Fam}"
        want_icons="$want_style"
        want_konsole="MoOSUI2${want_Fam}.profile"
        want_wallpaper_package="/usr/share/wallpapers/MoOSUI2${want_Fam}"
        want_wallpaper="${want_wallpaper_package}/contents/images/3840x2160.jpg"
        want_gtk_dark=false
        want_cursor=MoOSDark
        ;;
    *)
        echo "cannot resolve a MoOS theme target from '${want_lnf:-unset}'" >>"$log" 2>/dev/null || true
        exit 0
        ;;
esac
echo "repairing to ${want_lnf} (${want_scheme})" >>"$log" 2>/dev/null || true

# The whole Global Theme (colors, wallpaper, splash, cursor). Do NOT reset the
# panel layout — the MoOS dock is provided by the defaultPanel template.
if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    if plasma-apply-lookandfeel -a "$want_lnf" >>"$log" 2>&1; then
        applied=1
    fi
fi

# The desktop scene: our wallpaper plugin (image + dashboard bento, below the
# icons) on every desktop containment. plasma-apply-wallpaperimage is NOT used —
# it would flip the containments back onto org.kde.image and the bento would
# vanish. The LNF defaults deliberately carry no [Wallpaper] section for the
# same reason (see artwork/generate_moos_ui2.py).
if apply_desktop_scene "$want_wallpaper_package"; then
    applied=1
    echo "desktop scene applied: org.moos.ui2.wallpaper ← ${want_wallpaper_package}" >>"$log" 2>&1
else
    echo "desktop scene apply failed or shell not ready" >>"$log" 2>&1
fi
command -v plasma-apply-colorscheme >/dev/null 2>&1 && \
    plasma-apply-colorscheme "$want_scheme" >>"$log" 2>&1 || true

# The cursor, directly. plasma-apply-lookandfeel is SUPPOSED to carry the LNF's
# cursorTheme default, but LookAndFeelManager has historically skipped KCMs —
# the exact reason the colour scheme is re-applied above. moos-theme applies the
# cursor explicitly on every manual switch; the login repair used to rely on the
# LNF alone, so cursor drift (a white pointer on Tidal Light) survived every
# self-heal. Mirror moos-theme here.
if command -v plasma-apply-cursortheme >/dev/null 2>&1; then
    plasma-apply-cursortheme "$want_cursor" >>"$log" 2>&1 || true
fi
command -v kwriteconfig6 >/dev/null 2>&1 && \
    kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme "$want_cursor" 2>/dev/null || true

# Pin the values Plasma actually reads in the user's own configuration. Theme
# packages and /etc/xdg are defaults only; both lose to stale ~/.config and
# ~/.config/kdedefaults entries on an upgraded desktop.
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$want_lnf"
    kwriteconfig6 --file kdeglobals --group General --key ColorScheme "$want_scheme"
    kwriteconfig6 --file plasmarc --group Theme --key name "$want_style"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image
    # No greeter Theme key: the MoOS lock screen is a SHELL-package override that
    # every session draws; kscreenlocker does not read the look-and-feel here.
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group org.kde.image --group General --key Image "$want_wallpaper_package"
fi

# Konsole's colour scheme is NOT a KDE colour scheme and follows nothing. Without
# this, a Nova Light desktop keeps a black terminal.
command -v kwriteconfig6 >/dev/null 2>&1 && \
    kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile "$want_konsole"

# A terminal with no chrome — and the ONLY way to ship it.
#
# konsolerc kills the menu bar and the single-tab tab strip, but Konsole's two toolbars
# (mainToolBar, sessionToolbar) are not config keys at all: KMainWindow restores them from
# the Qt `State=` blob in ~/.local/state/konsolestaterc, and that state file is NOT part of
# the XDG config cascade, so /etc/xdg cannot reach it. Proven on this hardware: writing
# [MainWindow][Toolbar mainToolBar] Hidden=true into every candidate file leaves the toolbar
# on screen, while flipping the visibility byte inside the blob removes it.
#
# So seed the user's state file. In the blob each toolbar is a UTF-16BE name followed by a
# 1-byte visible flag; set it to 0. If the user has no blob yet, there is nothing to patch —
# Konsole writes one on first exit, and the next login catches it. Guarded by a one-shot
# marker: a user who turns the toolbar back on keeps it.
konsole_chrome_marker="${state_dir}/moos-konsole-chrome.v1"
if [ ! -e "$konsole_chrome_marker" ] && command -v python3 >/dev/null 2>&1; then
    if python3 - "${state_dir}/konsolestaterc" <<'PY' >>"$log" 2>&1
import base64, re, sys
path = sys.argv[1]
try:
    text = open(path).read()
except OSError:
    sys.exit("konsole chrome: no state file yet — will hide the toolbars next login")
m = re.search(r"^State=(.*)$", text, re.M)
if not m:
    sys.exit("konsole chrome: state file carries no State blob yet")
raw = bytearray(base64.b64decode(m.group(1)))
changed = False
for name in ("mainToolBar", "sessionToolbar"):
    i = raw.find(name.encode("utf-16-be"))
    if i < 0:
        continue
    flag = i + len(name) * 2          # the visible flag sits right after the name
    if flag < len(raw) and raw[flag] == 1:
        raw[flag] = 0
        changed = True
if changed:
    open(path, "w").write(re.sub(r"^State=.*$",
                                 "State=" + base64.b64encode(bytes(raw)).decode(),
                                 text, count=1, flags=re.M))
    print("konsole chrome: toolbars hidden")
else:
    print("konsole chrome: toolbars already hidden")
PY
    then
        touch "$konsole_chrome_marker" 2>/dev/null || true
        applied=1
    fi
fi

# --- The dock and the system tray: one call, one source of truth ---------------
# Everything structural about the bar is owned by moos-bar-apply, which reads
# /usr/share/moos/moos-bar.conf — the single source of truth. It MERGES every
# bottom panel into one glass capsule (launcher, tasks, separator, tray, clock),
# pins the tray's always-shown toggles (Wi-Fi, Bluetooth, volume, brightness,
# notifications and the keyboard/language indicator), applies the geometry,
# restarts the shell once per revision and reads the result back. Nothing in this
# script may restate a bar value; tests pin the two files together.
if command -v moos-bar-apply >/dev/null 2>&1; then
    moos-bar-apply apply "$THEME_REV" >>"$log" 2>&1 \
        || echo "moos-bar-apply reported an incomplete dock readback — will retry" >>"$log" 2>&1
else
    echo "moos-bar-apply missing — dock left as found" >>"$log" 2>&1
fi

# --- Motion sized to the machine ----------------------------------------------
# /etc/xdg/kwinrc ships ONE profile for every install — blur 15, magic lamp, the
# full set — tuned on a discrete-GPU desktop. The same profile reaches a cloud
# VPS drawing in software, where every blur pass behind every panel and menu is
# CPU work per frame, and KWin cannot tell the difference: its supported() check
# asks what the backend CAN do, not what this machine SHOULD do.
#
# moos-visual-tier reads the hardware (render node, GPU driver, cores, memory,
# panel size) and writes the profile that fits: flagship keeps the tuned full
# system, balanced trades magic lamp for squash and blur 15 for 9, essential
# turns blur and window animations off and keeps motion short. It writes only
# the keys it owns, records them, and stops touching any key the user has since
# changed — so this is a default, not a policy. `moos-visual-tier --set <tier>`
# pins it and turns detection off.
if command -v moos-visual-tier >/dev/null 2>&1; then
    moos-visual-tier --apply >>"$log" 2>&1 \
        || echo "moos-visual-tier could not size the motion profile" >>"$log" 2>&1
fi

# KSplash is user configuration, so a system default alone cannot override an
# already-created user's previous Breeze/Fedora choice.  Write the two exact
# Plasma 6 keys explicitly during this versioned migration.
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file ksplashrc --group KSplash --key Theme "$want_lnf"
    kwriteconfig6 --file ksplashrc --group KSplash --key Engine KSplashQML
fi

# The window decoration, for the same reason — and this one is worse than KSplash,
# because MoOS's system default could never have won on its own.
#
# XDG_CONFIG_DIRS is "~/.config/kdedefaults:/etc/xdg:…". LookAndFeelManager writes the
# applied Global Theme's defaults into kdedefaults/, which therefore OUTRANKS the
# /etc/xdg/kwinrc this image ships. A user created under Breeze got
# kdedefaults/kwinrc = org.kde.breeze on day one, and because Nova's own defaults file
# never declared a decoration, applying Nova did not overwrite it. MoOS's Aurorae
# decoration has been shadowed on every install since — Breeze's X / v / ^ glyphs on
# every window, with the /etc/xdg gate green the whole time.
#
# Nova's defaults now declares it (so a fresh apply writes kdedefaults correctly), but
# an existing user needs the value put somewhere that beats kdedefaults outright.
# ~/.config/kwinrc — the user's own config, XDG_CONFIG_HOME — does exactly that.
#
# ButtonsOnLeft mirrors /etc/xdg/kwinrc: X=Close I=Minimize A=Maximize.
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae.v2
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$want_deco"
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft XIA
    # The icon theme is not colour-scheme aware: Nova's symbolics are drawn light
    # for a dark panel and disappear on porcelain. The light look needs NovaLight.
    kwriteconfig6 --file kdeglobals --group Icons --key Theme "$want_icons"
    # A raw kdeglobals write is SILENT: running apps only drop their icon caches
    # when the icons KCM's helper broadcasts the KIconLoader change signal. Without
    # it the new family arrives at the next login, which reads as "didn't work".
    # plasma-changeicons writes the same key AND emits the signal.
    if [ -x /usr/libexec/plasma-changeicons ]; then
        /usr/libexec/plasma-changeicons "$want_icons" >>"$log" 2>&1 || true
    fi
    echo "pinned the ${want_deco} decoration and the ${want_icons} icons into the user's config" >>"$log" 2>/dev/null || true
    # KWin only re-reads kwinrc when told to. Without this the decoration changes on the
    # next login instead of now, which reads as "the fix did not work".
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.KWin -o /KWin -m org.kde.KWin.reconfigure \
            >>"$log" 2>&1 || echo "kwin reconfigure skipped" >>"$log" 2>&1
    fi

fi

# GTK apps — Firefox and every other non-Qt window on the system.
#
# Plasma's gtkconfig kded module already does the hard half of this correctly: on every
# theme change it regenerates ~/.config/gtk-3.0/colors.css from the ACTIVE KDE colour
# scheme, so those 84 colours are Nova's navy, and it syncs the Nova icon and MoOS
# cursor into the GTK settings. What it never sets is gtk-theme-name, which on this system
# is the empty string.
#
# Empty means GTK falls back to its built-in Adwaita — and Adwaita has never heard of the
# variables in colors.css. They are named borders_breeze, content_view_bg_breeze, …
# because they exist for the Breeze GTK theme, whose stylesheet references them 965 times.
# So the bridge that carries Nova's colours into GTK has been running, correctly, into a
# theme that ignores every one of them. Naming the theme is the entire fix: Breeze's GTK
# stylesheet is KDE's (which MoOS keeps, like the widget style), and it is what the
# generated Nova palette is written for. Geometry from Breeze, colour from Nova — exactly
# the deal the Nova Plasma style already makes.
#
# The sound theme has to be written here too: the module syncs icons and cursors from
# kdeglobals but NOT [Sounds], so GTK keeps freedesktop while Plasma plays moos.
#
# Verified to survive: gtkconfig rewrites these files on every theme change and preserves
# both keys — it only ever fills in the ones it owns.
# settings.ini is the WEAKEST of the three places GTK looks, and writing only it changes
# nothing. Probed live on this hardware, with settings.ini already saying Breeze:
#
#   GDK_BACKEND=wayland → gtk-theme-name = 'Adwaita'   (from GSettings)
#   GDK_BACKEND=x11     → gtk-theme-name = ''          (from xsettingsd, which is running)
#
# Wayland apps read GSettings; X11/XWayland apps read the XSETTINGS daemon; settings.ini is
# only the fallback when neither answers. gtkconfig keeps all three in sync and fills in
# what it owns — Net/IconThemeName "Nova", Gtk/CursorThemeName "MoOS", the Plex font —
# and leaves exactly the two keys below unset. So all three have to be written, or the
# desktop keeps rendering GTK apps in Adwaita grey while insisting the theme is Breeze.
pin_gtk() {
    local ini
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        for ini in "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"; do
            [ -f "$ini" ] || continue
            kwriteconfig6 --file "$ini" --group Settings --key gtk-theme-name Breeze
            kwriteconfig6 --file "$ini" --group Settings --key gtk-sound-theme-name moos
            # gtkconfig regenerates the GTK palette from the active KDE scheme but
            # never touches this key — so on a Nova Light desktop Firefox stayed
            # dark, because nothing had told GTK the desktop was light.
            kwriteconfig6 --file "$ini" --group Settings \
                --key gtk-application-prefer-dark-theme "$want_gtk_dark"
        done
    fi

    # GTK2 is not KConfig — plain `key="value"` lines, no group header.
    local rc="$HOME/.gtkrc-2.0"
    if [ -f "$rc" ]; then
        sed -i -e 's/^gtk-theme-name=.*/gtk-theme-name="Breeze"/' \
               -e 's/^gtk-sound-theme-name=.*/gtk-sound-theme-name="moos"/' "$rc" 2>/dev/null || true
        grep -q '^gtk-theme-name=' "$rc" 2>/dev/null || echo 'gtk-theme-name="Breeze"' >>"$rc"
        grep -q '^gtk-sound-theme-name=' "$rc" 2>/dev/null || echo 'gtk-sound-theme-name="moos"' >>"$rc"
    fi

    # Wayland GTK apps. Takes effect immediately — GSettings notifies live.
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface gtk-theme Breeze 2>/dev/null || true
        gsettings set org.gnome.desktop.sound theme-name moos 2>/dev/null || true
        # The freedesktop "which side of the day are we on" setting. GTK4/libadwaita
        # apps read ONLY this; they ignore gtk-theme-name entirely.
        gsettings set org.gnome.desktop.interface color-scheme \
            "$([ "$want_gtk_dark" = true ] && echo prefer-dark || echo prefer-light)" 2>/dev/null || true
        # Icon / cursor / font identity for GTK+libadwaita+Flatpak, pushed
        # DETERMINISTICALLY here instead of leaning on the race-prone kde-gtk-config
        # kded module (which this script's own comments document as failing under
        # the Flatpak sandbox). Values mirror kdeglobals + each L&F defaults exactly.
        gsettings set org.gnome.desktop.interface icon-theme \
            "$([ "$want_gtk_dark" = true ] && echo MoOSUI2 || echo MoOSUI2Light)" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-theme \
            "$([ "$want_gtk_dark" = true ] && echo MoOS || echo MoOSDark)" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name 'IBM Plex Sans 10' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 10' 2>/dev/null || true
    fi

    # X11 / XWayland GTK apps. xsettingsd re-reads its config on SIGHUP and pushes the new
    # values to every running client, so this does not wait for a re-login either.
    local xs="${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
    if [ -f "$xs" ]; then
        sed -i -e 's|^Net/ThemeName .*|Net/ThemeName "Breeze"|' \
               -e 's|^Net/SoundThemeName .*|Net/SoundThemeName "moos"|' "$xs" 2>/dev/null || true
        grep -q '^Net/ThemeName ' "$xs" 2>/dev/null || echo 'Net/ThemeName "Breeze"' >>"$xs"
        grep -q '^Net/SoundThemeName ' "$xs" 2>/dev/null || echo 'Net/SoundThemeName "moos"' >>"$xs"
        pkill -HUP -x xsettingsd 2>/dev/null || true
    fi

    echo "pinned the GTK theme (Breeze stylesheet, Nova palette) and sound theme in all three sources" >>"$log" 2>/dev/null || true
}
pin_gtk

# --- The sensor daemon the monitors cannot live without ------------------------
# Every system-monitor widget in Plasma reads from ksystemstats, and on this image
# it was simply NOT RUNNING. The widget does not say so: its face fails to build
# (Plasmoid.faceController.fullRepresentation is null) and it draws an empty grey
# rectangle. A monitor showing nothing looks exactly like a monitor reading zero.
#
# Started explicitly, before the widgets are placed, rather than trusted to come up
# on demand — it did not.
systemctl --user start plasma-ksystemstats.service >>"$log" 2>&1 || true

# --- The desktop itself -------------------------------------------------------
# The dashboard bento is NOT a desktop widget anymore. Three shipped fixes
# (x=80 -> 260 -> 360, icons right-aligned, live-ISO skip) each only moved its
# collision with the Folder View icons, because a Plasma desktop applet always
# draws ON TOP of the icon grid. The bento now lives INSIDE the wallpaper
# (org.moos.ui2.wallpaper renders image + dashboard as one layer BELOW icons),
# so there is nothing to place, nothing to collide, and the live ISO gets its
# dashboard back — the "Install MoOS" icon simply draws over wallpaper.
#
# apply_desktop_scene() above already did the whole job for this run: it set
# every desktop containment's wallpaper plugin + image, removed any stale
# org.moos.ui2.dashboard / org.moos.nova.deskclock applets left behind by
# earlier revisions, and right-aligned the icons (alignment=1, sortMode=1).


# --- The system tray -----------------------------------------------------------
# Pinned by moos-bar-apply above from moos-bar.conf: the everyday toggles
# (Wi-Fi, Bluetooth, volume, brightness, notifications and the keyboard/language
# indicator) live in the corner system capsule, always one click away.
# --- Photos and video ---------------------------------------------------------
# MoOS now ships gwenview and haruna and declares them in /etc/xdg/mimeapps.list.
# That is only half the fix: ~/.config/mimeapps.list OUTRANKS /etc/xdg, and Plasma
# WRITES that file the first time anyone picks "Open With". A user who ever opened
# a photo in Chrome — which every MoOS user did, because the image had no viewer at
# all — has Chrome recorded there, and the system default will never reach them.
#
# So pin it in the user's own config. Only for the types a browser has hijacked,
# only when the viewer is actually installed, and never overwriting a choice that
# is already a real image viewer — if the user prefers something else, that is
# theirs to keep.
pin_default_apps() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    local mimeapps="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
    local mime current

    if [ -f /usr/share/applications/org.kde.gwenview.desktop ]; then
        for mime in image/png image/jpeg image/gif image/webp image/tiff image/bmp \
                    image/avif image/heif image/jxl; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.kde.gwenview.desktop
                    ;;
            esac
        done
        echo "pinned gwenview as the image viewer in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    if [ -f /usr/share/applications/org.kde.haruna.desktop ]; then
        for mime in video/mp4 video/x-matroska video/webm video/quicktime video/mpeg; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.kde.haruna.desktop
                    ;;
            esac
        done
    fi

    # --- IPTV playlists open in MoPlayer -------------------------------------
    # Shipping the default in /etc/xdg is not the same as the user getting it: a
    # user's own ~/.config/mimeapps.list outranks the system one, and Plasma writes
    # to that file the first time anyone touches "Open With" on anything. On an
    # existing MoOS install, an .m3u therefore still opens in haruna — which plays
    # it as a *file*, one stream at a time, with no categories, no guide and no
    # favourites, which is not what the user asked for by double-clicking it.
    #
    # Only claim the type when it is unset or currently pointing at something that
    # is a dead end for a playlist. A user who has deliberately chosen VLC keeps VLC.
    if [ -f /usr/share/applications/org.moos.moplayer.desktop ]; then
        for mime in application/x-mpegurl application/vnd.apple.mpegurl audio/x-mpegurl; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*haruna*|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.moplayer.desktop
                    ;;
            esac
        done
        echo "pinned MoPlayer as the IPTV playlist handler in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    # --- Windows .exe and Android .apk open in the MoOS runner --------------------
    # The runner is what turns "MoOS supports Windows apps" into "the .exe you just
    # downloaded runs when you double-click it": it forwards to Bottles/Waydroid when they
    # are there, and offers the one-time setup when they are not (moos-run-foreign).
    #
    # Pin it for existing users too, because the two defaults they already have are both
    # dead ends: a raw Bottles association fails silently before Bottles is installed, and
    # Waydroid's own .apk handler runs `waydroid app install` with no window at all — on a
    # machine where Android was never initialised, that double-click does nothing.
    # Never overrule a real third-party choice: only claim the type when it is unset or
    # still points at one of those two.
    if [ -f /usr/share/applications/org.moos.runforeign.desktop ]; then
        for mime in application/x-msdownload application/x-ms-dos-executable \
                    application/vnd.microsoft.portable-executable application/x-msi \
                    application/vnd.android.package-archive; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*bottles*|*waydroid*|*runforeign*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.runforeign.desktop
                    ;;
            esac
        done
        echo "pinned the MoOS app runner for .exe/.msi/.apk in the user's mimeapps.list" >>"$log" 2>/dev/null || true

        # --- Office documents open (or offer to install) an office suite ------
        # Same half-fix problem, and a worse starting point: these types had NO
        # default at all on the shipped image — measured, all seven of .docx,
        # .xlsx, .pptx, .doc, .xls, .odt and .rtf returned nothing from
        # `xdg-mime query default`. So a Word file did nothing when double-clicked.
        #
        # Only claim a type that is unset or already pointing at the runner. Anyone
        # who has actually installed LibreOffice, OnlyOffice or WPS has made a real
        # choice and keeps it — the runner would only get in their way.
        for mime in application/msword \
                    application/vnd.openxmlformats-officedocument.wordprocessingml.document \
                    application/vnd.oasis.opendocument.text application/rtf \
                    application/vnd.ms-excel \
                    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet \
                    application/vnd.oasis.opendocument.spreadsheet \
                    application/vnd.ms-powerpoint \
                    application/vnd.openxmlformats-officedocument.presentationml.presentation \
                    application/vnd.oasis.opendocument.presentation; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*runforeign*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.runforeign.desktop
                    ;;
            esac
        done
        # A CSV is text and kate is already installed: opening it must not cost a
        # 700 MB download. Claim it only if nothing else has.
        current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key text/csv 2>/dev/null)"
        [ -z "$current" ] && [ -f /usr/share/applications/org.kde.kate.desktop ] && \
            kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                --key text/csv org.kde.kate.desktop
        echo "pinned office document handling in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "${XDG_DATA_HOME:-$HOME/.local/share}/applications" 2>/dev/null || true
    return 0
}
pin_default_apps

# --- Retire the hand-installed Kawkab Mono ------------------------------------
# The Arabic terminal font was first proven on this machine by dropping the TTFs
# into ~/.local/share/fonts with a matching ~/.config/fontconfig override, because
# the fix had to be visible before the image could carry it. The image carries it
# now (/usr/share/fonts/kawkab-mono + /etc/fonts/conf.d/61-moos-brand.conf), and a
# user-level copy of a font policy is precisely the kind of shadow that outranks
# the image and freezes it at whatever it said the day it was written.
#
# So: once the system font is present, remove the stand-in. Narrowly scoped to the
# exact files that were staged — nothing else under the user's fonts is touched.
if [ -f /usr/share/fonts/kawkab-mono/KawkabMono-Regular.ttf ]; then
    stale_conf="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/99-moos-kawkab-test.conf"
    if [ -f "$stale_conf" ]; then
        rm -f "$stale_conf"
        rm -f "${XDG_DATA_HOME:-$HOME/.local/share}"/fonts/KawkabMono-*.ttf
        command -v fc-cache >/dev/null 2>&1 && fc-cache -f >/dev/null 2>&1
        echo "removed the user-level Kawkab Mono stand-in; the image ships it now" >>"$log" 2>/dev/null || true
    fi
fi

# --- Retire user-level copies of MoOS's own theme assets ------------------------
# Same trap, several directories. Anything under ~/.local/share SHADOWS the copy in
# /usr, so a MoOS asset staged there freezes at whatever it said the day it was
# written and no later image can fix it. Every one of these paths is MoOS-owned by
# name; nothing that belongs to the user is touched.
#
# They exist because a fix has to be PROVEN on the running desktop before the image
# can carry it (AGENTS.md: read it back from the running system). Staging is the
# right way to prove it. Leaving the stage up afterwards is how the image loses.
user_share="${XDG_DATA_HOME:-$HOME/.local/share}"

# RETIRED MoOS assets are removed from the user share UNCONDITIONALLY — the
# image no longer carries them, so the [-e /usr/share/…] guard below would
# never fire, and a stale user-level copy of a package the OS retired would
# haunt the widget explorer forever. Every name here is MoOS-owned.
for rel in \
    "plasma/plasmoids/org.moos.nova.deskclock" \
    "plasma/plasmoids/org.moos.ui2.dashboard" \
; do
    if [ -e "${user_share}/$rel" ]; then
        rm -rf "${user_share:?}/$rel"
        echo "removed the user-level copy of retired $rel" >>"$log" 2>/dev/null || true
    fi
done

