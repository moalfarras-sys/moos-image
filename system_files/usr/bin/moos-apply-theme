#!/usr/bin/env bash
# moos-apply-theme — apply the full MoOS UI2 Global Theme once per user.
#
# WHY: /etc/xdg/kdeglobals sets [KDE] LookAndFeelPackage=org.moos.ui2, but
# Plasma 6 only AUTO-applies a subset of a default Global Theme (color scheme,
# icons) on a fresh login — it does NOT apply the wallpaper, splash, or the
# rest of the "look". So a freshly-created INSTALLED user lands on a half-Breeze
# desktop that does not look like MoOS. This runs once on first login and
# explicitly applies the whole thing (colors + wallpaper + splash).
#
# Separate marker from moos-firstrun on purpose: a system that was already
# installed (and whose user already saw moos-firstrun) still gets the theme
# applied on the first login AFTER a `bootc upgrade` that ships this file.
set -uo pipefail

# Versioned marker: bump THEME_REV whenever the MoOS UI assets change so a later
# `bootc upgrade` re-applies the new look exactly once for EXISTING users (a
# fixed marker would skip every revision after the first). Old markers are
# cleaned up so they don't accumulate.
THEME_REV=16
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir" 2>/dev/null || true
marker="${state_dir}/moos-ui2-theme-applied.v${THEME_REV}"

# Plasma can launch the same autostart entry twice while session restore is
# settling. Two migrations removing/recreating the same applet are not
# idempotent while they overlap, so only one instance may own this revision.
if command -v flock >/dev/null 2>&1; then
    lock_dir="${XDG_RUNTIME_DIR:-$state_dir}"
    mkdir -p "$lock_dir" 2>/dev/null || true
    if exec 9>"${lock_dir}/moos-theme.lock"; then
        flock -n 9 || exit 0
    fi
fi

# MoOS now ships TWO looks, and they are equally legitimate. Everything below that
# asks "is the desktop still MoOS?" must accept either — a user who chose Light and
# gets dragged back to Dark on every login has not been protected, they have been
# overruled.
DARK_LNF="org.moos.ui2"
LIGHT_LNF="org.moos.ui2.light"
DARK_DECO="__aurorae__svg__MoOSUI2"
LIGHT_DECO="__aurorae__svg__MoOSUI2Light"

# UI1 remains installed as an explicit rollback. It counts as intact after the
# UI2 migration marker exists, so `moos-theme ui1-dark|ui1-light` is a durable
# user choice rather than something the login repair immediately overwrites.
UI1_DARK_LNF="org.moos.ui"
UI1_LIGHT_LNF="org.moos.ui.light"
UI1_DARK_DECO="__aurorae__svg__MoOSUI"
UI1_LIGHT_DECO="__aurorae__svg__MoOSUILight"

log="${XDG_CACHE_HOME:-$HOME/.cache}/moos-apply-theme.log"
mkdir -p "$(dirname "$log")" 2>/dev/null || true

# What the desktop is ACTUALLY wearing right now. Empty (or no kreadconfig6) means
# "cannot tell" — say so, and let the caller fall back to trusting the marker rather
# than re-applying the theme on every single login.
current_lookandfeel() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null
}

# The decoration is checked separately because it can be wrong on its own: it lives in a
# different file, and ~/.config/kdedefaults/kwinrc can hold Breeze's while the Global
# Theme still reads org.moos.nova. A "Nova" desktop wearing Breeze title bars is exactly
# the state every install shipped in, and it must count as drift.
current_decoration() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme 2>/dev/null
}

current_scheme() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null
}

current_style() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null
}

current_icons() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null
}

desktop_wallpapers_complete() {
    local expected="$1" result desktops matching config
    if command -v gdbus >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        result="$(timeout 4s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var expected = "'"$expected"'";
                var ds = desktops();
                var matching = 0;
                for (var i = 0; i < ds.length; i++) {
                    ds[i].currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
                    var image = String(ds[i].readConfig("Image", ""));
                    if (image.indexOf(expected) >= 0) { matching++; }
                }
                print("desktops=" + ds.length + ";matching=" + matching);
            ' 2>/dev/null)" || result=""
        result="$(printf '%s\n' "$result" \
            | grep -oE 'desktops=[1-9][0-9]*;matching=[0-9]+' | head -n1)"
        if [ -n "$result" ]; then
            desktops="${result#desktops=}"
            desktops="${desktops%%;*}"
            matching="${result##*matching=}"
            [ "$desktops" = "$matching" ]
            return
        fi
    fi

    config="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
    [ -r "$config" ] || return 1
    awk -v expected="$expected" '
        /^\[Containments\]\[[^]]+\]\[Wallpaper\]\[org\.kde\.image\]\[General\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            split(section, parts, "\\]\\[")
            containment = parts[1]
            mode = "wallpaper"
            next
        }
        /^\[Containments\]\[[^]]+\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            sub(/\]$/, "", section)
            containment = section
            mode = "containment"
            next
        }
        /^\[/ { mode = ""; next }
        mode == "containment" && /^plugin=/ {
            rootPlugin[containment] = substr($0, 8)
            next
        }
        mode == "wallpaper" && /^Image=/ {
            image[containment] = substr($0, 7)
            next
        }
        END {
            desktops = 0
            matching = 0
            for (id in rootPlugin) {
                if (rootPlugin[id] == "org.kde.panel") { continue }
                desktops++
                if (index(image[id], expected) > 0) { matching++ }
            }
            exit !(desktops > 0 && matching == desktops)
        }
    ' "$config" 2>/dev/null
}

current_lockscreen_wallpaper() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group org.kde.image --group General --key Image 2>/dev/null
}

# Prefer the running containments, then fall back to Plasma's persisted source
# of truth when autostart arrives before the shell's scripting endpoint. The
# invariant is PER CONTAINMENT: every desktop owns exactly one card of the
# selected generation and none of the other. A global `ui2=1` is wrong as soon
# as a second monitor or Activity adds another legitimate desktop containment.
current_widget_state() {
    local result config
    if command -v gdbus >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        result="$(timeout 4s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var ds = desktops();
                var ui1Each = ds.length > 0;
                var ui2Each = ds.length > 0;
                for (var i = 0; i < ds.length; i++) {
                    var ui1 = 0, ui2 = 0;
                    var ws = ds[i].widgets();
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == "org.moos.nova.deskclock") { ui1++; }
                        if (ws[j].type == "org.moos.ui2.dashboard") { ui2++; }
                    }
                    if (!(ui1 == 1 && ui2 == 0)) { ui1Each = false; }
                    if (!(ui1 == 0 && ui2 == 1)) { ui2Each = false; }
                }
                var state = ui1Each ? "ui1-each" : (ui2Each ? "ui2-each" : "mixed");
                print("desktops=" + ds.length + ";state=" + state);
            ' 2>/dev/null)" || result=""
        # A responsive shell can still answer before it has created any desktop
        # containments. Never accept that transient empty result as real state;
        # let the persisted parser below decide instead.
        result="$(printf '%s\n' "$result" \
            | grep -oE 'desktops=[1-9][0-9]*;state=(ui1-each|ui2-each|mixed)' \
            | head -n1)"
        if [ -n "$result" ]; then
            printf '%s\n' "${result##*state=}"
            return 0
        fi
    fi

    config="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
    [ -r "$config" ] || return 1
    # Parse only direct applets of top-level desktop containments. Nested tray
    # applets and panels also carry plugin= keys and must not enter this count.
    # The parser intentionally returns failure when no persisted desktop exists:
    # "zero desktops" is startup uncertainty, never a valid completed theme.
    awk '
        /^\[Containments\]\[[^]]+\]\[Applets\]\[[^]]+\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            split(section, parts, "\\]\\[")
            containment = parts[1]
            mode = "applet"
            next
        }
        /^\[Containments\]\[[^]]+\]$/ {
            section = $0
            sub(/^\[Containments\]\[/, "", section)
            sub(/\]$/, "", section)
            containment = section
            mode = "containment"
            next
        }
        /^\[/ { mode = ""; next }
        mode == "containment" && /^plugin=/ {
            plugin = substr($0, 8)
            rootPlugin[containment] = plugin
            next
        }
        mode == "applet" && /^plugin=org\.moos\.nova\.deskclock$/ {
            ui1[containment]++
            next
        }
        mode == "applet" && /^plugin=org\.moos\.ui2\.dashboard$/ {
            ui2[containment]++
            next
        }
        END {
            desktops = 0
            ui1Each = 1
            ui2Each = 1
            for (id in rootPlugin) {
                if (rootPlugin[id] == "org.kde.panel") { continue }
                desktops++
                if (!((ui1[id] + 0) == 1 && (ui2[id] + 0) == 0)) { ui1Each = 0 }
                if (!((ui1[id] + 0) == 0 && (ui2[id] + 0) == 1)) { ui2Each = 0 }
            }
            if (desktops == 0) { exit 2 }
            if (ui1Each) { print "ui1-each" }
            else if (ui2Each) { print "ui2-each" }
            else { print "mixed" }
        }
    ' "$config" 2>/dev/null
}

# The marker means "this revision was applied once". It does NOT mean the desktop still
# LOOKS like MoOS, and those two came apart the moment Plasma started rewriting
# LookAndFeelPackage behind our back (see defuse_automatic_lookandfeel below). An
# apply-once marker on a desktop that has silently reverted to Breeze is precisely the
# thing that keeps it Breeze: the repair exists, and its own marker disables it.
#
# So the marker is honoured only while the look is intact. If it is not, this run repairs
# it however many times it has run before — that is the whole point.
# Which MoOS look is the user wearing, if any? "Intact" means the look-and-feel is
# one of ours AND the decoration is the one that belongs to it. A Nova Light
# desktop wearing the dark decoration is drift just as much as a Breeze one is.
theme_intact() {
    local lnf="$1" deco="$2" scheme style icons widgets
    local expected_deco expected_scheme expected_style expected_icons expected_widgets
    scheme="$(current_scheme)" || return 1
    style="$(current_style)" || return 1
    icons="$(current_icons)" || return 1
    widgets="$(current_widget_state)" || return 1

    case "$lnf" in
        "$DARK_LNF")
            expected_deco="$DARK_DECO"; expected_scheme=MoOSUI2Dark
            expected_style=MoOSUI2; expected_icons=MoOSUI2
            expected_widgets=ui2-each
            ;;
        "$LIGHT_LNF")
            expected_deco="$LIGHT_DECO"; expected_scheme=MoOSUI2Light
            expected_style=MoOSUI2Light; expected_icons=MoOSUI2Light
            expected_widgets=ui2-each
            ;;
        "$UI1_DARK_LNF")
            expected_deco="$UI1_DARK_DECO"; expected_scheme=MoOSUIDark
            expected_style=MoOSUI; expected_icons=Nova
            expected_widgets=ui1-each
            ;;
        "$UI1_LIGHT_LNF")
            expected_deco="$UI1_LIGHT_DECO"; expected_scheme=MoOSUILight
            expected_style=MoOSUILight; expected_icons=NovaLight
            expected_widgets=ui1-each
            ;;
        *) return 1 ;;
    esac

    [ "$deco" = "$expected_deco" ] \
        && [ "$scheme" = "$expected_scheme" ] \
        && [ "$style" = "$expected_style" ] \
        && [ "$icons" = "$expected_icons" ] \
        && [ "$widgets" = "$expected_widgets" ]
}

# Completion is stricter than steady-state integrity: a user may deliberately
# replace their wallpaper later, but the first revision apply may only mark
# itself done after both desktop and lock-screen received the requested package.
theme_complete() {
    local lnf="$1" deco="$2" wallpaper_package="$3" lockscreen
    theme_intact "$lnf" "$deco" || return 1
    desktop_wallpapers_complete "$wallpaper_package" || return 1
    lockscreen="$(current_lockscreen_wallpaper)" || return 1
    case "$lockscreen" in *"$wallpaper_package"*) ;; *) return 1 ;; esac
}

# Which one should a repair restore? Whichever the user last chose. Only when the
# desktop has drifted to something that is not MoOS at all do we impose the
# default. Re-applying Dark to someone who deliberately picked Light would make
# this script the bug it exists to fix.
target_lnf() {
    local current completed
    if [ "$#" -ge 1 ]; then
        current="$1"
    else
        current="$(current_lookandfeel)"
    fi
    if [ "$#" -ge 2 ]; then
        completed="$2"
    elif [ -e "$marker" ]; then
        completed=true
    else
        completed=false
    fi

    case "$current" in
        "$LIGHT_LNF") echo "$LIGHT_LNF" ;;
        "$DARK_LNF") echo "$DARK_LNF" ;;
        # Before revision 16 has completed, UI1 is the source that must migrate
        # into the corresponding UI2 half. After the marker exists, however,
        # UI1 can only be an explicit rollback choice. A later repair (for
        # example, a new Activity without its dashboard) must repair that same
        # rollback family instead of silently dragging the user back to UI2.
        "$UI1_LIGHT_LNF")
            [ "$completed" = true ] && echo "$UI1_LIGHT_LNF" || echo "$LIGHT_LNF"
            ;;
        "$UI1_DARK_LNF")
            [ "$completed" = true ] && echo "$UI1_DARK_LNF" || echo "$DARK_LNF"
            ;;
        *) echo "$DARK_LNF" ;;
    esac
}

migration_completed=false
if [ -e "$marker" ]; then
    migration_completed=true
    lnf="$(current_lookandfeel)" || exit 0   # cannot tell → trust the marker, as before
    deco="$(current_decoration)" || exit 0
    if theme_intact "$lnf" "$deco"; then
        exit 0
    fi
    echo "=== moos-apply-theme $(date -u '+%FT%TZ') === SELF-HEAL: look-and-feel='${lnf:-unset}' decoration='${deco:-unset}'" >>"$log" 2>/dev/null || true
else
    echo "=== moos-apply-theme $(date -u '+%FT%TZ') ===" >>"$log" 2>/dev/null || true
fi

mkdir -p "$state_dir" 2>/dev/null || true
rm -f "${state_dir}"/moos-nova-theme-applied "${state_dir}"/moos-nova-theme-applied.v* \
      "${state_dir}"/moos-ui2-theme-applied.v* 2>/dev/null || true
# Drop tray-collapse markers from older revisions too, so a new THEME_REV restarts the
# shell once to re-collapse the tray. Only the current v${THEME_REV} marker is kept below.
find "${state_dir}" -maxdepth 1 -name 'moos-tray-collapsed.v*' ! -name "moos-tray-collapsed.v${THEME_REV}" -delete 2>/dev/null || true

# Disarm Plasma's day/night Look-and-Feel switch BEFORE applying anything — otherwise it
# is free to undo this run's work at the next sunrise.
#
# The switch keeps its two targets in [KDE] Default{Light,Dark}LookAndFeel and resolves
# them BY NAME when it fires. If the named package is not installed, Plasma does not fall
# back to the configured LookAndFeelPackage — it falls back to BREEZE, and it persists
# that choice into the user's kdeglobals, which outranks /etc/xdg for good.
#
# This is not hypothetical, it is the bug this revision exists for. Users created under
# Fedora's kde-settings carried AutomaticLookAndFeel=true with
# DefaultLightLookAndFeel=org.fedoraproject.fedora.desktop. MoOS then removed Fedora's
# look-and-feel packages (a machine called MoOS should not offer another distribution's
# themes). The system default still said org.moos.nova and the image still shipped it —
# but on the first boot after that upgrade the switch resolved a package that no longer
# existed, and the desktop came up Breeze Dark.
#
# MoOS ships exactly ONE Look and Feel, so there is no second theme of ours to switch to:
# any target here can only ever be somebody else's. Drop the targets, turn the switch off.
# MoOS used to have exactly one theme, so there was no safe target to give the
# switch and the only correct move was to disarm it. That is no longer true: MoOS
# now ships a matched light/dark pair, so the switch gets POINTED AT THEM instead
# of being deleted. Whichever way it fires, it lands on MoOS.
#
# The danger it poses is unchanged, and it is why this still runs before anything
# else applies: any target that is not an installed package sends Plasma to Breeze
# — not to the configured LookAndFeelPackage — and it persists that choice into the
# user's kdeglobals, which outranks /etc/xdg for good.
#
# AutomaticLookAndFeel itself is left exactly as the user set it. Arming it is the
# user's call (`moos-theme auto`); all this guarantees is that if it IS armed, it
# cannot reach a non-MoOS theme.
pin_lookandfeel_switch_targets() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 0
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0

    local want key val
    for key in DefaultLightLookAndFeel DefaultDarkLookAndFeel; do
        if [ "$key" = "DefaultLightLookAndFeel" ]; then want="$LIGHT_LNF"; else want="$DARK_LNF"; fi

        # Never point the switch at a package that is not on disk — that is the
        # exact failure that put every MoOS desktop into Breeze Dark.
        if [ ! -d "/usr/share/plasma/look-and-feel/$want" ]; then
            val="$(kreadconfig6 --file kdeglobals --group KDE --key "$key" 2>/dev/null)"
            [ -n "$val" ] && kwriteconfig6 --file kdeglobals --group KDE --key "$key" --delete 2>/dev/null \
                && echo "dropped ${key}=${val}: ${want} is not installed" >>"$log" 2>/dev/null
            continue
        fi

        val="$(kreadconfig6 --file kdeglobals --group KDE --key "$key" 2>/dev/null)"
        [ "$val" = "$want" ] && continue
        kwriteconfig6 --file kdeglobals --group KDE --key "$key" "$want" 2>/dev/null \
            && echo "pinned ${key}=${want} (was '${val:-unset}')" >>"$log" 2>/dev/null
    done
    return 0
}
pin_lookandfeel_switch_targets

# Autostart can fire before the Plasma shell / session D-Bus is ready. Wait for
# plasmashell so the apply tools actually take effect. Do NOT rely on `qdbus`:
# Qt6 renamed it (qdbus6/qdbus-qt6) and Plasma 6 no longer pulls the Qt5 one, so
# a plain `qdbus` probe can be permanently absent → the loop would burn the full
# 40 s on EVERY first login and lose the readiness guarantee. Prefer busctl
# (ships with systemd) / gdbus (ships with glib2), which are always present.
plasma_ready() {
    if command -v busctl >/dev/null 2>&1; then
        busctl --user call org.kde.plasmashell /PlasmaShell \
            org.freedesktop.DBus.Peer Ping >/dev/null 2>&1 && return 0
    fi
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 && return 0
    fi
    for q in qdbus6 qdbus-qt6 qdbus; do
        command -v "$q" >/dev/null 2>&1 \
            && "$q" org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0
    done
    return 1
}
for _ in $(seq 1 40); do plasma_ready && break; sleep 1; done

# Drop the rendered-SVG caches BEFORE applying. Plasma memoises every FrameSvg
# element it has ever rasterised, keyed by theme name — and on an OSTree system
# the shipped SVG's mtime does not move when the file's content changes across a
# `bootc upgrade`, so a stale cache can outlive the artwork it was baked from and
# the user keeps seeing the OLD dock. Same class of bug as the qmlcache freeze
# the launchers already work around. Cheap to rebuild, so just delete them.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
rm -rf "${cache_dir}/ksvg-elements" \
       "${cache_dir}"/plasma_theme_*.kcache \
       "${cache_dir}"/plasma-svgelements* \
       "${cache_dir}/icon-cache.kcache" 2>/dev/null || true

# The QML disk cache is the same trap, and it hides a WIDGET rather than a colour.
#
# OSTree pins every mtime under /usr to the epoch, and Qt's qmlcache is keyed on mtime — so
# a rebuilt plasmoid whose QML changed byte for byte still looks "unchanged" to the cache,
# and plasmashell keeps executing the compiled OLD widget after the upgrade. moos-ui-migrate
# purges these, but only once, behind a permanent marker: it will never run again on this
# machine, so it cannot carry a new widget in. This runs once per THEME_REV, which is exactly
# the cadence at which MoOS's own QML changes.
rm -rf "${cache_dir}/qmlcache" \
       "${cache_dir}/plasmashell/qmlcache" \
       "${cache_dir}/kwin/qmlcache" 2>/dev/null || true
find "${cache_dir}" -mindepth 2 -maxdepth 2 -type d -name qmlcache \
    -exec rm -rf -- {} + 2>/dev/null || true

applied=0

# Repair the look the user is ACTUALLY on. Dark is only the default, not the
# verdict — see target_lnf().
want_lnf="$(target_lnf "$(current_lookandfeel)" "$migration_completed")"
case "$want_lnf" in
    "$LIGHT_LNF")
        want_scheme=MoOSUI2Light
        want_style=MoOSUI2Light
        want_deco="$LIGHT_DECO"
        want_icons=MoOSUI2Light
        want_konsole=MoOSUI2Light.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUI2Tide
        want_wallpaper=${want_wallpaper_package}/contents/images/3840x2160.jpg
        want_gtk_dark=false
        want_widget=org.moos.ui2.dashboard
        other_widget=org.moos.nova.deskclock
        widget_width=560
        widget_height=220
        ;;
    "$DARK_LNF")
        want_scheme=MoOSUI2Dark
        want_style=MoOSUI2
        want_deco="$DARK_DECO"
        want_icons=MoOSUI2
        want_konsole=MoOSUI2.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUI2Graphite
        want_wallpaper=${want_wallpaper_package}/contents/images_dark/3840x2160.jpg
        want_gtk_dark=true
        want_widget=org.moos.ui2.dashboard
        other_widget=org.moos.nova.deskclock
        widget_width=560
        widget_height=220
        ;;
    "$UI1_LIGHT_LNF")
        want_scheme=MoOSUILight
        want_style=MoOSUILight
        want_deco="$UI1_LIGHT_DECO"
        want_icons=NovaLight
        want_konsole=MoOSUILight.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUIAtmosphere
        want_wallpaper=${want_wallpaper_package}/contents/images/3840x2160.png
        want_gtk_dark=false
        want_widget=org.moos.nova.deskclock
        other_widget=org.moos.ui2.dashboard
        widget_width=430
        widget_height=400
        ;;
    "$UI1_DARK_LNF")
        want_scheme=MoOSUIDark
        want_style=MoOSUI
        want_deco="$UI1_DARK_DECO"
        want_icons=Nova
        want_konsole=MoOSUI.profile
        want_wallpaper_package=/usr/share/wallpapers/MoOSUIAtmosphere
        want_wallpaper=${want_wallpaper_package}/contents/images_dark/3840x2160.png
        want_gtk_dark=true
        want_widget=org.moos.nova.deskclock
        other_widget=org.moos.ui2.dashboard
        widget_width=430
        widget_height=400
        ;;
    *)
        echo "cannot resolve a MoOS theme target from '${want_lnf:-unset}'" >>"$log" 2>/dev/null || true
        exit 0
        ;;
esac
echo "repairing to ${want_lnf} (${want_scheme})" >>"$log" 2>/dev/null || true

# The whole Global Theme (colors, wallpaper, splash, cursor). Do NOT reset the
# panel layout — the MoOS dock is provided by the defaultPanel template.
if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    if plasma-apply-lookandfeel -a "$want_lnf" >>"$log" 2>&1; then
        applied=1
    fi
fi

# Belt-and-suspenders: force the wallpaper + colour scheme directly, in case the
# L&F apply skips them (Plasma has historically been inconsistent here).
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    [ -f "$want_wallpaper" ] \
        && { plasma-apply-wallpaperimage "$want_wallpaper" >>"$log" 2>&1 && applied=1; }
fi
command -v plasma-apply-colorscheme >/dev/null 2>&1 && \
    plasma-apply-colorscheme "$want_scheme" >>"$log" 2>&1 || true

# Pin the values Plasma actually reads in the user's own configuration. Theme
# packages and /etc/xdg are defaults only; both lose to stale ~/.config and
# ~/.config/kdedefaults entries on an upgraded desktop.
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$want_lnf"
    kwriteconfig6 --file kdeglobals --group General --key ColorScheme "$want_scheme"
    kwriteconfig6 --file plasmarc --group Theme --key name "$want_style"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image
    # No greeter Theme key: the MoOS lock screen is a SHELL-package override that
    # every session draws; kscreenlocker does not read the look-and-feel here.
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group org.kde.image --group General --key Image "$want_wallpaper_package"
fi

# Konsole's colour scheme is NOT a KDE colour scheme and follows nothing. Without
# this, a Nova Light desktop keeps a black terminal.
command -v kwriteconfig6 >/dev/null 2>&1 && \
    kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile "$want_konsole"

# A terminal with no chrome — and the ONLY way to ship it.
#
# konsolerc kills the menu bar and the single-tab tab strip, but Konsole's two toolbars
# (mainToolBar, sessionToolbar) are not config keys at all: KMainWindow restores them from
# the Qt `State=` blob in ~/.local/state/konsolestaterc, and that state file is NOT part of
# the XDG config cascade, so /etc/xdg cannot reach it. Proven on this hardware: writing
# [MainWindow][Toolbar mainToolBar] Hidden=true into every candidate file leaves the toolbar
# on screen, while flipping the visibility byte inside the blob removes it.
#
# So seed the user's state file. In the blob each toolbar is a UTF-16BE name followed by a
# 1-byte visible flag; set it to 0. If the user has no blob yet, there is nothing to patch —
# Konsole writes one on first exit, and the next login catches it. Guarded by a one-shot
# marker: a user who turns the toolbar back on keeps it.
konsole_chrome_marker="${state_dir}/moos-konsole-chrome.v1"
if [ ! -e "$konsole_chrome_marker" ] && command -v python3 >/dev/null 2>&1; then
    if python3 - "${state_dir}/konsolestaterc" <<'PY' >>"$log" 2>&1
import base64, re, sys
path = sys.argv[1]
try:
    text = open(path).read()
except OSError:
    sys.exit("konsole chrome: no state file yet — will hide the toolbars next login")
m = re.search(r"^State=(.*)$", text, re.M)
if not m:
    sys.exit("konsole chrome: state file carries no State blob yet")
raw = bytearray(base64.b64decode(m.group(1)))
changed = False
for name in ("mainToolBar", "sessionToolbar"):
    i = raw.find(name.encode("utf-16-be"))
    if i < 0:
        continue
    flag = i + len(name) * 2          # the visible flag sits right after the name
    if flag < len(raw) and raw[flag] == 1:
        raw[flag] = 0
        changed = True
if changed:
    open(path, "w").write(re.sub(r"^State=.*$",
                                 "State=" + base64.b64encode(bytes(raw)).decode(),
                                 text, count=1, flags=re.M))
    print("konsole chrome: toolbars hidden")
else:
    print("konsole chrome: toolbars already hidden")
PY
    then
        touch "$konsole_chrome_marker" 2>/dev/null || true
        applied=1
    fi
fi

# Float the dock for users who already exist.
#
# plasma/layout-templates/.../layout.js only ever runs when Plasma builds a
# desktop for a user that has no panel yet, so on an upgrade the existing user
# keeps the edge-to-edge dock the old template gave them. `floating` is a real
# property on Plasma 6's scripting Panel object (probed live on this hardware:
# `"floating" in panels()[0]` -> true), and setting it is what lifts the dock off
# the screen edge so the Nova glass reads as a floating slab.
#
# Guarded on every side: only touches BOTTOM panels, never creates or removes
# one, and a failure here is logged and ignored — a dock that is merely flush is
# a cosmetic regression, whereas a script that throws mid-layout can leave the
# session with no panel at all, which is a broken desktop.
#
# The same pass also applies the two dock-polish decisions the layout template
# makes for NEW users, so an upgraded user and a fresh user end up with the same
# dock: the clock puts its date beside the time instead of stacking it into two
# cramped lines, and the show-desktop applet (which renders as an empty bordered
# box at the end of the dock) is dropped.
#
# NOTE: escaping. gdbus unescapes its argument, so a literal \n inside the script
# string becomes a real newline and truncates the JS string it sits in. Keep this
# script free of backslash escapes.
if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var ps = panels();
            for (var i = 0; i < ps.length; i++) {
                var p = ps[i];
                if (p.location != "bottom") { continue; }
                try { if ("floating" in p) { p.floating = true; } } catch (e) {}
                try { if ("lengthMode" in p) { p.lengthMode = "fit"; } } catch (e) {}
                try { if ("alignment" in p) { p.alignment = "center"; } } catch (e) {}
                try { p.height = 44; } catch (e) {}
                var ws = p.widgets();
                for (var j = 0; j < ws.length; j++) {
                    var w = ws[j];
                    try {
                        if (w.type == "org.kde.plasma.kickoff") {
                            w.currentConfigGroup = ["General"];
                            w.writeConfig("icon", "/usr/share/moos/moos-logo.png");
                            w.writeConfig("appNameFormat", 0);
                            w.writeConfig("favoritesDisplay", 0);
                            w.writeConfig("applicationsDisplay", 1);
                            w.writeConfig("primaryActions", 3);
                            w.writeConfig("showActionButtonCaptions", true);
                            w.writeConfig("switchCategoryOnHover", true);
                            w.reloadConfig();
                        } else if (w.type == "org.kde.plasma.digitalclock") {
                            var clockIndex = w.index;
                            w.remove();
                            var novaClock = p.addWidget("org.moos.nova.clock");
                            try { novaClock.index = clockIndex; } catch (e) {}
                        } else if (w.type == "org.kde.plasma.showdesktop") {
                            w.remove();
                        }
                    } catch (e) {}
                }
            }
        ' >>"$log" 2>&1 || echo "panel polish migration skipped" >>"$log" 2>&1
fi

# --- The dock: MoOS's own apps are actually IN it ------------------------------
# THE BUG. layout.js pins Mo AI, MoPlayer and Mo PC Remote, and it is correct — but a
# layout template only ever runs for a user who has NO panel yet. Every existing user
# keeps the dock they were given the day their account was made, so the two apps MoOS
# added since then simply never arrived. Verified on the maintainer's own desktop on
# 2026-07-13, months of green gates later: his dock held moai, browser, dolphin,
# systemsettings, konsole — no MoPlayer, no Mo PC Remote. He owns an operating system
# whose flagship app is not in its own dock. (MoPlayer *looked* present in a screenshot
# only because it happened to be running; a task is not a launcher.) This is the
# shadowed-config family again: ship it right, and the user still does not get it.
#
# THE RULE THIS FOLLOWS. Add, never remove. A dock is the user's, not ours — so a MoOS
# app that is missing gets put back, and everything else is left exactly as found:
#   - an entry the user pinned themselves is kept, in their order, at the end;
#   - a NON-MoOS default they deliberately unpinned (dolphin, konsole) stays unpinned —
#     re-adding it would be us overruling a choice, and it would come back every upgrade;
#   - a MoOS app is re-added at its shipped position, so an upgraded dock and a fresh
#     one read the same left to right.
# The one thing MoOS insists on is that its own apps are reachable. If the user unpins
# MoPlayer, this puts it back once per THEME_REV — the honest cost of the guarantee, and
# the alternative is the desktop we actually shipped.
#
# Only pin a .desktop that EXISTS: icontasks silently skips a launcher URL it cannot
# resolve, so a stale entry does not fail loudly, it leaves an unexplained hole.
dock_shipped=""
for entry in \
    "applications:org.moos.moai.desktop" \
    "preferred://browser" \
    "applications:org.moos.moplayer.desktop" \
    "applications:org.kde.dolphin.desktop" \
    "applications:org.moos.remote.desktop" \
    "applications:systemsettings.desktop" \
    "applications:org.kde.konsole.desktop" \
; do
    case "$entry" in
        applications:*)
            desktop_id="${entry#applications:}"
            [ -e "/usr/share/applications/${desktop_id}" ] \
                || [ -e "${XDG_DATA_HOME:-$HOME/.local/share}/applications/${desktop_id}" ] \
                || continue
            ;;
    esac
    dock_shipped="${dock_shipped}${dock_shipped:+, }\"${entry}\""
done

# The shipped list is the only part that varies, so splice it in by concatenating quoted
# strings rather than switching the JS to a double-quoted heredoc: inside double quotes every
# JS string would need a backslash, and gdbus UNESCAPES its argument — a stray backslash
# escape does not error, it silently truncates the script at the first one.
if command -v gdbus >/dev/null 2>&1 && [ -n "$dock_shipped" ]; then
    gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var SHIPPED = ['"$dock_shipped"'];
            var isMoOS = function (u) { return u.indexOf("applications:org.moos.") === 0; };
            var ps = panels();
            for (var i = 0; i < ps.length; i++) {
                var ws = ps[i].widgets();
                for (var j = 0; j < ws.length; j++) {
                    if (ws[j].type != "org.kde.plasma.icontasks") { continue; }
                    try {
                        ws[j].currentConfigGroup = ["General"];
                        var cur = String(ws[j].readConfig("launchers", ""))
                                      .split(",").filter(function (s) { return s.length > 0; });
                        var out = [];
                        var push = function (u) { if (out.indexOf(u) < 0) { out.push(u); } };
                        for (var k = 0; k < SHIPPED.length; k++) {
                            var u = SHIPPED[k];
                            if (isMoOS(u) || cur.indexOf(u) >= 0) { push(u); }
                        }
                        for (var m = 0; m < cur.length; m++) { push(cur[m]); }
                        if (out.join(",") != cur.join(",")) {
                            ws[j].writeConfig("launchers", out.join(","));
                            ws[j].reloadConfig();
                        }
                    } catch (e) {}
                }
            }
        ' >>"$log" 2>&1 && dock_applied=1 || echo "dock launcher migration skipped" >>"$log" 2>&1
fi
# Like the tray below, the write lands in the file but the running icontasks keeps drawing
# its old model; the plasmashell restart at the end of this script is what makes it visible.

# KSplash is user configuration, so a system default alone cannot override an
# already-created user's previous Breeze/Fedora choice.  Write the two exact
# Plasma 6 keys explicitly during this versioned migration.
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file ksplashrc --group KSplash --key Theme "$want_lnf"
    kwriteconfig6 --file ksplashrc --group KSplash --key Engine KSplashQML
fi

# The window decoration, for the same reason — and this one is worse than KSplash,
# because MoOS's system default could never have won on its own.
#
# XDG_CONFIG_DIRS is "~/.config/kdedefaults:/etc/xdg:…". LookAndFeelManager writes the
# applied Global Theme's defaults into kdedefaults/, which therefore OUTRANKS the
# /etc/xdg/kwinrc this image ships. A user created under Breeze got
# kdedefaults/kwinrc = org.kde.breeze on day one, and because Nova's own defaults file
# never declared a decoration, applying Nova did not overwrite it. MoOS's Aurorae
# decoration has been shadowed on every install since — Breeze's X / v / ^ glyphs on
# every window, with the /etc/xdg gate green the whole time.
#
# Nova's defaults now declares it (so a fresh apply writes kdedefaults correctly), but
# an existing user needs the value put somewhere that beats kdedefaults outright.
# ~/.config/kwinrc — the user's own config, XDG_CONFIG_HOME — does exactly that.
#
# ButtonsOnLeft mirrors /etc/xdg/kwinrc: X=Close I=Minimize A=Maximize.
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$want_deco"
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft XIA
    # The icon theme is not colour-scheme aware: Nova's symbolics are drawn light
    # for a dark panel and disappear on porcelain. The light look needs NovaLight.
    kwriteconfig6 --file kdeglobals --group Icons --key Theme "$want_icons"
    echo "pinned the ${want_deco} decoration and the ${want_icons} icons into the user's config" >>"$log" 2>/dev/null || true
    # KWin only re-reads kwinrc when told to. Without this the decoration changes on the
    # next login instead of now, which reads as "the fix did not work".
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.KWin -o /KWin -m org.kde.KWin.reconfigure \
            >>"$log" 2>&1 || echo "kwin reconfigure skipped" >>"$log" 2>&1
    fi

    # The event sounds, third instance of the same trap. [Sounds] is NOT in the entry set
    # LookAndFeelManager applies, so it writes nothing to kdedefaults — and the user's own
    # kdeglobals, carrying Theme=freedesktop from the Breeze/Fedora defaults they were
    # created under, outranks both the Nova theme's declaration and /etc/xdg/kdeglobals.
    # The MoOS sound theme has shipped since day one and has never once played.
    kwriteconfig6 --file kdeglobals --group Sounds --key Theme moos-nova
    kwriteconfig6 --file kdeglobals --group Sounds --key Enable true
fi

# GTK apps — Firefox and every other non-Qt window on the system.
#
# Plasma's gtkconfig kded module already does the hard half of this correctly: on every
# theme change it regenerates ~/.config/gtk-3.0/colors.css from the ACTIVE KDE colour
# scheme, so those 84 colours are Nova's navy, and it syncs the Nova icon and NovaIce
# cursor into the GTK settings. What it never sets is gtk-theme-name, which on this system
# is the empty string.
#
# Empty means GTK falls back to its built-in Adwaita — and Adwaita has never heard of the
# variables in colors.css. They are named borders_breeze, content_view_bg_breeze, …
# because they exist for the Breeze GTK theme, whose stylesheet references them 965 times.
# So the bridge that carries Nova's colours into GTK has been running, correctly, into a
# theme that ignores every one of them. Naming the theme is the entire fix: Breeze's GTK
# stylesheet is KDE's (which MoOS keeps, like the widget style), and it is what the
# generated Nova palette is written for. Geometry from Breeze, colour from Nova — exactly
# the deal the Nova Plasma style already makes.
#
# The sound theme has to be written here too: the module syncs icons and cursors from
# kdeglobals but NOT [Sounds], so GTK keeps freedesktop while Plasma plays moos-nova.
#
# Verified to survive: gtkconfig rewrites these files on every theme change and preserves
# both keys — it only ever fills in the ones it owns.
# settings.ini is the WEAKEST of the three places GTK looks, and writing only it changes
# nothing. Probed live on this hardware, with settings.ini already saying Breeze:
#
#   GDK_BACKEND=wayland → gtk-theme-name = 'Adwaita'   (from GSettings)
#   GDK_BACKEND=x11     → gtk-theme-name = ''          (from xsettingsd, which is running)
#
# Wayland apps read GSettings; X11/XWayland apps read the XSETTINGS daemon; settings.ini is
# only the fallback when neither answers. gtkconfig keeps all three in sync and fills in
# what it owns — Net/IconThemeName "Nova", Gtk/CursorThemeName "NovaIce", the Plex font —
# and leaves exactly the two keys below unset. So all three have to be written, or the
# desktop keeps rendering GTK apps in Adwaita grey while insisting the theme is Breeze.
pin_gtk() {
    local ini
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        for ini in "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"; do
            [ -f "$ini" ] || continue
            kwriteconfig6 --file "$ini" --group Settings --key gtk-theme-name Breeze
            kwriteconfig6 --file "$ini" --group Settings --key gtk-sound-theme-name moos-nova
            # gtkconfig regenerates the GTK palette from the active KDE scheme but
            # never touches this key — so on a Nova Light desktop Firefox stayed
            # dark, because nothing had told GTK the desktop was light.
            kwriteconfig6 --file "$ini" --group Settings \
                --key gtk-application-prefer-dark-theme "$want_gtk_dark"
        done
    fi

    # GTK2 is not KConfig — plain `key="value"` lines, no group header.
    local rc="$HOME/.gtkrc-2.0"
    if [ -f "$rc" ]; then
        sed -i -e 's/^gtk-theme-name=.*/gtk-theme-name="Breeze"/' \
               -e 's/^gtk-sound-theme-name=.*/gtk-sound-theme-name="moos-nova"/' "$rc" 2>/dev/null || true
        grep -q '^gtk-theme-name=' "$rc" 2>/dev/null || echo 'gtk-theme-name="Breeze"' >>"$rc"
        grep -q '^gtk-sound-theme-name=' "$rc" 2>/dev/null || echo 'gtk-sound-theme-name="moos-nova"' >>"$rc"
    fi

    # Wayland GTK apps. Takes effect immediately — GSettings notifies live.
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface gtk-theme Breeze 2>/dev/null || true
        gsettings set org.gnome.desktop.sound theme-name moos-nova 2>/dev/null || true
        # The freedesktop "which side of the day are we on" setting. GTK4/libadwaita
        # apps read ONLY this; they ignore gtk-theme-name entirely.
        gsettings set org.gnome.desktop.interface color-scheme \
            "$([ "$want_gtk_dark" = true ] && echo prefer-dark || echo prefer-light)" 2>/dev/null || true
    fi

    # X11 / XWayland GTK apps. xsettingsd re-reads its config on SIGHUP and pushes the new
    # values to every running client, so this does not wait for a re-login either.
    local xs="${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
    if [ -f "$xs" ]; then
        sed -i -e 's|^Net/ThemeName .*|Net/ThemeName "Breeze"|' \
               -e 's|^Net/SoundThemeName .*|Net/SoundThemeName "moos-nova"|' "$xs" 2>/dev/null || true
        grep -q '^Net/ThemeName ' "$xs" 2>/dev/null || echo 'Net/ThemeName "Breeze"' >>"$xs"
        grep -q '^Net/SoundThemeName ' "$xs" 2>/dev/null || echo 'Net/SoundThemeName "moos-nova"' >>"$xs"
        pkill -HUP -x xsettingsd 2>/dev/null || true
    fi

    echo "pinned the GTK theme (Breeze stylesheet, Nova palette) and sound theme in all three sources" >>"$log" 2>/dev/null || true
}
pin_gtk

# --- The sensor daemon the monitors cannot live without ------------------------
# Every system-monitor widget in Plasma reads from ksystemstats, and on this image
# it was simply NOT RUNNING. The widget does not say so: its face fails to build
# (Plasmoid.faceController.fullRepresentation is null) and it draws an empty grey
# rectangle. A monitor showing nothing looks exactly like a monitor reading zero.
#
# Started explicitly, before the widgets are placed, rather than trusted to come up
# on demand — it did not.
systemctl --user start plasma-ksystemstats.service >>"$log" 2>&1 || true

# --- The desktop itself -------------------------------------------------------
# MoOS shipped a desktop with nothing on it: no clock, no widgets, nothing. The
# panel clock is a PANEL applet — its full representation is a calendar popup — so
# it cannot double as the desktop dashboard. UI2's dashboard is the desktop one.
#
# ONE widget, carrying the clock AND the three system rings. It was two, briefly,
# and Plasma would not have it: a desktop applet's position lives in a
# resolution-keyed ItemGeometries string on the CONTAINMENT, not on the applet, and
# the x/y/w/h passed to addWidget() is transient. After the first shell restart the
# monitor was auto-placed at 0,0 on top of the folder icons while the clock stayed
# put. Two widgets that must sit together cannot be two widgets.
#
# org.kde.plasma.systemmonitor is deliberately NOT used: UI2's single passive
# bento owns the clock, 3D weather and system health without taking desktop input.
# The destination is parameterised because a completed UI2 migration may later
# be repaired while the user is deliberately wearing UI1. Both directions keep
# the same add-first safety invariant and exactly one card per containment.
#
# Guarded and idempotent inside this revision: the target is added first and the
# other generation is removed only after a second scan proves it instantiated.
# A Folder View containment will NOT place a scripted widget for you — pass an
# explicit rectangle, or the applet exists with zero geometry and never paints.
if command -v gdbus >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    widget_migration_result="$(timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var TARGET = "'"$want_widget"'";
            var OTHER = "'"$other_widget"'";
            var TARGET_WIDTH = '"$widget_width"';
            var TARGET_HEIGHT = '"$widget_height"';
            var migratedOther = false;
            var deduplicated = false;
            var incomplete = false;
            var ds = desktops();
            for (var i = 0; i < ds.length; i++) {
                var d = ds[i];
                var ws = d.widgets();
                var others = [];
                var targets = [];
                for (var j = 0; j < ws.length; j++) {
                    if (ws[j].type == TARGET) { targets.push(ws[j]); }
                    if (ws[j].type == OTHER) { others.push(ws[j]); }
                }
                try {
                    if (targets.length == 0) {
                        d.addWidget(TARGET, 80, 70, TARGET_WIDTH, TARGET_HEIGHT);
                        var after = d.widgets();
                        for (var n = 0; n < after.length; n++) {
                            if (after[n].type == TARGET) {
                                targets.push(after[n]);
                            }
                        }
                    }
                    if (targets.length > 0) {
                        // Keep the first valid target and remove every
                        // duplicate in this containment. This also repairs a
                        // same-family duplicate state; it does not depend on
                        // the other generation being present.
                        for (var n = 1; n < targets.length; n++) {
                            targets[n].remove();
                            deduplicated = true;
                        }
                        for (var k = 0; k < others.length; k++) { others[k].remove(); }
                        if (others.length > 0) { migratedOther = true; }
                    } else { incomplete = true; }
                } catch (e) { incomplete = true; }
            }
            print(migratedOther ? "widget-family-migrated" :
                (incomplete ? "widget-incomplete" :
                (deduplicated ? "widget-deduplicated" : "widget-ready")));
        ' 2>>"$log")" || widget_migration_result=""
    echo "desktop widget migration: ${widget_migration_result:-skipped}" >>"$log" 2>&1

    # Folder View collision-avoids a new widget while the other one still owns
    # its preferred top-left rectangle. Once the safe add-then-remove pass above
    # has proven the target loads, recreate only that freshly migrated card after
    # the old geometry has left the layout. The two short waits let Plasma commit
    # each removal; doing both operations in one evaluateScript leaves a phantom
    # collision and snaps the new bento to 0,0.
    if [[ "$widget_migration_result" == *widget-family-migrated* ]]; then
        sleep 2
        timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var TARGET = "'"$want_widget"'";
                var OTHER = "'"$other_widget"'";
                var ds = desktops();
                for (var i = 0; i < ds.length; i++) {
                    var ws = ds[i].widgets();
                    var otherPresent = false;
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == OTHER) { otherPresent = true; }
                    }
                    if (otherPresent) { continue; }
                    for (var k = 0; k < ws.length; k++) {
                        if (ws[k].type == TARGET) { ws[k].remove(); }
                    }
                }
            ' >>"$log" 2>&1 || true
        sleep 2
        timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var TARGET = "'"$want_widget"'";
                var OTHER = "'"$other_widget"'";
                var TARGET_WIDTH = '"$widget_width"';
                var TARGET_HEIGHT = '"$widget_height"';
                var ds = desktops();
                for (var i = 0; i < ds.length; i++) {
                    var ws = ds[i].widgets();
                    var blocked = false;
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == OTHER || ws[j].type == TARGET) {
                            blocked = true;
                        }
                    }
                    if (!blocked) {
                        ds[i].addWidget(TARGET, 80, 70, TARGET_WIDTH, TARGET_HEIGHT);
                    }
                }
            ' >>"$log" 2>&1 || true
    fi
fi

# --- The system tray: two icons, not sixteen -----------------------------------
# The tray was a wall of indicators — notifications, disc burner, printer, vault,
# camera, clipboard, KDE Connect, the Xwayland video bridge, the portal's
# remote-control icon — all of them permanently out, none of them ever looked at.
# MoOS shows TWO: the keyboard layout and the volume. Everything else lives behind
# the collapse arrow, one click away.
#
# StatusNotifierItems are matched on their OWN Id, not on a plasmoid id, which is
# why the portal and the video bridge survived the first attempt: they are not
# plasmoids. Their Id is also the app's *translated* name on some builds
# ("Xwayland-Video-Brücke" on this German session), so the variants are all listed.
#
# The portal's item is the "your screen is being controlled remotely" indicator.
# Collapsing it is not the same as removing it — it is one click away, and it still
# lights up. But it IS a security indicator, so it is called out here rather than
# quietly folded in with the printer.
if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var HIDE = [
                "org.kde.kdeconnect", "org.kde.plasma.vault", "org.kde.kscreen",
                "org.kde.plasma.battery", "org.kde.plasma.bluetooth",
                "org.kde.plasma.brightness", "org.kde.plasma.cameraindicator",
                "org.kde.plasma.clipboard", "org.kde.plasma.devicenotifier",
                "org.kde.plasma.keyboardindicator", "org.kde.plasma.manage-inputmethod",
                "org.kde.plasma.mediacontroller", "org.kde.plasma.networkmanagement",
                "org.kde.plasma.notifications", "org.kde.plasma.printmanager",
                "org.kde.plasma.weather",
                "xdg-desktop-portal-kde", "xwaylandvideobridge",
                "Xwayland Video Bridge", "Xwayland-Video-Bruecke"
            ];
            var SHOW = ["org.kde.plasma.keyboardlayout", "org.kde.plasma.volume"];
            var ps = panels();
            for (var i = 0; i < ps.length; i++) {
                var ws = ps[i].widgets();
                for (var j = 0; j < ws.length; j++) {
                    if (ws[j].type != "org.kde.plasma.systemtray") { continue; }
                    try {
                        ws[j].currentConfigGroup = ["General"];
                        ws[j].writeConfig("shownItems", SHOW.join(","));
                        ws[j].writeConfig("hiddenItems", HIDE.join(","));
                        ws[j].reloadConfig();
                    } catch (e) {}
                }
            }
        ' >>"$log" 2>&1 && tray_applied=1 || echo "system tray migration skipped" >>"$log" 2>&1
fi
# reloadConfig() above writes the FILE but does NOT rebuild the systray's shown/hidden
# model in Plasma 6.7 — proven on 6.7.2: the file said "2 shown" while the tray kept
# drawing 8 across reboots. The shell only re-reads it on a full restart, which happens
# near the end of this script (once per THEME_REV, never on a steady-state login).

# --- Photos and video ---------------------------------------------------------
# MoOS now ships gwenview and haruna and declares them in /etc/xdg/mimeapps.list.
# That is only half the fix: ~/.config/mimeapps.list OUTRANKS /etc/xdg, and Plasma
# WRITES that file the first time anyone picks "Open With". A user who ever opened
# a photo in Chrome — which every MoOS user did, because the image had no viewer at
# all — has Chrome recorded there, and the system default will never reach them.
#
# So pin it in the user's own config. Only for the types a browser has hijacked,
# only when the viewer is actually installed, and never overwriting a choice that
# is already a real image viewer — if the user prefers something else, that is
# theirs to keep.
pin_default_apps() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    local mimeapps="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
    local mime current

    if [ -f /usr/share/applications/org.kde.gwenview.desktop ]; then
        for mime in image/png image/jpeg image/gif image/webp image/tiff image/bmp \
                    image/avif image/heif image/jxl; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.kde.gwenview.desktop
                    ;;
            esac
        done
        echo "pinned gwenview as the image viewer in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    if [ -f /usr/share/applications/org.kde.haruna.desktop ]; then
        for mime in video/mp4 video/x-matroska video/webm video/quicktime video/mpeg; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.kde.haruna.desktop
                    ;;
            esac
        done
    fi

    # --- IPTV playlists open in MoPlayer -------------------------------------
    # Shipping the default in /etc/xdg is not the same as the user getting it: a
    # user's own ~/.config/mimeapps.list outranks the system one, and Plasma writes
    # to that file the first time anyone touches "Open With" on anything. On an
    # existing MoOS install, an .m3u therefore still opens in haruna — which plays
    # it as a *file*, one stream at a time, with no categories, no guide and no
    # favourites, which is not what the user asked for by double-clicking it.
    #
    # Only claim the type when it is unset or currently pointing at something that
    # is a dead end for a playlist. A user who has deliberately chosen VLC keeps VLC.
    if [ -f /usr/share/applications/org.moos.moplayer.desktop ]; then
        for mime in application/x-mpegurl application/vnd.apple.mpegurl audio/x-mpegurl; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*haruna*|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.moplayer.desktop
                    ;;
            esac
        done
        echo "pinned MoPlayer as the IPTV playlist handler in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    # --- Windows .exe and Android .apk open in the MoOS runner --------------------
    # The runner is what turns "MoOS supports Windows apps" into "the .exe you just
    # downloaded runs when you double-click it": it forwards to Bottles/Waydroid when they
    # are there, and offers the one-time setup when they are not (moos-run-foreign).
    #
    # Pin it for existing users too, because the two defaults they already have are both
    # dead ends: a raw Bottles association fails silently before Bottles is installed, and
    # Waydroid's own .apk handler runs `waydroid app install` with no window at all — on a
    # machine where Android was never initialised, that double-click does nothing.
    # Never overrule a real third-party choice: only claim the type when it is unset or
    # still points at one of those two.
    if [ -f /usr/share/applications/org.moos.runforeign.desktop ]; then
        for mime in application/x-msdownload application/x-ms-dos-executable \
                    application/vnd.microsoft.portable-executable application/x-msi \
                    application/vnd.android.package-archive; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*bottles*|*waydroid*|*runforeign*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.runforeign.desktop
                    ;;
            esac
        done
        echo "pinned the MoOS app runner for .exe/.msi/.apk in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "${XDG_DATA_HOME:-$HOME/.local/share}/applications" 2>/dev/null || true
    return 0
}
pin_default_apps

# --- Retire the hand-installed Kawkab Mono ------------------------------------
# The Arabic terminal font was first proven on this machine by dropping the TTFs
# into ~/.local/share/fonts with a matching ~/.config/fontconfig override, because
# the fix had to be visible before the image could carry it. The image carries it
# now (/usr/share/fonts/kawkab-mono + /etc/fonts/conf.d/61-moos-brand.conf), and a
# user-level copy of a font policy is precisely the kind of shadow that outranks
# the image and freezes it at whatever it said the day it was written.
#
# So: once the system font is present, remove the stand-in. Narrowly scoped to the
# exact files that were staged — nothing else under the user's fonts is touched.
if [ -f /usr/share/fonts/kawkab-mono/KawkabMono-Regular.ttf ]; then
    stale_conf="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/99-moos-kawkab-test.conf"
    if [ -f "$stale_conf" ]; then
        rm -f "$stale_conf"
        rm -f "${XDG_DATA_HOME:-$HOME/.local/share}"/fonts/KawkabMono-*.ttf
        command -v fc-cache >/dev/null 2>&1 && fc-cache -f >/dev/null 2>&1
        echo "removed the user-level Kawkab Mono stand-in; the image ships it now" >>"$log" 2>/dev/null || true
    fi
fi

# --- Retire user-level copies of MoOS's own theme assets ------------------------
# Same trap, several directories. Anything under ~/.local/share SHADOWS the copy in
# /usr, so a MoOS asset staged there freezes at whatever it said the day it was
# written and no later image can fix it. Every one of these paths is MoOS-owned by
# name; nothing that belongs to the user is touched.
#
# They exist because a fix has to be PROVEN on the running desktop before the image
# can carry it (AGENTS.md: read it back from the running system). Staging is the
# right way to prove it. Leaving the stage up afterwards is how the image loses.
user_share="${XDG_DATA_HOME:-$HOME/.local/share}"
for rel in \
    "plasma/plasmoids/org.moos.nova.clock" \
    "plasma/plasmoids/org.moos.nova.deskclock" \
    "plasma/plasmoids/org.moos.ui2.dashboard" \
    "plasma/look-and-feel/org.moos.nova" \
    "plasma/look-and-feel/org.moos.nova.light" \
    "plasma/look-and-feel/org.moos.ui" \
    "plasma/look-and-feel/org.moos.ui.light" \
    "plasma/look-and-feel/org.moos.ui2" \
    "plasma/look-and-feel/org.moos.ui2.light" \
    "plasma/desktoptheme/Nova" \
    "plasma/desktoptheme/NovaLight" \
    "plasma/desktoptheme/MoOSUI" \
    "plasma/desktoptheme/MoOSUILight" \
    "plasma/desktoptheme/MoOSUI2" \
    "plasma/desktoptheme/MoOSUI2Light" \
    "aurorae/themes/MoOSNova" \
    "aurorae/themes/MoOSNovaLight" \
    "aurorae/themes/MoOSUI" \
    "aurorae/themes/MoOSUILight" \
    "aurorae/themes/MoOSUI2" \
    "aurorae/themes/MoOSUI2Light" \
    "color-schemes/NovaDark.colors" \
    "color-schemes/NovaLight.colors" \
    "color-schemes/MoOSUIDark.colors" \
    "color-schemes/MoOSUILight.colors" \
    "color-schemes/MoOSUI2Dark.colors" \
    "color-schemes/MoOSUI2Light.colors" \
    "konsole/NovaDark.colorscheme" \
    "konsole/NovaLight.colorscheme" \
    "konsole/MoOSUIDark.colorscheme" \
    "konsole/MoOSUILight.colorscheme" \
    "konsole/MoOSUI2Dark.colorscheme" \
    "konsole/MoOSUI2Light.colorscheme" \
    "konsole/MoOS.profile" \
    "konsole/MoOSLight.profile" \
    "konsole/MoOSUI.profile" \
    "konsole/MoOSUILight.profile" \
    "konsole/MoOSUI2.profile" \
    "konsole/MoOSUI2Light.profile" \
    "wallpapers/MoOSUI2Graphite" \
    "wallpapers/MoOSUI2Tide" \
    "icons/Nova" \
    "icons/NovaLight" \
    "icons/MoOSUI2" \
    "icons/MoOSUI2Light" \
; do
    if [ -e "/usr/share/$rel" ] && [ -e "${user_share}/$rel" ]; then
        rm -rf "${user_share:?}/$rel"
        echo "removed the user-level copy of $rel; it shadows the image" >>"$log" 2>/dev/null || true
    fi
done

# Make the collapsed tray actually take effect. Plasma 6.7's writeConfig+reloadConfig set
# the config file but never rebuild the running systray's shown/hidden model, so the tray
# keeps drawing every indicator until the shell is restarted (verified on 6.7.2: file said
# "2 shown", tray drew 8, survived reboots). A full plasmashell restart re-reads the file we
# just wrote. This whole apply body only runs on a REAL apply (marker missing after a
# THEME_REV bump, or a self-heal), never on a steady-state login, so this is not a per-login
# flicker; the per-revision marker also stops a repeated self-heal from thrashing the shell.
#
# The dock reconcile above needs exactly the same restart for exactly the same reason —
# icontasks keeps drawing the launcher model it booted with — so one restart serves both.
tray_marker="${state_dir}/moos-tray-collapsed.v${THEME_REV}"
if { [ "${tray_applied:-0}" = "1" ] || [ "${dock_applied:-0}" = "1" ]; } && [ ! -e "$tray_marker" ]; then
    if ! systemctl --user restart plasma-plasmashell.service >>"$log" 2>&1; then
        kquitapp6 plasmashell >>"$log" 2>&1 || true
        sleep 1
        setsid kstart plasmashell >>"$log" 2>&1 &
    fi
    touch "$tray_marker" 2>/dev/null || true
    applied=1
    echo "restarted plasmashell so the collapsed tray and the dock's launchers take hold" >>"$log" 2>/dev/null || true
fi

# Only mark done after reading the complete result back from the running desktop.
# A successful LNF command followed by a failed wallpaper/widget migration is
# not success; leaving the marker absent makes the next login retry safely.
lnf_after="$(current_lookandfeel)" || lnf_after=""
deco_after="$(current_decoration)" || deco_after=""
if [ "$applied" = "1" ] \
        && [ "$lnf_after" = "$want_lnf" ] \
        && theme_complete "$lnf_after" "$deco_after" "$want_wallpaper_package"; then
    if touch "$marker" 2>/dev/null; then
        echo "applied OK" >>"$log" 2>/dev/null || true
    else
        echo "apply complete but marker write failed — will retry next login" >>"$log" 2>/dev/null || true
    fi
else
    rm -f "$marker" 2>/dev/null || true
    echo "apply incomplete after runtime readback — will retry next login" >>"$log" 2>/dev/null || true
fi
exit 0
