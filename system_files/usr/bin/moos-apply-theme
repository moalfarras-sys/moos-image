#!/usr/bin/env bash
# moos-apply-theme — apply the full MoOS UI2 Global Theme once per user.
#
# WHY: /etc/xdg/kdeglobals sets [KDE] LookAndFeelPackage=org.moos.ui2, but
# Plasma 6 only AUTO-applies a subset of a default Global Theme (color scheme,
# icons) on a fresh login — it does NOT apply the wallpaper, splash, or the
# rest of the "look". So a freshly-created INSTALLED user lands on a half-Breeze
# desktop that does not look like MoOS. This runs once on first login and
# explicitly applies the whole thing (colors + wallpaper + splash).
#
# Separate marker from moos-firstrun on purpose: a system that was already
# installed (and whose user already saw moos-firstrun) still gets the theme
# applied on the first login AFTER a `bootc upgrade` that ships this file.
set -uo pipefail

# Versioned marker: bump THEME_REV whenever the MoOS UI assets change so a later
# `bootc upgrade` re-applies the new look exactly once for EXISTING users (a
# fixed marker would skip every revision after the first). Old markers are
# cleaned up so they don't accumulate.
# 22: apply the unified MoOS visual system to existing users: rebuilt Plasma
#     controls and Aurorae chrome, first-party icons, exact GTK/GSettings pins,
#     balanced blur, localized RTL clock, and the refreshed 4K wallpaper pair.
# 23: the dock's own revision. The rim art is repaired (a malformed corner path
#     dropped a stray turquoise line into the dock, and the rim died at the
#     corner/side seam), task tiles finally show which apps are OPEN, and the
#     clock is PUT BACK: rev 22's migration only rewrote an existing
#     org.kde.plasma.digitalclock into the MoOS clock, so a panel that had no
#     clock at all — the maintainer's — silently stayed clockless.
# 24: Aurorae frames changed (flat maximized bar, centred buttons, no blur mask),
#     and the tray hide-list changed — the remote-control indicator is UNHIDDEN
#     (a security signal that must surface when Active) and the video bridge
#     gained its Arabic Id. The rev bump re-runs the tray collapse so existing
#     sessions get the corrected list, and restarts the shell over the new art.
# 26: palette-matched Tidal Cut icon overlays plus the refined Launcher/control
#     states. Re-apply once so existing users stop carrying the shared light
#     symbolic fallback in dark/accent themes.
# 27: the nine first-party application marks are redrawn and baked per palette.
#     Existing sessions must drop ~/.local/share/icons overrides of those marks
#     (and of MoOSUI2*/hicolor moos-* trees left by live previews) — otherwise
#     XDG_DATA_HOME keeps showing the retired Breeze-blue geometry forever while
#     every gate on /usr stays green.
# 28: lock-screen wallpaper becomes part of the theme contract for EXISTING users.
#     The v27 marker short-circuited on theme_intact() before checking the lock
#     wallpaper, so only fresh users received it. Re-apply once, then require an
#     exact package match: NovaLight is not Nova merely because one name prefixes
#     the other.
# 29: the application marks gain the 9-layer liquid-glass plate (rebaked into all
#     14 palette overlays) and the launcher's session strip gains working hover
#     tooltips plus honest logout/switch-user glyphs. Existing sessions must drop
#     home icon previews AND home shadows of the first-party MoOS plasmoids —
#     a ~/.local/share/plasma/plasmoids/org.moos.brand left by a live preview
#     outranks /usr forever and no earlier revision cleaned that class.
# 30: the Horizon Bar becomes TWO glass slabs. A single floating panel cannot
#     centre the task area (Plasma has no flexible spacer and the system zone
#     outweighs the brand button by ~450 physical px, measured), so the roles
#     split into a CENTERED dock capsule (brand + tasks — the true screen centre
#     at every task count) and a CORNER system capsule (tray + clock), and the
#     keyboard/language indicator is pinned into the tray's always-shown list.
#     All bar structure now lives in moos-bar-apply (single source:
#     /usr/share/moos/moos-bar.conf), which does the split, the tray pin, one
#     guarded plasmashell restart and a live readback of its own.
# 31: the shadow cleanup loop now covers ALL 16 family desktop themes, not just
#     the base MoOSUI2/MoOSUI2Light. A live preview of any family member
#     (e.g. MoOSUI2Nova) left a shadow under ~/.local/share/plasma/desktoptheme/
#     that outranked /usr and froze the user on a stale theme while every gate
#     stayed green — the same trap rev 29 fixed for plasmoids. Tasks SVG
#     hover/focus states are refined: subtle underline indicators replace the
#     bordered rectangles that read as "boxes" on the panel.
# 32: the last two boxes are gone from the shipped art — the frame Plasma's shell
#     paints behind an OPEN panel applet (widgets/tabbar.svg `*-active-tab`, a
#     0.84 slab with a 0.88 accent rim) and the flat tile every task state filled
#     behind its icon. This rev exists for the SVG CACHE: Plasma serves
#     ~/.cache/plasma_theme_<Theme>.kcache and ~/.cache/ksvg-elements, so new art
#     under a frozen OSTree /usr does not reach the screen until those are
#     purged, which only happens inside this once-per-revision migration. Without
#     the bump an updated machine keeps rendering the boxes and every gate stays
#     green — the exact class of trap rev 29 and 31 were written for.
# 33: the bar is ONE capsule again. Rev 30 split it into a centred dock capsule
#     and a corner system capsule to win the true screen centre for the task
#     area; on the real machine that ships as two detached pieces of glass with
#     a wide gap and the clock marooned in the corner, and the owner rejected it
#     on sight. moos-bar-apply no longer splits — it MERGES every bottom panel
#     into one and orders the applets from moos-bar.conf. This rev is what makes
#     an already-split desktop converge: the merge is file surgery on the
#     appletsrc and only runs inside this once-per-revision migration.
# 34: motion is sized to the machine. moos-visual-tier probes the render node,
#     GPU driver, cores, memory and panel size, classifies the host as flagship
#     / balanced / essential, and writes the matching KWin + Kirigami profile.
#     Until now every MoOS install ran the profile tuned on a discrete-GPU 4K
#     desktop, including cloud hosts with no render node at all.
# 35: the tray gets shorter and the context island arrives. shownItems drops from
#     six forced icons to four (bluetooth and brightness move to auto, where they
#     surface only when they have something to say); org.moos.island joins
#     extraItems — KNOWN to the tray but never forced — so Plasma's own
#     ActiveStatus/PassiveStatus decides, and the island appears only while a
#     player is actually playing. Verified live against a real MPRIS2 service on
#     the session bus: one mark appears, and disappears with the player.
# 36: the launcher's favourites grid assembles instead of appearing — each tile
#     arrives a beat after the one before it (24 ms, capped at 11 steps), and the
#     entrance now replays on EVERY open instead of once per session. This rev
#     exists because the change is shipped QML: OSTree pins /usr mtimes, Qt's
#     qmlcache is keyed on mtime, and without the bump plasmashell keeps
#     executing the compiled OLD widget after the upgrade.
# 37: the dock becomes a material and the home button becomes a button. The
#     glass ramp spanned 0.15 of alpha — measured on the shipped NovaLight panel
#     it travelled #C2DAE6 -> #AECDD8 under an almost constant alpha, which is a
#     wash, not glass. The range is doubled (0.50..0.86 dark, 0.58..0.88 light):
#     more frost shows at the top, the bottom carries the icons. And the MoOS
#     button was literally color "transparent" at rest — the one control wearing
#     the system's name was invisible until the pointer found it; it now rests at
#     highlight 0.10.
# 38: the launcher grid becomes a grid of CARDS, and the light dock keeps its
#     depth through the family wash. App tiles were "transparent" until hovered
#     — the same defect the home button had — so the grid read as loose icons
#     floating in an empty pane. They now rest on the TEXT colour at 0.05, which
#     is the one value that lifts a card off its surface on a light theme AND a
#     dark one, and they lift 2 px on hover. Grid icons 44 -> 52.
#
#     The light panel ramp was being flattened by the family wash: mixing the
#     three panel roles 55% toward a near-white tint pulled top, middle and
#     bottom toward the same colour, so the base's 34 luminance steps collapsed
#     to 13 and the dock rendered as flat paint. The wash now moves WHERE the
#     dock sits without changing HOW FAR it travels.
# 39: AMPLITUDE. Revs 32-38 were all correct and all invisible, and the reason
#     was one habit: every value was chosen in the 0.05..0.12 band, which over
#     pale glass renders as 5-11 luminance steps. A person needs roughly 15 to
#     register that anything changed. Measured on the running dock, the home
#     button's resting pill was ELEVEN steps against bare glass — present in the
#     code, absent to the eye. It is 0.24 now and measures 21.5. The launcher's
#     tile cards go 0.05 -> 0.11 and their hover 0.14 -> 0.24 for the same
#     reason. Nothing visual ships from here without that measurement.
# 40: the desk is handed back to its owner. Both containments on this machine
#     carried immutability=1 — Plasma's "Widgets are locked" — with nothing in
#     this repo setting it. That does not merely stop a drag: it removes Add
#     Widgets, Configure and every applet's own settings from the context menus,
#     so the desktop goes read-only with nothing on screen saying why. It had
#     been in force through every session, which is why "I do not know where to
#     manage the widgets" was the correct complaint and no colour was ever going
#     to answer it. moos-bar-apply now returns every containment to 0 on each
#     apply.
# 41: the MoOS clock becomes findable. It shipped with no Category at all — the
#     only applet on the system without one — so it fell outside every filter in
#     Plasma's widget browser, and with no Description[ar] it described itself in
#     English to an Arabic session. Both are fields the EXPLORER renders, and
#     missing them fails nothing and warns nobody; it just makes a MoOS widget
#     harder to find than a stock KDE one, in MoOS's own browser. Gated now for
#     every org.moos.* widget, icon resolution included.
# 42: the launcher sidebar tells you which page you are on. The SELECTED nav row
#     sat at highlight 0.11 and hover at 0.065 — both inside the 0.05..0.12 band
#     that renders as 5-11 luminance steps, under the ~15 a person needs, so the
#     sidebar looked identical on every page. Selected is 0.26 now, hover 0.14.
#     Rows correctly stay transparent at REST; a sidebar is a list, not a grid.
# 43: the launcher hero cards become cards at REST. CommandCard sat at text
#     0.025 / featured highlight 0.105 — again the invisible band. Resting fill
#     is textColour 0.11 (same measured AppTile contract); hover/press use the
#     accent; rim stays ≤0.22 at rest. SettingCard raised from 0.045 to 0.11.
#     Also unlocked desktop.locked so createApplet works on a session shell.
# 44: the auto-placed Hero Clock is gone. Rev 43 seeded org.moos.heroclock on
#     the desk; the owner rejected it on sight. Remove every instance and never
#     seed again — the plasmoid stays installable from the widget browser.
# 45: one generated Design Core and one transactional theme owner replace the
#     application-local token copies and the migrator's second 16-theme table.
#     QML cache eviction is required for the global MoUI imports, launcher and
#     picker updates to reach existing OSTree users. The picker also gains a
#     safe custom-image canvas flow whose encoded state survives login repair.
# 46: the unified experience reaches every effective shell/session consumer:
#     Horizon Hub, launcher, Control Center, login/lock/power/splash and the
#     sixteen generated profiles all consume org.moos.ui. Qt/GTK engine choices
#     are now profile data and verified live. The wallpaper no longer owns any
#     infinite animation; sparse finite weather/health pulses replace the
#     measured 10.25–11.3% permanent 4K repaint tax. Existing sessions must drop
#     qmlcache and reload the wallpaper package to receive both the visual and
#     performance architecture.
# 47: DelegateModel temporarily gives a launcher tile index=-1 while detaching
#     it. The staggered entrance delay now clamps both bounds, preventing a
#     negative PauseAnimation and the repeated live-shell warnings it caused.
#     Reload the launcher QML for existing immutable-image users.
# 48: Horizon Hub drops its outer glass card and moves to the upper/middle
#     centre; the launcher retires clipped wireframe corners; org.moos.island
#     moves from a square tray cell into the direct adaptive MPRIS zone after
#     the launcher. Existing users must purge QML caches, remove a stale
#     user-level island package, migrate the panel and restart plasmashell once.
# 49: the launcher gives each input route exactly one expanded-state owner
#     (custom pointer handling, Plasma activation for keyboard/accessibility),
#     and the bar marker becomes a payload fingerprint with current-shell QML
#     health verification. Existing panels also remove the retired island child
#     from either historical system-tray nesting shape while preserving every
#     unrelated tray item. Re-run once so an update cannot leave first-party
#     applets stuck as Plasma error icons behind an already-existing marker.
THEME_REV=50
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir" 2>/dev/null || true
marker="${state_dir}/moos-ui2-theme-applied.v${THEME_REV}"

# Plasma can launch the same autostart entry twice while session restore is
# settling. Two migrations removing/recreating the same applet are not
# idempotent while they overlap, so only one instance may own this revision.
if command -v flock >/dev/null 2>&1; then
    lock_dir="${XDG_RUNTIME_DIR:-$state_dir}"
    mkdir -p "$lock_dir" 2>/dev/null || true
    if exec 9>"${lock_dir}/moos-apply-theme.lock"; then
        flock -n 9 || exit 0
    fi
fi

# MoOS now ships TWO looks, and they are equally legitimate. Everything below that
# asks "is the desktop still MoOS?" must accept either — a user who chose Light and
# gets dragged back to Dark on every login has not been protected, they have been
# overruled.
DARK_LNF="org.moos.ui2"

# UI1 remains installed as an explicit rollback. It counts as intact after the
# UI2 migration marker exists, so `moos-theme ui1-dark|ui1-light` is a durable
# user choice rather than something the login repair immediately overwrites.

log="${XDG_CACHE_HOME:-$HOME/.cache}/moos-apply-theme.log"
mkdir -p "$(dirname "$log")" 2>/dev/null || true

# What the desktop is ACTUALLY wearing right now. Empty (or no kreadconfig6) means
# "cannot tell" — say so, and let the caller fall back to trusting the marker rather
# than re-applying the theme on every single login.
current_lookandfeel() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null
}


# Which one should a repair restore? Whichever the user last chose. Only when the
# desktop has drifted to something that is not MoOS at all do we impose the
# default. Re-applying Dark to someone who deliberately picked Light would make
# this script the bug it exists to fix.
target_lnf() {
    local current completed
    if [ "$#" -ge 1 ]; then
        current="$1"
    else
        current="$(current_lookandfeel)"
    fi
    if [ "$#" -ge 2 ]; then
        completed="$2"
    elif [ -e "$marker" ]; then
        completed=true
    else
        completed=false
    fi

    # MoOS ships a FAMILY of looks now (the Graphite/Tidal base pair plus nova,
    # amethyst, midnight, aurora, gaming, dev, study — each with a light sibling:
    # 16 installed Global Themes). ANY of them is a deliberate user choice and must
    # be PRESERVED on a self-heal — the source of truth for "is this a real theme"
    # is whether its package is on disk, not a hand-kept list here (that list is
    # exactly what silently drifted and dragged gaming/dev/study/*-light back to
    # Dark). Only a look that is NOT an installed MoOS package (an old Nova/UI1, a
    # Fedora look, or Breeze) resolves to the dark default — the one guaranteed to
    # exist. Plasma does not error on a missing theme, it silently serves Breeze,
    # so the on-disk check is what keeps a stale name from persisting.
    case "$current" in
        org.moos.ui2|org.moos.ui2.*)
            # LNF_ROOT is overridable so the gate can point the existence check at
            # the in-tree packages; at runtime it defaults to the installed path.
            if [ -d "${LNF_ROOT:-/usr/share/plasma/look-and-feel}/$current" ]; then
                echo "$current"
            else
                echo "$DARK_LNF"
            fi
            ;;
        *) echo "$DARK_LNF" ;;
    esac
}

# Keep the automatic light/dark targets and the event-sound selector safe on
# every login, including the marker fast path. The writes belong to the
# transactional appearance owner; this revision migrator only requests its
# fixed guard operation.
if command -v moos-theme >/dev/null 2>&1; then
    moos-theme guard >>"$log" 2>&1 || true
fi

# User-local Plasma data outranks /usr/share and can be created by a preview at
# any time, including after THEME_REV was applied. Reconcile the complete set of
# MoOS-owned packages on every invocation, before the marker fast path. Move
# shadows to a dated quarantine so preview work remains recoverable while the
# official image copy becomes authoritative again. The operation is idempotent:
# an absent source is ignored and unrelated user packages are never inspected.
quarantine_moos_data_shadows() {
    local user_share="${XDG_DATA_HOME:-$HOME/.local/share}"
    local system_share="${MOOS_SYSTEM_SHARE:-/usr/share}"
    local stamp backup rel source target
    stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
    backup="${user_share}/MoOS/theme-shadow-backups/${stamp}"

    while IFS= read -r -d '' source; do
        rel="${source#${user_share}/}"
        target="${system_share}/${rel}"
        [ -e "$target" ] || continue
        mkdir -p "${backup}/$(dirname "$rel")" 2>/dev/null || continue
        if mv -- "$source" "${backup}/${rel}" 2>/dev/null; then
            echo "quarantined user shadow ${rel} in ${backup}" >>"$log" 2>/dev/null || true
        fi
    done < <(
        for root in \
            "${user_share}/plasma/plasmoids/org.moos."* \
            "${user_share}/plasma/desktoptheme/MoOSUI2"* \
            "${user_share}/plasma/look-and-feel/org.moos.ui2"* \
            "${user_share}/aurorae/themes/MoOSUI2"* \
            "${user_share}/color-schemes/MoOSUI2"* \
            "${user_share}/konsole/MoOSUI2"* \
            "${user_share}/wallpapers/MoOSUI2"* \
            "${user_share}/icons/MoOSUI2"*; do
            [ -e "$root" ] || continue
            printf '%s\0' "$root"
        done
    )
}

# This must precede the marker exit below. A preview can create a new shadow
# after a successful revision apply, and waiting for a revision bump leaves the
# running desktop on the preview forever.
quarantine_moos_data_shadows


migration_completed=false
if [ -e "$marker" ]; then
    migration_completed=true
    lnf="$(current_lookandfeel)" || exit 0   # cannot tell → trust the marker, as before
    # moos-theme is the only appearance owner. Its read-only verifier resolves
    # the active profile from the generated database, includes GTK/KWin/Konsole
    # and respects the central custom-wallpaper state. The revision migrator
    # owns cache/layout migrations only; it must not keep a second theme table.
    if command -v moos-theme >/dev/null 2>&1 \
            && moos-theme verify-lnf "$lnf" >>"$log" 2>&1; then
        exit 0
    fi
    echo "=== moos-apply-theme $(date -u '+%FT%TZ') === SELF-HEAL: look-and-feel='${lnf:-unset}'" >>"$log" 2>/dev/null || true
    # A SELF-HEAL inside the same THEME_REV used to leave the tray marker in
    # place, which suppressed the one guarded plasmashell restart — so the
    # tray/dock writes landed in the file while the running shell kept drawing
    # the old model until logout (the exact Plasma 6.7 reloadConfig() failure
    # this script documents). A repair that the user cannot see is not a repair:
    # drop the bar marker too so this heal may restart the shell once, like a
    # fresh apply. (moos-tray-collapsed is the retired pre-split marker.)
    rm -f "${state_dir}/moos-bar-applied.v${THEME_REV}" 2>/dev/null || true
    rm -f "${state_dir}/moos-tray-collapsed.v${THEME_REV}" 2>/dev/null || true
else
    echo "=== moos-apply-theme $(date -u '+%FT%TZ') ===" >>"$log" 2>/dev/null || true
fi

mkdir -p "$state_dir" 2>/dev/null || true
rm -f "${state_dir}"/moos-theme-applied "${state_dir}"/moos-theme-applied.v* \
      "${state_dir}"/moos-ui2-theme-applied.v* 2>/dev/null || true
# Drop bar-apply markers from older revisions too, so a new THEME_REV restarts the
# shell once to rebuild the current single-capsule bar. Only the current
# v${THEME_REV} marker is kept below (and the retired tray marker is purged for
# good).
find "${state_dir}" -maxdepth 1 \( -name 'moos-bar-applied.v*' -o -name 'moos-tray-collapsed.v*' \) \
    ! -name "moos-bar-applied.v${THEME_REV}" -delete 2>/dev/null || true

# Autostart can fire before the Plasma shell / session D-Bus is ready. Wait for
# plasmashell so the apply tools actually take effect. Do NOT rely on `qdbus`:
# Qt6 renamed it (qdbus6/qdbus-qt6) and Plasma 6 no longer pulls the Qt5 one, so
# a plain `qdbus` probe can be permanently absent → the loop would burn the full
# 40 s on EVERY first login and lose the readiness guarantee. Prefer busctl
# (ships with systemd) / gdbus (ships with glib2), which are always present.
plasma_ready() {
    if command -v busctl >/dev/null 2>&1; then
        busctl --user call org.kde.plasmashell /PlasmaShell \
            org.freedesktop.DBus.Peer Ping >/dev/null 2>&1 && return 0
    fi
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 && return 0
    fi
    for q in qdbus6 qdbus-qt6 qdbus; do
        command -v "$q" >/dev/null 2>&1 \
            && "$q" org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0
    done
    return 1
}
for _ in $(seq 1 40); do plasma_ready && break; sleep 1; done

# Drop the rendered-SVG caches BEFORE applying. Plasma memoises every FrameSvg
# element it has ever rasterised, keyed by theme name — and on an OSTree system
# the shipped SVG's mtime does not move when the file's content changes across a
# `bootc upgrade`, so a stale cache can outlive the artwork it was baked from and
# the user keeps seeing the OLD dock. Same class of bug as the qmlcache freeze
# the launchers already work around. Cheap to rebuild, so just delete them.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
rm -rf "${cache_dir}/ksvg-elements" \
       "${cache_dir}"/plasma_theme_*.kcache \
       "${cache_dir}"/plasma-svgelements* \
       "${cache_dir}/icon-cache.kcache" 2>/dev/null || true

# The QML disk cache is the same trap, and it hides a WIDGET rather than a colour.
#
# OSTree pins every mtime under /usr to the epoch, and Qt's qmlcache is keyed on mtime — so
# a rebuilt plasmoid whose QML changed byte for byte still looks "unchanged" to the cache,
# and plasmashell keeps executing the compiled OLD widget after the upgrade. moos-ui-migrate
# purges these, but only once, behind a permanent marker: it will never run again on this
# machine, so it cannot carry a new widget in. This runs once per THEME_REV, which is exactly
# the cadence at which MoOS's own QML changes.
rm -rf "${cache_dir}/qmlcache" \
       "${cache_dir}/plasmashell/qmlcache" \
       "${cache_dir}/kwin/qmlcache" 2>/dev/null || true
find "${cache_dir}" -mindepth 2 -maxdepth 2 -type d -name qmlcache \
    -exec rm -rf -- {} + 2>/dev/null || true

# Home icon overrides are the SAME class of trap as ~/.config/kdedefaults: they
# outrank /usr in XDG_DATA_DIRS, and a live preview (or an earlier THEME_REV that
# planted a fallback) leaves them forever. THEME_REV 27 ships the redrawn
# first-party application marks baked per palette; if the home tree still holds
# the retired geometry — often still painted with Breeze's #3daee9 — the dock
# and launcher keep showing that while every image gate stays green. Drop only
# the MoOS-owned overlay trees and moos-* / moplayer names under hicolor; never
# touch third-party icon themes the user may have installed.
local_icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
if [ -d "$local_icons" ]; then
    find "$local_icons" -maxdepth 1 -type d \( \
            -name 'MoOSUI2' -o -name 'MoOSUI2Light' -o -name 'MoOSUI2*' \
        \) -exec rm -rf -- {} + 2>/dev/null || true
    find "$local_icons/hicolor" -type f \( \
            -name 'moos-*' -o -name 'moplayer.*' -o -name 'org.moos.*' \
        \) -delete 2>/dev/null || true
    # Empty size dirs left behind are harmless; the icon cache must not keep
    # pointing at files we just removed.
    rm -f "${local_icons}/hicolor/icon-theme.cache" \
          "${cache_dir}/icon-cache.kcache" 2>/dev/null || true
fi

# A home shadow of a FIRST-PARTY MoOS plasmoid is the same trap one directory
# over: ~/.local/share/plasma/plasmoids/org.moos.* outranks /usr in the package
# search path, so a live-preview copy keeps executing last month's launcher —
# tooltips, glyphs and all — while every image gate stays green. Only the
# MoOS-owned ids are dropped; third-party widgets the user installed stay put.
local_plasmoids="${XDG_DATA_HOME:-$HOME/.local/share}/plasma/plasmoids"
for moos_widget in org.moos.brand org.moos.heroclock org.moos.nova.clock \
                   org.moos.island; do
    rm -rf "${local_plasmoids:?}/${moos_widget}" 2>/dev/null || true
done

# ksycoca — the menu/launcher/service database — is the SAME mtime trap one level
# up: OSTree pins every /usr mtime to the epoch, so a .desktop that was renamed
# across a `bootc upgrade` (Discover -> "Mo Store" is exactly this) looks unchanged
# to ksycoca, and the menu keeps serving the old name and icon. A full,
# non-incremental rebuild ignores mtimes and reads the files, so this revision's
# .desktop and icon changes actually reach the user. Runs only on a real apply
# (this whole body does), so it is not a per-login cost.
command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental >>"$log" 2>&1 || true

# Revision 21 expands Baloo from the inherited media-folder profile to the
# user's whole visible HOME. Ask the already-running daemon to re-read the new
# /etc/xdg/baloofilerc; a fresh login would pick it up naturally, but an update
# must not require another logout before launcher file results become complete.
if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session --dest org.kde.baloo --object-path / \
        --method org.kde.baloo.main.updateConfig >>"$log" 2>&1 || true
fi
command -v balooctl6 >/dev/null 2>&1 && balooctl6 check >>"$log" 2>&1 || true

applied=0

# Repair the look the user is ACTUALLY on. Dark is only the default, not the
# verdict — see target_lnf().
want_lnf="$(target_lnf "$(current_lookandfeel)" "$migration_completed")"
case "$want_lnf" in
    org.moos.ui2|org.moos.ui2.*) ;;
    *)
        echo "cannot resolve a MoOS theme target from '${want_lnf:-unset}'" >>"$log" 2>/dev/null || true
        exit 0
        ;;
esac
echo "repairing the generated profile ${want_lnf}" >>"$log" 2>/dev/null || true

# One owner applies the appearance. moos-apply-theme still owns revisioned cache,
# shell-layout and user-shadow migrations, but it must never restate the Plasma,
# KWin, GTK, Konsole, lock-screen or wallpaper cascade. moos-theme snapshots the
# live pre-repair state, applies the profile, reads every layer back and restores
# the snapshot on any failure.
if command -v moos-theme >/dev/null 2>&1 \
        && moos-theme apply-lnf "$want_lnf" >>"$log" 2>&1; then
    applied=1
else
    echo "the transactional theme owner could not repair ${want_lnf}" >>"$log" 2>&1
fi

# A terminal with no chrome — and the ONLY way to ship it.
#
# konsolerc kills the menu bar and the single-tab tab strip, but Konsole's two toolbars
# (mainToolBar, sessionToolbar) are not config keys at all: KMainWindow restores them from
# the Qt `State=` blob in ~/.local/state/konsolestaterc, and that state file is NOT part of
# the XDG config cascade, so /etc/xdg cannot reach it. Proven on this hardware: writing
# [MainWindow][Toolbar mainToolBar] Hidden=true into every candidate file leaves the toolbar
# on screen, while flipping the visibility byte inside the blob removes it.
#
# So seed the user's state file. In the blob each toolbar is a UTF-16BE name followed by a
# 1-byte visible flag; set it to 0. If the user has no blob yet, there is nothing to patch —
# Konsole writes one on first exit, and the next login catches it. Guarded by a one-shot
# marker: a user who turns the toolbar back on keeps it.
konsole_chrome_marker="${state_dir}/moos-konsole-chrome.v1"
if [ ! -e "$konsole_chrome_marker" ] && command -v python3 >/dev/null 2>&1; then
    if python3 - "${state_dir}/konsolestaterc" <<'PY' >>"$log" 2>&1
import base64, re, sys
path = sys.argv[1]
try:
    text = open(path).read()
except OSError:
    sys.exit("konsole chrome: no state file yet — will hide the toolbars next login")
m = re.search(r"^State=(.*)$", text, re.M)
if not m:
    sys.exit("konsole chrome: state file carries no State blob yet")
raw = bytearray(base64.b64decode(m.group(1)))
changed = False
for name in ("mainToolBar", "sessionToolbar"):
    i = raw.find(name.encode("utf-16-be"))
    if i < 0:
        continue
    flag = i + len(name) * 2          # the visible flag sits right after the name
    if flag < len(raw) and raw[flag] == 1:
        raw[flag] = 0
        changed = True
if changed:
    open(path, "w").write(re.sub(r"^State=.*$",
                                 "State=" + base64.b64encode(bytes(raw)).decode(),
                                 text, count=1, flags=re.M))
    print("konsole chrome: toolbars hidden")
else:
    print("konsole chrome: toolbars already hidden")
PY
    then
        touch "$konsole_chrome_marker" 2>/dev/null || true
        applied=1
    fi
fi

# --- The dock and the system tray: one call, one source of truth ---------------
# Everything structural about the bar is owned by moos-bar-apply, which reads
# /usr/share/moos/moos-bar.conf — the single source of truth. It MERGES every
# bottom panel into one glass capsule (launcher, adaptive island, tasks,
# separator, tray, clock),
# pins the tray's always-shown toggles (Wi-Fi, Bluetooth, volume, brightness,
# notifications and the keyboard/language indicator), applies the geometry,
# restarts the shell once per revision and reads the result back. Nothing in this
# script may restate a bar value; tests pin the two files together.
if command -v moos-bar-apply >/dev/null 2>&1; then
    moos-bar-apply apply "$THEME_REV" >>"$log" 2>&1 \
        || echo "moos-bar-apply reported an incomplete dock readback — will retry" >>"$log" 2>&1
else
    echo "moos-bar-apply missing — dock left as found" >>"$log" 2>&1
fi

# --- Motion sized to the machine ----------------------------------------------
# /etc/xdg/kwinrc ships ONE profile for every install — blur 15, magic lamp, the
# full set — tuned on a discrete-GPU desktop. The same profile reaches a cloud
# VPS drawing in software, where every blur pass behind every panel and menu is
# CPU work per frame, and KWin cannot tell the difference: its supported() check
# asks what the backend CAN do, not what this machine SHOULD do.
#
# moos-visual-tier reads the hardware (render node, GPU driver, cores, memory,
# panel size) and writes the profile that fits: flagship keeps the tuned full
# system, balanced trades magic lamp for squash and blur 15 for 9, essential
# turns blur and window animations off and keeps motion short. It writes only
# the keys it owns, records them, and stops touching any key the user has since
# changed — so this is a default, not a policy. `moos-visual-tier --set <tier>`
# pins it and turns detection off.
if command -v moos-visual-tier >/dev/null 2>&1; then
    moos-visual-tier --apply >>"$log" 2>&1 \
        || echo "moos-visual-tier could not size the motion profile" >>"$log" 2>&1
fi

# Appearance ownership stops at moos-theme. The revision migrator intentionally
# performs no second KSplash/KWin/icon/GTK cascade here: doing so after the
# verified transaction could tear it and would make rollback incomplete.


# --- The sensor daemon the monitors cannot live without ------------------------
# Every system-monitor widget in Plasma reads from ksystemstats, and on this image
# it was simply NOT RUNNING. The widget does not say so: its face fails to build
# (Plasmoid.faceController.fullRepresentation is null) and it draws an empty grey
# rectangle. A monitor showing nothing looks exactly like a monitor reading zero.
#
# Started explicitly, before the widgets are placed, rather than trusted to come up
# on demand — it did not.
systemctl --user start plasma-ksystemstats.service >>"$log" 2>&1 || true

# --- The desktop itself -------------------------------------------------------
# The dashboard bento is NOT a desktop widget anymore. Three shipped fixes
# (x=80 -> 260 -> 360, icons right-aligned, live-ISO skip) each only moved its
# collision with the Folder View icons, because a Plasma desktop applet always
# draws ON TOP of the icon grid. The bento now lives INSIDE the wallpaper
# (org.moos.ui2.wallpaper renders image + dashboard as one layer BELOW icons),
# so there is nothing to place, nothing to collide, and the live ISO gets its
# dashboard back — the "Install MoOS" icon simply draws over wallpaper.
#
# moos-theme already reconciled every desktop containment through the one
# transactional scene owner. THEME_REV 43's auto-seed of heroclock was rejected
# on sight; this migrator clears its old cache/shadows and never places it again.


# --- The system tray -----------------------------------------------------------
# Pinned by moos-bar-apply above from moos-bar.conf: the everyday toggles
# (Wi-Fi, Bluetooth, volume, brightness, notifications and the keyboard/language
# indicator) live in the corner system capsule, always one click away.
# --- Photos and video ---------------------------------------------------------
# MoOS now ships gwenview and haruna and declares them in /etc/xdg/mimeapps.list.
# That is only half the fix: ~/.config/mimeapps.list OUTRANKS /etc/xdg, and Plasma
# WRITES that file the first time anyone picks "Open With". A user who ever opened
# a photo in Chrome — which every MoOS user did, because the image had no viewer at
# all — has Chrome recorded there, and the system default will never reach them.
#
# So pin it in the user's own config. Only for the types a browser has hijacked,
# only when the viewer is actually installed, and never overwriting a choice that
# is already a real image viewer — if the user prefers something else, that is
# theirs to keep.
pin_default_apps() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    local mimeapps="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
    local mime current

    if [ -f /usr/share/applications/org.kde.gwenview.desktop ]; then
        for mime in image/png image/jpeg image/gif image/webp image/tiff image/bmp \
                    image/avif image/heif image/jxl; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.kde.gwenview.desktop
                    ;;
            esac
        done
        echo "pinned gwenview as the image viewer in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    if [ -f /usr/share/applications/org.kde.haruna.desktop ]; then
        for mime in video/mp4 video/x-matroska video/webm video/quicktime video/mpeg; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.kde.haruna.desktop
                    ;;
            esac
        done
    fi

    # --- IPTV playlists open in MoPlayer -------------------------------------
    # Shipping the default in /etc/xdg is not the same as the user getting it: a
    # user's own ~/.config/mimeapps.list outranks the system one, and Plasma writes
    # to that file the first time anyone touches "Open With" on anything. On an
    # existing MoOS install, an .m3u therefore still opens in haruna — which plays
    # it as a *file*, one stream at a time, with no categories, no guide and no
    # favourites, which is not what the user asked for by double-clicking it.
    #
    # Only claim the type when it is unset or currently pointing at something that
    # is a dead end for a playlist. A user who has deliberately chosen VLC keeps VLC.
    if [ -f /usr/share/applications/org.moos.moplayer.desktop ]; then
        for mime in application/x-mpegurl application/vnd.apple.mpegurl audio/x-mpegurl; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*haruna*|*chrome*|*chromium*|*firefox*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.moplayer.desktop
                    ;;
            esac
        done
        echo "pinned MoPlayer as the IPTV playlist handler in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    # --- Windows .exe and Android .apk open in the MoOS runner --------------------
    # The runner is what turns "MoOS supports Windows apps" into "the .exe you just
    # downloaded runs when you double-click it": it forwards to Bottles/Waydroid when they
    # are there, and offers the one-time setup when they are not (moos-run-foreign).
    #
    # Pin it for existing users too, because the two defaults they already have are both
    # dead ends: a raw Bottles association fails silently before Bottles is installed, and
    # Waydroid's own .apk handler runs `waydroid app install` with no window at all — on a
    # machine where Android was never initialised, that double-click does nothing.
    # Never overrule a real third-party choice: only claim the type when it is unset or
    # still points at one of those two.
    if [ -f /usr/share/applications/org.moos.runforeign.desktop ]; then
        for mime in application/x-msdownload application/x-ms-dos-executable \
                    application/vnd.microsoft.portable-executable application/x-msi \
                    application/vnd.android.package-archive; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*bottles*|*waydroid*|*runforeign*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.runforeign.desktop
                    ;;
            esac
        done
        echo "pinned the MoOS app runner for .exe/.msi/.apk in the user's mimeapps.list" >>"$log" 2>/dev/null || true

        # --- Office documents open (or offer to install) an office suite ------
        # Same half-fix problem, and a worse starting point: these types had NO
        # default at all on the shipped image — measured, all seven of .docx,
        # .xlsx, .pptx, .doc, .xls, .odt and .rtf returned nothing from
        # `xdg-mime query default`. So a Word file did nothing when double-clicked.
        #
        # Only claim a type that is unset or already pointing at the runner. Anyone
        # who has actually installed LibreOffice, OnlyOffice or WPS has made a real
        # choice and keeps it — the runner would only get in their way.
        for mime in application/msword \
                    application/vnd.openxmlformats-officedocument.wordprocessingml.document \
                    application/vnd.oasis.opendocument.text application/rtf \
                    application/vnd.ms-excel \
                    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet \
                    application/vnd.oasis.opendocument.spreadsheet \
                    application/vnd.ms-powerpoint \
                    application/vnd.openxmlformats-officedocument.presentationml.presentation \
                    application/vnd.oasis.opendocument.presentation; do
            current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key "$mime" 2>/dev/null)"
            case "$current" in
                ""|*runforeign*)
                    kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                        --key "$mime" org.moos.runforeign.desktop
                    ;;
            esac
        done
        # A CSV is text and kate is already installed: opening it must not cost a
        # 700 MB download. Claim it only if nothing else has.
        current="$(kreadconfig6 --file "$mimeapps" --group "Default Applications" --key text/csv 2>/dev/null)"
        [ -z "$current" ] && [ -f /usr/share/applications/org.kde.kate.desktop ] && \
            kwriteconfig6 --file "$mimeapps" --group "Default Applications" \
                --key text/csv org.kde.kate.desktop
        echo "pinned office document handling in the user's mimeapps.list" >>"$log" 2>/dev/null || true
    fi

    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "${XDG_DATA_HOME:-$HOME/.local/share}/applications" 2>/dev/null || true
    return 0
}
pin_default_apps

# --- Retire the hand-installed Kawkab Mono ------------------------------------
# The Arabic terminal font was first proven on this machine by dropping the TTFs
# into ~/.local/share/fonts with a matching ~/.config/fontconfig override, because
# the fix had to be visible before the image could carry it. The image carries it
# now (/usr/share/fonts/kawkab-mono + /etc/fonts/conf.d/61-moos-brand.conf), and a
# user-level copy of a font policy is precisely the kind of shadow that outranks
# the image and freezes it at whatever it said the day it was written.
#
# So: once the system font is present, remove the stand-in. Narrowly scoped to the
# exact files that were staged — nothing else under the user's fonts is touched.
if [ -f /usr/share/fonts/kawkab-mono/KawkabMono-Regular.ttf ]; then
    stale_conf="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/99-moos-kawkab-test.conf"
    if [ -f "$stale_conf" ]; then
        rm -f "$stale_conf"
        rm -f "${XDG_DATA_HOME:-$HOME/.local/share}"/fonts/KawkabMono-*.ttf
        command -v fc-cache >/dev/null 2>&1 && fc-cache -f >/dev/null 2>&1
        echo "removed the user-level Kawkab Mono stand-in; the image ships it now" >>"$log" 2>/dev/null || true
    fi
fi

# --- Retire user-level copies of MoOS's own theme assets ------------------------
# Same trap, several directories. Anything under ~/.local/share SHADOWS the copy in
# /usr, so a MoOS asset staged there freezes at whatever it said the day it was
# written and no later image can fix it. Every one of these paths is MoOS-owned by
# name; nothing that belongs to the user is touched.
#
# They exist because a fix has to be PROVEN on the running desktop before the image
# can carry it (AGENTS.md: read it back from the running system). Staging is the
# right way to prove it. Leaving the stage up afterwards is how the image loses.
user_share="${XDG_DATA_HOME:-$HOME/.local/share}"

# RETIRED MoOS assets are removed from the user share UNCONDITIONALLY — the
# image no longer carries them, so the [-e /usr/share/…] guard below would
# never fire, and a stale user-level copy of a package the OS retired would
# haunt the widget explorer forever. Every name here is MoOS-owned.
for rel in \
    "plasma/plasmoids/org.moos.nova.deskclock" \
    "plasma/plasmoids/org.moos.ui2.dashboard" \
; do
    if [ -e "${user_share}/$rel" ]; then
        rm -rf "${user_share:?}/$rel"
        echo "removed the user-level copy of retired $rel" >>"$log" 2>/dev/null || true
    fi
done

for rel in \
