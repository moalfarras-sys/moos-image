#!/usr/bin/env bash
# moai-brain-mode — retired. It switched the phone agent between a local, a cloud and a
# hybrid brain. Mo AI is cloud-only now, and which cloud brain answers — the provider,
# the model, and the free models measured on this machine — is set on the Mo AI page of
# System Settings. This name opens that page and changes nothing itself.
set -euo pipefail
printf '%s\n' 'Mo AI: سحابي مجاني فقط | free cloud only. الإعدادات في «إعدادات النظام ← MoOS ← Mo AI» | settings are in System Settings → MoOS → Mo AI'
exec moos-settings --section=assistant
