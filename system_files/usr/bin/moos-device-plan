#!/usr/bin/python3
"""Produce a deterministic, read-only hardware plan for MoOS first boot."""
import argparse
import json
import math
import os
import platform
import re
import shutil
import subprocess
import stat
from pathlib import Path


def run(*args, timeout=12):
    try:
        p = subprocess.run(args, text=True, capture_output=True, timeout=timeout)
        return (p.stdout or "").strip() if p.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def flatpak_installed(app_id):
    return subprocess.run(
        ["flatpak", "info", app_id], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL).returncode == 0 if shutil.which("flatpak") else False


# PCI classes where "no kernel driver bound" means the device is genuinely unusable.
# Deliberately NOT every driverless device: a host bridge, a chipset SRAM window or an ISA
# bridge legitimately have no driver, and reporting those as "missing drivers" would be a
# fake warning on a perfectly healthy machine. Only these classes are actionable.
DRIVER_CRITICAL = re.compile(
    r"VGA compatible|3D controller|Display controller|Network controller|Ethernet controller|"
    r"Audio device|Multimedia audio|USB controller|SATA controller|Non-Volatile memory",
    re.I)


def motion_sensor_inventory(sysfs=Path("/sys")):
    """Read known firmware clients, retaining unavailable versus empty inventory."""
    result = {"known": False, "status": "unavailable", "clients": []}
    try:
        with os.scandir(sysfs / "bus/i2c/devices") as entries:
            names = sorted(entry.name for entry in entries
                           if re.fullmatch(r"i2c-SMOCF05:[0-9A-Fa-f]+", entry.name))
        for name in names:
            client = sysfs / "bus/i2c/devices" / name
            if not client.is_dir():
                raise OSError("motion client disappeared")
            driver = client / "driver"
            # A dangling driver link is not a bound driver.
            try:
                bound = stat.S_ISDIR(driver.stat().st_mode)
            except FileNotFoundError:
                bound = False
            result["clients"].append({"name": name, "bound": bound,
                                       "driver": driver.resolve().name if bound else ""})
        result.update(known=True, status="ok")
    except OSError:
        result["status"] = "read-failed"
    return result


def i2c_driver_gaps(sysfs=Path("/sys")):
    return [f"I2C motion sensor SMOCF05 ({client['name']})"
            for client in motion_sensor_inventory(sysfs)["clients"] if not client["bound"]]


def json_probe(argv, timeout=5):
    """Fixed read-only probes. Missing, failed and malformed are never false."""
    try:
        process = subprocess.run(argv, text=True, capture_output=True, timeout=timeout)
        if process.returncode:
            return None, "command-failed"
        if len(process.stdout.encode("utf-8")) > 262144:
            return None, "invalid-response"
        return json.loads(process.stdout), "ok"
    except subprocess.TimeoutExpired:
        return None, "timeout"
    except (OSError, subprocess.SubprocessError):
        return None, "unavailable"
    except (ValueError, UnicodeError):
        return None, "invalid-response"


def sensor_proxy_report(payload, status):
    result = {"known": False, "status": status, "has_accelerometer": None,
              "orientation": "undefined"}
    try:
        if status != "ok":
            return result
        if not isinstance(payload, dict) or payload.get("type") != "a{sv}":
            raise ValueError("invalid properties")
        data = payload["data"]
        if not isinstance(data, list) or len(data) != 1 or not isinstance(data[0], dict):
            raise ValueError("invalid properties data")
        has = data[0]["HasAccelerometer"]
        orientation = data[0]["AccelerometerOrientation"]
        if (not isinstance(has, dict) or has.get("type") != "b"
                or type(has.get("data")) is not bool
                or not isinstance(orientation, dict) or orientation.get("type") != "s"
                or orientation.get("data") not in
                ("undefined", "normal", "bottom-up", "left-up", "right-up")):
            raise ValueError("invalid sensor values")
        result.update(known=True, status="ok", has_accelerometer=has["data"],
                      orientation=orientation["data"])
    except (KeyError, TypeError, ValueError):
        result["status"] = "invalid-response"
    return result


def internal_panel_report(payload, status):
    result = {"known": False, "status": status, "panels": []}
    try:
        if status != "ok":
            return result
        if not isinstance(payload, dict) or not isinstance(payload.get("outputs"), list):
            raise ValueError("invalid outputs")
        for output in payload["outputs"]:
            if not isinstance(output, dict) or type(output.get("type")) is not int:
                raise ValueError("invalid output type")
            # KScreen Output::Panel == 7. Connector names are not device types.
            if output["type"] != 7:
                continue
            if (type(output.get("connected")) is not bool
                    or type(output.get("enabled")) is not bool
                    or not isinstance(output.get("name"), str)):
                raise ValueError("invalid panel")
            if not output["connected"]:
                continue
            panel = {"name": output["name"], "enabled": output["enabled"],
                     "geometry_known": False, "auto_rotation_policy": "unavailable"}
            # KScreen serializes autoRotatePolicy only with AutoRotation capability.
            # Its absence cannot establish the policy. Never is a valid personal lock.
            if "autoRotatePolicy" in output:
                policy = output["autoRotatePolicy"]
                if type(policy) is not int or policy not in (0, 1, 2):
                    raise ValueError("invalid automatic rotation policy")
                panel["auto_rotation_policy"] = {0: "never", 1: "tablet", 2: "always"}[policy]
            scale, rotation = output.get("scale"), output.get("rotation")
            modes = output.get("modes")
            if (type(scale) not in (int, float) or not 0.1 <= scale <= 16
                    or type(rotation) is not int or rotation not in (1, 2, 4, 8, 16, 32, 64, 128)
                    or not isinstance(modes, list)):
                raise ValueError("invalid panel geometry")
            current = output.get("currentModeId")
            ids = [m.get("id") if isinstance(m, dict) else None for m in modes]
            if (any(not isinstance(identity, str) or not identity for identity in ids)
                    or len(set(ids)) != len(ids)):
                raise ValueError("invalid mode identities")
            if output["enabled"] and (not isinstance(current, str) or not current):
                raise ValueError("active panel has no current mode identity")
            mode = next((m for m in modes if m["id"] == current), None)
            if mode is not None:
                size = mode.get("size", {})
                if not isinstance(size, dict):
                    raise ValueError("invalid mode size")
                width, height = size.get("width"), size.get("height")
                if (type(width) is not int or type(height) is not int
                        or not 1 <= width <= 32768 or not 1 <= height <= 32768):
                    raise ValueError("invalid mode size")
                transformed = (height, width) if rotation in (2, 8, 32, 128) else (width, height)
                panel.update(geometry_known=True, mode_pixels={"width": width, "height": height},
                             derived_logical_size={"width": round(transformed[0] / scale, 3),
                                                   "height": round(transformed[1] / scale, 3)},
                             derived_logical_bounds={"width": math.ceil(transformed[0] / scale),
                                                     "height": math.ceil(transformed[1] / scale)},
                             scale=scale, rotation=rotation)
            elif output["enabled"]:
                raise ValueError("active panel has no current mode")
            result["panels"].append(panel)
        result.update(known=True, status="ok")
    except (KeyError, TypeError, ValueError):
        result.update(known=False, status="invalid-response")
    return result


def graphical_session_available():
    """Do not start a Qt GUI diagnostic in headless/early-login environments."""
    qpa = os.environ.get("QT_QPA_PLATFORM", "").split(":", 1)[0]
    if qpa and qpa not in ("wayland", "xcb"):
        return False
    session = os.environ.get("XDG_SESSION_TYPE", "")
    if qpa and qpa != {"wayland": "wayland", "x11": "xcb"}.get(session):
        return False
    try:
        if session == "wayland":
            name, runtime = os.environ.get("WAYLAND_DISPLAY", ""), os.environ.get("XDG_RUNTIME_DIR", "")
            if not name or not runtime or not Path(runtime).is_absolute():
                return False
            path = Path(name) if Path(name).is_absolute() else Path(runtime) / name
            return stat.S_ISSOCK(path.stat().st_mode)
        if session == "x11":
            display = os.environ.get("DISPLAY", "")
            match = re.fullmatch(r":([0-9]+)(?:\.[0-9]+)?", display)
            return bool(match and stat.S_ISSOCK(
                Path("/tmp/.X11-unix/X" + match[1]).stat().st_mode))
    except OSError:
        pass
    return False


def rotation_report(sysfs=Path("/sys")):
    inventory = motion_sensor_inventory(sysfs)
    payload, status = json_probe(["busctl", "--system", "--json=short", "call",
        "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
        "org.freedesktop.DBus.Properties", "GetAll", "s", "net.hadess.SensorProxy"])
    sensor = sensor_proxy_report(payload, status)
    payload, status = (json_probe(["kscreen-doctor", "-j"])
                       if graphical_session_available() else (None, "no-graphical-session"))
    display = internal_panel_report(payload, status)
    if any(not client["bound"] for client in inventory["clients"]):
        state = "driver-missing"
    elif not inventory["known"] or not display["known"]:
        state = "inspection-unavailable"
    elif not display["panels"]:
        state = "not-applicable"
    elif not sensor["known"]:
        state = "sensor-unavailable"
    elif sensor["has_accelerometer"] is False:
        state = "accelerometer-missing"
    elif not any(panel["enabled"] for panel in display["panels"]):
        state = "panel-disabled"
    elif all(panel["auto_rotation_policy"] == "never"
             for panel in display["panels"] if panel["enabled"]):
        state = "rotation-locked"
    else:
        # GetAll does not claim the sensor; undefined can be an idle valid value.
        # Presence is a prerequisite, not proof of orientation/touch operation.
        state = "available-unverified"
    return {"status": state, "i2c": inventory, "sensor": sensor, "display": display,
            "owner": "KWin", "physical_rotation_tested": False,
            "touch_mapping_tested": False}


def driver_gaps(pci=None):
    """Devices the user would actually notice as broken: no driver bound, in a class that needs one."""
    blocks = re.split(r"\n(?=\S)", run("lspci", "-nnk") if pci is None else pci)
    gaps = []
    for block in blocks:
        head = block.splitlines()[0].strip() if block.strip() else ""
        if not head or not DRIVER_CRITICAL.search(head):
            continue
        if "Kernel driver in use:" not in block:
            gaps.append(head)
    return gaps + i2c_driver_gaps()


def firmware_report(status=None):
    """Read-only local fwupd/journal results, with explicit probe confidence.

    Keep the two-list return contract. Optional status reports command outcome,
    not online metadata freshness, device support or functional hardware health.
    fwupdmgr documents exit2 as successful nothing-to-do; exit1 is a failure.
    Pinned2.1.8 emits Devices[] or an Error object in JSON mode (fu-util.c and
    fu-util-common.c). Never infer success from a localized error message.
    """
    status = status if status is not None else {}
    status.update(firmware_known=False, firmware_status="not-installed",
                  kernel_journal_known=False, kernel_journal_status="unavailable")
    updates = []
    if shutil.which("fwupdmgr"):
        try:
            p = subprocess.run(["fwupdmgr", "get-updates", "--json"],
                               text=True, capture_output=True, timeout=25)
            status["firmware_exit_code"] = p.returncode
            if p.returncode not in (0, 2):
                status["firmware_status"] = "command-failed"
            else:
                raw = (p.stdout or "").strip()
                data = json.loads(raw) if raw else None
                # Exit2 is the documented no-action success. Some releases
                # emit no JSON; current releases emit a structured Error.
                nothing = p.returncode == 2 and (not raw or (
                    isinstance(data, dict) and isinstance(data.get("Error"), dict)
                    and isinstance(data["Error"].get("Domain"), str)
                    and type(data["Error"].get("Code")) is int
                    and isinstance(data["Error"].get("Message"), str)))
                if nothing:
                    status.update(firmware_known=True, firmware_status="nothing-to-do")
                else:
                    if not isinstance(data, dict) or not isinstance(data.get("Devices"), list):
                        raise ValueError("invalid firmware response")
                    for dev in data["Devices"]:
                        if not isinstance(dev, dict) or not isinstance(dev.get("Name"), str):
                            raise ValueError("invalid firmware device")
                        releases = dev.get("Releases", [])
                        if not isinstance(releases, list):
                            raise ValueError("invalid firmware releases")
                        for rel in releases:
                            if not isinstance(rel, dict) or not isinstance(rel.get("Version"), str):
                                raise ValueError("invalid firmware release")
                        if releases:
                            current = dev.get("Version", "")
                            if not isinstance(current, str) or not releases[0]["Version"]:
                                raise ValueError("invalid firmware version")
                            updates.append(f"{dev['Name']} {current} → {releases[0]['Version']}".strip())
                    if p.returncode == 2 and updates:
                        raise ValueError("inconsistent nothing-to-do response")
                    status.update(firmware_known=True, firmware_status="updates" if updates else "no-updates")
        except subprocess.TimeoutExpired:
            status["firmware_status"] = "timeout"
        except (OSError, subprocess.SubprocessError):
            status["firmware_status"] = "unavailable"
        except ValueError:
            status["firmware_status"] = "invalid-response"

    missing = []
    try:
        p = subprocess.run(["journalctl", "-b", "-k", "--no-pager", "-o", "cat"],
                           text=True, capture_output=True, timeout=20)
        status["kernel_journal_exit_code"] = p.returncode
        status["kernel_journal_known"] = p.returncode == 0
        status["kernel_journal_status"] = "ok" if p.returncode == 0 else "command-failed"
        # Preserve observed gaps even if the command later fails. A failure
        # never turns partial output into a complete/clean kernel journal.
        for line in (p.stdout or "").splitlines():
            m = re.search(r"[Dd]irect firmware load for (\S+) failed", line)
            if m and m.group(1) not in missing:
                missing.append(m.group(1))
    except subprocess.TimeoutExpired:
        status["kernel_journal_status"] = "timeout"
    except (OSError, subprocess.SubprocessError):
        status["kernel_journal_status"] = "unavailable"
    return updates, missing[:8]

def booted_image_reference(raw):
    """Read only the booted deployment, never a staged/rollback image name."""
    try:
        data = json.loads(raw)
    except (TypeError, ValueError):
        return ""
    if not isinstance(data, dict):
        return ""
    deployments = data.get("deployments", [])
    if isinstance(deployments, list):
        for deployment in deployments:
            if isinstance(deployment, dict) and deployment.get("booted") is True:
                ref = deployment.get("container-image-reference", "")
                return ref if isinstance(ref, str) else ""
    image = data
    for key in ("status", "booted", "image", "image", "image"):
        image = image.get(key) if isinstance(image, dict) else None
    return image if isinstance(image, str) else ""


def detect(machine=None):
    # MOOS_DEVICE_PLAN_MACHINE lets a test drive the architecture branch through the REAL process
    # boundary, the way tests/test_device_plan.py runs this file. Without it the black-box section
    # simulated an x86 NVIDIA box and then read the host's own CPU, so it passed on a CI runner and
    # failed on the maintainer's aarch64 machine — where `just check` is the thing everyone is told
    # to run. Same shape as MOOS_TIER_ROOT and MOOS_HW_DRYRUN elsewhere in the image: a documented
    # test seam, never consulted by anything that ships.
    machine = (machine or os.environ.get("MOOS_DEVICE_PLAN_MACHINE")
               or platform.machine()).lower()
    x86_64 = machine in ("x86_64", "amd64")
    pci = run("lspci", "-nnk")
    blocks = re.split(r"\n(?=\S)", pci)
    gpu_blocks = [block for block in blocks
                  if re.search(r"VGA compatible|3D controller|Display controller", block, re.I)]
    gpu_lines = [block.splitlines()[0].strip() for block in gpu_blocks]
    gpu = "\n".join(gpu_lines) or "unavailable"
    # Match vendor words, never class text such as the "ati" in "compatible".
    vendor = ("nvidia" if re.search(r"\bNVIDIA\b", gpu, re.I)
              else "amd" if re.search(r"\b(?:AMD|ATI)\b", gpu, re.I)
              else "intel" if re.search(r"\bIntel\b", gpu, re.I)
              else "unknown")
    driver_hits = re.findall(r"Kernel driver in use:\s*(\S+)", "\n".join(gpu_blocks))
    driver = ", ".join(dict.fromkeys(driver_hits)) or "unavailable"
    os_release = {}
    try:
        with open("/etc/os-release", encoding="utf-8") as stream:
            for line in stream:
                if "=" in line:
                    k, v = line.rstrip().split("=", 1); os_release[k] = v.strip('"')
    except OSError:
        pass
    # bootc status became root-only on the installed host, so an unprivileged
    # desktop helper cannot rely on it. rpm-ostree exposes the same deployed
    # container reference read-only and remains available to the user.
    image = (booted_image_reference(run("bootc", "status", "--format=json"))
             or booted_image_reference(run("rpm-ostree", "status", "--json")))
    nvidia_image = bool(re.search(r"(?:^|/)moos-nvidia(?=[:@]|$)", image))
    mem_kib = 0
    try:
        with open("/proc/meminfo") as stream:
            mem_kib = int(next(line.split()[1] for line in stream if line.startswith("MemTotal:")))
    except (OSError, StopIteration, ValueError):
        pass
    memory_gib = round(mem_kib / 1024 / 1024, 1)
    kvm = os.access("/dev/kvm", os.R_OK | os.W_OK)
    secure_boot = run("mokutil", "--sb-state") or "unavailable"
    actions = []
    pci_known = bool(pci.strip())
    health = "ready" if pci_known else "attention"
    if not pci_known:
        actions.append({
            "id": "hardware-unavailable", "severity": "info",
            "title": "فحص الأجهزة غير متاح | Hardware inspection unavailable",
            "detail": "تعذّر قراءة أجهزة PCI؛ حالة التعريفات غير مؤكدة. | PCI devices could not be read; driver health is unverified.",
            "url": ""
        })
    if vendor == "nvidia" and "nvidia" not in driver and x86_64:
        health = "action-needed"
        actions.append({
            "id": "nvidia-image", "severity": "important",
            "title": "تعريف NVIDIA الرسمي | NVIDIA driver",
            "detail": "انتقل ذرّيًا إلى صورة MoOS NVIDIA؛ تُطبَّق بعد إعادة التشغيل. | Switch atomically to the MoOS NVIDIA image; applies after reboot.",
            "url": "moos://do/install-nvidia"
        })
    # Mo AI shows this line as-is, so it carries both languages like every other
    # device-plan string the owner reads.
    if vendor == "nvidia" and "nvidia" in driver and nvidia_image:
        driver_status = "NVIDIA proprietary driver active"
        driver_status_ar = "تعريف NVIDIA الرسمي يعمل"
    elif vendor == "nvidia" and x86_64:
        driver_status = "NVIDIA detected; optimized image required"
        driver_status_ar = "تم اكتشاف NVIDIA؛ يلزم الانتقال إلى صورة MoOS NVIDIA"
    elif vendor == "nvidia":
        driver_status = "NVIDIA detected; use the driver supplied for this ARM device"
        driver_status_ar = "تم اكتشاف NVIDIA؛ استخدم التعريف المخصص لجهاز ARM هذا"
    else:
        driver_status = f"{vendor.title()} graphics using {driver}"
        driver_status_ar = f"رسوميات {vendor.title()} تعمل بتعريف {driver}"
    # Real driver/firmware gaps — the Hardware Center's whole job is to say "this device of
    # yours does not work and here is why", instead of only ever talking about the GPU.
    gaps = driver_gaps(pci)
    if gaps:
        health = "action-needed"
        actions.append({
            "id": "driver-gap", "severity": "important",
            "title": "أجهزة بدون تعريف | Devices without a driver",
            "detail": "لا يوجد تعريف مرتبط بهذه الأجهزة | No kernel driver is bound to: " + "; ".join(gaps[:4]),
            "url": ""
        })

    rotation = rotation_report()
    rotation_state = rotation["status"]
    if rotation_state not in ("not-applicable", "available-unverified"):
        if health == "ready" and rotation_state != "rotation-locked":
            health = "action-needed" if rotation_state in ("driver-missing", "accelerometer-missing") else "attention"
        messages = {
            "rotation-locked": ("دوران الشاشة مقفل | Screen rotation locked",
                "خيارك الحالي يقفل الدوران؛ يمكنك مراجعته في إعدادات العرض. | Your current preference locks rotation; review it in Display settings."),
            "driver-missing": ("تعريف حساس الدوران مفقود | Rotation sensor driver missing",
                "الحساس ظاهر للنظام لكن تعريف النواة غير مرتبط؛ يلزم تحديث موقّع يدعم معرّف الجهاز. | The sensor is enumerated but its kernel driver is not bound; a signed update supporting its device ID is required."),
            "accelerometer-missing": ("حساس الدوران غير متاح | Accelerometer missing",
                "خدمة الحساسات لا تعرض مقياس تسارع؛ ظهور تعريف وحده لا يثبت عمل الدوران. | SensorProxy exposes no accelerometer; a driver binding alone does not establish rotation."),
            "panel-disabled": ("الشاشة الداخلية متوقفة | Internal display disabled",
                "حساس الاتجاه متاح لكن الشاشة الداخلية متوقفة؛ افتح إعدادات العرض لمراجعتها. | The sensor is available but the internal panel is disabled; review Display settings."),
            "sensor-unavailable": ("فحص حساس الدوران غير مكتمل | Rotation sensor inspection incomplete",
                "تعذّر قراءة حالة خدمة الحساسات؛ جاهزية الدوران غير مؤكدة. | SensorProxy could not be read; rotation readiness is unconfirmed."),
            "inspection-unavailable": ("فحص ربط الشاشة والحساس غير مكتمل | Display and sensor inspection incomplete",
                "تعذّر تأكيد أجهزة I2C أو الشاشات؛ حالة الربط غير مؤكدة. | I2C devices or displays could not be verified; their association is unconfirmed.")
        }
        title, detail = messages[rotation_state]
        actions.append({"id": "rotation-" + rotation_state,
                        "severity": "important" if rotation_state in ("driver-missing", "accelerometer-missing") else "info",
                        "title": title, "detail": detail, "url": ""})

    firmware_status = {}
    firmware_updates, missing_firmware = firmware_report(firmware_status)
    if not firmware_status.get("firmware_known") or not firmware_status.get("kernel_journal_known"):
        if health == "ready":
            health = "attention"
        actions.append({
            "id": "firmware-inspection-unavailable", "severity": "info",
            "title": "فحص البرامج الثابتة غير مكتمل | Firmware inspection incomplete",
            "detail": "تعذّر تأكيد تحديثات البرامج الثابتة أو قراءة سجل النواة؛ الحالة غير مؤكدة. | Firmware updates or the kernel journal could not be verified; firmware health is unconfirmed.",
            "url": ""
        })
    if missing_firmware:
        if health == "ready":
            health = "attention"
        actions.append({
            "id": "firmware-missing", "severity": "important",
            "title": "برامج ثابتة ناقصة | Missing firmware",
            "detail": "The kernel could not load: " + ", ".join(missing_firmware),
            "url": ""
        })
    if firmware_updates:
        if health == "ready":
            health = "attention"
        actions.append({
            "id": "firmware-update", "severity": "info",
            "title": "تحديث البرامج الثابتة | Firmware updates",
            "detail": "; ".join(firmware_updates[:4]),
            "url": "moos://do/update-firmware"
        })

    if not kvm:
        actions.append({"id": "kvm", "severity": "info", "title": "تسريع محاكي أندرويد | Android emulator acceleration", "detail": "فعّل المحاكاة الافتراضية للمعالج من إعدادات البرنامج الثابت وامنح صلاحية KVM. | Enable CPU virtualization in firmware and grant KVM access.", "url": ""})
    if memory_gib and memory_gib < 15:
        actions.append({"id": "memory", "severity": "info", "title": "ذاكرة للتطوير | Development memory", "detail": "يُنصح بـ16 غيغابايت أو أكثر لتطوير أندرويد. | 16 GiB or more is recommended for Android development.", "url": ""})
    # Mo Store is the one visible store; Bazaar is an OPTIONAL full-catalog engine,
    # never auto-installed into the default plan (that would ship a second store).
    recommended = [
        "org.mozilla.firefox", "org.videolan.VLC", "org.libreoffice.LibreOffice",
        "com.github.tchx84.Flatseal"
    ]
    if kvm and memory_gib >= 15:
        recommended.append("com.google.AndroidStudio")
    installed = [app for app in recommended if flatpak_installed(app)]
    return {
        "schema": 1, "health": health, "architecture": machine, "pci_known": pci_known,
        "gpu_vendor": vendor, "gpu": gpu,
        "driver": driver, "driver_status": driver_status,
        "driver_status_ar": driver_status_ar,
        "nvidia_image": nvidia_image, "memory_gib": memory_gib, "kvm": kvm,
        "secure_boot": secure_boot, "os": os_release.get("PRETTY_NAME", "MoOS"),
        "driver_gaps": gaps, "rotation": rotation,
        **firmware_status,
        "firmware_updates": firmware_updates,
        "missing_firmware": missing_firmware,
        "recommended_apps": recommended, "installed_recommended_apps": installed,
        "missing_recommended_apps": [x for x in recommended if x not in installed],
        "actions": actions,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--compact", action="store_true")
    args = parser.parse_args()
    print(json.dumps(detect(), ensure_ascii=False, indent=None if args.compact else 2))


if __name__ == "__main__":
    main()
