#!/usr/bin/env bash
# moos-fast-remote — MoOS "Fast Remote" mode.
# When ON, it pauses everything that makes the remote (Mo PC Remote) feel slow:
#   • live dashboard motion              -> the same MoOS scene, held still
#   • KWin blur + slide effects          -> off (huge win for encoded bandwidth)
#   • window animation duration          -> instant (nothing to re-encode)
#   • Mo AI local brain (VRAM ~5.6G)     -> suspended (freed for the compositor)
# When OFF, everything is restored to the full beautiful MoOS experience.
# Toggling is instant and never restarts kwin/plasmashell, so it is safe to run
# from inside an active remote session — the connection is not dropped.
set -uo pipefail

STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/moos-fast-remote.on"
ENGINE_HELPER="${MOOS_ENGINE_HELPER:-/usr/libexec/moai-local-engine}"
THEME_HELPER="${MOOS_THEME_HELPER:-/usr/bin/moos-theme}"

acquire_theme_lock() {
  local lock_dir="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}}"
  command -v flock >/dev/null 2>&1 || return 0
  mkdir -p "$lock_dir" 2>/dev/null || return 1
  exec 9>"${lock_dir}/moos-theme.lock" || return 1
  flock -w 30 9
}

kwin_reconfigure() {
  gdbus call --session --dest org.kde.KWin --object-path /KWin \
    --method org.kde.KWin.reconfigure >/dev/null 2>&1
}

# Switch the ACTIVE xkb group to a layout by its code (e.g. us / de). The owner's
# physical keyboard is German, so `de` is the day-to-day layout; but the phone speaks
# US, so remote typing is only correct with `us` active. Fast Remote flips to US while
# on and back to German when off. No-op if the layout is not in the session list.
set_layout() { # $1 = layout code
  local idx
  idx=$(gdbus call --session --dest org.kde.KWin --object-path /Layouts \
        --method org.kde.KeyboardLayouts.getLayoutsList 2>/dev/null \
        | python3 -c "import sys,re;c=re.findall(r\"\\('([a-z]+)'\",sys.stdin.read());t='$1';print(c.index(t) if t in c else -1)" 2>/dev/null)
  if [ -n "$idx" ] && [ "$idx" -ge 0 ] 2>/dev/null; then
    set_layout_idx "$idx"
  else
    # The phone layout is optional; machines without US in their layout list
    # still receive the rest of the Fast Remote profile.
    return 0
  fi
}

# Read / set the ACTIVE layout by INDEX, so OFF can restore whatever the user
# actually had — MoOS ships internationally, so hard-coding a country (de) on
# restore was wrong for every non-German user and never captured their real layout.
get_layout_idx() {
  local result
  result="$(gdbus call --session --dest org.kde.KWin --object-path /Layouts \
    --method org.kde.KeyboardLayouts.getLayout 2>/dev/null)" || return 1
  # The reply is `(uint32 N,)`; matching the first digits returned 32 (from the
  # type name) instead of N and silently left the session on the US layout.
  sed -nE 's/.*uint32 ([0-9]+).*/\1/p' <<<"$result"
}
set_layout_idx() { # $1 = index
  local result
  result="$(gdbus call --session --dest org.kde.KWin --object-path /Layouts \
    --method org.kde.KeyboardLayouts.setLayout "$1" 2>/dev/null)" || return 1
  case "$result" in *"(true,"*) return 0 ;; *) return 1 ;; esac
}

set_config() { # file group key value
  kwriteconfig6 --file "$1" --group "$2" --key "$3" "$4"
}

snapshot_config() { # file group key snapshot-name
  local file="$1" group="$2" key="$3" name="$4"
  local missing_a missing_b value_a value_b
  # Two unequal defaults distinguish an absent key without reserving a magic
  # value that a user could legitimately have configured.
  missing_a="__MOOS_FAST_REMOTE_$$_${RANDOM}_A__"
  missing_b="__MOOS_FAST_REMOTE_$$_${RANDOM}_B__"
  value_a="$(kreadconfig6 --file "$file" --group "$group" --key "$key" \
      --default "$missing_a" 2>/dev/null)" || return 1
  value_b="$(kreadconfig6 --file "$file" --group "$group" --key "$key" \
      --default "$missing_b" 2>/dev/null)" || return 1
  rm -f -- "${STATE}.${name}.value" "${STATE}.${name}.missing"
  if [ "$value_a" != "$value_b" ]; then
    : >"${STATE}.${name}.missing"
  else
    printf '%s\n' "$value_a" >"${STATE}.${name}.value"
  fi
}

restore_config() { # file group key snapshot-name
  local file="$1" group="$2" key="$3" name="$4" value
  if [ -f "${STATE}.${name}.missing" ]; then
    kwriteconfig6 --file "$file" --group "$group" --key "$key" --delete
  else
    [ -f "${STATE}.${name}.value" ] || return 1
    value="$(cat "${STATE}.${name}.value")"
    kwriteconfig6 --file "$file" --group "$group" --key "$key" "$value"
  fi
}

clear_appearance_snapshot() {
  rm -f -- "${STATE}.blur.value" "${STATE}.blur.missing" \
    "${STATE}.slide.value" "${STATE}.slide.missing" \
    "${STATE}.contrast.value" "${STATE}.contrast.missing" \
    "${STATE}.duration.value" "${STATE}.duration.missing" \
    "${STATE}.motion"
}

clear_transaction_snapshot() {
  clear_appearance_snapshot
  rm -f -- "${STATE}.brain" "${STATE}.prevlayout" "${STATE}.new"
}

snapshot_appearance() {
  snapshot_config kwinrc Plugins blurEnabled blur || return 1
  snapshot_config kwinrc Plugins slideEnabled slide || return 1
  snapshot_config kwinrc Plugins contrastEnabled contrast || return 1
  snapshot_config kdeglobals KDE AnimationDurationFactor duration || return 1
  "$THEME_HELPER" motion >"${STATE}.motion" || return 1
}

restore_appearance() {
  local motion
  restore_config kwinrc Plugins blurEnabled blur || return 1
  restore_config kwinrc Plugins slideEnabled slide || return 1
  restore_config kwinrc Plugins contrastEnabled contrast || return 1
  restore_config kdeglobals KDE AnimationDurationFactor duration || return 1
  motion="$(cat "${STATE}.motion" 2>/dev/null)"
  case "$motion" in still|gentle|alive) ;; *) return 1 ;; esac
  MOOS_THEME_LOCK_HELD=1 "$THEME_HELPER" motion "$motion" >/dev/null || return 1
  kwin_reconfigure
}

fast_on() {
  local brain
  acquire_theme_lock || {
    echo "Fast Remote: another appearance transaction is still running" >&2
    return 1
  }
  # Repeated desktop-action clicks must preserve the first transition's brain
  # and layout snapshot instead of overwriting it with the already-suspended
  # and already-US state.
  if [ -f "$STATE" ]; then
    echo "Fast Remote: already ON"
    return 0
  fi
  clear_transaction_snapshot
  if ! snapshot_appearance; then
    clear_transaction_snapshot
    echo "Fast Remote: could not snapshot the current appearance" >&2
    return 1
  fi
  # Capture every non-appearance value before the first mutation. The marker
  # is then committed atomically, so an interrupted ON always has an OFF path.
  brain="$("$ENGINE_HELPER" unit)" || {
    clear_transaction_snapshot
    echo "Fast Remote: could not resolve the selected Mo AI engine" >&2
    return 1
  }
  if systemctl --user is-active --quiet "$brain" 2>/dev/null; then
    printf '%s\n' "$brain" >"${STATE}.brain" || return 1
  fi
  get_layout_idx >"${STATE}.prevlayout" 2>/dev/null || : >"${STATE}.prevlayout"
  printf '%s\n' applying >"${STATE}.new" || return 1
  mv -f -- "${STATE}.new" "$STATE" || return 1
  # 1) transient effects off — every key is restored to its captured value.
  # AnimationDurationFactor belongs to kdeglobals, not kwinrc.
  if ! set_config kwinrc Plugins blurEnabled false \
      || ! set_config kwinrc Plugins slideEnabled false \
      || ! set_config kwinrc Plugins contrastEnabled false \
      || ! set_config kdeglobals KDE AnimationDurationFactor 0.05 \
      || ! MOOS_THEME_LOCK_HELD=1 "$THEME_HELPER" motion still >/dev/null; then
    restore_appearance >/dev/null 2>&1 || true
    rm -f -- "$STATE"
    clear_transaction_snapshot
    echo "Fast Remote: could not apply the temporary performance profile" >&2
    return 1
  fi
  kwin_reconfigure
  # 2) free the GPU: suspend only the selected Mo AI engine. Remember whether
  # it was active; OFF must not start a brain the user had deliberately left off.
  if [ -f "${STATE}.brain" ] \
      && ! systemctl --user stop "$brain" >/dev/null 2>&1; then
    restore_appearance >/dev/null 2>&1 || true
    rm -f -- "$STATE"
    clear_transaction_snapshot
    echo "Fast Remote: could not suspend the selected Mo AI engine" >&2
    return 1
  fi
  # 3) US keyboard for correct remote typing (the phone speaks US). Remember the
  #    layout in use FIRST, so OFF restores exactly it — not a hard-coded country.
  set_layout us
  printf '%s\n' on >"$STATE"
  echo "Fast Remote: ON  (effects off, scene still, US keyboard, Mo AI brain suspended)"
}

fast_off() {
  local brain saved prev
  acquire_theme_lock || {
    echo "Fast Remote: another appearance transaction is still running" >&2
    return 1
  }
  # Without an ON snapshot there is nothing to restore. A repeated OFF must not
  # manufacture new effect or keyboard settings.
  if [ ! -f "$STATE" ]; then
    echo "Fast Remote: already OFF"
    return 0
  fi
  # Restore the exact pre-ON appearance before clearing the marker. A failed
  # restore leaves every snapshot in place so the next OFF can retry safely.
  if ! restore_appearance; then
    echo "Fast Remote: exact appearance restore failed; state retained for retry" >&2
    return 1
  fi
  # Restore only the engine that was active before ON, and only if it is still
  # the selected allowlisted engine. A runtime migration while Fast Remote is on
  # must never resurrect the retired moai.service.
  brain="$("$ENGINE_HELPER" unit)" || {
    echo "Fast Remote: could not resolve the selected Mo AI engine; state retained" >&2
    return 1
  }
  saved="$(cat "${STATE}.brain" 2>/dev/null)"
  if [ -n "$saved" ] && [ "$saved" = "$brain" ] \
      && ! systemctl --user start "$brain" >/dev/null 2>&1; then
    echo "Fast Remote: could not restore the selected Mo AI engine; state retained" >&2
    return 1
  fi
  # restore whatever layout was active before Fast Remote (fallback: index 0),
  # not a hard-coded country — MoOS users are not all on a German keyboard.
  prev="$(cat "${STATE}.prevlayout" 2>/dev/null)"; [ -n "$prev" ] || prev=0
  if ! set_layout_idx "$prev"; then
    echo "Fast Remote: could not restore the keyboard layout; state retained" >&2
    return 1
  fi
  rm -f -- "$STATE"
  clear_transaction_snapshot
  echo "Fast Remote: OFF  (full experience restored)"
}

case "${1:-toggle}" in
  on)     fast_on ;;
  off)    fast_off ;;
  status) [ -f "$STATE" ] && echo "on" || echo "off" ;;
  toggle) [ -f "$STATE" ] && fast_off || fast_on ;;
  *) echo "usage: moos-fast-remote {on|off|toggle|status}" >&2; exit 2 ;;
esac
