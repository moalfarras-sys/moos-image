#!/usr/bin/env bash
# moos-fast-remote — MoOS "Fast Remote" mode.
# When ON, it pauses everything that makes the remote (Mo PC Remote) feel slow:
#   • live animated dashboard wallpaper  -> static Tide image
#   • KWin blur + slide effects          -> off (huge win for encoded bandwidth)
#   • window animation duration          -> instant (nothing to re-encode)
#   • Mo AI local brain (VRAM ~5.6G)     -> suspended (freed for the compositor)
# When OFF, everything is restored to the full beautiful MoOS experience.
# Toggling is instant and never restarts kwin/plasmashell, so it is safe to run
# from inside an active remote session — the connection is not dropped.
set -uo pipefail

STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/moos-fast-remote.on"
STATIC_WALLPAPER="/usr/share/wallpapers/MoOSUI2Tide"
LIVE_WALLPAPER="org.moos.ui2.wallpaper"

kwin_reconfigure() {
  gdbus call --session --dest org.kde.KWin --object-path /KWin \
    --method org.kde.KWin.reconfigure >/dev/null 2>&1
}

# Switch the ACTIVE xkb group to a layout by its code (e.g. us / de). The owner's
# physical keyboard is German, so `de` is the day-to-day layout; but the phone speaks
# US, so remote typing is only correct with `us` active. Fast Remote flips to US while
# on and back to German when off. No-op if the layout is not in the session list.
set_layout() { # $1 = layout code
  local idx
  idx=$(gdbus call --session --dest org.kde.KWin --object-path /Layouts \
        --method org.kde.KeyboardLayouts.getLayoutsList 2>/dev/null \
        | python3 -c "import sys,re;c=re.findall(r\"\\('([a-z]+)'\",sys.stdin.read());t='$1';print(c.index(t) if t in c else -1)" 2>/dev/null)
  [ -n "$idx" ] && [ "$idx" -ge 0 ] 2>/dev/null && \
    gdbus call --session --dest org.kde.KWin --object-path /Layouts \
      --method org.kde.KeyboardLayouts.setLayout "$idx" >/dev/null 2>&1
}

# Read / set the ACTIVE layout by INDEX, so OFF can restore whatever the user
# actually had — MoOS ships internationally, so hard-coding a country (de) on
# restore was wrong for every non-German user and never captured their real layout.
get_layout_idx() {
  gdbus call --session --dest org.kde.KWin --object-path /Layouts \
    --method org.kde.KeyboardLayouts.getLayout 2>/dev/null | grep -oE '[0-9]+' | head -1
}
set_layout_idx() { # $1 = index
  gdbus call --session --dest org.kde.KWin --object-path /Layouts \
    --method org.kde.KeyboardLayouts.setLayout "$1" >/dev/null 2>&1
}

set_effect() { # group key value
  kwriteconfig6 --file kwinrc --group "$1" --key "$2" "$3"
}

set_wallpaper_static() {
  gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell \
    --method org.kde.PlasmaShell.evaluateScript "
      var ds = desktops();
      for (var i=0;i<ds.length;i++){
        ds[i].wallpaperPlugin = 'org.kde.image';
        ds[i].currentConfigGroup = ['Wallpaper','org.kde.image','General'];
        ds[i].writeConfig('Image','file://$STATIC_WALLPAPER');
      }" >/dev/null 2>&1
}

set_wallpaper_live() {
  gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell \
    --method org.kde.PlasmaShell.evaluateScript "
      var ds = desktops();
      for (var i=0;i<ds.length;i++){ ds[i].wallpaperPlugin = '$LIVE_WALLPAPER'; }" \
    >/dev/null 2>&1
}

fast_on() {
  # 1) effects off
  set_effect Plugins blurEnabled false
  set_effect Plugins slideEnabled false
  set_effect Plugins contrastEnabled false
  # 2) instant animations
  set_effect KDE AnimationDurationFactor 0.05
  kwin_reconfigure
  # 3) static wallpaper
  set_wallpaper_static
  # 4) free the GPU: suspend Mo AI local brain (gateway stays; reloads on demand)
  systemctl --user stop moai.service >/dev/null 2>&1
  # 5) US keyboard for correct remote typing (the phone speaks US). Remember the
  #    layout in use FIRST, so OFF restores exactly it — not a hard-coded country.
  get_layout_idx > "${STATE}.prevlayout" 2>/dev/null || true
  set_layout us
  touch "$STATE"
  echo "Fast Remote: ON  (effects off, static wallpaper, US keyboard, Mo AI brain suspended)"
}

fast_off() {
  # restore effects
  set_effect Plugins blurEnabled true
  set_effect Plugins slideEnabled true
  kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled --delete 2>/dev/null
  kwriteconfig6 --file kwinrc --group KDE --key AnimationDurationFactor --delete 2>/dev/null
  kwin_reconfigure
  # restore live wallpaper
  set_wallpaper_live
  # bring Mo AI local brain back
  systemctl --user start moai.service >/dev/null 2>&1
  # restore whatever layout was active before Fast Remote (fallback: index 0),
  # not a hard-coded country — MoOS users are not all on a German keyboard.
  _prev="$(cat "${STATE}.prevlayout" 2>/dev/null)"; [ -n "$_prev" ] || _prev=0
  set_layout_idx "$_prev"
  rm -f "${STATE}.prevlayout"
  rm -f "$STATE"
  echo "Fast Remote: OFF  (full experience restored)"
}

case "${1:-toggle}" in
  on)     fast_on ;;
  off)    fast_off ;;
  status) [ -f "$STATE" ] && echo "on" || echo "off" ;;
  toggle) [ -f "$STATE" ] && fast_off || fast_on ;;
  *) echo "usage: moos-fast-remote {on|off|toggle|status}" >&2; exit 2 ;;
esac
