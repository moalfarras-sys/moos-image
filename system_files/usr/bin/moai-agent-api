}
CONFIG_WRITE_LOCK = threading.RLock()
TASK_RUNNER_LOCK = threading.RLock()
TASK_RUNNERS: dict[str, subprocess.Popen] = {}

# Cloud providers Mo AI already knows about, kept identical so the two settings
# surfaces never disagree about what "cloud" means.
# `api` must be one of OpenClaw's wire protocols. "openai" alone is REJECTED —
# the schema wants the specific dialect, and the error names the whole allowed
# list, so read it if you add a provider here.
PROVIDERS = [
    {"id": "synterolink", "name": "Synterolink", "base": "https://api.synterolink.com/v1",
