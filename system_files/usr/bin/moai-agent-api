PROVIDER_API = {p["id"]: p["api"] for p in PROVIDERS}


# ── permission tiers ────────────────────────────────────────────────────
# These are OpenClaw's OWN enforcement knobs, not a layer we invented on top:
#
#   agents.defaults.elevatedDefault           off | ask | full
#   agents.defaults.sandbox.workspaceAccess   none | ro | rw
#   agents.defaults.sandbox.mode              all | off
#   approvals.exec.enabled + mode=session     prompt lands in the origin chat
#
# The DECISIVE knob for "control the real computer" is sandbox.mode. With
# mode="all" every tool call runs inside a throwaway podman container — the
# agent can read/write its workspace but can NEVER touch the host session, so
# no camera, no launching apps, no reboot, no host terminal. mode="off" runs
# tool calls as the gateway user ON THE HOST, which is what makes a Telegram
# request able to open the camera, run a terminal command, update the system,
# or work on a project. That reach is exactly why "off" is gated behind an
# explicit, per-user choice here and is NEVER the shipped default.
#
# "ask" with approvals forwarding is what makes phone approval work: the agent
# stops, Telegram shows the exact command, and nothing runs until you tap yes.
#
# Only the owner can drive any of this — channels.telegram.allowFrom is the
# hard boundary; a non-allowlisted sender is dropped before the agent ever runs.
TIERS = {
    # معطّل — يردّ ويحلّل داخل الحاوية فقط، لا يتحكّم بالجهاز إطلاقاً.
    # (disabled) sandboxed, exec denied — replies/analyses but reaches nothing.
    "read": {
        "elevated": "off",
        "workspace": "ro",
        "approvals": False,
        "sandbox": "all",
        "exec_security": "deny",
        "exec_ask": "off",
        "deny": ["group:web", "browser", "exec"],
    },
    # تعديل مشروع — كتابة داخل workspace المعزول، بلا وصول إلى جلسة المضيف.
    "project": {
        "elevated": "off",
        "workspace": "rw",
        "approvals": False,
        "sandbox": "all",
        "exec_security": "full",
        "exec_ask": "off",
        "deny": ["group:web", "browser"],
    },
    # تحكّم بالنظام — وصول حقيقي، وكل أمر يحتاج موافقة من القناة الأصلية.
    "system": {
        "elevated": "ask",
        "workspace": "rw",
        "approvals": True,
        "sandbox": "off",
        "exec_security": "allowlist",
        "exec_ask": "always",
        "deny": ["group:web", "browser"],
    },
    # كامل — تحكّم حقيقي بالجهاز وينفّذ فوراً بلا سؤال. الأقوى والأخطر.
    # (full) HOST reach, no prompt. Owner-only, still — but nothing is withheld.
    "full": {
        "elevated": "full",
        "workspace": "rw",
        "approvals": False,
        "sandbox": "off",
        "exec_security": "full",
        "exec_ask": "off",
        "deny": [],
    },
}

TOKEN_RE = re.compile(r"^\d{6,}:[A-Za-z0-9_-]{30,}$")


def sh(argv: list[str], timeout: int = 20) -> str:
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=ENV)
        return (p.stdout or "").strip()
    except Exception:
        return ""


def command_ok(argv: list[str], timeout: int = 20,
               extra_env: dict[str, str] | None = None) -> bool:
    try:
        p = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout,
            env={**ENV, **(extra_env or {})},
        )
        return p.returncode == 0
    except Exception:
        return False


def _fsync_dir(directory: Path) -> None:
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _atomic_bytes(path: Path, payload: bytes, mode: int = 0o600,
                  parent_mode: int = 0o700) -> None:
    path.parent.mkdir(mode=parent_mode, parents=True, exist_ok=True)
    os.chmod(path.parent, parent_mode)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
        _fsync_dir(path.parent)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def _json_bytes(value: dict) -> bytes:
    return (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def load_cfg() -> dict:
    try:
        return json.loads(OC_CFG.read_text(encoding="utf-8"))
    except Exception:
        return {}


def validate_config_file(path: Path) -> None:
    """Validate a staged file with the installed pinned OpenClaw, when present."""
    binary = Path(BIN)
    if not binary.is_file() or not os.access(binary, os.X_OK):
        return
    if not command_ok(
        [BIN, "config", "validate", "--json"],
        60,
        {"OPENCLAW_CONFIG_PATH": str(path)},
    ):
        # Never reflect validator output: it may contain credential-bearing config.
        raise ValueError("رفض OpenClaw الإعداد الجديد؛ لم يُحفظ أي تغيير")


def save_cfg(cfg: dict, *, validate: bool = True) -> None:
    with CONFIG_WRITE_LOCK:
        OC_CFG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(OC_CFG.parent, 0o700)
        fd, tmp_name = tempfile.mkstemp(prefix=".openclaw.json.", dir=OC_CFG.parent)
        tmp = Path(tmp_name)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(_json_bytes(cfg))
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp, 0o600)
            if validate:
                validate_config_file(tmp)
            os.replace(tmp, OC_CFG)
            _fsync_dir(OC_CFG.parent)
        finally:
            try:
                tmp.unlink()
            except FileNotFoundError:
                pass


def load_state() -> dict:
    for path in (STATE, LEGACY_STATE):
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if not isinstance(value, dict):
            continue
        if path == LEGACY_STATE and not STATE.exists():
            # Preserve the old file as a fallback, but atomically establish the
            # new product-named path so all future writes leave MOAPP behind.
            save_state(value)
        return value
    return {}


def save_state(st: dict) -> None:
    with CONFIG_WRITE_LOCK:
        _atomic_bytes(STATE, _json_bytes(st))


def load_workspace() -> dict:
    """Read Mo AI-owned metadata without extending OpenClaw's strict schema."""
    try:
        value = json.loads(WORKSPACE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"version": 1, "sessions": {}, "projects": {}, "tasks": {},
                "attachments": {}}
    except Exception as exc:
        raise ValueError(f"could not read Mo AI workspace metadata: {exc}") from exc
    if not isinstance(value, dict) or value.get("version") != 1:
        raise ValueError("unsupported Mo AI workspace metadata")
    for key in ("sessions", "projects", "tasks", "attachments"):
        if not isinstance(value.get(key, {}), dict):
            raise ValueError(f"workspace field {key!r} must be an object")
        value.setdefault(key, {})
    return value


def save_workspace(workspace: dict) -> None:
    with CONFIG_WRITE_LOCK:
        _atomic_bytes(WORKSPACE, _json_bytes(workspace))


def unit_active(name: str) -> bool:
    return sh(["systemctl", "--user", "is-active", name], 8) == "active"


def selected_engine() -> dict:
    unit = sh([str(ENGINE_HELPER), "unit"], 8)
    existing = [
        name for name, spec in ENGINE_UNITS.items()
        if (QUADLET_DIR / spec["quadlet"]).is_file()
    ]
    if len(existing) > 1:
        return {
            "unit": unit if unit in ENGINE_UNITS else "",
            "configured": False, "conflict": True,
        }
    spec = ENGINE_UNITS.get(unit)
    if not spec:
        return {"unit": unit, "configured": False, "conflict": False}
    return {
        "unit": unit,
        **spec,
        "quadlet_path": str(QUADLET_DIR / spec["quadlet"]),
        "configured": (QUADLET_DIR / spec["quadlet"]).is_file(),
        "conflict": False,
    }


def selected_speech() -> dict:
    present = [
        (unit, spec) for unit, spec in SPEECH_UNITS.items()
        if (QUADLET_DIR / spec["quadlet"]).is_file()
    ]
    if len(present) > 1:
        return {"unit": "", "configured": False, "conflict": True}
    if not present:
        return {"unit": "", "configured": False, "conflict": False}
    unit, spec = present[0]
    return {
        "unit": unit,
        **spec,
        "quadlet_path": str(QUADLET_DIR / spec["quadlet"]),
        "configured": True,
        "conflict": False,
    }


# ── status ──────────────────────────────────────────────────────────────

def status() -> dict:
    engine = selected_engine()
    speech = selected_speech()
    engine_active = bool(
        engine.get("configured") and unit_active(engine.get("unit", "")))
    speech_active = bool(
        speech.get("configured") and unit_active(speech.get("unit", "")))

    gpu = sh(["nvidia-smi", "--query-gpu=memory.used,memory.total,temperature.gpu",
              "--format=csv,noheader,nounits"], 8)
    used = total = temp = 0
    if gpu:
        parts = [p.strip() for p in gpu.split(",")]
        if len(parts) >= 3:
            used, total, temp = (int(float(x)) for x in parts[:3])

    loaded = None
    if engine_active:
        ps = sh(["podman", "exec", engine["container"], "ollama", "ps"], 10)
        for line in ps.splitlines()[1:]:
            f = line.split()
            if len(f) >= 5:
                loaded = {
                    "name": f[0],
                    "size": f"{f[1]} {f[2]}" if not f[1][0].isdigit() else f[1],
                    "processor": " ".join(f[3:5]),
                }
                break

    cfg = load_cfg()
    primary = _primary(cfg)

    return {
        "services": {
            "ollama": engine_active,
            "gateway": unit_active("openclaw-gateway.service"),
            "speaches": speech_active,
            "moai": unit_active("moai-gateway.service"),
        },
        "openclaw_installed": Path(BIN).is_file() and os.access(BIN, os.X_OK),
        "openclaw_configured": _openclaw_configured(cfg, primary),
        "brain_configured": bool(engine.get("configured")),
        "speech_configured": bool(
            speech.get("configured") and TRANSCRIBE.is_file()
            and os.access(TRANSCRIBE, os.X_OK)),
        "selected_engine": engine,
        "selected_speech": speech,
        "gpu": {"used": used, "total": total, "temp": temp},
        "model": loaded,
        "ts": int(time.time()),
    }


def capabilities() -> dict:
    """Machine-readable product contract; read-only and does not wake services."""
    cfg = load_cfg()
    st = load_state()
    tier = _actual_tier(cfg) or st.get("tier", "read")
    return {
        "schema": 1,
        "workspace": {
            "sessions": True, "projects": True, "tasks": True,
            "attachments": {"images": True, "text": True, "binary_extract": False},
        },
        "agent": {
            "installed": Path(BIN).is_file() and os.access(BIN, os.X_OK),
            "task_execution": True,
            "permission_tiers": list(TIERS),
            "active_tier": tier if tier in TIERS else "read",
        },
        "terminal": {"pty": True, "tabs": True, "model_access": False},
        "voice": {"push_to_talk": PW_RECORD.is_file(),
                  "transcription": TRANSCRIBE.is_file()},
        "channels": {"telegram": True, "whatsapp": True,
                     "shared_openclaw_sessions": True},
        "brains": {"local": True, "cloud": True, "hybrid": True},
    }


# ── config ──────────────────────────────────────────────────────────────

def _primary(cfg: dict) -> str:
    return str(
        (((cfg.get("agents") or {}).get("defaults") or {}).get("model") or {})
        .get("primary") or ""
    ).strip()


def _primary_mode(primary: str) -> str:
    return "cloud" if primary.startswith("cloud/") else "local"


def _model_from_primary(primary: str, provider: str) -> str:
    prefix = provider + "/"
    return primary[len(prefix):] if primary.startswith(prefix) else ""


def _clean_model(value, field: str = "model") -> str:
    model = str(value or "").strip()
    if not model or len(model) > 256 or any(ord(ch) < 32 for ch in model):
        raise ValueError(f"{field} غير صالح")
    if model.startswith("/") or model.endswith("/"):
        raise ValueError(f"{field} غير صالح")
    return model


def _upsert_model(provider: dict, model_id: str) -> None:
    models = provider.setdefault("models", [])
    if not isinstance(models, list):
        raise ValueError("قائمة نماذج المزوّد غير صالحة")
    for item in models:
        if isinstance(item, dict) and item.get("id") == model_id:
            item.setdefault("name", model_id)
            return
    models.append({"id": model_id, "name": model_id})


def _valid_base(value: str) -> str:
    base = str(value or "").strip().rstrip("/")
    try:
        parsed = urllib.parse.urlsplit(base)
    except ValueError as exc:
        raise ValueError("عنوان المزوّد غير صالح") from exc
    if parsed.scheme not in ("http", "https") or not parsed.hostname \
            or parsed.username is not None or parsed.password is not None \
            or parsed.query or parsed.fragment:
        raise ValueError("عنوان المزوّد يجب أن يكون HTTP(S) بلا بيانات دخول أو استعلام")
    return base


def _openclaw_configured(cfg: dict, primary: str | None = None) -> bool:
    primary = primary if primary is not None else _primary(cfg)
    if "/" not in primary:
        return False
    provider_id, model_id = primary.split("/", 1)
    if provider_id not in ("ollama", "cloud") or not model_id:
        return False
    node = (((cfg.get("models") or {}).get("providers") or {}).get(provider_id) or {})
    models = node.get("models") or []
    has_model = any(
        isinstance(item, dict) and item.get("id") == model_id
        for item in models
    )
    if not node.get("baseUrl") or not node.get("api") or not has_model:
        return False
    return provider_id != "cloud" or bool(node.get("apiKey"))


def _actual_tier(cfg: dict) -> str:
    defaults = ((cfg.get("agents") or {}).get("defaults") or {})
    sandbox = defaults.get("sandbox") or {}
    tools_exec = ((cfg.get("tools") or {}).get("exec") or {})
    approvals = ((cfg.get("approvals") or {}).get("exec") or {})
    for name, tier in TIERS.items():
        if (
            tools_exec.get("security", "deny") == tier["exec_security"]
            and tools_exec.get("ask", "off") == tier["exec_ask"]
            and defaults.get("elevatedDefault", "off") == tier["elevated"]
            and sandbox.get("workspaceAccess", "ro") == tier["workspace"]
            and sandbox.get("mode", "all") == tier["sandbox"]
            and bool(approvals.get("enabled")) == tier["approvals"]
        ):
            return name
    return "read"


def _keep_alive(engine: dict) -> str:
    if not engine.get("configured"):
        return "15m"
    try:
        text = Path(engine["quadlet_path"]).read_text(encoding="utf-8")
        match = re.search(r"^Environment=OLLAMA_KEEP_ALIVE=(\S+)", text, re.M)
        return match.group(1) if match else "15m"
    except Exception:
        return "15m"


def read_config() -> dict:
    c = load_cfg()
    st = load_state()
    prov = (c.get("models", {}).get("providers", {}) or {})
    agents = c.get("agents", {}).get("defaults", {}) or {}
    tg = c.get("channels", {}).get("telegram", {}) or {}
    tts = c.get("messages", {}).get("tts", {}) or {}
    primary = _primary(c)
    mode = _primary_mode(primary)
    deny = ((c.get("tools", {}).get("byProvider", {}) or {})
            .get(primary, {}) or {}).get("deny", [])
    engine = selected_engine()
    speech = selected_speech()

    cloud = prov.get("cloud", {}) or {}
    media_audio = (((c.get("tools") or {}).get("media") or {}).get("audio") or {})
    media_models = media_audio.get("models") or []
    local_model = (
        primary if primary.startswith("ollama/")
        else str(st.get("local_model") or "ollama/default")
    )
    if not local_model.startswith("ollama/"):
        local_model = "ollama/" + local_model
    cloud_model = (
        _model_from_primary(primary, "cloud")
        if mode == "cloud"
        else str(st.get("cloud_model") or "")
    )
    return {
        "brain": {
            "mode": mode,
            "local_model": local_model,
            "context": agents.get("contextTokens", 14336),
            "thinking": agents.get("thinkingDefault", "off"),
        },
        "cloud": {
            "provider": st.get("provider", "synterolink"),
            "base": cloud.get("baseUrl", ""),
            "model": cloud_model,
            "has_key": bool(cloud.get("apiKey")),
        },
        "telegram": {
            "enabled": bool(tg.get("enabled")),
            "has_token": bool(tg.get("botToken")),
            "policy": tg.get("dmPolicy", "pairing"),
            "allow": tg.get("allowFrom", []),
        },
        "voice": {
            "tts_enabled": bool(tts.get("enabled")),
            "tts_auto": tts.get("auto", "inbound"),
            "stt_on": bool(
                media_audio.get("enabled", True)
                and any(
                    isinstance(item, dict) and item.get("command")
                    for item in media_models
                )
            ),
            "machine_configured": bool(
                speech.get("configured") and TRANSCRIBE.is_file()
                and os.access(TRANSCRIBE, os.X_OK)),
        },
        "power": {
            "keep_alive": _keep_alive(engine),
            "engine_configured": bool(engine.get("configured")),
        },
        "permissions": {
            # Safe default when nothing is set yet: sandboxed, no host reach.
            "tier": _actual_tier(c),
            "web": "group:web" not in deny,
            "exec": ((c.get("tools", {}).get("exec", {}) or {})
                     .get("security", "deny")) != "deny",
            "workspace": ((agents.get("sandbox", {}) or {}).get("workspaceAccess", "ro")),
            # The host/container switch, surfaced so the UI can show it plainly.
            "sandbox": ((agents.get("sandbox", {}) or {}).get("mode", "all")),
            "host_control": ((agents.get("sandbox", {}) or {}).get("mode", "all")) == "off",
            "elevated": agents.get("elevatedDefault", "off"),
            "approvals": bool(((c.get("approvals", {}) or {}).get("exec", {}) or {}).get("enabled")),
            "project": agents.get("workspace", st.get("project", "")),
        },
        "providers": PROVIDERS,
        "tiers": list(TIERS.keys()),
    }


def _restore(path: Path, before: bytes | None, mode: int) -> None:
    if before is None:
        try:
            path.unlink()
            _fsync_dir(path.parent)
        except FileNotFoundError:
            pass
    else:
        _atomic_bytes(path, before, mode)


def _quadlet_with_keep_alive(text: str, keep_alive: str) -> str:
    line = f"Environment=OLLAMA_KEEP_ALIVE={keep_alive}"
    if re.search(r"^Environment=OLLAMA_KEEP_ALIVE=.*$", text, re.M):
        return re.sub(r"^Environment=OLLAMA_KEEP_ALIVE=.*$", line, text, flags=re.M)
    if "[Container]" not in text:
        raise ValueError("ملف محرك النماذج لا يحتوي قسم [Container]")
    return text.replace("[Container]", "[Container]\n" + line, 1)


def write_config(body: dict) -> dict:
    """Validate, atomically commit, and truthfully activate one config update."""
    with CONFIG_WRITE_LOCK:
        c = load_cfg()
        st = load_state()
        original_c = copy.deepcopy(c)
        original_st = copy.deepcopy(st)
        original_primary = _primary(c)
        restart: set[str] = set()
        started: set[str] = set()

        # ── cloud provider + write-only key ──
        cl = body.get("cloud") or {}
        if not isinstance(cl, dict):
            raise ValueError("إعداد المزوّد غير صالح")
        if cl:
            provider_id = str(cl.get("provider") or st.get("provider")
                              or "synterolink")
            if provider_id not in PROVIDER_API:
                raise ValueError("المزوّد غير معروف")
            st["provider"] = provider_id
            providers = c.setdefault("models", {}).setdefault("providers", {})
            node = providers.setdefault("cloud", {})
            if "base" in cl and str(cl.get("base") or "").strip():
                node["baseUrl"] = _valid_base(cl["base"])
            if "model" in cl and str(cl.get("model") or "").strip():
                cloud_model = _clean_model(cl["model"], "نموذج السحابة")
                st["cloud_model"] = cloud_model
                _upsert_model(node, cloud_model)
            key = cl.get("key")
            if key == "__clear__":
                node.pop("apiKey", None)
            elif key:
                node["apiKey"] = str(key)
            node["api"] = PROVIDER_API[provider_id]

        # ── the real primary, never a UI-only hybrid flag ──
        if "mode" in body:
            mode = str(body["mode"])
            if mode not in ("local", "cloud"):
                raise ValueError("الوضع يجب أن يكون محلياً أو سحابياً فقط")
            defaults = c.setdefault("agents", {}).setdefault("defaults", {})
            model_node = defaults.setdefault("model", {})
            providers = c.setdefault("models", {}).setdefault("providers", {})
            if mode == "local":
                saved_local = str(st.get("local_model") or "ollama/default")
                raw_local = body.get("local_model") or saved_local
                local_id = _clean_model(
                    str(raw_local).removeprefix("ollama/"), "النموذج المحلي")
                ollama = providers.setdefault("ollama", {})
                ollama.setdefault("baseUrl", "http://127.0.0.1:11434")
                ollama.setdefault("apiKey", "ollama-local")
                ollama.setdefault("api", "ollama")
                _upsert_model(ollama, local_id)
                new_primary = f"ollama/{local_id}"
                st["local_model"] = new_primary
            else:
                cloud = providers.setdefault("cloud", {})
                cloud_id = _clean_model(
                    cl.get("model") or st.get("cloud_model"), "نموذج السحابة")
                if not cloud.get("baseUrl"):
                    raise ValueError("اضبط عنوان المزوّد قبل اختيار الوضع السحابي")
                if not cloud.get("apiKey"):
                    raise ValueError("اضبط مفتاح API قبل اختيار الوضع السحابي")
                _upsert_model(cloud, cloud_id)
                new_primary = f"cloud/{cloud_id}"
                st["cloud_model"] = cloud_id
            model_node["primary"] = new_primary
            st["mode"] = mode  # migration breadcrumb; reads use primary only.
            if original_primary and original_primary != new_primary:
                policies = c.setdefault("tools", {}).setdefault("byProvider", {})
                if new_primary not in policies and original_primary in policies:
                    policies[new_primary] = copy.deepcopy(policies[original_primary])
            restart.add("openclaw-gateway.service")

        # ── telegram ──
        tg_in = body.get("telegram") or {}
        if not isinstance(tg_in, dict):
            raise ValueError("إعداد تليجرام غير صالح")
        if tg_in:
            tg = c.setdefault("channels", {}).setdefault("telegram", {})
            tok = tg_in.get("token")
            if tok:
                if not TOKEN_RE.match(str(tok)):
                    raise ValueError("شكل توكن البوت غير صحيح")
                tg["botToken"] = str(tok)
            if "enabled" in tg_in:
                tg["enabled"] = bool(tg_in["enabled"])
            allow = tg_in.get("allow")
            if allow is not None:
                if not isinstance(allow, list):
                    raise ValueError("قائمة تليجرام غير صالحة")
                ids = [str(a).strip() for a in allow if str(a).strip().isdigit()]
                tg["allowFrom"] = ids
                tg["dmPolicy"] = "allowlist" if ids else "pairing"
            tg.setdefault("groups", {"*": {"requireMention": True}})
            restart.add("openclaw-gateway.service")

        # ── voice ──
        voice = body.get("voice") or {}
        if not isinstance(voice, dict):
            raise ValueError("إعداد الصوت غير صالح")
        speech = selected_speech()
        if voice:
            tts = c.setdefault("messages", {}).setdefault("tts", {})
            enabled = bool(voice.get("tts_enabled", tts.get("enabled", False)))
            auto = voice.get("tts_auto", tts.get("auto", "inbound"))
            if auto not in ("inbound", "always", "off", "tagged"):
                raise ValueError("وضع النطق غير صالح")
            if enabled and not (
                speech.get("configured") and TRANSCRIBE.is_file()
                and os.access(TRANSCRIBE, os.X_OK)
            ):
                raise ValueError("محرك الصوت غير مُعدّ؛ شغّل «تجهيز العقل المحلي» أولاً")
            tts.update({
                "enabled": enabled, "auto": auto, "mode": "final",
                "provider": "openai", "maxTextLength": 600, "timeoutMs": 120000,
            })
            tts.setdefault("providers", {})["openai"] = dict(SPEACHES_TTS)
            # OpenClaw retired `audio.transcription`; voice notes now enter via
            # tools.media.audio.models. Preserve a user's existing media model
            # order and append MoOS's local CLI only when it is not present.
            legacy_audio = c.get("audio")
            if isinstance(legacy_audio, dict):
                legacy_audio.pop("transcription", None)
                if not legacy_audio:
                    c.pop("audio", None)
            media_audio = (
                c.setdefault("tools", {})
                .setdefault("media", {})
                .setdefault("audio", {})
            )
            media_audio["enabled"] = True
            media_models = media_audio.setdefault("models", [])
            if not isinstance(media_models, list):
                raise ValueError("قائمة نماذج تفريغ الصوت غير صالحة")
            if not any(
                isinstance(item, dict)
                and item.get("type") == "cli"
                and item.get("command") == AUDIO_TRANSCRIBER["command"]
                for item in media_models
            ):
                media_models.append(dict(AUDIO_TRANSCRIBER))
            restart.add("openclaw-gateway.service")

        # ── permissions ──
        permissions = body.get("permissions") or {}
        if not isinstance(permissions, dict):
            raise ValueError("إعداد الصلاحيات غير صالح")
        tier = permissions.get("tier")
        if tier == "ask":  # upgrade compatibility with the retired three-tier UI
            tier = "system"
        if tier is not None and tier not in TIERS:
            raise ValueError("مستوى الصلاحيات غير معروف")
        if tier in TIERS:
            selected = TIERS[tier]
            st["tier"] = tier
            defaults = c.setdefault("agents", {}).setdefault("defaults", {})
            defaults["elevatedDefault"] = selected["elevated"]
            sandbox = defaults.setdefault("sandbox", {})
            sandbox["workspaceAccess"] = selected["workspace"]
            sandbox["mode"] = selected["sandbox"]
            defaults.pop("instructions", None)
            approvals = c.setdefault("approvals", {}).setdefault("exec", {})
            approvals["enabled"] = selected["approvals"]
            if selected["approvals"]:
                approvals["mode"] = "session"
            else:
                approvals.pop("mode", None)
            exec_policy = c.setdefault("tools", {}).setdefault("exec", {})
            exec_policy.pop("mode", None)
            exec_policy["security"] = selected["exec_security"]
            exec_policy["ask"] = selected["exec_ask"]
            primary = _primary(c)
            if primary:
                provider_policy = (
                    c.setdefault("tools", {}).setdefault("byProvider", {})
                    .setdefault(primary, {})
                )
                provider_policy["deny"] = list(selected["deny"])
            restart.add("openclaw-gateway.service")

        project = permissions.get("project")
        if project is not None:
            project = str(project).strip()
            defaults = c.setdefault("agents", {}).setdefault("defaults", {})
            if project:
                candidate = Path(project).expanduser()
                if not candidate.is_absolute():
                    raise ValueError("مجلد المشروع يجب أن يكون مساراً مطلقاً داخل مجلد المنزل")
                try:
                    home_real = HOME.resolve(strict=True)
                    resolved = candidate.resolve(strict=True)
                except OSError as exc:
                    raise ValueError("المجلد غير موجود") from exc
                if not resolved.is_dir() or (
                    resolved != home_real and home_real not in resolved.parents
                ):
                    raise ValueError("مجلد المشروع يجب أن يكون داخل مجلد المنزل الحقيقي")
                st["project"] = str(resolved)
                defaults["workspace"] = str(resolved)
            else:
                st.pop("project", None)
                defaults.pop("workspace", None)
            restart.add("openclaw-gateway.service")

        if "web" in permissions:
            primary = _primary(c)
            if not primary:
                raise ValueError("اضبط النموذج الأساسي قبل صلاحية الإنترنت")
            policy = (c.setdefault("tools", {}).setdefault("byProvider", {})
                      .setdefault(primary, {}))
            if permissions["web"]:
                policy["deny"] = [
                    item for item in policy.get("deny", [])
                    if item not in ("group:web", "browser")
                ]
            else:
                policy["deny"] = sorted(
                    set(policy.get("deny", [])) | {"group:web", "browser"})
            restart.add("openclaw-gateway.service")

        # ── power: stage the selected fixed Quadlet, never a hard-coded rival ──
        power = body.get("power") or {}
        if not isinstance(power, dict):
            raise ValueError("إعداد الطاقة غير صالح")
        quadlet_path: Path | None = None
        quadlet_new: bytes | None = None
        keep_alive = power.get("keep_alive")
        if keep_alive is not None:
            keep_alive = str(keep_alive)
            if not re.fullmatch(r"-1|\d+[ms]", keep_alive):
                raise ValueError("مدة إبقاء النموذج غير صالحة")
            engine = selected_engine()
            if not engine.get("configured"):
                raise ValueError("محرك النماذج غير مُعدّ أو توجد إعدادات متعارضة")
            quadlet_path = Path(engine["quadlet_path"])
            original_text = quadlet_path.read_text(encoding="utf-8")
            updated_text = _quadlet_with_keep_alive(original_text, keep_alive)
            if updated_text != original_text:
                quadlet_new = updated_text.encode("utf-8")
                restart.add(engine["unit"])

        cfg_changed = c != original_c
        state_changed = st != original_st
        before_cfg = OC_CFG.read_bytes() if OC_CFG.exists() else None
        before_state = STATE.read_bytes() if STATE.exists() else None
        before_quadlet = (
            quadlet_path.read_bytes() if quadlet_path and quadlet_new is not None else None
        )
        active_before = {unit: unit_active(unit) for unit in restart}

        try:
            if cfg_changed:
                save_cfg(c)
            if state_changed:
                save_state(st)
            if quadlet_path and quadlet_new is not None:
                mode = quadlet_path.stat().st_mode & 0o777
                _atomic_bytes(quadlet_path, quadlet_new, mode, 0o700)
                if not command_ok(["systemctl", "--user", "daemon-reload"], 20):
                    raise RuntimeError("تعذّرت إعادة تحميل خدمات المستخدم")

            # Enabling voice is an explicit request: start its selected fixed unit
            # and prove it active instead of merely claiming configuration success.
            if voice and bool(voice.get("tts_enabled")) \
                    and speech.get("configured") \
                    and not unit_active(speech["unit"]):
                if not command_ok(
                    ["systemctl", "--user", "start", speech["unit"]], 60
                ) or not unit_active(speech["unit"]):
                    raise RuntimeError("تعذّر تشغيل محرك الصوت")
                started.add(speech["unit"])

            restarted = []
            pending = []
            for unit in sorted(restart):
                if not active_before[unit]:
                    pending.append(unit)
                    continue
                if not command_ok(["systemctl", "--user", "restart", unit], 90) \
                        or not unit_active(unit):
                    raise RuntimeError(f"تعذّرت إعادة تشغيل {unit}")
                restarted.append(unit)
        except Exception as exc:
            # Roll back all file commits and best-effort restore the previously
            # running services. The API must never return success for a config
            # the actual gateway could not activate.
            if cfg_changed:
                _restore(OC_CFG, before_cfg, 0o600)
            if state_changed:
                _restore(STATE, before_state, 0o600)
            if quadlet_path and quadlet_new is not None:
                _restore(quadlet_path, before_quadlet, 0o644)
                command_ok(["systemctl", "--user", "daemon-reload"], 20)
            for unit in started:
                command_ok(["systemctl", "--user", "stop", unit], 30)
            for unit, was_active in active_before.items():
                if was_active:
                    command_ok(["systemctl", "--user", "restart", unit], 90)
            if isinstance(exc, ValueError):
                raise
            raise ValueError(
                f"لم يُفعّل التغيير وأُعيد الإعداد السابق: {exc}"
            ) from exc

        return {
            "ok": True,
            "restarted": restarted,
            "restart_pending": pending,
            "started": sorted(started),
        }


# ── workspace: projects and tasks ───────────────────────────────────────

TASK_STATES = {"pending", "running", "paused", "failed", "completed", "cancelled"}
STEP_STATES = {"pending", "running", "completed", "failed", "skipped"}
TERMINAL_ID_RE = re.compile(r"^[0-9a-f-]{36}$")


def _home_directory(value: str) -> Path:
    try:
        home_real = HOME.resolve(strict=True)
        resolved = Path(str(value or "")).expanduser().resolve(strict=True)
    except OSError as exc:
        raise ValueError("project path does not exist") from exc
    if not resolved.is_dir() or (resolved != home_real and home_real not in resolved.parents):
        raise ValueError("project must be inside the real home directory")
    return resolved


def list_projects(include_archived: bool = False) -> list[dict]:
    values = []
    for project in load_workspace()["projects"].values():
        if not isinstance(project, dict):
            continue
        if project.get("archived") and not include_archived:
            continue
        values.append(project)
    return sorted(values, key=lambda p: (not p.get("pinned", False),
                                          -int(p.get("updated", 0))))


def upsert_project(body: dict) -> dict:
    allowed = {"id", "name", "path", "pinned", "archived"}
    unknown = set(body) - allowed
    if unknown:
        raise ValueError("unknown project metadata: " + ", ".join(sorted(unknown)))
    resolved = _home_directory(str(body.get("path") or ""))
    project_id = hashlib.sha256(str(resolved).encode()).hexdigest()[:20]
    supplied = str(body.get("id") or "")
    if supplied and supplied != project_id:
        raise ValueError("project id does not match its canonical path")
    workspace = load_workspace()
    current = workspace["projects"].get(project_id, {})
    now = int(time.time())
    name = str(body.get("name") or current.get("name") or resolved.name or resolved).strip()
    if not name or len(name) > 120 or any(ord(ch) < 32 for ch in name):
        raise ValueError("invalid project name")
    project = {
        "id": project_id,
        "name": name,
        "path": str(resolved),
        "pinned": bool(body.get("pinned", current.get("pinned", False))),
        "archived": bool(body.get("archived", current.get("archived", False))),
        "created": int(current.get("created", now)),
        "updated": now,
    }
    workspace["projects"][project_id] = project
    save_workspace(workspace)
    return {"ok": True, **project}


def list_tasks(project: str = "", state: str = "") -> list[dict]:
    if state and state not in TASK_STATES:
        raise ValueError("invalid task state")
    out = []
    for task in load_workspace()["tasks"].values():
        if not isinstance(task, dict):
            continue
        if project and task.get("project") != project:
            continue
        if state and task.get("status") != state:
            continue
        out.append(task)
    return sorted(out, key=lambda t: -int(t.get("updated", 0)))[:200]


def create_task(body: dict) -> dict:
    allowed = {"title", "description", "project", "steps"}
    unknown = set(body) - allowed
    if unknown:
        raise ValueError("unknown task fields: " + ", ".join(sorted(unknown)))
    title = str(body.get("title") or "").strip()
    description = str(body.get("description") or "").strip()
    if not title or len(title) > 160 or any(ord(ch) < 32 for ch in title):
        raise ValueError("invalid task title")
    if len(description) > 8000:
        raise ValueError("task description is too long")
    project_id = str(body.get("project") or "")
    workspace = load_workspace()
    if project_id and project_id not in workspace["projects"]:
        raise ValueError("unknown task project")
    raw_steps = body.get("steps") or []
    if not isinstance(raw_steps, list) or len(raw_steps) > 100:
        raise ValueError("invalid task steps")
    steps = []
    for index, value in enumerate(raw_steps):
        text = str(value.get("title") if isinstance(value, dict) else value).strip()
        if not text or len(text) > 300 or any(ord(ch) < 32 for ch in text):
            raise ValueError("invalid task step")
        steps.append({"id": index + 1, "title": text, "status": "pending",
                      "error": "", "result": ""})
    now = int(time.time())
    task = {
        "id": str(uuid.uuid4()), "title": title, "description": description,
        "project": project_id, "status": "pending", "steps": steps,
        "tools": [], "error": "", "result": "", "created": now, "updated": now,
    }
    workspace["tasks"][task["id"]] = task
    save_workspace(workspace)
    return {"ok": True, **task}


def update_task(body: dict) -> dict:
    allowed = {"id", "status", "step", "step_status", "error", "result", "tool"}
    unknown = set(body) - allowed
    if unknown:
        raise ValueError("unknown task update: " + ", ".join(sorted(unknown)))
    task_id = str(body.get("id") or "")
    if not re.fullmatch(r"[0-9a-f-]{36}", task_id):
        raise ValueError("invalid task id")
    workspace = load_workspace()
    task = workspace["tasks"].get(task_id)
    if not isinstance(task, dict):
        raise ValueError("task does not exist")
    status_value = body.get("status")
    if status_value is not None:
        if status_value not in TASK_STATES:
            raise ValueError("invalid task state")
        task["status"] = status_value
    if "step" in body:
        try:
            step_id = int(body["step"])
        except (TypeError, ValueError) as exc:
            raise ValueError("invalid task step id") from exc
        matches = [step for step in task.get("steps", []) if step.get("id") == step_id]
        if len(matches) != 1 or body.get("step_status") not in STEP_STATES:
            raise ValueError("invalid task step update")
        matches[0]["status"] = body["step_status"]
        if "error" in body:
            matches[0]["error"] = str(body.get("error") or "")[:2000]
        if "result" in body:
            matches[0]["result"] = str(body.get("result") or "")[:8000]
    else:
        if "error" in body:
            task["error"] = str(body.get("error") or "")[:2000]
        if "result" in body:
            task["result"] = str(body.get("result") or "")[:8000]
    if "tool" in body:
        tool = str(body.get("tool") or "").strip()
        if not tool or len(tool) > 120:
            raise ValueError("invalid task tool")
        task.setdefault("tools", []).append({"name": tool, "ts": int(time.time())})
        task["tools"] = task["tools"][-200:]
    task["updated"] = int(time.time())
    save_workspace(workspace)
    return {"ok": True, **task}


def _task_prompt(task: dict, project: dict | None) -> str:
    """Build fixed execution context; the UI never supplies a command/executable."""
    lines = [
        "You are executing a tracked Mo AI task. Work carefully and report only real results.",
        f"Task: {task['title']}",
    ]
    if task.get("description"):
        lines.append(f"Description: {task['description']}")
    if project:
        lines.extend([
            f"Project name: {project['name']}",
            f"Canonical project directory: {project['path']}",
            "Stay inside that project unless the active permission policy explicitly allows more.",
        ])
    steps = task.get("steps") or []
    if steps:
        lines.append("Requested steps:")
        lines.extend(f"{step['id']}. {step['title']}" for step in steps)
    lines.append("Inspect first, make the smallest sound changes, run relevant tests, then summarize evidence.")
    return "\n".join(lines)


def _task_session_tools(task_id: str) -> list[str]:
    """Read actual tool-call names from the task's OpenClaw JSONL session."""
    try:
        index = json.loads((SESSIONS / "sessions.json").read_text(encoding="utf-8"))
    except Exception:
        return []
    session_id = ""
    expected = f"moai-task-{task_id}"
    for key, value in index.items() if isinstance(index, dict) else []:
        if str(key).split(":")[-1] == expected and isinstance(value, dict):
            session_id = str(value.get("sessionId") or "")
            break
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", session_id):
        return []
    names = []
    try:
        lines = (SESSIONS / f"{session_id}.jsonl").read_text(
            encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []
    for line in lines:
        try:
            message = (json.loads(line).get("message") or {})
        except Exception:
            continue
        content = message.get("content") or []
        if not isinstance(content, list):
            content = []
        for block in content:
            if not isinstance(block, dict):
                continue
            kind = str(block.get("type") or "").lower().replace("_", "")
            if kind not in {"toolcall", "tooluse"}:
                continue
            name = str(block.get("name") or block.get("toolName") or "").strip()
            if name and len(name) <= 120 and name not in names:
                names.append(name)
    return names[:100]


def _finish_task(task_id: str, process: subprocess.Popen) -> None:
    try:
        stdout, stderr = process.communicate(timeout=3600)
        output = (stdout or "").strip()
        error = (stderr or "").strip()
        current = next((t for t in list_tasks() if t.get("id") == task_id), None)
        if current and current.get("status") == "cancelled":
            return
        for tool in _task_session_tools(task_id):
            update_task({"id": task_id, "tool": tool})
        if process.returncode == 0:
            for step in (current or {}).get("steps", []):
                if step.get("status") in {"pending", "running"}:
                    update_task({"id": task_id, "step": step["id"],
                                 "step_status": "completed",
                                 "result": "Completed by the agent run."})
            update_task({"id": task_id, "status": "completed",
                         "result": output[-8000:] or "Agent completed without a text summary."})
        else:
            detail = error or output or f"OpenClaw exited with status {process.returncode}"
            update_task({"id": task_id, "status": "failed", "error": detail[-2000:]})
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGTERM)
            process.wait(timeout=5)
        except Exception:
            pass
        update_task({"id": task_id, "status": "failed",
                     "error": "Agent execution exceeded the one-hour safety limit."})
    except Exception as exc:
        update_task({"id": task_id, "status": "failed", "error": str(exc)[:2000]})
    finally:
        with TASK_RUNNER_LOCK:
            if TASK_RUNNERS.get(task_id) is process:
                TASK_RUNNERS.pop(task_id, None)


def task_action(body: dict) -> dict:
    """Control one tracked OpenClaw process without accepting arbitrary commands."""
    if set(body) != {"id", "action"}:
        raise ValueError("task action accepts only id and action")
    task_id = str(body.get("id") or "")
    action = str(body.get("action") or "")
    if not re.fullmatch(r"[0-9a-f-]{36}", task_id):
        raise ValueError("invalid task id")
    if action not in {"start", "pause", "resume", "cancel"}:
        raise ValueError("invalid task action")
    workspace = load_workspace()
    task = workspace["tasks"].get(task_id)
    if not isinstance(task, dict):
        raise ValueError("task does not exist")
    with TASK_RUNNER_LOCK:
        process = TASK_RUNNERS.get(task_id)
        if action == "start":
            if process and process.poll() is None:
                raise ValueError("task is already running")
            if not Path(BIN).is_file() or not os.access(BIN, os.X_OK):
                raise ValueError("OpenClaw is not installed")
            project = None
            if task.get("project"):
                project = workspace["projects"].get(task["project"])
                if not isinstance(project, dict):
                    raise ValueError("task project no longer exists")
                # Selecting a project is part of starting its task. OpenClaw then
                # enforces the currently selected read/project/system/full tier.
                write_config({"permissions": {"project": project["path"]}})
            argv = [BIN, "agent", "--session-key", f"moai-task-{task_id}",
                    "-m", _task_prompt(task, project)]
            process = subprocess.Popen(
                argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                env=ENV, start_new_session=True,
            )
            TASK_RUNNERS[task_id] = process
            update_task({"id": task_id, "status": "running", "error": "",
                         "result": "", "tool": "openclaw-agent"})
            threading.Thread(target=_finish_task, args=(task_id, process),
                             daemon=True, name=f"moai-task-{task_id[:8]}").start()
        elif not process or process.poll() is not None:
            raise ValueError("task has no live agent process")
        elif action == "pause":
            os.killpg(process.pid, signal.SIGSTOP)
            update_task({"id": task_id, "status": "paused"})
        elif action == "resume":
            os.killpg(process.pid, signal.SIGCONT)
            update_task({"id": task_id, "status": "running"})
        else:
            os.killpg(process.pid, signal.SIGTERM)
            update_task({"id": task_id, "status": "cancelled",
                         "result": "Cancelled by the user."})
    return {"ok": True, "id": task_id,
            "status": next(t["status"] for t in list_tasks() if t["id"] == task_id)}


# ── real user terminals ─────────────────────────────────────────────────

class TerminalSession:
    """One bounded PTY running the user's fixed shell without elevation."""

    def __init__(self, cwd: Path, title: str):
        self.id = str(uuid.uuid4())
        self.cwd = str(cwd)
        self.title = title[:80] or cwd.name or "Terminal"
        self.created = int(time.time())
        self.buffer = bytearray()
        self.base_offset = 0
        self.lock = threading.Lock()
        master, slave = pty.openpty()
        env = dict(os.environ)
        env.update({"TERM": "dumb", "PS1": r"moai:\w$ ", "PROMPT_COMMAND": ""})
        try:
            self.process = subprocess.Popen(
                ["/bin/bash", "--noprofile", "--norc"], cwd=cwd, env=env,
                stdin=slave, stdout=slave, stderr=slave, close_fds=True,
                start_new_session=True,
            )
        finally:
            os.close(slave)
        self.master = master
        os.set_blocking(master, False)
        self.reader = threading.Thread(target=self._read_loop, daemon=True)
        self.reader.start()

    def _read_loop(self) -> None:
        while True:
            try:
                ready, _, _ = select.select([self.master], [], [], 0.25)
                if ready:
                    chunk = os.read(self.master, 65536)
                    if chunk:
                        with self.lock:
                            self.buffer.extend(chunk)
                            if len(self.buffer) > MAX_TERMINAL_BUFFER:
                                trim = len(self.buffer) - MAX_TERMINAL_BUFFER
                                del self.buffer[:trim]
                                self.base_offset += trim
                        continue
            except (BlockingIOError, InterruptedError):
                continue
            except OSError:
                break
            if self.process.poll() is not None:
                break
        try:
            os.close(self.master)
        except OSError:
            pass

    def write(self, value: str) -> None:
        data = value.encode("utf-8")
        if not data or len(data) > MAX_TERMINAL_INPUT or "\x00" in value:
            raise ValueError("invalid terminal input")
        if self.process.poll() is not None:
            raise ValueError("terminal has exited")
        try:
            os.write(self.master, data)
        except OSError as exc:
            raise ValueError("terminal input failed") from exc

    def output(self, offset: int) -> dict:
        with self.lock:
            start = max(0, offset - self.base_offset)
            data = bytes(self.buffer[start:])
            next_offset = self.base_offset + len(self.buffer)
            truncated = offset < self.base_offset
        return {
            "id": self.id,
            "output": data.decode("utf-8", errors="replace"),
            "offset": next_offset,
            "truncated": truncated,
            "running": self.process.poll() is None,
            "exit_code": self.process.poll(),
        }

    def stop(self) -> None:
        if self.process.poll() is None:
            try:
                os.killpg(self.process.pid, signal.SIGTERM)
                self.process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
                self.process.wait(timeout=3)
            except ProcessLookupError:
                pass

    def summary(self) -> dict:
        return {"id": self.id, "title": self.title, "cwd": self.cwd,
                "created": self.created, "running": self.process.poll() is None,
                "exit_code": self.process.poll()}


TERMINAL_LOCK = threading.RLock()
TERMINALS: dict[str, TerminalSession] = {}


def _terminal(terminal_id: str) -> TerminalSession:
    if not TERMINAL_ID_RE.fullmatch(terminal_id or ""):
        raise ValueError("invalid terminal id")
    with TERMINAL_LOCK:
        session = TERMINALS.get(terminal_id)
    if session is None:
        raise ValueError("terminal does not exist")
    return session


def list_terminals() -> list[dict]:
    with TERMINAL_LOCK:
        return [session.summary() for session in TERMINALS.values()]


def start_terminal(body: dict) -> dict:
    if set(body) - {"project", "title"}:
        raise ValueError("unknown terminal option")
    project_id = str(body.get("project") or "")
    workspace = load_workspace()
    if project_id:
        project = workspace["projects"].get(project_id)
        if not isinstance(project, dict):
            raise ValueError("unknown terminal project")
        cwd = _home_directory(project.get("path", ""))
        default_title = str(project.get("name") or cwd.name)
    else:
        cwd = _home_directory(str(HOME))
        default_title = "Terminal"
    title = str(body.get("title") or default_title).strip()
    if len(title) > 80 or any(ord(ch) < 32 for ch in title):
        raise ValueError("invalid terminal title")
    session = TerminalSession(cwd, title)
    with TERMINAL_LOCK:
        TERMINALS[session.id] = session
    return {"ok": True, **session.summary()}


def write_terminal(body: dict) -> dict:
    if set(body) != {"id", "input"}:
        raise ValueError("terminal write requires id and input")
    session = _terminal(str(body.get("id") or ""))
    session.write(str(body.get("input") or ""))
    return {"ok": True, "id": session.id}


def stop_terminal(body: dict) -> dict:
    if set(body) != {"id"}:
        raise ValueError("terminal stop requires id")
    session = _terminal(str(body.get("id") or ""))
    session.stop()
    return {"ok": True, **session.summary()}


# ── private attachments ─────────────────────────────────────────────────

def _attachment_payload(meta: dict) -> dict:
    path = ATTACHMENTS / meta["stored"]
    if not path.is_file():
        raise ValueError("attachment content is missing")
    mime = str(meta.get("mime") or "application/octet-stream")
    payload = dict(meta)
    if mime.startswith("image/"):
        payload["content"] = "data:" + mime + ";base64," + base64.b64encode(
            path.read_bytes()).decode("ascii")
        payload["content_type"] = "image"
    elif mime.startswith("text/") or mime in {
        "application/json", "application/xml", "application/x-yaml",
        "application/javascript", "application/sql",
    }:
        if path.stat().st_size > MAX_TEXT_ATTACHMENT_BYTES:
            raise ValueError("text attachment is too large to include in a chat")
        payload["content"] = path.read_text(encoding="utf-8", errors="replace")
        payload["content_type"] = "text"
    else:
        payload["content"] = ""
        payload["content_type"] = "file"
    return payload


def import_attachment(body: dict) -> dict:
    if set(body) != {"path"}:
        raise ValueError("attachment import requires one path")
    raw = str(body.get("path") or "").strip()
    if raw.startswith("file:"):
        parsed = urllib.parse.urlsplit(raw)
        if parsed.scheme != "file" or parsed.netloc not in ("", "localhost"):
            raise ValueError("invalid local file URL")
        raw = urllib.parse.unquote(parsed.path)
    try:
        home_real = HOME.resolve(strict=True)
        source = Path(raw).expanduser().resolve(strict=True)
    except OSError as exc:
        raise ValueError("attachment does not exist") from exc
    if not source.is_file() or home_real not in source.parents:
        raise ValueError("attachment must be a regular file inside the real home")
    size = source.stat().st_size
    if size < 0 or size > MAX_ATTACHMENT_BYTES:
        raise ValueError("attachment exceeds the 20 MB limit")
    mime = mimetypes.guess_type(source.name)[0] or "application/octet-stream"
    attachment_id = str(uuid.uuid4())
    suffix = source.suffix.lower()[:16] if re.fullmatch(r"\.[a-zA-Z0-9._+-]{1,16}", source.suffix) else ""
    stored = attachment_id + suffix
    ATTACHMENTS.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(ATTACHMENTS, 0o700)
    destination = ATTACHMENTS / stored
    with source.open("rb") as src, destination.open("xb") as dst:
        shutil.copyfileobj(src, dst, 1024 * 1024)
        dst.flush()
        os.fsync(dst.fileno())
    os.chmod(destination, 0o600)
    workspace = load_workspace()
    meta = {
        "id": attachment_id, "name": source.name[:180], "stored": stored,
        "mime": mime, "size": size, "created": int(time.time()),
    }
    workspace["attachments"][attachment_id] = meta
    save_workspace(workspace)
    return {"ok": True, **_attachment_payload(meta)}


def list_attachments() -> list[dict]:
    out = []
    for meta in load_workspace()["attachments"].values():
        if isinstance(meta, dict) and (ATTACHMENTS / str(meta.get("stored", ""))).is_file():
            out.append({key: value for key, value in meta.items() if key != "stored"})
    return sorted(out, key=lambda item: -int(item.get("created", 0)))[:200]


# ── push-to-talk voice capture ──────────────────────────────────────────

VOICE_LOCK = threading.RLock()
VOICE_CAPTURE: dict[str, object] = {}


def voice_status() -> dict:
    with VOICE_LOCK:
        process = VOICE_CAPTURE.get("process")
        recording = bool(process is not None and process.poll() is None)
        return {"recording": recording,
                "started": int(VOICE_CAPTURE.get("started", 0)) if recording else 0}


def start_voice() -> dict:
    if not PW_RECORD.is_file() or not os.access(PW_RECORD, os.X_OK):
        raise ValueError("PipeWire recorder is unavailable")
    with VOICE_LOCK:
        process = VOICE_CAPTURE.get("process")
        if process is not None and process.poll() is None:
            raise ValueError("voice recording is already active")
        ATTACHMENTS.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(ATTACHMENTS, 0o700)
        path = ATTACHMENTS / ("voice-" + str(uuid.uuid4()) + ".wav")
        process = subprocess.Popen(
            [str(PW_RECORD), "--rate", "16000", "--channels", "1", str(path)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE, start_new_session=True,
        )
        VOICE_CAPTURE.clear()
        VOICE_CAPTURE.update({"process": process, "path": path, "started": int(time.time())})
        return {"ok": True, "recording": True, "started": VOICE_CAPTURE["started"]}


def stop_voice() -> dict:
    with VOICE_LOCK:
        process = VOICE_CAPTURE.get("process")
        path = VOICE_CAPTURE.get("path")
        if process is None or process.poll() is not None or not isinstance(path, Path):
            raise ValueError("voice recording is not active")
        try:
            os.killpg(process.pid, signal.SIGINT)
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=3)
        VOICE_CAPTURE.clear()
    try:
        if not path.is_file() or path.stat().st_size <= 44:
            detail = (process.stderr.read() if process.stderr else b"").decode(
                "utf-8", errors="replace")[-300:]
            raise ValueError("no microphone audio was captured" + (": " + detail if detail else ""))
        result = subprocess.run(
            [str(TRANSCRIBE), str(path)], capture_output=True, text=True,
            timeout=180, env=ENV,
        )
        transcript = (result.stdout or "").strip()
        if result.returncode != 0 or not transcript:
            error = (result.stderr or "voice transcription returned no text").strip()[-500:]
            raise ValueError(error)
        return {"ok": True, "recording": False, "text": transcript}
    finally:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


# ── conversations ───────────────────────────────────────────────────────

def list_sessions(search: str = "", include_archived: bool = False) -> list[dict]:
    idx = SESSIONS / "sessions.json"
    try:
        data = json.loads(idx.read_text(encoding="utf-8"))
    except Exception:
        return []
    workspace = load_workspace()
    metadata = workspace["sessions"]
    needle = str(search or "").strip().casefold()[:120]
    out = []
    for key, meta in (data.items() if isinstance(data, dict) else []):
        sid = meta.get("sessionId")
        if not sid:
            continue
        f = SESSIONS / f"{sid}.jsonl"
        if not f.exists():
            continue
        own = metadata.get(sid, {})
        if not isinstance(own, dict):
            own = {}
        archived = bool(own.get("archived", False))
        if archived and not include_archived:
            continue
        label = str(own.get("title") or key.split(":")[-1]).strip()[:120]
        if needle and needle not in label.casefold() and needle not in key.casefold():
            continue
        out.append({
            "key": key,
            "id": sid,
            "label": label,
            "pinned": bool(own.get("pinned", False)),
            "archived": archived,
            "project": str(own.get("project") or ""),
            "updated": int(meta.get("updatedAt", 0) / 1000) or int(f.stat().st_mtime),
        })
    return sorted(out, key=lambda s: (not s["pinned"], -s["updated"]))[:60]


def update_session(body: dict) -> dict:
    """Update presentation metadata for a real OpenClaw session.

    OpenClaw owns its JSONL and index. Mo AI stores only product metadata in a
    separate atomic file so an OpenClaw update cannot reject our fields.
    """
    sid = str(body.get("id") or "")
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", sid):
        raise ValueError("invalid session id")
    if not (SESSIONS / f"{sid}.jsonl").is_file():
        raise ValueError("session does not exist")
    allowed = {"title", "pinned", "archived", "project"}
    unknown = set(body) - allowed - {"id"}
    if unknown:
        raise ValueError("unknown session metadata: " + ", ".join(sorted(unknown)))

    workspace = load_workspace()
    current = workspace["sessions"].get(sid, {})
    if not isinstance(current, dict):
        current = {}
    current = dict(current)
    if "title" in body:
        title = str(body.get("title") or "").strip()
        if len(title) > 120 or any(ord(ch) < 32 for ch in title):
            raise ValueError("invalid session title")
        if title:
            current["title"] = title
        else:
            current.pop("title", None)
    for field in ("pinned", "archived"):
        if field in body:
            if not isinstance(body[field], bool):
                raise ValueError(f"{field} must be boolean")
            current[field] = body[field]
    if "project" in body:
        project = str(body.get("project") or "").strip()
        if project:
            try:
                home_real = HOME.resolve(strict=True)
                resolved = Path(project).expanduser().resolve(strict=True)
            except OSError as exc:
                raise ValueError("project path does not exist") from exc
            if not resolved.is_dir() or (
                resolved != home_real and home_real not in resolved.parents
            ):
                raise ValueError("project must be inside the real home directory")
            current["project"] = str(resolved)
        else:
            current.pop("project", None)
    current["changed"] = int(time.time())
    workspace["sessions"][sid] = current
    save_workspace(workspace)
    return {"ok": True, "id": sid, **current}


def _text_of(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content
                         if isinstance(b, dict) and b.get("type") == "text").strip()
    return ""


def read_session(sid: str) -> list[dict]:
    # Reject anything that is not a bare uuid — this value reaches a path join.
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", sid or ""):
        return []
    f = SESSIONS / f"{sid}.jsonl"
    if not f.exists():
        return []
    msgs = []
    for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line.strip():
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") != "message":
            continue
        m = d.get("message") or {}
        role = m.get("role")
        if role not in ("user", "assistant"):
            continue
        text = _text_of(m.get("content"))
        if not text:
            continue
        msgs.append({"role": role, "text": text, "ts": d.get("timestamp", "")})
    return msgs


def send(key: str, text: str) -> dict:
    key = re.sub(r"[^A-Za-z0-9_-]", "", key or "console")[:48] or "console"
    if not text.strip():
        return {"error": "رسالة فارغة"}
    p = subprocess.run([BIN, "agent", "--session-key", key, "-m", text],
                       capture_output=True, text=True, timeout=600, env=ENV)
    out = "\n".join(l for l in (p.stdout or "").splitlines()
                    if l.strip() and not l.startswith("["))
    return {"reply": out.strip() or (p.stderr or "").strip()[:400] or "لا رد"}


# ── http ────────────────────────────────────────────────────────────────

class H(BaseHTTPRequestHandler):
    server_version = "moai-agent-api"

    def log_message(self, *a):  # quiet
        pass

    def _send(self, obj, code=200, ctype="application/json"):
        body = obj if isinstance(obj, bytes) else json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", f"{ctype}; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'self'; script-src 'self' 'unsafe-inline'; "
            "style-src 'self' 'unsafe-inline'; connect-src 'self'; "
            "img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; "
            "form-action 'none'",
        )
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header(
            "Permissions-Policy",
            "camera=(), microphone=(), geolocation=(), payment=()",
        )
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _reject(self, code: int, message: str):
        # Rejections happen before the body is read.  Close the connection so
        # unread bytes can never be mistaken for a second keep-alive request.
        self.close_connection = True
        self._send({"error": message}, code)

    def _foreign_origin(self) -> bool:
        origin = self.headers.get("Origin")
        if not origin:
            return False
        try:
            parsed = urllib.parse.urlsplit(origin)
            port = parsed.port
        except ValueError:
            return True
        expected_port = getattr(self.server, "server_port", PORT)
        return not (
            parsed.scheme == "http"
            and parsed.hostname in ("127.0.0.1", "localhost", "::1")
            and port == expected_port
            and parsed.username is None
            and parsed.password is None
            and not parsed.path
            and not parsed.query
            and not parsed.fragment
        )

    @staticmethod
    def _is_api(path: str) -> bool:
        return path == "/api" or path.startswith("/api/")

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        if self._foreign_origin():
            return self._reject(403, "foreign origin")
        if self._is_api(u.path) and self.headers.get(API_HEADER) != "1":
            return self._reject(403, "missing agent request header")
        q = urllib.parse.parse_qs(u.query)
        try:
            if u.path in ("/", "/index.html"):
                return self._send(UI.read_bytes(), ctype="text/html")
            if u.path == "/api/status":
                return self._send(status())
            if u.path == "/api/capabilities":
                return self._send(capabilities())
            if u.path == "/api/config":
                return self._send(read_config())
            if u.path == "/api/sessions":
                search = (q.get("q") or [""])[0]
                archived = (q.get("archived") or [""])[0] == "1"
                return self._send(list_sessions(search, archived))
            if u.path == "/api/session":
                return self._send(read_session((q.get("id") or [""])[0]))
            if u.path == "/api/projects":
                archived = (q.get("archived") or [""])[0] == "1"
                return self._send(list_projects(archived))
            if u.path == "/api/tasks":
                return self._send(list_tasks((q.get("project") or [""])[0],
                                             (q.get("status") or [""])[0]))
            if u.path == "/api/terminals":
                return self._send(list_terminals())
            if u.path == "/api/attachments":
                return self._send(list_attachments())
            if u.path == "/api/voice/status":
                return self._send(voice_status())
            if u.path == "/api/terminal/output":
                terminal_id = (q.get("id") or [""])[0]
                try:
                    offset = max(0, int((q.get("offset") or ["0"])[0]))
                except ValueError as exc:
                    raise ValueError("invalid terminal offset") from exc
                return self._send(_terminal(terminal_id).output(offset))
        except Exception as e:
            return self._send({"error": str(e)[:300]}, 500)
        self._send({"error": "not found"}, 404)

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        if self._foreign_origin():
            return self._reject(403, "foreign origin")
        if self._is_api(u.path) and self.headers.get(API_HEADER) != "1":
            return self._reject(403, "missing agent request header")
        media_type = self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if media_type != "application/json":
            return self._reject(415, "content type must be application/json")
        if self.headers.get("Transfer-Encoding"):
            return self._reject(400, "transfer encoding is not supported")
        lengths = self.headers.get_all("Content-Length") or []
        if len(lengths) != 1:
            return self._reject(411, "one content length is required")
        try:
            n = int(lengths[0])
            if n < 0:
                raise ValueError
        except (TypeError, ValueError):
            return self._reject(400, "bad content length")
        if n > MAX_BODY_BYTES:
            return self._reject(413, "request body too large")
        try:
            body = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._send({"error": "bad json"}, 400)
        if not isinstance(body, dict):
            return self._send({"error": "json body must be an object"}, 400)
        try:
            if u.path == "/api/config":
                return self._send(write_config(body))
            if u.path == "/api/send":
                return self._send(send(body.get("key", "console"), body.get("text", "")))
            if u.path == "/api/session/update":
                return self._send(update_session(body))
            if u.path == "/api/project/upsert":
                return self._send(upsert_project(body))
            if u.path == "/api/task/create":
                return self._send(create_task(body))
            if u.path == "/api/task/update":
                return self._send(update_task(body))
            if u.path == "/api/task/action":
                return self._send(task_action(body))
            if u.path == "/api/terminal/start":
                return self._send(start_terminal(body))
            if u.path == "/api/terminal/write":
                return self._send(write_terminal(body))
            if u.path == "/api/terminal/stop":
                return self._send(stop_terminal(body))
            if u.path == "/api/attachment/import":
                return self._send(import_attachment(body))
            if u.path == "/api/voice/start":
                if body:
                    raise ValueError("voice start takes no options")
                return self._send(start_voice())
            if u.path == "/api/voice/stop":
                if body:
                    raise ValueError("voice stop takes no options")
                return self._send(stop_voice())
        except ValueError as e:
            return self._send({"error": str(e)}, 400)
        except Exception as e:
            return self._send({"error": str(e)[:300]}, 500)
        self._send({"error": "not found"}, 404)

    def do_OPTIONS(self):
        # Intentionally no CORS headers: a foreign page must never gain
        # permission to send X-Moai-Agent to this credential-writing API.
        self._reject(405, "method not allowed")


def main():
    if not UI.exists():
        sys.exit(f"واجهة غير موجودة: {UI}")
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), H)
    print(f"moai-agent-api → http://127.0.0.1:{PORT}/", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
