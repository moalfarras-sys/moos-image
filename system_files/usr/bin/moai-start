#!/usr/bin/env bash
# moai-start — set up the Mo AI local brain, then make it auto-start.
#
# Flow: consent → pull the model once (visible progress) → enable the moai.service
# user unit so the RamaLama/llama.cpp OpenAI server (port 8080) comes up on every
# login WITHOUT keeping a terminal open. The Mo AI app (main.qml) talks to
# http://127.0.0.1:8080. Everything stays local — no cloud, no telemetry.
set -uo pipefail

PORT="${MOAI_PORT:-8080}"
MODEL="${MOAI_MODEL:-ollama://qwen3:4b-instruct}"
B='\033[1;34m'; C='\033[1;36m'; G='\033[1;32m'; Y='\033[1;33m'; N='\033[0m'

if ! command -v ramalama >/dev/null 2>&1; then
    echo -e "${B}Mo AI${N}: RamaLama غير مثبّت | RamaLama is not installed."
    echo "ثبّته ثم أعد التشغيل | install then reboot:  sudo rpm-ostree install ramalama"
    exit 1
fi

echo -e "${B}Mo AI${N} — إعداد العقل المحلي | Setting up the local brain"
echo
echo -e "  النموذج | Model : ${C}${MODEL}${N}"
echo -e "  المنفذ  | Port  : ${C}${PORT}${N}"
echo
echo "أول مرة يُحمّل النموذج (~2.5 GB) — قد يأخذ وقتاً حسب سرعة الإنترنت."
echo "First run downloads the model (~2.5 GB) — may take a while."
echo "بعدها يبدأ تلقائياً كل مرة تشغّل الجهاز. | After that it auto-starts every boot."
echo "كل شيء يبقى على جهازك، لا سحابة. | Everything stays on your device, no cloud."
echo
read -rp "متابعة؟ | Continue? [Y/n] " answer
case "${answer:-Y}" in [Yy]*) ;; *) echo "أُلغي | Cancelled."; exit 0 ;; esac

echo
echo -e "${B}==>${N} تحميل النموذج | Pulling the model…"
if ! ramalama pull "$MODEL"; then
    echo -e "${Y}!${N} فشل التحميل — تحقق من الإنترنت وأعد المحاولة. | Pull failed — check your Internet and retry."
    exit 1
fi

echo
echo -e "${B}==>${N} تفعيل التشغيل التلقائي | Enabling auto-start (moai.service)…"
if systemctl --user enable --now moai.service 2>/dev/null; then
    echo -e "${G}✓${N} العقل يعمل الآن وسيبدأ تلقائياً كل إقلاع. | The brain is running and will auto-start every boot."
    echo "  حالة | status:  systemctl --user status moai.service"
    echo "  إيقاف | stop  :  systemctl --user disable --now moai.service"
else
    # Fallback: no user-service manager (e.g. live session) — serve in-place.
    echo -e "${Y}!${N} تعذّر تفعيل الخدمة — أشغّل الخادم هنا مباشرة. | Could not enable the service — serving here instead."
    echo "  (اترك هذه النافذة مفتوحة | keep this window open)"
    exec ramalama serve --port "$PORT" "$MODEL"
fi

echo
echo -e "${C}افتح Mo AI الآن — سيتصل خلال ثوانٍ. | Open Mo AI now — it will connect within seconds.${N}"
