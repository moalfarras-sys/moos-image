#!/usr/bin/env bash
# moai-start — manage Mo AI's unprivileged local-brain service.
#
# The local brain listens on 8081. 8080 belongs to moai-gateway, the always-on
# front door that routes each request to the local brain or to the cloud — see
# /usr/bin/moai-gateway. Running the brain on 8080 would fight the front door for
# the port, so the port is NOT taken from the existing moai.env here: every file
# written before this change says 8080, and that file (an EnvironmentFile)
# outranks the unit. The MODEL, on the other hand, IS preserved — the user may
# have switched it from Mo AI's picker, and rewriting it back to the default
# would silently undo their choice.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/moos"
ENV_FILE="$CONFIG_DIR/moai.env"
CONSENT_FILE="$CONFIG_DIR/moai-local-consent"
SERVICE="moai.service"

PORT="${MOAI_PORT:-8081}"
prev_model=""
[ -f "$ENV_FILE" ] && prev_model="$(sed -n 's/^MOAI_MODEL=//p' "$ENV_FILE" | tail -n1)"
MODEL="${MOAI_MODEL:-${prev_model:-ollama://qwen3:4b-instruct}}"

if [ -t 1 ]; then
    B=$'\033[1;34m'; C=$'\033[1;36m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; N=$'\033[0m'
else
    B=; C=; G=; Y=; N=
fi

status() {
    if systemctl --user is-active --quiet "$SERVICE"; then
        echo "${G}● Mo AI يعمل | local brain is running${N}"
        echo "  http://127.0.0.1:${PORT}"
    else
        echo "${Y}○ Mo AI متوقف | local brain is stopped${N}"
        systemctl --user status "$SERVICE" --no-pager 2>/dev/null | tail -n 8 || true
    fi
}

case "${1:-start}" in
    status)
        status
        exit 0
        ;;
    stop)
        systemctl --user disable --now "$SERVICE"
        echo "${G}تم إيقاف العقل المحلي وتعطيل تشغيله التلقائي.${N}"
        echo "${G}Local brain stopped and autostart disabled.${N}"
        echo "  Mo AI لا يزال يعمل — سيوقظ العقل المحلي عند الطلب أو يستخدم السحابة."
        echo "  Mo AI still works — the gateway wakes this on demand, or uses the cloud."
        exit 0
        ;;
    logs)
        exec journalctl --user -u "$SERVICE" -f
        ;;
    start) ;;
    *)
        echo "Usage: moai-start [start|stop|status|logs]" >&2
        exit 2
        ;;
esac

if ! command -v ramalama >/dev/null 2>&1; then
    echo "${Y}RamaLama غير مثبّت | RamaLama is not installed.${N}" >&2
    exit 1
fi

mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"
mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/ramalama" \
         "${XDG_DATA_HOME:-$HOME/.local/share}/containers" \
         "${XDG_CACHE_HOME:-$HOME/.cache}/ramalama"

# Consent is requested once because the first start downloads a multi-gigabyte
# model. Subsequent logins start only the already-approved user service; no
# password, sudo or system-wide privilege is involved.
if [ ! -f "$CONSENT_FILE" ]; then
    echo "${B}Mo AI — العقل المحلي | Local brain${N}"
    echo
    echo "  ${C}النموذج | Model:${N} $MODEL"
    echo "  ${C}المنفذ | Port:${N}  $PORT (localhost only)"
    echo
    echo "أول تشغيل يحمّل النموذج (~2.5 GB). البيانات والمحادثة تبقيان على جهازك."
    echo "First start downloads the model (~2.5 GB). Data and chat stay on this device."
    echo
    read -rp "تفعيل وتشغيل Mo AI تلقائياً بعد تسجيل الدخول؟ | Enable at login? [y/N] " answer
    case "${answer:-N}" in
        [Yy]|[Yy][Ee][Ss]) ;;
        *) echo "أُلغي | Cancelled."; exit 0 ;;
    esac
    printf 'approved=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$CONSENT_FILE"
    chmod 600 "$CONSENT_FILE"
fi

cat >"$ENV_FILE" <<EOF
MOAI_PORT=$PORT
MOAI_MODEL=$MODEL
EOF
chmod 600 "$ENV_FILE"

systemctl --user daemon-reload
systemctl --user enable --now "$SERVICE"
echo "${G}✓ Mo AI يعمل كخدمة مستخدم وسيبدأ تلقائياً بعد تسجيل الدخول.${N}"
echo "${G}  Mo AI is running as a user service and will start automatically at login.${N}"
echo "  moai-start status | moai-start logs | moai-start stop"
status
