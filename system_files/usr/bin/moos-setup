#!/usr/bin/env bash
# moos-setup — MoOS first-run power setup (user-consent, never automatic)
# Installs the curated Flathub app set. Run from Konsole: moos-setup
# Docs: MOOS_APP_CENTER_PLAN.md / MOOS_COMPATIBILITY_PLAN.md
set -euo pipefail

B='\033[1;34m'; G='\033[1;32m'; N='\033[0m'
echo -e "${B}"
echo "  __  __        ___  ____  "
echo " |  \\/  | ___  / _ \\/ ___| "
echo " | |\\/| |/ _ \\| | | \\___ \\ "
echo " | |  | | (_) | |_| |___) |"
echo " |_|  |_|\\___/ \\___/|____/ "
echo -e "${N}"
echo "MoOS Setup — إعداد تطبيقات القوة | Power apps setup"
echo

if ! flatpak remotes | grep -q flathub; then
    echo "Adding Flathub remote..."
    sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

if [ -n "${DISPLAY:-}" ]; then
    CHOICES=$(kdialog --title "إعداد تطبيقات القوة | Power apps setup" \
        --checklist "اختر التطبيقات لتثبيتها | Select apps to install:" \
        "org.mozilla.firefox" "Firefox — المتصفح (Web Browser)" on \
        "org.videolan.VLC" "VLC — مشغل الوسائط (Media Player)" on \
        "org.libreoffice.LibreOffice" "LibreOffice — حزمة المكتب (Office Suite)" on \
        "io.github.kolunmi.Bazaar" "Bazaar — متجر تطبيقات MoOS (App Store)" on \
        "com.github.tchx84.Flatseal" "Flatseal — إدارة أذونات التطبيقات (Flatpak Permissions)" on \
        "com.valvesoftware.Steam" "Steam — منصة الألعاب (Steam Gaming)" on \
        "com.usebottles.bottles" "Bottles — تشغيل برامج Windows (Run Windows Apps)" on \
        "net.lutris.Lutris" "Lutris — مدير الألعاب الشامل (Lutris Games Manager)" on 2>/dev/null)

    if [ $? -ne 0 ]; then
        echo "أُلغي | Cancelled."
        exit 0
    fi

    eval "SELECTED=($CHOICES)"
else
    SELECTED=("org.mozilla.firefox" "org.videolan.VLC" "org.libreoffice.LibreOffice" "io.github.kolunmi.Bazaar" "com.github.tchx84.Flatseal" "com.valvesoftware.Steam" "com.usebottles.bottles" "net.lutris.Lutris")
    echo "No graphical display detected. Installing all recommended apps: ${SELECTED[*]}"
fi

for app in "${SELECTED[@]}"; do
    echo -e "${B}Installing ${app}...${N}"
    flatpak install -y --noninteractive flathub "$app" || echo "skipped: $app"
done
echo -e "${G}✓ اكتمل الإعداد — أهلاً بك في MoOS | Setup complete — welcome to MoOS${N}"
