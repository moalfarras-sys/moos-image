#!/usr/bin/env bash
# moos-setup — MoOS first-run power setup (user-consent, never automatic)
# Installs a hardware-aware curated Flatpak set. Run: moos-setup [--smart]
# Docs: MOOS_APP_CENTER_PLAN.md / MOOS_COMPATIBILITY_PLAN.md
set -euo pipefail

B='\033[1;34m'; G='\033[1;32m'; N='\033[0m'
echo -e "${B}"
echo "  __  __        ___  ____  "
echo " |  \\/  | ___  / _ \\/ ___| "
echo " | |\\/| |/ _ \\| | | \\___ \\ "
echo " | |  | | (_) | |_| |___) |"
echo " |_|  |_|\\___/ \\___/|____/ "
echo -e "${N}"
echo "MoOS Setup — إعداد تطبيقات القوة | Power apps setup"
echo

if ! flatpak remotes | grep -q flathub; then
    echo "Adding Flathub remote..."
    sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

MODE="${1:---interactive}"
SMART=()
if [ -x /usr/bin/moos-device-plan ]; then
    mapfile -t SMART < <(python3 -c 'import json,subprocess; d=json.loads(subprocess.check_output(["/usr/bin/moos-device-plan","--compact"])); print("\n".join(d["missing_recommended_apps"]))' 2>/dev/null || true)
fi

if [ "$MODE" = "--gaming" ]; then
    SELECTED=("com.valvesoftware.Steam" "com.usebottles.bottles" "net.lutris.Lutris" "net.davidotek.pupgui2")
    MISSING=()
    for app in "${SELECTED[@]}"; do
        flatpak info "$app" >/dev/null 2>&1 || MISSING+=("$app")
    done
    SELECTED=("${MISSING[@]}")
    echo "Gaming compatibility selected ${#SELECTED[@]} missing app(s)."
elif [ "$MODE" = "--smart" ]; then
    SELECTED=("${SMART[@]}")
    echo "Hardware-aware plan selected ${#SELECTED[@]} missing essential app(s)."
elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    if ! CHOICES=$(kdialog --title "إعداد تطبيقات القوة | Power apps setup" \
        --checklist "اختر التطبيقات لتثبيتها | Select apps to install:" \
        "org.mozilla.firefox" "Firefox — المتصفح (Web Browser)" on \
        "org.videolan.VLC" "VLC — مشغل الوسائط (Media Player)" on \
        "org.libreoffice.LibreOffice" "LibreOffice — حزمة المكتب (Office Suite)" on \
        "io.github.kolunmi.Bazaar" "Bazaar — كتالوج Mo Store الكامل، اختياري (full catalog engine)" off \
        "com.github.tchx84.Flatseal" "Flatseal — إدارة أذونات التطبيقات (Flatpak Permissions)" on \
        "com.valvesoftware.Steam" "Steam — منصة الألعاب (Steam Gaming)" on \
        "com.usebottles.bottles" "دعم تطبيقات Windows (Windows app support)" on \
        "net.lutris.Lutris" "Lutris — مدير الألعاب الشامل (Lutris Games Manager)" on 2>/dev/null); then
        echo "أُلغي | Cancelled."
        exit 0
    fi
    CHOICES="${CHOICES//\"/}"
    read -r -a SELECTED <<< "$CHOICES"
else
    SELECTED=("${SMART[@]}")
    echo "No graphical display detected. Installing the smart essential set: ${SELECTED[*]:-already complete}"
fi

# Through Mo Store's backend — the ONE authority for installing, removing and updating
# apps (DEVELOPMENT_PLAN.md P4.1). `flatpak install` here put the first-run set in the
# SYSTEM installation while Mo Store installs per user, so the apps a person chose in
# their first five minutes were exactly the ones Mo Store could never remove afterwards,
# and none of them produced an Island job row. One call installs the whole selection as
# one job, in the scope the rest of MoOS uses.
if [ "${#SELECTED[@]}" -gt 0 ]; then
    echo -e "${B}Installing ${SELECTED[*]}...${N}"
    if summary="$(moos-storectl install "${SELECTED[@]}" 2>/dev/null | tail -n 1)"; then
        printf '%s\n' "$summary" | python3 -c 'import json, sys
try:
    document = json.loads(sys.stdin.read())
except ValueError:
    document = {}
message = " ".join(str((document or {}).get("message") or "").split())
print(message or "Installed.")' || true
    else
        echo "Some apps did not install; open Mo Store to finish."
    fi
fi
# Bazaar may have just been installed system-wide. It is Mo Store's engine, not
# a second storefront — hide its launcher for this user (moos-one-store is a
# no-op when Bazaar is absent).
/usr/bin/moos-one-store 2>/dev/null || true
if [ "${#SELECTED[@]}" -eq 0 ]; then
    echo -e "${G}✓ التطبيقات الأساسية موجودة بالفعل | Essential apps are already installed${N}"
fi
echo -e "${G}✓ اكتمل الإعداد — أهلاً بك في MoOS | Setup complete — welcome to MoOS${N}"
