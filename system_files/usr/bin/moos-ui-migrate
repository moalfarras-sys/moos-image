#!/usr/bin/env bash
# Scoped, once-per-revision UI migration for immutable MoOS images.
set -uo pipefail

# Revision 11: the popup FrameSvg now uses one continuous neutral rim instead
# of split accent/luminous bands whose 9-patch joins showed as clipped launcher
# corners. OSTree keeps its mtime stable, so existing users must drop Plasma's
# rendered-SVG/QML caches once to see the corrected frame.
MOOS_THEME_REV=11
MOAI_UI_REV=3
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/moos"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
log_dir="$state_dir/migrations"
marker="$state_dir/ui-theme-${MOOS_THEME_REV}-moai-${MOAI_UI_REV}.done"
mkdir -p "$log_dir" 2>/dev/null || exit 0

# KWin reads [Keyboard] NumLock from kcminputrc while its Wayland compositor is
# starting. /etc/xdg supplies the right default for fresh accounts, but an
# existing ~/.config/kcminputrc is the stronger KConfig layer and can retain the
# old 1=off or 2=unchanged value forever. Migrate those two defined legacy
# states once, before KWin starts, while preserving every unrelated input key.
#
# The marker is deliberately independent of the theme migration revisions. A
# user can choose a different startup preference after this repair and it will
# not be overwritten on later logins. This writes a startup preference only; it
# never injects a key event, so the physical Num Lock key remains fully usable.
migrate_startup_numlock() {
    local input_conf="${XDG_CONFIG_HOME:-$HOME/.config}/kcminputrc"
    local input_marker="$state_dir/numlock-startup-v1.done"
    local input_log="$log_dir/numlock-startup-v1.log"
    local old_value tmp new_value

    [ -e "$input_marker" ] && return 0
    if [ ! -f "$input_conf" ]; then
        touch "$input_marker"
        return 0
    fi
    command -v kreadconfig6 >/dev/null 2>&1 || return 0
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0

    old_value="$(kreadconfig6 --file "$input_conf" --group Keyboard \
        --key NumLock --default __missing__ 2>/dev/null || true)"
    case "$old_value" in
        0|__missing__)
            touch "$input_marker"
            return 0
            ;;
        1|2)
            ;;
        *)
            # Preserve unknown/future values rather than guessing their meaning.
            touch "$input_marker"
            echo "$(date -u '+%FT%TZ') preserved unknown NumLock value: $old_value" \
                >>"$input_log" 2>/dev/null || true
            return 0
            ;;
    esac

    tmp="$(mktemp "${input_conf}.moos-numlock.XXXXXX")" || return 0
    if cp --preserve=mode -- "$input_conf" "$tmp" \
       && kwriteconfig6 --file "$tmp" --group Keyboard --key NumLock 0 \
       && new_value="$(kreadconfig6 --file "$tmp" --group Keyboard \
            --key NumLock --default __missing__ 2>/dev/null)" \
       && [ "$new_value" = "0" ] \
       && mv -f -- "$tmp" "$input_conf"; then
        touch "$input_marker"
        echo "$(date -u '+%FT%TZ') migrated NumLock $old_value -> 0 before KWin" \
            >>"$input_log" 2>/dev/null || true
    else
        rm -f -- "$tmp"
        echo "$(date -u '+%FT%TZ') could not migrate NumLock; will retry" \
            >>"$input_log" 2>/dev/null || true
    fi
}
migrate_startup_numlock

# A development recovery for the first broken OpenClaw idle unit masked the
# user service with ~/.config/systemd/user/openclaw-idle.service -> /dev/null.
# The fixed image later shipped the real service and globally enabled its timer,
# but a user mask outranks /usr forever: every login then queued an enabled timer
# whose trigger was "not loaded".  Repair only that internally contradictory
# state.  A disabled/masked timer is an intentional user choice and is preserved.
repair_legacy_openclaw_idle_mask() {
    local user_unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    local mask="${user_unit_dir}/openclaw-idle.service"
    local system_user_dir="${MOOS_SYSTEMD_USER_DIR:-/usr/lib/systemd/user}"
    local systemctl_bin="${MOOS_SYSTEMCTL_BIN:-/usr/bin/systemctl}"
    local idle_marker="$state_dir/openclaw-idle-mask-v1.done"
    local idle_log="$log_dir/openclaw-idle-mask-v1.log"

    [ -e "$idle_marker" ] && return 0
    [ -f "${system_user_dir}/openclaw-idle.service" ] || return 0

    # Mark coherent states once so a user who deliberately masks the unit later
    # is never fought by an image migration.
    if [ ! -L "$mask" ] || [ "$(readlink -- "$mask" 2>/dev/null)" != "/dev/null" ]; then
        touch "$idle_marker"
        return 0
    fi
    if ! "$systemctl_bin" --user is-enabled --quiet openclaw-idle.timer; then
        touch "$idle_marker"
        echo "$(date -u '+%FT%TZ') preserved idle-service mask with disabled timer" \
            >>"$idle_log" 2>/dev/null || true
        return 0
    fi

    rm -f -- "$mask" || return 0
    "$systemctl_bin" --user daemon-reload >/dev/null 2>&1 || true
    "$systemctl_bin" --user reset-failed openclaw-idle.service openclaw-idle.timer \
        >/dev/null 2>&1 || true
    if "$systemctl_bin" --user start openclaw-idle.timer \
       && "$systemctl_bin" --user is-active --quiet openclaw-idle.timer; then
        touch "$idle_marker"
        echo "$(date -u '+%FT%TZ') retired incoherent idle-service mask; timer active" \
            >>"$idle_log" 2>/dev/null || true
        return 0
    fi

    # Transactional failure: restore the exact mask and retry on a later login.
    ln -s /dev/null "$mask" 2>/dev/null || true
    "$systemctl_bin" --user daemon-reload >/dev/null 2>&1 || true
    echo "$(date -u '+%FT%TZ') idle-mask repair failed; original mask restored" \
        >>"$idle_log" 2>/dev/null || true
    return 0
}
repair_legacy_openclaw_idle_mask

# --- The XDG data directories KDE expects to be able to stat ---------------------------------
#
# These are mkdir -p on empty directories, which sounds like housekeeping and is
# not. A directory that appears in XDG_DATA_DIRS but does not EXIST is the
# classic cause of a KSycoca rebuild loop: KBuildSycoca records every resource
# directory it was asked about, `needsRebuild()` then stats each recorded path,
# a path that is not there never matches its recorded timestamp, and the answer
# is "rebuild" for ever. The rebuild is a full one, and it is synchronous on
# whichever thread asked.
#
# Measured on the owner's server: plasmashell rebuilding ksycoca every ~15
# seconds for the whole uptime, ~79% of one core on the main thread, triggered
# (`eu-stack`, not guesswork) by plasma-nm looking up a "qrca" service that MoOS
# does not ship:
#
#     QrcaHandler::update() -> KService::serviceByDesktopName("qrca")
#       -> KSycoca::ensureCacheValid() -> KSycocaPrivate::checkDatabase()
#         -> KBuildSycoca::recreate()
#
# The lookup is not the bug — that lookup happens on both accounts and only one
# of them spins. The bug is that the rebuild never makes the cache valid, and an
# unstattable directory explains exactly that, including the asymmetry: flatpak's
# systemd user-environment generator puts ~/.local/share/flatpak/exports/share
# into XDG_DATA_DIRS for EVERY account, and the directory only exists once that
# account has actually installed something with flatpak. The seat owner has;
# a freshly created second developer has not.
#
# Stated honestly: this is a mechanism that fits every observation, not a fix
# confirmed on the server — that needs a boot on the machine that shows the loop.
# It is applied anyway because these directories should exist regardless (they
# are where a user's own .desktop files and icons go), and creating an empty
# directory cannot break anything. Four other hypotheses were tried and refuted;
# they are recorded in MOOS_ROADMAP.md and should not be retried without new
# evidence.
#
# This runs BEFORE the --input-only gate below, because the loop is driven by the
# session that is about to start, not by anything later in this script.
for xdg_dir in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/icons" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications"
do
    [ -d "$xdg_dir" ] || mkdir -p "$xdg_dir" 2>/dev/null || true
done

# The early systemd user unit asks for only the input repair so it can finish
# before either user-session KWin or the Plasma Login Manager's KWin starts.
[ "${1:-}" = "--input-only" ] && exit 0

# --- GStreamer registry: keyed on the DEPLOYMENT, not on the revisions above ----------------
#
# GStreamer decides whether to rescan a plugin by looking at its mtime — and OSTree pins every
# mtime under /usr to the epoch, where they stay. So the registry is never invalidated by a
# bootc upgrade: not when the plugins change, and far worse, not when the DRIVER does.
#
# Switching from moos to moos-nvidia therefore leaves the user carrying a registry that was
# built on a machine with no NVIDIA driver, and what that registry cached is the answer
# "nvcodec provides zero elements". Measured on this hardware right after exactly that switch:
# libnvidia-encode.so present, libgstnvcodec.so present, driver loaded, nvidia-smi happy — and
# gst-inspect-1.0 had never heard of nvh264enc. Deleting the registry made nvh264enc, nvh265enc
# and nvautogpuh264enc appear immediately. Mo PC Remote's hardware encode path is gated on this,
# and the roadmap's assumption that the encoder "registers as soon as the driver loads" is only
# true on a machine that has never cached the answer no.
#
# Keyed on the booted deployment because that is what actually invalidates it; a hand-bumped
# constant would have to be remembered on every image change, and would not be. The deployment
# checksum is already on the kernel command line, so this costs one read and needs no root.
#
# Runs BEFORE the revision gate below on purpose: that gate is an apply-once marker, and an
# apply-once marker cannot notice that the machine has since booted a different image.
deployment="$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | sed -n 's|^ostree=||p' | awk -F/ 'NF>1{print $(NF-1)}')"
if [ -n "${deployment:-}" ] && [ ! -e "$state_dir/gst-registry-${deployment}.done" ]; then
    rm -rf "$cache_dir/gstreamer-1.0"
    rm -f "$state_dir"/gst-registry-*.done
    touch "$state_dir/gst-registry-${deployment}.done"
    echo "$(date -u '+%FT%TZ') dropped the GStreamer registry for deployment ${deployment}" \
        >>"$log_dir/gst-registry.log" 2>/dev/null || true
fi

# The 2026-07-22 image added a temporary US layout for Fast Remote between the
# German physical keyboard and Arabic. Existing profiles can carry an exact
# three-line KConfig shadow written from the previous `de,ara` default, so the
# new image's `de,us,ara` never reaches them. Migrate ONLY that byte-for-byte
# known legacy shape. Any extra key means the user customised the layout and is
# left untouched. A separate marker keeps this repair independent of theme
# revisions and lets a failed atomic write retry on the next login.
migrate_legacy_keyboard() {
    local keyboard_conf="${XDG_CONFIG_HOME:-$HOME/.config}/kxkbrc"
    local keyboard_marker="$state_dir/keyboard-layout-v2.done"
    local keyboard_log="$log_dir/keyboard-layout-v2.log"
    local nonempty tmp

    [ -e "$keyboard_marker" ] && return 0
    if [ ! -f "$keyboard_conf" ]; then
        touch "$keyboard_marker"
        return 0
    fi

    nonempty="$(grep -Evc '^[[:space:]]*(#|$)' "$keyboard_conf" 2>/dev/null || true)"
    if [ "$nonempty" != "4" ] \
       || ! grep -Fxq '[Layout]' "$keyboard_conf" \
       || ! grep -Fxq 'DisplayNames=DE,ع' "$keyboard_conf" \
       || ! grep -Fxq 'LayoutList=de,ara' "$keyboard_conf" \
       || ! grep -Fxq 'VariantList=,' "$keyboard_conf"; then
        touch "$keyboard_marker"
        return 0
    fi

    tmp="$(mktemp "${keyboard_conf}.moos-layout.XXXXXX")" || return 0
    if cp --preserve=mode -- "$keyboard_conf" "$tmp" \
       && kwriteconfig6 --file "$tmp" --group Layout --key LayoutList "de,us,ara" \
       && kwriteconfig6 --file "$tmp" --group Layout --key VariantList ",," \
       && kwriteconfig6 --file "$tmp" --group Layout --key DisplayNames "DE,EN,ع" \
       && mv -f -- "$tmp" "$keyboard_conf"; then
        touch "$keyboard_marker"
        echo "$(date -u '+%FT%TZ') migrated exact legacy keyboard de,ara -> de,us,ara" \
            >>"$keyboard_log" 2>/dev/null || true
        # KWin 6.5+ watches kxkbrc through KConfigWatcher. Its generic
        # reconfigure method does not reload the keyboard. Notify the Layout
        # group after the atomic rename; --notify on the temporary absolute
        # filename cannot reach the watcher for /kxkbrc.
        gdbus emit --session --object-path /kxkbrc \
            --signal org.kde.kconfig.notify.ConfigChanged \
            "{'Layout': @aay []}" >/dev/null 2>&1 || true
    else
        rm -f -- "$tmp"
        echo "$(date -u '+%FT%TZ') could not migrate legacy keyboard; will retry" \
            >>"$keyboard_log" 2>/dev/null || true
    fi
}
migrate_legacy_keyboard

# MoOS briefly enabled KWallet globally to support MoPlayer and Mo AI. That made
# a password prompt part of login even for an owner who never opted into a
# wallet. Both apps now own private XDG stores, so existing profiles must be
# moved back to Enabled=false once. Preserve a currently unlocked Mo AI key
# before stopping the service; never activate or prompt for a closed wallet.
disable_wallet_v2() {
    local wallet_conf="${XDG_CONFIG_HOME:-$HOME/.config}/kwalletrc"
    local wallet_marker="$state_dir/wallet-disabled-v2.done"
    local wallet_log="$log_dir/wallet-disabled-v2.log"
    local credential_store=/usr/libexec/moai-credential-store
    local legacy_key new_value

    [ -e "$wallet_marker" ] && return 0

    if [ -x "$credential_store" ] \
       && ! "$credential_store" has >/dev/null 2>&1 \
       && command -v secret-tool >/dev/null 2>&1 \
       && command -v gdbus >/dev/null 2>&1 \
       && gdbus call --session --dest org.freedesktop.DBus \
            --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.ListNames 2>/dev/null \
            | grep -q "org.freedesktop.secrets"; then
        legacy_key="$(secret-tool lookup service org.moos.MoAI account cloud \
            2>/dev/null || true)"
        if [ -n "$legacy_key" ]; then
            if printf '%s' "$legacy_key" | "$credential_store" set; then
                echo "$(date -u '+%FT%TZ') preserved the unlocked Mo AI credential" \
                    >>"$wallet_log" 2>/dev/null || true
            else
                echo "$(date -u '+%FT%TZ') could not preserve the unlocked Mo AI credential" \
                    >>"$wallet_log" 2>/dev/null || true
            fi
        fi
        legacy_key=
    fi

    command -v kreadconfig6 >/dev/null 2>&1 || return 0
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    mkdir -p "$(dirname "$wallet_conf")" 2>/dev/null || return 0
    if kwriteconfig6 --file "$wallet_conf" --group Wallet --key Enabled false \
       && kwriteconfig6 --file "$wallet_conf" --group Wallet --key "First Use" false \
       && new_value="$(kreadconfig6 --file "$wallet_conf" --group Wallet \
            --key Enabled --default __missing__ 2>/dev/null)" \
       && [ "$new_value" = "false" ]; then
        systemctl --user disable --now moos-secret-service.service \
            >/dev/null 2>&1 || true
        systemctl --user mask --now moos-secret-service.service \
            plasma-kwallet-pam.service >/dev/null 2>&1 || true
        pkill -TERM -u "$(id -u)" -x ksecretd >/dev/null 2>&1 || true
        pkill -TERM -u "$(id -u)" -x kwalletd6 >/dev/null 2>&1 || true
        touch "$wallet_marker"
        echo "$(date -u '+%FT%TZ') disabled KWallet and its session services" \
            >>"$wallet_log" 2>/dev/null || true
    else
        echo "$(date -u '+%FT%TZ') could not disable KWallet; will retry" \
            >>"$wallet_log" 2>/dev/null || true
    fi
}
disable_wallet_v2

[ -e "$marker" ] && exit 0
log="$log_dir/ui-theme-${MOOS_THEME_REV}-moai-${MOAI_UI_REV}.log"
exec >>"$log" 2>&1
echo "$(date -u '+%FT%TZ') starting scoped UI migration"

# Remove only the known 2026-07-11 development copy. It shadows the immutable
# application through PATH and KService. Never touch conversations, config,
# models, Secret Service items, or any other user data.
legacy_qml="$HOME/.local/share/moos/apps/moai/main.qml"
legacy_bin="$HOME/.local/bin/moai"
legacy_desktop="$HOME/.local/share/applications/org.moos.moai.desktop"
if [ -f "$legacy_bin" ] && grep -Fq '$HOME/.local/share/moos/apps/moai/main.qml' "$legacy_bin"; then
    rm -f "$legacy_bin"
    echo "removed obsolete local Mo AI launcher"
fi
if [ -f "$legacy_desktop" ] && grep -Fq "Exec=$HOME/.local/bin/moai" "$legacy_desktop"; then
    rm -f "$legacy_desktop"
    echo "removed obsolete local Mo AI desktop override"
fi
if [ -f "$legacy_qml" ] && [ "$(grep -c settingsOpen "$legacy_qml" 2>/dev/null || true)" = 0 ]; then
    rm -f "$legacy_qml"
    rmdir "$HOME/.local/share/moos/apps/moai" "$HOME/.local/share/moos/apps" 2>/dev/null || true
    echo "removed obsolete local Mo AI QML bundle"
fi

# OSTree normalises mtimes. Remove only caches capable of retaining MoOS QML,
# Plasma theme SVGs, service metadata, or the retired desktop entry.
rm -rf "$cache_dir/qmlcache" "$cache_dir/qml-qt6" \
       "$cache_dir/kwin/qmlcache" "$cache_dir/plasmashell/qmlcache" \
       "$cache_dir/ksvg-elements" "$cache_dir"/plasma_theme_*.kcache \
       "$cache_dir"/plasma-svgelements* "$cache_dir/icon-cache.kcache" \
       "$cache_dir"/ksycoca6_* 2>/dev/null || true
find "$cache_dir" -mindepth 2 -maxdepth 2 -type d -name qmlcache \
    -exec rm -rf -- {} + 2>/dev/null || true

command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental || true

touch "$marker"
echo "$(date -u '+%FT%TZ') migration complete"
