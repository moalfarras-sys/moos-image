#!/usr/bin/env bash
# moos-store-browse — Mo Store's "Browse all" engine.
#
# Mo Store (org.moos.store) is the ONE visible MoOS storefront: a curated,
# premium, one-tap surface. Its full-Flathub catalog + app lifecycle (search
# everything, update, remove, permissions) is provided by the Bazaar engine,
# which MoOS does NOT preinstall — so a fresh device shows exactly one store.
#
# Compatibility entry point. The trusted backend verifies the configured
# Flathub URL/GPG policy, installs Bazaar per-user when needed, keeps its launcher
# out of the app menu, and opens it. Do not duplicate remote handling here.
set -euo pipefail

[ "$#" -eq 0 ] || {
    echo "moos-store-browse: arguments are not supported" >&2
    exit 64
}
exec /usr/bin/moos-storectl open-engine bazaar
