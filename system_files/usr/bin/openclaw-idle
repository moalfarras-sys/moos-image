#!/usr/bin/env bash
# =============================================================================
# openclaw-idle — the Mo AI RUNTIME sleeper. When the local model has been idle
# (Ollama unloaded it after OLLAMA_KEEP_ALIVE=15m with no inference), stop the whole
# heavy runtime so only the lightweight moai-wake receiver stays resident:
#   - openclaw-gateway  (Telegram Node agent + rootless-podman sandbox, ~386 MB)
#   - speaches          (STT/TTS container, ~410 MB)
#   - ollama            (model-server container, ~943 MB) → frees its RAM + all VRAM
# =============================================================================
# Loss-free & self-healing:
#   • The DESKTOP front door (moai-gateway) restarts ollama on the next local chat
#     via ensure_local (MOAI_LOCAL_UNIT=ollama.service).
#   • moai-wake re-wakes openclaw-gateway on the next allowlisted Telegram message;
#     its preflight starts the selected Ollama unit. Telegram redelivers any
#     message that arrived during the handoff, so nothing is dropped.
# WhatsApp Web has no lightweight stateless wake API: its linked WebSocket IS the
# inbound receiver. Once the owner enables WhatsApp, keep only the Gateway and
# its small model-server shell alive; Ollama still unloads the model/VRAM after
# its keep-alive. Stopping the Gateway would make "message me after idle" false.
#
# ONE signal covers desktop + Telegram clients (they share one Ollama): model residency.
# A resident model means someone is mid-conversation — leave everything up. A
# per-unit start grace stops us tearing down a stack that only just came up (the
# few seconds between "ollama started" and "model finished loading").
# =============================================================================
set -uo pipefail

ENGINE_HELPER="/usr/libexec/moai-local-engine"
[ "$("$ENGINE_HELPER" backend)" = "ollama" ] || exit 0
OLLAMA_UNIT="$("$ENGINE_HELPER" unit)"
OLLAMA="http://127.0.0.1:$("$ENGINE_HELPER" port)"
GRACE_SEC="${MOAI_RUNTIME_GRACE_SEC:-120}"

# Model residency: 0 = up but idle (keep-alive expired) → sleep the runtime.
#                  N>0 = active chat → leave everything up.
#                  "missing" = Ollama API unreachable = already down → nothing for it.
resident="$(curl -sf --max-time 4 "$OLLAMA/api/ps" 2>/dev/null \
    | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("models",[])))' 2>/dev/null \
    || echo missing)"

# Only sleep when the model is NOT resident. If a model is loaded, bail entirely.
case "$resident" in
    0|missing) : ;;
    *) exit 0 ;;
esac

# Is the Telegram agent's PRIMARY brain a cloud model? Then the gateway holds no
# local model at all, so ollama residency is a meaningless idle signal for it —
# it would read "idle" forever and stop the gateway every cycle. Worse, stopping
# the gateway kills every app the agent opened (they share its cgroup), which is
# the "apps close by themselves" bug. On a cloud brain, KEEP the gateway (and its
# apps) up; the ollama/speaches sleep below still runs for the desktop's local model.
cloud_primary=0
primary="$(python3 -c 'import json,os
try: print((json.load(open(os.path.expanduser("~/.openclaw/openclaw.json"))).get("agents",{}).get("defaults",{}).get("model",{}) or {}).get("primary",""))
except Exception: print("")' 2>/dev/null)"
case "$primary" in cloud/*) cloud_primary=1 ;; esac

# A linked/enabled WhatsApp channel must keep its WebSocket receiver alive.
# Read only the boolean enable flag; malformed or absent config fails closed to
# the old on-demand behavior. Telegram still uses the lightweight moai-wake path.
whatsapp_enabled="$(python3 -c 'import json,os
try:
 c=json.load(open(os.path.expanduser("~/.openclaw/openclaw.json"))).get("channels",{}).get("whatsapp",{})
 print(1 if isinstance(c,dict) and c.get("enabled") is True else 0)
except Exception: print(0)' 2>/dev/null)"
keep_gateway=0
if [ "$cloud_primary" = 1 ] || [ "$whatsapp_enabled" = 1 ]; then
    keep_gateway=1
fi

stop_unit() {  # stop + normalise, but only if active and past its start grace
    local u="$1" started now start_s
    systemctl --user is-active --quiet "$u" || return 0
    started="$(systemctl --user show "$u" -p ActiveEnterTimestamp --value 2>/dev/null)"
    start_s="$(date -d "$started" +%s 2>/dev/null || echo 0)"
    now="$(date +%s)"
    if [ "$start_s" -gt 0 ] && [ $(( now - start_s )) -lt "$GRACE_SEC" ]; then
        return 0   # just came up — a request is probably still loading the model
    fi
    systemctl --user stop "$u" 2>/dev/null || true
    # openclaw's sandbox teardown can leave the unit "failed" though the stop
    # succeeded; normalise so moai-wake / ensure_local see a clean restartable unit.
    systemctl --user reset-failed "$u" 2>/dev/null || true
    logger -t openclaw-idle "slept $u (Mo AI runtime idle)" 2>/dev/null || true
}

# Sleep the heavy stack, consumer before providers (OpenClaw uses speech/Ollama).
# On a cloud brain, leave the gateway + speaches up (see cloud_primary above) so
# the bot stays responsive and apps it opened are not torn down.
if [ "$keep_gateway" != 1 ]; then
    stop_unit openclaw-gateway.service
    stop_unit speaches.service
    # Compatibility with the first shipped setup-brain Quadlet name.
    stop_unit moai-speech.service
fi
if [ "$resident" = "0" ] && [ "$keep_gateway" != 1 ]; then
    stop_unit "$OLLAMA_UNIT"   # was up but idle → free its RAM + any VRAM
fi
exit 0
