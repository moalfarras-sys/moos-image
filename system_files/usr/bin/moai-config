#!/usr/bin/python3
"""Terminal twin of Mo AI Settings, backed by the one OpenClaw authority."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request


API = os.environ.get("MOAI_AGENT_API_URL", "http://127.0.0.1:8077").rstrip("/")
HEADERS = {"X-Moai-Agent": "1"}


def dialog(*args: str) -> str | None:
    try:
        result = subprocess.run(
            ["kdialog", *args], text=True, capture_output=True, timeout=600,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.rstrip("\n") if result.returncode == 0 else None


def notice(kind: str, message: str) -> None:
    subprocess.run(
        ["kdialog", f"--{kind}", message], check=False,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def request(method: str, path: str, body: dict | None = None) -> dict:
    payload = None if body is None else json.dumps(body).encode("utf-8")
    headers = dict(HEADERS)
    if payload is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(API + path, data=payload, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            value = json.load(response)
    except urllib.error.HTTPError as error:
        try:
            detail = json.load(error).get("error")
        except Exception:
            detail = None
        raise RuntimeError(detail or f"Mo AI API returned HTTP {error.code}") from error
    except (OSError, ValueError) as error:
        raise RuntimeError(f"Mo AI API is unavailable: {error}") from error
    if not isinstance(value, dict):
        raise RuntimeError("Mo AI API returned an invalid response")
    if value.get("error"):
        raise RuntimeError(str(value["error"]))
    return value


def current_config() -> dict:
    subprocess.run(
        ["systemctl", "--user", "start", "moai-agent-api.service"], check=False,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    last_error: Exception | None = None
    for _ in range(30):
        try:
            return request("GET", "/api/config")
        except RuntimeError as error:
            last_error = error
            time.sleep(0.2)
    raise RuntimeError(str(last_error or "Mo AI API did not start"))


def choose_cloud(config: dict) -> dict | None:
    providers = config.get("providers") or []
    if not isinstance(providers, list) or not providers:
        raise RuntimeError("Mo AI returned no cloud-provider catalog")
    menu: list[str] = []
    by_id: dict[str, dict] = {}
    for item in providers:
        if not isinstance(item, dict) or not item.get("id"):
            continue
        provider_id = str(item["id"])
        by_id[provider_id] = item
        menu.extend((provider_id, str(item.get("name") or provider_id)))
    provider_id = dialog(
        "--title", "Mo AI — Cloud", "--menu",
        "اختر المزوّد | Choose provider:", *menu,
    )
    if provider_id is None:
        return None
    provider = by_id.get(provider_id)
    if provider is None:
        raise RuntimeError("Unknown provider selection")
    current = config.get("cloud") or {}
    base_default = str(current.get("base") or provider.get("base") or "")
    model_default = str(current.get("model") or provider.get("model") or "")
    base = dialog(
        "--title", "Mo AI — Cloud", "--inputbox",
        "عنوان الخدمة | API base URL:", base_default,
    )
    if base is None:
        return None
    model = dialog(
        "--title", "Mo AI — Cloud", "--inputbox",
        "اسم النموذج | Model name:", model_default,
    )
    if model is None:
        return None
    key = dialog(
        "--title", "Mo AI — Cloud", "--password",
        "مفتاح API (اتركه فارغًا للاحتفاظ بالمفتاح الحالي) | "
        "API key (leave blank to keep the current key):",
    )
    if key is None:
        return None
    if not key and not bool(current.get("has_key")):
        raise RuntimeError("No API key is configured")
    cloud = {"provider": provider_id, "base": base, "model": model}
    if key:
        cloud["key"] = key
    return {"mode": "cloud", "cloud": cloud}


def main() -> int:
    if not shutil_which("kdialog"):
        print("kdialog required", file=sys.stderr)
        return 1
    try:
        config = current_config()
        mode = dialog(
            "--title", "Mo AI — العقل | Brain", "--menu",
            "اختر عقل Mo AI | Choose Mo AI's brain:",
            "local", "محلي وخاص | Local & private",
            "cloud", "سحابي | Cloud",
            "hybrid", "هجين | Hybrid",
        )
        if mode is None:
            return 0
        if mode == "cloud":
            body = choose_cloud(config)
            if body is None:
                return 0
        elif mode == "local":
            brain = config.get("brain") or {}
            body = {
                "mode": "local",
                "local_model": brain.get("local_model", "ollama/default"),
            }
        else:
            body = {"mode": "hybrid"}
        request("POST", "/api/config", body)
        notice("msgbox", "تم حفظ إعداد Mo AI ✓ | Mo AI setting saved ✓")
        return 0
    except RuntimeError as error:
        notice(
            "error",
            f"تعذر حفظ إعداد Mo AI.\nMo AI setting was not saved.\n\n{error}",
        )
        return 1


def shutil_which(name: str) -> str | None:
    """Small PATH lookup without importing a module solely for one call."""
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


if __name__ == "__main__":
    raise SystemExit(main())
