#!/usr/bin/env bash
# moai-config — choose Mo AI's DEFAULT brain and (optionally) configure a cloud
# provider. The terminal twin of Mo AI's Settings sheet.
#
# Writes non-secret provider settings to ~/.config/moai/config.json (chmod 600).
# The API key is stored only in Mo AI's private XDG data file (0700 directory,
# 0600 file), entered by the USER in a kdialog password field, and read only by
# moai-gateway — never by the pure-QML app or config.json.
#
# `mode` is only the DEFAULT now. moai-gateway is a single always-on front door on
# 8080 and routes each REQUEST: Mo AI's chat picker chooses local or cloud per
# conversation, and only a request that names no brain falls back to what is set
# here. So nothing is enabled or disabled below — the days of stopping one brain
# to start the other are over; that is what made this a global setting in the
# first place.
set -uo pipefail

cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/moai"
cfg="${cfg_dir}/config.json"
credential_store="${MOAI_CREDENTIAL_STORE:-/usr/libexec/moai-credential-store}"
mkdir -p "$cfg_dir" 2>/dev/null || true

command -v kdialog >/dev/null 2>&1 || { echo "kdialog required"; exit 1; }

mode=$(kdialog --title "Mo AI — العقل | Brain" \
    --menu "اختر عقل Mo AI | Choose Mo AI's brain:" \
        local "محلي وخاص (RamaLama) | Local & private" \
        cloud "سحابي (مفتاحك الخاص) | Cloud (your own API key)" 2>/dev/null) || exit 0

# MERGE, never overwrite. Choosing "local" used to write {"cloud_base": "",
# "cloud_model": ""} over the file and throw the user's provider away — which was
# survivable only while local and cloud were mutually exclusive. They are not any
# more: a default of local and a working cloud provider is now an ordinary state,
# and picking a default must not delete the other brain.
write_cfg() {  # write_cfg <mode> [base] [model]
    MOAI_MODE="$1" MOAI_BASE="${2-}" MOAI_MODEL="${3-}" python3 - "$cfg" <<'PY'
import json, os, sys
p = sys.argv[1]
try:
    with open(p, encoding="utf-8") as f:
        cur = json.load(f)
except Exception:
    cur = {}
cur.pop("cloud_key", None)          # the key lives in private XDG data, nowhere else
cur["mode"] = os.environ.get("MOAI_MODE") or "local"
for field, var in (("cloud_base", "MOAI_BASE"), ("cloud_model", "MOAI_MODEL")):
    value = os.environ.get(var) or ""
    if value:
        cur[field] = value
    cur.setdefault(field, "")
cur.setdefault("cloud_wire", "openai")
with open(p, "w", encoding="utf-8") as f:
    json.dump(cur, f, ensure_ascii=False, indent=2)
PY
    chmod 600 "$cfg" 2>/dev/null || true
}

# The front door must be up whichever brain is the default — it is the only thing
# on 8080 and the only thing Mo AI talks to.
systemctl --user enable --now moai-gateway.service 2>/dev/null || true

if [ "$mode" = "cloud" ]; then
    base=$(kdialog --title "Mo AI — Cloud" \
        --inputbox $'عنوان الخدمة (OpenAI-compatible) | API base URL:\nمثال | e.g.  https://openrouter.ai/api/v1' \
        "https://openrouter.ai/api/v1" 2>/dev/null) || exit 0
    model=$(kdialog --title "Mo AI — Cloud" \
        --inputbox $'اسم النموذج | Model name:\nمثال | e.g.  anthropic/claude-sonnet-5  ·  openai/gpt-4o-mini' \
        "anthropic/claude-sonnet-5" 2>/dev/null) || exit 0
    key=$(kdialog --title "Mo AI — Cloud" \
        --password $'مفتاح الـ API الخاص بك (يُحفظ محلياً فقط) | Your API key (stored locally only):' 2>/dev/null) || exit 0
    if [ -z "$key" ]; then
        kdialog --sorry "لم تُدخل مفتاحاً — بقي العقل محلياً. | No key entered — staying local." || true
        write_cfg local
        exit 0
    fi
    if [ ! -x "$credential_store" ] || ! \
        printf '%s' "$key" | "$credential_store" set; then
        kdialog --error $'تعذر حفظ المفتاح في مخزن Mo AI الخاص.\nThe key could not be saved in Mo AI private storage.' || true
        exit 1
    fi
    key=""
    write_cfg cloud "$base" "$model"
    kdialog --title "Mo AI" --msgbox $'العقل السحابي هو الافتراضي ✓ (بإمكانك اختيار العقل لكل محادثة من داخل Mo AI)\nCloud is now the default brain ✓ (pick a brain per conversation inside Mo AI)' || true
else
    # Keep the cloud provider on file. It is the DEFAULT that changed, not the
    # user's account — and the chat picker can still route a message to it.
    write_cfg local
    kdialog --title "Mo AI" --msgbox $'العقل المحلي هو الافتراضي ✓ (بإمكانك اختيار العقل لكل محادثة من داخل Mo AI)\nLocal is now the default brain ✓ (pick a brain per conversation inside Mo AI)' || true
fi
exit 0
