#!/usr/bin/env bash
# moai-config — Mo AI's settings are a page of System Settings: MoOS → Mo AI
# (kcm_moos_ai). The cloud provider and the model, the write-only key, the free-model
# measurement, the phone channels and the permissions all live there, and the page is a
# client of moai-agent-api, the one owner of that configuration.
#
# This name stays for the scripts and habits that call it, and it does exactly one thing:
# it opens that page. It never reads or writes the configuration itself, never asks for
# a key, and has no wizard any more — two front ends for one secret was one too many.
set -euo pipefail
printf '%s\n' 'Mo AI: الإعدادات في «إعدادات النظام ← MoOS ← Mo AI» | settings are in System Settings → MoOS → Mo AI'
exec moos-settings --section=assistant
