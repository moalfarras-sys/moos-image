#!/usr/bin/env bash
# moos-ensure-brain — make Mo AI's local brain the FAST instruct model, idempotently.
#
# The desktop chat must not run a *thinking* model: it forces 3700+ reasoning
# tokens (~97 s) on trivial turns and ignores the app's system prompt. This
# builds moai-brain/default from the shipped Modelfile (Qwen2.5-7B-Instruct,
# GPU-resident on 8 GB, <0.5 s replies) the first time — or after an update that
# re-introduced a thinking model. Failure-tolerant: if anything goes wrong the
# existing brain is left untouched, so Mo AI never ends up with NO brain.
set -u
OLLAMA="http://127.0.0.1:11434"
CT="$(podman ps --format '{{.Names}}' 2>/dev/null | grep -ixE 'ollama|moai-brain' | head -1)"

# ── Which brain this MACHINE should run ──────────────────────────────────────
#
# There is no single best model, because MoOS runs on two very different
# machines and the right answer is opposite on each. Both of these were MEASURED
# through the real gateway, in Arabic, on a real repair question — the same bar
# moai-control's picker holds (see RECOMMENDED_LOCAL there):
#
#   qwen3:8b            the best Arabic of everything tried, and the best at code
#                       and repair with it: correct commands AND correct
#                       explanations. It wants a real GPU.
#   qwen2.5:7b-instruct fast, instruct-only, no hidden thinking. On a GPU-less
#                       box it is measurably faster, and Mo AI's own error text
#                       already tells the user so.
#
# So pick by what the machine actually has, rather than shipping one constant
# that is wrong on half the installs. A card with less than ~7.5 GB is NOT
# enough: the brain has to stay GPU-resident, and this image has a long history
# of a spilled model taking the desktop down with it (moos-gpu-headroom exists
# because kwin_wayland died on `NVRM: invalid mmap context` when VRAM ran out).
#
# NOT qwen2.5-coder:7b, however tempting "coder" sounds for a development brain:
# it writes excellent one-liners and its ARABIC IS BROKEN — measured emitting
# "الملفات الممكدة" (not a phrase) and inventing an `lsof -m` flag that does not
# exist. A brain that cannot hold a sentence in Arabic fails MoOS's bilingual
# contract no matter how well it codes. That rejection is recorded in
# moai-control and this must not quietly undo it.
# ── WHY THE GPU-LESS BOX NOW GETS QWEN3 TOO (this used to say otherwise) ─────
#
# The split above was written when the GPU-less machine was assumed to need the
# cheaper model. Re-measured on the CPU-only server, both at num_thread 6, same
# Arabic sysadmin question and the same bash task:
#
#   qwen2.5:7b-instruct   9.14 tok/s   ARABIC IS BROKEN. Asked in Arabic about a
#                         dangerous `find -exec rm`, it replied
#                           "هذا الأمر يبحث عن جميع ملفات日记记录文件 … 使用前请三思"
#                         — Chinese, mid-sentence, in an Arabic answer. It also
#                         reached for sudo in a script that did not need it.
#   qwen3:8b (no think)   7.79 tok/s   Clean Arabic, correct three sentences,
#                         better script, and a CLEANER tool call: it emits the
#                         call alone, where qwen2.5 prepends a paragraph of
#                         chatter to every one.
#
# So the honest trade is 15% speed for a brain that can hold a sentence in the
# user's own language. On a bilingual OS that is not a trade, it is a bug fix —
# and it is the same reason qwen2.5-coder was rejected in moai-control. The 15%
# is also affordable only because the thread cap and the desktop's render fix
# below took generation from 0.47 to 8.5 tok/s; do not restore this split without
# re-measuring both halves.
#
# CONDITION: qwen3 must never be allowed to THINK on this hardware. Measured, one
# sentence of Arabic: 45s and 1184 characters of hidden reasoning with thinking
# on, 4s with it off. Ollama 0.32 has no Modelfile switch for it ("unknown
# parameter 'think'"), so the guarantee lives in the two callers instead —
# moai-gateway sends reasoning_effort:"none", OpenClaw sends think:false. If you
# change either, this choice stops being safe.
pick_brain() {
    # RAM, not VRAM, is the binding constraint once there is no GPU: qwen3:8b is
    # ~5.2 GB against qwen2.5's ~4.7 GB, and a machine that cannot hold it will
    # swap the weights out mid-token, which costs far more than the model gains.
    local ram_mib=0
    ram_mib="$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)"
    if [ "${ram_mib:-0}" -lt 7500 ] 2>/dev/null; then
        printf 'qwen2.5:7b-instruct'
    else
        printf 'qwen3:8b'
    fi
}

# ── How many CPU threads the brain may take ──────────────────────────────────
#
# llama.cpp synchronises its workers with a SPIN barrier: every thread busy-waits
# at the end of each layer until the slowest one arrives. So if even one thread
# loses its core to another process, the whole forward pass stalls — the cost is
# not proportional, it is a collapse. Ollama's default is one thread per core,
# which on any machine that also draws a desktop is permanently oversubscribed.
#
# MEASURED on the GPU-less box (8 cores, qwen2.5:7b-instruct Q4, same prompt):
#     num_thread = 8 (ollama default) →  0.47 tok/s
#     num_thread = 5                  →  6.77 tok/s   ← 14x, same model
# Leaving two cores for the compositor, the gateway and whatever else the user is
# doing is worth more than the two cores are worth to inference. Do NOT "optimise"
# this back up to nproc: the higher number measures slower on a real desktop.
brain_threads() {
    local n; n="$(nproc 2>/dev/null || echo 4)"
    if [ "${n:-4}" -le 4 ]; then printf '%s' "${n:-4}"; else printf '%s' "$((n - 2))"; fi
}
THREADS="$(brain_threads)"

BASE="${MOOS_BRAIN_MODEL:-$(pick_brain)}"
# One Modelfile per brain: they need the same num_ctx contract but not the same
# base, and a Modelfile that names the wrong base would silently rebuild the
# machine's brain into the other one on every login.
MF="/usr/share/moos/containers/moai-brain.Modelfile"
case "$BASE" in
    qwen3:8b) MF="/usr/share/moos/containers/moai-brain-gpu.Modelfile" ;;
esac

log(){ echo "moos-ensure-brain: $*"; }

# Keep OpenClaw's context budget in lockstep with the model's num_ctx. The desktop
# chat sends a short prompt, but the SAME shared model serves the Telegram agent
# (OpenClaw) whose system+tools prompt is ~11.5k tokens. If openclaw.json still
# says contextTokens 14336 / reserve 4096 (prompt budget 10240) while the model is
# 16384, the agent's precheck computes a budget smaller than its own base prompt
# and every Telegram turn dies with "Context overflow (precheck)". Idempotent;
# atomic write; leaves the file untouched if already correct or absent.
reconcile_openclaw_ctx() {
    local cfg="${HOME}/.openclaw/openclaw.json"
    [ -f "$cfg" ] || return 0
    if python3 - "$cfg" 2>/dev/null <<'PY'
import json,os,sys
p=sys.argv[1]
try: c=json.load(open(p))
except Exception: sys.exit(0)
CTX=24576; RESERVE=2048; MAXOUT=2048; changed=False
ad=c.setdefault("agents",{}).setdefault("defaults",{})
primary=(ad.get("model",{}) or {}).get("primary","")
local_primary = primary.startswith("ollama/") or primary in ("", "default")
# Only pin the AGENT context budget to the small local ceiling when the local
# brain is actually primary. A cloud brain (e.g. gpt-5.x) has a far larger window,
# and forcing 24576 there causes needless overflow/compaction and empty replies —
# leave the cloud budget alone.
if local_primary:
    if ad.get("contextTokens")!=CTX: ad["contextTokens"]=CTX; changed=True
    comp=ad.setdefault("compaction",{})
    for k in ("reserveTokens","reserveTokensFloor"):
        if comp.get(k)!=RESERVE: comp[k]=RESERVE; changed=True
# The ollama model's own window is model-specific — always keep it in lockstep.
for m in c.get("models",{}).get("providers",{}).get("ollama",{}).get("models",[]):
    if m.get("id")=="default" or m.get("name")=="default":
        if m.get("contextWindow")!=CTX: m["contextWindow"]=CTX; changed=True
        if m.get("maxTokens")!=MAXOUT: m["maxTokens"]=MAXOUT; changed=True
if changed:
    tmp=p+".tmp"
    with open(tmp,"w",encoding="utf-8") as fh:
        json.dump(c,fh,ensure_ascii=False,indent=2)
    os.chmod(tmp,0o600)
    os.replace(tmp,p)
    print("changed")
PY
    then log "openclaw context reconciled (local brain → 24576; cloud left as-is)"; fi
}

[ -f "$MF" ] || { log "no Modelfile — nothing to do"; exit 0; }

# openclaw.json reconciliation needs no model server, so do it BEFORE the "no
# container" skip: on an on-demand system ollama is down at login, and we still
# want the context budget healed so the first Telegram turn does not overflow.
reconcile_openclaw_ctx

[ -n "$CT" ] || { log "ollama container not running — skip"; exit 0; }

# Wait (bounded) for the API.
for _ in $(seq 1 30); do curl -sf "$OLLAMA/api/tags" >/dev/null 2>&1 && break; sleep 2; done
curl -sf "$OLLAMA/api/tags" >/dev/null 2>&1 || { log "ollama API not up — skip"; exit 0; }

# Already the RIGHT brain, and wide enough? Then this is a no-op.
#
# The check is against the model this machine should be running, not against a
# hardcoded family. It used to grep for "qwen2.5" unconditionally, which on a
# GPU machine would have declared the correct qwen3:8b brain "wrong" and
# rebuilt it down to the CPU model on every single login.
# (openclaw.json is still reconciled above — it drifts independently of the model.)
want="$(printf '%s' "$BASE" | cut -d: -f1)"
show="$(curl -sf "$OLLAMA/api/show" -d '{"model":"default"}' 2>/dev/null)"
ctx="$(printf '%s' "$show" | grep -oE 'num_ctx[^0-9]*[0-9]+' | grep -oE '[0-9]+' | tail -1)"
# num_thread is part of "correct" too: a brain built before this machine's core
# count was taken into account runs at a fraction of its speed, and nothing else
# in the system would ever notice or heal it.
thr="$(printf '%s' "$show" | grep -oE 'num_thread[^0-9]*[0-9]+' | grep -oE '[0-9]+' | tail -1)"
if printf '%s' "$show" | grep -qi "$want" && [ "${ctx:-0}" -ge 24576 ] && [ "${thr:-0}" -eq "$THREADS" ]; then
    log "brain already correct for this machine (${BASE}, num_ctx ${ctx}, num_thread ${thr}) — nothing to do"
    exit 0
fi
log "this machine should run ${BASE} (Modelfile: $(basename "$MF"))"

# Ensure the base model is present (pull only if missing; tolerate no network).
if ! curl -sf "$OLLAMA/api/tags" 2>/dev/null | grep -q "$BASE"; then
    log "pulling $BASE …"
    podman exec "$CT" ollama pull "$BASE" >/dev/null 2>&1 || { log "pull failed — leaving current brain"; exit 0; }
fi

# Build the fast brain from the shipped Modelfile, then repoint the served tags.
#
# num_thread is appended here rather than baked into the Modelfile because it is
# the one parameter that depends on the MACHINE, not on the model: the same
# Modelfile ships to every install, and a hardcoded thread count would be wrong
# on all but one of them.
BUILD_MF="$(mktemp)" || exit 0
trap 'rm -f "$BUILD_MF"' EXIT
{ cat "$MF"; printf '\nPARAMETER num_thread %s\n' "$THREADS"; } > "$BUILD_MF" || exit 0
log "building for this machine: num_thread ${THREADS} of $(nproc 2>/dev/null || echo '?') cores"
podman cp "$BUILD_MF" "$CT":/tmp/moai-brain.Modelfile >/dev/null 2>&1 || exit 0
if podman exec "$CT" ollama create moai-brain -f /tmp/moai-brain.Modelfile >/dev/null 2>&1; then
    podman exec "$CT" ollama cp moai-brain default >/dev/null 2>&1
    log "fast brain built and served (moai-brain/default → $BASE)"
else
    log "create failed — leaving current brain"
fi
exit 0
