#!/usr/bin/python3
"""moos-control — instant, reversible control of this computer.

WHY: Mo AI could repair, update and install software (moai-do), but not do the
everyday things people ask an assistant for: turn it down, dim the screen, night
light on, take a screenshot. Each action here runs as the logged-in user with no
privilege, maps to ONE fixed argv (never a shell, never free text) and is undone
by its opposite. moos-open exposes them as moos://control/… routes; Mo AI shows
them as buttons, and nothing runs until the user taps one.

The desktop verbs (window, arrange, desktop, dnd, keyboard-layout, power-profile) drive
the desktop the way its own shortcuts and applets do: a FIXED action name invoked through
the global-shortcut service, or one fixed D-Bus method. Nothing here can load a script,
close a window or restart the compositor, and no verb takes free text.

Exit codes: 0 done, 2 invalid request, 69 that control is unavailable here.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

EX_USAGE = 2
EX_UNAVAILABLE = 69
SINK = "@DEFAULT_AUDIO_SINK@"
STEP = 10
BRIGHTNESS_SERVICE = "org.kde.ScreenBrightness"
BRIGHTNESS_PATH = "/org/kde/ScreenBrightness"
# `status` answers a person waiting for an answer (Mo AI calls it as a
# read-only tool), so the whole read is bounded. Any single probe that cannot
# answer inside what is left of the budget is reported unknown, never waited on.
STATUS_BUDGET = 8.0
THEMES = ("dark", "light", "nova", "amethyst", "midnight", "aurora", "auto")


def _settings_pages():
    """The pages Mo AI offers (moai: true in the one settings registry, SPEC D3).

    Each is a fixed route in moos-open, which opens the page. A registry that is missing
    or malformed offers NO page: the settings verb then reports itself unavailable, and
    every other verb keeps working.
    """
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib/moos"))
        import moos_settings_destinations as destinations
    except ImportError:
        return ()
    finally:
        sys.path.pop(0)
    registry = Path(__file__).resolve().parent.parent / "share/moos/settings-destinations.json"
    return destinations.moai_tokens(destinations.safe_load(registry))


SETTINGS_PAGES = _settings_pages()

# ── The desktop's own actions, by their fixed names ─────────────────────────
# Measured on the station (Plasma 6.7.5, 2026-09-24) in `shortcutNames` of each
# component. Each call is checked against that list first, so a renamed action is
# reported unavailable instead of silently doing nothing.
ACCEL = ("org.kde.kglobalaccel", "org.kde.kglobalaccel.Component")
WINDOW_COMPONENT = "/component/kwin"
SHELL_COMPONENT = "/component/plasmashell"
WINDOW_VIEWS = {"overview": "Overview", "grid": "Grid View", "show-desktop": "Show Desktop"}
# Registered by MoOS's own window-arrangement script (usr/share/kwin/scripts/moos-arrange).
ARRANGEMENTS = {kind: f"MoOS Arrange: {kind}"
                for kind in ("halves", "thirds", "quarters", "main", "centre")}
DESKTOP_STEPS = {"next": "nextDesktop", "previous": "previousDesktop"}
# The notifications applet's own toggle. Invoking it runs the applet's logic, so the
# desktop records the change itself (plasmanotifyrc [DoNotDisturb] Until) — measured:
# the notification server's Inhibited property follows it both ways.
DND_ACTION = "toggle do not disturb"
NOTIFICATIONS = ("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                 "org.freedesktop.Notifications")
SOURCE = "@DEFAULT_AUDIO_SOURCE@"
LAYOUTS = ("org.kde.keyboard", "/Layouts", "org.kde.KeyboardLayouts")
MOTION = ("still", "gentle", "alive")
CLARITY = ("clear", "balanced", "solid")
# Through the power manager's own action, the one the battery applet uses; the
# profile daemon allows the active session to switch without a password (measured).
POWER = ("org.kde.Solid.PowerManagement",
         "/org/kde/Solid/PowerManagement/Actions/PowerProfile",
         "org.kde.Solid.PowerManagement.Actions.PowerProfile")
POWER_PROFILES = ("power-saver", "balanced", "performance")
APP_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{2,254}")
DISPLAY_NAME = re.compile(r"[A-Za-z0-9_]{1,64}")

USAGE = """moos-control — تحكّم فوري بالجهاز | instant control of this computer

  moos-control status
  moos-control volume <0-100|up|down>
  moos-control mute | unmute
  moos-control brightness <5-100|up|down>
  moos-control night-light <on|off|auto>
  moos-control wifi <on|off>
  moos-control bluetooth <on|off>
  moos-control screenshot
  moos-control theme <dark|light|nova|amethyst|midnight|aurora|auto>
  moos-control open <installed-app-id>
  moos-control settings <page>
  moos-control window <overview|grid|show-desktop>
  moos-control arrange <halves|thirds|quarters|main|centre>
  moos-control desktop <next|previous>
  moos-control dnd <on|off>
  moos-control mic <mute|unmute>
  moos-control keyboard-layout next
  moos-control motion <still|gentle|alive>
  moos-control clarity <clear|balanced|solid>
  moos-control power-profile <power-saver|balanced|performance>
"""


class Invalid(Exception):
    pass


class Unavailable(Exception):
    pass


def run(argv, timeout=30):
    if shutil.which(argv[0]) is None:
        raise Unavailable(f"{argv[0]} is not installed")
    try:
        # stdin is closed: bluetoothctl and friends drop into an interactive
        # REPL when they inherit a terminal, and a control action never reads.
        result = subprocess.run(argv, capture_output=True, text=True,
                                timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as error:
        raise Unavailable(f"{argv[0]} did not answer") from error
    if result.returncode != 0:
        raise Unavailable((result.stderr or result.stdout or f"{argv[0]} failed").strip())
    return result.stdout


def spawn(argv):
    """Start a long-running action (a theme change, an app) detached."""
    if shutil.which(argv[0]) is None:
        raise Unavailable(f"{argv[0]} is not installed")
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def audit(message):
    if shutil.which("logger"):
        subprocess.run(["logger", "-t", "moos-control", message],
                       capture_output=True, timeout=5)


def level(value, low, high, what):
    if not re.fullmatch(r"[0-9]{1,3}", value or "") or not low <= int(value) <= high:
        raise Invalid(f"{what} must be {low}-{high}, up or down")
    return int(value)


def one_of(value, choices, what):
    if value not in choices:
        raise Invalid(f"{what} must be one of: {', '.join(choices)}")
    return value


# ── Volume (PipeWire default output) ────────────────────────────────────────
def volume_state(timeout=30):
    out = run(["wpctl", "get-volume", SINK], timeout=timeout)
    match = re.search(r"Volume:\s*([0-9.]+)", out)
    return (round(float(match.group(1)) * 100) if match else None), "[MUTED]" in out


def volume(value):
    if value in ("up", "down"):
        change = f"{STEP}%{'+' if value == 'up' else '-'}"
    else:
        change = f"{level(value, 0, 100, 'volume') / 100:.2f}"
    run(["wpctl", "set-volume", "-l", "1.0", SINK, change])
    # Asking for a volume means wanting to hear it.
    run(["wpctl", "set-mute", SINK, "0"])
    now, _ = volume_state()
    return f"🔊 الصوت {now}% | Volume {now}%"


def mute(on):
    run(["wpctl", "set-mute", SINK, "1" if on else "0"])
    return "🔇 تم كتم الصوت | Muted" if on else "🔊 أُلغي الكتم | Unmuted"


# ── Brightness (Plasma ScreenBrightness: laptop panels and DDC monitors) ────
def busctl_data(*args, timeout=30):
    out = run(["busctl", "--user", "--json=short", *args], timeout=timeout)
    try:
        return json.loads(out)["data"]
    except (ValueError, KeyError, TypeError) as error:
        raise Unavailable(f"unexpected reply from {args[1] if len(args) > 1 else 'the bus'}") \
            from error


def displays(timeout=30):
    names = busctl_data("get-property", BRIGHTNESS_SERVICE, BRIGHTNESS_PATH,
                        BRIGHTNESS_SERVICE, "DisplaysDBusNames", timeout=timeout)
    found = [name for name in (names or [])
             if isinstance(name, str) and DISPLAY_NAME.fullmatch(name)]
    if not found:
        raise Unavailable("no screen with adjustable brightness")
    return found


def display_value(name, prop, timeout=30):
    return int(busctl_data("get-property", BRIGHTNESS_SERVICE, f"{BRIGHTNESS_PATH}/{name}",
                           BRIGHTNESS_SERVICE + ".Display", prop, timeout=timeout))


def brightness(value):
    target = None if value in ("up", "down") else level(value, 5, 100, "brightness") / 100
    applied = []
    for name in displays():
        maximum = display_value(name, "MaxBrightness")
        if maximum <= 0:
            continue
        if target is None:
            ratio = display_value(name, "Brightness") / maximum
            ratio += STEP / 100 if value == "up" else -STEP / 100
        else:
            ratio = target
        # Never all the way to black: 5% is the floor on every screen.
        ratio = min(1.0, max(0.05, ratio))
        run(["busctl", "--user", "call", BRIGHTNESS_SERVICE, f"{BRIGHTNESS_PATH}/{name}",
             BRIGHTNESS_SERVICE + ".Display", "SetBrightness", "iu",
             str(round(ratio * maximum)), "0"])
        applied.append(round(ratio * 100))
    if not applied:
        raise Unavailable("no screen with adjustable brightness")
    return f"☀ السطوع {applied[0]}% | Brightness {applied[0]}%"


# ── Night light (KWin) ──────────────────────────────────────────────────────
def night_light(value):
    one_of(value, ("on", "off", "auto"), "night-light")
    write = ["kwriteconfig6", "--file", "kwinrc", "--group", "NightColor"]
    run([*write, "--key", "Active", "--type", "bool", "false" if value == "off" else "true"])
    if value != "off":
        # Constant is warm now; DarkLight is Plasma's own day/night schedule.
        run([*write, "--key", "Mode", "Constant" if value == "on" else "DarkLight"])
    # reconfigure is a no-reply method; waiting for an answer would only time out.
    run(["busctl", "--user", "--expect-reply=no", "call", "org.kde.KWin", "/KWin",
         "org.kde.KWin", "reconfigure"])
    return {"on": "🌙 الضوء الليلي يعمل | Night light on",
            "off": "☀ الضوء الليلي متوقف | Night light off",
            "auto": "🌗 الضوء الليلي تلقائي | Night light automatic"}[value]


# ── Radios ──────────────────────────────────────────────────────────────────
def wifi(value):
    one_of(value, ("on", "off"), "wifi")
    run(["nmcli", "radio", "wifi", value])
    return "📶 الواي فاي يعمل | Wi-Fi on" if value == "on" else "📴 الواي فاي متوقف | Wi-Fi off"


def bluetooth(value):
    one_of(value, ("on", "off"), "bluetooth")
    if value == "on" and shutil.which("rfkill"):
        # A soft block makes "power on" fail; lifting it is best-effort.
        subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True, timeout=10)
    run(["bluetoothctl", "power", value])
    return "🔵 البلوتوث يعمل | Bluetooth on" if value == "on" else "⚪ البلوتوث متوقف | Bluetooth off"


# ── Screenshot ──────────────────────────────────────────────────────────────
def pictures_dir():
    try:
        out = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True,
                             text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    return Path(out) if out else Path.home() / "Pictures"


def screenshot():
    folder = pictures_dir() / "Screenshots"
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / f"MoOS-{datetime.now():%Y%m%d-%H%M%S}.png"
    run(["spectacle", "--background", "--nonotify", "--fullscreen", "--output", str(target)])
    return f"📸 حُفظت اللقطة | Screenshot saved: {target}"


# ── Theme and apps: the same fixed actions moos-open already offers ─────────
def theme(value):
    one_of(value, THEMES, "theme")
    spawn(["moos-theme", value])
    return f"🎨 المظهر: {value} | Theme: {value}"


def data_dirs():
    home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    shared = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [home, *(Path(item) for item in shared.split(":") if item)]


def open_app(value):
    if not APP_ID.fullmatch(value or ""):
        raise Invalid("invalid app id")
    if shutil.which("flatpak") and subprocess.run(
            ["flatpak", "info", value], capture_output=True, timeout=15).returncode == 0:
        spawn(["flatpak", "run", value])
    elif any((base / "applications" / f"{value}.desktop").is_file() for base in data_dirs()):
        spawn(["gtk-launch", value])
    else:
        raise Unavailable(f"app is not installed: {value}")
    return f"🚀 فتح {value} | Opening {value}"


def settings(value):
    if not SETTINGS_PAGES:
        raise Unavailable("the settings list cannot be read")
    one_of(value, SETTINGS_PAGES, "settings page")
    spawn(["moos-open", f"moos://settings/{value}"])
    return f"⚙ فتح الإعدادات: {value} | Opening settings: {value}"


# ── Windows and desktops (the window manager's own actions) ─────────────────
def invoke_shortcut(component, name, timeout=15):
    """Run one of the desktop's registered actions by its fixed name.

    The name is looked up in the component's own list first: a renamed or missing action
    is "unavailable", never a call into the void that reports success.
    """
    service, interface = ACCEL
    listed = busctl_data("call", service, component, interface, "shortcutNames",
                         timeout=timeout)
    names = listed[0] if listed and isinstance(listed[0], list) else []
    if name not in names:
        raise Unavailable(f"this desktop has no '{name}' action")
    run(["busctl", "--user", "call", service, component, interface,
         "invokeShortcut", "s", name], timeout=timeout)


def window(value):
    one_of(value, tuple(WINDOW_VIEWS), "window")
    invoke_shortcut(WINDOW_COMPONENT, WINDOW_VIEWS[value])
    return {"overview": "🪟 نظرة عامة على النوافذ | Window overview",
            "grid": "🔲 شبكة أسطح المكتب | Desktop grid",
            "show-desktop": "🖥 إظهار سطح المكتب | Show desktop"}[value]


def arrange(value):
    one_of(value, tuple(ARRANGEMENTS), "arrange")
    invoke_shortcut(WINDOW_COMPONENT, ARRANGEMENTS[value])
    return {"halves": "🪟 رُتّبت النوافذ نصفين | Windows arranged in halves",
            "thirds": "🪟 رُتّبت النوافذ أثلاثاً | Windows arranged in thirds",
            "quarters": "🪟 رُتّبت النوافذ أرباعاً | Windows arranged in quarters",
            "main": "🪟 نافذة رئيسية ونافذتان | Main window and two",
            "centre": "🪟 النافذة في المنتصف | Window centred"}[value]


def desktop(value):
    one_of(value, tuple(DESKTOP_STEPS), "desktop")
    run(["busctl", "--user", "call", "org.kde.KWin", "/KWin", "org.kde.KWin",
         DESKTOP_STEPS[value]])
    return ("➡ سطح المكتب التالي | Next desktop" if value == "next"
            else "⬅ سطح المكتب السابق | Previous desktop")


# ── Do not disturb (the notifications applet's own toggle) ──────────────────
def notifications_inhibited(timeout=30):
    return bool(busctl_data("get-property", *NOTIFICATIONS, "Inhibited", timeout=timeout))


def dnd(value):
    one_of(value, ("on", "off"), "dnd")
    wanted = value == "on"
    if notifications_inhibited() != wanted:
        # A toggle, so it is only pressed when the state really differs.
        invoke_shortcut(SHELL_COMPONENT, DND_ACTION)
        deadline = time.monotonic() + 3.0
        while notifications_inhibited() != wanted:
            if time.monotonic() > deadline:
                raise Unavailable("do not disturb did not change")
            time.sleep(0.2)
    return ("🔕 عدم الإزعاج يعمل | Do not disturb on" if wanted
            else "🔔 عدم الإزعاج متوقف | Do not disturb off")


# ── Microphone (PipeWire default input) ─────────────────────────────────────
def mic_muted(timeout=30):
    return "[MUTED]" in run(["wpctl", "get-volume", SOURCE], timeout=timeout)


def mic(value):
    one_of(value, ("mute", "unmute"), "mic")
    run(["wpctl", "set-mute", SOURCE, "1" if value == "mute" else "0"])
    return ("🎙 كُتم الميكروفون | Microphone muted" if value == "mute"
            else "🎙 الميكروفون يعمل | Microphone on")


# ── Keyboard layout (the layout switcher's own interface) ───────────────────
def keyboard_layout(value):
    one_of(value, ("next",), "keyboard-layout")
    service, path, interface = LAYOUTS
    layouts = busctl_data("call", service, path, interface, "getLayoutsList")
    layouts = layouts[0] if layouts and isinstance(layouts[0], list) else []
    if len(layouts) < 2:
        raise Unavailable("only one keyboard layout is set up")
    run(["busctl", "--user", "call", service, path, interface, "switchToNextLayout"])
    index = busctl_data("call", service, path, interface, "getLayout")
    try:
        short, _symbol, name = layouts[int(index[0])]
    except (IndexError, TypeError, ValueError) as error:
        raise Unavailable("the new keyboard layout could not be read back") from error
    return f"⌨ لوحة المفاتيح: {name} | Keyboard layout: {short}"


# ── Motion and glass: the MoOS look's own owner ─────────────────────────────
def motion(value):
    one_of(value, MOTION, "motion")
    run(["moos-theme", "motion", value], timeout=60)
    return f"🌊 حركة الخلفية: {value} | Wallpaper motion: {value}"


def clarity(value):
    one_of(value, CLARITY, "clarity")
    run(["moos-theme", "clarity", value], timeout=60)
    return f"💎 وضوح الزجاج: {value} | Glass clarity: {value}"


# ── Power profile ───────────────────────────────────────────────────────────
def power_profile_now(timeout=30):
    service, path, interface = POWER
    value = busctl_data("call", service, path, interface, "currentProfile", timeout=timeout)
    return value[0] if value and isinstance(value[0], str) else None


def power_profile(value):
    one_of(value, POWER_PROFILES, "power-profile")
    service, path, interface = POWER
    choices = busctl_data("call", service, path, interface, "profileChoices")
    if value not in (choices[0] if choices and isinstance(choices[0], list) else []):
        raise Unavailable(f"this computer has no {value} profile")
    run(["busctl", "--user", "call", service, path, interface, "setProfile", "s", value])
    if power_profile_now() != value:
        raise Unavailable("the power profile did not change")
    return {"power-saver": "🔋 وضع توفير الطاقة | Power saver",
            "balanced": "⚖ الوضع المتوازن | Balanced power",
            "performance": "⚡ وضع الأداء | Performance"}[value]


# ── Status (read-only) ──────────────────────────────────────────────────────
def bluez_running(timeout):
    """Is bluez actually on the bus, without starting it?

    `bluetoothctl show` never returns when bluez has no adapter: it activates
    the service and then waits for an adapter that is never going to appear.
    Measured on the Oracle A1, which has no Bluetooth hardware at all, it was
    still waiting after 25 s while every other probe answered in under 20 ms.
    NameHasOwner is a plain bus query -- it reports absence instead of
    activating bluez, so a machine without Bluetooth costs one round trip.
    """
    out = run(["busctl", "--system", "--json=short", "call",
               "org.freedesktop.DBus", "/org/freedesktop/DBus",
               "org.freedesktop.DBus", "NameHasOwner", "s", "org.bluez"],
              timeout=timeout)
    try:
        return bool(json.loads(out)["data"][0])
    except (ValueError, KeyError, IndexError, TypeError) as error:
        raise Unavailable("unexpected bus reply for org.bluez") from error


def theme_token(package):
    """A MoOS look's short name, or None for anything that is not a MoOS look."""
    if package == "org.moos.ui2":
        return "dark"
    if package == "org.moos.ui2.light":
        return "light"
    if package == "org.moos.ui2.midnight.light":
        return "daylight"
    found = re.fullmatch(r"org\.moos\.ui2\.([a-z]+)(\.light)?", package or "")
    return (found.group(1) + ("-light" if found.group(2) else "")) if found else None


def theme_state(timeout):
    read = ["kreadconfig6", "--file", "kdeglobals", "--group", "KDE", "--key"]
    if run([*read, "AutomaticLookAndFeel"], timeout=timeout).strip() == "true":
        return "auto"
    return theme_token(run([*read, "LookAndFeelPackage"], timeout=timeout).strip())


def status():
    """Read what the desktop can tell us, within one bounded budget.

    Mo AI calls this as a read-only tool while somebody waits, so no probe may
    decide how long the answer takes. Each one gets what is left of
    STATUS_BUDGET; whatever cannot answer in time is reported unknown (null),
    which the callers already render as "not available here".
    """
    deadline = time.monotonic() + STATUS_BUDGET

    def left():
        # Never zero or negative: subprocess.run treats that as "expire now",
        # which would turn a slow probe into a guaranteed failure.
        return max(0.5, deadline - time.monotonic())

    state = {}
    try:
        state["volume"], state["muted"] = volume_state(left())
    except Unavailable:
        state["volume"], state["muted"] = None, None
    try:
        name = displays(left())[0]
        state["brightness"] = round(100 * display_value(name, "Brightness", left())
                                    / max(1, display_value(name, "MaxBrightness", left())))
    except Unavailable:
        state["brightness"] = None
    try:
        state["night_light"] = bool(busctl_data(
            "get-property", "org.kde.KWin", "/org/kde/KWin/NightLight",
            "org.kde.KWin.NightLight", "running", timeout=left()))
    except Unavailable:
        state["night_light"] = None
    try:
        state["wifi"] = run(["nmcli", "radio", "wifi"], timeout=left()).strip() == "enabled"
    except Unavailable:
        state["wifi"] = None
    try:
        # A machine with no Bluetooth at all is unknown (null), not "off":
        # "off" would invite Mo AI to offer a switch that turns nothing on.
        if not bluez_running(left()):
            raise Unavailable("bluez is not on the bus; no Bluetooth here")
        state["bluetooth"] = "Powered: yes" in run(["bluetoothctl", "show"],
                                                   timeout=left())
    except Unavailable:
        state["bluetooth"] = None
    try:
        state["theme"] = theme_state(left())
    except Unavailable:
        state["theme"] = None
    try:
        state["dnd"] = notifications_inhibited(left())
    except Unavailable:
        state["dnd"] = None
    try:
        state["mic_muted"] = mic_muted(left())
    except Unavailable:
        state["mic_muted"] = None
    try:
        state["power_profile"] = power_profile_now(left())
    except Unavailable:
        state["power_profile"] = None
    return json.dumps(state, ensure_ascii=False)


ACTIONS = {
    "volume": (1, volume),
    "brightness": (1, brightness),
    "night-light": (1, night_light),
    "wifi": (1, wifi),
    "bluetooth": (1, bluetooth),
    "theme": (1, theme),
    "open": (1, open_app),
    "settings": (1, settings),
    "window": (1, window),
    "arrange": (1, arrange),
    "desktop": (1, desktop),
    "dnd": (1, dnd),
    "mic": (1, mic),
    "keyboard-layout": (1, keyboard_layout),
    "motion": (1, motion),
    "clarity": (1, clarity),
    "power-profile": (1, power_profile),
    "mute": (0, lambda: mute(True)),
    "unmute": (0, lambda: mute(False)),
    "screenshot": (0, screenshot),
    "status": (0, status),
}


def main(argv):
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(USAGE, end="")
        return 0
    action = ACTIONS.get(argv[0]) if argv else None
    if action is None or len(argv) - 1 != action[0]:
        print(USAGE, end="", file=sys.stderr)
        return EX_USAGE
    try:
        message = action[1](*argv[1:])
    except Invalid as error:
        print(f"moos-control: {error}", file=sys.stderr)
        return EX_USAGE
    except Unavailable as error:
        print(f"moos-control: {error}", file=sys.stderr)
        return EX_UNAVAILABLE
    if argv[0] != "status":
        audit(" ".join(argv))
    print(message)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
