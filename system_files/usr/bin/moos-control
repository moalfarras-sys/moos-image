  moos-control click <single|double>
  moos-control remote <on|off|restart>
  moos-control fast-remote <on|off>
"""


class Invalid(Exception):
    pass


class Unavailable(Exception):
    pass


def run(argv, timeout=30):
    if shutil.which(argv[0]) is None:
        raise Unavailable(f"{argv[0]} is not installed")
    try:
        # stdin is closed: bluetoothctl and friends drop into an interactive
        # REPL when they inherit a terminal, and a control action never reads.
        result = subprocess.run(argv, capture_output=True, text=True,
                                timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as error:
        raise Unavailable(f"{argv[0]} did not answer") from error
    if result.returncode != 0:
        raise Unavailable((result.stderr or result.stdout or f"{argv[0]} failed").strip())
    return result.stdout


# A detached action that dies inside this window never started: its failure is the answer.
# A launcher that hands off and exits 0 (gtk-launch) is a success; one still running is too.
SPAWN_SETTLE = 1.0


def require_display():
    """A window needs a desktop session to appear on.

    Mo AI's tool runner used to start before the session did, with neither variable set:
    System Settings and the apps it "opened" died at once looking for a display, and the
    detached start still printed "Opening…". Without a display the answer is no, out loud.
    """
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        raise Unavailable("no desktop session to show it on "
                          "(WAYLAND_DISPLAY and DISPLAY are unset)")


def spawn(argv):
    """Start a long-running action (a theme change, an app) detached.

    The child is watched for SPAWN_SETTLE seconds: an exit with an error inside that window
    is reported as the verb's failure instead of being hidden behind a success message.
    """
    if shutil.which(argv[0]) is None:
        raise Unavailable(f"{argv[0]} is not installed")
    try:
        child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        raise Unavailable(f"{argv[0]} could not start: {error.strerror or error}") from error
    try:
        code = child.wait(timeout=SPAWN_SETTLE)
    except subprocess.TimeoutExpired:
        return
    if code != 0:
        raise Unavailable(f"{argv[0]} stopped at once (exit {code})")


def audit(message):
    if shutil.which("logger"):
        subprocess.run(["logger", "-t", "moos-control", message],
                       capture_output=True, timeout=5)


def level(value, low, high, what):
    if not re.fullmatch(r"[0-9]{1,3}", value or "") or not low <= int(value) <= high:
        raise Invalid(f"{what} must be {low}-{high}, up or down")
    return int(value)


def one_of(value, choices, what):
    if value not in choices:
        raise Invalid(f"{what} must be one of: {', '.join(choices)}")
    return value


# ── Volume (PipeWire default output) ────────────────────────────────────────
def volume_state(timeout=30):
    out = run(["wpctl", "get-volume", SINK], timeout=timeout)
    match = re.search(r"Volume:\s*([0-9.]+)", out)
    return (round(float(match.group(1)) * 100) if match else None), "[MUTED]" in out


def volume(value):
    if value in ("up", "down"):
        change = f"{STEP}%{'+' if value == 'up' else '-'}"
    else:
        change = f"{level(value, 0, 100, 'volume') / 100:.2f}"
    run(["wpctl", "set-volume", "-l", "1.0", SINK, change])
    # Asking for a volume means wanting to hear it.
    run(["wpctl", "set-mute", SINK, "0"])
    now, _ = volume_state()
    return f"🔊 الصوت {now}% | Volume {now}%"


def mute(on):
    run(["wpctl", "set-mute", SINK, "1" if on else "0"])
    return "🔇 تم كتم الصوت | Muted" if on else "🔊 أُلغي الكتم | Unmuted"


# ── Brightness (Plasma ScreenBrightness: laptop panels and DDC monitors) ────
def busctl_data(*args, timeout=30):
    out = run(["busctl", "--user", "--json=short", *args], timeout=timeout)
    try:
        return json.loads(out)["data"]
    except (ValueError, KeyError, TypeError) as error:
        raise Unavailable(f"unexpected reply from {args[1] if len(args) > 1 else 'the bus'}") \
            from error


def displays(timeout=30):
    names = busctl_data("get-property", BRIGHTNESS_SERVICE, BRIGHTNESS_PATH,
                        BRIGHTNESS_SERVICE, "DisplaysDBusNames", timeout=timeout)
    found = [name for name in (names or [])
             if isinstance(name, str) and DISPLAY_NAME.fullmatch(name)]
    if not found:
        raise Unavailable("no screen with adjustable brightness")
    return found


def display_value(name, prop, timeout=30):
    return int(busctl_data("get-property", BRIGHTNESS_SERVICE, f"{BRIGHTNESS_PATH}/{name}",
                           BRIGHTNESS_SERVICE + ".Display", prop, timeout=timeout))


def brightness(value):
    target = None if value in ("up", "down") else level(value, 5, 100, "brightness") / 100
    applied = []
    for name in displays():
        maximum = display_value(name, "MaxBrightness")
        if maximum <= 0:
            continue
        if target is None:
            ratio = display_value(name, "Brightness") / maximum
            ratio += STEP / 100 if value == "up" else -STEP / 100
        else:
            ratio = target
        # Never all the way to black: 5% is the floor on every screen.
        ratio = min(1.0, max(0.05, ratio))
        run(["busctl", "--user", "call", BRIGHTNESS_SERVICE, f"{BRIGHTNESS_PATH}/{name}",
             BRIGHTNESS_SERVICE + ".Display", "SetBrightness", "iu",
             str(round(ratio * maximum)), "0"])
        applied.append(round(ratio * 100))
    if not applied:
        raise Unavailable("no screen with adjustable brightness")
    return f"☀ السطوع {applied[0]}% | Brightness {applied[0]}%"


# ── Night light (KWin) ──────────────────────────────────────────────────────
def night_light(value):
    one_of(value, ("on", "off", "auto"), "night-light")
    write = ["kwriteconfig6", "--file", "kwinrc", "--group", "NightColor"]
    run([*write, "--key", "Active", "--type", "bool", "false" if value == "off" else "true"])
    if value != "off":
        # Constant is warm now; DarkLight is Plasma's own day/night schedule.
        run([*write, "--key", "Mode", "Constant" if value == "on" else "DarkLight"])
    # reconfigure is a no-reply method; waiting for an answer would only time out.
    run(["busctl", "--user", "--expect-reply=no", "call", "org.kde.KWin", "/KWin",
         "org.kde.KWin", "reconfigure"])
    return {"on": "🌙 الضوء الليلي يعمل | Night light on",
            "off": "☀ الضوء الليلي متوقف | Night light off",
            "auto": "🌗 الضوء الليلي تلقائي | Night light automatic"}[value]


# ── Radios ──────────────────────────────────────────────────────────────────
def wifi(value):
    one_of(value, ("on", "off"), "wifi")
    run(["nmcli", "radio", "wifi", value])
    return "📶 الواي فاي يعمل | Wi-Fi on" if value == "on" else "📴 الواي فاي متوقف | Wi-Fi off"


def bluetooth(value):
    one_of(value, ("on", "off"), "bluetooth")
    if value == "on" and shutil.which("rfkill"):
        # A soft block makes "power on" fail; lifting it is best-effort.
        subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True, timeout=10)
    run(["bluetoothctl", "power", value])
    return "🔵 البلوتوث يعمل | Bluetooth on" if value == "on" else "⚪ البلوتوث متوقف | Bluetooth off"


# ── Screenshot ──────────────────────────────────────────────────────────────
def pictures_dir():
    try:
        out = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True,
                             text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    return Path(out) if out else Path.home() / "Pictures"


def screenshot():
    require_display()
    folder = pictures_dir() / "Screenshots"
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / f"MoOS-{datetime.now():%Y%m%d-%H%M%S}.png"
    run(["spectacle", "--background", "--nonotify", "--fullscreen", "--output", str(target)])
    return f"📸 حُفظت اللقطة | Screenshot saved: {target}"


# ── Theme and apps: the same fixed actions moos-open already offers ─────────
def theme(value):
    one_of(value, THEMES, "theme")
    spawn(["moos-theme", value])
    return f"🎨 المظهر: {value} | Theme: {value}"


def data_dirs():
    home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    shared = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [home, *(Path(item) for item in shared.split(":") if item)]


def open_app(value):
    if not APP_ID.fullmatch(value or ""):
        raise Invalid("invalid app id")
    if shutil.which("flatpak") and subprocess.run(
            ["flatpak", "info", value], capture_output=True, timeout=15).returncode == 0:
        command = ["flatpak", "run", value]
    elif any((base / "applications" / f"{value}.desktop").is_file() for base in data_dirs()):
        command = ["gtk-launch", value]
    else:
        raise Unavailable(f"app is not installed: {value}")
    require_display()
    spawn(command)
    return f"🚀 فتح {value} | Opening {value}"


def settings(value):
    if not SETTINGS_PAGES:
        raise Unavailable("the settings list cannot be read")
    one_of(value, SETTINGS_PAGES, "settings page")
    require_display()
    spawn(list(SETTINGS_COMMANDS[value]))
    return f"⚙ فتح الإعدادات: {value} | Opening settings: {value}"


# ── Windows and desktops (the window manager's own actions) ─────────────────
def invoke_shortcut(component, name, timeout=15):
    """Run one of the desktop's registered actions by its fixed name.

    The name is looked up in the component's own list first: a renamed or missing action
    is "unavailable", never a call into the void that reports success.
    """
    service, interface = ACCEL
    listed = busctl_data("call", service, component, interface, "shortcutNames",
                         timeout=timeout)
    names = listed[0] if listed and isinstance(listed[0], list) else []
    if name not in names:
        raise Unavailable(f"this desktop has no '{name}' action")
    run(["busctl", "--user", "call", service, component, interface,
         "invokeShortcut", "s", name], timeout=timeout)


def window(value):
    one_of(value, tuple(WINDOW_VIEWS), "window")
    invoke_shortcut(WINDOW_COMPONENT, WINDOW_VIEWS[value])
    return {"overview": "🪟 نظرة عامة على النوافذ | Window overview",
            "grid": "🔲 شبكة أسطح المكتب | Desktop grid",
            "show-desktop": "🖥 إظهار سطح المكتب | Show desktop"}[value]


def arrange(value):
    one_of(value, tuple(ARRANGEMENTS), "arrange")
    invoke_shortcut(WINDOW_COMPONENT, ARRANGEMENTS[value])
    return {"halves": "🪟 رُتّبت النوافذ نصفين | Windows arranged in halves",
            "thirds": "🪟 رُتّبت النوافذ أثلاثاً | Windows arranged in thirds",
            "quarters": "🪟 رُتّبت النوافذ أرباعاً | Windows arranged in quarters",
            "main": "🪟 نافذة رئيسية ونافذتان | Main window and two",
            "centre": "🪟 النافذة في المنتصف | Window centred"}[value]


def desktop(value):
    one_of(value, tuple(DESKTOP_STEPS), "desktop")
    run(["busctl", "--user", "call", "org.kde.KWin", "/KWin", "org.kde.KWin",
         DESKTOP_STEPS[value]])
    return ("➡ سطح المكتب التالي | Next desktop" if value == "next"
            else "⬅ سطح المكتب السابق | Previous desktop")


# ── Do not disturb (the notifications applet's own toggle) ──────────────────
def notifications_inhibited(timeout=30):
    return bool(busctl_data("get-property", *NOTIFICATIONS, "Inhibited", timeout=timeout))


def dnd(value):
    one_of(value, ("on", "off"), "dnd")
    wanted = value == "on"
    if notifications_inhibited() != wanted:
        # A toggle, so it is only pressed when the state really differs.
        invoke_shortcut(SHELL_COMPONENT, DND_ACTION)
        deadline = time.monotonic() + 3.0
        while notifications_inhibited() != wanted:
            if time.monotonic() > deadline:
                raise Unavailable("do not disturb did not change")
            time.sleep(0.2)
    return ("🔕 عدم الإزعاج يعمل | Do not disturb on" if wanted
            else "🔔 عدم الإزعاج متوقف | Do not disturb off")


# ── Microphone (PipeWire default input) ─────────────────────────────────────
def mic_muted(timeout=30):
    return "[MUTED]" in run(["wpctl", "get-volume", SOURCE], timeout=timeout)


def mic(value):
    one_of(value, ("mute", "unmute"), "mic")
    run(["wpctl", "set-mute", SOURCE, "1" if value == "mute" else "0"])
    return ("🎙 كُتم الميكروفون | Microphone muted" if value == "mute"
            else "🎙 الميكروفون يعمل | Microphone on")


# ── Keyboard layout (the layout switcher's own interface) ───────────────────
def keyboard_layout(value):
    one_of(value, ("next",), "keyboard-layout")
    service, path, interface = LAYOUTS
    layouts = busctl_data("call", service, path, interface, "getLayoutsList")
    layouts = layouts[0] if layouts and isinstance(layouts[0], list) else []
    if len(layouts) < 2:
        raise Unavailable("only one keyboard layout is set up")
    run(["busctl", "--user", "call", service, path, interface, "switchToNextLayout"])
    index = busctl_data("call", service, path, interface, "getLayout")
    try:
        short, _symbol, name = layouts[int(index[0])]
    except (IndexError, TypeError, ValueError) as error:
        raise Unavailable("the new keyboard layout could not be read back") from error
    return f"⌨ لوحة المفاتيح: {name} | Keyboard layout: {short}"


# ── Motion and glass: the MoOS look's own owner ─────────────────────────────
def motion(value):
    one_of(value, MOTION, "motion")
    run(["moos-theme", "motion", value], timeout=60)
    return f"🌊 حركة الخلفية: {value} | Wallpaper motion: {value}"


def clarity(value):
    one_of(value, CLARITY, "clarity")
    run(["moos-theme", "clarity", value], timeout=60)
    return f"💎 وضوح الزجاج: {value} | Glass clarity: {value}"


# ── Power profile ───────────────────────────────────────────────────────────
def power_profile_now(timeout=30):
    service, path, interface = POWER
    value = busctl_data("call", service, path, interface, "currentProfile", timeout=timeout)
    return value[0] if value and isinstance(value[0], str) else None


def power_profile(value):
    one_of(value, POWER_PROFILES, "power-profile")
    service, path, interface = POWER
    choices = busctl_data("call", service, path, interface, "profileChoices")
    if value not in (choices[0] if choices and isinstance(choices[0], list) else []):
        raise Unavailable(f"this computer has no {value} profile")
    run(["busctl", "--user", "call", service, path, interface, "setProfile", "s", value])
    if power_profile_now() != value:
        raise Unavailable("the power profile did not change")
    return {"power-saver": "🔋 وضع توفير الطاقة | Power saver",
            "balanced": "⚖ الوضع المتوازن | Balanced power",
            "performance": "⚡ وضع الأداء | Performance"}[value]


# ── Windows by name (KWin's own window search) ─────────────────────────────
def clean_title(caption):
    """A window's caption as a person reads it: no bidi marks, the owner's home as ~."""
    text = BIDI_MARKS.sub("", str(caption or "")).strip()
    home = str(Path.home())
    if len(home) > 1:
        text = text.replace(home, "~")
    return text[:120]


def window_matches(term, timeout=15):
    """{uuid: best relevance} of the normal windows KWin's search finds for `term`, in order.

    Only activation ids (action 0) are windows; a desktop answer carries another number.
    """
    data = busctl_data("call", *RUNNER, "Match", "s", term, timeout=timeout)
    rows = data[0] if data and isinstance(data[0], list) else []
    found = {}
    for row in rows:
        if not isinstance(row, list) or len(row) < 5:
            continue
        action, _, uuid = str(row[0]).partition("_")
        if action != "0" or not WINDOW_UUID.fullmatch(uuid):
            continue
        relevance = float(row[4]) if isinstance(row[4], (int, float)) else 0.0
        found[uuid] = max(relevance, found.get(uuid, relevance))
    return found


def window_info(uuid, timeout=15):
    """KWin's own description of one window; {} when no window has that id."""
    data = busctl_data("call", *KWIN, "getWindowInfo", "s", uuid, timeout=timeout)
    info = data[0] if data and isinstance(data[0], dict) else {}
    return {key: value.get("data") for key, value in info.items() if isinstance(value, dict)}


def window_state(info):
    return {"minimized": bool(info.get("minimized")),
            # KWin reports each axis on its own; a window is maximized when both are.
            "maximized": bool(info.get("maximizeHorizontal")) and bool(info.get("maximizeVertical")),
            "fullscreen": bool(info.get("fullscreen")),
            "keep_above": bool(info.get("keepAbove"))}


def window_name(info):
    return clean_title(info.get("caption")) or str(info.get("resourceClass") or "window")


def desktop_list(timeout=15):
    """[(number, id, name)] in the desktops' own order; number counts from 1."""
    rows = busctl_data("get-property", *VDM, "desktops", timeout=timeout)
    desks = []
    for row in rows if isinstance(rows, list) else []:
        if isinstance(row, list) and len(row) == 3 and isinstance(row[0], int):
            desks.append((row[0] + 1, str(row[1]), str(row[2])))
    if not desks:
        raise Unavailable("the desktop list cannot be read")
    return sorted(desks)


def find_window(target):
    """The ONE window `target` names — its {uuid}, or words from its title or app."""
    if WINDOW_UUID.fullmatch(target or ""):
        info = window_info(target)
        if not info:
            raise Unavailable("no open window has that id")
        return target, info
    if not WINDOW_TARGET.fullmatch(target or ""):
        raise Invalid("a window is named by 1-80 characters of its title or app, or its {id}")
    matches = window_matches(target)
    if not matches:
        raise Unavailable(f"no open window matches “{target}”")
    best = max(matches.values())
    top = [uuid for uuid, relevance in matches.items() if relevance == best]
    if len(top) > 1:
        names = "; ".join(window_name(window_info(uuid)) for uuid in top[:5])
        raise Unavailable(f"{len(top)} windows match “{target}”: {names} — name one more "
                          "exactly, or use its id from the window list")
    return top[0], window_info(top[0])


def run_window(uuid, action):
    run(["busctl", "--user", "call", *RUNNER, "Run", "ss",
         f"{RUNNER_ACTIONS[action]}_{uuid}", ""])


def settle(read, wanted, seconds=2.0):
    """Poll `read()` until it returns `wanted` or the time is up; returns the last reading."""
    deadline = time.monotonic() + seconds
    value = read()
    while value != wanted and time.monotonic() < deadline:
        time.sleep(0.15)
        value = read()
    return value


def windows():
    """Every desktop and every normal window, as JSON (read-only)."""
    desks = desktop_list()
    current = busctl_data("get-property", *VDM, "current")
    numbers = {desk_id: number for number, desk_id, _ in desks}
    listed = []
    for uuid in list(window_matches(""))[:MAX_WINDOWS]:
        info = window_info(uuid)
        if not info:
            continue                                   # closed between the two reads
        on = [numbers[d] for d in info.get("desktops") or [] if d in numbers]
        listed.append({"id": uuid,
                       "app": str(info.get("desktopFile") or info.get("resourceClass") or ""),
                       "title": clean_title(info.get("caption")),
                       "desktops": on or "all", **window_state(info)})
    return json.dumps({"desktops": [{"number": number, "name": name, "current": desk_id == current}
                                    for number, desk_id, name in desks],
                       "windows": listed}, ensure_ascii=False)


# The state each request must read back as, and the runner action that toggles it.
WINDOW_GOALS = {"minimize": ("minimized", True, "minimize"),
                "restore": ("minimized", False, "minimize"),
                "maximize": ("maximized", True, "maximize"),
                "unmaximize": ("maximized", False, "maximize"),
                "fullscreen": ("fullscreen", True, "fullscreen"),
                "exit-fullscreen": ("fullscreen", False, "fullscreen"),
                "keep-above": ("keep_above", True, "keep-above"),
                "no-keep-above": ("keep_above", False, "keep-above")}


def window_do(action, target):
    one_of(action, WINDOW_ACTIONS, "window action")
    uuid, info = find_window(target)
    name = window_name(info)
    if action == "close":
        # The title bar's own close: the app decides, and asks to save first when it must.
        run_window(uuid, "close")
        if settle(lambda: bool(window_info(uuid)), False, 3.0):
            raise Unavailable(f"asked “{name}” to close; it is still open — it may be asking "
                              "you to save your work")
        return f"✖ أُغلقت النافذة: {name} | Closed: {name}"
    if action == "focus":
        run_window(uuid, "activate")
        if window_state(window_info(uuid))["minimized"]:
            run_window(uuid, "minimize")                 # the runner's minimize toggles it back
        if settle(lambda: window_state(window_info(uuid))["minimized"], False):
            raise Unavailable(f"“{name}” did not come forward")
        return f"🪟 في المقدمة: {name} | In front: {name}"
    key, wanted, toggle = WINDOW_GOALS[action]
    # Each runner action TOGGLES, and maximize from a half-maximized window restores first,
    # so press at most twice and believe only the read-back.
    for _ in range(2):
        if window_state(window_info(uuid))[key] == wanted:
            break
        run_window(uuid, toggle)
        if settle(lambda: window_state(window_info(uuid))[key], wanted) == wanted:
            break
    if window_state(window_info(uuid))[key] != wanted:
        raise Unavailable(f"“{name}” did not change")
    words = {"minimize": ("صُغّرت", "Minimized"), "restore": ("أُعيدت", "Restored"),
             "maximize": ("كُبّرت", "Maximized"), "unmaximize": ("أُعيد حجمها", "Unmaximized"),
             "fullscreen": ("ملء الشاشة", "Full screen"),
             "exit-fullscreen": ("خرجت من ملء الشاشة", "Left full screen"),
             "keep-above": ("فوق كل النوافذ", "Kept above others"),
             "no-keep-above": ("لم تعد فوق النوافذ", "No longer kept above")}[action]
    return f"🪟 {words[0]}: {name} | {words[1]}: {name}"


def window_move(number, target):
    wanted = level(number, 1, MAX_DESKTOPS, "desktop")
    desks = desktop_list()
    if wanted > len(desks):
        raise Unavailable(f"this computer has {len(desks)} desktop(s); add one first")
    desk_id = desks[wanted - 1][1]
    uuid, info = find_window(target)
    name = window_name(info)
    if (info.get("desktops") or []) != [desk_id]:
        # The desktop's own "Window to Desktop N" acts on the active window, so the window
        # is brought forward first; then only the read-back decides.
        run_window(uuid, "activate")
        invoke_shortcut(WINDOW_COMPONENT, f"Window to Desktop {wanted}")
        if settle(lambda: window_info(uuid).get("desktops") or [], [desk_id]) != [desk_id]:
            raise Unavailable(f"“{name}” did not move")
    return f"🪟 {name} ← سطح المكتب {wanted} | {name} → desktop {wanted}"


def go_desktop(number):
    wanted = level(number, 1, MAX_DESKTOPS, "desktop")
    count = len(desktop_list())
    if wanted > count:
        raise Unavailable(f"this computer has {count} desktop(s)")
    moved = busctl_data("call", *KWIN, "setCurrentDesktop", "i", str(wanted))
    current = lambda: (busctl_data("call", *KWIN, "currentDesktop") or [0])[0]   # noqa: E731
    if not (moved and moved[0]) or settle(current, wanted) != wanted:
        raise Unavailable(f"desktop {wanted} did not open")
    return f"🖥 سطح المكتب {wanted} | Desktop {wanted}"


def desktops(change):
    one_of(change, ("add", "remove"), "desktops")
    desks = desktop_list()
    count = len(desks)
    if change == "add":
        if count >= MAX_DESKTOPS:
            raise Unavailable(f"{MAX_DESKTOPS} desktops is the most MoOS makes")
        run(["busctl", "--user", "call", *VDM, "createDesktop", "us", str(count), ""])
    else:
        if count == 1:
            raise Unavailable("the only desktop cannot be removed")
        number, desk_id, name = desks[-1]
        # Removing a desktop moves its windows somewhere the owner did not choose; say what
        # is on it instead, and leave the choice with them.
        alone = [window_name(info) for info in (window_info(uuid) for uuid in window_matches(""))
                 if (info.get("desktops") or []) == [desk_id]]
        if alone:
            raise Unavailable(f"desktop {number} still has windows: {'; '.join(alone[:5])} — "
                              "move or close them first")
        run(["busctl", "--user", "call", *VDM, "removeDesktop", "s", desk_id])
    expected = count + (1 if change == "add" else -1)
    if settle(lambda: len(desktop_list()), expected) != expected:
        raise Unavailable("the number of desktops did not change")
    return (f"➕ أُضيف سطح مكتب ({expected}) | Desktop added ({expected})" if change == "add"
            else f"➖ أُزيل سطح المكتب {count} | Desktop {count} removed")


# ── Media (the media keys' own actions, read back over MPRIS) ───────────────
def players(timeout=15):
    names = busctl_data("call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                        "org.freedesktop.DBus", "ListNames", timeout=timeout)
    names = names[0] if names and isinstance(names[0], list) else []
    return [name for name in names if isinstance(name, str) and name.startswith(MPRIS)]


def player_state(name, timeout=15):
    path = ("/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player")
    state = busctl_data("get-property", name, *path, "PlaybackStatus", timeout=timeout)
    meta = busctl_data("get-property", name, *path, "Metadata", timeout=timeout)
    meta = meta if isinstance(meta, dict) else {}
    title = (meta.get("xesam:title") or {}).get("data") or ""
    artist = (meta.get("xesam:artist") or {}).get("data") or []
    return {"player": name[len(MPRIS):].split(".")[0], "state": str(state or ""),
            "title": clean_title(title)[:100],
            "artist": clean_title(", ".join(a for a in artist if isinstance(a, str)))[:80]}


def now_playing(timeout=15):
    """The player that is playing, else the first one; None when no player is open."""
    found = []
    for name in players(timeout):
        try:
            found.append(player_state(name, timeout))
        except Unavailable:
            continue
    playing = [item for item in found if item["state"] == "Playing"]
    return (playing or found or [None])[0]


def media(value):
    one_of(value, tuple(MEDIA), "media")
    if not players():
        raise Unavailable("no media player is open")
    invoke_shortcut(MEDIA_COMPONENT, MEDIA[value])
    expect = {"pause": False, "stop": False, "play": True}.get(value)
    if expect is not None:
        def playing():
            item = now_playing()
            return bool(item) and item["state"] == "Playing"
        if settle(playing, expect) != expect:
            raise Unavailable(f"the player did not {value}")
    else:
        time.sleep(0.6)                                # let the player publish its new track
    item = now_playing()
    shown = (f"{item['title']} — {item['artist']}".strip(" —") if item else "") or "—"
    return f"🎵 {shown} | {item['state'] if item else 'no player'}"


# ── Lock the screen ─────────────────────────────────────────────────────────
def lock():
    run(["busctl", "--user", "call", *SCREENSAVER, "Lock"])
    active = lambda: bool((busctl_data("call", *SCREENSAVER, "GetActive") or [False])[0])  # noqa: E731
    if not settle(active, True, 3.0):
        raise Unavailable("the screen did not lock")
    return "🔒 قُفلت الشاشة | Screen locked"


# ── Reminders (a user timer that raises one notification) ──────────────────
def remind(minutes, text):
    after = level(minutes, 1, 1440, "minutes")
    words = " ".join(str(text or "").split())
    if not REMINDER_TEXT.fullmatch(words):
        raise Invalid("a reminder says what to remember in 1-160 characters")
    notify = shutil.which("notify-send")
    if not notify:
        raise Unavailable("notify-send is not installed")
    unit = f"{REMINDER_PREFIX}{int(time.time())}-{secrets.token_hex(2)}"
    # systemd-run passes each argument through verbatim ($ and % are escaped for ExecStart,
    # measured on the A1); the description keeps no specifier character at all.
    run(["systemd-run", "--user", "--collect", f"--unit={unit}",
         "--description=Mo AI reminder: " + words.replace("%", ""),
         f"--on-active={after}m", "--timer-property=AccuracySec=5s", "--",
         notify, "--app-name=Mo AI", "--icon=moos-moai", "--urgency=critical",
         "Mo AI — تذكير | Reminder", words])
    if run(["systemctl", "--user", "is-active", f"{unit}.timer"]).strip() != "active":
        raise Unavailable("the reminder was not set")
    return f"⏰ سأذكّرك بعد {after} دقيقة | Reminder in {after} min: {words}"


def reminder_units():
    """[(unit, next wall-clock time or '', text)] for every pending MoOS reminder."""
    try:
        timers = json.loads(run(["systemctl", "--user", "list-timers", "--all",
                                 "--output=json", f"{REMINDER_PREFIX}*"]) or "[]")
    except ValueError as error:
        raise Unavailable("the reminder list cannot be read") from error
    found = []
    for timer in timers if isinstance(timers, list) else []:
        unit = str((timer or {}).get("unit") or "")
        if not REMINDER_UNIT.fullmatch(unit):
            continue
        described = run(["systemctl", "--user", "show", unit, "-p", "Description", "--value"])
        text = described.strip().removeprefix("Mo AI reminder: ")
        due = timer.get("next")
        when = (datetime.fromtimestamp(due / 1e6).strftime("%H:%M")
                if isinstance(due, int) and due > 0 else "")
        found.append((unit, when, text))
    return found


def reminders(value):
    one_of(value, ("list", "cancel-all"), "reminders")
    pending = reminder_units()
    if value == "list":
        return json.dumps([{"at": when, "text": text} for _, when, text in pending],
                          ensure_ascii=False)
    for unit, _, _ in pending:
        run(["systemctl", "--user", "stop", unit])
    if reminder_units():
        raise Unavailable("some reminders are still pending")
    return f"⏰ أُلغيت التذكيرات ({len(pending)}) | Reminders cancelled ({len(pending)})"


# ── A web page or a folder, in the owner's own default apps ────────────────
def open_url(value):
    found = URL.fullmatch(value or "")
    if len(value or "") > 2048 or not found:
        raise Invalid("only an http:// or https:// address can be opened")
    if LOOPBACK.fullmatch(found.group(1)):
        # This computer's own services answer on loopback; a page is never one of them.
        raise Invalid("addresses on this computer itself are not opened")
    require_display()
    spawn(["xdg-open", value])
    return f"🌐 فتح {found.group(1)} | Opening {found.group(1)}"


def open_folder(value):
    one_of(value, tuple(FOLDERS), "folder")
    folder = Path.home()
    if FOLDERS[value]:
        try:
            out = subprocess.run(["xdg-user-dir", FOLDERS[value]], capture_output=True,
                                 text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            out = ""
        folder = Path(out) if out else folder
    if value == "screenshots":
        folder = folder / "Screenshots"
    if not folder.is_dir():
        raise Unavailable(f"there is no {value} folder yet")
    require_display()
    spawn(["xdg-open", str(folder)])
    return f"📁 فتح {clean_title(str(folder))} | Opening {clean_title(str(folder))}"


# ── Three of the desktop's own settings, written with notification and read back ──
def write_setting(file, group, key, value, kind=None):
    argv = ["kwriteconfig6", "--notify", "--file", file, "--group", group, "--key", key]
    run([*argv, *(["--type", kind] if kind else []), value])
    read = run(["kreadconfig6", "--file", file, "--group", group, "--key", key]).strip()
    if read != value:
        raise Unavailable(f"{key} reads back as {read or 'nothing'}, not {value}")


def animations(value):
    one_of(value, tuple(ANIMATION_SPEEDS), "animations")
    write_setting("kdeglobals", "KDE", "AnimationDurationFactor", ANIMATION_SPEEDS[value])
    run(["busctl", "--user", "--expect-reply=no", "call", *KWIN, "reconfigure"])
    return {"off": "⚡ بلا حركة | Animations off", "fast": "⚡ حركة سريعة | Fast animations",
            "normal": "✨ حركة عادية | Normal animations",
            "slow": "🐢 حركة بطيئة | Slow animations"}[value]


def screen_lock(minutes):
    after = level(minutes, 0, 120, "screen-lock minutes")
    write_setting("kscreenlockerrc", "Daemon", "Autolock", "true" if after else "false", "bool")
    if after:
        write_setting("kscreenlockerrc", "Daemon", "Timeout", str(after))
    # The locker re-reads its configuration on this call (org.kde.screensaver.configure).
    run(["busctl", "--user", "--expect-reply=no", "call", "org.kde.screensaver", "/ScreenSaver",
         "org.kde.screensaver", "configure"])
    return (f"🔒 قفل تلقائي بعد {after} دقيقة | Locks after {after} min" if after
            else "🔓 لا قفل تلقائي | Never locks by itself")


def click(value):
    one_of(value, CLICK_MODES, "click")
    write_setting("kdeglobals", "KDE", "SingleClick", "true" if value == "single" else "false",
                  "bool")
    return ("👆 نقرة واحدة تفتح | One click opens" if value == "single"
            else "👆 نقرتان تفتحان | Double-click opens")


# ── Mo PC Remote and Fast Remote ────────────────────────────────────────────
def remote_state(timeout=REMOTE_STATE_TIMEOUT):
    """The unit's state word. `is-active` exits non-zero for every state but active, so the
    printed word is the answer and the exit status is not a failure here."""
    if shutil.which("systemctl") is None:
        raise Unavailable("systemctl is not installed")
    try:
        result = subprocess.run(["systemctl", "--user", "is-active", REMOTE_UNIT],
                                capture_output=True, text=True, timeout=timeout,
                                stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as error:
        raise Unavailable("systemctl did not answer") from error
    state = (result.stdout or "").strip().splitlines()
    return state[0] if state else "unknown"


def remote_came_up():
    """(True, "active") when active and still active a moment later — a unit that crashes at
    once is not "on" — else (False, the last state seen). At most the start budget plus one
    last look (state, settle, state)."""
    deadline = time.monotonic() + REMOTE_START_BUDGET
    state = "unknown"
    while time.monotonic() < deadline:
        state = remote_state()
        if state == "active":
            time.sleep(REMOTE_SETTLE)
            state = remote_state()
            if state == "active":
                return True, state
        else:
            time.sleep(0.25)
    return False, state


def remote(value):
    one_of(value, REMOTE_VALUES, "remote")
    if value == "on":
        run(["systemctl", "--user", "enable", "--now", REMOTE_UNIT], timeout=60)
        up, state = remote_came_up()
        if not up:
            raise Unavailable(f"Mo PC Remote did not start (it is {state})")
        return "📱 Mo PC Remote يعمل | Mo PC Remote on"
    if value == "off":
        run(["systemctl", "--user", "disable", "--now", REMOTE_UNIT], timeout=60)
        if remote_state() in REMOTE_RUNNING:
            raise Unavailable("Mo PC Remote is still running")
        return "📴 Mo PC Remote متوقف | Mo PC Remote off"
    # try-restart does nothing to a stopped unit and still exits 0: say so instead.
    if remote_state() not in REMOTE_RUNNING:
        raise Unavailable("Mo PC Remote is off; turn it on first")
    try:
        result = subprocess.run(["systemctl", "--user", "try-restart", REMOTE_UNIT],
                                capture_output=True, text=True, timeout=REMOTE_RESTART_TIMEOUT,
                                stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as error:
        # systemd keeps the restart job when its client stops waiting: it is not a failure yet.
        raise Unavailable("Mo PC Remote is still restarting; check again in a moment") from error
    if result.returncode != 0:
        raise Unavailable((result.stderr or result.stdout or "systemctl failed").strip())
    up, state = remote_came_up()
    if not up:
        raise Unavailable(f"Mo PC Remote did not come back (it is {state})")
    return "🔄 أُعيد تشغيل Mo PC Remote | Mo PC Remote restarted"


def run_unkilled(argv, budget):
    """Run argv and wait up to `budget` seconds; True when it ended in time.

    For a transaction that must not be cut in half. It runs in its own session with its output
    in an unlinked file, so neither this process ending, nor a signal to its group, nor a closed
    pipe can interrupt it; at the budget it is left to finish (False). A non-zero exit raises
    Unavailable with what it said."""
    if shutil.which(argv[0]) is None:
        raise Unavailable(f"{argv[0]} is not installed")
    with tempfile.TemporaryFile() as output:
        child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=output,
                                 stderr=subprocess.STDOUT, start_new_session=True)
        try:
            code = child.wait(timeout=budget)
        except subprocess.TimeoutExpired:
            return False
        if code != 0:
            output.seek(0)
            said = output.read().decode("utf-8", "ignore").strip()
            raise Unavailable(said.splitlines()[-1] if said else f"{argv[0]} failed")
    return True


def fast_remote(value):
    one_of(value, FAST_REMOTE_VALUES, "fast-remote")
    # moos-fast-remote waits up to 30 s for another appearance change to finish first.
    if not run_unkilled(["moos-fast-remote", value], FAST_REMOTE_BUDGET[value]):
        raise Unavailable(f"Fast Remote is still switching {value}; it finishes on its own — "
                          "check again in a minute")
    now = run(["moos-fast-remote", "status"], timeout=REMOTE_STATE_TIMEOUT).strip()
    if now != value:
        raise Unavailable(f"Fast Remote is still {now or 'unknown'}")
    return ("⚡ الاتصال السريع يعمل | Fast Remote on" if value == "on"
            else "✨ عادت تجربة MoOS الكاملة | Fast Remote off")


# ── Status (read-only) ──────────────────────────────────────────────────────
def bluez_running(timeout):
    """Is bluez actually on the bus, without starting it?

    `bluetoothctl show` never returns when bluez has no adapter: it activates
    the service and then waits for an adapter that is never going to appear.
    Measured on the Oracle A1, which has no Bluetooth hardware at all, it was
    still waiting after 25 s while every other probe answered in under 20 ms.
    NameHasOwner is a plain bus query -- it reports absence instead of
    activating bluez, so a machine without Bluetooth costs one round trip.
    """
    out = run(["busctl", "--system", "--json=short", "call",
               "org.freedesktop.DBus", "/org/freedesktop/DBus",
               "org.freedesktop.DBus", "NameHasOwner", "s", "org.bluez"],
              timeout=timeout)
    try:
        return bool(json.loads(out)["data"][0])
    except (ValueError, KeyError, IndexError, TypeError) as error:
        raise Unavailable("unexpected bus reply for org.bluez") from error


def theme_token(package):
    """A MoOS look's short name, or None for anything that is not a MoOS look."""
    if package == "org.moos.ui2":
        return "dark"
    if package == "org.moos.ui2.light":
        return "light"
    if package == "org.moos.ui2.midnight.light":
        return "daylight"
    found = re.fullmatch(r"org\.moos\.ui2\.([a-z]+)(\.light)?", package or "")
    return (found.group(1) + ("-light" if found.group(2) else "")) if found else None


def theme_state(timeout):
    read = ["kreadconfig6", "--file", "kdeglobals", "--group", "KDE", "--key"]
    if run([*read, "AutomaticLookAndFeel"], timeout=timeout).strip() == "true":
        return "auto"
    return theme_token(run([*read, "LookAndFeelPackage"], timeout=timeout).strip())


def status():
    """Read what the desktop can tell us, within one bounded budget.

    Mo AI calls this as a read-only tool while somebody waits, so no probe may
    decide how long the answer takes. Each one gets what is left of
    STATUS_BUDGET; whatever cannot answer in time is reported unknown (null),
    which the callers already render as "not available here".
    """
    deadline = time.monotonic() + STATUS_BUDGET

    def left():
        # Never zero or negative: subprocess.run treats that as "expire now",
        # which would turn a slow probe into a guaranteed failure.
        return max(0.5, deadline - time.monotonic())

    state = {}
    try:
        state["volume"], state["muted"] = volume_state(left())
    except Unavailable:
        state["volume"], state["muted"] = None, None
    try:
        name = displays(left())[0]
        state["brightness"] = round(100 * display_value(name, "Brightness", left())
                                    / max(1, display_value(name, "MaxBrightness", left())))
    except Unavailable:
        state["brightness"] = None
    try:
        state["night_light"] = bool(busctl_data(
            "get-property", "org.kde.KWin", "/org/kde/KWin/NightLight",
            "org.kde.KWin.NightLight", "running", timeout=left()))
    except Unavailable:
        state["night_light"] = None
    try:
        state["wifi"] = run(["nmcli", "radio", "wifi"], timeout=left()).strip() == "enabled"
    except Unavailable:
        state["wifi"] = None
    try:
        # A machine with no Bluetooth at all is unknown (null), not "off":
        # "off" would invite Mo AI to offer a switch that turns nothing on.
        if not bluez_running(left()):
            raise Unavailable("bluez is not on the bus; no Bluetooth here")
        state["bluetooth"] = "Powered: yes" in run(["bluetoothctl", "show"],
                                                   timeout=left())
    except Unavailable:
        state["bluetooth"] = None
    try:
        state["theme"] = theme_state(left())
    except Unavailable:
        state["theme"] = None
    try:
        state["dnd"] = notifications_inhibited(left())
    except Unavailable:
        state["dnd"] = None
    try:
        state["mic_muted"] = mic_muted(left())
    except Unavailable:
        state["mic_muted"] = None
    try:
        state["power_profile"] = power_profile_now(left())
    except Unavailable:
        state["power_profile"] = None
    try:
        # What is playing, so "pause it" and "what song is this" need no second look.
        state["media"] = now_playing(left())
    except Unavailable:
        state["media"] = None
    try:
        count = len(desktop_list(left()))
        state["desktop"] = {"current": (busctl_data("call", *KWIN, "currentDesktop",
                                                    timeout=left()) or [None])[0],
                            "count": count}
    except Unavailable:
        state["desktop"] = None
    return json.dumps(state, ensure_ascii=False)


# Verbs that only read: nothing to audit.
READ_ONLY_VERBS = ("status", "windows")
# Verbs whose arguments are the owner's own words or places.
PRIVATE_ARGUMENTS = ("remind", "reminders", "open-url", "window-do", "window-move")

ACTIONS = {
    "volume": (1, volume),
    "brightness": (1, brightness),
    "night-light": (1, night_light),
    "wifi": (1, wifi),
    "bluetooth": (1, bluetooth),
    "theme": (1, theme),
    "open": (1, open_app),
    "settings": (1, settings),
    "window": (1, window),
    "arrange": (1, arrange),
    "desktop": (1, desktop),
    "dnd": (1, dnd),
    "mic": (1, mic),
    "keyboard-layout": (1, keyboard_layout),
    "motion": (1, motion),
    "clarity": (1, clarity),
    "power-profile": (1, power_profile),
    "window-do": (2, window_do),
    "window-move": (2, window_move),
    "go-desktop": (1, go_desktop),
    "desktops": (1, desktops),
    "media": (1, media),
    "remind": (2, remind),
    "reminders": (1, reminders),
    "open-url": (1, open_url),
    "open-folder": (1, open_folder),
    "animations": (1, animations),
    "screen-lock": (1, screen_lock),
    "click": (1, click),
    "windows": (0, windows),
    "lock": (0, lock),
    "remote": (1, remote),
    "fast-remote": (1, fast_remote),
    "mute": (0, lambda: mute(True)),
    "unmute": (0, lambda: mute(False)),
    "screenshot": (0, screenshot),
    "status": (0, status),
}


def main(argv):
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(USAGE, end="")
        return 0
    action = ACTIONS.get(argv[0]) if argv else None
    if action is None or len(argv) - 1 != action[0]:
        print(USAGE, end="", file=sys.stderr)
        return EX_USAGE
    try:
        message = action[1](*argv[1:])
    except Invalid as error:
        print(f"moos-control: {error}", file=sys.stderr)
        return EX_USAGE
    except Unavailable as error:
        print(f"moos-control: {error}", file=sys.stderr)
        return EX_UNAVAILABLE
    if argv[0] in PRIVATE_ARGUMENTS:
        # A reminder's words, a page's address and a window's title stay out of the journal.
        audit(argv[0])
    elif argv[0] not in READ_ONLY_VERBS:
        audit(" ".join(argv))
    print(message)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
