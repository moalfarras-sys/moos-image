#!/usr/bin/python3
"""moos-control — instant, reversible control of this computer.

WHY: Mo AI could repair, update and install software (moai-do), but not do the
everyday things people ask an assistant for: turn it down, dim the screen, night
light on, take a screenshot. Each action here runs as the logged-in user with no
privilege, maps to ONE fixed argv (never a shell, never free text) and is undone
by its opposite. moos-open exposes them as moos://control/… routes; Mo AI shows
them as buttons, and nothing runs until the user taps one.

The desktop verbs (window, arrange, desktop, dnd, keyboard-layout, power-profile) drive
the desktop the way its own shortcuts and applets do: a FIXED action name invoked through
the global-shortcut service, or one fixed D-Bus method. Nothing here can load a script,
kill a window or restart the compositor.

The desktop HANDS (W9.10) reach one named window, one desktop, the media keys, the lock,
a reminder, a web page or a folder, and three of the desktop's own settings. A window is
found through KWin's own window search (the krunner1 interface KRunner uses), acted on
through the same interface, and read back through KWin's getWindowInfo: nothing is
inferred, and a request that matches two windows is refused with both names instead of
guessed. Closing asks the app to close exactly as its title-bar button does — the app
still asks to save — and Mo AI shows a card before it (confirm_values in the schema).
Free text reaches argv only as a search term, a reminder's words or an http(s) address,
each bounded and validated here; none of it is ever a command.

The remote verbs (remote, fast-remote) drive Mo PC Remote the way its settings page and the
moos://remote/… routes do: the one user unit, enabled or disabled with --now so it agrees with
the page about the next boot, and the Fast Remote profile through its own tool. Each reads the
result back; a unit that did not come up is a failure, not "on".

Exit codes: 0 done, 2 invalid request, 69 that control is unavailable here.
"""
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

EX_USAGE = 2
EX_UNAVAILABLE = 69
SINK = "@DEFAULT_AUDIO_SINK@"
STEP = 10
BRIGHTNESS_SERVICE = "org.kde.ScreenBrightness"
BRIGHTNESS_PATH = "/org/kde/ScreenBrightness"
# `status` answers a person waiting for an answer (Mo AI calls it as a
# read-only tool), so the whole read is bounded. Any single probe that cannot
# answer inside what is left of the budget is reported unknown, never waited on.
STATUS_BUDGET = 8.0
# Every look `moos-theme` applies (its own case table), plus its three moves: auto follows the
# sun, toggle flips the current family between light and dark, undo returns to the last one.
# gaming, dev and study are the looks called Arena, Forge and Scholar in the theme picker.
THEMES = ("dark", "light", "nova", "amethyst", "midnight", "aurora", "nova-light",
          "amethyst-light", "aurora-light", "daylight", "gaming", "dev", "study",
          "gaming-light", "dev-light", "study-light", "auto", "toggle", "undo")


def _settings_pages():
    """The pages Mo AI offers (moai: true in the one settings registry, SPEC D3), with the
    fixed command that opens each one.

    The command is the registry's own (`argv()`), the one moos-open's literal arm for the
    same token runs — tests/test_settings_destinations.py holds the two equal. It is started
    here rather than through moos-open because moos-open detaches and exits 0 at once, so a
    page that failed to open (no desktop session, a module that will not load) would still
    be reported as opened. A registry that is missing or malformed offers NO page: the
    settings verb then reports itself unavailable, and every other verb keeps working.
    """
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib/moos"))
        import moos_settings_destinations as destinations
    except ImportError:
        return {}
    finally:
        sys.path.pop(0)
    registry = destinations.safe_load(
        Path(__file__).resolve().parent.parent / "share/moos/settings-destinations.json")
    return {token: destinations.argv(registry[token])
            for token in destinations.moai_tokens(registry)}


SETTINGS_COMMANDS = _settings_pages()
SETTINGS_PAGES = tuple(SETTINGS_COMMANDS)

# ── The desktop's own actions, by their fixed names ─────────────────────────
# Measured on the station (Plasma 6.7.5, 2026-09-24) in `shortcutNames` of each
# component. Each call is checked against that list first, so a renamed action is
# reported unavailable instead of silently doing nothing.
ACCEL = ("org.kde.kglobalaccel", "org.kde.kglobalaccel.Component")
WINDOW_COMPONENT = "/component/kwin"
SHELL_COMPONENT = "/component/plasmashell"
WINDOW_VIEWS = {"overview": "Overview", "grid": "Grid View", "show-desktop": "Show Desktop"}
# Registered by MoOS's own window-arrangement script (usr/share/kwin/scripts/moos-arrange).
ARRANGEMENTS = {kind: f"MoOS Arrange: {kind}"
                for kind in ("halves", "thirds", "quarters", "main", "centre")}
DESKTOP_STEPS = {"next": "nextDesktop", "previous": "previousDesktop"}
# The notifications applet's own toggle. Invoking it runs the applet's logic, so the
# desktop records the change itself (plasmanotifyrc [DoNotDisturb] Until) — measured:
# the notification server's Inhibited property follows it both ways.
DND_ACTION = "toggle do not disturb"
NOTIFICATIONS = ("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                 "org.freedesktop.Notifications")
SOURCE = "@DEFAULT_AUDIO_SOURCE@"
LAYOUTS = ("org.kde.keyboard", "/Layouts", "org.kde.KeyboardLayouts")
MOTION = ("still", "gentle", "alive")
CLARITY = ("clear", "balanced", "solid")
# Through the power manager's own action, the one the battery applet uses; the
# profile daemon allows the active session to switch without a password (measured).
POWER = ("org.kde.Solid.PowerManagement",
         "/org/kde/Solid/PowerManagement/Actions/PowerProfile",
         "org.kde.Solid.PowerManagement.Actions.PowerProfile")
POWER_PROFILES = ("power-saver", "balanced", "performance")
APP_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{2,254}")
DISPLAY_NAME = re.compile(r"[A-Za-z0-9_]{1,64}")
# Mo PC Remote's user service — the same unit moos-open's remote/* routes and the Mo PC Remote
# settings page switch. restart is try-restart: it reconnects a remote that is on and can never
# turn one on.
REMOTE_UNIT = "mo-remote-personal.service"
REMOTE_VALUES = ("on", "off", "restart")
REMOTE_RUNNING = ("active", "activating", "reloading")
# A unit that dies in its first second (a port clash, a missing runtime) still reads "active"
# for an instant; it has to still be active after this before it is called on.
REMOTE_SETTLE = 1.0
REMOTE_START_BUDGET = 8.0
REMOTE_STATE_TIMEOUT = 5
REMOTE_RESTART_TIMEOUT = 20
FAST_REMOTE_VALUES = ("on", "off")
# How long a Fast Remote switch is waited for. `remote restart` and `fast-remote off` need no
# card, so moai-control runs them in the request itself and gives up after 60 s — reporting a
# failure for an action that is still going. Every such verb therefore answers within 50 s:
# restart's worst case is state + try-restart + (start budget + state + settle + state) =
# 5 + 20 + 19 = 44 s, and Fast Remote OFF is waited for 40 s. ON is a confirmed job (45 min).
# A switch still running at its budget is LEFT running — cutting moos-fast-remote in half would
# leave half an appearance — and the answer says so instead of claiming either result.
FAST_REMOTE_BUDGET = {"on": 120, "off": 40}

# ── The desktop hands (W9.10) ───────────────────────────────────────────────
# KWin's window search, the one KRunner queries. Read from KWin 6.7's
# windowsrunnerinterface.{h,cpp} on 2026-09-28 and exercised on the A1's live session:
# Match("") lists every normal window, Match(term) the windows whose caption or class
# contains the term, and Run("<action>_<uuid>", "") performs the numbered action on it.
RUNNER = ("org.kde.KWin", "/WindowsRunner", "org.kde.krunner1")
RUNNER_ACTIONS = {"activate": 0, "close": 1, "minimize": 2, "maximize": 3, "fullscreen": 4,
                  "keep-above": 6}
VDM = ("org.kde.KWin", "/VirtualDesktopManager", "org.kde.KWin.VirtualDesktopManager")
KWIN = ("org.kde.KWin", "/KWin", "org.kde.KWin")
# What a window can be asked to do, and the state each one must read back as.
WINDOW_ACTIONS = ("focus", "minimize", "restore", "maximize", "unmaximize", "fullscreen",
                  "exit-fullscreen", "keep-above", "no-keep-above", "close")
WINDOW_UUID = re.compile(r"\{[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\}")
# A search term, not a command: printable, bounded, never an option.
WINDOW_TARGET = re.compile(r"(?!-)[^\x00-\x1f\x7f]{1,80}")
BIDI_MARKS = re.compile("[\u200e\u200f\u202a-\u202e\u2066-\u2069]")
MAX_DESKTOPS = 20
MAX_WINDOWS = 40
MEDIA_COMPONENT = "/component/mediacontrol"
# The media keys' own actions (Plasma's media controller picks the player, as for the keys).
MEDIA = {"play-pause": "playpausemedia", "play": "playmedia", "pause": "pausemedia",
         "next": "nextmedia", "previous": "previousmedia", "stop": "stopmedia"}
MPRIS = "org.mpris.MediaPlayer2."
SCREENSAVER = ("org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver")
REMINDER_PREFIX = "moos-reminder-"
REMINDER_TEXT = re.compile(r"[^\x00-\x1f\x7f]{1,160}")
REMINDER_UNIT = re.compile(r"moos-reminder-[0-9]{10}-[0-9a-f]{4}\.timer")
URL = re.compile(r"https?://([A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?)"
                 r"(?::[0-9]{1,5})?(?:[/?#][^\s\x00-\x1f\x7f]*)?")
LOOPBACK = re.compile(r"(?i)localhost|127(?:\.[0-9]{1,3}){3}|0\.0\.0\.0|.*\.localhost")
# xdg-user-dir names; `screenshots` is where `screenshot` saves.
FOLDERS = {"home": None, "documents": "DOCUMENTS", "downloads": "DOWNLOAD",
           "pictures": "PICTURES", "music": "MUSIC", "videos": "VIDEOS", "desktop": "DESKTOP",
           "screenshots": "PICTURES"}
# Plasma's own animation-speed control (System Settings → Animations): the factor every
# KWin effect and, through Tokens.scaled(), every MoOS surface already follows.
ANIMATION_SPEEDS = {"off": "0", "fast": "0.5", "normal": "1", "slow": "2"}
CLICK_MODES = ("single", "double")

USAGE = """moos-control — تحكّم فوري بالجهاز | instant control of this computer

  moos-control status
  moos-control volume <0-100|up|down>
  moos-control mute | unmute
