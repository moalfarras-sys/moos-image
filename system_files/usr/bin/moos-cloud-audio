<audio id="a" hidden></audio>
<script>
// A live WebM stream has no duration and never "ends" cleanly, so the usual media
// events do not mean what they normally mean. `playing` is the only trustworthy
// signal that audio is actually flowing; `error`/`stalled` mean the service
// restarted underneath us (it restarts once per listener by design), and the fix
// for that is always the same: take a fresh URL and try again.
const a = document.getElementById("a"), go = document.getElementById("go");
const state = document.getElementById("state"), msg = document.getElementById("msg");
let on = false, retry = null;

function say(text, tone) { msg.textContent = text; state.dataset.tone = tone || "idle"; }

function connect() {
  clearTimeout(retry);
  // RELATIVE, not "/stream.webm". This page is also served under a mount prefix
  // (`tailscale serve --set-path=/audio`) so that the sound shares the desktop's
  // HTTPS origin instead of living on its own plain-http port. An absolute path
  // would leave the prefix behind and ask the DESKTOP agent for the stream, which
  // answers index.html — a 200 that is not audio, so nothing plays and nothing
  // errors. The server redirects the prefix to its directory form so that this
  // resolves the same either way.
  // Cache-busting is not superstition here: without it Safari re-uses the dead
  // response from the previous connection and plays nothing, silently.
  a.src = "stream.webm?t=" + Date.now();
  a.play().then(() => say("متصل", "live")).catch(() => say("اضغط الزر للتشغيل", "bad"));
}

function stop() {
  clearTimeout(retry);
  a.pause(); a.removeAttribute("src"); a.load();
}

go.addEventListener("click", () => {
  on = !on;
  go.dataset.on = on ? "1" : "0";
  go.textContent = on ? "■ إيقاف" : "▶︎ تشغيل الصوت";
  if (on) { say("يتصل…"); connect(); } else { stop(); say("متوقّف"); }
});

a.addEventListener("playing", () => say("متصل", "live"));
a.addEventListener("waiting", () => on && say("يتصل…"));
for (const ev of ["error", "ended", "stalled"]) {
  a.addEventListener(ev, () => {
    if (!on) return;
    say("انقطع — يعيد المحاولة…", "bad");
    clearTimeout(retry);
    retry = setTimeout(connect, 1200);
  });
}
</script></body></html>
"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "MoOSCloudAudio/2"
    sys_version = ""

    def log_message(self, fmt: str, *args: typing.Any) -> None:
        # systemd already stamps time and unit onto everything on stderr; the
        # default handler's own timestamp just makes every line twice as wide.
        sys.stderr.write("moos-cloud-audio: " + (fmt % args) + "\n")

    # ── routes ───────────────────────────────────────────────────────────────
    #
    # Matching on the LAST path segment rather than the whole path, because this service is reached
    # two ways and only one of them has the path it expects:
    #
    #   direct              http://<tailscale-ip>:8776/stream
    #   behind serve        https://<host>:8443/audio/stream   (`--set-path=/audio`)
    #
    # and whether `tailscale serve` strips its own mount prefix before proxying is a detail of the
    # version installed, not something this service should depend on. The leaf is the same either
    # way, so match on that and both work — including any deeper prefix somebody mounts later.
    ROUTES = {
        "": "page", "index.html": "page",
        "stream": "stream", "stream.webm": "stream",
        "healthz": "health",
    }

    # The mount path `moos-cloud-desktop own` publishes (`tailscale serve --set-path=/audio`), listed
    # EXPLICITLY rather than inferred from "anything unknown".
    #
    # The first version of this redirected every unrecognised path to its directory form, and the
    # repo's own gate caught what that means: `GET /../etc/passwd` came back 302 instead of 404.
    # Nothing was served and no encoder started, so it was harmless — but answering a traversal probe
    # with a redirect is both wrong and alarming, and "harmless today" is not the standard. One known
    # prefix is all this needs.
    MOUNT_PREFIXES = ("/audio",)

    def _leaf(self) -> str:
        return self.path.split("?", 1)[0].rsplit("/", 1)[-1]

    def _redirect_to_directory(self) -> None:
        """Send `/audio` to `/audio/`.

        The page asks for `stream.webm` relatively so that it works under any mount. A relative URL
        resolves against the DIRECTORY of the current document, so at `/audio` (no trailing slash)
        it would resolve to `/stream.webm` — off the mount and into the desktop agent. One redirect
        makes the browser's idea of "here" match the mount, and every relative URL below is then
        correct by construction rather than by luck.

        302 and not 301/308: the mount path is deployment configuration and can change, and a
        permanent redirect for it would be cached in browsers long after it stopped being true.
        """
        target = self.path.split("?", 1)[0] + "/"
        self.send_response(302)
        self.send_header("Location", target)
        self.send_header("Content-Length", "0")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def do_GET(self) -> None:
        what = self.ROUTES.get(self._leaf())
        if what == "page":
            self._page()
        elif what == "stream":
            self._stream()
        elif what == "health":
            self._text("ok\n")
        elif self.path.split("?", 1)[0] in self.MOUNT_PREFIXES:
            self._redirect_to_directory()
        else:
            self.send_error(404, "not found")

    def do_HEAD(self) -> None:
        if self.ROUTES.get(self._leaf()) == "stream":
            # Answer the probe without spawning an encoder for it.
            self.send_response(200)
            self.send_header("Content-Type", "audio/webm")
            self.send_header("Accept-Ranges", "none")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
        else:
            self.send_error(404, "not found")

    # ── responses ────────────────────────────────────────────────────────────
    def _text(self, body: str) -> None:
        raw = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _page(self) -> None:
        page = (PAGE.replace("__PORT__", html.escape(str(PORT)))
                    .replace("__DESKTOP_PORT__", html.escape(str(PORT - 10))))
        raw = page.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def _stream(self) -> None:
        if not _listeners.acquire(blocking=False):
            self.send_error(503, "too many listeners")
            return
        try:
            self._stream_locked()
        finally:
            _listeners.release()

    def _stream_locked(self) -> None:
        # A dead peer has to be discovered, not waited on. A phone that walks out
        # of Wi-Fi range never sends a FIN, and the encoder behind it keeps
        # running for nobody until the kernel notices.
        #
        # TCP_USER_TIMEOUT is the one that does the work here, and keepalive alone
        # would NOT have: keepalive probes only fire on an IDLE connection, and a
        # stream that is writing 12 KB every second is never idle. What that
        # connection actually does is retransmit unacknowledged data on the
        # default schedule — roughly fifteen minutes of an encoder running for a
        # phone that is long gone. TCP_USER_TIMEOUT caps exactly that.
        #
        # Keepalive is still set, because the reverse case is real too: a listener
        # who paused for a while has nothing in flight to retransmit.
        sock = self.connection
        try:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            for opt, value in (("TCP_USER_TIMEOUT", 20_000),   # milliseconds
                               ("TCP_KEEPIDLE", 30), ("TCP_KEEPINTVL", 10),
                               ("TCP_KEEPCNT", 3)):
                if hasattr(socket, opt):
                    sock.setsockopt(socket.IPPROTO_TCP, getattr(socket, opt), value)
        except OSError:
            pass

        read_fd, write_fd = os.pipe()
        os.set_inheritable(write_fd, True)
        proc = None
        try:
            proc = subprocess.Popen(
                pipeline(write_fd),
                pass_fds=(write_fd,),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,   # gst-launch chatter, never the media
                stderr=None,                 # real errors go to the journal
                start_new_session=True,      # so terminate() cannot reach us
            )
        except Exception as exc:
            os.close(read_fd)
            os.close(write_fd)
            self.log_message("cannot start gst-launch-1.0: %s", exc)
            self.send_error(503, "encoder unavailable")
            return

        # The parent must drop its copy of the write end, or the read side never
        # sees EOF when the encoder dies and this loop blocks forever.
        os.close(write_fd)

        self.send_response(200)
        self.send_header("Content-Type", "audio/webm")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Accept-Ranges", "none")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True

        try:
            while True:
                chunk = os.read(read_fd, 65536)
                if not chunk:
                    break        # encoder exited
                self.wfile.write(chunk)
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, TimeoutError, OSError):
            pass                 # the listener left; that is the normal ending
        finally:
            os.close(read_fd)
            _reap(proc)


def _reap(proc: typing.Optional['subprocess.Popen[typing.Any]']) -> None:
    if proc is None or proc.poll() is not None:
        return
    try:
        # start_new_session put gst-launch in its own process group, so this
        # reaches the whole pipeline and nothing else.
        os.killpg(proc.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError):
        proc.terminate()
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError):
            proc.kill()
        proc.wait()


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    # A listener whose stream is running holds its thread for as long as they
    # listen; shutdown must not wait on that.
    block_on_close = False


def main() -> None:
    server = Server((HOST, PORT), Handler)

    def bye(*_):
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    sys.stderr.write(f"moos-cloud-audio: listening on {HOST}:{PORT} (device {DEVICE})\n")
    sys.stderr.flush()
    try:
        server.serve_forever(poll_interval=0.5)
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
