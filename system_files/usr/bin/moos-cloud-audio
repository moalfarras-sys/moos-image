#!/usr/bin/python3
"""moos-cloud-audio — the server's sound, in a browser tab.

WHY THIS EXISTS

Mo PC Remote streams the desktop and nothing else. There is no audio path in it:
not in the Linux agent (agent-linux/ contains no capture, no encoder, no audio
endpoint) and not in the shipped controller bundle (no AudioContext, no
MediaSource, no audio URL). "No sound in the browser" on MoOS Cloud is not a
setting somebody turned off — the feature was never there.

A VPS also has no sound card at all. `/proc/asound/cards` says "no soundcards",
so WirePlumber falls back to `auto_null`, a sink that accepts audio and throws it
away. Every application on this machine has been playing into a bin.

This turns that bin into a stream: the default sink's monitor — exactly what the
desktop is playing — encoded to Opus-in-WebM, served over HTTP. Browsers play
Opus-in-WebM natively, so the listener needs no player, no plugin and no app.

    moalfarras (uid 1000) -> http://<tailscale-ip>:8775
    momo       (uid 1001) -> http://<tailscale-ip>:8776

WHY GSTREAMER AND NOT FFMPEG

This shipped on `ffmpeg -c:a libopus` and that was wrong in a way that cost four
commits. The *server* that the pipeline was measured on has RPMFusion's ffmpeg
8.1.2 WITH libopus. The *image* has no RPMFusion: its `ffmpeg` is Fedora's
`ffmpeg-free`, which has no libopus at all. The encoder that was measured was
never the encoder that shipped — and the build gate written to catch it failed
the whole image instead, so `moos-cloud` stopped publishing entirely while the
desktop editions moved on without it.

GStreamer is already in the image for Mo PC Remote's capture pipeline
(gstreamer1-plugins-base carries opusenc, -good carries pulsesrc and webmmux), so
this adds no package, no RPMFusion, and no size. build.sh asserts every element
below exists *in the image* rather than trusting that it does.

WHY A PYTHON SERVER IN FRONT OF IT

GStreamer has no plain HTTP sink. `tcpserversink` writes the raw muxed bytes with
no status line and no headers, which no browser will touch. So the HTTP part is
here and the media part is gst-launch, and the two are joined by a pipe.

WHAT IT COSTS WHEN NOBODY IS LISTENING

Nothing. The pipeline is not spawned until a listener actually requests the
stream, and it is killed when they leave. That matters on a box where the desktop
dashboard had to be turned off to get 1.5 cores back — this must not quietly
spend them again.
"""
import html
import os
import signal
import socket
import subprocess
import sys
import threading
import typing
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# The same derivation Mo PC Remote uses for its own port, so the two stay in
# step: person N's desktop is on 8765+N and their sound is on 8775+N.
PORT = int(os.environ.get("MOOS_AUDIO_PORT") or (8775 + os.getuid() - 1000))

# LOOPBACK, and this is a security boundary rather than a preference.
#
# THIS SERVICE HAS NO AUTHENTICATION. None: no PIN, no token, no session. Whoever can open the
# socket hears the machine's microphone-adjacent reality — every call, every video, everything the
# desktop is playing. That was defensible while it bound 0.0.0.0 ONLY on the cloud edition, whose
# firewalld default zone is FedoraServer (ssh alone) with just tailscale0 trusted, so the port
# genuinely answered on the tailnet and nowhere else.
#
# That argument is edition-specific, and it does not survive contact with a desktop. Measured on a
# MoOS desktop:
#
#     $ firewall-cmd --get-default-zone
#     FedoraWorkstation
#     $ firewall-cmd --list-ports
#     1025-65535/tcp 1025-65535/udp
#
# FedoraWorkstation opens everything above 1024 to the local network by design. So the instant this
# service is enabled on a desktop — which is exactly what makes the Sound button work from a phone —
# a 0.0.0.0 bind publishes unauthenticated live audio to every device on the WiFi. A café, a hotel,
# a shared flat.
#
# Binding loopback removes the question rather than answering it. The supported path in is
# `tailscale serve --set-path=/audio http://127.0.0.1:8775`, which connects to 127.0.0.1 anyway —
# so the reachable surface is unchanged for every user who arrives the intended way, and closed for
# everyone else. It also no longer depends on the firewall being configured correctly, which is the
# kind of dependency that is true until somebody changes a zone.
#
# The cost is the undocumented direct http://<tailscale-ip>:8775 fallback, which was plain HTTP —
# the very thing this repo spent several commits routing users AWAY from, because a browser
# withholds WebCodecs, the clipboard and a PWA install outside a secure context.
#
# MOOS_AUDIO_HOST still overrides it for anyone who has a reason.
HOST = os.environ.get("MOOS_AUDIO_HOST", "127.0.0.1")

# One person per desktop is the shape, but a phone that loses signal leaves a
# socket that TCP will not reap for two hours. A hard limit of one listener would
# hand that dead socket the only slot; a small pool means reconnecting always
# works, and four Opus encoders is still under a tenth of a core.
MAX_LISTENERS = 4

BITRATE = int(os.environ.get("MOOS_AUDIO_BITRATE") or 96000)

# @DEFAULT_MONITOR@ follows whatever sink is current rather than hardcoding
# `auto_null`. The name of the fallback sink is WirePlumber's business, and on a
# machine that later gains a real device the monitor should follow it.
DEVICE = os.environ.get("MOOS_AUDIO_DEVICE", "@DEFAULT_MONITOR@")

_listeners = threading.BoundedSemaphore(MAX_LISTENERS)


def pipeline(out_fd: int) -> list[str]:
    """gst-launch's argv, writing muxed WebM to `out_fd`.

    The caps filter after audioconvert is load-bearing, not decoration. A null
    sink's monitor advertises ONE channel; opusenc will happily encode mono, and
    then everything the desktop actually plays in stereo arrives folded down.
    audioconvert upmixes only because it is told to.

    fdsink writes to an explicit inherited fd and NOT to stdout, which is the
    other trap here: gst-launch prints "Setting pipeline to PAUSED ..." on
    stdout, and those bytes landing in the middle of a WebM header produce a
    stream that fails to play for a reason nothing reports. -q silences them
    today; a private fd means it does not matter if that ever changes.
    """
    return [
        "gst-launch-1.0", "-q",
        "pulsesrc", f"device={DEVICE}",
        "!", "audioconvert",
        "!", "audioresample",
        "!", "audio/x-raw,rate=48000,channels=2",
        "!", "opusenc", f"bitrate={BITRATE}",
        "!", "webmmux", "streamable=true",
        "!", "fdsink", f"fd={out_fd}", "sync=false",
    ]


PAGE = """<!doctype html>
<html lang="ar" dir="rtl"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>صوت MoOS</title>
<style>
  :root {
    --canvas:#14191C; --card:#232D32; --raised:#2C383E; --primary:#4ED7C8;
    --text:#E8F1EF; --muted:#9CAFAC; --outline:#415158; --on-accent:#102522;
    --negative:#FF7D88; --positive:#69D9A5;
  }
  * { box-sizing:border-box; }
  body {
    margin:0; min-height:100dvh; display:grid; place-items:center; padding:24px;
    background:radial-gradient(120% 90% at 50% 0%, #1B2429 0%, var(--canvas) 70%);
