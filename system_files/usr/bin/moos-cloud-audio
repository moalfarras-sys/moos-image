  button {
    width:100%; border:0; border-radius:16px; padding:16px 20px; cursor:pointer;
    background:var(--primary); color:var(--on-accent);
    font-family:inherit; font-size:1.05rem; font-weight:650;
    transition:transform .12s ease, filter .12s ease;
  }
  button:hover { filter:brightness(1.06); }
  button:active { transform:scale(.985); }
  button[data-on="1"] { background:var(--raised); color:var(--text); }
  .state {
    margin-top:18px; min-height:1.4em; font-size:.88rem; color:var(--muted);
    display:flex; align-items:center; justify-content:center; gap:8px;
  }
  .dot { width:8px; height:8px; border-radius:50%; background:var(--outline); }
  .state[data-tone="live"] .dot { background:var(--positive); box-shadow:0 0 0 4px rgba(105,217,165,.16); }
  .state[data-tone="bad"]  .dot { background:var(--negative); }
  .state[data-tone="live"] { color:var(--text); }
