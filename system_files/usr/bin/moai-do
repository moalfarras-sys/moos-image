#!/usr/bin/env bash
# =============================================================================
# moai-do — MoOS "Mo AI" safe action executor.
# =============================================================================
# Mo AI (the pure-QML assistant at /usr/share/moos/apps/moai/main.qml) cannot
# execute commands itself, so it COPIES `moai-do <action>` commands for the user
# to run in a terminal. THIS script is the safe, auditable executor behind those
# suggestions: a small whitelist of actions, bilingual (AR|EN) prompts, explicit
# confirmation before every state-changing step, and pkexec (a polkit GUI
# prompt) for privileged calls — NEVER a passwordless sudo.
#
# External commands VERIFIED 2026-07-10:
#   - bootc upgrade                  (bootc.dev man pages) stages update, applies on reboot
#   - flatpak install -y REMOTE REF  (flatpak docs; -y/--assumeyes; flathub remote)
#   - flatpak uninstall --unused -y  (flatpak-uninstall(1)) drop unused runtimes
#   - fwupdmgr get-devices           (fwupd.github.io) READ-ONLY device list
#   - podman image prune -f          (docs.podman.io; -f = no prompt)
#   - journalctl --vacuum-time=7d    (systemd journalctl(1)) needs root -> pkexec
#   - systemctl --user restart pipewire pipewire-pulse wireplumber
#                                    (PipeWire user services) audio reset, no privilege
# =============================================================================
set -euo pipefail

# lspci lives under /usr/sbin on Fedora — make sure it is reachable.
export PATH="/usr/sbin:/sbin:${PATH}"

# ---- colors (disabled when stdout is not a terminal) ------------------------
if [ -t 1 ]; then
    B=$'\033[1;34m'; C=$'\033[1;36m'; V=$'\033[1;35m'
    G=$'\033[1;32m'; Y=$'\033[1;33m'; R=$'\033[1;31m'
    D=$'\033[2m';    N=$'\033[0m'
else
    B=; C=; V=; G=; Y=; R=; D=; N=
fi

# hdr "AR title" "EN title" — bilingual section header.
hdr() {
    echo
    echo "${C}▸ ${1}${N}"
    echo "${C}  ${2}${N}"
    echo
}

# confirm — read -rp prompt, default NO. Returns 0 only on an explicit yes.
confirm() {
    local ans=""
    printf '%s' "${V}متابعة؟ | Continue? [y/N] ${N}"
    read -r ans || return 1
    case "${ans:-N}" in
        [Yy]|[Yy][Ee][Ss]) return 0 ;;
        *) echo "${D}أُلغي | Cancelled.${N}"; return 1 ;;
    esac
}

# run_priv — privileged run via polkit (no sudo assumption).
run_priv() {
    if command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    else
        echo "${Y}pkexec غير متوفّر — لا يمكن طلب صلاحية المسؤول.${N}" >&2
        echo "${Y}pkexec not available — cannot request admin privileges.${N}" >&2
        return 127
    fi
}

# need <cmd> — verify a command exists, else print a bilingual note.
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "${R}${1} غير موجود على هذا النظام | not found${N}" >&2
        return 1
    fi
}

# avail_bytes <path> — available bytes on the filesystem holding <path>.
avail_bytes() {
    df -B1 --output=avail "$1" 2>/dev/null | tail -n 1 | tr -d '[:space:]'
}

# human <bytes> — pretty size (IEC), falling back to a plain count.
human() {
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0} B"
    else
        echo "${1:-0} B"
    fi
}

# -----------------------------------------------------------------------------
# update — atomic system update via bootc (applies on reboot).
# -----------------------------------------------------------------------------
do_update() {
    hdr "تحديث النظام (ذرّي عبر bootc)" "System update (atomic via bootc)"
    echo "${D}يُنزّل ويُجهّز نسخة جديدة — تُطبَّق عند إعادة التشغيل. لا يمسّ ملفاتك.${N}"
    echo "${D}Downloads & stages a new version — applies on reboot. Files untouched.${N}"
    echo
    need bootc || { echo "${Y}شغّل هذا داخل MoOS | run this on a MoOS system${N}"; return 1; }
    confirm || return 0
    echo "${C}قد يظهر طلب إذن المسؤول | an admin prompt may appear…${N}"
    if run_priv bootc upgrade; then
        echo "${G}✓ تم التجهيز — أعد التشغيل لإكمال التحديث.${N}"
        echo "${G}  Staged — reboot to finish. ${D}(لا تغيير = محدّث بالفعل | no change = already up to date)${N}"
    else
        echo "${Y}لم يكتمل التحديث | update did not complete${N}"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# install <flatpak-id> — install a Flatpak app from Flathub.
# -----------------------------------------------------------------------------
do_install() {
    local id="${1:-}"
    hdr "تثبيت تطبيق من Flathub" "Install an app from Flathub"
    if [ -z "$id" ]; then
        echo "${Y}حدّد معرّف التطبيق | provide an app id${N}"
        echo "${D}مثال | e.g.:  moai-do install org.mozilla.firefox${N}"
        return 2
    fi
    # Validate: letters, digits, dots, dashes, underscores only (reverse-DNS ids).
    if ! printf '%s' "$id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'; then
        echo "${R}معرّف غير صالح | invalid app id:${N} ${id}"
        echo "${D}يُسمح بالحروف والأرقام والنقاط والشرطات فقط | letters, digits, dots, dashes only${N}"
        return 2
    fi
    need flatpak || return 1
    echo "${C}التطبيق | App :${N} ${id}"
    echo "${D}المصدر | From : flathub${N}"
    confirm || return 0
    if flatpak install -y flathub "$id"; then
        echo "${G}✓ تم التثبيت | installed:${N} ${id}"
    else
        echo "${Y}لم يكتمل التثبيت (تحقّق من المعرّف على flathub.org).${N}"
        echo "${Y}Install did not complete (check the id on flathub.org).${N}"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# fix-audio — restart the user's PipeWire stack.
# -----------------------------------------------------------------------------
do_fix_audio() {
    hdr "إصلاح الصوت (إعادة تشغيل PipeWire)" "Fix audio (restart PipeWire)"
    echo "${D}يعيد تشغيل خدمات الصوت للمستخدم — سينقطع الصوت للحظة. بلا صلاحيات مسؤول.${N}"
    echo "${D}Restarts your user audio services — sound blips briefly. No admin needed.${N}"
    echo
    need systemctl || return 1
    confirm || return 0
    if systemctl --user restart pipewire pipewire-pulse wireplumber; then
        echo "${G}✓ أُعيد تشغيل الصوت | audio services restarted${N}"
    else
        echo "${Y}تعذّرت إعادة التشغيل — سجّل الخروج والدخول قد يساعد.${N}"
        echo "${Y}Restart failed — logging out and back in may help.${N}"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# check-drivers — READ-ONLY GPU + firmware report (no confirmation needed).
# -----------------------------------------------------------------------------
do_check_drivers() {
    hdr "فحص التعريفات والعتاد (قراءة فقط)" "Check drivers & hardware (read-only)"

    local gpu=""
    if command -v lspci >/dev/null 2>&1; then
        gpu="$(lspci | grep -Ei 'vga compatible controller|3d controller|display controller' || true)"
    fi
    echo "${B}كرت الشاشة | Graphics:${N}"
    if [ -n "$gpu" ]; then
        echo "$gpu" | sed 's/^/  /'
    else
        echo "  ${D}غير متاح (lspci) | unavailable${N}"
    fi
    echo

    if printf '%s' "$gpu" | grep -qi nvidia; then
        echo "${Y}⚠ كرت NVIDIA مكتشف — لأفضل تعريف انتقل إلى صورة MoOS الخاصة بـ NVIDIA:${N}"
        echo "${Y}⚠ NVIDIA GPU detected — for the best driver, switch to the MoOS NVIDIA image:${N}"
        echo "${C}  sudo bootc switch ghcr.io/moalfarras-sys/moos-nvidia:latest${N}"
        echo "${D}  (يُطبَّق عند إعادة التشغيل | applies on reboot)${N}"
        echo
    fi

    echo "${B}البرمجيات الثابتة | Firmware devices (fwupd):${N}"
    if command -v fwupdmgr >/dev/null 2>&1; then
        fwupdmgr get-devices || echo "  ${D}تعذّر الاستعلام | query failed${N}"
    else
        echo "  ${D}fwupdmgr غير مثبّت | not installed${N}"
    fi
}

do_update_firmware() {
    hdr "تحديث البرامج الثابتة" "Update device firmware"
    if ! command -v fwupdmgr >/dev/null 2>&1; then
        echo "${R}fwupd غير متوفر | fwupd is not available${N}" >&2
        return 1
    fi
    # Refresh the metadata first, otherwise "no updates" can simply mean "never checked".
    # --force lets a same-day re-check through instead of erroring on the cache age.
    fwupdmgr refresh --force >/dev/null 2>&1 || true
    echo "${D}البرامج الثابتة المتاحة | Available firmware updates:${N}"
    if ! fwupdmgr get-updates 2>/dev/null; then
        echo "${G}✓ لا توجد تحديثات برامج ثابتة | No firmware updates available${N}"
        return 0
    fi
    echo
    echo "${Y}تحديث البرامج الثابتة قد يتطلب إعادة تشغيل ولا يمكن التراجع عنه.${N}"
    echo "${Y}Firmware updates may require a reboot and cannot be rolled back.${N}"
    confirm || return 0
    run_priv fwupdmgr update
    echo "${G}✓ اكتمل | Done${N}"
}

do_install_nvidia() {
    hdr "تثبيت تعريف NVIDIA الأمثل" "Install the optimized NVIDIA driver"
    local gpu
    gpu="$(lspci 2>/dev/null | grep -Ei 'vga compatible controller|3d controller|display controller' || true)"
    if ! printf '%s' "$gpu" | grep -qi nvidia; then
        echo "${Y}لم تُكتشف بطاقة NVIDIA — لن يتغير النظام | No NVIDIA GPU detected — nothing changed${N}"
        return 0
    fi
    echo "${D}ينتقل إلى صورة MoOS NVIDIA الذرية ويُبقي النشر السابق للرجوع.${N}"
    echo "${D}Switches to the atomic NVIDIA image and keeps the previous deployment for rollback.${N}"
    confirm || return 0
    run_priv bootc switch ghcr.io/moalfarras-sys/moos-nvidia:latest
    echo "${G}✓ تم التجهيز — أعد التشغيل لتفعيل التعريف | Staged — reboot to activate${N}"
}

do_setup_waydroid() {
    hdr "تجهيز Android عبر Waydroid" "Set up Android through Waydroid"
    need waydroid || return 1
    echo "${D}ينزّل صورة Android الحرة ويشغّل الحاوية. لا يتضمن Google Play.${N}"
    echo "${D}Downloads the free Android image and starts its container. Google Play is not included.${N}"
    confirm || return 0
    run_priv waydroid init -s VANILLA
    run_priv systemctl enable --now waydroid-container.service
    waydroid show-full-ui >/dev/null 2>&1 &
}

# -----------------------------------------------------------------------------
# remote-anywhere — make Mo PC Remote reachable once the phone leaves the house.
#
# It already is, in every way that matters: Tailscale is a mesh, not a LAN trick, and the agent
# has always accepted the tailnet. What was missing is a NAME and a CERTIFICATE. Without them
# the only address anyone can be handed is the LAN IP over plain http — an address that stops
# existing on mobile data, and that the browser also refuses to treat as a secure context, which
# in turn locks Mo PC Remote out of hardware video decode, the clipboard and PWA install.
#
# `tailscale serve` supplies both: TLS on this machine's MagicDNS name with a real, auto-renewing
# certificate, proxied to the agent on loopback. It is tailnet-only — nothing is exposed to the
# public internet. (`tailscale funnel` is the one that would be. MoOS does not use it.)
#
# The privileged half is one line: make this user Tailscale's operator, so serve — and every
# later change to it — needs no root at all.
# -----------------------------------------------------------------------------
do_remote_anywhere() {
    hdr "الوصول إلى Mo PC Remote من أي مكان" "Reach Mo PC Remote from anywhere"
    need tailscale || return 1

    local state
    state="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("BackendState",""))' 2>/dev/null || true)"
    if [ "$state" != "Running" ]; then
        echo "${R}Tailscale ليس متصلاً | Tailscale is not connected${N}" >&2
        echo "${D}شغّله أولاً | connect it first:  tailscale up${N}" >&2
        return 1
    fi

    echo "${D}يمنح هذا الجهاز اسماً وشهادة HTTPS حقيقية على شبكتك الخاصة، فيعمل التحكم من بيانات الجوال.${N}"
    echo "${D}لا شيء يُنشر على الإنترنت العام — الوصول محصور بأجهزتك.${N}"
    echo "${D}Gives this machine a real HTTPS name on your private tailnet, so the phone works on"
    echo "mobile data. Nothing is published to the public internet — your devices only.${N}"
    confirm || return 0

    run_priv tailscale set --operator="$USER"
    tailscale serve --bg --https=443 http://127.0.0.1:8765 || {
        echo "${R}فشل tailscale serve | tailscale serve failed${N}" >&2
        echo "${D}تحتاج تفعيل شهادات HTTPS في لوحة Tailscale (DNS ← HTTPS Certificates).${N}" >&2
        echo "${D}HTTPS certificates must be enabled for your tailnet (DNS -> HTTPS Certificates).${N}" >&2
        return 1
    }
    echo
    tailscale serve status
}

# -----------------------------------------------------------------------------
# optimize — clean unused Flatpak runtimes + container images + old logs.
# -----------------------------------------------------------------------------
do_optimize() {
    hdr "تحسين وتنظيف" "Optimize & clean up"
    echo "${D}يحذف أوقات تشغيل Flatpak غير المستخدمة، وصور الحاويات غير المستخدمة،${N}"
    echo "${D}ويقلّص سجلّات النظام الأقدم من 7 أيام. لا يمسّ ملفاتك الشخصية.${N}"
    echo "${D}Removes unused Flatpak runtimes and container images, and trims system${N}"
    echo "${D}logs older than 7 days. Your personal files are untouched.${N}"
    echo
    confirm || return 0

    local fs="/var"
    [ -d /var ] || fs="/"
    local before after freed
    before="$(avail_bytes "$fs")"
    before="${before:-0}"

    echo "${C}› Flatpak: إزالة غير المستخدم | removing unused runtimes…${N}"
    if command -v flatpak >/dev/null 2>&1; then
        flatpak uninstall --unused -y || echo "  ${D}(لا شيء لإزالته | nothing to remove)${N}"
    else
        echo "  ${D}flatpak غير موجود | not present${N}"
    fi

    echo "${C}› Podman: تقليم الصور | pruning unused images…${N}"
    if command -v podman >/dev/null 2>&1; then
        podman image prune -f >/dev/null 2>&1 || true
    else
        echo "  ${D}podman غير موجود | not present${N}"
    fi

    echo "${C}› Journal: تقليص السجلّات (7 أيام) | vacuum logs (7d)…${N}"
    run_priv journalctl --vacuum-time=7d || echo "  ${D}(تخطّي | skipped)${N}"

    after="$(avail_bytes "$fs")"
    after="${after:-0}"
    freed=$(( after - before ))
    if [ "$freed" -lt 0 ]; then
        freed=0
    fi
    echo
    echo "${G}✓ اكتمل | done — تحرّر تقريباً | freed ~$(human "$freed") على | on ${fs}${N}"
}

# Read-only diagnostics. These deliberately collect bounded status summaries;
# they never restart a unit, edit boot configuration, or request privileges.
do_diagnose_services() {
    hdr "تشخيص الخدمات الفاشلة (قراءة فقط)" "Diagnose failed services (read-only)"
    echo "${B}System units:${N}"
    systemctl --failed --no-pager || true
    echo
    echo "${B}User units:${N}"
    systemctl --user --failed --no-pager || true
}

do_inspect_boot() {
    hdr "فحص مشاكل الإقلاع (قراءة فقط)" "Inspect boot problems (read-only)"
    echo "${B}Boot deployment:${N}"
    bootc status 2>/dev/null || ostree admin status 2>/dev/null || true
    echo
    echo "${B}Current-boot errors:${N}"
    journalctl -b -p err --no-pager -n 80 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# usage — bilingual help listing every subcommand.
# -----------------------------------------------------------------------------
usage() {
    cat <<EOF
${B}Mo AI · moai-do${N}  —  ${D}منفّذ أوامر MoOS الآمن | MoOS safe action runner${N}

${V}الاستعمال | Usage:${N}  moai-do <command> [args]

  ${C}update${N}            تحديث النظام (bootc، يُطبَّق عند إعادة التشغيل)
                    Update the system (bootc, applies on reboot)
  ${C}install <id>${N}      تثبيت تطبيق Flatpak من Flathub
                    Install a Flatpak app from Flathub
  ${C}fix-audio${N}         إعادة تشغيل خدمات الصوت (PipeWire)
                    Restart audio services (PipeWire)
  ${C}check-drivers${N}     عرض كرت الشاشة والبرمجيات الثابتة (قراءة فقط)
                    Show GPU & firmware devices (read-only)
  ${C}install-nvidia${N}    تجهيز صورة NVIDIA الصحيحة بأمان
                    Stage the correct NVIDIA image safely
  ${C}update-firmware${N}   تحديث البرامج الثابتة للأجهزة عبر fwupd
                    Update device firmware through fwupd
  ${C}setup-waydroid${N}    تنزيل وتجهيز Android الاختياري
                    Download and configure optional Android support
  ${C}optimize${N}          تنظيف Flatpak/الحاويات/السجلّات وتحرير مساحة
                    Clean Flatpak/containers/logs and free disk space
  ${C}hw-report${N}         فتح مركز العتاد | open the Hardware Center
  ${C}remote-anywhere${N}   تشغيل Mo PC Remote من خارج البيت (Tailscale HTTPS)
                    Reach Mo PC Remote from outside the house
  ${C}diagnose-services${N} عرض الخدمات الفاشلة (قراءة فقط)
                    Show failed services (read-only)
  ${C}inspect-boot${N}      عرض حالة النشر وأخطاء الإقلاع (قراءة فقط)
                    Show deployment and boot errors (read-only)
  ${C}help${N}              عرض هذه المساعدة | show this help

${D}كل إجراء مُغيِّر يطلب تأكيداً، والصلاحيات عبر pkexec (لا sudo بلا كلمة مرور).${N}
${D}Every state-changing action asks to confirm; privileges go through pkexec.${N}
EOF
}

# -----------------------------------------------------------------------------
# dispatch
# -----------------------------------------------------------------------------
main() {
    local cmd="${1:-help}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$cmd" in
        update)        do_update ;;
        install)       do_install "${1:-}" ;;
        fix-audio)     do_fix_audio ;;
        check-drivers) do_check_drivers ;;
        install-nvidia) do_install_nvidia ;;
        update-firmware) do_update_firmware ;;
        setup-waydroid) do_setup_waydroid ;;
        remote-anywhere) do_remote_anywhere ;;
        optimize)      do_optimize ;;
        diagnose-services) do_diagnose_services ;;
        inspect-boot)  do_inspect_boot ;;
        hw-report)
            if command -v moos-hardware >/dev/null 2>&1; then
                exec moos-hardware
            else
                echo "${R}moos-hardware غير موجود | not found${N}" >&2
                return 1
            fi
            ;;
        help|-h|--help) usage ;;
        *)
            echo "${R}أمر غير معروف | unknown command:${N} ${cmd}" >&2
            echo >&2
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
