#!/usr/bin/env bash
# =============================================================================
# moai-do — MoOS "Mo AI" safe action executor.
# =============================================================================
# Mo AI (the pure-QML assistant at /usr/share/moos/apps/moai/main.qml) cannot
# execute commands itself, so it COPIES `moai-do <action>` commands for the user
# to run in a terminal. THIS script is the safe, auditable executor behind those
# suggestions: a small whitelist of actions, bilingual (AR|EN) prompts, explicit
# confirmation before every state-changing step, and pkexec (a polkit GUI
# prompt) for privileged calls — NEVER a passwordless sudo.
#
# External commands VERIFIED 2026-07-10:
#   - rpm-ostree rebase <signed-ref> stages an exact signed image, applies on reboot
#   - flatpak install -y REMOTE REF  (flatpak docs; -y/--assumeyes; flathub remote)
#   - flatpak uninstall --unused -y  (flatpak-uninstall(1)) drop unused runtimes
#   - fwupdmgr get-devices           (fwupd.github.io) READ-ONLY device list
#   - podman image prune -f          (docs.podman.io; -f = no prompt)
#   - journalctl --vacuum-time=7d    (systemd journalctl(1)) needs root -> pkexec
#   - systemctl --user restart pipewire pipewire-pulse wireplumber
#                                    (PipeWire user services) audio reset, no privilege
# =============================================================================
set -euo pipefail

# lspci lives under /usr/sbin on Fedora — make sure it is reachable. Keep the
# caller's normal command order; Polkit applies its own trusted execution path.
export PATH="${PATH}:/usr/sbin:/sbin"

# ---- colors (disabled when stdout is not a terminal) ------------------------
if [ -t 1 ]; then
    B=$'\033[1;34m'; C=$'\033[1;36m'; V=$'\033[1;35m'
    G=$'\033[1;32m'; Y=$'\033[1;33m'; R=$'\033[1;31m'
    D=$'\033[2m';    N=$'\033[0m'
else
    B=; C=; V=; G=; Y=; R=; D=; N=
fi

# hdr "AR title" "EN title" — bilingual section header.
hdr() {
    echo
    echo "${C}▸ ${1}${N}"
    echo "${C}  ${2}${N}"
    echo
}

# confirm — read -rp prompt, default NO. Returns 0 only on an explicit yes.
confirm() {
    local ans=""
    printf '%s' "${V}متابعة؟ | Continue? [y/N] ${N}"
    # A closed stdin reads EOF, which is a decline, not an approval — record it as one.
    if ! read -r ans; then AUDIT_DECISION=declined; return 1; fi
    case "${ans:-N}" in
        [Yy]|[Yy][Ee][Ss]) AUDIT_DECISION=approved; return 0 ;;
        *) AUDIT_DECISION=declined; echo "${D}أُلغي | Cancelled.${N}"; return 1 ;;
    esac
}

# run_priv — privileged run via polkit (no sudo assumption).
run_priv() {
    if command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    else
        echo "${Y}pkexec غير متوفّر — لا يمكن طلب صلاحية المسؤول.${N}" >&2
        echo "${Y}pkexec not available — cannot request admin privileges.${N}" >&2
        return 127
    fi
}

# need <cmd> — verify a command exists, else print a bilingual note.
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "${R}${1} غير موجود على هذا النظام | not found${N}" >&2
        return 1
    fi
}

# avail_bytes <path> — available bytes on the filesystem holding <path>.
avail_bytes() {
    df -B1 --output=avail "$1" 2>/dev/null | tail -n 1 | tr -d '[:space:]'
}

# human <bytes> — pretty size (IEC), falling back to a plain count.
human() {
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0} B"
    else
        echo "${1:-0} B"
    fi
}

# launch_detached <argv…> — accept either a process that stays alive or a launcher that exits 0.
# A bare `cmd &` reports only that Bash created a child; even a missing/broken Flatpak then looks
# successful. Give it a short rejection window while preserving D-Bus launchers that exit cleanly.
launch_detached() {
    setsid "$@" >/dev/null 2>&1 &
    local pid=$!
    sleep 0.25
    if kill -0 "$pid" >/dev/null 2>&1; then
        return 0
    fi
    wait "$pid"
}

# launch_app <id> — open an installed app, detached, as the user.
# A Flatpak is run by its id, a native app by its desktop file. The optional
# GPU-headroom step never fails the caller, but a rejected launcher DOES. It takes
# no arguments beyond the id, so it can do no more than start an
# app the user already has. This is what makes `install` also RUN:
# the whole point of "install a camera" is to end up looking through the camera.
#
# It also asks for GPU headroom first, and that is not an optimisation. This machine's
# local brain holds ~6 GB of an 8 GB card for as long as it is loaded, and a graphical app
# started into the ~300 MB that leaves does not fall back to software — it ABORTS on
# eglMakeCurrent. MoPlayer survives only because /usr/bin/moplayer calls moos-gpu-headroom
# itself; a Flatpak has no MoOS launcher to do that for it, so an app Mo AI installs is
# launched straight into a full card. The user asked for a camera and got a crash, which is
# indistinguishable from "MoOS installed something broken". The guard unloads only OUR OWN
# brain (moai-gateway reloads it on the next message), never the user's programs, and it is
# silent and non-fatal — see moos-gpu-headroom.
launch_app() {
    local id="${1:-}"
    [ -n "$id" ] || return 1
    command -v moos-gpu-headroom >/dev/null 2>&1 && moos-gpu-headroom 2>/dev/null || true
    if flatpak info "$id" >/dev/null 2>&1; then
        launch_detached flatpak run "$id"
    elif command -v gtk-launch >/dev/null 2>&1; then
        launch_detached gtk-launch "$id"
    else
        return 1
    fi
}

# -----------------------------------------------------------------------------
# update — resolve the official latest image to an immutable digest, then stage it
# through the signature-enforcing rpm-ostree transport. A digest-pinned installation
# cannot advance with `bootc upgrade`: its origin deliberately names the old immutable
# object. We therefore discover `:latest` without privilege, reject every repository
# except MoOS's two official editions, validate the digest shape, and pass only the
# constructed exact reference across Polkit.
# -----------------------------------------------------------------------------
do_update() {
    hdr "تحديث النظام (صورة MoOS موقّعة وثابتة)" "System update (exact signed MoOS image)"
    echo "${D}يُنزّل ويُجهّز نسخة جديدة — تُطبَّق عند إعادة التشغيل. لا يمسّ ملفاتك.${N}"
    echo "${D}Downloads & stages a new version — applies on reboot. Files untouched.${N}"
    echo
    need rpm-ostree || { echo "${Y}شغّل هذا داخل MoOS | run this on a MoOS system${N}"; return 1; }
    need skopeo || return 1
    need python3 || return 1

    local status ref edition registry latest current target
    status="$(rpm-ostree status --json)" || return 1
    ref="$(python3 -c '
import json, sys
for deployment in json.load(sys.stdin).get("deployments", []):
    if deployment.get("booted"):
        print(deployment.get("container-image-reference", ""))
        break
' <<<"$status")"

    registry="ghcr.io/moalfarras-sys"
    case "$ref" in
        *"/moos-nvidia@"*|*"/moos-nvidia:"*) edition="moos-nvidia" ;;
        *"/moos@"*|*"/moos:"*) edition="moos" ;;
        *)
            echo "${R}تعذّر تحديد إصدار MoOS المشغّل بأمان.${N}" >&2
            echo "${R}Could not safely identify the booted MoOS edition.${N}" >&2
            return 1
            ;;
    esac

    echo "${C}الإصدار | Edition:${N} ${edition}"
    echo "${D}يفحص أحدث صورة من ghcr.io/moalfarras-sys فقط…${N}"
    echo "${D}Checking only the official ghcr.io/moalfarras-sys image…${N}"
    latest="$(skopeo inspect --format '{{.Digest}}' "docker://${registry}/${edition}:latest")" || return 1
    if ! printf '%s' "$latest" | grep -Eq '^sha256:[0-9a-f]{64}$'; then
        echo "${R}رفض digest غير صالح من السجل | refused invalid registry digest${N}" >&2
        return 1
    fi
    current="$(printf '%s' "$ref" | grep -Eo 'sha256:[0-9a-f]{64}' | tail -n 1 || true)"
    if [ "$latest" = "$current" ]; then
        echo "${G}✓ النظام على أحدث صورة موقّعة | already on the latest signed image${N}"
        return 0
    fi

    target="ostree-image-signed:docker://${registry}/${edition}@${latest}"
    echo "${C}الحالي | Current:${N} ${current:-unknown}"
    echo "${C}الجديد | New:    ${N} ${latest}"
    confirm || return 0
    echo "${C}قد يظهر طلب إذن المسؤول | an admin prompt may appear…${N}"
    if run_priv rpm-ostree rebase "$target"; then
        echo "${G}✓ تم التجهيز — أعد التشغيل لإكمال التحديث.${N}"
        echo "${G}  Staged — reboot to finish. The previous deployment remains available.${N}"
    else
        echo "${Y}لم يكتمل التحديث | update did not complete${N}"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# install <flatpak-id> — install a Flatpak app from Flathub.
# -----------------------------------------------------------------------------
do_install() {
    local id="${1:-}"
    hdr "تثبيت تطبيق من Flathub" "Install an app from Flathub"
    if [ -z "$id" ]; then
        echo "${Y}حدّد معرّف التطبيق | provide an app id${N}"
        echo "${D}مثال | e.g.:  moai-do install org.mozilla.firefox${N}"
        return 2
    fi
    # Validate: letters, digits, dots, dashes, underscores only (reverse-DNS ids).
    if ! printf '%s' "$id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'; then
        echo "${R}معرّف غير صالح | invalid app id:${N} ${id}"
        echo "${D}يُسمح بالحروف والأرقام والنقاط والشرطات فقط | letters, digits, dots, dashes only${N}"
        return 2
    fi
    need flatpak || return 1
    echo "${C}التطبيق | App :${N} ${id}"
    echo "${D}المصدر | From : flathub${N}"
    confirm || return 0
    if flatpak install -y flathub "$id"; then
        echo "${G}✓ تم التثبيت | installed:${N} ${id}"
        echo "${C}يفتح التطبيق الآن… | opening it now…${N}"
        if ! launch_app "$id"; then
            echo "${Y}تم التثبيت، لكن تعذّر فتح التطبيق الآن.${N}" >&2
            echo "${Y}Installed successfully, but the app could not be opened now.${N}" >&2
            return 1
        fi
    else
        echo "${Y}لم يكتمل التثبيت (تحقّق من المعرّف على flathub.org).${N}"
        echo "${Y}Install did not complete (check the id on flathub.org).${N}"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# fix-audio — restart the user's PipeWire stack.
# -----------------------------------------------------------------------------
do_fix_audio() {
    hdr "إصلاح الصوت (إعادة تشغيل PipeWire)" "Fix audio (restart PipeWire)"
    echo "${D}يعيد تشغيل خدمات الصوت للمستخدم — سينقطع الصوت للحظة. بلا صلاحيات مسؤول.${N}"
    echo "${D}Restarts your user audio services — sound blips briefly. No admin needed.${N}"
    echo
    need systemctl || return 1
    confirm || return 0
    if systemctl --user restart pipewire pipewire-pulse wireplumber; then
        echo "${G}✓ أُعيد تشغيل الصوت | audio services restarted${N}"
    else
        echo "${Y}تعذّرت إعادة التشغيل — سجّل الخروج والدخول قد يساعد.${N}"
        echo "${Y}Restart failed — logging out and back in may help.${N}"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# check-drivers — READ-ONLY GPU + firmware report (no confirmation needed).
# -----------------------------------------------------------------------------
do_check_drivers() {
    hdr "فحص التعريفات والعتاد (قراءة فقط)" "Check drivers & hardware (read-only)"

    local gpu=""
    if command -v lspci >/dev/null 2>&1; then
        gpu="$(lspci | grep -Ei 'vga compatible controller|3d controller|display controller' || true)"
    fi
    echo "${B}كرت الشاشة | Graphics:${N}"
    if [ -n "$gpu" ]; then
        echo "$gpu" | sed 's/^/  /'
    else
        echo "  ${D}غير متاح (lspci) | unavailable${N}"
    fi
    echo

    if printf '%s' "$gpu" | grep -qi nvidia; then
        echo "${Y}⚠ كرت NVIDIA مكتشف — لأفضل تعريف انتقل إلى صورة MoOS الخاصة بـ NVIDIA:${N}"
        echo "${Y}⚠ NVIDIA GPU detected — for the best driver, switch to the MoOS NVIDIA image:${N}"
        # Point at the action, not a raw bootc line. The action keeps the confirmation, the
        # Polkit prompt and --enforce-container-sigpolicy; a hand-typed `bootc switch` is the
        # exact path that silently staged an unverified origin on the maintainer's machine.
        echo "${C}  moai-do install-nvidia${N}"
        echo "${D}  (يُطبَّق عند إعادة التشغيل | applies on reboot)${N}"
        echo
    fi

    echo "${B}البرمجيات الثابتة | Firmware devices (fwupd):${N}"
    if command -v fwupdmgr >/dev/null 2>&1; then
        fwupdmgr get-devices || echo "  ${D}تعذّر الاستعلام | query failed${N}"
    else
        echo "  ${D}fwupdmgr غير مثبّت | not installed${N}"
    fi
}

do_update_firmware() {
    hdr "تحديث البرامج الثابتة" "Update device firmware"
    if ! command -v fwupdmgr >/dev/null 2>&1; then
        echo "${R}fwupd غير متوفر | fwupd is not available${N}" >&2
        return 1
    fi
    # Refresh the metadata first, otherwise "no updates" can simply mean "never checked".
    # --force lets a same-day re-check through instead of erroring on the cache age.
    fwupdmgr refresh --force >/dev/null 2>&1 || true
    echo "${D}البرامج الثابتة المتاحة | Available firmware updates:${N}"
    if ! fwupdmgr get-updates 2>/dev/null; then
        echo "${G}✓ لا توجد تحديثات برامج ثابتة | No firmware updates available${N}"
        return 0
    fi
    echo
    echo "${Y}تحديث البرامج الثابتة قد يتطلب إعادة تشغيل ولا يمكن التراجع عنه.${N}"
    echo "${Y}Firmware updates may require a reboot and cannot be rolled back.${N}"
    confirm || return 0
    run_priv fwupdmgr update
    echo "${G}✓ اكتمل | Done${N}"
}

do_install_nvidia() {
    hdr "تثبيت تعريف NVIDIA الأمثل" "Install the optimized NVIDIA driver"
    local gpu
    gpu="$(lspci 2>/dev/null | grep -Ei 'vga compatible controller|3d controller|display controller' || true)"
    if ! printf '%s' "$gpu" | grep -qi nvidia; then
        echo "${Y}لم تُكتشف بطاقة NVIDIA — لن يتغير النظام | No NVIDIA GPU detected — nothing changed${N}"
        return 0
    fi
    echo "${D}ينتقل إلى صورة MoOS NVIDIA الذرية ويُبقي النشر السابق للرجوع.${N}"
    echo "${D}Switches to the atomic NVIDIA image and keeps the previous deployment for rollback.${N}"
    confirm || return 0
    # --enforce-container-sigpolicy is NOT optional. `bootc switch` REPLACES the origin, and
    # without this flag it writes `ostree-unverified-registry:` — silently downgrading a
    # signature-enforced machine to one that verifies nothing. The origin persists, so every
    # later `bootc upgrade` stays unverified for the life of the install. An installed MoOS
    # boots `ostree-image-signed:docker://` (the kickstart deploys it that way and
    # verify_image_experience.py gates it); switching editions must land on the same footing.
    # Guarded by tests/verify_user_experience.py — do not drop the flag.
    run_priv bootc switch --enforce-container-sigpolicy ghcr.io/moalfarras-sys/moos-nvidia:latest
    echo "${G}✓ تم التجهيز — أعد التشغيل لتفعيل التعريف | Staged — reboot to activate${N}"
}

do_setup_waydroid() {
    hdr "تجهيز Android عبر Waydroid" "Set up Android through Waydroid"
    need waydroid || return 1

    # Idempotent: `waydroid init` re-downloads the multi-GB system image. Skip it if the
    # image is already there — `waydroid status` says "not initialized" only when it isn't.
    local inited=1
    if waydroid status 2>&1 | grep -qi 'not initialized'; then inited=0; fi

    if [ "$inited" = "0" ]; then
        echo "${D}ينزّل صورة Android الحرة (~1GB، أول مرة تأخذ دقائق) ويشغّل الحاوية. بلا Google Play.${N}"
        echo "${D}Downloads the free Android image (~1GB, first run takes minutes) and starts its container. No Google Play.${N}"
    else
        echo "${G}✓ Android مُهيّأ مسبقاً — سأشغّله فقط | already initialized — just starting it${N}"
    fi
    # Starting an already-initialized container is still a state change. This action is reachable
    # through the public moos: URL scheme, so confirmation must not exist only on first install.
    confirm || return 0
    if [ "$inited" = "0" ]; then
        run_priv waydroid init -s VANILLA \
            || { echo "${Y}تعذّر التهيئة | init failed${N}"; return 1; }
    fi

    if ! run_priv systemctl enable --now waydroid-container.service \
            || ! systemctl is-active --quiet waydroid-container.service; then
        echo "${R}تعذّر تشغيل حاوية Android | Android container failed to start${N}" >&2
        return 1
    fi
    # Free VRAM before the Android UI (an EGL/GPU client) starts — same guard as
    # launch_app and moos-open's apps/run route. With the local brain holding ~6GB
    # of an 8GB card, eglMakeCurrent aborts instead of degrading; best-effort.
    command -v moos-gpu-headroom >/dev/null 2>&1 && moos-gpu-headroom 2>/dev/null || true
    waydroid session start >/dev/null 2>&1 &
    local session_pid=$! session_ready=0 attempt
    # The session becomes ready asynchronously. Bound the wait so a broken compositor/container
    # never leaves the terminal hanging, and verify the state instead of sleeping then claiming it.
    for attempt in $(seq 1 20); do
        if waydroid status 2>/dev/null | grep -Eq 'Session:[[:space:]]+RUNNING'; then
            session_ready=1
            break
        fi
        sleep 1
    done
    if [ "$session_ready" -ne 1 ]; then
        kill "$session_pid" >/dev/null 2>&1 || true
        wait "$session_pid" 2>/dev/null || true
        echo "${R}بدأت الحاوية لكن جلسة Android لم تصبح جاهزة خلال 20 ثانية.${N}" >&2
        echo "${R}The container started, but the Android session was not ready within 20 seconds.${N}" >&2
        return 1
    fi
    waydroid show-full-ui >/dev/null 2>&1 &
    echo "${G}✓ Android جاهز | ready${N}"
    echo "${D}لتثبيت تطبيق APK | to install an APK:  ${C}waydroid app install <file.apk>${N}"
    echo "${D}تطبيقات Android تظهر في القائمة مثل أي تطبيق | Android apps appear in your launcher${N}"
}

# -----------------------------------------------------------------------------
# setup-windows — install Bottles (managed Wine) and open it, so the user can run
# real Windows .exe programs. Running needs no admin; only the one-time install of
# the Bottles Flatpak does (a Polkit prompt). Steam/Proton stays the gaming path.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# setup-gaming — the third foreign runtime, and it was the one command Mo AI
# recommended that did not exist.
#
# The gaming set was only ever reachable as `moos-setup --gaming`, wired to the
# Compatibility panel's button through moos://do/setup-gaming. But Mo AI's system
# prompt tells the model to answer "how do I run games" with `moai-do setup-gaming`
# — a command that printed "unknown command" and a help screen. The assistant was
# confidently handing the user a dead command; tests/test_moai_do.py now fails the
# build if any moai-do the QML names is not a real action.
#
# So make it real, and keep the safety identical: moos-setup does the Flatpak work
# (Steam, Bottles, Lutris, ProtonUp) and skips whatever is already installed.
# -----------------------------------------------------------------------------
do_setup_gaming() {
    hdr "تجهيز الألعاب (Steam + Proton + Lutris)" "Set up gaming (Steam + Proton + Lutris)"
    if ! command -v moos-setup >/dev/null 2>&1; then
        echo "${R}moos-setup غير موجود | not found${N}" >&2
        return 1
    fi
    echo "${D}يثبّت ما ينقص فقط: Steam وBottles وLutris وProtonUp — ويتخطّى المثبّت مسبقاً.${N}"
    echo "${D}Installs only what is missing: Steam, Bottles, Lutris, ProtonUp — skips what you have.${N}"
    confirm || return 0
    moos-setup --gaming
}

do_setup_windows() {
    hdr "تجهيز تطبيقات Windows عبر Bottles" "Set up Windows apps through Bottles"
    need flatpak || return 1
    echo "${D}يثبّت Bottles (Wine مُدار) لتشغيل برامج ‎.exe. التشغيل بلا صلاحيات؛ التثبيت مرة واحدة فقط.${N}"
    echo "${D}Installs Bottles (managed Wine) to run .exe programs. Running needs no admin; only the one-time install does.${N}"
    if flatpak info com.usebottles.bottles >/dev/null 2>&1; then
        echo "${G}✓ Bottles مثبّت مسبقاً — سأفتحه | already installed — opening it${N}"
    else
        confirm || return 0
        if ! flatpak install -y flathub com.usebottles.bottles; then
            echo "${Y}لم يكتمل التثبيت | install did not complete${N}"
            return 1
        fi
        echo "${G}✓ تم تثبيت Bottles | Bottles installed${N}"
    fi
    if ! launch_app com.usebottles.bottles; then
        echo "${Y}Bottles مثبّت، لكن تعذّر فتح نافذته الآن.${N}" >&2
        echo "${Y}Bottles is installed, but its window could not be opened now.${N}" >&2
        return 1
    fi
    echo "${D}في Bottles: أنشئ «Application» ثم شغّل ملف ‎.exe.${N}"
    echo "${D}In Bottles: create an 'Application' bottle, then Run your .exe.${N}"
}

# -----------------------------------------------------------------------------
# remote-anywhere — make Mo PC Remote reachable once the phone leaves the house.
#
# It already is, in every way that matters: Tailscale is a mesh, not a LAN trick, and the agent
# has always accepted the tailnet. What was missing is a NAME and a CERTIFICATE. Without them
# the only address anyone can be handed is the LAN IP over plain http — an address that stops
# existing on mobile data, and that the browser also refuses to treat as a secure context, which
# in turn locks Mo PC Remote out of hardware video decode, the clipboard and PWA install.
#
# `tailscale serve` supplies both: TLS on this machine's MagicDNS name with a real, auto-renewing
# certificate, proxied to the agent on loopback. It is tailnet-only — nothing is exposed to the
# public internet. (`tailscale funnel` is the one that would be. MoOS does not use it.)
#
# The privileged half is one line: make this user Tailscale's operator, so serve — and every
# later change to it — needs no root at all.
# -----------------------------------------------------------------------------
do_remote_anywhere() {
    hdr "الوصول إلى Mo PC Remote من أي مكان" "Reach Mo PC Remote from anywhere"
    need tailscale || return 1

    local state
    state="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("BackendState",""))' 2>/dev/null || true)"
    if [ "$state" != "Running" ]; then
        echo "${R}Tailscale ليس متصلاً | Tailscale is not connected${N}" >&2
        echo "${D}شغّله أولاً | connect it first:  tailscale up${N}" >&2
        return 1
    fi

    echo "${D}يمنح هذا الجهاز اسماً وشهادة HTTPS حقيقية على شبكتك الخاصة، فيعمل التحكم من بيانات الجوال.${N}"
    echo "${D}لا شيء يُنشر على الإنترنت العام — الوصول محصور بأجهزتك.${N}"
    echo "${D}Gives this machine a real HTTPS name on your private tailnet, so the phone works on"
    echo "mobile data. Nothing is published to the public internet — your devices only.${N}"
    confirm || return 0

    run_priv tailscale set --operator="$USER"
    tailscale serve --bg --https=443 http://127.0.0.1:8765 || {
        echo "${R}فشل tailscale serve | tailscale serve failed${N}" >&2
        echo "${D}تحتاج تفعيل شهادات HTTPS في لوحة Tailscale (DNS ← HTTPS Certificates).${N}" >&2
        echo "${D}HTTPS certificates must be enabled for your tailnet (DNS -> HTTPS Certificates).${N}" >&2
        return 1
    }
    echo
    tailscale serve status
}

# -----------------------------------------------------------------------------
# optimize — clean unused Flatpak runtimes + container images + old logs.
# -----------------------------------------------------------------------------
do_optimize() {
    hdr "تحسين وتنظيف" "Optimize & clean up"
    echo "${D}يحذف أوقات تشغيل Flatpak غير المستخدمة، وصور الحاويات غير المستخدمة،${N}"
    echo "${D}ويقلّص سجلّات النظام الأقدم من 7 أيام. لا يمسّ ملفاتك الشخصية.${N}"
    echo "${D}Removes unused Flatpak runtimes and container images, and trims system${N}"
    echo "${D}logs older than 7 days. Your personal files are untouched.${N}"
    echo
    confirm || return 0

    local fs="/var"
    [ -d /var ] || fs="/"
    local before after freed
    before="$(avail_bytes "$fs")"
    before="${before:-0}"

    echo "${C}› Flatpak: إزالة غير المستخدم | removing unused runtimes…${N}"
    if command -v flatpak >/dev/null 2>&1; then
        flatpak uninstall --unused -y || echo "  ${D}(لا شيء لإزالته | nothing to remove)${N}"
    else
        echo "  ${D}flatpak غير موجود | not present${N}"
    fi

    echo "${C}› Podman: تقليم الصور | pruning unused images…${N}"
    if command -v podman >/dev/null 2>&1; then
        podman image prune -f >/dev/null 2>&1 || true
    else
        echo "  ${D}podman غير موجود | not present${N}"
    fi

    echo "${C}› Journal: تقليص السجلّات (7 أيام) | vacuum logs (7d)…${N}"
    run_priv journalctl --vacuum-time=7d || echo "  ${D}(تخطّي | skipped)${N}"

    after="$(avail_bytes "$fs")"
    after="${after:-0}"
    freed=$(( after - before ))
    if [ "$freed" -lt 0 ]; then
        freed=0
    fi
    echo
    echo "${G}✓ اكتمل | done — تحرّر تقريباً | freed ~$(human "$freed") على | on ${fs}${N}"
}

# Read-only diagnostics. These deliberately collect bounded status summaries;
# they never restart a unit, edit boot configuration, or request privileges.
do_diagnose_services() {
    hdr "تشخيص الخدمات الفاشلة (قراءة فقط)" "Diagnose failed services (read-only)"
    echo "${B}System units:${N}"
    systemctl --failed --no-pager || true
    echo
    echo "${B}User units:${N}"
    systemctl --user --failed --no-pager || true
}

do_inspect_boot() {
    hdr "فحص مشاكل الإقلاع (قراءة فقط)" "Inspect boot problems (read-only)"
    echo "${B}Boot deployment:${N}"
    bootc status 2>/dev/null || ostree admin status 2>/dev/null || true
    echo
    echo "${B}Current-boot errors:${N}"
    journalctl -b -p err --no-pager -n 80 2>/dev/null || true
}

# rollback — the most important rescue on a bootc system, which the assistant could
# describe but not do. Atomic and reversible: it only changes which deployment the
# NEXT boot uses; a later `update` moves forward again. Confirmed, and privileged via
# pkexec. It never touches the signature policy or removes a deployment.
#
# THE COMMAND IS `bootc rollback`, NOT `rpm-ostree rollback`. They are not
# interchangeable on this system and the first version of this action used the wrong
# one. `rpm-ostree rollback` reverts to "the previously booted tree"; `bootc rollback`
# reorders the bootloader entries and — in its own words — "if there is a `staged`
# entry (an unapplied, queued upgrade) then it will be discarded". With an update
# already staged by uupd or `moai-do update`, that difference is the difference
# between rescuing the machine and printing a success message while nothing changed.
# It is also what the Recovery app (`moos-rollback`) has always run, so the assistant
# and the GUI now do the same thing.
do_rollback() {
    hdr "الرجوع إلى النسخة السابقة" "Roll back to the previous version"
    echo "${D}يجعل الإقلاع القادم على النشر السابق. ملفاتك وإعداداتك لا تتغيّر،${N}"
    echo "${D}ويمكنك التقدّم ثانيةً في أي وقت عبر «تحديث».${N}"
    echo "${D}Makes the next boot use the previous deployment. Your files and settings are${N}"
    echo "${D}untouched, and you can move forward again any time with an update.${N}"
    echo
    if command -v rpm-ostree >/dev/null 2>&1; then
        echo "${B}النشرات الحالية | Current deployments:${N}"
        rpm-ostree status 2>/dev/null | sed -n '1,12p' || true
        echo
        # Say so BEFORE asking. A queued update is discarded by the rollback, and a
        # user who confirms without being told that has been surprised, not informed.
        #
        # Read the JSON, not the human output. Every deployment carries a "staged"
        # boolean there (verified on this image), whereas the text rendering does not
        # reliably print the word at all — the first version of this grepped for
        # "Staged" in `rpm-ostree status` and so could never fire, which made the
        # warning decorative.
        if rpm-ostree status --json 2>/dev/null \
            | python3 -c 'import json,sys
try: d = json.load(sys.stdin)
except Exception: raise SystemExit(1)
raise SystemExit(0 if any(x.get("staged") for x in d.get("deployments", [])) else 1)' 2>/dev/null; then
            echo "${Y}تنبيه: يوجد تحديث مُجهَّز للإقلاع القادم، وسيُلغى بالرجوع${N}"
            echo "${Y}Note: an update is staged for the next boot; rolling back discards it${N}"
            echo "${D}(يمكنك تجهيزه ثانيةً في أي وقت عبر «تحديث» | re-stage it any time with an update)${N}"
            echo
        fi
    fi
    confirm || return 0
    run_priv bootc rollback || return 1
    echo
    echo "${G}✓ سيبدأ الإقلاع القادم على النسخة السابقة | next boot will use the previous version${N}"
    echo "${D}أعد التشغيل لتطبيق الرجوع | reboot to apply.${N}"
}

# net-doctor — read-only. The first thing to check when the remote or updates "don't
# work": link, route, internet, DNS (specifically the update registry), and Tailscale.
do_net_doctor() {
    hdr "تشخيص الشبكة (قراءة فقط)" "Network doctor (read-only)"
    echo "${B}الأجهزة والاتصال | Interfaces:${N}"
    if command -v nmcli >/dev/null 2>&1; then
        nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | grep -vE ':unmanaged$' || true
    else
        ip -brief addr 2>/dev/null | grep -v '^lo' || true
    fi
    echo
    echo "${B}الإنترنت | Internet:${N}"
    ip route get 1.1.1.1 2>/dev/null | head -1 || true
    if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then
        echo "  ${G}✓ يمكن الوصول للإنترنت | reachable (1.1.1.1)${N}"
    else
        echo "  ${R}✗ لا مسار للإنترنت | no route to 1.1.1.1${N}"
    fi
    echo
    echo "${B}DNS:${N}"
    command -v resolvectl >/dev/null 2>&1 \
        && resolvectl status 2>/dev/null | grep -E "Current DNS Server|DNS Servers" | head -3 || true
    if getent hosts ghcr.io >/dev/null 2>&1; then
        echo "  ${G}✓ يُحلَّل ghcr.io (خادم التحديثات) | resolves ghcr.io (update registry)${N}"
    else
        echo "  ${R}✗ تعذّر تحليل ghcr.io — التحديثات لن تعمل | cannot resolve ghcr.io${N}"
    fi
    echo
    echo "${B}Tailscale (Mo PC Remote من الخارج | remote from outside):${N}"
    if command -v tailscale >/dev/null 2>&1; then
        tailscale status --peers=false 2>/dev/null | head -4 || echo "  ${D}غير متّصل | not connected${N}"
    else
        echo "  ${D}Tailscale غير مثبّت | not installed${N}"
    fi
}

# gpu-report — read-only. VRAM and, crucially, WHO is holding it. On this hardware the
# local brain can hold most of the card, which is the root of the remote's encoder
# falling back and of apps aborting on eglMakeCurrent — so the assistant should be able
# to show it.
do_gpu_report() {
    hdr "تقرير كرت الشاشة والذاكرة (قراءة فقط)" "GPU & VRAM report (read-only)"
    if command -v nvidia-smi >/dev/null 2>&1; then
        echo "${B}NVIDIA:${N}"
        nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free \
            --format=csv,noheader 2>/dev/null || nvidia-smi 2>/dev/null | head -15 || true
        echo
        echo "${B}من يحتجز الذاكرة | Who is holding VRAM:${N}"
        nvidia-smi --query-compute-apps=pid,process_name,used_memory \
            --format=csv,noheader 2>/dev/null | grep -v '^\s*$' || echo "  ${D}(لا شيء | none)${N}"
    else
        echo "${D}لا يوجد كرت NVIDIA أو الأداة غير متوفّرة | no NVIDIA GPU or tool present${N}"
        command -v glxinfo >/dev/null 2>&1 \
            && glxinfo -B 2>/dev/null | grep -iE "device|memory" | head -5 || true
    fi
    echo
    echo "${D}لتحرير الذاكرة للتطبيقات يُفرَّغ العقل المحلي تلقائياً عند فتح تطبيق رسومي.${N}"
    echo "${D}The local brain is unloaded automatically when a graphical app starts.${N}"
}

# -----------------------------------------------------------------------------
# install-codex / install-claude — the AI coding agents, as the USER.
# -----------------------------------------------------------------------------
# These are the only actions here that take NO privilege at all, and that is the
# point: /usr is read-only on an OSTree system, so a plain `npm i -g` would try
# to write there and fail. Installing under ~/.local instead means the agent runs
# as the user, owns only what the user owns, and needs no pkexec, no polkit and
# no rpm-ostree layer. Fedora already puts ~/.local/bin on PATH.
#
# nodejs22 + nodejs22-npm ship in the image (build.sh), so this works offline of
# any extra setup — it only needs the network to fetch the package itself.
install_agent() {
    local pkg="$1" bin="$2" label="$3"
    hdr "تثبيت ${label} (كمستخدم، بلا صلاحيات مسؤول)" \
        "Install ${label} (as your user — no admin rights)"
    echo "${D}يُثبَّت في ~/.local — لا يلمس النظام ولا يحتاج كلمة مرور.${N}"
    echo "${D}Installs into ~/.local — never touches the system, no password needed.${N}"
    echo "${D}الحزمة | Package: ${pkg}${N}"
    echo
    need npm || {
        echo "${Y}npm غير موجود | npm not found${N}"
        return 1
    }
    confirm || return 0

    # --prefix keeps the global install inside the user's home. Without it npm
    # targets /usr (read-only here) and fails with EROFS.
    if npm install -g --prefix "$HOME/.local" "$pkg"; then
        echo "${G}✓ تم تثبيت ${label} | ${label} installed${N}"
        if ! command -v "$bin" >/dev/null 2>&1; then
            echo "${Y}ملاحظة: أعد فتح الطرفية ليصبح '${bin}' في PATH.${N}"
            echo "${Y}Note: reopen your terminal so '${bin}' lands on PATH.${N}"
        fi
        echo "${D}شغّله من Mo AI ← المطوّر | run it from Mo AI → Developer${N}"
    else
        echo "${Y}لم يكتمل التثبيت | install did not complete${N}"
        return 1
    fi
}

do_install_codex() {
    install_agent "@openai/codex" "codex" "Codex"
}

do_install_claude() {
    install_agent "@anthropic-ai/claude-code" "claude" "Claude Code"
}

# -----------------------------------------------------------------------------
# install-opencode — the coding agent that runs on MoOS's OWN brain.
#
# Codex and Claude Code are excellent, and they are both somebody else's cloud: each
# needs an account, a subscription and a network. OpenCode is provider-agnostic, so on
# MoOS it can be pointed at the machine's own model — a real coding agent that works on
# a plane, on a train, and on a laptop that has never been logged in to anything. That
# is why it is the third agent rather than a second cloud one.
#
# Which means the install cannot stop at `npm install`. An agent that lands with no
# provider configured opens, asks for a model the user does not have, and is
# indistinguishable from broken. So this WRITES the provider config — pointed at
# moai-gateway on 127.0.0.1:8080, which is already OpenAI-compatible and already routes
# `local:` to the brain (and wakes it on demand) — but only when the user has none of
# their own. A config the user wrote is theirs; MoOS does not overwrite it.
#
# Verified end-to-end on this hardware: brain stopped, `opencode run "Reply with exactly
# one word: ready"` → the gateway woke it and OpenCode printed `ready`.
# -----------------------------------------------------------------------------
# ── The phone agent ──────────────────────────────────────────────────────────
# OpenClaw is what lets you talk to this machine from Telegram. It is a per-user
# npm install like the other agents, with one extra step: its engines field
# demands Node >= 22.22.3 and the image ships 22.22.2 — one patch below. Layering
# a newer Node onto /usr would fight every ostree update, so a private runtime
# goes in ~/.local/node instead and only this agent sees it.
OPENCLAW_NODE="v24.18.0"
OPENCLAW_VERSION="2026.7.1-2"

# The first MoOS Quadlets were installable and therefore started at every login,
# even though every consumer already knows how to wake them on demand. Remove
# only the exact trailing [Install] block from files that still carry all of the
# shipped MoOS identity markers. A hand-written or differently sourced Quadlet
# is user data and is never rewritten here.
strip_legacy_moos_quadlet_autostart() {
    local file="$1" kind="$2" tmp tail_block
    [ -f "$file" ] || return 0
    tail_block="$(tail -n 2 -- "$file" 2>/dev/null || true)"
    [ "$tail_block" = $'[Install]\nWantedBy=default.target' ] || return 0

    case "$kind" in
        model)
            grep -Eq '^Description=Ollama LLM server \(rootless podman, (NVIDIA CDI|hardware-safe)\)$' \
                "$file" || return 0
            grep -Eq '^ContainerName=(ollama|moai-brain)$' "$file" || return 0
            grep -Fxq 'Image=docker.io/ollama/ollama:latest' "$file" || return 0
            ;;
        speech)
            grep -Fxq 'Description=Speaches — Arabic STT/TTS, OpenAI-compatible, CPU only' \
                "$file" || return 0
            grep -Eq '^ContainerName=(speaches|moai-speech)$' "$file" || return 0
            grep -Eq '^Image=(localhost/speaches-ar:0\.8\.3-cpu|ghcr\.io/speaches-ai/speaches:[^[:space:]]+)$' \
                "$file" || return 0
            ;;
        *) return 2 ;;
    esac

    tmp="$(mktemp --tmpdir="$(dirname "$file")" '.moos-quadlet.XXXXXX')" || return 1
    if ! head -n -2 -- "$file" > "$tmp" \
            || ! chmod --reference="$file" "$tmp" \
            || ! mv -f -- "$tmp" "$file"; then
        rm -f -- "$tmp"
        return 1
    fi
    echo "${G}✓ أزيل التشغيل التلقائي القديم: $(basename "$file")${N}"
    echo "${G}  Removed legacy always-on startup: $(basename "$file")${N}"
}

do_install_openclaw() {
    hdr "تثبيت وكيل الهاتف (OpenClaw)" "Install the phone agent (OpenClaw)"
    echo "${D}يتيح لك مراسلة جهازك من تليجرام. البرنامج في ~/.local؛ ويطلب موافقة مسؤول مرة واحدة ليبقى متاحاً بعد تسجيل الخروج.${N}"
    echo "${D}Lets you message this machine from Telegram. The app stays in ~/.local; one admin approval keeps it available after logout.${N}"
    echo
    confirm || return 0

    echo "${C}▸ التحقق من العقل والصوت المحليين | checking the local brain and voice${N}"
    setup_brain_impl || return 1

    local node_dir="$HOME/.local/node"
    local node_bin="${node_dir}/bin"

    # A private Node only if the system one is too old for the engines field.
    if ! "${node_bin}/node" --version >/dev/null 2>&1; then
        echo "${C}▸ تنزيل Node ${OPENCLAW_NODE} إلى ~/.local/node${N}"
        local tmp; tmp="$(mktemp -d)" || return 1
        if ! curl -fsSL --max-time 600 -o "${tmp}/node.tar.xz" \
             "https://nodejs.org/dist/${OPENCLAW_NODE}/node-${OPENCLAW_NODE}-linux-x64.tar.xz"; then
            echo "${Y}تعذّر تنزيل Node | could not download Node${N}" >&2
            rm -rf "$tmp"; return 1
        fi
        # Verify before extracting: this lands on PATH for an agent with shell access.
        if curl -fsSL --max-time 120 -o "${tmp}/SHASUMS256.txt" \
             "https://nodejs.org/dist/${OPENCLAW_NODE}/SHASUMS256.txt"; then
            ( cd "$tmp" && grep "node-${OPENCLAW_NODE}-linux-x64.tar.xz\$" SHASUMS256.txt \
              | sed "s#node-${OPENCLAW_NODE}-linux-x64.tar.xz#node.tar.xz#" | sha256sum -c - ) \
              || { echo "${R}فشل التحقق من البصمة | checksum mismatch${N}" >&2; rm -rf "$tmp"; return 1; }
        else
            echo "${Y}تعذّر جلب البصمات — أُلغي التثبيت | checksums unavailable, aborting${N}" >&2
            rm -rf "$tmp"; return 1
        fi
        mkdir -p "$node_dir" && tar -xJf "${tmp}/node.tar.xz" -C "$node_dir" --strip-components=1
        rm -rf "$tmp"
        echo "${G}✓ Node $("${node_bin}/node" --version)${N}"
    fi

    echo "${C}▸ تثبيت OpenClaw ${OPENCLAW_VERSION}${N}"
    if ! PATH="${node_bin}:$PATH" npm install -g --prefix "$HOME/.local" \
            "openclaw@${OPENCLAW_VERSION}"; then
        echo "${Y}لم يكتمل التثبيت | install did not complete${N}" >&2
        return 1
    fi

    local openclaw_path="${node_bin}:$HOME/.local/bin:/usr/bin:/bin"
    local version_text
    version_text="$(PATH="$openclaw_path" "$HOME/.local/bin/openclaw" --version 2>&1)" \
        || { echo "${R}تعذّر تشغيل OpenClaw بعد التثبيت | installed OpenClaw did not run${N}" >&2; return 1; }
    case "$version_text" in
        *"OpenClaw ${OPENCLAW_VERSION}"*) ;;
        *)
            echo "${R}إصدار OpenClaw المثبّت غير متوقع؛ أُلغي الإعداد.${N}" >&2
            echo "${R}Unexpected OpenClaw version; setup stopped: ${version_text}${N}" >&2
            return 1
            ;;
    esac

    # One schema-complete transaction: local model/provider, STT, loopback
    # Speaches TTS, safe sandbox/exec defaults, and the literal docker→podman
    # compatibility shim the sandbox backend invokes. Existing user choices win.
    if ! PATH="$openclaw_path" /usr/libexec/moai-openclaw-bootstrap; then
        echo "${R}تثبّت البرنامج لكن تعذّر إنشاء إعداد OpenClaw الآمن.${N}" >&2
        echo "${R}OpenClaw installed, but its safe baseline could not be created.${N}" >&2
        return 1
    fi
    if ! OPENCLAW_CONFIG_PATH="$HOME/.openclaw/openclaw.json" \
            PATH="$openclaw_path" "$HOME/.local/bin/openclaw" \
            config validate --json >/dev/null; then
        echo "${R}رفض OpenClaw الإعداد الجديد؛ لم أدّعِ أن الوكيل جاهز.${N}" >&2
        echo "${R}OpenClaw rejected the new config; the phone agent is not ready.${N}" >&2
        return 1
    fi

    systemctl --user daemon-reload || return 1
    if ! systemctl --user cat openclaw-gateway.service >/dev/null 2>&1; then
        echo "${R}خدمة وكيل الهاتف غير موجودة | phone-agent service is missing${N}" >&2
        return 1
    fi

    echo "${G}✓ تم تثبيت OpenClaw | OpenClaw installed${N}"
    echo
    echo "${C}الخطوة التالية | Next:${N}"
    echo "${D}  افتح Mo AI ← الإعدادات ← القناة، وضع توكن البوت من @BotFather.${N}"
    echo "${D}  Open Mo AI → Settings → Channel and paste the bot token from @BotFather.${N}"
}

setup_brain_impl() {
    local cfg_root="${XDG_CONFIG_HOME:-$HOME/.config}"
    local dst="${cfg_root}/containers/systemd"
    local engine_cfg="${cfg_root}/moos/moai-local.env"

    # Two generated units would both publish the same loopback port. Refuse the
    # conflict before creating, editing or selecting anything; the user's files
    # are evidence to inspect, never something this helper deletes implicitly.
    if [ -f "$dst/ollama.container" ] && [ -f "$dst/moai-brain.container" ]; then
        echo "${R}يوجد إعدادا عقل متعارضان؛ لم أغيّر أي إعداد أو خدمة.${N}" >&2
        echo "${R}Two model Quadlets conflict; config and services were left untouched.${N}" >&2
        return 1
    fi
    if [ -f "$dst/speaches.container" ] && [ -f "$dst/moai-speech.container" ]; then
        echo "${R}يوجد إعدادا صوت متعارضان؛ لم أغيّر أي إعداد أو خدمة.${N}" >&2
        echo "${R}Two speech Quadlets conflict; config and services were left untouched.${N}" >&2
        return 1
    fi
    mkdir -p "$dst" "$HOME/.ollama" "$(dirname "$engine_cfg")" || return 1

    # NEVER stand up a SECOND model server: an 8 GB card holds ONE 4-5 GB model, so
    # two Ollamas fighting for 127.0.0.1:11434 is the failure to avoid. If a model
    # server is already provisioned by a hand-tuned Quadlet, REUSE it instead of
    # installing a rival. A bare Podman container cannot be adopted by Quadlet:
    # pretending it maps to ollama.service records a unit that does not exist and
    # makes every helper target the wrong runtime.
    local model_unit=moai-brain.service
    local quadlet="$dst/moai-brain.container"
    local installed_model_quadlet=0
    local have_nvidia_cdi=0
    if command -v nvidia-smi >/dev/null 2>&1 \
            && command -v nvidia-ctk >/dev/null 2>&1 \
            && nvidia-smi --query-gpu=name --format=csv,noheader \
                >/dev/null 2>&1 \
            && nvidia-ctk cdi list 2>/dev/null \
                | grep -Fxq 'nvidia.com/gpu=all'; then
        have_nvidia_cdi=1
    fi
    if [ -f "$dst/ollama.container" ]; then
        model_unit=ollama.service
        quadlet="$dst/ollama.container"
        echo "${G}✓ خادم النماذج موجود — أعيد استخدامه بلا تكرار | model server present — reusing, not duplicating${N}"
    elif [ -f "$dst/moai-brain.container" ]; then
        echo "${G}✓ خادم النماذج موجود — أعيد استخدامه بلا تكرار | model server present — reusing, not duplicating${N}"
    elif podman ps -a --format '{{.Names}}' 2>/dev/null \
            | grep -qxE 'ollama|moai-brain'; then
        echo "${R}يوجد خادم حاوية غير مُدار؛ لم أغيّر إعداد العقل.${N}" >&2
        echo "${R}An unmanaged model container already exists; brain settings were left unchanged.${N}" >&2
        echo "${D}أنشئ له Quadlet باسم ollama.container أو أعد تسميته، ثم حاول ثانية.${N}" >&2
        echo "${D}Give it an ollama.container Quadlet or rename it, then try again.${N}" >&2
        return 1
    else
        install -m 0644 /usr/share/moos/containers/moai-brain.container "$dst/" || return 1
        installed_model_quadlet=1
    fi

    # The generic image and VMs must never inherit NVIDIA-only CDI directives:
    # a generated unit with AddDevice=nvidia.com/gpu=all cannot even start
    # without the driver. New installs begin from the CPU-safe template and get
    # acceleration only after the real runtime proves the CDI device exists.
    if [ "$installed_model_quadlet" -eq 1 ] && [ "$have_nvidia_cdi" -eq 1 ]; then
        sed -i '/^# MOOS_NVIDIA_CDI_INSERT$/a AddDevice=nvidia.com/gpu=all\nSecurityLabelDisable=true' \
            "$quadlet"
        echo "${G}✓ تفعيل تسريع NVIDIA | NVIDIA acceleration enabled${N}"
    elif [ "$installed_model_quadlet" -eq 1 ]; then
        echo "${Y}• لا يوجد NVIDIA CDI — سيعمل العقل محلياً بوضع CPU الآمن.${N}"
        echo "${Y}  NVIDIA CDI not present — using the safe local CPU path.${N}"
    elif [ "$model_unit" = "moai-brain.service" ] \
            && grep -qx 'Description=Ollama LLM server (rootless podman, NVIDIA CDI)' \
                "$quadlet" \
            && [ "$have_nvidia_cdi" -eq 0 ]; then
        # Migrate only the exact legacy MoOS template marker. Hand-written
        # Quadlets and an available NVIDIA setup remain untouched.
        sed -i \
            -e 's/^Description=Ollama LLM server (rootless podman, NVIDIA CDI)$/Description=Ollama LLM server (rootless podman, hardware-safe)/' \
            -e '/^AddDevice=nvidia\\.com\\/gpu=all$/d' \
            -e '/^SecurityLabelDisable=true$/d' \
            "$quadlet"
        echo "${G}✓ حُوّل إعداد العقل القديم إلى مسار CPU المتوافق.${N}"
        echo "${G}  Migrated the legacy brain config to the compatible CPU path.${N}"
    fi

    # Standardise new installs on speaches.service, but preserve the first
    # shipped moai-speech.container name when an upgraded user already has it.
    # Both are fixed names; two files would fight for 127.0.0.1:8000.
    local speech_unit=speaches.service
    local speech_quadlet="$dst/speaches.container"
    if [ -f "$dst/speaches.container" ] && [ -f "$dst/moai-speech.container" ]; then
        echo "${R}يوجد إعدادا صوت متعارضان؛ لم أبدأ خدمة ثانية.${N}" >&2
        echo "${R}Two speech Quadlets conflict; no second service was started.${N}" >&2
        return 1
    elif [ -f "$dst/speaches.container" ]; then
        echo "${G}✓ محرك الصوت موجود — أعيد استخدامه | speech engine present — reusing${N}"
    elif [ -f "$dst/moai-speech.container" ]; then
        speech_unit=moai-speech.service
        speech_quadlet="$dst/moai-speech.container"
        echo "${G}✓ محرك الصوت القديم موجود — أعيد استخدامه | existing speech engine — reusing${N}"
    elif podman ps -a --format '{{.Names}}' 2>/dev/null \
            | grep -qxE 'speaches|moai-speech'; then
        echo "${R}توجد حاوية صوت غير مُدارة؛ لم أنشئ خدمة متضاربة.${N}" >&2
        echo "${R}An unmanaged speech container exists; no conflicting service was created.${N}" >&2
        return 1
    else
        install -m 0644 /usr/share/moos/containers/speaches.container "$dst/" || return 1
    fi

    # Existing hand-tuned Quadlets are preserved, but MoOS's local route never
    # uses Ollama Cloud.  Reconcile this one privacy switch in place so upgrades
    # stop the cloud-cache/recommendation probes without replacing user tuning.
    if [ -f "$quadlet" ]; then
        if grep -q '^Environment=OLLAMA_NO_CLOUD=' "$quadlet"; then
            sed -i 's/^Environment=OLLAMA_NO_CLOUD=.*/Environment=OLLAMA_NO_CLOUD=true/' "$quadlet"
        elif grep -q '^Environment=OLLAMA_HOST=' "$quadlet"; then
            sed -i '/^Environment=OLLAMA_HOST=/a Environment=OLLAMA_NO_CLOUD=true' "$quadlet"
        else
            sed -i '/^\[Container\]$/a Environment=OLLAMA_NO_CLOUD=true' "$quadlet"
        fi
    fi

    # Upgrade the exact first-party templates to the same on-demand contract as
    # fresh installs. The currently requested setup still starts both services
    # explicitly below and verifies them before reporting ready.
    strip_legacy_moos_quadlet_autostart "$quadlet" model || return 1
    strip_legacy_moos_quadlet_autostart "$speech_quadlet" speech || return 1

    if grep -qx 'Image=localhost/speaches-ar:0.8.3-cpu' "$speech_quadlet"; then
        echo "${C}▸ تنزيل مكوّن Piper المفتوح وبناء الصوت محلياً${N}"
        echo "${D}  Downloading the open-source Piper component and building voice locally${N}"
        /usr/libexec/moos-prepare-speech-image || return 1
    fi

    # Without linger the containers die at logout and never start at boot —
    # the classic "it worked until I signed out". login1 protects this setting
    # with Polkit, so ask explicitly through the one privileged seam and verify
    # what logind actually applied. Never print "ready" after a hidden failure.
    local login_user
    login_user="$(id -un)"
    if [ "$(loginctl show-user "$login_user" -p Linger --value 2>/dev/null)" != "yes" ]; then
        echo "${C}▸ موافقة مسؤول لإبقاء وكيل الهاتف متاحاً بعد تسجيل الخروج${N}"
        echo "${D}  Admin approval keeps the phone agent available after logout${N}"
        run_priv /usr/bin/loginctl enable-linger "$login_user" || return 1
    fi
    if [ "$(loginctl show-user "$login_user" -p Linger --value 2>/dev/null)" != "yes" ]; then
        echo "${R}لم يُفعّل التشغيل بعد تسجيل الخروج؛ أُلغي الإعداد.${N}" >&2
        echo "${R}Background availability after logout was not enabled; setup stopped.${N}" >&2
        return 1
    fi
    systemctl --user daemon-reload || return 1

    echo "${C}▸ تشغيل الخدمات${N}"
    # Quadlet units are generated; `enable` is not a valid operation on them.
    # Starting the generated unit is mandatory. Never select it in the shared
    # config or print "ready" unless systemd confirms it is actually active.
    if ! systemctl --user start "$model_unit" \
            || ! systemctl --user is-active --quiet "$model_unit"; then
        echo "${R}تعذّر تشغيل خادم النماذج | model server failed to start${N}" >&2
        return 1
    fi
    if ! systemctl --user start "$speech_unit" \
            || ! systemctl --user is-active --quiet "$speech_unit"; then
        echo "${R}تعذّر تشغيل محرك الصوت العربي | Arabic speech engine failed to start${N}" >&2
        return 1
    fi

    # Build/reconcile the default alias before testing it. Fresh Ollama stores
    # are empty; checking /api/tags first made a clean install fail before the
    # very service responsible for pulling and creating `default` had run.
    systemctl --user restart moos-ensure-brain.service || return 1

    # The reconciler is deliberately failure-tolerant at login so a temporary
    # network outage never breaks the session. Bootstrap has the stricter
    # contract below: do not commit the route or retire the legacy service until
    # Ollama itself confirms that the `default` alias really exists.
    if ! curl -fsS --max-time 10 http://127.0.0.1:11434/api/tags \
            | python3 -c 'import json,sys
names={(m.get("name") or m.get("model") or "").removesuffix(":latest")
       for m in json.load(sys.stdin).get("models",[])}
raise SystemExit(0 if "default" in names else 1)'; then
        echo "${R}خادم النماذج يعمل، لكن نموذج Mo AI الافتراضي لم يكتمل.${N}" >&2
        echo "${R}The model server is running, but Mo AI's default model did not finish installing.${N}" >&2
        echo "${D}تحقق من الإنترنت والمساحة ثم شغّل «تجهيز العقل المحلي» مرة أخرى.${N}" >&2
        echo "${D}Check network and disk space, then run “Set up local brain” again.${N}" >&2
        return 1
    fi

    # One source of truth for every consumer. This commit happens only after the
    # selected unit is active AND its default model is proven usable.
    local engine_tmp="${engine_cfg}.new"
    cat > "$engine_tmp" <<EOF
MOAI_LOCAL_UNIT=$model_unit
MOAI_LOCAL_BACKEND=ollama
MOAI_LOCAL_PORT=11434
MOAI_LOCAL_MODEL=default
EOF
    chmod 0600 "$engine_tmp"
    mv -f "$engine_tmp" "$engine_cfg"

    systemctl --user disable --now moai.service >/dev/null 2>&1 || true
    systemctl --user restart moai-gateway.service moai-control.service || return 1
    systemctl --user start moai-agent-api.service || return 1

    echo "${G}✓ جاهز | ready${N}"
    echo "${D}اختر نموذجاً من Mo AI ← الإعدادات ← النماذج.${N}"
    echo "${D}Pick a model in Mo AI → Settings → Models.${N}"
}

do_setup_brain() {
    hdr "تجهيز العقل المحلي" "Set up the local brain"
    echo "${D}ينزّل المكوّنات المفتوحة ويشغّلها كحاويات rootless؛ يطلب موافقة مسؤول مرة واحدة ليبقى الوكيل متاحاً بعد تسجيل الخروج.${N}"
    echo "${D}Downloads the open components as rootless containers; one admin approval keeps the agent available after logout.${N}"
    echo
    confirm || return 0
    setup_brain_impl
}

do_install_opencode() {
    install_agent "opencode-ai" "opencode" "OpenCode" || return 1

    local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
    local cfg="${cfg_dir}/opencode.json"

    if [ -e "$cfg" ]; then
        echo "${D}إعدادك موجود — لم يُغيَّر. | You already have a config — left untouched.${N}"
        return 0
    fi

    mkdir -p "$cfg_dir" 2>/dev/null || return 0
    # THE PORT IS PER-USER, so it must not be hardcoded. 60-moai-ports gives every
    # account its own gateway port (uid 1000 keeps 8080; a second developer on a MoOS
    # Cloud box gets 8180, and so on). Writing a literal 8080 here pointed the SECOND
    # tenant's OpenCode at the FIRST tenant's gateway — the one process holding the
    # cloud API key — which is precisely the cross-tenant leak the port generator
    # exists to prevent. Read the injected variable, falling back to the base only
    # where nothing injected one (a plain uid-1000 desktop).
    local gw_port="${MOAI_GATEWAY_PORT:-8080}"
    cat > "$cfg" <<JSON
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "moos": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MoOS local brain",
      "options": {
        "baseURL": "http://127.0.0.1:${gw_port}/v1",
        "apiKey": "moos"
      },
      "models": {
        "local:qwen2.5:7b-instruct": { "name": "MoOS local (Qwen2.5 7B Instruct)" }
      }
    }
  },
  "model": "moos/local:qwen2.5:7b-instruct"
}
JSON
    echo "${G}✓ مضبوط على عقل MoOS المحلي — بلا حساب وبلا إنترنت.${N}"
    echo "${G}  Pointed at the MoOS local brain — no account, no internet.${N}"
    echo "${D}العقل يصحو تلقائياً عند أول سؤال (~دقيقة في أول مرة).${N}"
    echo "${D}The brain wakes on the first question (~a minute the first time).${N}"
}

# -----------------------------------------------------------------------------
# usage — bilingual help listing every subcommand.
# -----------------------------------------------------------------------------
usage() {
    cat <<EOF
${B}Mo AI · moai-do${N}  —  ${D}منفّذ أوامر MoOS الآمن | MoOS safe action runner${N}

${V}الاستعمال | Usage:${N}  moai-do <command> [args]

  ${C}update${N}            تجهيز أحدث صورة MoOS موقّعة وثابتة بالـdigest
                    Stage the latest signed MoOS image by exact digest
  ${C}install <id>${N}      تثبيت تطبيق Flatpak من Flathub ثم فتحه
                    Install a Flatpak app from Flathub, then open it
  ${C}fix-audio${N}         إعادة تشغيل خدمات الصوت (PipeWire)
                    Restart audio services (PipeWire)
  ${C}check-drivers${N}     عرض كرت الشاشة والبرمجيات الثابتة (قراءة فقط)
                    Show GPU & firmware devices (read-only)
  ${C}install-nvidia${N}    تجهيز صورة NVIDIA الصحيحة بأمان
                    Stage the correct NVIDIA image safely
  ${C}update-firmware${N}   تحديث البرامج الثابتة للأجهزة عبر fwupd
                    Update device firmware through fwupd
  ${C}setup-waydroid${N}    تنزيل وتجهيز Android الاختياري (وتشغيل تطبيقات Android)
                    Download and configure Android support (run Android apps)
  ${C}setup-windows${N}     تثبيت Bottles وفتحه لتشغيل برامج ‎.exe
                    Install Bottles and open it to run Windows .exe programs
  ${C}setup-gaming${N}      تجهيز الألعاب: Steam وProton وLutris وBottles
                    Set up gaming: Steam, Proton, Lutris, Bottles
  ${C}optimize${N}          تنظيف Flatpak/الحاويات/السجلّات وتحرير مساحة
                    Clean Flatpak/containers/logs and free disk space
  ${C}hw-report${N}         فتح مركز الجهاز داخل Mo AI | open the device centre in Mo AI
  ${C}install-codex${N}     تثبيت وكيل Codex في ~/.local (بلا صلاحيات)
                    Install the Codex agent into ~/.local (no privileges)
  ${C}install-claude${N}    تثبيت وكيل Claude Code في ~/.local (بلا صلاحيات)
                    Install the Claude Code agent into ~/.local (no privileges)
  ${C}install-opencode${N}  تثبيت OpenCode — وكيل برمجة يعمل على عقلك المحلي (بلا حساب)
                    Install OpenCode — a coding agent on your LOCAL brain (no account)
  ${C}install-openclaw${N}  وكيل الهاتف — موافقة مسؤول واحدة للعمل بعد تسجيل الخروج
                    Phone agent — one admin approval for after-logout availability
  ${C}setup-brain${N}       تشغيل العقل المحلي: خادم النماذج ومحرّك الصوت العربي
                    Start the local brain: model server and Arabic speech engine
  ${C}remote-anywhere${N}   تشغيل Mo PC Remote من خارج البيت (Tailscale HTTPS)
                    Reach Mo PC Remote from outside the house
  ${C}diagnose-services${N} عرض الخدمات الفاشلة (قراءة فقط)
                    Show failed services (read-only)
  ${C}inspect-boot${N}      عرض حالة النشر وأخطاء الإقلاع (قراءة فقط)
                    Show deployment and boot errors (read-only)
  ${C}rollback${N}          الرجوع إلى النسخة السابقة (إنقاذ، قابل للعكس)
                    Roll back to the previous version (rescue, reversible)
  ${C}net-doctor${N}        تشخيص الشبكة وDNS وTailscale (قراءة فقط)
                    Diagnose network, DNS and Tailscale (read-only)
  ${C}gpu-report${N}        عرض ذاكرة كرت الشاشة ومن يحتجزها (قراءة فقط)
                    Show GPU memory and who is holding it (read-only)
  ${C}help${N}              عرض هذه المساعدة | show this help

${D}كل إجراء مُغيِّر يطلب تأكيداً، والصلاحيات عبر pkexec (لا sudo بلا كلمة مرور).${N}
${D}Every state-changing action asks to confirm; privileges go through pkexec.${N}
EOF
}

# -----------------------------------------------------------------------------
# dispatch
# -----------------------------------------------------------------------------
# audit <verdict> [detail…] — record what the assistant did to this system.
#
# Mo AI can update the OS, roll it back, layer the NVIDIA driver, restart services and
# install software. It already asks before each of those and takes privileges through
# pkexec, which is the right shape — but until this existed NOTHING recorded that any of
# it happened. `journalctl -t moai-do` returned nothing on a machine where the assistant
# had been used, so "what did it change?" after something breaks had no answer, and neither
# did "did I actually approve that?".
#
# The journal, not a file of our own: it is already collected, rotated and size-capped
# (SystemMaxUse=500M), it timestamps and attributes entries itself, and it survives the
# reboot an update causes — which a log written under /var/log by hand would need to
# re-implement badly. Read it with:
#
#     journalctl -t moai-do            # everything the assistant has done
#     journalctl -t moai-do -p warning # only the refusals and failures
#
# Deliberately records the ACTION NAME and the verdict, never arguments beyond a validated
# app id: the only free-form value that reaches here is a Flatpak id, and a log is not a
# place to start echoing anything a model produced.
audit() {
    local verdict="$1"; shift
    command -v logger >/dev/null 2>&1 || return 0
    local pri="user.notice"
    case "$verdict" in refused|failed) pri="user.warning" ;; esac
    logger -t moai-do -p "$pri" -- \
        "action=${AUDIT_ACTION:-unknown} verdict=${verdict} user=$(id -un 2>/dev/null || echo ?)${*:+ $*}" \
        2>/dev/null || true
}

main() {
    local cmd="${1:-help}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    # Named once, here, so every branch below is covered by construction and a NEW action
    # cannot be added that forgets to be auditable.
    AUDIT_ACTION="$cmd"
    case "$cmd" in
        update)        do_update ;;
        install)       do_install "${1:-}" ;;
        fix-audio)     do_fix_audio ;;
        check-drivers) do_check_drivers ;;
        install-nvidia) do_install_nvidia ;;
        update-firmware) do_update_firmware ;;
        setup-waydroid) do_setup_waydroid ;;
        setup-windows) do_setup_windows ;;
        setup-gaming)  do_setup_gaming ;;
        remote-anywhere) do_remote_anywhere ;;
        install-codex) do_install_codex ;;
        install-claude) do_install_claude ;;
        install-opencode) do_install_opencode ;;
        install-openclaw) do_install_openclaw ;;
        setup-brain)      do_setup_brain ;;
        optimize)      do_optimize ;;
        diagnose-services) do_diagnose_services ;;
        inspect-boot)  do_inspect_boot ;;
        rollback)      do_rollback ;;
        net-doctor)    do_net_doctor ;;
        gpu-report)    do_gpu_report ;;
        hw-report)
            # The Hardware Centre is a panel inside Mo AI now, not a separate
            # window. Open it directly rather than bouncing through the
            # moos-hardware compatibility shim.
            if command -v moai >/dev/null 2>&1; then
                exec moai --device
            else
                echo "${R}moai غير موجود | not found${N}" >&2
                return 1
            fi
            ;;
        help|-h|--help) usage ;;
        *)
            # Logged at warning: a rejected command is the interesting line in this journal.
            # It is either the model inventing an action that does not exist, or something
            # trying its luck through moos-open — and both are worth being able to find.
            audit refused
            echo "${R}أمر غير معروف | unknown command:${N} ${cmd}" >&2
            echo >&2
            usage >&2
            exit 2
            ;;
    esac
}

# The outcome, recorded once, around the whole dispatch — so the journal answers "did it
# work?" and not merely "was it asked for". `help` and the read-only reports are audited
# too: they are cheap to record and their absence is what makes a trail ambiguous.
#
# The exit status is preserved exactly: `set -e` is on, so main's own failure would end the
# script before the audit line without this, and a wrapper that swallowed the status would
# be worse than no wrapper at all.
if main "$@"; then
    # A declined prompt exits 0 (`confirm || return 0`), so "the command succeeded" and "the
    # user agreed to it" are different facts and the trail has to say which. Reporting a
    # decline as `ok` would make the one question an audit log exists for — "did I actually
    # approve that?" — unanswerable from the log.
    if [ "${AUDIT_DECISION:-}" = declined ]; then audit declined; else audit ok; fi
else
    _moai_status=$?
    audit failed "status=${_moai_status}"
    exit "${_moai_status}"
fi
