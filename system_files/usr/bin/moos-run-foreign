#!/usr/bin/env bash
# moos-run-foreign — double-click a Windows .exe or an Android .apk and it RUNS.
#
# WHY: MoOS already shipped both runtimes (Bottles for Windows, Waydroid for Android) and
# both could be set up from Mo AI — but nothing connected them to the file manager. Double-
# clicking a downloaded .exe did nothing at all: no handler claimed it, so Dolphin offered to
# open it in a text editor. That is the gap between "the OS supports Windows apps" and "the
# user can run the program they just downloaded", and closing it is the whole point of the
# unified runner (docs/DEVELOPMENT_PLAN.md P4.3).
#
# WHAT IT DOES: asks /usr/libexec/moos-app-engine which engine owns the file and whether
# that engine is ready, then does the ONE thing that follows. It no longer decides alone,
# because deciding alone is how it came to disagree with the image it ships in: build.sh
# installs a Windows runtime on every desktop edition so "any .exe the user downloads
# actually runs", and this script knew only about the optional Flatpak one — so a first
# .exe offered a large download on a machine that could already run it.
#
#   .exe .msi .lnk .msp  ->  engine "Windows programs"
#   .apk                 ->  engine "Android apps"
#   .docx .xlsx .pptx …  ->  an office suite, which is an app and not an engine
#
# The engine's own name is never shown. A person who downloaded a program wants to know
# it is a Windows program; which runtime MoOS used to run it is MoOS's business.
#
# The office half closes the same gap for documents. MEASURED on the shipped image before
# this: `xdg-mime query default` returned NOTHING for all eight of .docx, .xlsx, .pptx,
# .doc, .xls, .odt, .rtf and .csv — so a Word file a colleague sent you did nothing at all
# when you double-clicked it. MoOS deliberately does not ship a ~700 MB office suite, and
# LibreOffice was already in Mo AI's store; what was missing was the bridge between them.
#
# NOT A SECURITY BOUNDARY, and it does not need to be: it is reached only through a MimeType
# association, so the file is one the user picked in their own file manager, and every path
# below hands that file to a sandboxed runtime (Bottles is a Flatpak; Waydroid is a container).
# It runs NOTHING with privilege — the only privileged step (installing a runtime) is delegated
# to moai-do, which confirms and uses Polkit exactly as before.
set -uo pipefail

OFFICE_ID="org.libreoffice.LibreOffice"

# WHICH engine runs a file, whether it is ready, and what to CALL it in front of
# a person: one resolver over /usr/share/moos/app-engines.json, shared with Mo
# Store and App Drop. This script used to decide alone and got it wrong in a way
# nobody could see from the source: build.sh installs wine on every desktop
# edition so "any .exe the user downloads actually runs", and this file knew only
# about Bottles — so the first .exe on a fresh MoOS offered a large download on a
# machine that could already run it.
ENGINE_TOOL="${MOOS_APP_ENGINE:-/usr/libexec/moos-app-engine}"

engine() {  # engine <file> <jq-ish key>  -> value, or empty
    "$ENGINE_TOOL" resolve "$1" 2>/dev/null | python3 -c '
import json, sys
try:
    document = json.load(sys.stdin)
except ValueError:
    raise SystemExit(0)
key = sys.argv[1]
if key == "name":
    name = document.get("name") or {}
    print((name.get("ar") or "") + "|" + (name.get("en") or ""))
elif key == "chosen":
    chosen = document.get("chosen") or {}
    print(chosen.get("id") or "")
elif key == "sandboxed":
    chosen = document.get("chosen") or {}
    print("yes" if chosen.get("sandboxed") else "no")
elif key == "preflight_reason":
    preflight = document.get("preflight") or {}
    reason = preflight.get("reason") or {}
    if preflight.get("status") == "blocked":
        print((reason.get("ar") or "") + " | " + (reason.get("en") or ""))
elif key == "preflight_architecture":
    preflight = document.get("preflight") or {}
    print(preflight.get("architecture") or "unknown")
else:
    value = document.get(key)
    print("" if value is None else ("yes" if value is True else ("" if value is False else value)))
' "$2" 2>/dev/null
}

# The two halves of the engine's display name. Never a runtime's brand: a person
# who downloaded a .exe wants "Windows programs", not a lesson about Wine.
engine_ar() { engine "$1" name | cut -d"|" -f1; }
engine_en() { engine "$1" name | cut -d"|" -f2; }

# A MoOS notification filed under Mo Store, where the program came from: the desktop-entry
# hint lets System Settings › Notifications list and mute it. kdialog is only the fallback.
notify() {
    if command -v notify-send >/dev/null 2>&1 \
        && notify-send --app-name=MoOS --icon=moos-store \
               --hint=string:desktop-entry:org.moos.store "MoOS" "$1" >/dev/null 2>&1; then
        return 0
    fi
    command -v kdialog >/dev/null 2>&1 && kdialog --title "MoOS" --passivepopup "$1" 6 >/dev/null 2>&1 || true
}

# Match old Windows UI to the desktop density before launching it. XWayland scales
# the pixels, but many Win32 programs still lay out controls at a hard-coded 96
# DPI; on a 4K MoOS desktop that leaves a perfectly sharp, unusably tiny dialog.
# Use the density Plasma publishes through X resources and cap it at 200%: beyond
# that, legacy fixed-size dialogs can grow taller than the usable screen. This is
# intentionally a prefix setting, not a KWin size rule — stretching a fixed Win32
# dialog only creates a large blank window while its controls stay in one corner.
wine_display_dpi() {
    local raw
    raw="$(xrdb -query 2>/dev/null | awk '$1 == "Xft.dpi:" { print $2; exit }')"
    awk -v dpi="${raw:-96}" 'BEGIN {
        dpi += 0
        if (dpi < 96) dpi = 96
        if (dpi > 192) dpi = 192
        printf "%.0f\n", dpi
    }'
}

wine_prepare_display() {
    local prefix="$1" state_dir="$2" dpi stamp
    dpi="$(wine_display_dpi)"
    stamp="$state_dir/windows-dpi"
    if [ -f "$prefix/user.reg" ] && [ "$(cat "$stamp" 2>/dev/null || true)" = "$dpi" ]; then
        return 0
    fi
    if env WINEPREFIX="$prefix" WINEDLLOVERRIDES="mscoree,mshtml=" \
            wine reg add 'HKCU\Control Panel\Desktop' /v LogPixels \
            /t REG_DWORD /d "$dpi" /f >/dev/null 2>&1; then
        printf '%s\n' "$dpi" >"$stamp"
    fi
}

# A yes/no the user can actually read, in both languages. Default to "no" — an OS that
# installs a multi-hundred-MB runtime because a file was double-clicked is not trustworthy.
ask() {
    command -v kdialog >/dev/null 2>&1 || return 1
    # KDialog 26 has no default-button flag: its internal primary button always
    # owns Enter. Label that primary button Cancel, put the action on its
    # secondary button, then accept ONLY secondary (exit 1). Escape is exit 2.
    kdialog --title "MoOS" \
        --yes-label "إلغاء | Cancel" --no-label "متابعة | Continue" \
        --warningyesno "$1" >/dev/null 2>&1
    [ "$?" -eq 1 ]
}

# Long, chatty work (an APK install can take a minute) belongs in a visible terminal, held
# open so the user sees the result instead of a window that blinks and vanishes.
term() { setsid konsole --hold -e "$@" >/dev/null 2>&1 & }

# Supervise the native Windows-runtime path after the file-manager launcher has
# returned. The old path detached Wine with stderr in /dev/null, so a runtime
# mapping failure looked exactly like a successful double-click. Keep one
# user-owned diagnostic and say plainly when the program exits with an error.
wine_run() {
    local target="$1" prefix state_dir log code
    [ -f "$target" ] || return 2
    prefix="${XDG_DATA_HOME:-$HOME/.local/share}/moos/windows"
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/moos-foreign"
    log="$state_dir/windows-last.log"
    mkdir -p "$prefix" "$state_dir" 2>/dev/null || return 1
    wine_prepare_display "$prefix" "$state_dir"
    env WINEPREFIX="$prefix" WINEDLLOVERRIDES="mscoree,mshtml=" \
        wine "$target" >"$log" 2>&1
    code=$?
    if [ "$code" -ne 0 ]; then
        notify "تعذّر فتح برنامج Windows. لم يُثبّت شيء. يمكن لـ Mo AI فحص المشكلة. | This Windows program could not be opened. Nothing was installed. Mo AI can inspect the problem."
    fi
    return "$code"
}

# Runtime files are not proof that the kernel can map them. The 2026-09-19
# signed image contains the complete modern 32-bit payload, yet a real PE32
# program fails before main() because SELinux rejects an executable composefs
# mapping. Probe MoOS's own built-in PE32 command once per image revision,
# never the downloaded file. A failed probe goes to the same optional,
# sandboxed compatibility setup used on machines without a native runtime.
native_x86_ready() {
    local image_key cache_dir status prefix probe log result candidate
    # Key the answer to the booted immutable deployment, not VERSION_ID (which
    # deliberately remains 44 across MoOS updates). A policy or runtime fix in
    # the next image must cause a fresh probe instead of inheriting "blocked".
    image_key="$(rpm-ostree status --json 2>/dev/null | python3 -c '
import json, sys
try:
    deployments = json.load(sys.stdin).get("deployments", [])
except (ValueError, OSError):
    deployments = []
print(next((d.get("checksum", "") for d in deployments if d.get("booted")), ""))
' 2>/dev/null)"
    if [ -z "$image_key" ]; then
        image_key="$(stat -Lc '%d-%i-%s-%Y' /usr/bin/wine 2>/dev/null || printf unknown)"
    fi
    image_key="$(printf '%s' "$image_key" | tr -c 'A-Za-z0-9._-' '_')"
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/moos-foreign"
    status="$cache_dir/windows-x86-$image_key.status"
    prefix="$cache_dir/windows-x86-probe-$image_key"
    log="$cache_dir/windows-x86-probe-$image_key.log"
    probe=""
    for candidate in \
            /usr/lib64/wine-wow64/wine/i386-windows/cmd.exe \
            /usr/lib64/wine/i386-windows/cmd.exe \
            /usr/lib/wine/i386-windows/cmd.exe; do
        if [ -f "$candidate" ]; then
            probe="$candidate"
            break
        fi
    done

    case "$(cat "$status" 2>/dev/null || true)" in
        available) return 0 ;;
        blocked) return 1 ;;
    esac
    mkdir -p "$cache_dir" "$prefix" 2>/dev/null || return 1
    [ -n "$probe" ] || { printf '%s\n' blocked >"$status"; return 1; }

    timeout 30 env WINEPREFIX="$prefix" WINEARCH=wow64 \
        WINEDLLOVERRIDES="mscoree,mshtml=" wine "$probe" /c exit \
        >"$log" 2>&1
    result=$?
    if [ "$result" -eq 0 ]; then
        printf '%s\n' available >"$status"
        return 0
    fi
    printf '%s\n' blocked >"$status"
    return 1
}

usage() { echo "usage: moos-run-foreign <file.exe|file.msi|file.apk>" >&2; exit 2; }

# ---------------------------------------------------------------------------------
# One decision for every foreign file, from the shared engine registry.
#
# Three outcomes, in this order:
#   ready            -> run it now, with no questions and no downloads
#   needs setup      -> ONE question, in the words of the KIND of program, then
#                       hand the one-time download to moai-do (which confirms and
#                       uses Polkit exactly as before)
#   nothing can run it -> say so plainly rather than failing silently
#
# What is never said out loud: the runtime's name. The registry's `name` is the
# only text that reaches a person.
# ---------------------------------------------------------------------------------
run_with_engine() {
    local target="$1" ar en chosen sandboxed preflight_reason architecture route
    ar="$(engine_ar "$target")"; en="$(engine_en "$target")"
    [ -n "$en" ] || { notify "لا يعرف MoOS كيف يفتح هذا الملف | MoOS cannot open this file"; exit 2; }

    preflight_reason="$(engine "$target" preflight_reason)"
    if [ -n "$preflight_reason" ]; then
        notify "$preflight_reason"
        exit 2
    fi

    if [ "$(engine "$target" ready)" = "yes" ]; then
        chosen="$(engine "$target" chosen)"
        sandboxed="$(engine "$target" sandboxed)"
        architecture="$(engine "$target" preflight_architecture)"
        if [ "$chosen" = "wine" ] && [ "$architecture" = "x86" ] \
                && ! native_x86_ready; then
            route="$(engine "$target" provision_route)"
            if [ -n "$route" ] && ask "هذا برنامج Windows أقدم ويحتاج دعم توافق اختياريًا (تنزيل كبير لمرة واحدة). لم يُشغّل الملف.\n\nنجهّز الدعم الآن؟\n\nThis older Windows program needs optional compatibility support (a large one-time download). The file was not launched.\n\nSet it up now?"; then
                moos-open "$route"
            fi
            exit 0
        fi
        case "$chosen" in
            com.usebottles.bottles)
                # Its desktop entry declares these MIME types and uses Flatpak file
                # forwarding (`@@u %u @@`), so going through the entry is what gets the
                # path across the sandbox boundary — `flatpak run <id> <path>` would hand
                # over a path the sandbox cannot see.
                notify "يشغّل $ar | opening $en"
                setsid gtk-launch "$chosen" "$target" >/dev/null 2>&1 &
                ;;
            wine)
                # Shipped in the image, so this is the ordinary path on a desktop MoOS
                # and it costs no download. It is NOT a sandbox: the program gets the
                # owner's files. Say that once, the first time, rather than on every run
                # (a warning shown every time is a warning nobody reads) and rather than
                # never (which would be hiding it).
                local seen="${XDG_STATE_HOME:-$HOME/.local/state}/moos-foreign-windows-notice"
                if [ ! -e "$seen" ]; then
                    mkdir -p "$(dirname "$seen")" 2>/dev/null || true
                    ask "سيعمل هذا البرنامج على جهازك مع صلاحية الوصول إلى ملفاتك، مثل أي برنامج تثبّته بنفسك.\n\nنشغّله؟\n\nThis program will run on your machine with access to your files, like any program you install yourself.\n\nRun it?" || exit 0
                    : >"$seen" 2>/dev/null || true
                fi
                notify "يشغّل $ar | opening $en"
                setsid /usr/bin/moos-run-foreign --wine-run "$target" >/dev/null 2>&1 &
                ;;
            waydroid)
                term moos-run-foreign --apk-install "$target"
                ;;
            *)
                notify "لا يوجد محرّك جاهز لـ$ar | no ready engine for $en"
                exit 2
                ;;
        esac
        exit 0
    fi

    if [ "$(engine "$target" needs_setup)" = "yes" ]; then
        local route; route="$(engine "$target" provision_route)"
        if [ -n "$route" ] && ask "هذا من $ar. لتشغيله يحتاج MoOS تجهيزًا لمرة واحدة (تنزيل كبير).\n\nنجهّزه الآن؟\n\nThis is one of your $en. Running it needs a one-time setup (a large download).\n\nSet it up now?"; then
            moos-open "$route"
        fi
        exit 0
    fi

    notify "لا يستطيع هذا الإصدار تشغيل $ar | this edition cannot run $en"
    exit 2
}

# ---------------------------------------------------------------------------------
# The Android half, run INSIDE the terminal window opened below (--apk-install).
# ---------------------------------------------------------------------------------
apk_install() {
    local apk="$1"
    echo "MoOS — تثبيت تطبيق Android | installing an Android app"
    echo "  $apk"
    echo

    # The container has to be up before it can be handed a package. `session start` is a
    # user-level call and is a no-op when a session is already running.
    if ! waydroid status 2>/dev/null | grep -qi 'session:[[:space:]]*running'; then
        echo "يشغّل حاوية Android… | starting the Android container…"
        setsid waydroid session start >/dev/null 2>&1 &
        for _ in $(seq 1 30); do
            waydroid status 2>/dev/null | grep -qi 'session:[[:space:]]*running' && break
            sleep 1
        done
    fi

    if /usr/bin/moos-storectl install-file "$apk"; then
        echo
        echo "✓ اكتمل التثبيت — افتح التطبيق من قائمة التطبيقات | installation completed — open the app from the launcher"
    else
        echo
        echo "✗ فشل التثبيت | install failed"
        echo "  افتح Mo AI ليفحص الجهاز | open Mo AI to check the system"
        return 1
    fi
    echo
}

case "${1:-}" in
    --apk-install) shift; [ -n "${1:-}" ] || usage; apk_install "$1"; exit $? ;;
    --wine-run) shift; [ -n "${1:-}" ] || usage; wine_run "$1"; exit $? ;;
    -h|--help|"") usage ;;
esac

file="$1"
# Dolphin may hand a file:// URI even for %f. Accept both.
case "$file" in
    file://*) file="$(python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1][7:]))' "$file" 2>/dev/null)" ;;
esac
[ -f "$file" ] || { notify "الملف غير موجود | file not found"; exit 2; }

ext="${file##*.}"
ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

case "$ext" in
    # ── Windows ──────────────────────────────────────────────────────────────────
    exe|msi|lnk|msp)
        run_with_engine "$file"
        ;;

    # ── Android ──────────────────────────────────────────────────────────────────
    apk)
        run_with_engine "$file"
        ;;

    # ── Office documents ─────────────────────────────────────────────────────────
    #
    # MoOS shipped no office suite and no default for ANY office type. Measured on the
    # image: `xdg-mime query default` returned nothing for .docx, .xlsx, .pptx, .doc,
    # .xls, .odt and .rtf — all eight. So double-clicking a Word file a colleague sent
    # did nothing at all. That is the same gap the .exe had, with the same shape and the
    # same fix.
    #
    # LibreOffice is NOT in the image on purpose (it is ~700 MB and most people never
    # open a .docx), and it is already in Mo AI's store catalogue. What was missing was
    # the bridge: an association that explains and offers the one-time install, instead
    # of a double-click that silently does nothing.
    #
    # Deliberately NOT here: .csv. It is a text/plain subclass, kate is already in the
    # image and opens it instantly — making someone install 700 MB to read a comma-
    # separated file would be a worse answer than the one they have. It is pinned to
    # kate in mimeapps.list instead.
    doc|docx|odt|rtf|xls|xlsx|ods|ppt|pptx|odp)
        if flatpak info "$OFFICE_ID" >/dev/null 2>&1; then
            # Through the desktop entry, not `flatpak run <id> <path>`: the same
            # file-forwarding reason as Bottles above — a raw path is one the sandbox
            # cannot see. LibreOffice's start centre routes the document to Writer,
            # Calc or Impress by its type, so one entry covers all nine extensions.
            notify "يفتح المستند في LibreOffice | opening in LibreOffice"
            setsid gtk-launch "$OFFICE_ID" "$file" >/dev/null 2>&1 &
            exit 0
        fi
        # A native (rpm-layered) LibreOffice is a perfectly good answer too, and someone
        # who layered one should not be asked to install a second copy from Flathub.
        if command -v libreoffice >/dev/null 2>&1; then
            notify "يفتح المستند في LibreOffice | opening in LibreOffice"
            setsid libreoffice "$file" >/dev/null 2>&1 &
            exit 0
        fi
        if ask "هذا مستند Office. لفتحه يحتاج MoOS حزمة مكتبية (LibreOffice) — تثبيت لمرة واحدة.\n\nنثبّتها الآن؟\n\nThis is an Office document. Opening it needs an office suite (LibreOffice) — a one-time install.\n\nInstall it now?"; then
            moos-open "moos://apps/install/${OFFICE_ID}"
        fi
        ;;

    *)
        notify "نوع ملف غير مدعوم | unsupported file type: .$ext"
        exit 2 ;;
esac
exit 0
