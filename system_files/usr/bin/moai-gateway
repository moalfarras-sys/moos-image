#!/usr/bin/env python3
# moai-gateway — Mo AI's FRONT DOOR. One port, two brains, chosen PER REQUEST.
#
# WHY THIS EXISTS IN THIS SHAPE (read before you touch a port number)
#   Mo AI used to have a hard either/or. moai.service (RamaLama, the local brain)
#   and this gateway (the cloud proxy) BOTH listened on 8080, so only one of them
#   could ever run, and switching brain meant `systemctl disable --now` one and
#   `enable --now` the other — a global, service-bouncing setting buried in a
#   settings sheet. Choosing a brain per conversation was not possible at all.
#
#   Now there is one door:
#
#       8080   moai-gateway   ALWAYS ON. The only thing the app ever talks to.
#       8081   moai.service   the local brain (RamaLama). Started ON DEMAND.
#
#   The app still speaks exactly ONE dialect — OpenAI /v1/chat/completions with
#   SSE deltas — and still never sees the API key. What is new is that it may say
#   WHICH brain it wants, in the request's `model` field:
#
#   ┌─ THE ROUTING CONTRACT ───────────────────────────────────────────────────┐
#   │  "local"              → the local brain, whatever model it is serving     │
#   │  "local:<model>"      → the local brain, serving <model>                  │
#   │  "cloud"              → the configured provider + its configured model    │
#   │  "cloud:<model-id>"   → the configured provider, <model-id> upstream      │
#   │  absent / anything    → the default in ~/.config/moai/config.json         │
#   │                         (mode=local|cloud) — the pre-split behaviour, so   │
#   │                         an older client keeps working unchanged.           │
#   └──────────────────────────────────────────────────────────────────────────┘
#
#   The split is on the FIRST colon, so a model id may contain colons of its own
#   ("local:qwen3:4b-instruct" → local, "qwen3:4b-instruct").
#
# WHY `local:<model>` RESTARTS THE UNIT INSTEAD OF PASSING THE NAME THROUGH
#   llama.cpp — which is what RamaLama serves behind — IGNORES the request's
#   `model` field. VERIFIED on this machine: a request for "totally-made-up" was
#   answered, without complaint, by the loaded weights. So a picker that listed
#   three local models and simply forwarded the name would be a lie: all three
#   would be answered by the same model. The only honest way to serve a different
#   local model is to point the unit at it and restart, which is what ensure_local
#   does — and only for a model that is ALREADY pulled, because a chat message
#   must never be able to start a multi-gigabyte download behind the user's back.
#
# WIRE PROTOCOLS (the cloud side, unchanged)
#   openai     — OpenAI, OpenRouter, Google Gemini (its OpenAI-compatible
#                endpoint), Groq, Together, a local vLLM, and any private
#                OpenAI-compatible gateway. Passed through almost untouched.
#   anthropic  — Claude's NATIVE API (/v1/messages). A genuinely different shape:
#                the system prompt is a top-level field, max_tokens is required,
#                auth is x-api-key, and the stream is content_block_delta events.
#                Translated in both directions here so the app stays unchanged.
#
# This process is the only thing that ever sees the API key: it reads the provider
# (base URL + model + wire) from ~/.config/moai/config.json and the KEY from Secret
# Service. Stdlib only (no pip deps).
import json, os, re, socket, subprocess, sys, threading, time
import urllib.error, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONFIG = os.path.expanduser("~/.config/moai/config.json")
MOOS_DIR = os.path.expanduser("~/.config/moos")
ENV_FILE = os.path.join(MOOS_DIR, "moai.env")

PORT = int(os.environ.get("MOAI_GATEWAY_PORT", "8080"))
LOCAL_PORT = int(os.environ.get("MOAI_LOCAL_PORT", "8081"))
LOCAL_UNIT = os.environ.get("MOAI_LOCAL_UNIT", "moai.service")
LOCAL_BASE = "http://127.0.0.1:%d" % LOCAL_PORT

# The gateway is the one process that sees every local chat, so it stamps the time of
# the last one here. moai-idle.timer reads this file's mtime and stops the local brain
# once it goes stale, freeing ~6 GB of VRAM — otherwise the model sits in the GPU forever
# and starves the compositor (a maximised browser on top of a loaded brain has crashed
# kwin_wayland with NVRM: invalid mmap context and frozen the desktop). ensure_local()
# brings the brain back on the next request, so unloading it while idle costs only a reload.
ACTIVITY_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % os.getuid()),
    "moai-activity")


def mark_activity():
    """Record that the local brain was just used, for moai-idle's staleness check."""
    try:
        with open(ACTIVITY_FILE, "w") as handle:
            handle.write(str(int(time.time())))
    except OSError:
        pass

# How long to wait for the local brain after starting it. A model that is already
# pulled loads in well under a minute; the FIRST ever start downloads ~2.5 GB and
# can take far longer than any HTTP request should be held open, which is why the
# timeout answers with an instruction instead of hanging forever.
LOCAL_TIMEOUT = float(os.environ.get("MOAI_LOCAL_TIMEOUT", "180"))

# Must stay in step with Environment=MOAI_MODEL in moai.service. This is only the
# fallback: ~/.config/moos/moai.env is an EnvironmentFile and therefore OUTRANKS
# the unit's Environment=, so env_model() reads the file that actually decides.
DEFAULT_LOCAL_MODEL = "ollama://qwen3:4b-instruct"

# Identify ourselves. Python's urllib defaults to "Python-urllib/3.x", and
# Cloudflare — which fronts a large share of AI providers — answers that with
# HTTP 403 "error code: 1010" before the request ever reaches the API. The
# shipped gateway sent the default and therefore could not reach ANY
# Cloudflare-fronted provider; the cloud brain was configurable and dead.
USER_AGENT = "MoOS-MoAI/1.0 (+https://github.com/moalfarras-sys/moos-image)"

ANTHROPIC_VERSION = "2023-06-01"
DEFAULT_MAX_TOKENS = 2048

# A base URL is expected to carry its API version ("…/v1", "…/v1beta/openai").
VERSIONED = re.compile(r"/v\d[\w.]*(/|$)")

# "ollama://library/qwen3:4b-instruct" — strip the transport, keep the name.
SCHEME = re.compile(r"^[a-z0-9+.-]+://")


def load_cfg():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def load_secret():
    try:
        result = subprocess.run(
            ["secret-tool", "lookup", "service", "org.moos.MoAI",
             "account", "cloud"], capture_output=True, text=True,
            timeout=10, check=False)
        return result.stdout.rstrip("\n") if result.returncode == 0 else ""
    except Exception:
        return ""


# ── The local brain ──────────────────────────────────────────────────────────

def short_model(name):
    """`ollama://library/qwen3:4b-instruct` → `qwen3:4b-instruct`.

    RamaLama normalises `ollama://qwen3:4b` to `ollama://library/qwen3:4b`, so the
    string in moai.env and the string in `ramalama list` name the same weights and
    do not match. Compare the short form, or every request would look like a
    request to switch models and pointlessly restart the unit.
    """
    n = SCHEME.sub("", (name or "").strip())
    if n.startswith("library/"):
        n = n[len("library/"):]
    return n


def env_model():
    """The model the local unit will ACTUALLY serve.

    moai.env is the unit's EnvironmentFile, so it outranks the unit's own
    Environment= line. Reading the shipped default here instead of this file is
    the exact mistake that let a stale moai.env keep the local brain on 8080.
    """
    try:
        with open(ENV_FILE, encoding="utf-8") as f:
            for line in f:
                if line.startswith("MOAI_MODEL="):
                    value = line.split("=", 1)[1].strip()
                    if value:
                        return value
    except Exception:
        pass
    return DEFAULT_LOCAL_MODEL


def env_port():
    """The port the local unit will ACTUALLY bind, or None if the file says nothing.

    Same trap as env_model(), and it is the one that actually bit: moai.env is the
    unit's EnvironmentFile, and systemd applies an EnvironmentFile AFTER the unit's
    own Environment= lines — so this file wins. A moai.env left over from the old
    single-port layout still says MOAI_PORT=8080.
    """
    try:
        with open(ENV_FILE, encoding="utf-8") as f:
            for line in f:
                if line.startswith("MOAI_PORT="):
                    return int(line.split("=", 1)[1].strip())
    except Exception:
        pass
    return None


def set_env_model(model):
    """Point the local unit at `model`.

    The port is rewritten too, and never taken from the old file: 8080 is the
    gateway's and a rewrite that carried a stale MOAI_PORT forward would put the
    local brain back on top of the front door.
    """
    os.makedirs(MOOS_DIR, exist_ok=True)
    os.chmod(MOOS_DIR, 0o700)
    tmp = ENV_FILE + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("MOAI_PORT=%d\nMOAI_MODEL=%s\n" % (LOCAL_PORT, model))
    os.chmod(tmp, 0o600)
    os.replace(tmp, ENV_FILE)


_pulled_lock = threading.Lock()
_pulled_cache = {"names": [], "ts": 0.0}
PULLED_TTL = 30.0


def pulled_models():
    """The models RamaLama has already downloaded. Cached — it is a subprocess."""
    with _pulled_lock:
        if _pulled_cache["names"] and time.monotonic() - _pulled_cache["ts"] < PULLED_TTL:
            return list(_pulled_cache["names"])
    names = []
    try:
        result = subprocess.run(["ramalama", "list", "--json"],
                                capture_output=True, text=True, timeout=25, check=False)
        if result.returncode == 0:
            for item in json.loads(result.stdout or "[]"):
                name = (item.get("name") or "").strip()
                if name:
                    names.append(name)
    except Exception:
        pass
    with _pulled_lock:
        _pulled_cache["names"] = list(names)
        _pulled_cache["ts"] = time.monotonic()
    return names


def local_online(timeout=1.5):
    try:
        with urllib.request.urlopen(LOCAL_BASE + "/v1/models", timeout=timeout) as r:
            return r.status == 200
    except Exception:
        return False


# ── Why the brain did not come up ────────────────────────────────────────────
# Everything below exists because the failure message lied. When the brain does not
# answer, the gateway told the user "the first start downloads the model (~2.5 GB) and
# keeps going in the background" — the ONE message it had. It says that when the disk is
# full, when there is no network to download from, and when llama-server aborted on this
# very machine because the GPU had no memory left (SIGABRT, 2026-07-13). The user waits
# for a download that is not happening.
#
# So: check what can be checked BEFORE starting, and when it fails anyway, read the
# service's own log and say what it said.
MODEL_BYTES = 3 * 1024 ** 3   # a ~2.5 GB model plus room for RamaLama's staging copy.


def disk_free(path="/var"):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize
    except OSError:
        return -1


def gb(n):
    return "%.1f GB" % (n / 1024 ** 3)


def have_network(timeout=2.0):
    """Can we reach the model registry at all? A pull needs this; a loaded brain does not."""
    try:
        socket.create_connection(("registry.ollama.ai", 443), timeout=timeout).close()
        return True
    except OSError:
        pass
    try:
        socket.create_connection(("huggingface.co", 443), timeout=timeout).close()
        return True
    except OSError:
        return False


def preflight_local(target):
    """Refuse a start that cannot possibly work, and say why. "" = go ahead."""
    if target and target in pulled_models():
        return ""                      # already downloaded: no disk, no network needed
    free = disk_free()
    if 0 <= free < MODEL_BYTES:
        return ("لا تكفي المساحة لتنزيل النموذج: متاح %s، ويلزم نحو %s.\n"
                "فرّغ مساحة (جرّب: moai-do optimize) ثم أعد المحاولة.\n"
                "Not enough disk space to download the model: %s free, ~%s needed. "
                "Free some space (try: moai-do optimize) and ask again."
                % (gb(free), gb(MODEL_BYTES), gb(free), gb(MODEL_BYTES)))
    if not have_network():
        return ("النموذج غير محمّل ولا يوجد اتصال بالإنترنت لتنزيله.\n"
                "وصّل الإنترنت، أو اسأل العقل السحابي.\n"
                "The model is not downloaded and there is no internet connection to "
                "fetch it. Connect to the network, or ask the cloud brain instead.")
    return ""


# What the service says when it dies, mapped to what the user can do about it. Ordered:
# the first match wins, so the specific signatures come before the generic ones.
FAILURE_SIGNS = [
    (("out of memory", "cudamalloc", "failed to allocate", "cuda error", "vram"),
     "ذاكرة كرت الشاشة لا تكفي لتحميل النموذج الآن.\n"
     "أغلق تطبيقاً ثقيلاً (متصفّح/لعبة) ثم أعد المحاولة — MoOS يفرّغ العقل تلقائياً عند الخمول.\n"
     "The GPU ran out of memory loading the model. Close a heavy app (a browser or a "
     "game) and ask again — MoOS unloads the brain automatically when it goes idle."),
    (("no space left", "enospc", "disk full"),
     "امتلأت المساحة أثناء تحميل النموذج.\n"
     "فرّغ مساحة (moai-do optimize) ثم أعد المحاولة.\n"
     "The disk filled up while loading the model. Free some space (moai-do optimize)."),
    (("name resolution", "could not resolve", "connection refused", "network is unreachable",
      "temporary failure", "timed out"),
     "انقطع الاتصال أثناء جلب النموذج.\n"
     "تحقّق من الإنترنت ثم أعد المحاولة.\n"
     "The connection dropped while fetching the model. Check the network and retry."),
    (("no such file", "not found", "manifest unknown"),
     "النموذج غير موجود في السجل.\n"
     "The model was not found in the registry. Pick another model in Settings."),
]


def local_failure_reason():
    """Ask the SERVICE why it is not up. "" when it is simply still working."""
    try:
        state = subprocess.run(["systemctl", "--user", "is-active", LOCAL_UNIT],
                               capture_output=True, text=True, timeout=10, check=False)
        active = (state.stdout or "").strip()
    except Exception:
        return ""
    # "activating" is a unit still coming up (RamaLama pulls a model before it serves), and
    # calling that a failure would turn every slow first start into a false alarm. Only a
    # unit that is DOWN gets diagnosed.
    if active in ("active", "activating", "reloading"):
        return ""                      # up (or coming up) but not answering yet — a slow load

    try:
        log = subprocess.run(
            ["journalctl", "--user", "-u", LOCAL_UNIT, "-n", "40", "--no-pager"],
            capture_output=True, text=True, timeout=15, check=False)
        text = (log.stdout or "").lower()
    except Exception:
        log, text = None, ""

    for needles, message in FAILURE_SIGNS:
        if any(n in text for n in needles):
            return message

    # The last line is usually systemd's own bookkeeping ("Consumed 652ms CPU time…"),
    # which tells the user nothing. Prefer the last thing the SERVICE said.
    lines = [l.strip() for l in ((log.stdout if log else "") or "").splitlines() if l.strip()]
    spoken = [l for l in lines if "systemd[" not in l]
    tail = (spoken or lines or [""])[-1]
    return ("توقّف العقل المحلي (%s) ولم يبدأ.\n"
            "آخر ما قاله: %s\n"
            "The local brain is %s and did not start. Last log line: %s"
            % (active or "inactive", tail or "—", active or "inactive", tail or "—"))


def systemctl(verb):
    try:
        result = subprocess.run(["systemctl", "--user", verb, LOCAL_UNIT],
                                capture_output=True, text=True, timeout=60, check=False)
    except Exception as e:
        return "systemctl --user %s %s: %s" % (verb, LOCAL_UNIT, e)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()[:200]
        return "systemctl --user %s %s: %s" % (verb, LOCAL_UNIT, detail)
    return ""


_local_lock = threading.Lock()


def ensure_local(want):
    """Bring the local brain up, serving `want` ("" = whatever it already serves).

    Returns "" on success, or a message meant for the user. Serialised: two chats
    that both wake the brain must not race two `systemctl start`s at it, and the
    second one should wait for the first rather than start a parallel download.
    """
    with _local_lock:
        current = env_model()
        switching = bool(want) and short_model(want) != short_model(current)

        # Reconcile the PORT on every start, not only when the model changes.
        #
        # This is the bug that made the very first `local` request fail. moai.env is
        # the unit's EnvironmentFile and therefore outranks the unit's own
        # Environment=MOAI_PORT=8081. A file written under the old single-port layout
        # still says 8080. Rewriting it only on the model-switch path meant the plain
        # "local" path started the brain with the STALE port — so RamaLama bound the
        # wrong one, this gateway polled 8081, found nothing, and timed out after
        # three minutes with the model loaded and sitting idle. Measured, exactly
        # that: the unit went active, the model loaded, and the chat returned 502.
        stale_port = env_port() != LOCAL_PORT

        if not switching and not stale_port and local_online():
            return ""

        target = current
        if switching:
            target = ""
            for name in pulled_models():
                if short_model(name) == short_model(want):
                    target = name
                    break
            if not target:
                # Never start a multi-gigabyte download from a chat message.
                return ("النموذج «%s» غير محمّل على هذا الجهاز.\n"
                        "The local model \"%s\" is not downloaded. Pull it first:\n"
                        "    ramalama pull %s" % (want, want, want))

        # Do not start something that cannot succeed: no disk for the download, or no
        # network to download from. Both used to fail deep inside RamaLama and surface
        # as "the model is downloading in the background", which was a lie.
        blocked = preflight_local(target)
        if blocked:
            return blocked

        if switching or stale_port:
            # A running brain on the wrong port has to be restarted, not started:
            # systemd will not re-read the EnvironmentFile for a unit it considers
            # already up.
            set_env_model(target)
            error = systemctl("restart")
        else:
            error = systemctl("start")
        if error:
            return ("تعذّر تشغيل العقل المحلي | could not start the local brain\n"
                    + error)

        deadline = time.monotonic() + LOCAL_TIMEOUT
        next_check = time.monotonic() + 6.0
        while time.monotonic() < deadline:
            if local_online():
                return ""
            # The unit dying is not the same as the unit being slow, and only one of the
            # two is worth waiting out. Ask the service; if it is DOWN, say what killed it
            # (GPU memory, disk, network) instead of waiting the full timeout and blaming a
            # download that already failed. Every 6 s — this shells out twice, and the
            # answer cannot change faster than the unit can.
            if time.monotonic() >= next_check:
                reason = local_failure_reason()
                if reason:
                    return reason
                next_check = time.monotonic() + 6.0
            time.sleep(1.5)
        return ("العقل المحلي لم يجب خلال %d ثانية — أول تشغيل يحمّل النموذج (~2.5GB) "
                "ويكمل في الخلفية.\n"
                "The local brain did not answer within %ds. The first start downloads "
                "the model (~2.5 GB) and keeps going in the background — watch it with "
                "`moai-start logs`, then ask again."
                % (int(LOCAL_TIMEOUT), int(LOCAL_TIMEOUT)))


# ── Routing ──────────────────────────────────────────────────────────────────

def parse_model(field):
    """The request's `model` field → (brain, model). ("", "") means: use the default."""
    raw = (field or "").strip()
    low = raw.lower()
    if low == "local":
        return "local", ""
    if low.startswith("local:"):
        return "local", raw.split(":", 1)[1].strip()
    if low == "cloud":
        return "cloud", ""
    if low.startswith("cloud:"):
        return "cloud", raw.split(":", 1)[1].strip()
    return "", ""


def resolve(field, cfg):
    """(brain, model) for this request, falling back to the configured default."""
    brain, model = parse_model(field)
    if not brain:
        brain = "cloud" if cfg.get("mode") == "cloud" else "local"
        model = ""
    if brain == "cloud" and not model:
        model = cfg.get("cloud_model") or ""
    return brain, model


def upstream_url(base, path, wire):
    """Map the app's /v1/<endpoint> onto the provider's base URL."""
    b = base.rstrip("/")
    if not VERSIONED.search(b):
        # A bare host was pasted. Add the conventional version segment so it
        # still works rather than 404ing on the user.
        b += "/v1"
    endpoint = path[len("/v1"):] if path.startswith("/v1/") else path
    if wire == "anthropic":
        # Claude has no /chat/completions.
        return b + ("/messages" if endpoint.startswith("/chat/completions") else endpoint)
    return b + endpoint


def auth_headers(key, wire):
    if wire == "anthropic":
        return {"x-api-key": key, "anthropic-version": ANTHROPIC_VERSION}
    return {"Authorization": "Bearer " + key}


# ── OpenAI → Anthropic, and back ─────────────────────────────────────────────

def to_anthropic(body, model):
    """Rewrite an OpenAI chat/completions request as an Anthropic /v1/messages one.

    Returns (body, streaming).
    """
    req = json.loads(body)
    system_parts, messages = [], []
    for m in req.get("messages", []):
        role, content = m.get("role"), m.get("content") or ""
        if role == "system":
            system_parts.append(content)       # Anthropic takes system separately
        elif role in ("user", "assistant"):
            messages.append({"role": role, "content": content})
    streaming = bool(req.get("stream"))
    out = {
        "model": model or req.get("model") or "",
        # Required by Anthropic — OpenAI treats it as optional, so supply a default.
        "max_tokens": req.get("max_tokens") or DEFAULT_MAX_TOKENS,
        "messages": messages,
        "stream": streaming,
    }
    if system_parts:
        out["system"] = "\n\n".join(system_parts)
    return json.dumps(out).encode("utf-8"), streaming


def anthropic_chunk(text):
    """Wrap a text delta in the chat.completion.chunk shape the app parses."""
    return b"data: " + json.dumps({
        "object": "chat.completion.chunk",
        "choices": [{"index": 0, "delta": {"content": text}, "finish_reason": None}],
    }).encode("utf-8") + b"\n\n"


def anthropic_stream_to_openai(upstream, write):
    """Translate Anthropic's SSE events into OpenAI chunks, live.

    Anthropic emits `event: content_block_delta` with
    {"delta": {"type": "text_delta", "text": "…"}}. The app only understands
    choices[0].delta.content, so rewrite each delta as it arrives — buffering the
    whole reply first would throw away the streaming the UI is built around.
    """
    buf = b""
    while True:
        chunk = upstream.read1(65536)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            line = line.strip()
            if not line.startswith(b"data:"):
                continue
            payload = line[5:].strip()
            if not payload:
                continue
            try:
                ev = json.loads(payload)
            except Exception:
                continue
            if ev.get("type") == "content_block_delta":
                text = (ev.get("delta") or {}).get("text") or ""
                if text:
                    write(anthropic_chunk(text))
            elif ev.get("type") == "message_stop":
                write(b"data: [DONE]\n\n")
                return
    write(b"data: [DONE]\n\n")


def anthropic_whole_to_openai(raw):
    """Non-streamed Anthropic reply → an OpenAI chat.completion."""
    try:
        msg = json.loads(raw)
        text = "".join(b.get("text") or "" for b in msg.get("content", [])
                       if b.get("type") == "text")
    except Exception:
        text = ""
    return json.dumps({
        "object": "chat.completion",
        "choices": [{"index": 0, "message": {"role": "assistant", "content": text},
                     "finish_reason": "stop"}],
    }).encode("utf-8")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):  # keep the journal quiet
        pass

    def _cloud_cfg(self, cfg):
        return ((cfg.get("cloud_base") or "").rstrip("/"),
                load_secret(),
                (cfg.get("cloud_wire") or "openai").lower())

    # ── GET ──────────────────────────────────────────────────────────────────

    def do_GET(self):
        cfg = load_cfg()

        # The liveness probe. Cheap on purpose — moai-control polls it every few
        # seconds and must never make it reach out to a provider to answer.
        if self.path.startswith("/healthz"):
            return self._send_json(200, {
                "ok": True,
                "service": "moai-gateway",
                "port": PORT,
                "local_port": LOCAL_PORT,
                "local_unit": LOCAL_UNIT,
                "default_mode": "cloud" if cfg.get("mode") == "cloud" else "local",
            })

        # What this door will actually route. Every id here is a real route; a
        # `cloud:<id>` for any other model the provider knows is accepted too —
        # moai-control's /models asks the provider for that list.
        if self.path.startswith("/v1/models"):
            data = [{"id": "default", "object": "model", "owned_by": "moos"}]
            served = short_model(env_model())
            names = [short_model(n) for n in pulled_models()] or [served]
            if served not in names:
                names.insert(0, served)
            for name in names:
                data.append({"id": "local:" + name, "object": "model",
                             "owned_by": "ramalama"})
            base, key, _ = self._cloud_cfg(cfg)
            model = (cfg.get("cloud_model") or "").strip()
            if base and key and model:
                data.append({"id": "cloud:" + model, "object": "model",
                             "owned_by": "cloud"})
            return self._send_json(200, {"object": "list", "data": data})

        # Anything else is a provider endpoint (embeddings, etc.) — cloud only.
        base, key, wire = self._cloud_cfg(cfg)
        if not base or not key:
            return self._err(503, "cloud brain not configured")
        self._proxy("GET", upstream_url(base, self.path, wire),
                    auth_headers(key, wire), None, wire, False)

    # ── POST ─────────────────────────────────────────────────────────────────

    def do_POST(self):
        # Drain the request body FIRST — an early error must not leave unread
        # bytes in the keep-alive socket (they would desync the next request).
        length = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(length) if length else b""

        cfg = load_cfg()
        try:
            req = json.loads(raw) if raw else {}
        except Exception:
            req = {}
        if not isinstance(req, dict):
            req = {}

        brain, model = resolve(req.get("model", ""), cfg)
        if brain == "local":
            return self._to_local(req, model)
        return self._to_cloud(req, raw, model, cfg)

    def _to_local(self, req, model):
        error = ensure_local(model)
        if error:
            return self._err(503, error)
        # A real local chat just happened: refresh the idle clock so moai-idle keeps
        # the brain loaded while it is in use and only unloads it once you stop.
        mark_activity()
        body, streaming = b"", False
        if req:
            out = dict(req)
            # llama.cpp ignores this, but send something coherent rather than the
            # routing token: a proxy that forwards "local:qwen3" as a model name
            # is lying to whatever it is talking to.
            out["model"] = model or "default"
            streaming = bool(out.get("stream"))
            body = json.dumps(out).encode("utf-8")
        self._proxy("POST", LOCAL_BASE + self.path, {}, body, "openai", streaming)

    def _to_cloud(self, req, raw, model, cfg):
        base, key, wire = self._cloud_cfg(cfg)
        if not base or not key:
            return self._err(503,
                             "العقل السحابي غير مضبوط — أضف مزوّداً ومفتاحاً في إعدادات Mo AI.\n"
                             "The cloud brain is not configured — add a provider and an "
                             "API key in Mo AI's settings.")
        if wire == "anthropic":
            try:
                body, streaming = to_anthropic(raw, model)
            except Exception as e:
                return self._err(400, "could not translate the request: %s" % e)
        else:
            body, streaming = raw, False
            if req:
                out = dict(req)
                if model:
                    out["model"] = model
                streaming = bool(out.get("stream"))
                body = json.dumps(out).encode("utf-8")

        self._proxy("POST", upstream_url(base, self.path, wire),
                    auth_headers(key, wire), body, wire, streaming)

    # ── The pipe ─────────────────────────────────────────────────────────────

    def _proxy(self, method, url, headers, body, wire, streaming):
        req = urllib.request.Request(url, data=body, method=method)
        req.add_header("Content-Type", "application/json")
        req.add_header("User-Agent", USER_AGENT)     # or Cloudflare answers 403/1010
        for name, value in (headers or {}).items():
            req.add_header(name, value)
        try:
            up = urllib.request.urlopen(req, timeout=180)
        except urllib.error.HTTPError as e:
            return self._err(e.code, e.read().decode("utf-8", "replace"))
        except Exception as e:
            return self._err(502, "request failed: %s" % e)

        self.send_response(up.status)
        ctype = up.headers.get("Content-Type", "application/json")
        if wire == "anthropic":
            # We rewrite the body, so never echo the upstream content type.
            ctype = "text/event-stream" if streaming else "application/json"
        self.send_header("Content-Type", ctype)
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()

        def write(data):
            self.wfile.write(b"%X\r\n%s\r\n" % (len(data), data))
            self.wfile.flush()

        try:
            if wire == "anthropic":
                if streaming:
                    anthropic_stream_to_openai(up, write)
                else:
                    write(anthropic_whole_to_openai(up.read()))
            else:
                # Stream (SSE or plain) straight through. read1() returns as soon
                # as ANY bytes are available; read() would block until the buffer
                # fills, defeating live streaming.
                while True:
                    chunk = up.read1(65536)
                    if not chunk:
                        break
                    write(chunk)
            self.wfile.write(b"0\r\n\r\n")
        except Exception:
            pass

    def _send_json(self, code, obj):
        payload = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        try:
            self.wfile.write(payload)
        except Exception:
            pass

    def _err(self, code, msg):
        payload = json.dumps({"error": {"message": msg}},
                             ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Connection", "close")   # don't reuse a poisoned socket
        self.close_connection = True
        self.end_headers()
        try:
            self.wfile.write(payload)
        except Exception:
            pass


def main():
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    sys.stderr.write("moai-gateway: front door on 127.0.0.1:%d "
                     "(local brain: %s on 127.0.0.1:%d)\n"
                     % (PORT, LOCAL_UNIT, LOCAL_PORT))
    sys.stderr.flush()
    srv.serve_forever()


if __name__ == "__main__":
    main()
