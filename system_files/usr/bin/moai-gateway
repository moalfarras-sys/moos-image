#!/usr/bin/env python3
# moai-gateway — Mo AI's FRONT DOOR. One port, two brains, chosen PER REQUEST.
#
# WHY THIS EXISTS IN THIS SHAPE (read before you touch a port number)
#   Mo AI used to have a hard either/or. moai.service (RamaLama, the local brain)
#   and this gateway (the cloud proxy) BOTH listened on 8080, so only one of them
#   could ever run, and switching brain meant `systemctl disable --now` one and
#   `enable --now` the other — a global, service-bouncing setting buried in a
#   settings sheet. Choosing a brain per conversation was not possible at all.
#
#   Now there is one door:
#
#       8080   moai-gateway       ALWAYS ON. The app's only front door.
#       8081   moai.service       RamaLama fallback, started on demand.
#      11434   ollama/moai-brain  Ollama engine, when selected, on demand.
#
#   The app still speaks exactly ONE dialect — OpenAI /v1/chat/completions with
#   SSE deltas — and still never sees the API key. What is new is that it may say
#   WHICH brain it wants, in the request's `model` field:
#
#   ┌─ THE ROUTING CONTRACT ───────────────────────────────────────────────────┐
#   │  "local"              → the local brain, whatever model it is serving     │
#   │  "local:<model>"      → the local brain, serving <model>                  │
#   │  "cloud"              → the configured provider + its configured model    │
#   │  "cloud:<model-id>"   → the configured provider, <model-id> upstream      │
#   │  absent / anything    → the default in ~/.config/moai/config.json         │
#   │                         (mode=local|cloud) — the pre-split behaviour, so   │
#   │                         an older client keeps working unchanged.           │
#   └──────────────────────────────────────────────────────────────────────────┘
#
#   The split is on the FIRST colon, so a model id may contain colons of its own
#   ("local:qwen3:4b" → local, "qwen3:4b").
#
# WHY THE TWO LOCAL ENGINES SWITCH DIFFERENTLY
#   Ollama honours the request's model, so its selected tag is passed through
#   directly and the unit is never restarted. RamaLama serves llama.cpp, which
#   IGNORES that field (verified with a deliberately made-up model name), so its
#   unit must be repointed and restarted. Both paths accept only models already
#   present locally: a chat message must never begin a multi-gigabyte download
#   behind the user's back.
#
# WIRE PROTOCOLS (the cloud side, unchanged)
#   openai     — OpenAI, OpenRouter, Google Gemini (its OpenAI-compatible
#                endpoint), Groq, Together, a local vLLM, and any private
#                OpenAI-compatible gateway. Passed through almost untouched.
#   anthropic  — Claude's NATIVE API (/v1/messages). A genuinely different shape:
#                the system prompt is a top-level field, max_tokens is required,
#                auth is x-api-key, and the stream is content_block_delta events.
#                Translated in both directions here so the app stays unchanged.
#
# This process is the only thing that ever sees the API key: it reads the provider
# (base URL + model + wire) from ~/.config/moai/config.json and the KEY from Mo
# AI's private XDG data store. Stdlib only (no pip deps).
import json, os, re, socket, subprocess, sys, threading, time
import urllib.error, urllib.parse, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONFIG = os.path.expanduser("~/.config/moai/config.json")
MOOS_DIR = os.path.expanduser("~/.config/moos")
ENV_FILE = os.path.join(MOOS_DIR, "moai.env")
CREDENTIAL_STORE = os.environ.get(
    "MOAI_CREDENTIAL_STORE", "/usr/libexec/moai-credential-store")
OPENCLAW_CONFIG = os.path.expanduser("~/.openclaw/openclaw.json")
OPENCLAW_BIN = os.path.expanduser("~/.local/bin/openclaw")
OPENCLAW_HOST = "127.0.0.1"
OPENCLAW_PORT = int(os.environ.get("MOAI_OPENCLAW_PORT", "18789"))
OPENCLAW_BASE = "http://%s:%d" % (OPENCLAW_HOST, OPENCLAW_PORT)

PORT = int(os.environ.get("MOAI_GATEWAY_PORT", "8080"))
RAMALAMA_UNIT = "moai.service"
OLLAMA_UNITS = ("ollama.service", "moai-brain.service")
ALLOWED_LOCAL_UNITS = (RAMALAMA_UNIT, *OLLAMA_UNITS)
_requested_local_unit = os.environ.get("MOAI_LOCAL_UNIT", RAMALAMA_UNIT)
LOCAL_UNIT = (_requested_local_unit if _requested_local_unit in ALLOWED_LOCAL_UNITS
              else RAMALAMA_UNIT)
_derived_backend = "ollama" if LOCAL_UNIT in OLLAMA_UNITS else "ramalama"
_requested_backend = os.environ.get("MOAI_LOCAL_BACKEND", _derived_backend)
LOCAL_BACKEND = (_requested_backend
                 if _requested_backend in ("ollama", "ramalama")
                 and _requested_backend == _derived_backend
                 else _derived_backend)
try:
    LOCAL_PORT = int(os.environ.get(
        "MOAI_LOCAL_PORT", "11434" if LOCAL_BACKEND == "ollama" else "8081"))
except (TypeError, ValueError):
    LOCAL_PORT = 11434 if LOCAL_BACKEND == "ollama" else 8081
LOCAL_BASE = "http://127.0.0.1:%d" % LOCAL_PORT

# The gateway is the one process that sees every local chat, so it stamps the time of
# the last one here. moai-idle.timer reads this file's mtime and stops the local brain
# once it goes stale, freeing ~6 GB of VRAM — otherwise the model sits in the GPU forever
# and starves the compositor (a maximised browser on top of a loaded brain has crashed
# kwin_wayland with NVRM: invalid mmap context and frozen the desktop). ensure_local()
# brings the brain back on the next request, so unloading it while idle costs only a reload.
ACTIVITY_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % os.getuid()),
    "moai-activity")


def mark_activity() -> None:
    """Record that the local brain was just used, for moai-idle's staleness check."""
    try:
        tmp = ACTIVITY_FILE + ".tmp"
        with open(tmp, "w") as handle:
            handle.write(str(int(time.time())))
        os.replace(tmp, ACTIVITY_FILE)
    except OSError:
        pass

# How long to wait for the local brain after starting it. A model that is already
# pulled loads in well under a minute; the FIRST ever start downloads ~2.5 GB and
# can take far longer than any HTTP request should be held open, which is why the
# timeout answers with an instruction instead of hanging forever.
LOCAL_TIMEOUT = float(os.environ.get("MOAI_LOCAL_TIMEOUT", "180"))

# Must stay in step with Environment=MOAI_MODEL in moai.service. This is only the
# fallback: ~/.config/moos/moai.env is an EnvironmentFile and therefore OUTRANKS
# the unit's Environment=, so env_model() reads the file that actually decides.
DEFAULT_LOCAL_MODEL = os.environ.get(
    "MOAI_LOCAL_MODEL",
    "default" if LOCAL_BACKEND == "ollama" else "ollama://qwen2.5:7b-instruct")

# Identify ourselves. Python's urllib defaults to "Python-urllib/3.x", and
# Cloudflare — which fronts a large share of AI providers — answers that with
# HTTP 403 "error code: 1010" before the request ever reaches the API. The
# shipped gateway sent the default and therefore could not reach ANY
# Cloudflare-fronted provider; the cloud brain was configurable and dead.
USER_AGENT = "MoOS-MoAI/1.0 (+https://github.com/moalfarras-sys/moos-image)"

ANTHROPIC_VERSION = "2023-06-01"
DEFAULT_MAX_TOKENS = 2048
MAX_BODY_BYTES = 20 * 1024 * 1024

# A base URL is expected to carry its API version ("…/v1", "…/v1beta/openai").
VERSIONED = re.compile(r"/v\d[\w.]*(/|$)")

# "ollama://library/qwen3:4b" — strip the transport, keep the name.
SCHEME = re.compile(r"^[a-z0-9+.-]+://")


def load_cfg() -> dict:
    """Load the legacy Mo AI gateway configuration if it exists."""
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def load_product_cfg():
    """Merge the shared OpenClaw settings over the legacy gateway fallback.

    Mo AI Settings and phone channels own one OpenClaw configuration. Older
    installations may still have ~/.config/moai/config.json and the credential
    helper, so those remain fallback-only instead of becoming a second truth.
    """
    merged = dict(load_cfg())
    try:
        with open(OPENCLAW_CONFIG, encoding="utf-8") as handle:
            oc = json.load(handle)
        providers = ((oc.get("models") or {}).get("providers") or {})
        cloud = providers.get("cloud") or {}
        defaults = (oc.get("agents") or {}).get("defaults") or {}
        primary = str(((defaults.get("model") or {}).get("primary") or ""))
        base = str(cloud.get("baseUrl") or "").rstrip("/")
        key = str(cloud.get("apiKey") or "")
        model = primary.removeprefix("cloud/") if primary.startswith("cloud/") else ""
        if not model:
            catalog = cloud.get("models") or []
            if isinstance(catalog, list) and catalog and isinstance(catalog[0], dict):
                model = str(catalog[0].get("id") or "")
        api = str(cloud.get("api") or "").lower()
        if base:
            merged["cloud_base"] = base
        if key:
            merged["cloud_key"] = key
        if model:
            merged["cloud_model"] = model
        if api:
            merged["cloud_wire"] = "anthropic" if api.startswith("anthropic") else "openai"
        if primary == "moai/hybrid":
            merged["mode"] = "hybrid"
        elif primary.startswith("cloud/"):
            merged["mode"] = "cloud"
        elif primary.startswith("ollama/"):
            merged["mode"] = "local"
    except Exception:
        pass
    return merged


def load_secret() -> str:
    """Retrieve the legacy cloud API key from the local credential store."""
    try:
        result = subprocess.run(
            [CREDENTIAL_STORE, "get"], capture_output=True, text=True,
            timeout=10, check=False)
        return result.stdout.rstrip("\n") if result.returncode == 0 else ""
    except Exception:
        return ""


def load_openclaw_client():
    """Return private desktop-client material without ever exposing the token."""
    try:
        with open(OPENCLAW_CONFIG, encoding="utf-8") as handle:
            cfg = json.load(handle)
        gateway = cfg.get("gateway") or {}
        auth = gateway.get("auth") or {}
        endpoint = ((((gateway.get("http") or {}).get("endpoints") or {})
                     .get("chatCompletions") or {}))
        token = str(auth.get("token") or "")
        enabled = endpoint.get("enabled") is True
        providers = ((cfg.get("models") or {}).get("providers") or {})
        primary = str(((((cfg.get("agents") or {}).get("defaults") or {})
                        .get("model") or {}).get("primary") or ""))
        if auth.get("mode") != "token" or not token or not enabled:
            return {}
        return {"token": token, "providers": providers, "primary": primary}
    except Exception:
        return {}


def ensure_openclaw_gateway(timeout=45.0):
    """Wake the fixed user service and prove its loopback listener is ready."""
    try:
        subprocess.run(["systemctl", "--user", "start", "openclaw-gateway.service"],
                       capture_output=True, text=True, timeout=timeout, check=False)
    except Exception as exc:
        return "could not start OpenClaw: %s" % exc
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with socket.create_connection((OPENCLAW_HOST, OPENCLAW_PORT), timeout=0.5):
                return ""
        except OSError:
            time.sleep(0.25)
    return "OpenClaw gateway did not become ready"


def openclaw_model(client, brain, model, cfg):
    """Map Mo AI's route to an actually configured OpenClaw provider model."""
    provider = "ollama" if brain == "local" else "cloud"
    node = client.get("providers", {}).get(provider) or {}
    catalog = [str(item.get("id") or "") for item in node.get("models", [])
               if isinstance(item, dict) and item.get("id")]
    requested = str(model or "").strip()
    if requested and not re.fullmatch(r"[A-Za-z0-9._:+/-]{1,200}", requested):
        return ""
    if brain == "cloud" and not requested:
        requested = str(cfg.get("cloud_model") or "").strip()
    if requested and requested in catalog:
        return provider + "/" + requested
    # Ollama is discovered dynamically by OpenClaw (`/api/show` supplies the
    # real input/tool/thinking capabilities). Mo AI's picker may therefore name
    # a pulled model that isn't in the small persisted bootstrap catalog. The
    # following ensure_local() call proves the tag exists before any request is
    # forwarded; cloud ids stay catalog-only because their inventory/auth is a
    # different trust boundary.
    if brain == "local" and requested and node.get("baseUrl"):
        return provider + "/" + requested
    primary = str(client.get("primary") or "")
    if primary.startswith(provider + "/"):
        return primary
    if catalog:
        return provider + "/" + catalog[0]
    return ""


# ── The local brain ──────────────────────────────────────────────────────────

def short_model(name: str) -> str:
    """`ollama://library/qwen3:4b` → `qwen3:4b`.

    RamaLama normalises `ollama://qwen3:4b` to `ollama://library/qwen3:4b`, so the
    string in moai.env and the string in `ramalama list` name the same weights and
    do not match. Compare the short form, or every request would look like a
    request to switch models and pointlessly restart the unit.
    """
    n = SCHEME.sub("", (name or "").strip())
    if n.startswith("library/"):
        n = n[len("library/"):]
    return n


def comparable_model(name: str) -> str:
    """Normalize a model name to its base alphanumeric identity for comparisons."""
    name = short_model(name)
    return name[:-len(":latest")] if name.endswith(":latest") else name


def same_model(left: str, right: str) -> bool:
    """Check if two model identifiers refer to the same base model."""
    return comparable_model(left) == comparable_model(right)


def env_model() -> str:
    """The model the local unit will ACTUALLY serve.

    moai.env is the unit's EnvironmentFile, so it outranks the unit's own
    Environment= line. Reading the shipped default here instead of this file is
    the exact mistake that let a stale moai.env keep the local brain on 8080.
    """
    if LOCAL_BACKEND == "ollama":
        # Ollama honours the request model.  moai.env is RamaLama's private
        # EnvironmentFile and must never cause an Ollama service restart.
        return DEFAULT_LOCAL_MODEL
    try:
        with open(ENV_FILE, encoding="utf-8") as f:
            for line in f:
                if line.startswith("MOAI_MODEL="):
                    value = line.split("=", 1)[1].strip()
                    if value:
                        return value
    except Exception:
        pass
    return DEFAULT_LOCAL_MODEL


def env_port() -> "int | None":
    """The port the local unit will ACTUALLY bind, or None if the file says nothing.

    Same trap as env_model(), and it is the one that actually bit: moai.env is the
    unit's EnvironmentFile, and systemd applies an EnvironmentFile AFTER the unit's
    own Environment= lines — so this file wins. A moai.env left over from the old
    single-port layout still says MOAI_PORT=8080.
    """
    if LOCAL_BACKEND == "ollama":
        return LOCAL_PORT
    try:
        with open(ENV_FILE, encoding="utf-8") as f:
            for line in f:
                if line.startswith("MOAI_PORT="):
                    return int(line.split("=", 1)[1].strip())
    except Exception:
        pass
    return None


def set_env_model(model: str) -> None:
    """Point the local unit at `model`.

    The port is rewritten too, and never taken from the old file: 8080 is the
    gateway's and a rewrite that carried a stale MOAI_PORT forward would put the
    local brain back on top of the front door.
    """
    if LOCAL_BACKEND != "ramalama":
        raise RuntimeError("moai.env belongs to RamaLama")
    os.makedirs(MOOS_DIR, exist_ok=True)
    os.chmod(MOOS_DIR, 0o700)
    tmp = ENV_FILE + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("MOAI_PORT=%d\nMOAI_MODEL=%s\n" % (LOCAL_PORT, model))
    os.chmod(tmp, 0o600)
    os.replace(tmp, ENV_FILE)


_pulled_lock = threading.Lock()
_pulled_cache = {"names": [], "ts": 0.0}
PULLED_TTL = 30.0


def pulled_models() -> "list[str]":
    """The models the selected engine has already downloaded."""
    with _pulled_lock:
        if _pulled_cache["names"] and time.monotonic() - _pulled_cache["ts"] < PULLED_TTL:
            return list(_pulled_cache["names"])
    names = []
    try:
        if LOCAL_BACKEND == "ollama":
            with urllib.request.urlopen(LOCAL_BASE + "/api/tags", timeout=12) as response:
                data = json.loads(response.read().decode("utf-8", "replace"))
            items = data.get("models", []) if isinstance(data, dict) else []
            for item in items:
                name = (item.get("name") or item.get("model") or "").strip()
                if name:
                    names.append(name)
        else:
            result = subprocess.run(["ramalama", "list", "--json"],
                                    capture_output=True, text=True, timeout=25, check=False)
            if result.returncode == 0:
                for item in json.loads(result.stdout or "[]"):
                    name = (item.get("name") or "").strip()
                    if name:
                        names.append(name)
    except Exception:
        pass
    with _pulled_lock:
        _pulled_cache["names"] = list(names)
        _pulled_cache["ts"] = time.monotonic()
    return names


def local_online(timeout=1.5):
    try:
        with urllib.request.urlopen(LOCAL_BASE + "/v1/models", timeout=timeout) as r:
            return r.status == 200
    except Exception:
        return False


# ── Why the brain did not come up ────────────────────────────────────────────
# Everything below exists because the failure message lied. When the brain does not
# answer, the gateway told the user "the first start downloads the model (~2.5 GB) and
# keeps going in the background" — the ONE message it had. It says that when the disk is
# full, when there is no network to download from, and when llama-server aborted on this
# very machine because the GPU had no memory left (SIGABRT, 2026-07-13). The user waits
# for a download that is not happening.
#
# So: check what can be checked BEFORE starting, and when it fails anyway, read the
# service's own log and say what it said.
MODEL_BYTES = 3 * 1024 ** 3   # a ~2.5 GB model plus room for RamaLama's staging copy.


def disk_free(path="/var"):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize
    except OSError:
        return -1


def gb(n):
    return "%.1f GB" % (n / 1024 ** 3)


def have_network(timeout=2.0):
    """Can we reach what a first-run local pull actually needs? A pull fetches BOTH
    the model (Ollama registry / Hugging Face) AND the RamaLama runtime container
    (quay.io / ghcr.io). The old check probed only the model registry, so a machine
    that could reach Hugging Face but not quay.io passed preflight and then failed
    the container pull with a misleading 'model' error. A loaded brain needs none of
    this (preflight_local() already short-circuits when the model is present)."""
    def reachable(*hosts):
        for h in hosts:
            try:
                socket.create_connection((h, 443), timeout=timeout).close()
                return True
            except OSError:
                continue
        return False
    return reachable("registry.ollama.ai", "huggingface.co") \
        and reachable("quay.io", "ghcr.io")


def preflight_local(target):
    """Refuse a start that cannot possibly work, and say why. "" = go ahead."""
    if target and target in pulled_models():
        return ""                      # already downloaded: no disk, no network needed
    free = disk_free()
    if 0 <= free < MODEL_BYTES:
        return ("لا تكفي المساحة لتنزيل النموذج: متاح %s، ويلزم نحو %s.\n"
                "فرّغ مساحة (جرّب: moai-do optimize) ثم أعد المحاولة.\n"
                "Not enough disk space to download the model: %s free, ~%s needed. "
                "Free some space (try: moai-do optimize) and ask again."
                % (gb(free), gb(MODEL_BYTES), gb(free), gb(MODEL_BYTES)))
    if not have_network():
        return ("النموذج غير محمّل ولا يوجد اتصال بالإنترنت لتنزيله.\n"
                "وصّل الإنترنت، أو اسأل العقل السحابي.\n"
                "The model is not downloaded and there is no internet connection to "
                "fetch it. Connect to the network, or ask the cloud brain instead.")
    return ""


# What the service says when it dies, mapped to what the user can do about it. Ordered:
# the first match wins, so the specific signatures come before the generic ones.
FAILURE_SIGNS = [
    (("out of memory", "cudamalloc", "failed to allocate", "cuda error", "vram"),
     "ذاكرة كرت الشاشة لا تكفي لتحميل النموذج الآن.\n"
     "أغلق تطبيقاً ثقيلاً (متصفّح/لعبة) ثم أعد المحاولة — MoOS يفرّغ العقل تلقائياً عند الخمول.\n"
     "The GPU ran out of memory loading the model. Close a heavy app (a browser or a "
     "game) and ask again — MoOS unloads the brain automatically when it goes idle."),
    (("no space left", "enospc", "disk full"),
     "امتلأت المساحة أثناء تحميل النموذج.\n"
     "فرّغ مساحة (moai-do optimize) ثم أعد المحاولة.\n"
     "The disk filled up while loading the model. Free some space (moai-do optimize)."),
    (("name resolution", "could not resolve", "connection refused", "network is unreachable",
      "temporary failure", "timed out"),
     "انقطع الاتصال أثناء جلب النموذج.\n"
     "تحقّق من الإنترنت ثم أعد المحاولة.\n"
     "The connection dropped while fetching the model. Check the network and retry."),
    (("no such file", "not found", "manifest unknown"),
     "النموذج غير موجود في السجل.\n"
     "The model was not found in the registry. Pick another model in Settings."),
]


def local_failure_reason():
    """Ask the SERVICE why it is not up. "" when it is simply still working."""
    try:
        state = subprocess.run(["systemctl", "--user", "is-active", LOCAL_UNIT],
                               capture_output=True, text=True, timeout=10, check=False)
        active = (state.stdout or "").strip()
    except Exception:
        return ""
    # "activating" is a unit still coming up (RamaLama pulls a model before it serves), and
    # calling that a failure would turn every slow first start into a false alarm. Only a
    # unit that is DOWN gets diagnosed.
    if active in ("active", "activating", "reloading"):
        return ""                      # up (or coming up) but not answering yet — a slow load

    try:
        log = subprocess.run(
            ["journalctl", "--user", "-u", LOCAL_UNIT, "-n", "40", "--no-pager"],
            capture_output=True, text=True, timeout=15, check=False)
        text = (log.stdout or "").lower()
    except Exception:
        log, text = None, ""

    for needles, message in FAILURE_SIGNS:
        if any(n in text for n in needles):
            return message

    # The last line is usually systemd's own bookkeeping ("Consumed 652ms CPU time…"),
    # which tells the user nothing. Prefer the last thing the SERVICE said.
    lines = [l.strip() for l in ((log.stdout if log else "") or "").splitlines() if l.strip()]
    spoken = [l for l in lines if "systemd[" not in l]
    tail = (spoken or lines or [""])[-1]
    return ("توقّف العقل المحلي (%s) ولم يبدأ.\n"
            "آخر ما قاله: %s\n"
            "The local brain is %s and did not start. Last log line: %s"
            % (active or "inactive", tail or "—", active or "inactive", tail or "—"))


def systemctl(verb):
    try:
        result = subprocess.run(["systemctl", "--user", verb, LOCAL_UNIT],
                                capture_output=True, text=True, timeout=60, check=False)
    except Exception as e:
        return "systemctl --user %s %s: %s" % (verb, LOCAL_UNIT, e)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()[:200]
        return "systemctl --user %s %s: %s" % (verb, LOCAL_UNIT, detail)
    return ""


_local_lock = threading.Lock()


def ensure_local(want: str) -> str:
    """Bring the local brain up, serving `want` ("" = whatever it already serves).

    Returns "" on success, or a message meant for the user. Serialised: two chats
    that both wake the brain must not race two `systemctl start`s at it, and the
    second one should wait for the first rather than start a parallel download.
    """
    with _local_lock:
        if LOCAL_BACKEND == "ollama":
            target = short_model(want) or short_model(DEFAULT_LOCAL_MODEL)

            # Starting Ollama loads no model by itself.  It is safe to wake the
            # server, then verify the requested tag is already present before
            # forwarding the chat.  A chat message never starts a download.
            if not local_online():
                error = systemctl("start")
                if error:
                    return ("تعذّر تشغيل العقل المحلي | could not start the local brain\n"
                            + error)
                deadline = time.monotonic() + LOCAL_TIMEOUT
                while time.monotonic() < deadline and not local_online():
                    reason = local_failure_reason()
                    if reason:
                        return reason
                    time.sleep(1.0)
                if not local_online():
                    return ("العقل المحلي لم يبدأ | the local model server did not start")

            installed = pulled_models()
            if target and not any(same_model(target, name) for name in installed):
                return ("النموذج «%s» غير محمّل على هذا الجهاز.\n"
                        "نزّله من Mo AI ← الإعدادات ← النماذج.\n"
                        "The local model \"%s\" is not downloaded. Download it from "
                        "Mo AI → Settings → Models." % (target, target))
            return ""

        current = env_model()
        switching = bool(want) and short_model(want) != short_model(current)

        # Reconcile the PORT on every start, not only when the model changes.
        #
        # This is the bug that made the very first `local` request fail. moai.env is
        # the unit's EnvironmentFile and therefore outranks the unit's own
        # Environment=MOAI_PORT=8081. A file written under the old single-port layout
        # still says 8080. Rewriting it only on the model-switch path meant the plain
        # "local" path started the brain with the STALE port — so RamaLama bound the
        # wrong one, this gateway polled 8081, found nothing, and timed out after
        # three minutes with the model loaded and sitting idle. Measured, exactly
        # that: the unit went active, the model loaded, and the chat returned 502.
        stale_port = env_port() != LOCAL_PORT

        if not switching and not stale_port and local_online():
            return ""

        target = current
        if switching:
            target = ""
            for name in pulled_models():
                if short_model(name) == short_model(want):
                    target = name
                    break
            if not target:
                # Never start a multi-gigabyte download from a chat message.
                return ("النموذج «%s» غير محمّل على هذا الجهاز.\n"
                        "The local model \"%s\" is not downloaded. Pull it first:\n"
                        "    ramalama pull %s" % (want, want, want))

        # Do not start something that cannot succeed: no disk for the download, or no
        # network to download from. Both used to fail deep inside RamaLama and surface
        # as "the model is downloading in the background", which was a lie.
        blocked = preflight_local(target)
        if blocked:
            return blocked

        if switching or stale_port:
            # A running brain on the wrong port has to be restarted, not started:
            # systemd will not re-read the EnvironmentFile for a unit it considers
            # already up.
            set_env_model(target)
            error = systemctl("restart")
        else:
            error = systemctl("start")
        if error:
            return ("تعذّر تشغيل العقل المحلي | could not start the local brain\n"
                    + error)

        deadline = time.monotonic() + LOCAL_TIMEOUT
        next_check = time.monotonic() + 6.0
        while time.monotonic() < deadline:
            if local_online():
                return ""
            # The unit dying is not the same as the unit being slow, and only one of the
            # two is worth waiting out. Ask the service; if it is DOWN, say what killed it
            # (GPU memory, disk, network) instead of waiting the full timeout and blaming a
            # download that already failed. Every 6 s — this shells out twice, and the
            # answer cannot change faster than the unit can.
            if time.monotonic() >= next_check:
                reason = local_failure_reason()
                if reason:
                    return reason
                next_check = time.monotonic() + 6.0
            time.sleep(1.5)
        return ("العقل المحلي لم يجب خلال %d ثانية — أول تشغيل يحمّل النموذج (~2.5GB) "
                "ويكمل في الخلفية.\n"
                "The local brain did not answer within %ds. The first start downloads "
                "the model (~2.5 GB) and keeps going in the background — watch it with "
                "`moai-start logs`, then ask again."
                % (int(LOCAL_TIMEOUT), int(LOCAL_TIMEOUT)))


# ── Routing ──────────────────────────────────────────────────────────────────

def parse_model(field):
    """The request's `model` field → (brain, model). ("", "") means: use the default."""
    raw = (field or "").strip()
    low = raw.lower()
    if low == "local":
        return "local", ""
    if low.startswith("local:"):
        return "local", raw.split(":", 1)[1].strip()
    if low == "cloud":
        return "cloud", ""
    if low.startswith("cloud:"):
        return "cloud", raw.split(":", 1)[1].strip()
    if low == "hybrid":
        return "hybrid", ""
    if low.startswith("hybrid:"):
        return "hybrid", raw.split(":", 1)[1].strip()
    return "", ""


def resolve(field, cfg):
    """(brain, model) for this request, falling back to the configured default."""
    brain, model = parse_model(field)
    if not brain:
        mode = cfg.get("mode")
        brain = mode if mode in ("local", "cloud", "hybrid") else "local"
        model = ""
    if brain == "cloud" and not model:
        model = cfg.get("cloud_model") or ""
    return brain, model


def _request_text(req):
    chunks = []
    for message in req.get("messages", []) if isinstance(req, dict) else []:
        content = message.get("content", "") if isinstance(message, dict) else ""
        if isinstance(content, str):
            chunks.append(content)
        elif isinstance(content, list):
            for part in content:
                if isinstance(part, dict) and isinstance(part.get("text"), str):
                    chunks.append(part["text"])
    return "\n".join(chunks)


def _has_private_attachment(req):
    for message in req.get("messages", []) if isinstance(req, dict) else []:
        content = message.get("content", []) if isinstance(message, dict) else []
        if not isinstance(content, list):
            continue
        for part in content:
            if isinstance(part, dict) and str(part.get("type") or "").lower() in {
                "image", "image_url", "input_image", "file", "input_file"
            }:
                return True
    return False


_network_cache = {"base": "", "at": 0.0, "available": False}


def cloud_network_available(base):
    """Cheap cached reachability check used before Hybrid chooses cloud."""
    now = time.monotonic()
    if _network_cache["base"] == base and now - _network_cache["at"] < 10:
        return _network_cache["available"]
    try:
        parsed = urllib.parse.urlsplit(base)
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        with socket.create_connection((parsed.hostname, port), timeout=0.6):
            available = True
    except Exception:
        available = False
    _network_cache.update({"base": base, "at": now, "available": available})
    return available


def choose_hybrid(req, cfg, check_network=True):
    """Return (route, reason, may_fallback_to_cloud) for a Hybrid request."""
    meta = req.get("moai") if isinstance(req.get("moai"), dict) else {}
    privacy = str(meta.get("privacy") or "standard").lower()
    attachment = _has_private_attachment(req)
    if privacy in {"local", "private", "confidential"}:
        return "local", "privacy", False
    if attachment and meta.get("allow_cloud_attachments") is not True:
        return "local", "private-attachment", False

    base = str(cfg.get("cloud_base") or "").rstrip("/")
    has_cloud = bool(base and cfg.get("cloud_key"))
    if not has_cloud:
        return "local", "cloud-not-configured", False
    if check_network and not cloud_network_available(base):
        return "local", "cloud-offline", False

    text = _request_text(req)
    lowered = text.casefold()
    difficult = len(text) >= 2400 or any(token in lowered for token in (
        "```", "refactor", "debug", "architecture", "research", "analyze project",
        "إعادة هيكلة", "حلّل المشروع", "ابحث", "خطّة كاملة",
    ))
    if str(meta.get("prefer") or "").lower() == "cloud" or difficult:
        return "cloud", "complex-task", True
    return "local", "fast-private-default", True


def upstream_url(base, path, wire):
    """Map the app's /v1/<endpoint> onto the provider's base URL."""
    b = base.rstrip("/")
    if not VERSIONED.search(b):
        # A bare host was pasted. Add the conventional version segment so it
        # still works rather than 404ing on the user.
        b += "/v1"
    endpoint = path[len("/v1"):] if path.startswith("/v1/") else path
    if wire == "anthropic":
        # Claude has no /chat/completions.
        return b + ("/messages" if endpoint.startswith("/chat/completions") else endpoint)
    return b + endpoint


def auth_headers(key, wire):
    if wire == "anthropic":
        return {"x-api-key": key, "anthropic-version": ANTHROPIC_VERSION}
    return {"Authorization": "Bearer " + key}


# ── OpenAI → Anthropic, and back ─────────────────────────────────────────────

def to_anthropic(body, model):
    """Rewrite an OpenAI chat/completions request as an Anthropic /v1/messages one.

    Returns (body, streaming).
    """
    req = json.loads(body)
    system_parts, messages = [], []
    for m in req.get("messages", []):
        role, content = m.get("role"), m.get("content") or ""
        if role == "system":
            system_parts.append(content)       # Anthropic takes system separately
        elif role in ("user", "assistant"):
            messages.append({"role": role, "content": content})
    streaming = bool(req.get("stream"))
    out = {
        "model": model or req.get("model") or "",
        # Required by Anthropic — OpenAI treats it as optional, so supply a default.
        "max_tokens": req.get("max_tokens") or DEFAULT_MAX_TOKENS,
        "messages": messages,
        "stream": streaming,
    }
    if system_parts:
        out["system"] = "\n\n".join(system_parts)
    return json.dumps(out).encode("utf-8"), streaming


def anthropic_chunk(text):
    """Wrap a text delta in the chat.completion.chunk shape the app parses."""
    return b"data: " + json.dumps({
        "object": "chat.completion.chunk",
        "choices": [{"index": 0, "delta": {"content": text}, "finish_reason": None}],
    }).encode("utf-8") + b"\n\n"


def anthropic_stream_to_openai(upstream, write):
    """Translate Anthropic's SSE events into OpenAI chunks, live.

    Anthropic emits `event: content_block_delta` with
    {"delta": {"type": "text_delta", "text": "…"}}. The app only understands
    choices[0].delta.content, so rewrite each delta as it arrives — buffering the
    whole reply first would throw away the streaming the UI is built around.
    """
    buf = b""
    while True:
        chunk = upstream.read1(65536)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            line = line.strip()
            if not line.startswith(b"data:"):
                continue
            payload = line[5:].strip()
            if not payload:
                continue
            try:
                ev = json.loads(payload)
            except Exception:
                continue
            if ev.get("type") == "content_block_delta":
                text = (ev.get("delta") or {}).get("text") or ""
                if text:
                    write(anthropic_chunk(text))
            elif ev.get("type") == "error":
                # Anthropic sends {"type":"error","error":{...}} AFTER the 200 begins
                # (overloaded_error, rate_limit). With no branch here it was ignored and
                # the loop ended in a clean [DONE], so an error looked identical to a
                # finished — but blank — reply. Surface it as visible text, then end.
                msg = (ev.get("error") or {}).get("message") or "the model returned an error"
                write(anthropic_chunk(f"\n\n⚠️ {msg}"))
                write(b"data: [DONE]\n\n")
                return
            elif ev.get("type") == "message_stop":
                write(b"data: [DONE]\n\n")
                return
    # The loop ended on EOF without a message_stop: a truncated stream. Say so rather than
    # presenting a half-answer as a complete reply.
    write(anthropic_chunk("\n\n⚠️ the reply ended early"))
    write(b"data: [DONE]\n\n")


def anthropic_whole_to_openai(raw):
    """Non-streamed Anthropic reply → an OpenAI chat.completion."""
    try:
        msg = json.loads(raw)
        text = "".join(b.get("text") or "" for b in msg.get("content", [])
                       if b.get("type") == "text")
    except Exception:
        text = ""
    return json.dumps({
        "object": "chat.completion",
        "choices": [{"index": 0, "message": {"role": "assistant", "content": text},
                     "finish_reason": "stop"}],
    }).encode("utf-8")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):  # keep the journal quiet
        pass

    def _cloud_cfg(self, cfg):
        return ((cfg.get("cloud_base") or "").rstrip("/"),
                cfg.get("cloud_key") or load_secret(),
                (cfg.get("cloud_wire") or "openai").lower())

    def _foreign_origin(self):
        origin = self.headers.get("Origin")
        if not origin:
            return False
        try:
            parsed = urllib.parse.urlsplit(origin)
            port = parsed.port
        except ValueError:
            return True
        expected_port = getattr(self.server, "server_port", PORT)
        return not (
            parsed.scheme == "http"
            and parsed.hostname in ("127.0.0.1", "localhost", "::1")
            and port == expected_port
            and parsed.username is None
            and parsed.password is None
            and not parsed.path
            and not parsed.query
            and not parsed.fragment
        )

    # ── GET ──────────────────────────────────────────────────────────────────

    def do_GET(self):
        if self._foreign_origin():
            return self._err(403, "foreign origin")
        cfg = load_product_cfg()

        # The liveness probe. Cheap on purpose — moai-control polls it every few
        # seconds and must never make it reach out to a provider to answer.
        if self.path.startswith("/healthz"):
            return self._send_json(200, {
                "ok": True,
                "service": "moai-gateway",
                "port": PORT,
                "local_port": LOCAL_PORT,
                "local_unit": LOCAL_UNIT,
                "default_mode": (cfg.get("mode")
                                 if cfg.get("mode") in ("local", "cloud", "hybrid")
                                 else "local"),
            })

        # What this door will actually route. Every id here is a real route; a
        # `cloud:<id>` for any other model the provider knows is accepted too —
        # moai-control's /models asks the provider for that list.
        if self.path.startswith("/v1/models"):
            data = [
                {"id": "default", "object": "model", "owned_by": "moos"},
                {"id": "hybrid", "object": "model", "owned_by": "moos"},
            ]
            names = [short_model(n) for n in pulled_models()]
            for name in names:
                data.append({"id": "local:" + name, "object": "model",
                             "owned_by": LOCAL_BACKEND})
            base, key, _ = self._cloud_cfg(cfg)
            model = (cfg.get("cloud_model") or "").strip()
            if base and key and model:
                data.append({"id": "cloud:" + model, "object": "model",
                             "owned_by": "cloud"})
            return self._send_json(200, {"object": "list", "data": data})

        # Anything else is a provider endpoint (embeddings, etc.) — cloud only.
        base, key, wire = self._cloud_cfg(cfg)
        if not base or not key:
            return self._err(503, "cloud brain not configured")
        self._proxy("GET", upstream_url(base, self.path, wire),
                    auth_headers(key, wire), None, wire, False)

    # ── POST ─────────────────────────────────────────────────────────────────

    def do_POST(self):
        if self._foreign_origin():
            return self._err(403, "foreign origin")
        media_type = self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if media_type != "application/json":
            return self._err(415, "content type must be application/json")
        if self.headers.get("Transfer-Encoding"):
            return self._err(400, "transfer encoding is not supported")

        # Once the headers pass, drain the body in one bounded-by-Content-Length
        # read.  Header rejections close the connection in _err(), so their
        # unread bytes can never desynchronise a keep-alive socket.
        lengths = self.headers.get_all("Content-Length") or []
        if len(lengths) != 1:
            return self._err(411, "one content length is required")
        try:
            length = int(lengths[0])
            if length < 0:
                raise ValueError
        except (TypeError, ValueError):
            return self._err(400, "bad content length")
        if length > MAX_BODY_BYTES:
            return self._err(413, "request body too large")
        raw = self.rfile.read(length) if length else b""

        cfg = load_product_cfg()
        try:
            req = json.loads(raw)
        except Exception:
            return self._err(400, "bad json")
        if not isinstance(req, dict):
            return self._err(400, "json body must be an object")

        self.moai_route = ""
        self.moai_route_reason = ""
        self.moai_agent = ""
        meta = req.get("moai") if isinstance(req.get("moai"), dict) else {}
        wants_agent = meta.get("agent") is True
        brain, model = resolve(req.get("model", ""), cfg)
        if brain == "hybrid":
            brain, reason, may_fallback = choose_hybrid(req, cfg)
            self.moai_route = brain
            self.moai_route_reason = reason
            req = dict(req)
            if brain == "local":
                error = ensure_local(model)
                if error and may_fallback:
                    self.moai_route = "cloud"
                    self.moai_route_reason = "local-unavailable"
                    if wants_agent and self._to_agent(req, "cloud", model, cfg):
                        return
                    req.pop("moai", None)
                    raw = json.dumps(req).encode("utf-8")
                    return self._to_cloud(req, raw, model, cfg)
                if error:
                    return self._err(503, error)
                if wants_agent and self._to_agent(req, "local", model, cfg,
                                                  local_prepared=True):
                    return
                req.pop("moai", None)
                return self._to_local(req, model, prepared=True)
            if wants_agent and self._to_agent(req, "cloud", model, cfg):
                return
            req.pop("moai", None)
            raw = json.dumps(req).encode("utf-8")
            return self._to_cloud(req, raw, model, cfg)
        if wants_agent and self._to_agent(req, brain, model, cfg):
            return
        req = dict(req)
        req.pop("moai", None)
        raw = json.dumps(req).encode("utf-8")
        if brain == "local":
            return self._to_local(req, model)
        return self._to_cloud(req, raw, model, cfg)

    def _to_agent(self, req, brain, model, cfg, local_prepared=False):
        """Route desktop chat through the same OpenClaw runtime as phone channels.

        False means the runtime is not configured and the caller may use the
        existing direct-model path. Once a request reaches OpenClaw, its result is
        authoritative and is streamed straight back; no secret enters QML.
        """
        client = load_openclaw_client()
        if not client or not os.path.isfile(OPENCLAW_BIN):
            self.moai_agent = "direct-fallback"
            return False
        selected = openclaw_model(client, brain, model, cfg)
        if not selected:
            self.moai_agent = "direct-fallback"
            return False
        if brain == "local" and not local_prepared:
            error = ensure_local(model)
            if error:
                self._err(503, error)
                return True
        error = ensure_openclaw_gateway()
        if error:
            self.moai_agent = "direct-fallback"
            self.moai_route_reason = "openclaw-unavailable"
            return False
        meta = req.get("moai") if isinstance(req.get("moai"), dict) else {}
        session = str(meta.get("session") or "").strip()
        if not re.fullmatch(r"[A-Za-z0-9_.:-]{8,120}", session):
            self._err(400, "invalid Mo AI conversation id")
            return True
        session_key = str(meta.get("session_key") or "").strip()
        if session_key and (
            not re.fullmatch(r"[A-Za-z0-9_.:-]{1,180}", session_key)
            or session_key.startswith(("subagent:", "cron:", "acp:"))
        ):
            self._err(400, "invalid OpenClaw session key")
            return True
        latest_user = None
        for message in reversed(req.get("messages", [])):
            if isinstance(message, dict) and message.get("role") == "user":
                latest_user = message
                break
        if latest_user is None:
            self._err(400, "agent chat needs a user message")
            return True
        out = {
            "model": "openclaw/default",
            "messages": [latest_user],
            "stream": bool(req.get("stream")),
        }
        if not session_key:
            out["user"] = session
        headers = {
            "Authorization": "Bearer " + client["token"],
            "x-openclaw-message-channel": "webchat",
        }
        if selected != client.get("primary"):
            headers["x-openclaw-model"] = selected
        if session_key:
            headers["x-openclaw-session-key"] = session_key
        self.moai_agent = "openclaw"
        self._proxy("POST", OPENCLAW_BASE + "/v1/chat/completions", headers,
                    json.dumps(out).encode("utf-8"), "openai", out["stream"])
        return True

    def _to_local(self, req, model, prepared=False):
        error = None if prepared else ensure_local(model)
        if error:
            return self._err(503, error)
        # A real local chat just happened: refresh the idle clock so moai-idle keeps
        # the brain loaded while it is in use and only unloads it once you stop.
        mark_activity()
        body, streaming = b"", False
        if req:
            out = dict(req)
            # llama.cpp ignores this, but send something coherent rather than the
            # routing token: a proxy that forwards "local:qwen3" as a model name
            # is lying to whatever it is talking to.
            out["model"] = model or short_model(DEFAULT_LOCAL_MODEL) or "default"
            # ── Never pay for hidden reasoning on the desktop chat ────────────
            #
            # Qwen3 and its family think by default, and on a CPU-only box that is
            # not a quality knob, it is the difference between a usable assistant
            # and an unusable one. MEASURED here, same one-sentence Arabic question,
            # through THIS endpoint:
            #     nothing sent                     86.8s, 377 tokens
            #     reasoning_effort: "none"          5.7s,  28 tokens
            # Note the two dialects disagree, which is the whole reason this line
            # exists: Ollama's NATIVE /api/chat takes `think: false`, but over the
            # OpenAI-compatible /v1 path that field is silently ignored — `think:
            # false` still measured 63.1s, as did chat_template_kwargs. Only
            # reasoning_effort works here. OpenClaw talks the native dialect and
            # sets its own switch; this is the desktop half of the same contract.
            #
            # A caller that explicitly asks for reasoning still gets it.
            if "reasoning_effort" not in out:
                out["reasoning_effort"] = "none"
            streaming = bool(out.get("stream"))
            body = json.dumps(out).encode("utf-8")
        self._proxy("POST", LOCAL_BASE + self.path, {}, body, "openai", streaming)

    def _to_cloud(self, req, raw, model, cfg):
        base, key, wire = self._cloud_cfg(cfg)
        if not base or not key:
            return self._err(503,
                             "العقل السحابي غير مضبوط — أضف مزوّداً ومفتاحاً في إعدادات Mo AI.\n"
                             "The cloud brain is not configured — add a provider and an "
                             "API key in Mo AI's settings.")
        if wire == "anthropic":
            try:
                body, streaming = to_anthropic(raw, model)
            except Exception as e:
                return self._err(400, "could not translate the request: %s" % e)
        else:
            body, streaming = raw, False
            if req:
                out = dict(req)
                if model:
                    out["model"] = model
                streaming = bool(out.get("stream"))
                body = json.dumps(out).encode("utf-8")

        self._proxy("POST", upstream_url(base, self.path, wire),
                    auth_headers(key, wire), body, wire, streaming)

    # ── The pipe ─────────────────────────────────────────────────────────────

    def _proxy(self, method, url, headers, body, wire, streaming):
        req = urllib.request.Request(url, data=body, method=method)
        req.add_header("Content-Type", "application/json")
        req.add_header("User-Agent", USER_AGENT)     # or Cloudflare answers 403/1010
        for name, value in (headers or {}).items():
            req.add_header(name, value)
        try:
            up = urllib.request.urlopen(req, timeout=180)
        except urllib.error.HTTPError as e:
            return self._err(e.code, e.read().decode("utf-8", "replace"))
        except Exception as e:
            return self._err(502, "request failed: %s" % e)

        self.send_response(up.status)
        ctype = up.headers.get("Content-Type", "application/json")
        if wire == "anthropic":
            # We rewrite the body, so never echo the upstream content type.
            ctype = "text/event-stream" if streaming else "application/json"
        self.send_header("Content-Type", ctype)
        if getattr(self, "moai_route", ""):
            self.send_header("X-MoAI-Route", self.moai_route)
            self.send_header("X-MoAI-Route-Reason", self.moai_route_reason)
        if getattr(self, "moai_agent", ""):
            self.send_header("X-MoAI-Agent", self.moai_agent)
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()

        def write(data):
            self.wfile.write(b"%X\r\n%s\r\n" % (len(data), data))
            self.wfile.flush()

        completed = False
        try:
            if wire == "anthropic":
                if streaming:
                    anthropic_stream_to_openai(up, write)
                else:
                    write(anthropic_whole_to_openai(up.read()))
            else:
                # Stream (SSE or plain) straight through. read1() returns as soon
                # as ANY bytes are available; read() would block until the buffer
                # fills, defeating live streaming.
                while True:
                    chunk = up.read1(65536)
                    if not chunk:
                        break
                    write(chunk)
            self.wfile.write(b"0\r\n\r\n")
            completed = True
        except Exception:
            # An upstream drop mid-generation (provider rate-limit/overload, the local
            # engine evicting a loaded model, a network blip, or the urlopen timeout)
            # lands here. The old `pass` left the terminating chunk unwritten and the
            # HTTP/1.1 connection open, so the handler looped back to readline() and the
            # client's streaming socket hung for ever on a half-finished body with no
            # [DONE] — the "spinner that never clears". Once headers are sent the status
            # can no longer change, so the only signals left are a synthetic error and a
            # clean socket close.
            if not completed:
                if streaming:
                    try:
                        write(b'data: {"error":{"message":"upstream stream ended early"}}\n\n')
                        write(b"data: [DONE]\n\n")
                    except Exception:
                        pass
                try:
                    self.wfile.write(b"0\r\n\r\n")   # terminate the chunked body
                except Exception:
                    pass
                self.close_connection = True          # give the client an EOF, not a hang

    def _send_json(self, code, obj):
        payload = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        if getattr(self, "moai_route", ""):
            self.send_header("X-MoAI-Route", self.moai_route)
            self.send_header("X-MoAI-Route-Reason", self.moai_route_reason)
        if getattr(self, "moai_agent", ""):
            self.send_header("X-MoAI-Agent", self.moai_agent)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        try:
            self.wfile.write(payload)
        except Exception:
            pass

    def _err(self, code, msg):
        payload = json.dumps({"error": {"message": msg}},
                             ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        if getattr(self, "moai_route", ""):
            self.send_header("X-MoAI-Route", self.moai_route)
            self.send_header("X-MoAI-Route-Reason", self.moai_route_reason)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Connection", "close")   # don't reuse a poisoned socket
        self.close_connection = True
        self.end_headers()
        try:
            self.wfile.write(payload)
        except Exception:
            pass


def main():
    srv = None
    # Two units (this one and moai-control's ensure_front_door) can race to bind
    # 127.0.0.1:%d at boot, so a transient "Address already in use" must back off
    # and retry instead of dying and burning a restart cycle.
    deadline = time.time() + 60
    while srv is None:
        try:
            srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
        except OSError as e:
            if e.errno == 98 and time.time() < deadline:
                sys.stderr.write("moai-gateway: port %d busy, retrying in 2s (%s)\n" % (PORT, e))
                sys.stderr.flush()
                time.sleep(2)
                continue
            raise
    sys.stderr.write("moai-gateway: front door on 127.0.0.1:%d "
                     "(local brain: %s on 127.0.0.1:%d)\n"
                     % (PORT, LOCAL_UNIT, LOCAL_PORT))
    sys.stderr.flush()
    srv.serve_forever()


if __name__ == "__main__":
    main()
