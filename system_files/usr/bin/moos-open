#!/usr/bin/env bash
# moos-open — MoOS internal URL handler for the "moos:" scheme.
#
# WHY: the MoOS apps (Welcome, Mo AI) are pure-QML script apps. Pure QML has NO
# Process API and cannot exec, so historically their buttons only COPIED a
# command to the clipboard ("run it in a terminal") — a premium UI whose buttons
# did nothing. QML *can* call Qt.openUrlExternally(), which on Linux routes
# through xdg-open to the registered scheme handler. So the buttons open
# "moos://…" URLs and THIS handler runs the matching MoOS command. Registered as
# x-scheme-handler/moos via org.moos.urlhandler.desktop.
#
# SECURITY: strict whitelist. It never execs arbitrary input from the URL — only
# the fixed set of MoOS actions below. Terminal/privileged actions run in a
# visible Konsole (--hold) so the user sees every prompt (moai-do uses pkexec).
#
# Because "moos:" is a registered scheme, ANY web page can hand this script a
# URL. Free-form app ids are therefore re-validated here; installation is handed
# to moai-do, which validates again and requires an explicit confirmation.
# Store and Welcome software changes do NOT use this public scheme: they cross a
# private, fixed-argv bridge available only to those first-party QML app ids.
#
# EVERY moos:// URL emitted by a MoOS QML app must have a case below. Three
# buttons once shipped opening routes that did not exist here; they popped
# "unknown MoOS action" and did nothing. tests/verify_user_experience.py now
# cross-checks the QML against this file so that cannot happen again.
set -uo pipefail

url="${1:-}"
# moos://CAT/TGT  ->  cat=CAT tgt=TGT  (tolerate moos:CAT/TGT and trailing bits)
path="${url#moos:}"; path="${path#//}"; path="${path%%[?#]*}"; path="${path%/}"
cat="${path%%/*}"
tgt="${path#*/}"; [ "$tgt" = "$cat" ] && tgt=""

notify() { command -v kdialog >/dev/null 2>&1 && kdialog --title "MoOS" --passivepopup "$1" 5 >/dev/null 2>&1 || true; }

# Because "moos:" is a registered scheme, ANY web page can hand this handler a URL.
# State changes that are disruptive or persistent — turning ON a remote-access
# service (it comes back every boot), rebooting, powering off, logging out — must be
# something the USER actively confirms, matching this file's "at worst a prompt the
# user has to answer" contract. Fail CLOSED: with no dialog tool, refuse rather than
# act, so a drive-by URL can never silently trigger these. Trusted local UIs (the
# installer success page, the logout screen) simply show one confirm dialog, which is
# normal, expected UX for reboot/logout anyway.
#
# Route labels are kept as "Arabic | English" pairs in this whitelist so one
# audited string serves both locales. Never hand that mixed-direction pair to a
# dialog: Qt's bidi layout visibly reorders punctuation and the question mark.
# Pick exactly one side from the session locale first.
localized_message() {
    local pair="${1:-}" ar en locale
    if [[ "$pair" != *" | "* ]]; then
        printf '%s' "$pair"
        return
    fi
    ar="${pair%% | *}"
    en="${pair#* | }"
    locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
    case "$locale" in
        ar*|AR*) printf '%s' "$ar" ;;
        *)       printf '%s' "$en" ;;
    esac
}

confirm() {
    local message
    message="$(localized_message "${1:-}")"
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "MoOS" --warningyesno "$message" >/dev/null 2>&1
    elif command -v zenity >/dev/null 2>&1; then
        zenity --question --text="$message" >/dev/null 2>&1
    else
        return 1
    fi
}

# Launch a GUI app fully detached from this short-lived handler process.
gui() { setsid "$@" >/dev/null 2>&1 & }

# Plasma 6 ships the D-Bus CLI as qdbus-qt6, not qdbus6. Routes that hardcoded
# `qdbus6` (session/logout, session/power) confirmed the action, took the user's
# Yes, and then did nothing — `command -v qdbus6` was false so the && chain
# short-circuited to `|| true`. Resolve the binary by any of its shipped names and
# run the call; return non-zero if none exists so a caller can fall back.
qdbus_run() {
    local q
    for q in qdbus6 qdbus-qt6 qdbus; do
        if command -v "$q" >/dev/null 2>&1; then
            "$q" "$@"
            return
        fi
    done
    return 1
}

# Run an interactive command in a held terminal so its output/prompts/errors
# stay visible after it exits (moos-setup, moai-start, moai-do).
term() {
    if command -v konsole >/dev/null 2>&1; then
        setsid konsole --hold -e "$@" >/dev/null 2>&1 &
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        setsid x-terminal-emulator -e "$@" >/dev/null 2>&1 &
    else
        notify "لا توجد طرفية | no terminal available: $*"
    fi
}

# Mo PC Remote is a user service, so start/stop/reconnect need no privilege and
# no terminal — they are instant and Mo AI shows the resulting state. `enable
# --now` / `disable --now` (not plain start/stop) to match the Mo PC Remote
# panel, so the two never disagree about whether it comes back after a reboot.
REMOTE_UNIT="mo-remote-personal.service"
remote_ctl() {
    if systemctl --user "$@" "$REMOTE_UNIT" >/dev/null 2>&1; then
        notify "Mo PC Remote ✓"
    else
        notify "Mo PC Remote: تعذّر التنفيذ | action failed"
    fi
}

case "${cat}/${tgt}" in
    app/moai)      gui moai ;;
    app/moplayer)  gui moplayer ;;
    app/remote)    gui mo-pc-remote ;;
    app/setup)     term moos-setup ;;
    do/smart-setup) confirm "تشغيل الإعداد الذكي وتطبيق التوصيات؟ | Run smart setup and apply its recommendations?" \
                          && term moos-setup --smart ;;
    do/setup-gaming) confirm "تجهيز النظام للألعاب وتثبيت التوصيات؟ | Prepare the system for gaming and install recommendations?" \
                          && term moos-setup --gaming ;;
    app/compat)    gui moai --device ;;
    app/hardware)  gui moai --device ;;
    # GTK apps, not terminal programs. Launching them with `term` opened a Konsole
    # window (--hold, so it stays) AND the app's own window — two windows and two
    # taskbar entries for one action, with the terminal sitting empty because the app
    # prints nothing. `gui` is what the other graphical MoOS apps above use.
    app/updater)   gui moos-update ;;
    app/recovery)  gui moos-rollback ;;
    app/welcome)   gui moos-welcome ;;
    app/store)     gui moos-store ;;
    brain/start)   term moai-start ;;
    ai/config)     gui moai-config ;;

    # ── Connected devices: these are the real Plasma 6 KCM module ids. The
    # Welcome's pairing guide opens the exact settings page it describes; none
    # of its buttons are decorative. All four operations are read-only launches
    # from the public URL handler — the user still performs every pairing or
    # settings change inside System Settings.
    settings/bluetooth) gui systemsettings kcm_bluetooth ;;
    # USB is an Information Centre module, not a System Settings KCM. Plasma 6
    # embeds its metadata in kcm_usb.so and ships no kcm_usb.desktop, so sending
    # it to systemsettings produces a polished-looking dead button.
    settings/usb)       gui kinfocenter kcm_usb ;;
    settings/keyboard)  gui systemsettings kcm_keyboard ;;
    settings/mouse)     gui systemsettings kcm_mouse ;;

    # ── Theme: instant, cosmetic, reversible — the Welcome's look picker fires
    # these. moos-theme itself serializes concurrent runs behind a flock, so a
    # drive-by page can at worst flip a look the user can flip right back.
    theme/dark)     setsid moos-theme dark     >/dev/null 2>&1 & ;;
    theme/light)    setsid moos-theme light    >/dev/null 2>&1 & ;;
    theme/nova)     setsid moos-theme nova     >/dev/null 2>&1 & ;;
    theme/amethyst) setsid moos-theme amethyst >/dev/null 2>&1 & ;;
    theme/midnight) setsid moos-theme midnight >/dev/null 2>&1 & ;;
    theme/aurora)   setsid moos-theme aurora   >/dev/null 2>&1 & ;;
    theme/auto)     setsid moos-theme auto     >/dev/null 2>&1 & ;;

    # ── Language: the Welcome's language pick. moos-lang writes only the user's
    # own plasma-localerc + flatpak language (no root, reversible), and the id is
    # validated to a fixed set here before it ever reaches the writer.
    lang/ar)       setsid moos-lang ar >/dev/null 2>&1 & ;;
    lang/en)       setsid moos-lang en >/dev/null 2>&1 & ;;
    # (No lang/de — MoOS ships Arabic + English only; German was removed.)

    # ── MoOS Installer (apps/installer/main.qml, launched by moos-installer on
    # the live USB). Re-probe disks, run the ONE privileged destructive step, or
    # finish. moos-install-to-disk self-guards to a live boot and refuses the boot
    # medium, so even a drive-by moos:// URL can at worst raise the (live-only,
    # live-guarded) installer helper — which does nothing on an installed system.
    installer/probe)
        _idir="${XDG_CACHE_HOME:-$HOME/.cache}/moos-installer"; mkdir -p "$_idir"
        if command -v moos-list-disks >/dev/null 2>&1; then
            setsid sh -c 'moos-list-disks > "$1/disks.json" 2>/dev/null || printf "{\"liveNode\":\"\",\"disks\":[]}\n" > "$1/disks.json"' _ "$_idir" >/dev/null 2>&1 &
        fi ;;
    installer/begin)
        # The target disk is NOT taken from this URL — the helper reads it (and the
        # account answers) from the 0600 recipe.json the trusted QML front-end wrote
        # via the moos-qml-shell bridge. So a drive-by moos://installer/begin cannot
        # choose a disk: with no recipe the helper fails no-recipe and wipes nothing.
        _idir="${XDG_CACHE_HOME:-$HOME/.cache}/moos-installer"; mkdir -p "$_idir"
        : > "${_idir}/install.status" 2>/dev/null || true
        # Pass the status FILE to the helper (arg 1). It appends each
        # PHASE/PROGRESS/DONE/FAIL line itself (open-append-close ⇒ flushed at once),
        # because `stdbuf -oL pkexec` does NOT work: pkexec is setuid and drops the
        # LD_PRELOAD, so a redirected helper stdout would be block-buffered and the
        # progress bar would freeze until the process exits (seen live: FAIL stalled).
        setsid pkexec /usr/bin/moos-install-to-disk "${_idir}/install.status" >/dev/null 2>&1 & ;;
    # Open the MoOS installer UI itself — the Welcome's "Install MoOS on this
    # computer" call-to-action fires this on the live session. Harmless on an
    # installed system: moos-installer's own live-guard just shows a notice.
    installer/open)     gui moos-installer ;;
    installer/reboot)   confirm "إعادة تشغيل الجهاز الآن؟ | Restart the computer now?" \
                          && { systemctl reboot 2>/dev/null || loginctl reboot 2>/dev/null || qdbus_run org.kde.Shutdown /Shutdown logoutAndReboot 2>/dev/null || true; } ;;
    installer/poweroff) confirm "إيقاف تشغيل الجهاز الآن؟ | Shut the computer down now?" \
                          && { systemctl poweroff 2>/dev/null || loginctl poweroff 2>/dev/null || qdbus_run org.kde.Shutdown /Shutdown logoutAndShutdown 2>/dev/null || true; } ;;

    # ── Mo PC Remote: start / stop / reconnect, from inside Mo AI ────────────
    # start ENABLES the service (it returns every boot), so it must be confirmed —
    # a drive-by moos://remote/start must not silently open persistent remote access.
    remote/start)   confirm "تشغيل Mo PC Remote والسماح له بالعمل بعد كل إقلاع؟ | Turn on Mo PC Remote (it will start at every boot)?" \
                          && remote_ctl enable --now ;;
    remote/stop)    remote_ctl disable --now ;;
    # try-restart is a no-op when remote access is off. Plain restart would turn
    # an inactive service on, letting a public moos: URL open remote access.
    remote/restart) remote_ctl try-restart ;;

    # ── Coding agents: run the one the user picked, or install it ────────────
    dev/code)      term moai-code ;;
    dev/codex)     term moai-code --agent codex ;;
    dev/claude)    term moai-code --agent claude ;;
    dev/opencode)  term moai-code --agent opencode ;;

    # ── App Centre: install a Flathub app by id ──────────────────────────────
    # The id is free-form (it comes from a Flathub search), so validate the
    # reverse-DNS shape here before it reaches moai-do, which validates it again
    # and asks for confirmation.
    apps/install/*)
        id="${tgt#install/}"
        if printf '%s' "$id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{2,254}$'; then
            term moai-do install "$id"
        else
            notify "معرّف تطبيق غير صالح | invalid app id"
            exit 2
        fi ;;

    # ── App Centre: OPEN an already-installed app by id (no privilege) ────────
    # The counterpart to apps/install. Launching an app the user already has is
    # exactly what clicking its icon does — no confirmation and no terminal. The
    # id is still free-form (any web page can hand this scheme a URL), so validate
    # the reverse-DNS shape, pass NO arguments to the app, and refuse anything not
    # installed: the worst a drive-by page can do is start an app the user owns.
    apps/run/*)
        id="${tgt#run/}"
        if ! printf '%s' "$id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{2,254}$'; then
            notify "معرّف تطبيق غير صالح | invalid app id"
            exit 2
        fi
        # Same guard as moai-do's launch_app, and for the same reason: with the local brain
        # loaded there is not enough VRAM left for a GPU app to make an EGL context, and it
        # aborts rather than degrading. A route that opens apps must not open them into a
        # full card. Silent and non-fatal — never the reason an app did not start.
        command -v moos-gpu-headroom >/dev/null 2>&1 && moos-gpu-headroom 2>/dev/null || true
        if flatpak info "$id" >/dev/null 2>&1; then
            gui flatpak run "$id"
        elif [ -f "$HOME/.local/share/applications/$id.desktop" ] \
          || [ -f "/usr/share/applications/$id.desktop" ]; then
            gui gtk-launch "$id"
        else
            notify "التطبيق غير مثبّت | app is not installed: $id"
            exit 2
        fi ;;

    search/*)      query="$(python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "$tgt" 2>/dev/null)";
                   [ -n "$query" ] && gui krunner "$query" ;;
    session/lock)  loginctl lock-session ;;
    session/logout) confirm "تسجيل الخروج الآن؟ | Log out now?" \
                          && { qdbus_run org.kde.Shutdown /Shutdown logout 2>/dev/null || true; } ;;
    # Graceful FIRST, like session/logout. org.kde.Shutdown runs KDE's session shutdown,
    # so applications get the save-session / "this is preventing shutdown" cycle; a bare
    # `systemctl poweroff` skips all of it and can lose unsaved work. systemctl/loginctl
    # remain as the fallback for a session with no KDE shutdown service (the cloud edition).
    session/power) confirm "إيقاف تشغيل الجهاز الآن؟ | Shut the computer down now?" \
                          && { qdbus_run org.kde.Shutdown /Shutdown logoutAndShutdown 2>/dev/null \
                               || systemctl poweroff 2>/dev/null || loginctl poweroff 2>/dev/null || true; } ;;
    do/update|do/fix-audio|do/check-drivers|do/optimize|do/hw-report|do/diagnose-services|do/inspect-boot|do/install-nvidia|do/update-firmware|do/setup-waydroid|do/setup-windows|do/install-codex|do/install-claude|do/install-opencode|do/install-openclaw|do/setup-brain|do/remote-anywhere|do/rollback|do/net-doctor|do/gpu-report)
                   term moai-do "$tgt" ;;
    *)
        notify "أمر MoOS غير معروف | unknown MoOS action: ${path}"
        exit 2 ;;
esac
exit 0
