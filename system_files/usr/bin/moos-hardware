#!/usr/bin/env bash
# =============================================================================
# moos-hardware — MoOS Hardware Center v0 launcher (collector + pure-QML viewer)
# =============================================================================
# App:  /usr/share/moos/apps/hardware/main.qml
# Docs: MOOS_HARDWARE_CENTER_PLAN.md (v0.1 = Detect / overview + report)
#
# WHY a collector wrapper: QML has no Process API — a pure-QML window cannot run
# a command. So THIS wrapper does the (read-only) collection into a FIXED path
# and the QML window only DISPLAYS the result:
#     collect -> /tmp/moos-hw.json   (built by python3 from safe read-only cmds)
#     display -> main.qml            (reads that file via XMLHttpRequest)
#
# Commands used — ALL read-only, none privileged (VERIFIED on Fedora 44 Kinoite,
# 2026-07-10 unless noted):
#   lscpu   (util-linux)   — base image
#   free    (procps-ng)    — base image
#   lsblk   (util-linux)   — base image
#   ip      (iproute)      — base image
#   cat /etc/os-release    — always present
#   lspci   (pciutils 3.15.0-1.fc44) — its presence in the Kinoite BASE is not
#           guaranteed (Fedora immutable variants like IoT ship without it), so
#           build.sh (c7) installs pciutils explicitly. The collector below
#           still degrades to "unavailable" if lspci is somehow missing.
# python3 is guaranteed present on Fedora Atomic and BUILDS the JSON natively:
#   native quoting/escaping beats fragile shell string juggling, and every field
#   is forced to a plain string ("unavailable" on any error).
set -euo pipefail

HW_JSON="/tmp/moos-hw.json"
APP="/usr/share/moos/apps/hardware/main.qml"

# lspci / lsblk live under /usr/sbin on Fedora — make sure it is on PATH for the
# collector regardless of how the launcher was invoked.
export PATH="/usr/sbin:/sbin:${PATH}"

# -----------------------------------------------------------------------------
# (a) collect: build /tmp/moos-hw.json with python3.
#     LC_ALL=C keeps command labels (lscpu/free/ip) in stable English so the
#     parser below matches; it does NOT affect the QML UI locale (that runner is
#     started further down with the inherited environment).
#     '|| true' + a bash safety net guarantee the display step still runs even
#     if the collector hits an unexpected problem.
# -----------------------------------------------------------------------------
LC_ALL=C python3 - "$HW_JSON" <<'PY' || true
import json, os, subprocess, sys

OUT = sys.argv[1]

ENV = dict(os.environ)
ENV["LC_ALL"] = "C"   # stable English labels for lscpu/free/ip parsing


def run(cmd):
    """Run a read-only command; return stripped stdout, or None on any failure."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True,
                           timeout=15, env=ENV)
    except Exception:
        return None
    if p.returncode != 0:
        return None
    out = (p.stdout or "").strip()
    return out or None


def cpu():
    out = run(["lscpu"])
    if not out:
        return "unavailable"
    keep = ("Architecture", "Model name", "CPU(s)", "Thread(s) per core",
            "Core(s) per socket", "Socket(s)", "CPU max MHz", "CPU min MHz",
            "Vendor ID")
    lines = []
    for line in out.splitlines():
        key = line.split(":", 1)[0].strip()
        if key in keep:
            lines.append(line.strip())
    return "\n".join(lines) if lines else out


def memory():
    out = run(["free", "-h"])
    if not out:
        return "unavailable"
    mem_line = None
    swap_line = None
    for line in out.splitlines():
        if line.startswith("Mem:"):
            mem_line = line.split()
        elif line.startswith("Swap:"):
            swap_line = line.split()
    parts = []
    # free -h columns: label total used free shared buff/cache available
    if mem_line and len(mem_line) >= 4:
        total = mem_line[1]
        used = mem_line[2]
        free_ = mem_line[3]
        avail = mem_line[6] if len(mem_line) >= 7 else free_
        parts.append("Total: %s   Used: %s   Free: %s   Available: %s"
                     % (total, used, free_, avail))
    if swap_line and len(swap_line) >= 4:
        parts.append("Swap: total %s, used %s, free %s"
                     % (swap_line[1], swap_line[2], swap_line[3]))
    return "\n".join(parts) if parts else out


def gpu():
    out = run(["lspci"])
    if not out:
        return "unavailable"
    hits = []
    for line in out.splitlines():
        low = line.lower()
        if ("vga compatible controller" in low
                or "3d controller" in low
                or "display controller" in low):
            # line looks like: "01:00.0 VGA compatible controller: <desc>"
            # split on the first ": " so the "01:00.0" slot colon is untouched.
            desc = line.split(": ", 1)
            hits.append(desc[1].strip() if len(desc) == 2 else line.strip())
    return "\n".join(hits) if hits else "unavailable"


def disks():
    out = run(["lsblk", "-d", "-e", "7", "-o", "NAME,SIZE,TYPE,MODEL"])
    if not out:
        return "unavailable"
    return out


def network():
    out = run(["ip", "-brief", "link"])
    if not out:
        return "unavailable"
    return out


def os_pretty():
    out = run(["cat", "/etc/os-release"])
    if not out:
        return "unavailable"
    for line in out.splitlines():
        if line.startswith("PRETTY_NAME="):
            val = line.split("=", 1)[1].strip().strip('"')
            return val or "unavailable"
    return "unavailable"


data = {
    "cpu": cpu(),
    "memory": memory(),
    "gpu": gpu(),
    "disks": disks(),
    "network": network(),
    "os": os_pretty(),
}

try:
    plan_raw = run(["/usr/bin/moos-device-plan", "--compact"])
    if plan_raw:
        data.update(json.loads(plan_raw))
except (ValueError, TypeError):
    pass

# Every value is a plain string by construction; belt-and-braces coerce anyway.
for k in list(data):
    if not isinstance(data[k], str) or not data[k]:
        data[k] = "unavailable"

with open(OUT, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
PY

# Safety net: if the collector could not write the file at all, ship a valid
# all-"unavailable" document so the viewer still opens and reads cleanly.
if [ ! -s "$HW_JSON" ]; then
    printf '{\n  "cpu": "unavailable",\n  "memory": "unavailable",\n  "gpu": "unavailable",\n  "disks": "unavailable",\n  "network": "unavailable",\n  "os": "unavailable"\n}\n' > "$HW_JSON"
fi

# -----------------------------------------------------------------------------
# (b) display: hand off to the Qt6 QML runner.
# Deterministic QQC2 style: the app styles its own controls, so the pure-QML
# "Basic" style needs no QWidget/QStyle dependency. Same runner fallback chain
# as the other MoOS script apps (Fedora ships the runner as /usr/bin/qml-qt6
# from qt6-qtdeclarative-devel — installed by build.sh (c7)).
# -----------------------------------------------------------------------------
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-Basic}"
# OSTree fixes mtimes → Qt's QML disk cache never invalidates across upgrades.
export QML_DISABLE_DISK_CACHE=1
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/qmlcache" 2>/dev/null || true

for runner in qml-qt6 /usr/lib64/qt6/bin/qml qml6 qml; do
    if command -v "$runner" >/dev/null 2>&1; then
        exec "$runner" "$APP" "$@"
    fi
done

echo "moos-hardware: no Qt6 QML runner found (expected qml-qt6 from qt6-qtdeclarative-devel)." >&2
echo "moos-hardware: لم يتم العثور على مشغّل QML — ثبّت qt6-qtdeclarative-devel." >&2
exit 127
