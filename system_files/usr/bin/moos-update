#!/usr/bin/python3
"""MoOS Updater — the app that updates MoOS.

This was a bash script with an ASCII-art banner and a numbered menu, launched with Terminal=true.
Three things were wrong with that, and only one of them was cosmetic:

  * A Terminal=true launcher does not open YOUR app. It opens KONSOLE and runs you inside it — so
    the window in the dock wore Konsole's icon and Konsole's name, beside a pinned "MoOS Updater"
    that never lit up. The owner reported it as "the app opens with two different icons". He was
    right: there were two, and neither of them was the updater.
  * It could not show progress. An image update pulls layers for minutes; a numbered menu can only
    print at you. There was no way to see how far along it was, or whether it had hung.
  * Updating your operating system through an ASCII banner is not what MoOS is.

The mechanism is unchanged, because the mechanism was never the problem: an atomic image update,
staged over polkit, applied on reboot, with the running system untouched until then. What changed
is that you can watch it happen.

WHY IT NO LONGER RUNS `bootc upgrade` (2026-08-03)
--------------------------------------------------
It did, and on this OS that is a button that can never do anything.

`moai-do update` deliberately stages an EXACT DIGEST: the tag resolve happens unprivileged and
Polkit escalates only an immutable object, never a mutable tag. The nightly train
(`/usr/libexec/moos-image-update auto`) carries the same contract. The cost of that correct boundary is
that every MoOS install ends up with a DIGEST-PINNED origin — and `bootc upgrade` cannot advance
such an origin: the origin deliberately names the old object, so the check reports

    No changes in: ostree-image-signed:docker://…/moos-cloud@sha256:34b5…

forever, no matter how many newer images exist. Verified on the live Cloud machine while it was
two builds behind. The background train was fixed in the commit that added moos-auto-update; this
window — the one a person actually opens, and the one Mo Store's "system update" card opens — was
left on the dead path, so "Install update" was a dead button on every machine.

So the app now delegates that contract to `/usr/libexec/moos-image-update`, the same backend used
by the nightly train and Mo AI. The UI displays state and progress; the backend alone owns the
edition allowlist, registry resolution, target validation and exact signed rebase.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/moos")

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk  # noqa: E402

from moos_ui2 import MoOSApp, local_text, logical_start  # noqa: E402


def sh(*cmd, timeout=25):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.SubprocessError) as e:
        return 127, str(e)


UPDATE_BACKEND = "/usr/libexec/moos-image-update"


def deployment_state():
    """(booted, staged, busy) as rpm-ostree reports them, from ONE status call.

    booted/staged may be None: on a machine where rpm-ostreed is unreachable
    there is nothing honest to say, and the UI says exactly that instead of
    guessing. `busy` names the transaction another writer already owns — the
    nightly train, uupd, or a terminal — because "an update is being staged
    right now" is a completely different thing to tell someone than "your
    update failed", which is all a raced rebase could have said.
    """
    rc, out = sh("rpm-ostree", "status", "--json")
    if rc != 0:
        return None, None, ""
    try:
        status = json.loads(out)
    except ValueError:
        return None, None, ""
    deployments = status.get("deployments", [])
    booted = next((d for d in deployments if d.get("booted")), None)
    staged = next((d for d in deployments if d.get("staged")), None)
    # rpm-ostree reports the transaction as a string or as an argv list.
    transaction = status.get("transaction")
    if isinstance(transaction, (list, tuple)):
        transaction = " ".join(str(word) for word in transaction)
    return booted, staged, (transaction or "").strip()


def current_system(booted=None):
    """What this machine is running, named the way the OS names itself."""
    pretty = "MoOS"
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    pretty = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass

    # The BOOTED deployment, never deployments[0]: on this OS updates auto-stage,
    # so whenever one is pending that slot holds the build the machine is NOT yet
    # running. "Current system" must mean the one under your hands.
    return pretty, (booted or {}).get("version", "") or ""



def booted_origin(cmdline_path: str = "/proc/cmdline") -> str:
    """The container image reference the RUNNING deployment was created from.

    The kernel command line names the booted deployment directly, and that
    symlink plus its `.origin` file are both world-readable, so this needs no
    privilege and no bootc/rpm-ostree call. Returns "" when the origin cannot be
    read, which the caller must treat as unknown rather than as trusted.
    """
    try:
        with open(cmdline_path, encoding="utf-8") as handle:
            fields = handle.read().split()
        target = next(
            (f.split("=", 1)[1] for f in fields if f.startswith("ostree=")), "")
        if not target:
            return ""
        deployment = os.path.realpath(target)
        with open(deployment + ".origin", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("container-image-reference="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        return ""
    return ""


def trust_badge(cmdline_path: str = "/proc/cmdline") -> tuple[str, bool]:
    """(label, is_warning) describing the booted deployment's signature state.

    MoOS enforces signatures through the origin type: `ostree-image-signed`
    means every update to this deployment is checked against
    /etc/pki/containers/moos.pub, while `ostree-unverified-registry` means it is
    not. Claiming "signed" without looking is the one thing this badge must
    never do -- it is the only place the desktop tells the owner whether the
    system they are running is the one MoOS signed.
    """
    origin = booted_origin(cmdline_path)
    if origin.startswith("ostree-image-signed:"):
        return local_text("صورة موقّعة  ·  ذرّي", "SIGNED IMAGE  ·  ATOMIC"), False
    if origin.startswith("ostree-unverified"):
        return local_text("أصل غير موثّق  ·  ذرّي", "UNVERIFIED ORIGIN  ·  ATOMIC"), True
    return local_text("أصل غير معروف  ·  ذرّي", "UNKNOWN ORIGIN  ·  ATOMIC"), True


class Updater(MoOSApp):
    APP_ID = "org.moos.updater"      # == org.moos.updater.desktop — see MoOSApp's docstring
    TITLE = local_text("محدّث MoOS", "MoOS Updater")
    # The content is intentionally compact; a tall default left an admin-tool
    # sized void below the actions even after the technical log became an
    # on-demand detail. The scroller still takes over when details are opened.
    SIZE = (760, 380)

    def build(self, page):
        booted, staged, _busy = deployment_state()
        pretty, build = current_system(booted)
        # The reference the Install button will hand to Polkit. It stays None
        # until a check has resolved AND shape-validated a digest, which is why
        # the button starts insensitive and a failed check never enables it.
        self._target = None
        self._staged = staged

        page.append(self.title(local_text("محدّث MoOS", "MoOS Updater")))
        page.append(self.subtitle(local_text(
            "تحديث ذرّي يُجهَّز في الخلفية ويُطبَّق عند إعادة التشغيل. "
            "يبقى نظامك الحالي سليماً حتى ذلك الحين.",
            "Atomic updates are staged in the background and applied on restart. "
            "Your running system stays untouched until then.",
        )))

        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        icon_plate = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        icon_plate.add_css_class("ui2-icon-plate")
        icon = Gtk.Image.new_from_icon_name("moos-safe-update-symbolic")
        icon.set_pixel_size(34)
        icon_plate.append(icon)
        hero.append(icon_plate)

        identity = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3,
                           hexpand=True, valign=Gtk.Align.CENTER)
        identity_label = Gtk.Label(
            label=local_text("النظام الحالي", "Current system"),
            xalign=logical_start(),
        )
        identity_label.add_css_class("ui2-kicker")
        version = Gtk.Label(xalign=logical_start(), wrap=True)
        version.set_markup(
            f"<b>{GLib.markup_escape_text(pretty)}</b>  "
            f"<span alpha='70%'>{GLib.markup_escape_text(build or '—')}</span>")
        version.add_css_class("ui2-value")
        identity.append(identity_label)
        identity.append(version)
        hero.append(identity)

        trust_label, trust_warns = trust_badge()
        trust = Gtk.Label(label=trust_label)
        trust.add_css_class("ui2-badge")
        if trust_warns:
            trust.add_css_class("ui2-badge-warning")
            trust.set_tooltip_text(local_text(
                "هذا النظام أُقلع من أصل لم يُتحقّق من توقيعه، ولن تُتاح "
                "التحديثات حتى يعود إلى أصل موثّق. أعد التشغيل إلى تحديث "
                "موقّع — إن لم يكن هناك تحديث مُجهَّز فثبّت واحدًا أولًا.",
                "This system booted from an origin whose signature was not "
                "verified, and updates stay unavailable until it returns to a "
                "verified origin. Reboot into a signed update -- install one "
                "first if none is staged.",
            ))
        trust.set_valign(Gtk.Align.CENTER)
        hero.append(trust)
        page.append(self.card(hero, spacing=0))

        self.status = Gtk.Label(xalign=logical_start(), wrap=True)
        self.status.add_css_class("ui2-status")
        self.status.set_text(local_text(
            "اضغط «فحص التحديثات» للبدء.",
            "Press “Check for updates” to begin.",
        ))

        self.progress = Gtk.ProgressBar(show_text=False)
        self.progress.set_visible(False)

        self.log = Gtk.TextView(editable=False, monospace=True)
        self.log.add_css_class("ui2-log")
        log_scroll = Gtk.ScrolledWindow(hexpand=True)
        log_scroll.add_css_class("ui2-log-frame")
        log_scroll.set_min_content_height(140)
        log_scroll.set_child(self.log)

        self.details = Gtk.Expander(
            label=local_text("التفاصيل التقنية", "Technical details")
        )
        self.details.add_css_class("ui2-details")
        self.details.set_child(log_scroll)

        page.append(self.card(self.status, self.progress, self.details))

        self.check_btn = Gtk.Button(
            label=local_text("فحص التحديثات", "Check for updates")
        )
        self.check_btn.connect("clicked", self.on_check)

        self.apply_btn = Gtk.Button(
            label=local_text("تثبيت التحديث", "Install update")
        )
        self.apply_btn.add_css_class("suggested-action")
        self.apply_btn.set_sensitive(False)
        self.apply_btn.connect("clicked", self.on_apply)

        self.reboot_btn = Gtk.Button(
            label=local_text("إعادة التشغيل الآن", "Restart now")
        )
        self.reboot_btn.add_css_class("suggested-action")
        self.reboot_btn.set_visible(False)
        self.reboot_btn.connect("clicked", self.on_reboot)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, halign=Gtk.Align.END)
        row.append(self.check_btn)
        row.append(self.apply_btn)
        row.append(self.reboot_btn)
        page.append(row)

        # An update the nightly train already staged is finished work waiting on a
        # restart, and nothing else on this desktop says so: the notifier and the
        # old `bootc upgrade --check` both read the pinned origin and report "no
        # changes". Say it the moment the window opens, rather than making someone
        # hunt for an update that is already sitting on the disk.
        if staged:
            self.status.add_css_class("success")
            self.status.set_text(local_text(
                "✓ تحديث جاهز بالفعل ({}) — أعد التشغيل لتطبيقه.",
                "✓ An update is already staged ({}) — restart to apply it.",
            ).format(staged.get("version", "") or "—"))
            self.reboot_btn.set_visible(True)

    # -- log -------------------------------------------------------------------

    def say(self, text):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), text if text.endswith("\n") else text + "\n")
        self.log.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0.0, 0.0)

    def busy(self, on, message=""):
        self.progress.set_visible(on)
        self.check_btn.set_sensitive(not on)
        if on:
            self.status.remove_css_class("error")
            self.status.remove_css_class("success")
            self.status.set_text(message)
            # Nobody can say how long a layer pull will take, and a bar that claims to know is a
            # bar that lies. Pulse honestly rather than invent a percentage.
            self._pulse = GLib.timeout_add(120, self._tick)
        elif getattr(self, "_pulse", None):
            GLib.source_remove(self._pulse)
            self._pulse = None

    def _tick(self):
        self.progress.pulse()
        return True

    # -- privileged work, without freezing the window --------------------------

    def run_async(self, cmd, on_done, collect=None):
        """A child process, streamed onto the GLib loop.

        A subprocess.run() here would block the main loop and the window would go grey and stop
        repainting for the entire pull — which is indistinguishable, to the person watching, from
        an updater that has crashed. So: read the pipe a line at a time, and let the UI breathe.
        """
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, bufsize=1)
        except OSError as e:
            self.say(f"error: {e}")
            on_done(127)
            return

        def complete_when_exited():
            returncode = proc.poll()
            if returncode is None:
                return True
            on_done(returncode)
            return False

        def pump(_src, _cond):
            line = proc.stdout.readline()
            if line:
                self.say(line.rstrip("\n"))
                if collect is not None:
                    collect.append(line.strip())
                return True
            # A child can close stdout before it exits. Never wait for that
            # process from GTK's callback; poll at a low duty cycle instead.
            if proc.poll() is None:
                GLib.timeout_add(50, complete_when_exited)
            else:
                on_done(proc.returncode)
            return False

        GLib.io_add_watch(
            proc.stdout,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            pump,
        )

    # -- actions ---------------------------------------------------------------

    def fail(self, arabic, english):
        self.busy(False)
        self.status.add_css_class("error")
        self.status.set_text(local_text(arabic, english))

    def on_check(self, _btn):
        self._target = None
        self.busy(True, local_text("جارٍ الفحص…", "Checking…"))
        self.say("$ moos-image-update resolve")

        lines = []

        def done(rc):
            self.busy(False)
            if rc != 0:
                self.fail("تعذّر التحقق من تحديث MoOS بأمان.",
                          "Could not safely check for a MoOS update.")
                return
            payload = None
            for line in reversed(lines):
                try:
                    candidate = json.loads(line)
                except (TypeError, ValueError):
                    continue
                if isinstance(candidate, dict) and candidate.get("schema") == 1:
                    payload = candidate
                    break
            if payload is None:
                self.fail("رفض المحرك نتيجة غير صالحة.",
                          "The update backend returned invalid state.")
                return

            state = payload.get("state")
            if state == "busy":
                self.status.set_text(local_text(
                    "هناك تحديث قيد التجهيز الآن. انتظر حتى ينتهي ثم افحص مرة أخرى.",
                    "An update is being staged right now. Wait for it to finish, "
                    "then check again.",
                ))
                return
            if state == "staged":
                self.status.add_css_class("success")
                self.status.set_text(local_text(
                    "✓ تحديث جاهز بالفعل ({}) — أعد التشغيل لتطبيقه.",
                    "✓ An update is already staged ({}) — restart to apply it.",
                ).format(payload.get("staged_version") or "—"))
                self.reboot_btn.set_visible(True)
                return
            if state == "current":
                self.status.add_css_class("success")
                self.status.set_text(local_text(
                    "✓ نظامك على أحدث صورة MoOS موقّعة.",
                    "✓ You are on the latest signed MoOS image.",
                ))
                return
            digest = payload.get("latest_digest")
            if state != "available" or not isinstance(digest, str):
                self.fail("رفض المحرك حالة تحديث غير صالحة.",
                          "The update backend refused an invalid state.")
                return

            self._target = digest
            self.say(f"current: {payload.get('current_digest') or '-'}")
            self.say(f"new:     {payload.get('latest_digest') or '-'}")
            self.status.set_text(local_text(
                "يتوفّر تحديث. اضغط «تثبيت التحديث».",
                "An update is available. Press “Install update”.",
            ))
            self.apply_btn.set_sensitive(True)

        self.run_async(
            [UPDATE_BACKEND, "resolve"],
            done,
            collect=lines,
        )

    def on_apply(self, _btn):
        if not self._target:
            # Nothing was resolved, so there is nothing to install. The button is
            # insensitive until a check succeeds; this is the belt for that brace.
            self.fail("افحص التحديثات أولاً.", "Check for updates first.")
            return
        self.busy(True, local_text(
            "جارٍ تحضير التحديث… يمكنك متابعة عملك.",
            "Staging the update… you can keep working.",
        ))
        self.apply_btn.set_sensitive(False)
        self.say(f"$ moos-image-update stage --expected-digest {self._target}")

        def done(rc):
            self.busy(False)
            if rc == 0:
                self.status.add_css_class("success")
                self.status.set_text(local_text(
                    "✓ التحديث جاهز ويُطبَّق عند إعادة التشغيل.",
                    "✓ Update staged. It applies on the next restart.",
                ))
                self.reboot_btn.set_visible(True)
            else:
                self.status.add_css_class("error")
                self.status.set_text(local_text(
                    "فشل التحديث. لم يتغيّر نظامك الحالي.",
                    "Update failed. Your running system is untouched.",
                ))
                self.apply_btn.set_sensitive(True)

        # The backend revalidates the exact target against the booted edition and
        # current transaction after Polkit escalation, closing the UI/backend race.
        self.run_async(
            ["pkexec", UPDATE_BACKEND, "stage", "--expected-digest", self._target],
            done,
        )

    def on_reboot(self, _btn):
        os.execvp("systemctl", ["systemctl", "reboot"])


# Guarded like mo-pc-remote's: a gate that imports this file to exercise the
# edition allowlist and the digest handling must not also open a window.
if __name__ == "__main__":
    Updater().run()
