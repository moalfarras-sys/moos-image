#!/usr/bin/env bash
# moos-update — friendly bilingual on-demand updater for MoOS.
#
# THIN UX ONLY — no new update logic (MOOS_ARCHITECTURE.md §9 non-goals).
# Background updates already run automatically via the uupd systemd timer
# (MOOS_ARCHITECTURE.md §3). This is just a human-friendly front-end over the
# same atomic core commands, for users who want to check/apply an update now.
#
# Privileged calls go through pkexec so a polkit GUI prompt appears — we make
# NO sudo assumptions (a MoOS desktop user may not be a sudoer).
#
# bootc CLI flags verified against https://bootc.dev/ man pages (2026-07-10):
#   bootc status                 -> human-readable current system state
#   bootc upgrade                -> pull + stage new deployment (applies on reboot)
#   bootc upgrade --check         -> check for an update (metadata only, no full pull)
set -euo pipefail

# ---- colors (MoOS brand-ish; disabled when stdout is not a terminal) --------
if [ -t 1 ]; then
    B=$'\033[1;34m'   # blue   #2E7BFF
    C=$'\033[1;36m'   # cyan   #22D3EE
    V=$'\033[1;35m'   # violet #8B5CF6
    G=$'\033[1;32m'   # ok
    Y=$'\033[1;33m'   # warn
    R=$'\033[1;31m'   # error
    D=$'\033[2m'      # dim / secondary
    N=$'\033[0m'
else
    B=; C=; V=; G=; Y=; R=; D=; N=
fi

banner() {
    printf '%s' "$B"
    echo '  __  __        ___  ____  '
    echo ' |  \/  | ___  / _ \/ ___| '
    echo ' | |\/| |/ _ \| | | \___ \ '
    echo ' | |  | | (_) | |_| |___) |'
    echo ' |_|  |_|\___/ \___/|____/ '
    printf '%s' "$N"
    echo "${C}  MoOS Update  ·  محدّث MoOS${N}"
    echo "${D}  تحديث ذرّي آمن فوق bootc — يكتمل عند إعادة التشغيل${N}"
    echo "${D}  Atomic, safe update over bootc — applies on reboot${N}"
    echo "${D}  (التحديثات التلقائية تعمل في الخلفية عبر uupd | auto-updates already run via uupd)${N}"
    echo
}

# Privileged run via polkit — no sudo assumption.
run_priv() {
    if command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    else
        echo "${Y}pkexec غير متوفّر — لا يمكن طلب صلاحية المسؤول.${N}" >&2
        echo "${Y}pkexec not available — cannot request admin privileges.${N}" >&2
        return 127
    fi
}

show_status() {
    echo "${C}▸ النظام الحالي | Current system${N}"
    local out=""
    if command -v bootc >/dev/null 2>&1 && out="$(bootc status 2>/dev/null)" && [ -n "$out" ]; then
        echo "$out"
    elif command -v rpm-ostree >/dev/null 2>&1 && out="$(rpm-ostree status 2>/dev/null)" && [ -n "$out" ]; then
        echo "$out"
    else
        echo "${Y}  تعذّر قراءة الحالة (شغّل هذه الأداة داخل MoOS).${N}"
        echo "${Y}  Status unavailable (run this tool on a MoOS system).${N}"
    fi
    echo
}

do_update() {
    if ! command -v bootc >/dev/null 2>&1; then
        echo "${R}bootc غير موجود على هذا النظام | bootc not found${N}"
        return 1
    fi
    echo "${C}جارٍ تجهيز التحديث… قد يظهر طلب إذن المسؤول.${N}"
    echo "${C}Staging update… an admin prompt may appear.${N}"
    if run_priv bootc upgrade; then
        echo "${G}✓ تم تجهيز التحديث بنجاح.${N}"
        echo "${G}  يكتمل عند إعادة التشغيل | applies on reboot${N}"
        echo "${D}  (إن لم يتغيّر شيء فالنظام محدّث بالفعل | if nothing changed, you're already up to date)${N}"
    else
        echo "${Y}لم يكتمل التحديث. | update did not complete.${N}"
    fi
}

do_check() {
    if ! command -v bootc >/dev/null 2>&1; then
        echo "${R}bootc غير موجود على هذا النظام | bootc not found${N}"
        return 1
    fi
    echo "${C}جارٍ الفحص فقط (تنزيل بيانات وصفية بسيطة، بدون تحديث).${N}"
    echo "${C}Checking only (small metadata download, no upgrade). Admin prompt may appear.${N}"
    if run_priv bootc upgrade --check; then
        echo "${D}راجع النتيجة أعلاه — إن توفّر تحديث اختر (1). | see the result above; choose (1) to apply.${N}"
    else
        echo "${Y}تعذّر الفحص. | check failed.${N}"
    fi
}

main() {
    banner
    show_status
    while true; do
        echo "${V}اختر | Choose:${N}"
        echo "  1) تحديث الآن    | Update now"
        echo "  2) فحص فقط       | Check only"
        echo "  3) خروج          | Exit"
        printf '%s' "${V}> ${N}"
        read -r choice || { echo; break; }
        echo
        case "${choice:-}" in
            1) do_update || true ;;
            2) do_check || true ;;
            3|q|Q) echo "${D}مع السلامة | bye${N}"; break ;;
            *) echo "${Y}اختيار غير صحيح | invalid choice${N}" ;;
        esac
        echo
    done
}

main "$@"
