#!/usr/bin/env bash
# moos-devmode-enable — OPT-IN passwordless admin for the MAINTAINER's own machine.
#
# The public MoOS image ships WITHOUT any passwordless-root polkit rule: a released
# OS must ask for authentication before rpm-ostree/bootc/systemctl the same way every
# serious system does. (This is why 50-moos-devmode.rules was removed from
# system_files/ — it was marked "REMOVE BEFORE RELEASE" and it defeated Mo AI's whole
# pkexec-confirmation security model.)
#
# But the maintainer's develop/test loop wants to not type a password every few
# minutes. That convenience is a LOCAL, DELIBERATE choice — not something the shipped
# image imposes on every user. So it lives here, behind an explicit command the owner
# runs once, writing the rule into /etc/polkit-1/rules.d/ (mutable on ostree) instead
# of baking it into the read-only image everyone installs.
#
#   sudo moos-devmode-enable      # turn on passwordless admin for local wheel users
#   sudo moos-devmode-enable off  # turn it back off (delete the rule)
#
# Scope is identical to the old rule: only a session that is local AND active AND in
# `wheel`, and only for the rpm-ostree/bootc D-Bus actions and the exact pkexec-
# launched MoOS admin helpers — never a blanket YES.
set -euo pipefail

RULE=/etc/polkit-1/rules.d/50-moos-devmode.rules

if [ "$(id -u)" != "0" ]; then
    echo "run as root: sudo moos-devmode-enable [off]" >&2
    exit 1
fi

if [ "${1:-on}" = "off" ]; then
    rm -f "$RULE"
    echo "MoOS dev mode OFF — normal authentication restored (deleted $RULE)."
    exit 0
fi

install -d -m 0755 /etc/polkit-1/rules.d
cat > "$RULE" <<'RULE_EOF'
// MoOS — LOCAL developer convenience (opt-in via `moos-devmode-enable`).
// NOT shipped in the image. Lets the local, active, wheel user run MoOS's own
// admin flows without a password. Delete with `moos-devmode-enable off`.
polkit.addRule(function(action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("wheel"))
        return polkit.Result.NOT_HANDLED;
    if (action.id.indexOf("org.projectatomic.rpmostree1.") === 0 ||
        action.id.indexOf("org.freedesktop.bootc") === 0)
        return polkit.Result.YES;
    if (action.id === "org.freedesktop.policykit.exec") {
        var prog = action.lookup("program") || "";
        if (prog === "/usr/bin/bootc" ||
            prog === "/usr/bin/rpm-ostree" ||
            prog === "/usr/bin/systemctl" ||
            prog === "/usr/bin/journalctl" ||
            prog === "/usr/bin/moai-do" ||
            prog.indexOf("/usr/bin/moos-") === 0 ||
            prog.indexOf("/usr/libexec/moos-") === 0)
            return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
RULE_EOF
chmod 0644 "$RULE"
echo "MoOS dev mode ON — local wheel users skip the admin password ($RULE)."
echo "This is a LOCAL choice; the public image never ships it. Undo: moos-devmode-enable off"
