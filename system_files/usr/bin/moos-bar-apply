#!/usr/bin/env bash
# moos-bar-apply — the ONE writer and the ONE verifier of the MoOS Horizon Bar.
#
# The dock is defined in /usr/share/moos/moos-bar.conf (override with
# $MOOS_BAR_CONF). This tool is the only place that turns that definition into a
# running dock: it MERGES every bottom panel into one glass capsule, orders the
# applets, pins the tray's always-shown toggles, migrates the launcher and clock,
# applies the geometry, restarts the shell once per revision, and reads the
# result back from the live desktop. moos-apply-theme calls it for the whole dock
# section; moos-selfcheck calls its check; nothing else writes the bar.
#
# THE BAR IS ONE PANEL. Rev 30 split it into a centred dock capsule and a corner
# system capsule so the task area could hold the true screen centre. On the real
# machine that reads as two detached pieces of glass with a gap between them, and
# the owner rejected it. Rev 33 merges them back and this tool is now the thing
# that GUARANTEES one panel: it folds every extra bottom panel into the canonical
# one on every run, so a stale profile, a half-applied migration or a user
# experiment all converge on a single capsule.
#
# Design notes, so the shape of the code is not a mystery:
#   * Plasma 6 scripting cannot create or delete a panel, so panel-count surgery
#     is file surgery on the appletsrc (Plasma reads it at startup) followed by a
#     plasmashell restart. layout.js seeds ONE panel for new profiles; this tool
#     repairs existing ones.
#   * Panel geometry (floating / lengthMode / thickness) is persisted by Plasma
#     into ~/.config/plasmashellrc, NOT the appletsrc, and only on its own
#     flush. The reliable sequence is: write the appletsrc structure, restart,
#     then apply geometry live through the scripting API and let Plasma persist.
#     A removed panel leaves its [PlasmaViews][Panel N] group behind, so the
#     merge deletes those too or the stale geometry is restored on the next flush.
#   * gdbus unescapes its argument, so a literal backslash inside the JS becomes
#     a real newline and truncates the script. No backslash escapes in the JS.
#   * Add, never remove (dock rule): a MoOS app missing from the user's dock is
#     put back; anything the user pinned or unpinned is left exactly as found.
#     The one exception is a PANEL: an extra bottom panel is always absorbed,
#     never left, because two capsules is the defect this file exists to prevent.
set -uo pipefail

CONF="${MOOS_BAR_CONF:-/usr/share/moos/moos-bar.conf}"
[ -r "$CONF" ] || { echo "moos-bar-apply: no bar definition at $CONF" >&2; exit 3; }

conf() {
    awk -F= -v k="$1" '
        /^\[.*\]$/ { section = $0; sub(/^\[/, "", section); sub(/\]$/, "", section); next }
        $1 == k || (section != "" && section "." $1 == k) {
            sub(/^[^=]*=/, "")
            sub(/^[ \t]*/, "")
            sub(/[ \t]*$/, "")
            print
            exit
        }
    ' "$CONF"
}

BAR_HEIGHT="$(conf bar.height)"
BAR_LENGTH="$(conf bar.lengthMode)"
BAR_ALIGN="$(conf bar.alignment)"
BAR_APPLETS="$(conf bar.applets)"
TRAY_SHOWN="$(conf tray.shownItems)"
TRAY_EXTRA="$(conf tray.extraItems)"
BRAND_APPLET="$(conf brand.applet)"
ISLAND_APPLET="$(conf island.applet)"
TASKS_APPLET="$(conf tasks.applet)"
TRAY_APPLET="$(conf tray.applet)"
CLOCK_APPLET="$(conf clock.applet)"
SEP_APPLET="$(conf separator.applet)"
POPUP_W="$(conf brand.popupWidth)"
POPUP_H="$(conf brand.popupHeight)"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir" 2>/dev/null || true

# Plasma can fire the same autostart entry twice while session restore settles;
# two concurrent splitters on the same appletsrc corrupt it. One owner at a time.
if command -v flock >/dev/null 2>&1; then
    lock_dir="${XDG_RUNTIME_DIR:-$state_dir}"
    mkdir -p "$lock_dir" 2>/dev/null || true
    if exec 9>"${lock_dir}/moos-bar.lock"; then
        flock -n 9 || exit 0
    fi
fi

log="${MOOS_BAR_LOG:-/dev/null}"
applets_rc="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
shell_rc="${XDG_CONFIG_HOME:-$HOME/.config}/plasmashellrc"

plasma_ready() {
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript 'print("moos-ready")' \
            >/dev/null 2>&1 && return 0
    fi
    return 1
}

# The shipped launcher list, with every .desktop that does not exist on this
# machine filtered out (icontasks silently skips a launcher URL it cannot
# resolve, so a stale entry leaves an unexplained hole instead of an error).
shipped_launchers() {
    local dock_shipped="" entry desktop_id
    local IFS=','
    for entry in $(conf tasks.defaultLaunchers); do
        case "$entry" in
            applications:*)
                desktop_id="${entry#applications:}"
                [ -e "/usr/share/applications/${desktop_id}" ] \
                    || [ -e "${XDG_DATA_HOME:-$HOME/.local/share}/applications/${desktop_id}" ] \
                    || continue
                ;;
        esac
        dock_shipped="${dock_shipped}${dock_shipped:+, }\"${entry}\""
    done
    printf '%s\n' "$dock_shipped"
}

# --- The merge ---------------------------------------------------------------
# Folds EVERY bottom panel into one containment and orders its applets the way
# moos-bar.conf lists them. This is what guarantees a single capsule: it runs on
# every apply, so one panel stays one panel and two become one. Idempotent —
# running it again on a merged bar reports "no-change" and rewrites nothing.
# Prints "merged", "reordered", "no-change", "no-dock" or "no-config".
merge_appletsrc() {
    [ -r "$applets_rc" ] || { echo "no-config"; return; }
    cp "$applets_rc" "${applets_rc}.pre-horizon-merge" 2>/dev/null || true
    python3 - "$applets_rc" "$BRAND_APPLET" "$BAR_APPLETS" "$CONF" "$shell_rc" <<'PY' 2>/dev/null
import io, re, sys

path, brand, applet_order, conf_path, shell_rc = sys.argv[1:6]

with io.open(path, "r", encoding="utf-8") as f:
    original = f.read()
lines = original.splitlines(True)

def parts_of(line):
    m = re.match(r"^\[(.*)\]$", line.rstrip("\n"))
    return m.group(1).split("][") if m else None

# Resolve the configured zone order (brand;tasks;...) into plugin ids, so the
# merged panel is ordered by ROLE rather than by whichever panel happened to
# hold each applet. A zone with no applet= line (the reserved smart slot) is
# skipped rather than treated as an empty plugin that matches everything.
zone_plugin, section = {}, None
with io.open(conf_path, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        m = re.match(r"^\[(.+)\]$", line)
        if m:
            section = m.group(1)
        elif section and line.startswith("applet=") and line[7:]:
            zone_plugin[section] = line[7:]
wanted = [zone_plugin[z] for z in applet_order.split(";")
          if z and z in zone_plugin]

# Map every applet to its containment and plugin.
containment_of, plugin_of, top_keys = {}, {}, {}
cur = None
for i, line in enumerate(lines):
    parts = parts_of(line)
    if parts is None:
        continue
    if len(parts) == 2 and parts[0] == "Containments" and parts[1].isdigit():
        cur = parts[1]
        keys = {}
        for j in range(i + 1, len(lines)):
            if parts_of(lines[j]) is not None:
                break
            if "=" in lines[j]:
                k, v = lines[j].split("=", 1)
                keys[k.strip()] = v.strip()
        top_keys[cur] = keys
        continue
    if len(parts) == 4 and parts[0] == "Containments" and parts[2] == "Applets" \
            and parts[1].isdigit() and parts[3].isdigit():
        aid = parts[3]
        containment_of[aid] = parts[1]
        for j in range(i + 1, len(lines)):
            if parts_of(lines[j]) is not None:
                break
            if lines[j].startswith("plugin="):
                plugin_of[aid] = lines[j].split("=", 1)[1].strip()
                break

# location 4 == bottom edge. A panel on another edge is the user's own and is
# never touched; MoOS owns the bottom.
bottom = [cid for cid, keys in top_keys.items()
          if keys.get("plugin") == "org.kde.panel" and keys.get("location") == "4"]
if not bottom:
    sys.stdout.write("no-dock\n")
    sys.exit(0)

# The canonical panel is the one already holding the MoOS launcher, so the
# user's own dock survives and the stray capsule is the one absorbed.
keep = next((containment_of[aid] for aid in containment_of
             if plugin_of.get(aid) == brand and containment_of[aid] in bottom),
            sorted(bottom, key=int)[0])
absorb = [cid for cid in bottom if cid != keep]

def order_of(cid):
    for i, line in enumerate(lines):
        if parts_of(line) == ["Containments", cid, "General"]:
            for j in range(i + 1, len(lines)):
                if parts_of(lines[j]) is not None:
                    break
                if lines[j].startswith("AppletOrder="):
                    return [a for a in lines[j].split("=", 1)[1].strip().split(";") if a]
    return []

merged_order = order_of(keep)
for cid in absorb:
    merged_order += [a for a in order_of(cid) if a not in merged_order]
# Any applet living in one of these panels but missing from every AppletOrder
# would silently vanish from the bar, so sweep them in as well.
merged_order += sorted(
    (aid for aid, cid in containment_of.items()
     if cid in bottom and aid not in merged_order), key=int)

# The media island used to exist only as a nested system-tray applet. Plasma's
# live scripting Applet.index getter returns -1 on this release, so adding it
# after startup cannot reliably place it after the launcher. Create the direct
# applet section while plasmashell is stopped instead; the role sort below then
# writes the exact brand -> island -> tasks order before the shell reads it.
island_plugin = zone_plugin.get("island", "")
if island_plugin and not any(
        plugin_of.get(aid) == island_plugin and containment_of.get(aid) in bottom
        for aid in plugin_of):
    used_ids = {
        int(part)
        for line in lines
        for parts in [parts_of(line)]
        if parts is not None
        for part in parts
        if part.isdigit()
    }
    island_id = str(max(used_ids, default=0) + 1)
    lines.append("\n[Containments][" + keep + "][Applets][" + island_id + "]\n"
                 "plugin=" + island_plugin + "\n")
    containment_of[island_id] = keep
    plugin_of[island_id] = island_plugin
    merged_order.append(island_id)

# Re-order by role: configured zones first in conf order, then anything the user
# added, in the order it already had.
ranked = sorted(
    merged_order,
    key=lambda aid: (wanted.index(plugin_of.get(aid, ""))
                     if plugin_of.get(aid, "") in wanted else len(wanted),
                     merged_order.index(aid)),
)

# Re-home the absorbed applets, then drop the emptied containments entirely.
for aid, cid in list(containment_of.items()):
    if cid in absorb:
        old = "[Containments][" + cid + "][Applets][" + aid + "]"
        new = "[Containments][" + keep + "][Applets][" + aid + "]"
        lines = [ln.replace(old, new) if ln.startswith(old) else ln for ln in lines]

out, drop = [], False
for line in lines:
    parts = parts_of(line)
    if parts is not None:
        drop = (len(parts) >= 2 and parts[0] == "Containments" and parts[1] in absorb)
    if not drop:
        out.append(line)
lines = out

# Write the merged order back onto the surviving panel, creating its [General]
# group if the panel never had one.
wrote = False
for i, line in enumerate(lines):
    if parts_of(line) == ["Containments", keep, "General"]:
        for j in range(i + 1, len(lines)):
            if parts_of(lines[j]) is not None:
                break
            if lines[j].startswith("AppletOrder="):
                lines[j] = "AppletOrder=" + ";".join(ranked) + "\n"
                wrote = True
                break
        if not wrote:
            lines.insert(i + 1, "AppletOrder=" + ";".join(ranked) + "\n")
            wrote = True
        break
if not wrote:
    lines.append("\n[Containments][" + keep + "][General]\n"
                 "AppletOrder=" + ";".join(ranked) + "\n")

# MoOS NEVER SHIPS A DESKTOP ITS OWNER CANNOT ARRANGE.
#
# immutability=1 is Plasma's "Widgets are locked". It does not merely stop a
# drag: it removes Add Widgets, Configure, and every applet's own settings from
# the context menus, so the desk becomes read-only with no visible explanation
# and nothing telling the owner why. Found live on this machine on both the
# panel AND the folder containment, with nothing in this repo setting it — a
# stray lock from an earlier session that had been silently in force ever since,
# which is exactly why "I don't know where to manage the widgets" was the right
# complaint and a colour was never going to answer it.
#
# So every containment is returned to 0 on each apply. This is a REPAIR, not a
# policy: a user who locks their own widgets afterwards keeps that lock until
# the next MoOS revision touches the bar, and locking is one click away in the
# same menu this restores.
unlocked = 0
in_containment = False
for i, line in enumerate(lines):
    parts = parts_of(line)
    if parts is not None:
        in_containment = (len(parts) >= 2 and parts[0] == "Containments"
                          and parts[1].isdigit())
        continue
    if in_containment and line.startswith("immutability=") and line.strip() != "immutability=0":
        lines[i] = "immutability=0\n"
        unlocked += 1

merged = "".join(lines)
if merged == original:
    sys.stdout.write("no-change\n")
    sys.exit(0)

with io.open(path, "w", encoding="utf-8") as f:
    f.write(merged)

# Plasma keeps panel GEOMETRY in plasmashellrc, not here. A removed containment
# leaves its [PlasmaViews][Panel N] group behind; left in place it is dead
# config that reappears in every diff and confuses the next reader.
if absorb:
    try:
        with io.open(shell_rc, "r", encoding="utf-8") as f:
            view_lines = f.read().splitlines(True)
        kept, skip = [], False
        for line in view_lines:
            m = re.match(r"^\[PlasmaViews\]\[Panel (\d+)\]", line.rstrip("\n"))
            if m:
                skip = m.group(1) in absorb
            if not skip:
                kept.append(line)
        if len(kept) != len(view_lines):
            with io.open(shell_rc, "w", encoding="utf-8") as f:
                f.write("".join(kept))
    except (IOError, OSError):
        pass

sys.stdout.write(("merged" if absorb else "reordered") + "\n")
PY
}

# The brand's shell-owned popup geometry must be migrated per existing applet
# instance: QML implicitWidth/Height cannot override a persisted appletsrc value.
migrate_popup_geometry() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    [ -r "$applets_rc" ] || return 0
    local containment_id applet_id
    while read -r containment_id applet_id; do
        [[ "$containment_id" =~ ^[0-9]+$ && "$applet_id" =~ ^[0-9]+$ ]] || continue
        kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
            --group Containments --group "$containment_id" --group Applets \
            --group "$applet_id" --group Configuration --key popupWidth "$POPUP_W"
        kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
            --group Containments --group "$containment_id" --group Applets \
            --group "$applet_id" --group Configuration --key popupHeight "$POPUP_H"
    done < <(
        awk '
            match($0, /^\[Containments\]\[([0-9]+)\]\[Applets\]\[([0-9]+)\]$/, m) {
                containment=m[1]; applet=m[2]; next
            }
            $0 == "plugin='"$BRAND_APPLET"'" && containment != "" && applet != "" {
                print containment, applet
            }
        ' "$applets_rc"
    )
}

# --- The live pass -----------------------------------------------------------
# After the restart, and on every retry, drive the running shell: geometry on
# the one capsule, brand + kickoff-favorites migration + launcher reconcile,
# digitalclock->nova.clock and the tray pin — all on the SAME panel. Prints
# MOOS_BAR_OK=1 only when exactly one bottom panel answered carrying the whole
# bar; a second bottom panel reports bar=split and fails, so the merge retries.
live_pass() {
    local shipped dock_shipped
    shipped="$(shipped_launchers)"
    dock_shipped="${shipped:-}"
    command -v gdbus >/dev/null 2>&1 || { echo "MOOS_BAR_OK=0;tool=no-gdbus"; return 1; }
    command -v timeout >/dev/null 2>&1 || { echo "MOOS_BAR_OK=0;tool=no-timeout"; return 1; }
    local out
    out="$(timeout 12s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var HEIGHT = Number("'"$BAR_HEIGHT"'");
            var SHOWN = "'"$TRAY_SHOWN"'".split(",").filter(function (s) { return s.length > 0; });
            var EXTRA = "'"$TRAY_EXTRA"'".split(",").filter(function (s) { return s.length > 0; });
            var SHIPPED = ['"$dock_shipped"'];
            var HIDE = [
                "org.kde.kdeconnect", "org.kde.plasma.vault", "org.kde.kscreen",
                "org.kde.plasma.battery", "org.kde.plasma.cameraindicator",
                "org.kde.plasma.clipboard", "org.kde.plasma.devicenotifier",
                "org.kde.plasma.keyboardindicator", "org.kde.plasma.manage-inputmethod",
                "org.kde.plasma.mediacontroller", "org.kde.plasma.printmanager",
                "org.kde.plasma.weather",
                "xwaylandvideobridge",
                "Xwayland Video Bridge", "Xwayland-Video-Bruecke",
                "جسر فيديو ويلاند_اكس"
            ];
            var DOCK_APPLET = "'"$BRAND_APPLET"'";
            var ISLAND_APPLET = "'"$ISLAND_APPLET"'";
            var KICKOFF_APPLET = "org.kde.plasma.kickoff";
            var TASKS_APPLET = "'"$TASKS_APPLET"'";
            var TRAY_APPLET = "'"$TRAY_APPLET"'";
            var CLOCK_APPLET = "'"$CLOCK_APPLET"'";
            var DIGITAL_APPLET = "org.kde.plasma.digitalclock";
             var isMoOS = function (u) { return u.indexOf("applications:org.moos.") === 0; };
             // Plasma keeps the desktop runtime lock separate from the
             // appletsrc immutability key. A stale runtime lock makes
             // createApplet fail even when the saved config says mutable.
             var ds = desktops();
             for (var d = 0; d < ds.length; d++) {
                 try { ds[d].locked = false; } catch (e) {}
             }
             var ps = panels();
             for (var p0 = 0; p0 < ps.length; p0++) {
                 try { ps[p0].locked = false; } catch (e0) {}
             }
            var dock = null, bottomCount = 0;
            for (var i = 0; i < ps.length; i++) {
                if (ps[i].location != "bottom") { continue; }
                bottomCount++;
                var ws = ps[i].widgets();
                for (var j = 0; j < ws.length; j++) {
                    if (String(ws[j].type) == DOCK_APPLET) { dock = ps[i]; }
                }
            }
            if (dock == null && bottomCount == 1) {
                for (var i2 = 0; i2 < ps.length; i2++) {
                    if (ps[i2].location == "bottom") { dock = ps[i2]; }
                }
            }
            // MoOS is ONE bottom capsule. More than one means the merge has not
            // been picked up by a real restart yet, so this pass must NOT report
            // success — otherwise the marker is written while the user is still
            // looking at two detached slabs.
            var split = (bottomCount > 1);
            var applied = 0;
            var report = [];
            if (split) { report.push("bar=split;bottom=" + bottomCount); }
            if (dock != null && !split) {
                try { dock.floating = true; } catch (e) {}
                try { dock.lengthMode = "fit"; } catch (e) {}
                try { dock.alignment = "center"; } catch (e) {}
                try { dock.height = HEIGHT; } catch (e) {}
                var brandWidget = null;
                var kickoffWidget = null;
                var ws = dock.widgets();
                for (var k = 0; k < ws.length; k++) {
                    var t = String(ws[k].type);
                    if (t == DOCK_APPLET) { brandWidget = ws[k]; }
                    else if (t == KICKOFF_APPLET) { kickoffWidget = ws[k]; }
                }
                if (brandWidget == null) {
                    try {
                        brandWidget = dock.addWidget(DOCK_APPLET);
                        try { brandWidget.index = 0; } catch (e) {}
                        applied++;
                    } catch (e) {}
                }
                // The island is a direct adaptive zone after the launcher. A
                // stale profile may have no direct instance (the old design
                // loaded it inside the tray), so add exactly one and place it
                // immediately after the brand without disturbing user pins.
                var islandWidget = null;
                var islandScan = dock.widgets();
                for (var ii = 0; ii < islandScan.length; ii++) {
                    if (String(islandScan[ii].type) != ISLAND_APPLET) { continue; }
                    if (islandWidget == null) { islandWidget = islandScan[ii]; }
                    else { try { islandScan[ii].remove(); applied++; } catch (e) {} }
                }
                if (islandWidget == null) {
                    try {
                        islandWidget = dock.addWidget(ISLAND_APPLET);
                        applied++;
                    } catch (e) {}
                }
                for (var m = 0; m < ws.length; m++) {
                    if (String(ws[m].type) != TASKS_APPLET) { continue; }
                    try {
                        ws[m].currentConfigGroup = ["General"];
                        var cur = String(ws[m].readConfig("launchers", ""))
                                      .split(",").filter(function (s) { return s.length > 0; });
                        var out = [];
                        var push = function (u) { if (out.indexOf(u) < 0) { out.push(u); } };
                        for (var n = 0; n < SHIPPED.length; n++) {
                            var u = SHIPPED[n];
                            if (isMoOS(u) || cur.indexOf(u) >= 0) { push(u); }
                        }
                        for (var p = 0; p < cur.length; p++) { push(cur[p]); }
                        if (out.join(",") != cur.join(",")) {
                            ws[m].writeConfig("launchers", out.join(","));
                            ws[m].reloadConfig();
                            applied++;
                        }
                    } catch (e) {}
                }
                if (brandWidget != null) {
                    try {
                        brandWidget.currentConfigGroup = ["General"];
                        if (kickoffWidget != null) {
                            kickoffWidget.currentConfigGroup = ["General"];
                            brandWidget.writeConfig("favoritesClient",
                                "org.kde.plasma.kickoff.favorites.instance-" + kickoffWidget.id);
                            var oldFavorites = String(kickoffWidget.readConfig("favorites", ""));
                            if (oldFavorites.length > 0) {
                                brandWidget.writeConfig("favoriteApps", oldFavorites);
                            }
                            brandWidget.writeConfig("favoritesSeeded", true);
                        } else if (String(brandWidget.readConfig("favoritesClient", "")).length == 0) {
                            brandWidget.writeConfig("favoritesClient", "org.moos.launcher.favorites");
                            applied++;
                        }
                        brandWidget.reloadConfig();
                        if (kickoffWidget != null) {
                            kickoffWidget.remove();
                            applied++;
                        }
                    } catch (e) {}
                }
                // The system zone lives on this SAME capsule. Retiring Plasma
                // digital clock for the MoOS one, and making sure the tray and
                // clock exist at all, belong here rather than on a second panel.
                var ws2 = dock.widgets();
                for (var q = 0; q < ws2.length; q++) {
                    if (String(ws2[q].type) == DIGITAL_APPLET) {
                        try {
                            var idx = ws2[q].index;
                            ws2[q].remove();
                            var nc = dock.addWidget(CLOCK_APPLET);
                            try { nc.index = idx; } catch (e) {}
                            applied++;
                        } catch (e) {}
                    }
                }
                // Removal/addition above mutates the live containment. Read it
                // back before deciding whether the required applets exist.
                ws2 = dock.widgets();
                var hasI = false, hasTasks = false, hasT = false, hasC = false;
                for (var r = 0; r < ws2.length; r++) {
                    var tt = String(ws2[r].type);
                    if (tt == ISLAND_APPLET) { hasI = true; }
                    else if (tt == TASKS_APPLET) { hasTasks = true; }
                    else if (tt == TRAY_APPLET) { hasT = true; }
                    else if (tt == CLOCK_APPLET) { hasC = true; }
                }
                if (!hasI) { try { dock.addWidget(ISLAND_APPLET); applied++; } catch (e) {} }
                if (!hasTasks) { try { dock.addWidget(TASKS_APPLET); applied++; } catch (e) {} }
                if (!hasT) { try { dock.addWidget(TRAY_APPLET); applied++; } catch (e) {} }
                if (!hasC) { try { dock.addWidget(CLOCK_APPLET); applied++; } catch (e) {} }
                var ws3 = dock.widgets();
                var directBrand = 0, directIsland = 0, directTasks = 0;
                var directTray = 0, directClock = 0;
                var directTypesById = {};
                for (var s = 0; s < ws3.length; s++) {
                    var directType = String(ws3[s].type);
                    directTypesById[String(ws3[s].id)] = directType;
                    if (directType == DOCK_APPLET) {
                        directBrand++;
                    } else if (directType == ISLAND_APPLET) {
                        directIsland++;
                    }
                    else if (directType == TASKS_APPLET) { directTasks++; }
                    else if (directType == TRAY_APPLET) { directTray++; }
                    else if (directType == CLOCK_APPLET) { directClock++; }
                    if (String(ws3[s].type) == TRAY_APPLET) {
                        try {
                            ws3[s].currentConfigGroup = ["General"];
                            ws3[s].writeConfig("shownItems", SHOWN.join(","));
                            ws3[s].writeConfig("hiddenItems", HIDE.join(","));
                            // extraItems is the tray LOAD list. shownItems only
                            // controls visibility; it cannot instantiate an inner
                            // applet. The notification id once existed only in
                            // shownItems, leaving its protocol unowned. Merge every
                            // configured inner applet, never replace user additions.
                            var oldKnown = String(ws3[s].readConfig("extraItems", ""))
                                            .split(",").filter(function (e) { return e.length > 0; });
                            // Remove the retired inner-tray island while keeping
                            // every unrelated user addition. Then merge the
                            // canonical load list.
                            var known = oldKnown.filter(function (e) { return e != ISLAND_APPLET; });
                            var changed = known.length != oldKnown.length;
                            for (var x = 0; x < EXTRA.length; x++) {
                                if (known.indexOf(EXTRA[x]) < 0) { known.push(EXTRA[x]); changed = true; }
                            }
                            if (changed) { ws3[s].writeConfig("extraItems", known.join(",")); applied++; }
                            ws3[s].reloadConfig();
                        } catch (e) {}
                    }
                }
                // Plasma 6 reports every panel widget index as -1 and widgets
                // stays in creation order. AppletOrder is the saved visual
                // order, so use it to prove launcher then island adjacency.
                var directVisualTypes = [];
                try {
                    dock.currentConfigGroup = ["General"];
                    var directAppletOrder = String(dock.readConfig("AppletOrder", ""))
                        .split(";").filter(function (e) { return e.length > 0; });
                    directVisualTypes = directAppletOrder.map(function (id) {
                        return directTypesById[id] || "";
                    });
                } catch (e) {}
                var directBrandPosition = directVisualTypes.indexOf(DOCK_APPLET);
                var directIslandPosition = directVisualTypes.indexOf(ISLAND_APPLET);
                if (directBrand == 1 && directIsland == 1 && directTasks == 1
                        && directTray == 1 && directClock == 1
                        && directIslandPosition == directBrandPosition + 1) {
                    report.push("bar=ok");
                } else {
                    report.push("bar=incomplete;brand=" + directBrand
                        + ";island=" + directIsland + ";tasks=" + directTasks
                        + ";tray=" + directTray + ";clock=" + directClock);
                }
            } else if (!split) {
                report.push("bar=missing");
            }
            print("MOOS_BAR_REPORT=" + report.join(";") + ";changed=" + applied);
        ' 2>>"$log")" || out=""
    printf '%s\n' "$out" >>"$log" 2>/dev/null || true
    local report
    report="$(printf '%s\n' "$out" | grep -oE 'MOOS_BAR_REPORT=[^)]*' | head -n1)"
    case "$report" in
        *bar=ok*) echo "MOOS_BAR_OK=1;${report#MOOS_BAR_REPORT=}"; return 0 ;;
        *) echo "MOOS_BAR_OK=0;${report:-no-report}"; return 1 ;;
    esac
}

stop_shell() {
    if systemctl --user is-active plasma-plasmashell.service >/dev/null 2>&1; then
        systemctl --user stop plasma-plasmashell.service >>"$log" 2>&1
    else
        # Session-launched shell, not a systemd unit (startplasma owns it):
        # systemctl on the inactive unit is a silent no-op, so quit the shell
        # ourselves and wait until it is really gone.
        command -v kquitapp6 >/dev/null 2>&1 && kquitapp6 plasmashell >>"$log" 2>&1
        for _ in $(seq 1 30); do
            command -v pgrep >/dev/null 2>&1 || break
            [ -z "$(pgrep -x plasmashell)" ] && break
            sleep 1
        done
        if command -v pgrep >/dev/null 2>&1 && [ -n "$(pgrep -x plasmashell)" ]; then
            kill "$(pgrep -x plasmashell | head -n1)" >>"$log" 2>&1 || true
            sleep 2
        fi
    fi
    pgrep -x plasmashell >/dev/null 2>&1 && return 1
    return 0
}

start_shell() {
    systemctl --user start plasma-plasmashell.service >>"$log" 2>&1 || return 1
    for _ in $(seq 1 30); do
        systemctl --user is-active --quiet plasma-plasmashell.service && break
        sleep 1
    done
    for _ in $(seq 1 60); do plasma_ready && break; sleep 1; done
    # D-Bus becomes available before Plasma has restored containment state.
    # Give the managed shell time to finish loading before the live readback
    # changes runtime locks or applets.
    sleep 8
}

restart_shell() {
    stop_shell
    start_shell
}

cmd_apply() {
    local rev="${1:-0}"
    local marker="${state_dir}/moos-bar-applied.v${rev}"
    plasma_ready || { echo "moos-bar-apply: plasmashell not ready; skipping" >&2; return 0; }
    # The marker means "a restart already landed and the readback agreed". It
    # is ONLY trusted when the live desktop actually shows ONE bottom capsule
    # right now — a stale marker (written before a restart really took, or from
    # an earlier revision, or from the rev-30 two-slab era) must never suppress
    # the work, or the user keeps a split bar while the apply reports done.
    local ok
    if [ -e "$marker" ] && ok="$(live_pass)"; then
        echo "$ok"
        return 0
    fi
    # Order matters: the shell currently running still holds the PRE-merge
    # (two-panel) config in memory, and it FLUSHES that state back over the
    # appletsrc the moment it exits. So the file surgery must run while the
    # shell is DOWN — stop first, merge, then start — or the merge is silently
    # reverted and the desktop keeps both capsules.
    stop_shell || { echo "moos-bar-apply: could not stop plasmashell" >&2; return 1; }
    before="$(merge_appletsrc)" || true
    case "$before" in
        merged|reordered|no-change) : ;;
        no-dock) : ;;
        no-config) echo "moos-bar-apply: no appletsrc to merge" >&2 ;;
    esac
    migrate_popup_geometry >>"$log" 2>&1 || true
    start_shell
    for _ in $(seq 1 12); do
        if ok="$(live_pass)"; then
            mkdir -p "$(dirname "$marker")" 2>/dev/null || true
            touch "$marker" 2>/dev/null || true
            echo "$ok"
            return 0
        fi
        sleep 2
    done
    echo "moos-bar-apply: live readback failed: $ok" >&2
    return 1
}

cmd_check() {
    # Non-destructive: agree with the conf or fail (used by moos-selfcheck).
    local failures=0
    if ! plasma_ready; then
        echo "bar: plasmashell not ready"
        return 1
    fi
    local out
    out="$(timeout 10s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var TRAY_APPLET = "'"$TRAY_APPLET"'";
            var CLOCK_APPLET = "'"$CLOCK_APPLET"'";
            var DOCK_APPLET = "'"$BRAND_APPLET"'";
            var ISLAND_APPLET = "'"$ISLAND_APPLET"'";
            var ps = panels();
             var bottom = 0, whole = 0, align = "", shown = "", extra = "";
             var launcherCount = 0, islandCount = 0, trayCount = 0, clockCount = 0;
            for (var i = 0; i < ps.length; i++) {
                if (ps[i].location != "bottom") { continue; }
                bottom++;
                var ws = ps[i].widgets();
                var hasB = false, hasI = false, hasT = false, hasC = false;
                var typesById = {};
                for (var j = 0; j < ws.length; j++) {
                    var t = String(ws[j].type);
                    typesById[String(ws[j].id)] = t;
                     if (t == DOCK_APPLET) {
                         hasB = true; launcherCount++;
                     } else if (t == ISLAND_APPLET) {
                         hasI = true; islandCount++;
                     }
                     else if (t == TRAY_APPLET) { hasT = true; trayCount++; }
                     else if (t == CLOCK_APPLET) { hasC = true; clockCount++; }
                }
                var visualTypes = [];
                try {
                    ps[i].currentConfigGroup = ["General"];
                    var appletOrder = String(ps[i].readConfig("AppletOrder", ""))
                        .split(";").filter(function (e) { return e.length > 0; });
                    visualTypes = appletOrder.map(function (id) {
                        return typesById[id] || "";
                    });
                } catch (e) {}
                var brandPosition = visualTypes.indexOf(DOCK_APPLET);
                var islandPosition = visualTypes.indexOf(ISLAND_APPLET);
                if (hasB && hasI && hasT && hasC
                        && islandPosition == brandPosition + 1) {
                    whole++;
                    align = String(ps[i].alignment);
                    for (var k = 0; k < ws.length; k++) {
                        if (String(ws[k].type) == TRAY_APPLET) {
                            ws[k].currentConfigGroup = ["General"];
                            shown = String(ws[k].readConfig("shownItems", ""));
                            extra = String(ws[k].readConfig("extraItems", ""));
                        }
                    }
                }
            }
             print("bottom=" + bottom + ";whole=" + whole
                 + ";align=" + align + ";shown=" + shown + ";extra=" + extra
                 + ";launcher=" + launcherCount + ";island=" + islandCount
                 + ";tray=" + trayCount
                 + ";clock=" + clockCount);
        ' 2>/dev/null)" || out=""
    local report
    report="$(printf '%s\n' "$out" | grep -oE 'bottom=[0-9]+;whole=[0-9]+;align=[a-z]*;shown=.*' | head -n1)"
    [ -n "$report" ] || { echo "bar: no live report"; return 1; }
    local bottom whole align shown extra shown_norm want_norm launcher island tray clock item
    bottom="$(printf '%s' "$report" | sed -n 's/.*bottom=\([0-9]*\).*/\1/p')"
    whole="$(printf '%s' "$report" | sed -n 's/.*whole=\([0-9]*\).*/\1/p')"
    align="$(printf '%s' "$report" | sed -n 's/.*align=\([a-z]*\).*/\1/p')"
    shown="$(printf '%s' "$report" | sed -n 's/.*shown=\([^;]*\).*/\1/p')"
    extra="$(printf '%s' "$report" | sed -n 's/.*extra=\([^;]*\).*/\1/p')"
    launcher="$(printf '%s' "$report" | sed -n 's/.*;launcher=\([0-9]*\).*/\1/p')"
    island="$(printf '%s' "$report" | sed -n 's/.*;island=\([0-9]*\).*/\1/p')"
    tray="$(printf '%s' "$report" | sed -n 's/.*;tray=\([0-9]*\).*/\1/p')"
    clock="$(printf '%s' "$report" | sed -n 's/.*;clock=\([0-9]*\).*/\1/p')"
    shown_norm="$(printf '%s' "$shown" | tr ',' '\n' | sed '/^[[:space:]]*$/d' | sort | tr '\n' ',')"
    want_norm="$(printf '%s' "$TRAY_SHOWN" | tr ',' '\n' | sed '/^[[:space:]]*$/d' | sort | tr '\n' ',')"
    # ONE bottom panel, and it carries the WHOLE bar. Two capsules is the exact
    # regression this check exists to catch.
    [ "$bottom" = "1" ] || { echo "bar: $bottom bottom panels — the bar must be ONE capsule"; failures=$((failures+1)); }
    [ "$whole" = "1" ] || { echo "bar: no single panel holds launcher + island + tray + clock together"; failures=$((failures+1)); }
    [ "$launcher" = "1" ] || { echo "bar: launcher count is '$launcher' (want 1)"; failures=$((failures+1)); }
    [ "$island" = "1" ] || { echo "bar: direct media island count is '$island' (want 1)"; failures=$((failures+1)); }
    [ "$tray" = "1" ] || { echo "bar: tray count is '$tray' (want 1)"; failures=$((failures+1)); }
    [ "$clock" = "1" ] || { echo "bar: clock count is '$clock' (want 1)"; failures=$((failures+1)); }
    [ "$align" = "$BAR_ALIGN" ] || { echo "bar: alignment is '$align' (want $BAR_ALIGN)"; failures=$((failures+1)); }
    [ "$shown_norm" = "$want_norm" ] || {
        echo "bar: tray shownItems drift: live '$shown_norm' vs conf '$want_norm'"
        failures=$((failures+1))
    }
    while IFS= read -r item; do
        [ -n "$item" ] || continue
        case ",$extra," in
            *",$item,"*) : ;;
            *) echo "bar: tray inner applet '$item' is not loaded via extraItems"
               failures=$((failures+1)) ;;
        esac
    done < <(printf '%s' "$TRAY_EXTRA" | tr ',' '\n')
    case ",$extra," in
        *",$ISLAND_APPLET,"*)
            echo "bar: retired tray copy of '$ISLAND_APPLET' is still loaded"
            failures=$((failures+1))
            ;;
    esac
    # Static config used to pass while notification calls waited for D-Bus
    # activation to time out. A healthy tray must own the protocol now.
    if ! timeout 3s gdbus call --session -d org.freedesktop.Notifications \
        -o /org/freedesktop/Notifications \
        -m org.freedesktop.Notifications.GetServerInformation \
        >/dev/null 2>&1; then
        echo "bar: notification protocol has no live owner"
        failures=$((failures+1))
    fi
    [ "$failures" = "0" ] && { echo "bar: ok"; return 0; }
    return 1
}

cmd_get() {
    local key="${1:-}"
    local value
    value="$(conf "$key")"
    if [ -n "$value" ]; then
        printf '%s\n' "$value"
        return 0
    fi
    return 1
}

case "${1:-}" in
    apply) cmd_apply "${2:-0}" ;;
    check) cmd_check ;;
    get) cmd_get "${2:-}" ;;
    *)
        echo "usage: moos-bar-apply {apply [rev]|check|get <section.key>}" >&2
        exit 2
        ;;
esac
