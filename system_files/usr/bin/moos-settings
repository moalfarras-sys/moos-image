#!/usr/bin/env bash
# One settings window: Plasma's native KCM host and its real modules.
# MoOS-specific pages live in kcm_moos beside display, network and sound.
set -euo pipefail

section=overview
for arg in "$@"; do
    case "$arg" in
        --section=home|--section=system) section=overview ;;
        --section=update) section=update ;;
        --section=recovery) section=recovery ;;
        --section=remote) section=remote ;;
        --section=about) section=about ;;
        --section=whats-new) section=whats-new ;;
        --section=appearance) exec systemsettings kcm_lookandfeel ;;
        --section=connectivity) exec systemsettings kcm_networkmanagement ;;
        --section=devices) exec systemsettings kcm_kscreen ;;
        --section=apps) exec systemsettings kcm_componentchooser ;;
        --section=privacy) exec systemsettings kcm_app-permissions ;;
        --section=*) echo "MoOS Settings: unknown section" >&2; exit 2 ;;
        *) echo "MoOS Settings: unknown option" >&2; exit 2 ;;
    esac
done

# System Settings is a single-instance app. A later launch forwards its KCM id
# to the existing process, but not this process's environment. Send a fixed,
# per-user page request to the already loaded KCM as well.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    request_dir="${XDG_RUNTIME_DIR}/moos-settings"
    ( umask 077
      mkdir -p "$request_dir"
      request_file="$(mktemp "$request_dir/.request.XXXXXX")"
      printf '%s\n' "$section" > "$request_file"
      mv -f "$request_file" "$request_dir/request"
    )
fi
export MOOS_SETTINGS_SECTION="$section"
exec systemsettings kcm_moos
