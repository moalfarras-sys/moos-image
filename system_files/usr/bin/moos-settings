#!/usr/bin/env bash
# MoOS Settings is the system's own settings window. Every MoOS page is a native
# module of its MoOS group (the kcm_moos* plugins built from moos-settings-kcm/),
# beside display, network and sound, so a section name here is only a stable alias
# for a module id. systemsettings is single-instance: a later `systemsettings <id>`
# hands the id to the window that is already open, which is the whole deep link.
set -euo pipefail

module=kcm_moos
for arg in "$@"; do
    case "$arg" in
        --section=overview|--section=home|--section=system|--section=about) module=kcm_moos ;;
        --section=update) module=kcm_moos_update ;;
        --section=whats-new) module=kcm_moos_whatsnew ;;
        --section=assistant) module=kcm_moos_ai ;;
        --section=remote) module=kcm_moos_remote ;;
        --section=recovery) module=kcm_moos_recovery ;;
        --section=appearance|--section=themes|--section=wallpaper) module=kcm_moos_appearance ;;
        --section=connectivity) module=kcm_networkmanagement ;;
        --section=devices) module=kcm_kscreen ;;
        --section=apps) module=kcm_componentchooser ;;
        --section=privacy) module=kcm_app-permissions ;;
        --section=*) echo "MoOS Settings: unknown section" >&2; exit 2 ;;
        *) echo "MoOS Settings: unknown option" >&2; exit 2 ;;
    esac
done

# No section has a stand-in: the image build requires every MoOS module
# (moos-settings-kcm/CMakeLists.txt and verify_settings_modules.sh), so a missing one
# fails there, loudly, instead of an entry quietly landing on some other page.
exec systemsettings "$module"
