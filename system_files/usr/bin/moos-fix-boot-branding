#!/usr/bin/env bash
# Read-only boot identity audit by default. --apply changes only the firmware's
# visible entry label and Plymouth; bootupd owns grub.cfg on installed MoOS.
set -uo pipefail

mode="${1:-}"
case "$mode" in
    ""|--apply) ;;
    *) echo "usage: moos-fix-boot-branding [--apply]" >&2; exit 2 ;;
esac
[ "$mode" != "--apply" ] || [ "$(id -u)" = 0 ] || {
    echo "moos-fix-boot-branding: --apply requires sudo" >&2
    exit 1
}

# Keep the legacy vendor label out of all user-facing output. These values are
# technical matching keys only: the installed shim path cannot be renamed.
foreign_label="$(printf '\106\145\144\157\162\141')"
foreign_dir="$(printf '\146\145\144\157\162\141')"

heading() { printf '\n### %s\n' "$1"; }
state() { printf '  %s\n' "$1"; }

printf 'MoOS boot identity audit (%s)\n' "$([ "$mode" = --apply ] && printf apply || printf read-only)"

heading "Plymouth"
active_theme="$(plymouth-set-default-theme 2>/dev/null || true)"
if [ "$active_theme" = moos ]; then state "active theme: MoOS"
else state "active theme is not MoOS"
fi

heading "Firmware entry"
foreign_count="$(efibootmgr 2>/dev/null | grep -icE "Boot[0-9A-F]{4}\*? +${foreign_label}$" || true)"
moos_count="$(efibootmgr 2>/dev/null | grep -icE 'Boot[0-9A-F]{4}\*? +MoOS$' || true)"
state "MoOS entries: ${moos_count}; foreign entries requiring rename: ${foreign_count}"

heading "Boot configuration"
foreign_cfg=0
for cfg in /boot/grub2/grub.cfg /boot/efi/EFI/*/grub.cfg; do
    [ -f "$cfg" ] || continue
    if grep -qi "$foreign_label" "$cfg" 2>/dev/null; then foreign_cfg=$((foreign_cfg + 1)); fi
done
state "configs containing foreign visible identity: ${foreign_cfg}"
state "menu configuration owner: bootupd (static; no grub2-mkconfig)"

heading "System identity"
if grep -q '^NAME="MoOS"$' /etc/os-release 2>/dev/null; then state "os-release: MoOS"
else state "os-release is not MoOS"
fi

if [ "$mode" != "--apply" ]; then
    printf '\nRead-only audit complete. Use sudo moos-fix-boot-branding --apply only to\n'
    printf 'rename a foreign firmware entry and repair Plymouth. The static bootupd menu\n'
    printf 'is deliberately not regenerated by this tool.\n'
    exit 0
fi

heading "Applying safe identity repairs"

# Create the replacement entry first and verify it is visible before removing
# the old label. The signed loader path is deliberately unchanged.
foreign_line="$(efibootmgr 2>/dev/null | grep -iE "Boot[0-9A-F]{4}\*? +${foreign_label}$" | head -1)"
if [ -n "$foreign_line" ]; then
    number="$(printf '%s\n' "$foreign_line" | sed -E 's/^Boot([0-9A-Fa-f]{4}).*/\1/')"
    esp_source="$(findmnt -nro SOURCE /boot/efi 2>/dev/null || true)"
    parent="$(lsblk -nro PKNAME "$esp_source" 2>/dev/null | head -1)"
    partition="$(lsblk -nro PARTN "$esp_source" 2>/dev/null | head -1)"
    loader="\\EFI\\${foreign_dir}\\shimx64.efi"
    if [ -n "$parent" ] && [ -n "$partition" ] && \
       efibootmgr -c -d "/dev/${parent}" -p "$partition" -L MoOS -l "$loader" >/dev/null 2>&1; then
        if efibootmgr 2>/dev/null | grep -qE 'Boot[0-9A-F]{4}\*? +MoOS$'; then
            if efibootmgr -b "$number" -B >/dev/null 2>&1; then
                state "firmware entry renamed to MoOS"
            else
                state "new MoOS entry verified; old label retained because removal failed"
            fi
        else
            state "replacement entry could not be verified; old entry retained"
        fi
    else
        state "firmware disk/partition could not be resolved; old entry retained"
    fi
else
    state "no foreign firmware entry found"
fi

if [ "$active_theme" != moos ]; then
    if plymouth-set-default-theme -R moos >/dev/null 2>&1; then
        state "Plymouth repaired and initramfs regenerated"
    else
        state "Plymouth repair failed; inspect before reboot"
        exit 1
    fi
else
    state "Plymouth already uses MoOS; initramfs left untouched"
fi

printf '\nSafe repairs complete. No bootupd or GRUB configuration was rewritten.\n'
