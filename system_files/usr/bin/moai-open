#!/usr/bin/env bash
# =============================================================================
# moai-open — open a desktop app / run a command DETACHED, so it keeps running
# after the Telegram agent's exec turn ends and after openclaw-gateway stops.
#
# WHY: openclaw-gateway.service uses the default KillMode=control-group. Anything
# the agent spawns directly (e.g. `firefox`) lands in the gateway's own systemd
# cgroup, so the moment openclaw-idle stops the gateway — or the gateway restarts
# — systemd tears down the whole cgroup and the app dies with it. That is exactly
# the "the program the bot opens closes by itself" bug. systemd-run --user starts
# the command in its OWN transient unit/cgroup, owned by the user manager, immune
# to the gateway's lifecycle.
#
# Usage: moai-open [--app] <command> [args...]     e.g.  moai-open firefox
#        moai-open xdg-open https://…       moai-open kate /etc/hosts
# --app is the Store's graphical launch path: stop with the desktop and refuse
# a missing user manager rather than pretending setsid escapes a job cgroup.
# =============================================================================
set -uo pipefail

open_as_app=0
if [ "${1:-}" = "--app" ]; then open_as_app=1; shift; fi
[ $# -ge 1 ] || { echo "usage: moai-open [--app] <command> [args...]" >&2; exit 2; }

uid="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
# The user manager can retain a dead socket from the preceding Plasma session.
# Resolve a compositor that accepts connections; never guess wayland-0.
if resolved_wayland="$(/usr/libexec/moos-wayland-display 2>/dev/null)"; then
    export WAYLAND_DISPLAY="$resolved_wayland"
else
    unset WAYLAND_DISPLAY
fi

# An assistant/SSH process is outside the graphical login PAM environment. KWin's
# wrapper publishes DISPLAY and XAUTHORITY into the systemd user manager when
# Xwayland starts, but an empty shell variable used to overwrite both with
# nothing. Wayland-native apps opened; compatibility apps accepted the launch
# and immediately exited because they could not authenticate to :0. Read the
# live session values from their owner rather than guessing a display number.
if [ -z "${DISPLAY:-}" ] || [ -z "${XAUTHORITY:-}" ]; then
    manager_environment="$(systemctl --user show-environment 2>/dev/null || true)"
    while IFS= read -r environment_line; do
        case "$environment_line" in
            DISPLAY=*) [ -n "${DISPLAY:-}" ] || DISPLAY="${environment_line#DISPLAY=}" ;;
            XAUTHORITY=*) [ -n "${XAUTHORITY:-}" ] || XAUTHORITY="${environment_line#XAUTHORITY=}" ;;
        esac
    done <<< "$manager_environment"
fi
export DISPLAY="${DISPLAY:-}"
export XAUTHORITY="${XAUTHORITY:-}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

unit="moai-open-$$-${RANDOM}"
launch_properties=(--property=ExitType=cgroup)
if [ "$open_as_app" -eq 1 ]; then
    launch_properties+=(--property=PartOf=graphical-session.target)
fi
launch_error=""

if command -v systemd-run >/dev/null 2>&1; then
    if launch_error="$(systemd-run --user --collect --quiet --service-type=exec --unit="${unit}" \
            "${launch_properties[@]}" \
            --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
            --setenv=DISPLAY="${DISPLAY}" \
            --setenv=XAUTHORITY="${XAUTHORITY}" \
            --setenv=XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
            --setenv=DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}" \
            -- "$@" 2>&1)"; then
        echo "opened (detached unit ${unit}): $*"
        exit 0
    fi
fi

if [ "$open_as_app" -eq 1 ]; then
    echo "تعذّر فتح التطبيق في جلسة سطح المكتب. | Could not start the app in the desktop session." >&2
    [ -z "$launch_error" ] || printf '%s\n' "$launch_error" >&2
    exit 1
fi

# Fallback: a brand-new session, fully disconnected from this process tree.
setsid -f "$@" >/dev/null 2>&1 </dev/null && echo "opened (setsid): $*"
