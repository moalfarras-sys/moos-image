#!/usr/bin/env bash
# moai — launch Mo AI (pure-QML script app, no compilation).
#
#   moai                  the assistant
#   moai --panel device   open straight onto a panel (device|apps|compat|remote|dev|chat)
#   moai --device         alias for --panel device
#
# QML runtime on Fedora (VERIFIED 2026-07-10 via packages.fedoraproject.org):
#   - /usr/bin/qml-qt6 is the Qt6 QML runtime (symlink shipped by
#     qt6-qtdeclarative-devel; the real binary is /usr/lib64/qt6/bin/qml).
#   - Fedora ships NO plain 'qml6' binary — it is kept in the fallback chain
#     only as a just-in-case for other distros/future renames.
# NOTE: the base qt6-qtdeclarative package does NOT contain the runtime; the
# image must include qt6-qtdeclarative-devel for Mo AI to launch.
set -uo pipefail

MAIN_QML="/usr/share/moos/apps/moai/main.qml"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"

# ── Why this is not just `rm -rf qmlcache` ───────────────────────────────────
# OSTree pins every mtime under /usr to the epoch, so Qt's QML disk cache — which
# invalidates on mtime — is NEVER invalidated when a `bootc upgrade` ships a new
# main.qml. Mo AI would keep rendering the STALE compiled QML from the user's
# first install; that is why it "never changed" across updates.
#
# The previous fix was to delete the whole cache on every launch, which cured the
# staleness by throwing away the cache entirely: every start paid a full QML
# recompile, forever. Key it on the CONTENT of the file instead. A content hash
# is immune to the epoch-mtime problem, so the cache is dropped exactly once —
# the first launch after the UI actually changed — and every later start is warm.
if command -v sha256sum >/dev/null 2>&1 && [ -r "$MAIN_QML" ]; then
    stamp_file="${CACHE}/moai.qmlstamp"
    current="$(sha256sum "$MAIN_QML" 2>/dev/null | cut -c1-32)"
    if [ -n "$current" ] && [ "$(cat "$stamp_file" 2>/dev/null)" != "$current" ]; then
        rm -rf "${CACHE}/qmlcache" 2>/dev/null || true
        mkdir -p "$CACHE" 2>/dev/null || true
        printf '%s\n' "$current" > "$stamp_file" 2>/dev/null || true
    fi
else
    # No way to hash it — fall back to the old, always-correct, always-slow path.
    export QML_DISABLE_DISK_CACHE=1
fi

# Log QML output so a silent failure ("the app didn't open") is diagnosable at
# ~/.cache/moai.log instead of vanishing into the session.
LOG="${CACHE}/moai.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

# The app always talks to 127.0.0.1:8080, which is moai-gateway — the always-on
# front door, and the ONLY thing on that port. It routes each request to the
# selected allowlisted local engine (starting it on demand) or to the configured
# cloud provider, whose API key it alone ever sees. The app names the brain it
# wants in the request itself, so the launcher passes nothing engine-specific.
#
# Run under moos-qml-shell, NOT the bare qml-qt6 runtime. The runtime derives the
# Wayland app_id from its own executable name — org.qt-project.qml-qt6 — and
# Plasma, unable to match that to org.moos.moai.desktop, drew the generic green Qt
# diamond in the taskbar instead of the Mo AI orb. moos-qml-shell exists purely to
# call QGuiApplication::setDesktopFileName() before the window is created; the
# runtime offers no flag for it. Keep --app-id equal to the .desktop file's base
# name or the icon silently reverts to the Qt one.
if [ -x /usr/bin/moos-qml-shell ]; then
    echo "=== moai launch $(date -u '+%Y-%m-%dT%H:%M:%SZ') via moos-qml-shell ===" >>"$LOG" 2>/dev/null || true
    # Forward argv after `--` so `moai --panel device` reaches the app. That is how
    # moos-hardware and moos-compat land inside Mo AI instead of being separate
    # windows onto the same data.
    exec /usr/bin/moos-qml-shell \
        --app-id org.moos.moai --icon moos-moai --qml "$MAIN_QML" \
        -- "$@" 2> >(tee -a "$LOG" >&2)
fi

# Fallback: the app still opens, it just wears the wrong icon. Better a Mo AI with
# a Qt logo than no Mo AI.
for runner in qml-qt6 /usr/lib64/qt6/bin/qml qml6 qml; do
    if command -v "$runner" >/dev/null 2>&1; then
        echo "=== moai launch $(date -u '+%Y-%m-%dT%H:%M:%SZ') via $runner (no moos-qml-shell: icon will be wrong) ===" >>"$LOG" 2>/dev/null || true
        exec "$runner" "$MAIN_QML" -- "$@" 2> >(tee -a "$LOG" >&2)
    fi
done

echo "moai: لم يتم العثور على مشغّل QML | no QML runtime found" >&2
echo "moai: tried: moos-qml-shell, qml-qt6, /usr/lib64/qt6/bin/qml, qml6, qml" >&2
echo "moai: ثبّته | install it:  sudo rpm-ostree install qt6-qtdeclarative-devel" >&2
exit 1
