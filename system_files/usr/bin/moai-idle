#!/usr/bin/env bash
# =============================================================================
# moai-idle — unload the Mo AI local brain when it has been idle, to free VRAM.
# =============================================================================
# WHY: the local model (RamaLama/llama-server, moai.service) loads ~6 GB into the
# GPU and never releases it while the unit is up. On an 8 GB card that leaves the
# compositor almost nothing — a maximised browser on top of a loaded brain has
# exhausted VRAM, made the NVIDIA driver log `NVRM: VM: invalid mmap context`, and
# CRASHED kwin_wayland, freezing the whole desktop. So the brain must not sit loaded
# while nobody is chatting.
#
# moai-gateway writes $XDG_RUNTIME_DIR/moai-activity on every local chat request.
# moai-idle.timer runs this every few minutes: if the brain is up and that stamp is
# older than the idle window, it stops the unit. moai-gateway's ensure_local() starts
# the brain again on the next request, so the only cost of unloading is a one-time
# model reload on the next message — cheap next to a frozen desktop.
# =============================================================================
set -uo pipefail

ENGINE_HELPER="/usr/libexec/moai-local-engine"
UNIT="$("$ENGINE_HELPER" unit)"
BACKEND="$("$ENGINE_HELPER" backend)"
LOCAL_PORT="$("$ENGINE_HELPER" port)"
IDLE_MIN="${MOAI_IDLE_MINUTES:-15}"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
ACT="${runtime}/moai-activity"

# Nothing to free unless the brain is actually loaded.
systemctl --user is-active --quiet "$UNIT" || exit 0

# openclaw-idle owns teardown order for the phone-agent stack: gateway first,
# then speech, then Ollama. The two timers can fire in either order. If this
# desktop-only idle checker stopped a local-primary Ollama while OpenClaw was
# still active, ExecStartPre would not rerun and the next Telegram turn would
# hit a dead backend. Defer to openclaw-idle unless the phone agent is explicitly
# cloud-primary and therefore does not depend on this local engine.
if [ "$BACKEND" = "ollama" ] \
        && systemctl --user is-active --quiet openclaw-gateway.service; then
    openclaw_primary="$(python3 -c 'import json,os
try:
    print((json.load(open(os.path.expanduser("~/.openclaw/openclaw.json"))).get("agents",{}).get("defaults",{}).get("model",{}) or {}).get("primary",""))
except Exception:
    print("")' 2>/dev/null)"
    case "$openclaw_primary" in
        cloud/*) : ;;
        *) exit 0 ;;
    esac
fi

# Gateway activity covers desktop chats.  Ollama can also be serving OpenClaw,
# so never stop it while its own API says a model is resident.
if [ "$BACKEND" = "ollama" ]; then
    resident="$(curl -sf --max-time 4 "http://127.0.0.1:${LOCAL_PORT}/api/ps" 2>/dev/null \
        | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("models",[])))' \
        2>/dev/null || echo unknown)"
    case "$resident" in
        0) : ;;
        *) exit 0 ;;
    esac
fi

now="$(date +%s)"

if [ -f "$ACT" ]; then
    last="$(stat -c %Y "$ACT" 2>/dev/null || echo "$now")"
else
    # The brain is up but no chat has ever stamped the file — it was started by hand
    # (moai-start) or this is the first tick after boot. Give it one idle window from
    # now instead of yanking it out from under the user; the next tick measures for real.
    : > "$ACT" 2>/dev/null || true
    exit 0
fi

# A fresh start counts as activity. The stamp records the last CHAT, so a brain
# started seconds ago (by hand, by the picker, by ensure_local) still wears the
# stamp of a conversation from hours back — and this checker killed it two
# seconds after start (seen live 2026-07-17: Started 04:52:00, Stopping
# 04:52:02). Idle is measured from whichever is newer: the last chat, or the
# unit's own ActiveEnterTimestamp.
started="$(systemctl --user show "$UNIT" -p ActiveEnterTimestamp --value 2>/dev/null)"
if [ -n "$started" ]; then
    start_s="$(date -d "$started" +%s 2>/dev/null || echo 0)"
    [ "$start_s" -gt "$last" ] && last="$start_s"
fi

idle=$(( now - last ))
if [ "$idle" -ge $(( IDLE_MIN * 60 )) ]; then
    if systemctl --user stop "$UNIT"; then
        logger -t moai-idle "stopped $UNIT after ${idle}s idle — freed the local model's VRAM" 2>/dev/null || true
    fi
fi
exit 0
