#!/usr/bin/env bash
# moos-selfcheck — is this desktop actually working?
#
#   moos-selfcheck          human report, exit 1 if anything is broken
#   moos-selfcheck --quiet  only the failures
#
# WHY THIS EXISTS
#
# Every gate in this repo is STATIC: it reads files in system_files/ and asks
# whether the image is right. That is necessary and it is not sufficient — the
# dominant bug family in MoOS is "the image is right and the user still does not
# get it". A config in ~/.config outranks /etc/xdg. A cache keyed on mtime never
# invalidates, because OSTree pins every mtime under /usr to the epoch. A daemon
# nothing starts is a daemon that is not running. Every one of those leaves the
# build green and the desktop broken.
#
# So this asks the RUNNING system, and only the running system. kreadconfig6, not
# the file the image shipped. fc-match, not the fontconfig rule. curl, not the
# systemd unit. If a check here cannot be answered from live state, it does not
# belong in this file.
#
# It is deliberately quiet about things it cannot know. A check that guesses is
# worse than no check: it teaches you to ignore the output.
set -uo pipefail

QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1

pass=0
fail=0
warn=0

ok()   { pass=$((pass+1)); [ "$QUIET" = 1 ] || printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { fail=$((fail+1)); printf '  \033[31m✗\033[0m %s\n' "$1"; }
note() { warn=$((warn+1)); [ "$QUIET" = 1 ] || printf '  \033[33m!\033[0m %s\n' "$1"; }
head_() { [ "$QUIET" = 1 ] || printf '\n\033[1m%s\033[0m\n' "$1"; }

# ── The image ────────────────────────────────────────────────────────────────
head_ "النظام | System"
booted="$(rpm-ostree status --booted 2>/dev/null | grep -oP 'Version: \K\S+' | head -1)"
[ -n "$booted" ] && ok "booted MoOS ${booted}" || note "could not read the booted deployment"

if staged="$(rpm-ostree status 2>/dev/null | grep -c 'Version:')" && [ "${staged:-0}" -gt 0 ]; then
    if rpm-ostree status 2>/dev/null | head -6 | grep -q 'Version:' && \
       ! rpm-ostree status --booted 2>/dev/null | grep -q "$(rpm-ostree status 2>/dev/null | grep -oP 'Version: \K\S+' | head -1)"; then
        note "a newer deployment is staged — reboot to run it"
    fi
fi

# ── Nothing is on fire ───────────────────────────────────────────────────────
head_ "الوحدات الفاشلة | Failed units"

# `systemctl --failed --no-legend` puts a "●" in column 1, so the unit name is $2.
# Printing $1 gives you a row of bullets and tells you nothing — which is exactly
# what the first version of this did.
#
# drkonqi-coredump-processor@… is EXCLUDED, and only that one. It is a transient
# per-crash unit: one instance is spawned for every core dump on the machine, and a
# failed instance means "the crash handler could not hand this dump to a session",
# not "the system is broken". They accumulate after any crash, they clear on reboot,
# and counting them buries the real failures under noise. Everything else counts.
failed_units() {
    systemctl ${1:+--user} --failed --no-legend 2>/dev/null \
        | awk '{print $2}' \
        | grep -v '^drkonqi-coredump-processor@'
}
sys_failed="$(failed_units | grep -c . || true)"
usr_failed="$(failed_units user | grep -c . || true)"
[ "${sys_failed:-0}" -eq 0 ] && ok "no failed system units" \
    || bad "${sys_failed} failed system unit(s): $(failed_units | tr '\n' ' ')"
[ "${usr_failed:-0}" -eq 0 ] && ok "no failed user units" \
    || bad "${usr_failed} failed user unit(s): $(failed_units user | tr '\n' ' ')"

# ── The look ─────────────────────────────────────────────────────────────────
# Read back from the desktop, never from the file the image shipped: ~/.config and
# ~/.config/kdedefaults BOTH outrank /etc/xdg, and Plasma writes to them.
head_ "المظهر | Theme"
lnf="$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)"
deco="$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme 2>/dev/null)"
scheme="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)"
icons="$(kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null)"
style="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)"

case "$lnf" in
    org.moos.ui2)
        want_deco=__aurorae__svg__MoOSUI2; want_sch=MoOSUI2Dark; want_ico=MoOSUI2
        want_sty=MoOSUI2; want_wall=MoOSUI2Graphite
        pair_dark=org.moos.ui2; pair_light=org.moos.ui2.light; family=ui2
        mode="UI2 غرافيت | Graphite Dark"
        ;;
    org.moos.ui2.light)
        want_deco=__aurorae__svg__MoOSUI2Light; want_sch=MoOSUI2Light; want_ico=MoOSUI2Light
        want_sty=MoOSUI2Light; want_wall=MoOSUI2Tide
        pair_dark=org.moos.ui2; pair_light=org.moos.ui2.light; family=ui2
        mode="UI2 تركواز | Tidal Light"
        ;;
    # There is one MoOS look now (dark + light). The older Nova and UI generations no longer ship,
    # so anything that is not one of the two halves above is simply "not a MoOS look".
    *) want_deco=""; want_wall=""; pair_dark=""; pair_light=""; family=""; mode="" ;;
esac

if [ -z "$want_deco" ]; then
    bad "the desktop is NOT wearing a MoOS theme (LookAndFeelPackage='${lnf:-unset}')"
else
    ok "MoOS theme: ${mode}"
    [ "$deco"   = "$want_deco" ] && ok "window decoration matches" || bad "decoration is '${deco:-unset}', expected ${want_deco}"
    [ "$scheme" = "$want_sch"  ] && ok "colour scheme matches"     || bad "colour scheme is '${scheme:-unset}', expected ${want_sch}"
    [ "$icons"  = "$want_ico"  ] && ok "icon theme matches"        || bad "icon theme is '${icons:-unset}', expected ${want_ico}"
    [ "$style"  = "$want_sty"  ] && ok "Plasma style matches"      || bad "Plasma style is '${style:-unset}', expected ${want_sty}"
fi

# Plasma's day/night switch is a PAIR.  Merely proving that two arbitrary names
# exist is not enough: UI2 Dark beside UI1 Light is a mixed theme, and a missing
# name sends Plasma to Breeze and persists that choice in the user's own config.
default_dark="$(kreadconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel 2>/dev/null)"
default_light="$(kreadconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel 2>/dev/null)"
if [ -n "$pair_dark" ]; then
    [ "$default_dark" = "$pair_dark" ] \
        && ok "automatic dark target is UI2: ${default_dark}" \
        || bad "dark target is '${default_dark:-unset}', expected the UI2 safety target ${pair_dark}"
    [ "$default_light" = "$pair_light" ] \
        && ok "automatic light target is UI2: ${default_light}" \
        || bad "light target is '${default_light:-unset}', expected the UI2 safety target ${pair_light}"
    if [ -d "/usr/share/plasma/look-and-feel/$pair_dark" ] && \
       [ -d "/usr/share/plasma/look-and-feel/$pair_light" ]; then
        ok "UI2 Graphite/Tidal automatic pair is installed"
    else
        bad "the UI2 automatic dark/light pair is incomplete under /usr/share/plasma/look-and-feel"
    fi
fi

# Both UI2 halves and the dashboard are image assets, even while the user has
# explicitly selected UI1 for rollback.  Check the load-bearing representatives
# of every package rather than trusting that one metadata file implies the rest.
ui2_missing=""
for asset in \
    /usr/share/plasma/look-and-feel/org.moos.ui2/contents/defaults \
    /usr/share/plasma/look-and-feel/org.moos.ui2.light/contents/defaults \
    /usr/share/plasma/desktoptheme/MoOSUI2/widgets/panel-background.svg \
    /usr/share/plasma/desktoptheme/MoOSUI2Light/widgets/panel-background.svg \
    /usr/share/color-schemes/MoOSUI2Dark.colors \
    /usr/share/color-schemes/MoOSUI2Light.colors \
    /usr/share/aurorae/themes/MoOSUI2/MoOSUI2rc \
    /usr/share/aurorae/themes/MoOSUI2Light/MoOSUI2Lightrc \
    /usr/share/konsole/MoOSUI2.profile \
    /usr/share/konsole/MoOSUI2Light.profile \
    /usr/share/wallpapers/MoOSUI2Graphite/contents/images/3840x2160.jpg \
    /usr/share/wallpapers/MoOSUI2Tide/contents/images/3840x2160.jpg \
    /usr/share/plasma/wallpapers/org.moos.ui2.wallpaper/metadata.json \
    /usr/share/plasma/wallpapers/org.moos.ui2.wallpaper/contents/ui/main.qml \
    /usr/share/plasma/wallpapers/org.moos.ui2.wallpaper/contents/ui/DashboardBento.qml \
    /usr/share/plasma/wallpapers/org.moos.ui2.wallpaper/contents/images/weather/storm.png; do
    [ -e "$asset" ] || ui2_missing="${ui2_missing} ${asset}"
done
[ -z "$ui2_missing" ] \
    && ok "UI2 themes, wallpapers, the scene plugin and weather art are installed" \
    || bad "UI2 asset set is incomplete:${ui2_missing}"

# ── The keyboard ─────────────────────────────────────────────────────────────
# Ask the SESSION what it is typing with, not the system what it was told to type with.
#
# This check used to read `localectl`, which reports the SYSTEM default — and that is
# not what the compositor uses. On 2026-07-13 the maintainer could not type Arabic or
# Arabic for two hours: fcitx5 had been launched once, and it had rewritten
# ~/.config/kxkbrc to `LayoutList=us`, which outranks the image's /etc/xdg/kxkbrc. The
# system default was still a flawless "us,ara", so this check stayed GREEN throughout,
# reporting a keyboard the user did not have. (fcitx5 no longer ships — build.sh removes
# it — but a user file can still shadow the image, and that is the thing to detect.)
#
# So: three layers, in order of authority — what KWin actually loaded, then the effective
# config after the XDG cascade, then the system default. The first one that answers wins.
head_ "الكيبورد | Keyboard"
live_layouts="$(gdbus call --session --dest org.kde.KWin --object-path /Layouts \
                --method org.kde.KeyboardLayouts.getLayoutsList 2>/dev/null \
              | grep -oP "\('\K[a-z]+" | paste -sd, -)"
conf_layouts="$(kreadconfig6 --file kxkbrc --group Layout --key LayoutList 2>/dev/null)"
sys_layouts="$(localectl status 2>/dev/null | grep -oP 'X11 Layout: \K.*')"
opts="$(kreadconfig6 --file kxkbrc --group Layout --key Options 2>/dev/null)"

layouts="${live_layouts:-${conf_layouts:-$sys_layouts}}"

# The expectation is READ FROM THE IMAGE, never hardcoded here. This check asserted a
# literal "us,ara" and kept asserting it after the image default deliberately became
# "de,ara" (the owner's keyboard is German). So the check called a CORRECT machine
# broken and told the user to delete a ~/.config/kxkbrc that matched the image exactly
# — the check drifted from the system, and a check that has to be edited in lockstep
# with the thing it checks will always eventually lie. Ask /etc/xdg/kxkbrc what MoOS
# ships and compare the session against that.
image_layouts="$(kreadconfig6 --file /etc/xdg/kxkbrc --group Layout --key LayoutList 2>/dev/null)"
if [ -z "$image_layouts" ]; then
    bad "the image ships no /etc/xdg/kxkbrc LayoutList — MoOS has no default keyboard"
elif [ "$layouts" = "$image_layouts" ]; then
    ok "layouts: ${layouts}${live_layouts:+ (live, from KWin)}"
    # A config-only pass is NOT proof the session types those layouts: the live
    # ISO showed "DE" in config while KWin compiled English (US), and this very
    # check fell back to config and stayed green. Say so instead of implying.
    [ -z "$live_layouts" ] && \
        note "KWin did not answer getLayoutsList — the values above are config, not the running keymap"
    bad "layouts are '${layouts:-unset}', but MoOS ships '${image_layouts}' — the session does not match the image"
    [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/kxkbrc" ] && \
        bad "  cause: ~/.config/kxkbrc overrides the image (delete it, then log out and back in)"
fi
case "$opts" in *alt_shift_toggle*) ok "Alt+Shift switches the layout" ;;
                *) bad "the Alt+Shift toggle is not set (Options='${opts:-unset}')" ;; esac

# ── The one language the session speaks ──────────────────────────────────────
# MoOS is single-language: the user picked one, and the session should be in it.
# Read the LIVE language (LANG the session exports), not the file we shipped —
# same discipline as the keyboard check. A note, not a failure: language is the
# user's choice and an English or Arabic session are both perfectly valid; this
# only surfaces a mismatch between the session LANG and the Plasma language the
# user set, which is the state that reads as "half the UI is in the wrong tongue".
head_ "اللغة | Language"
sess_lang="${LANG%%.*}"; sess_lang="${sess_lang%%_*}"
plasma_lang="$(kreadconfig6 --file plasma-localerc --group Translations --key LANGUAGE 2>/dev/null)"
plasma_lang="${plasma_lang%%:*}"; plasma_lang="${plasma_lang%%_*}"
if [ -n "$plasma_lang" ]; then
    if [ -z "$sess_lang" ] || [ "$sess_lang" = "$plasma_lang" ]; then
        ok "the session speaks one language: ${plasma_lang}"
    else
        note "Plasma language is '${plasma_lang}' but the session LANG is '${sess_lang}' — log out and back in so the whole desktop follows the pick (moos-lang applies at next login)"
    fi
elif [ -n "$sess_lang" ]; then
    ok "session language: ${sess_lang} (no explicit MoOS pick yet — the default)"
else
    note "could not read the session language"
fi

# ── Arabic in the terminal ───────────────────────────────────────────────────
# fc-match answers a DIFFERENT question: it returns the family the pattern names.
# Only the sorted list shows the fallback, and the fallback is what draws Arabic.
head_ "الخط | Terminal font"
fallback="$(fc-match -s 'JetBrains Mono:lang=ar' 2>/dev/null | grep -v '"JetBrains Mono"' | head -1)"
case "$fallback" in
    *Kawkab*) ok "Arabic in the terminal renders in Kawkab Mono (letters join)" ;;
    "")       bad "could not resolve an Arabic fallback for the terminal font" ;;
    *)        bad "Arabic falls back to '${fallback}' — proportional, so the cursive joins tear apart" ;;
esac

# ── Photos and video ─────────────────────────────────────────────────────────
head_ "الصور والفيديو | Photos & video"
img="$(xdg-mime query default image/jpeg 2>/dev/null)"
vid="$(xdg-mime query default video/mp4 2>/dev/null)"
case "$img" in
    *gwenview*) ok "images open in Gwenview" ;;
    *chrome*|*chromium*|*firefox*) bad "images still open in a browser (${img})" ;;
    "")  bad "nothing claims image/jpeg" ;;
    *)   note "images open in ${img}" ;;
esac
case "$vid" in
    *haruna*) ok "video opens in Haruna" ;;
    "") bad "nothing claims video/mp4" ;;
    *)  note "video opens in ${vid}" ;;
esac

# ── Mo AI ────────────────────────────────────────────────────────────────────
head_ "Mo AI"
if [ -x /usr/bin/moos-qml-shell ] && grep -q -- "--app-id org.moos.moai" /usr/bin/moai 2>/dev/null; then
    ok "Mo AI's window carries its own app_id (no generic Qt icon)"
else
    bad "Mo AI still runs under the bare QML runtime — its taskbar icon will be the Qt logo"
fi

if curl -sf --max-time 6 http://127.0.0.1:8080/v1/models >/dev/null 2>&1; then
    ok "the brain gateway answers on 8080"
    models="$(curl -sf --max-time 6 http://127.0.0.1:8080/v1/models 2>/dev/null | grep -o '"id":' | wc -l)"
    [ "${models:-0}" -gt 1 ] && ok "it offers ${models} brains to choose from" \
                             || note "it offers ${models} brain(s) — configure a cloud key in Mo AI's settings"
else
    bad "nothing is answering on 8080 — Mo AI has no brain to talk to"
fi
curl -sf --max-time 6 -H 'X-Moai-Control: 1' http://127.0.0.1:8079/status >/dev/null 2>&1 \
    && ok "the control API answers on 8079" \
    || note "the control API is not up yet (it starts with the session)"

# ── The MoOS Store ────────────────────────────────────────────────────────────
# `bootc upgrade` replaces /usr atomically, so reading the booted /usr IS reading
# the running system: these prove the store, its install path and the Mo Store
# rebrand actually LANDED in the deployment you are running, and that a store tap
# has somewhere to go. The store installs with NO terminal by firing
# moos://store/install/<id> at moos-open, which runs moos-install for a catalogued
# id — so all three links are checked, not just that the window exists.
head_ "متجر MoOS | Mo Store"
catalog=/usr/share/moos/store/catalog.json
if [ -f "$catalog" ] && command -v python3 >/dev/null 2>&1 && \
   n_apps="$(python3 -c 'import json; print(len(json.load(open("/usr/share/moos/store/catalog.json",encoding="utf-8"))["apps"]))' 2>/dev/null)" && \
   [ "${n_apps:-0}" -gt 0 ]; then
    ok "the store catalogue lists ${n_apps} apps"
else
    bad "the store catalogue is missing or unreadable (${catalog})"
fi
[ -x /usr/bin/moos-install ] && ok "moos-install (the no-terminal installer) is present" \
    || bad "moos-install is missing — the store cannot install anything"
if [ -x /usr/bin/moos-open ] && grep -q "store/install" /usr/bin/moos-open 2>/dev/null; then
    ok "moos-open carries the store/install route"
else
    bad "moos-open has no store/install route — the store's install taps would do nothing"
fi
moos_handler="$(xdg-mime query default x-scheme-handler/moos 2>/dev/null)"
case "$moos_handler" in
    org.moos.urlhandler.desktop) ok "moos:// links route to MoOS" ;;
    "") bad "nothing handles moos:// — the store's install links are dead" ;;
    *)  note "moos:// is handled by '${moos_handler}' (expected org.moos.urlhandler.desktop)" ;;
esac
[ -x /usr/bin/moos-store ] && ok "the Mo Store launcher is present" \
    || bad "moos-store is missing — the store cannot open"
[ -x /usr/bin/moos-welcome ] && ok "the Welcome onboarding launcher is present" \
    || bad "moos-welcome is missing — first-run has no wizard"
[ -f /usr/share/applications/org.moos.store.desktop ] \
    && ok "Mo Store has its own app entry (org.moos.store)" \
    || bad "org.moos.store.desktop is missing — the store is not in the menu"
disc=/usr/share/applications/org.kde.discover.desktop
if [ -f "$disc" ]; then
    if grep -q '^NoDisplay=true$' "$disc" 2>/dev/null; then
        ok "the Discover engine entry is hidden (Mo Store is the one storefront)"
    else
        note "Discover's menu entry is visible — the menu will show two storefronts"
    fi
fi
# Bazaar (Mo Store's optional full-catalog engine) may be installed in EITHER
# flatpak scope. Resolve its menu entry the way the menu does — the user's own
# applications dir first, then the per-user export, then the system export —
# and require the WINNING file to be hidden. This is the live check for the bug
# where a system-scope Bazaar showed a second store while every gate was green.
bazaar=io.github.kolunmi.Bazaar
if flatpak info --user "$bazaar" >/dev/null 2>&1 || flatpak info "$bazaar" >/dev/null 2>&1; then
    bz_entry=""
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
             "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications" \
             /var/lib/flatpak/exports/share/applications; do
        [ -f "$d/$bazaar.desktop" ] && { bz_entry="$d/$bazaar.desktop"; break; }
    done
    if [ -z "$bz_entry" ]; then
        note "Bazaar is installed but exports no menu entry"
    elif grep -q '^NoDisplay=true$' "$bz_entry" 2>/dev/null; then
        ok "the Bazaar engine's launcher is hidden (Mo Store is the one storefront)"
    else
        bad "Bazaar's launcher is visible (${bz_entry}) — the menu shows TWO stores; run moos-one-store"
    fi
fi

# ── The lock screen and boot splash are MoOS ──────────────────────────────────
head_ "القفل والإقلاع | Lock screen & boot"
lock=/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml
if [ -f "$lock" ] && grep -q "MoOS" "$lock" 2>/dev/null; then
    ok "the lock screen is the MoOS override (drawn by the shell package)"
else
    bad "the lock screen is not MoOS's — the greeter will fall back to Breeze"
fi
if [ -d /usr/share/plymouth/themes/moos ]; then
    plymouth_theme="$(plymouth-set-default-theme 2>/dev/null || true)"
    if [ -n "$plymouth_theme" ]; then
        [ "$plymouth_theme" = moos ] && ok "the boot splash is moos" \
            || bad "the boot splash is '${plymouth_theme}', expected moos"
    elif grep -q '^Theme=moos' /usr/share/plymouth/plymouthd.defaults 2>/dev/null; then
        ok "the boot splash ships as moos"
    else
        note "could not confirm the active boot splash theme"
    fi
else
    bad "the moos boot splash theme is not installed"
fi

# ── The desktop ──────────────────────────────────────────────────────────────
head_ "سطح المكتب | Desktop"
systemctl --user is-active plasma-ksystemstats.service >/dev/null 2>&1 \
    && ok "the sensor daemon is running (the rings have data)" \
    || bad "plasma-ksystemstats is NOT running — every system monitor will draw an empty box"

appletsrc="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"

# Ask the running shell about every desktop containment. A global grep count is
# wrong as soon as a second monitor or Activity exists: the valid state is the
# MoOS SCENE (wallpaper plugin org.moos.ui2.wallpaper, which paints the bento
# below the icons) with the matching image and ZERO leftover desktop applets
# from the widget era — PER desktop, not once for the whole file.
desktop_visual_state() {
    local expected_wall="$1" result
    command -v gdbus >/dev/null 2>&1 || return 1
    command -v timeout >/dev/null 2>&1 || return 1
    result="$(timeout 5s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var expected = "'"$expected_wall"'";
            var ds = desktops();
            var scenes = 0, wallpapers = 0, staleTotal = 0;
            for (var i = 0; i < ds.length; i++) {
                if (ds[i].wallpaperPlugin == "org.moos.ui2.wallpaper") { scenes++; }
                ds[i].currentConfigGroup = ["Wallpaper", "org.moos.ui2.wallpaper", "General"];
                if (String(ds[i].readConfig("Image", "")).indexOf(expected) >= 0) {
                    wallpapers++;
                }
                var ws = ds[i].widgets();
                for (var j = 0; j < ws.length; j++) {
                    if (ws[j].type == "org.moos.ui2.dashboard"
                            || ws[j].type == "org.moos.nova.deskclock") { staleTotal++; }
                }
            }
            print("desktops=" + ds.length + ";scenes=" + scenes
                + ";wallpapers=" + wallpapers + ";stale=" + staleTotal);
        ' 2>/dev/null)" || return 1
    printf '%s\n' "$result" \
        | grep -oE 'desktops=[1-9][0-9]*;scenes=[0-9]+;wallpapers=[0-9]+;stale=[0-9]+' \
        | head -n1
}

visual_field() {
    printf '%s\n' "$desktop_state" | tr ';' '\n' | sed -n "s/^$1=//p"
}

if [ -n "$want_wall" ]; then
    if desktop_state="$(desktop_visual_state "$want_wall")" && [ -n "$desktop_state" ]; then
        desktop_count="$(visual_field desktops)"
        scene_count="$(visual_field scenes)"
        wallpaper_count="$(visual_field wallpapers)"
        stale_count="$(visual_field stale)"
        [ "$scene_count" = "$desktop_count" ] \
            && ok "all ${desktop_count} desktop(s) run the MoOS scene (dashboard below the icons)" \
            || bad "only ${scene_count}/${desktop_count} desktop(s) run org.moos.ui2.wallpaper — the dashboard is missing there"
        [ "$wallpaper_count" = "$desktop_count" ] \
            && ok "all ${desktop_count} desktop wallpaper(s) match: ${want_wall}" \
            || bad "only ${wallpaper_count}/${desktop_count} desktop wallpaper(s) match ${want_wall}"
        [ "${stale_count:-0}" = "0" ] \
            && ok "no leftover widget-era dashboard applets" \
            || bad "${stale_count} stale dashboard applet(s) still sit ON TOP of the icons — run moos-theme dark/light once"
    else
        bad "could not read every desktop's scene state from the running Plasma shell"
    fi
fi
grep -q "org.moos.nova.clock" "$appletsrc" 2>/dev/null \
    && ok "the MoOS clock is in the panel" \
    || bad "the panel has no clock"

if grep -q "shownItems=org.kde.plasma.keyboardlayout,org.kde.plasma.volume" "$appletsrc" 2>/dev/null; then
    ok "the tray shows two things: the layout and the volume"
else
    note "the tray's shown items are not the MoOS default (yours to change, so this is only a note)"
fi

# ── Nothing shadowing the image ──────────────────────────────────────────────
# A MoOS asset staged into ~/.local or ~/.config OUTRANKS the copy in /usr and
# freezes it at whatever it said the day it was written. This is the single most
# common way a MoOS fix reaches the image and never reaches the user.
head_ "لا شي بيحجب الصورة | Nothing shadowing the image"
shadows=0
for rel in plasma/plasmoids/org.moos.nova.clock \
           plasma/wallpapers/org.moos.ui2.wallpaper \
           plasma/look-and-feel/org.moos.ui2 plasma/look-and-feel/org.moos.ui2.light \
           plasma/desktoptheme/MoOSUI2 plasma/desktoptheme/MoOSUI2Light \
           aurorae/themes/MoOSUI2 aurorae/themes/MoOSUI2Light \
           wallpapers/MoOSUI2Graphite wallpapers/MoOSUI2Tide \
           color-schemes/MoOSUI2Dark.colors color-schemes/MoOSUI2Light.colors \
           icons/MoOSUI2 icons/MoOSUI2Light \
           konsole/MoOSUI2.profile konsole/MoOSUI2Light.profile; do
    if [ -e "/usr/share/$rel" ] && [ -e "${XDG_DATA_HOME:-$HOME/.local/share}/$rel" ]; then
        bad "~/.local/share/${rel} shadows the image copy — later updates will never reach you"
        shadows=$((shadows+1))
    fi
done
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/99-moos-kawkab-test.conf" ]; then
    bad "a user-level Kawkab fontconfig override is shadowing the image's font policy"
    shadows=$((shadows+1))
fi
[ "$shadows" -eq 0 ] && ok "no user-level copy is shadowing a MoOS asset"

# ── Verdict ──────────────────────────────────────────────────────────────────
printf '\n'
if [ "$fail" -eq 0 ]; then
    printf '\033[1;32m✓ %d checks passed\033[0m' "$pass"
    [ "$warn" -gt 0 ] && printf ', \033[33m%d note(s)\033[0m' "$warn"
    printf '\n'
    exit 0
fi
printf '\033[1;31m✗ %d broken\033[0m, %d passed' "$fail" "$pass"
[ "$warn" -gt 0 ] && printf ', %d note(s)' "$warn"
printf '\n'
exit 1
