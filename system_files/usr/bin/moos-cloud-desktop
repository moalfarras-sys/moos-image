#!/usr/bin/env bash
# moos-cloud-desktop — turn the cloud server's desktop on, and open it in a browser.
#
#   sudo moos-cloud-desktop on  <user>
#   sudo moos-cloud-desktop off
#        moos-cloud-desktop status
#
# WHY THIS IS A COMMAND AND NOT A DEFAULT
#
# A server has no screen, so nobody logs in at the greeter, so no Plasma session
# exists, so there is nothing for Mo PC Remote to stream. The desktop only appears
# if one account logs in automatically on the virtual display.
#
# Autologin on a server is a real trade-off and it is the owner's to make, not the
# image's: anyone who reaches the machine's CONSOLE — the provider's VNC panel,
# for instance — lands in a live session with no password asked. That is why this
# is opt-in, and why the shipped default is a greeter that asks.
#
# What makes it defensible when you do turn it on: MoOS Cloud takes no password
# over SSH, its serial console is the only other way in, and **Mo PC Remote itself
# refuses every connection that does not arrive over Tailscale** — verified, it
# answers `Forbidden: this device is only reachable over Tailscale.` to anything
# else. The desktop is never on the public internet, whatever this command does.
set -euo pipefail

CONF=/etc/plasmalogin.conf.d/20-moos-cloud-autologin.conf

red()   { printf '\033[31m✗\033[0m %s\n' "$*" >&2; }
ok()    { printf '\033[32m✓\033[0m %s\n' "$*"; }
note()  { printf '  %s\n' "$*"; }
die()   { red "$*"; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || die "run this with sudo — it changes how the machine logs in."; }

tailscale_url() {
    local ip
    ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
    if [ -n "$ip" ]; then
        printf 'http://%s:8765' "$ip"
    else
        printf ''
    fi
}

# ── A screen of their own ────────────────────────────────────────────────────
#
#   sudo moos-cloud-desktop own <user> [port]
#
# The machine has ONE seat. Two people logging in at the greeter take turns on
# it: both sessions exist, but only one draws, and the other sees a frozen frame.
# On a server rented so that two developers can work at once, that is the wrong
# answer to the right question.
#
# So give the second person a compositor that never touches the seat at all:
# Plasma's OWN compositor, told to render to a virtual framebuffer instead of to
# the seat. Their Mo PC Remote captures that, on its own port. Two desktops, one
# machine, neither aware of the other — verified running side by side on a netcup
# VPS, each with their own plasmashell and their own stream.
#
# What it costs, honestly: a second Plasma is ~400-600 MB of RAM and its own
# encode load when the stream is live. On a 15 GB / 8-core box that is nothing;
# on a 4 GB box it is most of what is left.
#
# WHAT THIS USED TO DO, AND WHY IT PRODUCED A BLACK SCREEN
#
# It used to start a compositor of its own:
#
#     kwin_wayland --virtual … --exit-with-session=/usr/bin/startplasma-wayland
#
# But startplasma-wayland does not run a desktop inside a compositor you hand it.
# It starts the systemd-managed Plasma session, and that session's first unit is
# plasma-kwin_wayland.service — A COMPOSITOR OF ITS OWN, which saw WAYLAND_DISPLAY
# already set and came up NESTED inside ours.
#
# So the machine ran two compositors: an outer virtual one with nothing on it, and
# an inner one carrying the actual desktop. The portal captured the outer one and
# streamed a perfectly healthy, perfectly BLACK 1920x1080 framebuffer — frames
# flowing at full rate, input reported ready, picture empty. Nothing failed, so
# nothing said anything. Found by decoding a frame off the wire and looking at it.
#
# The fix is to own no compositor at all: one drop-in tells Plasma's compositor to
# be the virtual one. kwin_wayland_wrapper forwards arguments it does not
# recognise straight to kwin_wayland (verified: it answers "kwin: Unknown option"),
# and keeping the wrapper is what publishes WAYLAND_DISPLAY into the systemd user
# environment — which is how plasmashell, the portal and Mo PC Remote find the
# session at all.

# A dummy DRM device, and why it is load-bearing.
#
# KWin refuses to screencast any session that is not compositing with OpenGL —
# screencastmanager.cpp: `backend->compositingType() == OpenGLCompositing`. And
# KWin's virtual backend only OFFERS OpenGL when findRenderDevice() finds a DRM
# device. A cloud VPS typically has exactly one: a KMS-only bochs-drm with no
# render node. So it finds nothing, composites with QPainter, and every stream
# request comes back "Unsupported compositing type" — which is what kept the
# second developer's screen dark for a week.
#
# vgem is the device KWin's own source special-cases for exactly this, opening its
# PRIMARY node because gbm can only allocate dumb buffers there. It has no display
# output and holds no screen contents, so sharing it costs nothing: /dev/dri/card0
# keeps its seat ACL and the two desktops stay as separate as they were.
ensure_render_device() {
    local group="${1:-}"
    if ! modinfo vgem >/dev/null 2>&1; then
        note "this kernel has no vgem — the private desktop will composite with QPainter"
        note "and Mo PC Remote will not be able to stream it"
        return 0
    fi
    modprobe vgem 2>/dev/null || true

    install -D -m0644 /dev/stdin /etc/modules-load.d/moos-cloud-vgem.conf <<'MODLOAD'
# A headless MoOS desktop needs a DRM device to composite with OpenGL, and KWin
# will not screencast a QPainter session. bochs-drm on a VPS offers no render
# node, so load vgem — the device KWin's virtual backend special-cases for this.
vgem
MODLOAD

    # The group only exists once moos-cloud-dev has made a developer account. On a
    # machine where it does not, fall back to a mode the headless user can open:
    # vgem carries no screen contents, so this exposes nothing card0 was guarding.
    if [ -n "$group" ] && getent group "$group" >/dev/null 2>&1; then
        install -D -m0644 /dev/stdin /etc/udev/rules.d/61-moos-cloud-vgem.rules <<RULE
# vgem exists here so a seatless Plasma can get an OpenGL context. Scoped to the
# faux-bus vgem device on purpose — /dev/dri/card0 keeps its seat ACL.
SUBSYSTEM=="drm", KERNEL=="card*", DEVPATH=="/devices/faux/vgem/drm/card*", GROUP="${group}", MODE="0660"
RULE
    else
        install -D -m0644 /dev/stdin /etc/udev/rules.d/61-moos-cloud-vgem.rules <<'RULE'
# vgem exists here so a seatless Plasma can get an OpenGL context. It is a dummy
# GEM buffer device: no display output, no screen contents. Scoped to it alone —
# /dev/dri/card0 keeps its seat ACL.
SUBSYSTEM=="drm", KERNEL=="card*", DEVPATH=="/devices/faux/vgem/drm/card*", MODE="0666"
RULE
    fi
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=drm --action=change 2>/dev/null || true
    ok "render device ready (vgem) — the private desktop can composite with OpenGL"
}

# The portal grant, and the vicious cycle it breaks.
#
# The RemoteDesktop portal wants one interactive click before it will hand over
# capture and input. A headless session has nobody to click, and the only way to
# click would be through Mo PC Remote — which needs the grant it is asking for.
# Never granted, for ever.
#
# The way out: Mo PC Remote already asks the portal for persistence
# (mo-remote-portal.py sets persist_mode=2) and saves the token the portal returns.
# That token IS the id of the record in the permission store, and the record it
# guards turns out to carry nothing session-specific at all — just which devices
# were granted and whether screen sharing was allowed. So it can be written ahead
# of time, and the first Start restores instead of asking.
#
# The token must be minted the way xdp_generate_token() mints them, or the portal
# frontend throws it out before the KDE side ever sees it: 16 random bytes,
# standard base64, '+' and '/' aliased to '_', padding cut — because
# xdp_is_valid_token() requires every character to be a D-Bus name character.
# Python's urlsafe_b64encode uses '-', which is not one, and fails with the
# unhelpful "Restore token is not valid".
seed_portal_grant() {
    local user="$1" uid="$2"
    runuser -u "$user" -- env \
        "XDG_RUNTIME_DIR=/run/user/${uid}" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus" \
        python3 - "/var/home/${user}/.config/MoRemote/portal-restore-token" <<'PYGRANT'
import base64, os, secrets, struct, sys

from gi.repository import Gio, GLib

token_path = sys.argv[1]
if os.path.exists(token_path) and open(token_path).read().strip():
    print("portal grant: already set up")
    sys.exit(0)

def qstring(s):
    b = s.encode("utf-16-be")
    return struct.pack(">I", len(b)) + b

def qbool(v):
    return struct.pack(">I", 1) + b"\x00" + (b"\x01" if v else b"\x00")

def quint(v):
    return struct.pack(">I", 3) + b"\x00" + struct.pack(">I", v)

# A QVariantMap as QDataStream writes it, in QMap key order. 3 = pointer|keyboard.
blob = struct.pack(">I", 3)
blob += qstring("clipboardEnabled") + qbool(False)
blob += qstring("devices") + quint(3)
blob += qstring("screenShareEnabled") + qbool(True)

data = GLib.Variant("(suv)", ("KDE", 1, GLib.Variant("ay", blob)))
token = base64.b64encode(secrets.token_bytes(16)).decode().rstrip("=")
token = token.replace("+", "_").replace("/", "_")

bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
bus.call_sync(
    "org.freedesktop.impl.portal.PermissionStore",
    "/org/freedesktop/impl/portal/PermissionStore",
    "org.freedesktop.impl.portal.PermissionStore",
    "Set",
    GLib.Variant("(sbsa{sas}v)", ("remote-desktop", True, token, {"": ["yes"]}, data)),
    None, Gio.DBusCallFlags.NONE, 10000, None)

os.makedirs(os.path.dirname(token_path), exist_ok=True)
with open(token_path, "w") as f:
    f.write(token)
os.chmod(token_path, 0o600)
print("portal grant: seeded")
PYGRANT
}

own_screen() {
    local user="${1:-}" port="${2:-}"
    [ -n "$user" ] || die "which account? e.g. moos-cloud-desktop own momo 8766"
    id "$user" >/dev/null 2>&1 || die "no such account: ${user}"
    local uid
    uid="$(id -u "$user")"
    [ -n "$port" ] || port=$(( 8765 + uid - 1000 ))
    case "$port" in ''|*[!0-9]*) die "port must be a number" ;; esac

    # Their services must outlive the SSH session that starts them.
    loginctl enable-linger "$user"

    # Without this the compositor comes up on QPainter and refuses to stream.
    # moosdev is the group moos-cloud-dev puts every developer account in.
    ensure_render_device moosdev

    # Mo PC Remote reads its port from TWO files, and settings.json is applied
    # AFTER config.dat — so writing only the one you find first changes nothing
    # and says nothing. Write both, in the order the app reads them.
    local dir="/var/home/${user}/.local/share/MoRemotePersonal"
    install -d -o "$user" -g "$user" -m0700 "$dir"
    python3 - "$dir" "$port" <<'PYPORT'
import json, pathlib, sys
d, port = pathlib.Path(sys.argv[1]), int(sys.argv[2])
for name, key in (("config.dat", "Port"), ("settings.json", "port")):
    f = d / name
    if not f.exists():
        continue
    try:
        data = json.loads(f.read_text())
    except Exception:
        continue
    data[key] = port
    f.write_text(json.dumps(data, indent=2))
PYPORT
    chown -R "${user}:${user}" "$dir"

    # An older version of this command pinned the streamer to a compositor of its
    # own (WAYLAND_DISPLAY=wayland-<user>). That compositor no longer exists, and a
    # pin pointing at a dead socket is worse than no pin: the streamer would sit
    # there capturing nothing. The wrapper publishes the real one.
    rm -f "/var/home/${user}/.config/systemd/user/mo-remote-personal.service.d/10-own-screen.conf"
    rmdir "/var/home/${user}/.config/systemd/user/mo-remote-personal.service.d" 2>/dev/null || true

    # Plasma's own compositor renders to a virtual framebuffer for this account.
    local kwindrop="/var/home/${user}/.config/systemd/user/plasma-kwin_wayland.service.d"
    install -d -o "$user" -g "$user" -m0755 "$kwindrop"
    install -D -m0644 /dev/stdin "${kwindrop}/20-moos-virtual-output.conf" <<'KWINDROP'
# Written by moos-cloud-desktop. This account has no seat — the one screen belongs
# to somebody else — so its compositor renders to a virtual framebuffer instead of
# fighting over seat0.
#
# The arguments pass through kwin_wayland_wrapper untouched; it forwards what it
# does not recognise to kwin_wayland. Keeping the WRAPPER rather than calling
# kwin_wayland directly is the point: the wrapper creates the Wayland socket and
# publishes WAYLAND_DISPLAY into the systemd user environment, which is how
# plasmashell, the portal and Mo PC Remote all find this session.
#
# LIBGL_ALWAYS_SOFTWARE: a cloud VPS has no GPU and no Vulkan device. Left alone
# Mesa reaches for zink, fails with "ZINK: failed to choose pdev", EGL never comes
# up, and KWin quietly falls back to QPainter — which KWin then refuses to
# screencast. The failure is silent in every log that matters.
[Service]
Environment=LIBGL_ALWAYS_SOFTWARE=1
ExecStart=
ExecStart=/usr/bin/kwin_wayland_wrapper --virtual --width 1920 --height 1080 --xwayland
KWINDROP
    chown -R "${user}:${user}" "/var/home/${user}/.config/systemd"

    # The session itself, as a user service so it comes back after a reboot.
    #
    # DO NOT WRAP THIS IN `dbus-run-session`. It looks like the obvious way to give
    # a headless session a bus, and it quietly destroys the session instead.
    #
    # `dbus-run-session` creates a NEW session bus (/tmp/dbus-XXXXXXXX). The systemd
    # --user manager is on the real one (/run/user/$uid/bus) and never moves. So the
    # desktop and everything systemd starts for that user end up on two different
    # buses that cannot see each other, and the failure is entirely silent:
    #
    #   * startplasma-wayland asks org.freedesktop.systemd1 — on the SESSION bus —
    #     to start the systemd-managed Plasma session. On a private bus that name
    #     does not exist, so it prints "Could not start systemd managed Plasma
    #     session", falls back to legacy startup, and never starts
    #     plasma-workspace.target. graphical-session.target therefore stays
    #     inactive, because plasma-workspace.target is what BindsTo it.
    #   * xdg-desktop-portal is ordered After=graphical-session.target, so it is
    #     refused with "Dependency failed for Portal service" — every 30 seconds,
    #     for ever.
    #   * and the portal is Mo PC Remote's PRIMARY input path (InputInjector.cs:
    #     ydotoold/uinput is only the fallback, and that fallback cannot work in a
    #     seatless session either — see ydotoold-moremote.service).
    #
    # Net effect, measured on this server before the fix: the second developer got
    # a desktop that streamed video perfectly and accepted no keyboard or mouse
    # input at all, with nothing in `systemctl --failed` to suggest why.
    #
    # The user is lingering, so systemd has already given them dbus.socket and a
    # real session bus. Use it.
    local unit="/var/home/${user}/.config/systemd/user/moos-own-screen.service"
    install -D -m0644 /dev/stdin "$unit" <<UNIT
[Unit]
Description=MoOS private desktop for ${user} (virtual output)
Before=mo-remote-personal.service
Wants=dbus.socket
After=dbus.socket

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus
# Plain startplasma-wayland, and nothing wrapped around it. Its compositor is the
# virtual one because of the drop-in written above, so this session has exactly
# one — and it is the one carrying the desktop.
ExecStart=/usr/bin/startplasma-wayland
# Clear the display variables when the session goes down.
#
# The systemd --user manager outlives the session and keeps whatever was pushed
# into its environment. Restart the desktop and Xwayland comes back on a NEW
# display number, but the old DISPLAY is still sitting there — so the autostart
# apps of the next session race against it and some lose. Measured: on a restart
# that moved Xwayland from :2 to :0, xwaylandvideobridge read the stale :2,
# could not connect, failed to load Qt's xcb plugin and aborted; drkonqi then
# crashed a dozen times trying to report it, and the crash storm filled the
# coredump cap. One stale variable, a gigabyte of dumps.
ExecStopPost=/usr/bin/systemctl --user unset-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
    chown "${user}:${user}" "$unit"

    runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/${uid}" systemctl --user daemon-reload
    runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/${uid}" systemctl --user enable --now moos-own-screen.service >/dev/null 2>&1

    # The streamer must start INTO a session that exists, not before it. The
    # desktop is up when plasmashell is; the socket alone only proves a compositor.
    local waited=0
    while [ "$waited" -lt 60 ]; do
        pgrep -u "$user" -x plasmashell >/dev/null 2>&1 && break
        sleep 1
        waited=$((waited + 1))
    done
    if ! pgrep -u "$user" -x plasmashell >/dev/null 2>&1; then
        red "the private desktop did not come up within 60s"
        note "check: journalctl --user -u moos-own-screen -n 40   (as ${user})"
        return 1
    fi
    ok "private 1920x1080 desktop up for ${user}"

    # Hand the portal its grant before the streamer asks for one, or it will sit
    # waiting on a dialog nobody can answer.
    seed_portal_grant "$user" "$uid" || note "could not seed the portal grant"

    runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/${uid}" \
        systemctl --user restart mo-remote-personal.service >/dev/null 2>&1 || true
    sleep 8
    if ss -tnl 2>/dev/null | grep -q ":${port} "; then
        ok "Mo PC Remote listening on ${port} for ${user}"
    else
        note "Mo PC Remote is not listening on ${port} yet — it starts with the session"
    fi

    echo
    local url
    url="$(tailscale_url)"
    # Sound is a SECOND tab, and saying so here is the difference between a
    # feature and a secret. Mo PC Remote streams video only — it has no audio path
    # at all — so moos-cloud-audio serves this account's sink monitor as
    # Opus-in-WebM on its own port, which every browser plays natively.
    local aport=$(( 8775 + uid - 1000 ))
    if [ -n "$url" ]; then
        note "${user} opens: ${url%:*}:${port}"
        note "  and for sound: ${url%:*}:${aport}"
    else
        note "${user} opens http://<tailscale-ip>:${port} once this server joins Tailscale"
        note "  and for sound: http://<tailscale-ip>:${aport}"
    fi
}

cmd_on() {
    local user="${1:-}"
    [ -n "$user" ] || die "which account should own the desktop? e.g. moos-cloud-desktop on moos"
    id "$user" >/dev/null 2>&1 || die "no such account: ${user}"

    install -D -m0644 /dev/stdin "$CONF" <<CONF
# Written by moos-cloud-desktop. A cloud server has no screen, so without an
# automatic login there is no session for Mo PC Remote to stream. Remove this file
# (or run \`moos-cloud-desktop off\`) to go back to a greeter that asks.
[Autologin]
User=${user}
Session=plasma.desktop
Relogin=true
CONF
    ok "autologin configured for ${user}"

    # Their user services must survive having no SSH session attached — without
    # lingering, Mo PC Remote stops the moment you disconnect, which looks exactly
    # like the desktop crashing.
    loginctl enable-linger "$user"
    ok "lingering on — the desktop survives your logout"

    systemctl restart plasmalogin.service
    ok "login manager restarted"

    # Give the session a moment to actually exist before enabling the streamer in
    # it; enabling into a session that has not started yet is how this ends up
    # "enabled" and not running.
    local waited=0
    while [ "$waited" -lt 30 ]; do
        if loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | grep -qx "$user"; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    # `systemctl --user` talks to the user's own systemd over a socket in
    # XDG_RUNTIME_DIR. runuser does not set it, so without this the call fails
    # with "Failed to connect to bus" — and the command reports it could not
    # start the streamer on a machine where the session is running perfectly.
    local uid
    uid="$(id -u "$user")"
    if runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/${uid}" \
            systemctl --user enable --now mo-remote-personal.service >/dev/null 2>&1; then
        ok "Mo PC Remote started"
    else
        note "could not start Mo PC Remote yet — it will come up with the session"
    fi

    echo
    local url
    url="$(tailscale_url)"
    if [ -n "$url" ]; then
        ok "open the desktop in any browser on your tailnet:"
        note "$url"
    else
        ok "the desktop is on. Join this server to Tailscale to reach it:"
        note "tailscale up --ssh     then open http://<its-tailscale-ip>:8765"
        note "(Mo PC Remote refuses connections from anywhere else — by design.)"
    fi
}

cmd_off() {
    rm -f "$CONF"
    systemctl restart plasmalogin.service 2>/dev/null || true
    ok "autologin removed — the greeter asks again on the next boot"
    note "Mo PC Remote is left as it is; it simply has no session to stream."
}

cmd_status() {
    if [ -f "$CONF" ]; then
        ok "autologin: on ($(grep -m1 '^User=' "$CONF" | cut -d= -f2))"
    else
        note "autologin: off (the greeter asks)"
    fi
    printf '  graphical session: %s\n' \
        "$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0"{print $3; found=1} END{if(!found) print "none"}')"
    printf '  Mo PC Remote: %s\n' \
        "$(ss -tnl 2>/dev/null | grep -q ':8765' && echo 'listening on 8765' || echo 'not listening')"
    local url
    url="$(tailscale_url)"
    [ -n "$url" ] && printf '  browser: %s\n' "$url" \
                  || printf '  browser: join Tailscale first — Mo PC Remote answers nothing else\n'
}

case "${1:-status}" in
    on)     need_root; shift; cmd_on "$@" ;;
    own)    need_root; shift; own_screen "$@" ;;
    off)    need_root; cmd_off ;;
    status) cmd_status ;;
    -h|--help) sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)      die "unknown command: $1 (try: on <user>, own <user> [port], off, status)" ;;
esac
