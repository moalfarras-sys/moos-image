#!/usr/bin/env bash
# moos-install-to-disk — the ONE privileged, destructive step of the MoOS installer.
# Wipes the chosen disk, installs the MoOS image, makes it bootable, and plants the
# account/locale answers for first boot.
#
# THE TARGET DISK AND ANSWERS COME FROM THE RECIPE, NOT ARGV/URL. The trusted QML
# front-end writes a 0600 recipe.json (via the moos-qml-shell bridge) containing the
# target node it enumerated + the user's account choices. This helper reads the node
# FROM THAT FILE — so a drive-by `moos://installer/begin` URL cannot aim a wipe at an
# attacker-chosen disk (there is no node to supply, and no recipe ⇒ FAIL no-recipe).
# Defence in depth: the node must also appear in the front-end's disks.json as an
# eligible (non-live) disk.
#
# Invoked ONLY by moos-open's `installer/begin` route via pkexec (polkit rule
# 49-moos-installer.rules). stdout is the machine-readable contract the QML polls:
#     PHASE partition|format|copy|bootloader|finalize
#     PROGRESS 0..100
#     DONE / FAIL <code>   code ∈ no-recipe|password-required|hash-failed|
#                                 not-root|not-live|no-node|live-node|no-image|
#                                 no-network|no-space|disk-io|seed-failed|generic
#
# ENGINE: prepares the target's standard GPT/Btrfs layout, then runs `bootc install
# to-filesystem` against it.  A temporary sibling Btrfs subvolume backs BOTH
# TMPDIR and /var/tmp for bootc's containers/image proxy.  This is load-bearing:
# bootc explicitly mirrors /var/tmp into its private mount namespace, so TMPDIR
# alone is insufficient.  The live root has only a ~1.2-GiB writable overlay,
# while importing MoOS needs multi-GiB temporary blobs.
# The staging subvolume uses the target disk, is deleted after the copy, and never
# consumes RAM-overlay space. Uses the LOCAL copy if the ISO embedded it (offline)
# else pulls it (online). After install it re-arms SIGNED day-2 verification (origin
# rewrite), so every future `bootc upgrade` verifies the cosign signature.
#
# SAFETY: refuses to run outside a live boot, refuses the live medium (and refuses a
# removable target if it cannot determine the live medium), refuses a non-block dev.
set -uo pipefail

# The status file the QML polls. We APPEND each line (open-append-close flushes it
# immediately) instead of writing to stdout — moos-open runs us via pkexec, which
# is setuid and drops `stdbuf`'s LD_PRELOAD, so a redirected stdout would be
# block-buffered and the progress bar would freeze (seen live: FAIL stalled).
STATUS="${1:-/dev/stdout}"
# Truncate the status file at the start of every run. We APPEND progress lines, so a
# previous attempt's stale `FAIL …` / `DONE` would otherwise linger at the top and
# the QML front-end (which polls this file) would show the OLD outcome — seen live:
# a successful retry still reported failure. Harmless when STATUS is /dev/stdout.
if [ "$STATUS" != "/dev/stdout" ]; then : > "$STATUS" 2>/dev/null || true; fi
emit()  { printf '%s\n' "$*" >> "$STATUS" 2>/dev/null; }
phase() { emit "PHASE $1"; }
prog()  { emit "PROGRESS $1"; }
fail()  { emit "FAIL ${1:-generic}"; exit 1; }

LOG="/tmp/moos-install-to-disk.log"
: > "$LOG" 2>/dev/null || true

IMGREF_FILE="/usr/lib/moos/install-imageref"
TARGET_IMGREF="ghcr.io/moalfarras-sys/moos:latest"
[ -r "$IMGREF_FILE" ] && TARGET_IMGREF="$(tr -d ' \t\r\n' < "$IMGREF_FILE")"

# ── find + parse the recipe (the trusted source of BOTH target disk and answers) ─
find_recipe() {
    local h
    if [ -n "${PKEXEC_UID:-}" ]; then
        h="$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f6)"
        [ -n "$h" ] && [ -r "$h/.cache/moos-installer/recipe.json" ] && { printf '%s' "$h/.cache/moos-installer/recipe.json"; return; }
    fi
    ls /home/*/.cache/moos-installer/recipe.json /var/home/*/.cache/moos-installer/recipe.json \
       /root/.cache/moos-installer/recipe.json 2>/dev/null | head -1
}
RECIPE="$(find_recipe)"
# The recipe holds a plaintext password — wipe it on ANY exit (belt), and again
# explicitly right after we parse it (braces) so it never outlives the parse.
wipe_recipe() { [ -n "${RECIPE:-}" ] && [ -e "$RECIPE" ] && { shred -u "$RECIPE" 2>/dev/null || rm -f "$RECIPE" 2>/dev/null; } || true; }
trap 'wipe_recipe' EXIT

[ -n "$RECIPE" ] && [ -r "$RECIPE" ] || fail "no-recipe"
DISKS_JSON="$(dirname "$RECIPE")/disks.json"

# Parse the recipe with NUL-delimited fields, NOT tab. `IFS=$'\t' read` collapses a
# run of tabs into ONE delimiter (tab is IFS-whitespace) and drops any EMPTY field,
# shifting every field after it left by one. That is a real, reproduced corruption:
# an empty field in an older recipe made the
# installed system get LOCALE=<timezone>, XKBLAYOUT=<locale> → LANG=UTC (invalid) →
# the desktop fell back to the image's default language and the keyboard broke.
# NUL delimiters + `mapfile -d ''` preserve empty fields exactly, in order.
mapfile -d '' -t _RF < <(
    python3 - "$RECIPE" <<'PY' 2>>"$LOG"
import json, sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
def g(k):
    v = d.get(k)
    # A trusted front-end writes strings, but a stray JSON null/boolean must not
    # coerce to the literal "None"/"True" (a null password would then hash to the
    # real word "None", defeating the passwordless path). Treat both as empty.
    if v is None or isinstance(v, bool):
        v = ""
    return str(v).replace("\x00", " ")
# Terminate EVERY field with NUL (trailing one included) so an empty LAST field
# (e.g. no timezone) still counts — `mapfile -d ''` drops a trailing delimiter, so
# "a\0b\0" is 2 elements, but "a\0b\0\0" is 3 with an empty tail. Always 8 here.
for k in ("node","username","fullname","password","keymap","xkblayout","locale","timezone"):
    sys.stdout.write(g(k)); sys.stdout.write("\x00")
PY
) || { wipe_recipe; fail "no-recipe"; }
[ "${#_RF[@]}" -ge 8 ] || { wipe_recipe; fail "no-recipe"; }
NODE="${_RF[0]}"; R_USER="${_RF[1]}"; R_FULL="${_RF[2]}"; R_PASS="${_RF[3]}"
R_KEYMAP="${_RF[4]}"; R_XKB="${_RF[5]}"; R_LOCALE="${_RF[6]}"; R_TZ="${_RF[7]}"

# Hash the password now (stdin, never argv) so the plaintext can be discarded with
# the recipe immediately after — nothing plaintext survives the long install.
PASS_HASH=""
[ "${#R_PASS}" -ge 8 ] || { R_PASS=""; wipe_recipe; fail "password-required"; }
command -v mkpasswd >/dev/null 2>&1 && PASS_HASH="$(printf '%s' "$R_PASS" | mkpasswd -m yescrypt -s 2>/dev/null)"
[ -z "$PASS_HASH" ] && command -v openssl >/dev/null 2>&1 && PASS_HASH="$(printf '%s' "$R_PASS" | openssl passwd -6 -stdin 2>/dev/null)"
# A required password that cannot be hashed must fail loudly. There is no
# passwordless administrative fallback in MoOS.
[ -z "$PASS_HASH" ] && { R_PASS=""; wipe_recipe; fail "hash-failed"; }
R_PASS=""
wipe_recipe   # done with the recipe — no plaintext lingers during the install

# ── guards ────────────────────────────────────────────────────────────────────
[ "$(id -u)" = "0" ] || fail "not-root"
if ! grep -q 'rd.live.image' /proc/cmdline 2>/dev/null && [ ! -d /run/initramfs/live ]; then
    fail "not-live"
fi
[ -n "$NODE" ] || fail "no-node"
[ -b "$NODE" ] || fail "no-node"

# Defence in depth: the node must be a disk the front-end actually enumerated as
# eligible (non-live). Ties the wipe to what the trusted UI showed the user.
if [ -r "$DISKS_JSON" ]; then
    python3 - "$DISKS_JSON" "$NODE" <<'PY' 2>>"$LOG" || fail "no-node"
import json, sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
n = sys.argv[2]
sys.exit(0 if any(x.get("node") == n and not x.get("isLive") for x in d.get("disks", [])) else 1)
PY
fi

# The whole disk backing the live medium — never a target.
live_parent() {
    local src pk typ
    for mnt in /run/initramfs/live /run/rootfsbase /; do
        src="$(findmnt -n -o SOURCE "$mnt" 2>/dev/null | sed 's/\[.*//')"
        case "$src" in /dev/*) ;; *) continue ;; esac
        pk="$(lsblk -no pkname "$src" 2>/dev/null | head -1 | tr -d ' ')"
        if [ -n "$pk" ]; then echo "/dev/$pk"; return; fi
        typ="$(lsblk -ndo type "$src" 2>/dev/null | tr -d ' ')"
        [ "$typ" = "disk" ] && { echo "$src"; return; }
    done
}
LIVE="$(live_parent)"
if [ -n "$LIVE" ] && [ "$NODE" = "$LIVE" ]; then
    fail "live-node"
fi
# Fail CLOSED, not open: if we could not identify the live medium at all, refuse a
# REMOVABLE target — it might BE the USB we booted from.
if [ -z "$LIVE" ]; then
    _rm="$(lsblk -ndo RM "$NODE" 2>/dev/null | tr -d ' ')"
    [ "$_rm" = "1" ] && fail "live-node"
fi

# One install at a time. A re-fired begin (the QML Retry, an impatient double-tap,
# or a drive-by moos://installer/begin) must never start a SECOND target preparation
# on the same disk while the first is still partitioning or copying. Hold an
# exclusive lock for the whole destructive run.
exec 9>/run/moos-install.lock 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
    flock -n 9 || fail "busy"
fi

# Early liveness: the QML poller times out on ~30s of silence, but the online
# source/network prep below can legitimately take longer before the ticker starts.
# Emit one PHASE/PROGRESS now so the front-end sees the helper is alive.
phase partition; prog 2

# Choose the install SOURCE: the LOCAL image if the ISO embedded it (offline,
# instant) else the registry (needs a working network). We run `bootc install`
# DIRECTLY below — NOT `podman run <image> bootc install`, which first unpacks the
# whole image into the live env's tiny writable layer. bootc's own image proxy also
# materializes blobs in TMPDIR, so run_install points that at a disposable subvolume
# on the target rather than the ~1.2-GiB LiveOS overlay.
SRC="docker://${TARGET_IMGREF}"
if command -v podman >/dev/null 2>&1 && podman image exists "$TARGET_IMGREF" >>"$LOG" 2>&1; then
    SRC="containers-storage:${TARGET_IMGREF}"
    echo "source: local containers-storage (offline)" >>"$LOG"
else
    echo "source: registry (online) — ensuring network is up" >>"$LOG"
    # systemd-resolved frequently has NOT come up on a slow live boot (dbus-broker
    # cascade), so DNS fails even though the NIC has an IP. Nudge it and wait.
    ensure_network() {
        local host="${TARGET_IMGREF%%/*}" i
        getent hosts "$host" >/dev/null 2>&1 && return 0
        systemctl restart systemd-resolved 2>>"$LOG" || true
        systemctl restart NetworkManager  2>>"$LOG" || true
        for i in $(seq 1 45); do
            getent hosts "$host" >/dev/null 2>&1 && return 0
            [ $(( i % 4 )) -eq 0 ] && prog 2   # heartbeat so the QML poller sees liveness
            sleep 1
        done
        return 1
    }
    ensure_network || fail "no-network"
fi

# Free the target of any live auto-mount so bootc's wipe can proceed. A single
# umount pass is NOT enough: the live KDE session (udisks) races us and RE-mounts a
# previous install's partitions under /run/media, so bootc dies "Device /dev/sdX is
# mounted" (seen live on the first attempt). Sweep every child partition AND its
# mountpoints, swapoff anything backed by the disk, then POLL until the kernel shows
# nothing from this disk still mounted — retrying the sweep each round.
free_target() {
    local i part mp busy
    for i in $(seq 1 10); do
        for part in $(lsblk -nrpo NAME "$NODE" 2>/dev/null); do
            swapoff "$part" 2>/dev/null || true
            for mp in $(findmnt -nro TARGET -S "$part" 2>/dev/null); do
                umount "$mp" >>"$LOG" 2>&1 || umount -l "$mp" >>"$LOG" 2>&1 || true
            done
            umount "$part" >>"$LOG" 2>&1 || true
        done
        busy=""
        for part in $(lsblk -nrpo NAME "$NODE" 2>/dev/null); do
            [ -n "$(findmnt -nro TARGET -S "$part" 2>/dev/null)" ] && { busy=1; break; }
        done
        [ -z "$busy" ] && return 0
        sleep 1
    done
    return 1   # still mounted after ~10s
}

# bootc's containers/image proxy writes each local-store blob to TMPDIR before
# importing it.  The live root's writable overlay is only ~1.2 GiB (measured on the
# release ISO), so /var/tmp fails late in the copy even though the target has tens
# of GiB free.  Prepare the normal bootc disk layout ourselves and give the proxy a
# temporary Btrfs sibling subvolume on the TARGET disk.  The installed root is a
# separate sibling and therefore remains empty for `bootc install to-filesystem`.
TARGET_ROOT=/run/moos-install-root
TARGET_STAGE=/run/moos-install-stage
TARGET_TOP=/run/moos-install-btrfs
ESP_PART=""
ROOT_PART=""
VAR_TMP_BOUND=0

unbind_stage_tmp() {
    # Only remove the top bind mount that THIS helper installed.  /var/tmp may
    # already be a separate LiveOS mount underneath it and must remain intact.
    if [ "$VAR_TMP_BOUND" = "1" ]; then
        umount /var/tmp >>"$LOG" 2>&1 || umount -l /var/tmp >>"$LOG" 2>&1 || true
        VAR_TMP_BOUND=0
    fi
}

cleanup_target() {
    # These are fixed /run paths owned by this helper; never recurse over a
    # caller-controlled path.  The ESP is below TARGET_ROOT, so -R detaches it
    # before the root subvolume.
    unbind_stage_tmp
    mountpoint -q "$TARGET_STAGE" 2>/dev/null && umount "$TARGET_STAGE" >>"$LOG" 2>&1 || true
    mountpoint -q "$TARGET_ROOT" 2>/dev/null && umount -R "$TARGET_ROOT" >>"$LOG" 2>&1 || true
    if mountpoint -q "$TARGET_TOP" 2>/dev/null; then
        [ -d "$TARGET_TOP/bootc-stage" ] \
            && btrfs subvolume delete "$TARGET_TOP/bootc-stage" >>"$LOG" 2>&1 || true
        umount "$TARGET_TOP" >>"$LOG" 2>&1 || true
    fi
    rmdir "$TARGET_STAGE" "$TARGET_ROOT" "$TARGET_TOP" 2>/dev/null || true
}

bind_stage_tmp() {
    # cap-tempfile respects TMPDIR, but bootc additionally calls
    # ensure_mirrored_host_mount("/var/tmp") before creating its image proxy.
    # Overlay the LiveOS path with the target-backed sibling for the duration of
    # bootc only; cleanup_target always peels this exact top mount back off.
    mount --bind "$TARGET_STAGE" /var/tmp >>"$LOG" 2>&1 || return 1
    VAR_TMP_BOUND=1
    chmod 1777 /var/tmp 2>/dev/null || true
    echo "staging: /var/tmp bind-backed by $TARGET_STAGE" >>"$LOG"
    return 0
}

prepare_target() {
    local i root_id
    cleanup_target

    # Match bootc's proven generic layout: BIOS boot + ESP + a Linux x86-64
    # root partition. sfdisk takes the already validated whole-disk NODE only.
    wipefs -a "$NODE" >>"$LOG" 2>&1 || return 1
    sfdisk --wipe always --wipe-partitions always "$NODE" >>"$LOG" 2>&1 <<'EOF'
label: gpt
start=1MiB, size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="BIOS boot"
size=512MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI System"
type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709, name="Linux root (x86-64)"
EOF
    partprobe "$NODE" >>"$LOG" 2>&1 || true
    udevadm settle 2>>"$LOG" || true

    # NVMe/MMC partitions carry a p separator; resolve by PARTN instead of
    # manufacturing /dev names from the disk string.
    for i in $(seq 1 30); do
        ESP_PART="$(lsblk -nrpo NAME,PARTN "$NODE" 2>/dev/null | awk '$2==2{print $1; exit}')"
        ROOT_PART="$(lsblk -nrpo NAME,PARTN "$NODE" 2>/dev/null | awk '$2==3{print $1; exit}')"
        [ -b "$ESP_PART" ] && [ -b "$ROOT_PART" ] && break
        sleep 0.2
    done
    [ -b "$ESP_PART" ] && [ -b "$ROOT_PART" ] || {
        echo "partition: target children did not appear for $NODE" >>"$LOG"
        return 1
    }

    phase format; raise 34
    mkfs.fat -F32 -n EFI-SYSTEM "$ESP_PART" >>"$LOG" 2>&1 || return 1
    mkfs.btrfs -f -L root "$ROOT_PART" >>"$LOG" 2>&1 || return 1

    mkdir -p "$TARGET_ROOT" "$TARGET_STAGE" "$TARGET_TOP"
    mount -o subvolid=5 "$ROOT_PART" "$TARGET_TOP" >>"$LOG" 2>&1 || return 1
    btrfs subvolume create "$TARGET_TOP/root" >>"$LOG" 2>&1 || return 1
    btrfs subvolume create "$TARGET_TOP/bootc-stage" >>"$LOG" 2>&1 || return 1
    root_id="$(btrfs subvolume show "$TARGET_TOP/root" 2>/dev/null \
        | sed -n 's/^[[:space:]]*Subvolume ID:[[:space:]]*//p' | head -1)"
    [ -n "$root_id" ] || { echo "partition: could not resolve root subvolume id" >>"$LOG"; return 1; }
    btrfs subvolume set-default "$root_id" "$TARGET_TOP" >>"$LOG" 2>&1 || return 1

    mount -o subvol=root "$ROOT_PART" "$TARGET_ROOT" >>"$LOG" 2>&1 || return 1
    mount -o subvol=bootc-stage "$ROOT_PART" "$TARGET_STAGE" >>"$LOG" 2>&1 || return 1
    chmod 0700 "$TARGET_STAGE" 2>/dev/null || true
    mkdir -p "$TARGET_ROOT/boot/efi"
    mount "$ESP_PART" "$TARGET_ROOT/boot/efi" >>"$LOG" 2>&1 || return 1
    echo "staging: TMPDIR=$TARGET_STAGE on target-backed Btrfs" >>"$LOG"
    return 0
}

# ── progress ticker: crawls toward a moving ceiling so the bar lives during the
#    long, quiet copy phase. Honest: never passes the ceiling. ─────────────────
CEILF="$(mktemp)"; PCTF="$(mktemp)"
echo 4 > "$CEILF"; echo 3 > "$PCTF"
ticker() {
    local cur ceil
    while :; do
        cur="$(cat "$PCTF" 2>/dev/null || echo 3)"
        ceil="$(cat "$CEILF" 2>/dev/null || echo 4)"
        if [ "$cur" -lt "$ceil" ]; then cur=$((cur + 1)); echo "$cur" > "$PCTF"; prog "$cur"; fi
        sleep 1
    done
}
raise() { echo "$1" > "$CEILF"; }
ticker & TICK=$!
stop_ticker() { [ -n "${TICK:-}" ] && kill "$TICK" 2>/dev/null; wait "$TICK" 2>/dev/null; rm -f "$CEILF" "$PCTF"; TICK=""; }
trap 'stop_ticker; cleanup_target; wipe_recipe' EXIT

phase partition; prog 4; raise 18

run_install() {
    # The filesystem and ESP are already mounted. TMPDIR and /var/tmp both resolve
    # to a disposable Btrfs sibling on the target, so containers/image can
    # materialize large local-store blobs without touching the LiveOS overlay.
    # --generic-image installs portable BIOS+UEFI bootloader state; the installed
    # origin remains the registry ref for day-2 updates and is rewritten to the
    # signed transport in seed_target.
    TMPDIR="$TARGET_STAGE" bootc install to-filesystem \
        --source-imgref "$SRC" \
        --target-transport registry --target-imgref "$TARGET_IMGREF" \
        --skip-fetch-check \
        --generic-image \
        "$TARGET_ROOT" 2>&1
}

attempt_install() {
    run_install | tee -a "$LOG" | while IFS= read -r line; do
    case "$line" in
        *artition*|*wiping*|*Wiping*|*GPT*|*sgdisk*)        phase partition;  raise 22 ;;
        *ilesystem*|*mkfs*|*ormatting*|*subvol*)            phase format;     raise 34 ;;
        *ostree*|*Deploying*|*deploy*|*ayer*|*hunk*|*Writing*|*opying*) phase copy; raise 86 ;;
        *bootupd*|*ootloader*|*grub*|*shim*|*EFI*)          phase bootloader; raise 93 ;;
        *inaliz*|*Finaliz*|*yncing*|*ompleted*|*omplete*)   phase finalize;   raise 97 ;;
    esac
    done
    return "${PIPESTATUS[0]}"
}

# Run the install with a bounded retry. free_target already polls the disk clear,
# but the live udisks can still win a race and make bootc see a fresh mount. Retry
# ONLY when the attempt failed on that mount/busy race — never loop on a real error.
rc=1
for _try in 1 2 3; do
    free_target || echo "free_target: $NODE still busy before attempt $_try" >>"$LOG"
    phase partition; raise 22
    if ! prepare_target; then
        rc=1
        echo "target preparation failed on attempt $_try" >>"$LOG"
        cleanup_target
        break
    fi
    if ! bind_stage_tmp; then
        rc=1
        echo "target staging bind failed on attempt $_try" >>"$LOG"
        cleanup_target
        break
    fi
    _before="$(wc -l < "$LOG" 2>/dev/null || echo 0)"
    attempt_install; rc=$?
    unbind_stage_tmp
    cleanup_target
    [ "$rc" -eq 0 ] && break
    _attempt_log="$(tail -n +"$(( _before + 1 ))" "$LOG" 2>/dev/null)"
    _attempt_log="${_attempt_log,,}"
    if case "$_attempt_log" in
         *"is mounted"*|*"resource busy"*|*"is in use"*|*"already in use"*) true ;;
         *) false ;;
       esac; then
        echo "install attempt $_try lost the umount race — freeing and retrying" >>"$LOG"
        sleep 2; continue
    fi
    break   # a genuine failure — stop and report it
done
stop_ticker

# On success: mount the target ONCE to (a) plant the first-boot answers and (b)
# re-arm SIGNED day-2 verification. Seeding is mandatory: without the encrypted
# account recipe the target would boot with no usable user.
seed_target() {
    local part etc deployment_root mnt=/run/moos-target origin
    part="$(lsblk -nrpo NAME,FSTYPE "$NODE" 2>/dev/null | awk '$2=="btrfs"{print $1; exit}')"
    [ -n "$part" ] || { echo "seed: no btrfs partition found" >>"$LOG"; return 1; }
    mkdir -p "$mnt"
    mount "$part" "$mnt" 2>>"$LOG" || { echo "seed: mount failed" >>"$LOG"; return 1; }
    etc="$(ls -d "$mnt"/ostree/deploy/*/deploy/*/etc "$mnt"/root/ostree/deploy/*/deploy/*/etc 2>/dev/null | head -1)"
    if [ -n "$etc" ] && [ -d "$etc" ]; then
        {
            printf 'USERNAME=%s\n'      "$R_USER"
            printf 'FULLNAME=%s\n'      "$R_FULL"
            printf 'PASSWORD_HASH=%s\n' "$PASS_HASH"
            printf 'KEYMAP=%s\n'        "${R_KEYMAP:-us}"
            printf 'XKBLAYOUT=%s\n'     "${R_XKB:-us}"
            printf 'LOCALE=%s\n'        "$R_LOCALE"
            printf 'TIMEZONE=%s\n'      "$R_TZ"
        } > "$etc/moos-setup.conf" 2>>"$LOG"
        chmod 0600 "$etc/moos-setup.conf" 2>/dev/null || true

        # bootc already deployed a complete /usr and its matching linker/font/
        # hardware caches.  A fresh deployment has no /etc/.updated stamp,
        # however, so systemd treats it like an offline /usr upgrade and runs
        # every ConditionNeedsUpdate=/etc helper before the first greeter.
        # On the 11.6-GiB MoOS deployment ldconfig's cold scan held the first
        # graphical boot for more than six minutes under the release QEMU
        # profile even though a warm run took only seconds.  Nothing in the
        # account recipe changes /usr, so rebuilding those image-time caches is
        # both unnecessary and user-visible.
        #
        # Use systemd's own installer-safe helper rather than inventing a stamp:
        # it records /usr's exact mtime in and on /etc/.updated (and /var when
        # available), which is the documented ConditionNeedsUpdate contract.
        deployment_root="${etc%/etc}"
        if /usr/lib/systemd/systemd-update-done --root="$deployment_root" >>"$LOG" 2>&1 \
            && [ -e "$etc/.updated" ]; then
            echo "seed: marked deployed /etc caches current with /usr" >>"$LOG"
        else
            echo "seed: failed to create $etc/.updated; first boot would rebuild image caches" >>"$LOG"
            umount "$mnt" 2>>"$LOG" || true
            return 1
        fi
    fi
    # Re-arm signed day-2 updates: rewrite the deployment origin so every future
    # `bootc upgrade` verifies the cosign signature (matches the Anaconda %post).
    for origin in "$mnt"/ostree/deploy/*/deploy/*.origin "$mnt"/root/ostree/deploy/*/deploy/*.origin; do
        [ -f "$origin" ] || continue
        sed -i "s|^container-image-reference=.*|container-image-reference=ostree-image-signed:docker://${TARGET_IMGREF}|" "$origin" 2>>"$LOG" \
            && echo "seed: re-armed signed origin in $origin" >>"$LOG" \
            || echo "seed: WARN could not re-arm signed origin in $origin" >>"$LOG"
    done
    umount "$mnt" 2>>"$LOG" || true
    [ -n "$etc" ]
}

# ── UEFI boot entry ───────────────────────────────────────────────────────────
# `bootc install --generic-image` deliberately does NOT write a UEFI NVRAM boot
# entry (a generic image is meant to be portable/re-imaged). On a real machine that
# is a trap: the firmware ends up with no "MoOS" entry, so the moment the live USB
# is pulled it boots the PREVIOUS OS and the whole install looks like it did nothing
# — this was the actual "it won't install on the real PC" symptom. Create the entry
# ourselves, pointed at the target ESP's shim (Secure-Boot friendly), first in
# BootOrder. Best-effort: never fail the install over it, but log loudly.
register_uefi_boot() {
    [ -d /sys/firmware/efi ] || { echo "uefi: legacy/BIOS boot — no NVRAM entry needed" >>"$LOG"; return 0; }
    command -v efibootmgr >/dev/null 2>&1 || { echo "uefi: efibootmgr missing" >>"$LOG"; return 1; }

    local esp pnum disk mnt=/run/moos-esp loader='\EFI\fedora\shimx64.efi'
    esp="$(lsblk -nrpo NAME,FSTYPE "$NODE" 2>/dev/null | awk '$2=="vfat"{print $1; exit}')"
    [ -n "$esp" ] || { echo "uefi: no ESP (vfat) on $NODE" >>"$LOG"; return 1; }
    pnum="$(lsblk -nro PARTN "$esp" 2>/dev/null | tr -d ' ')"
    [ -n "$pnum" ] || pnum="$(printf '%s' "$esp" | grep -oE '[0-9]+$')"
    disk="/dev/$(lsblk -nro PKNAME "$esp" 2>/dev/null | head -1 | tr -d ' ')"
    [ -b "$disk" ] && [ -n "$pnum" ] || { echo "uefi: could not resolve ESP disk/partnum ($esp)" >>"$LOG"; return 1; }

    # Prefer the signed shim; fall back to the removable-media default loader if the
    # image laid the bootloader down only under \EFI\BOOT.
    mkdir -p "$mnt"
    if mount -o ro "$esp" "$mnt" 2>>"$LOG"; then
        if [ ! -f "$mnt/EFI/fedora/shimx64.efi" ] && [ -f "$mnt/EFI/BOOT/BOOTX64.EFI" ]; then
            loader='\EFI\BOOT\BOOTX64.EFI'
        fi
        umount "$mnt" 2>>"$LOG" || true
    fi

    # Remove any stale MoOS entries a prior run left, then create fresh — efibootmgr
    # -c also prepends the new entry to BootOrder (so MoOS boots first; the existing
    # Windows/other entries are left untouched and still selectable in firmware).
    efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\}[[:space:]]*MoOS$/\1/p' \
        | while read -r n; do efibootmgr -b "$n" -B >>"$LOG" 2>&1 || true; done
    if efibootmgr -c -d "$disk" -p "$pnum" -L "MoOS" -l "$loader" >>"$LOG" 2>&1; then
        echo "uefi: registered MoOS -> $disk part $pnum $loader (first in BootOrder)" >>"$LOG"
        return 0
    fi
    echo "uefi: WARN efibootmgr failed to create the MoOS entry" >>"$LOG"
    return 1
}

if [ "$rc" -eq 0 ]; then
    phase finalize; raise 99
    seed_target || { echo "target seeding failed; refusing to report an unusable install" >>"$LOG"; fail "seed-failed"; }
    register_uefi_boot || echo "uefi: boot entry NOT registered — user may need to pick the disk in the firmware menu (check log)" >>"$LOG"
    prog 100
    emit "DONE"
    exit 0
fi

reason="generic"
if grep -qiE 'no space|enospc|not enough (space|room)|disk full' "$LOG" 2>/dev/null; then
    reason="no-space"
elif grep -qiE 'input/output error|i/o error|read-only|write error|failed to write|device or resource busy' "$LOG" 2>/dev/null; then
    reason="disk-io"
elif grep -qiE 'no such image|image not known|unable to find image' "$LOG" 2>/dev/null; then
    reason="no-image"
fi
fail "$reason"
