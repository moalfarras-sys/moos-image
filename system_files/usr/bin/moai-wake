#!/usr/bin/env python3
# =============================================================================
# moai-wake — the lightweight, always-on Telegram WAKE receiver for Mo AI.
# =============================================================================
# WHY THIS EXISTS
#   Mo AI's Telegram agent is OpenClaw (`openclaw gateway`, a ~386 MB Node
#   process + a rootless-podman sandbox + an Ollama model). Keeping it resident
#   just to hear "hi" wastes RAM/CPU/VRAM around the clock. This receiver is the
#   only thing that stays up: a few MB of Python stdlib that holds the Telegram
#   long-poll, and the instant an ALLOWLISTED user speaks, it wakes OpenClaw and
#   steps aside. When OpenClaw goes back to sleep (openclaw-idle), this resumes.
#
# THE ONE HARD RULE (Telegram getUpdates):
#   A bot allows exactly ONE getUpdates consumer. A second poller gets HTTP 409.
#   So moai-wake polls ONLY while openclaw-gateway is inactive, and the moment it
#   wakes OpenClaw it STOPS polling — handing the connection over. It never
#   confirms the triggering update, so Telegram redelivers it to OpenClaw, which
#   processes the actual command. (Non-allowlisted messages are confirmed and
#   dropped so they can't wake the box or pile up.)
#
# SECRETS: read-only from ~/.openclaw/openclaw.json (the same file OpenClaw uses):
#   channels.telegram.botToken   and   channels.telegram.allowFrom
#   No second secret store, no token on the command line, no model loaded here.
# =============================================================================
import http.client
import json
import os
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".openclaw", "openclaw.json")
GATEWAY_UNIT = "openclaw-gateway.service"
API_HOST = "api.telegram.org"
API = "https://api.telegram.org/bot{token}/{method}"
LONG_POLL = 25          # getUpdates long-poll seconds
IDLE_RECHECK = 8        # while OpenClaw owns the connection, re-check this often
BACKOFF_MAX = 60
SYSTEMCTL_PROBE_TIMEOUT = 5
SYSTEMCTL_START_TIMEOUT = 110

# REACHING TELEGRAM ON A NETWORK THAT BLOCKS THE DEFAULT ADDRESS
#
# This receiver is the ONLY thing that can wake OpenClaw once openclaw-idle has
# put it to sleep, so if it cannot reach Telegram the phone agent is silently
# dead: messages arrive at Telegram, nothing here ever reads them, and every
# surface still says "active". Measured on the maintainer's own network:
#
#   getaddrinfo("api.telegram.org") -> 149.154.166.110 AND 2001:67c:4e8:f004::9
#   the host has NO IPv6 default route  -> urlopen picks v6 first and dies
#                                          instantly with [Errno 101]
#   curl -4 to 149.154.166.110          -> no answer, 8s timeout
#   curl -4 to 149.154.167.220 / .99    -> HTTP 302 in ~0.10s
#
# So both halves of the default resolution are unusable here while Telegram
# itself is perfectly reachable on other addresses in its range. OpenClaw's own
# client already survives this by retrying an alternative API IP; this receiver
# used a bare urlopen and had no such path, which is why it logged
# "Network is unreachable" and "read operation timed out" forever.
#
# Two fixes, both narrow:
#   1. Restrict resolution to IPv4, so a missing v6 route cannot fail the call
#      before a usable v4 address is ever tried.
#   2. On a CONNECTION failure (never on an HTTP error, which means we reached
#      Telegram and it answered), retry against known api.telegram.org
#      addresses, pinning the socket while keeping TLS SNI and the Host header
#      set to the real name so certificate validation is unchanged.
# The winner is cached and tried first next time, so the steady state is one
# connection attempt. A network where the default address works is unaffected:
# the first attempt succeeds and the fallback list is never consulted.
# Verified by hand from the affected network: both answer api.telegram.org over
# TLS in ~0.10s. 149.154.175.50 is deliberately NOT here — it resolves in
# Telegram's range but does not serve the API over TLS on 443
# (SSL: WRONG_VERSION_NUMBER), so listing it would only buy a wasted round.
TELEGRAM_FALLBACK_IPS = ("149.154.167.220", "149.154.167.99")
_pinned_ip = None       # the address that last worked, or None for default DNS

_real_getaddrinfo = socket.getaddrinfo


def _ipv4_only_getaddrinfo(host, port, family=0, *args, **kwargs):
    """Resolve A records only — a host with no IPv6 route must not try AAAA."""
    results = _real_getaddrinfo(host, port, socket.AF_INET, *args, **kwargs)
    return results


socket.getaddrinfo = _ipv4_only_getaddrinfo


class _PinnedHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS to a fixed IP while TLS/Host still say api.telegram.org.

    Pinning the socket without this would either break certificate validation
    (SNI would carry the bare IP) or defeat the point (the name would resolve
    back to the blocked address).
    """

    def __init__(self, host, ip, **kwargs):
        super().__init__(host, **kwargs)
        self._pinned_ip = ip

    def connect(self):
        self.sock = socket.create_connection((self._pinned_ip, self.port), self.timeout)
        self.sock = self._context.wrap_socket(self.sock, server_hostname=self.host)


def log(msg):
    print(f"moai-wake: {msg}", flush=True)


def load_telegram():
    """Return (token, set(allow_ids)) from openclaw.json, or (None, set())."""
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None, set()
    tg = (((data.get("channels") or {}).get("telegram")) or {})
    token = tg.get("botToken") or None
    allow = tg.get("allowFrom") or []
    # allowFrom entries may be ints or strings; normalise to string ids.
    allow_ids = {str(x).strip() for x in allow if str(x).strip()}
    return token, allow_ids


def gateway_active():
    try:
        result = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", GATEWAY_UNIT],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=SYSTEMCTL_PROBE_TIMEOUT,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        # A wedged user bus must not wedge the only lightweight Telegram receiver.
        # Returning false lets the Telegram conflict/backoff path remain live.
        return False
    return result.returncode == 0


def start_gateway():
    log(f"waking {GATEWAY_UNIT}")
    # Clear any lingering "failed" from the previous sleep so this is a clean start
    # (openclaw's sandbox teardown can leave the unit failed-but-stopped).
    try:
        subprocess.run(
            ["systemctl", "--user", "reset-failed", GATEWAY_UNIT],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=SYSTEMCTL_PROBE_TIMEOUT,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        started = subprocess.run(
            ["systemctl", "--user", "start", GATEWAY_UNIT],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=SYSTEMCTL_START_TIMEOUT,
            check=False,
        )
    except subprocess.TimeoutExpired:
        # Killing the systemctl client does not cancel a unit that completed in the
        # meantime. Prove the final state once before consuming/reporting the update.
        if gateway_active():
            return True
        log(f"start of {GATEWAY_UNIT} timed out")
        return False
    except OSError as exc:
        log(f"could not invoke systemctl for {GATEWAY_UNIT}: {exc}")
        return False
    if started.returncode != 0:
        log(f"could not start {GATEWAY_UNIT} (systemctl exit {started.returncode})")
        return False
    if not gateway_active():
        log(f"{GATEWAY_UNIT} did not become active")
        return False
    return True


def _tg_via_ip(token, method, data, timeout, ip):
    """One Telegram call with the socket pinned to `ip` (None = default DNS)."""
    path = f"/bot{token}/{method}"
    headers = {}
    if data:
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    if ip is None:
        conn = http.client.HTTPSConnection(API_HOST, timeout=timeout)
    else:
        conn = _PinnedHTTPSConnection(
            API_HOST, ip, timeout=timeout, context=ssl.create_default_context()
        )
    try:
        conn.request("POST" if data else "GET", path, body=data or None, headers=headers)
        resp = conn.getresponse()
        body = resp.read()
        if resp.status != 200:
            # Reaching Telegram and being refused is NOT a connectivity problem;
            # surface it unchanged so the caller's 409/401 handling still works.
            raise urllib.error.HTTPError(
                API.format(token=token, method=method), resp.status,
                resp.reason, resp.headers, None)
        return json.loads(body)
    finally:
        conn.close()


def tg_call(token, method, params=None, timeout=35):
    """Call Telegram, surviving a blocked or v6-only default address.

    Order: last known-good address, then default DNS, then the fallback list.
    Only connection-level failures advance to the next candidate.
    """
    global _pinned_ip
    data = urllib.parse.urlencode(params or {}).encode() if params else None

    candidates = []
    if _pinned_ip is not None:
        candidates.append(_pinned_ip)
    candidates.append(None)
    candidates.extend(ip for ip in TELEGRAM_FALLBACK_IPS if ip != _pinned_ip)

    last_exc = None
    for candidate in candidates:
        try:
            result = _tg_via_ip(token, method, data, timeout, candidate)
        except urllib.error.HTTPError:
            # Telegram ANSWERED and refused. There is nothing to fail over to,
            # and retrying a 409 (a second getUpdates consumer) or a 401 across
            # every address would hammer the API for no reason. Note this clause
            # MUST come first: HTTPError subclasses OSError, so the connection
            # handler below would otherwise swallow it and retry the lot.
            raise
        except (OSError, ssl.SSLError, http.client.HTTPException) as exc:
            # Connection-level: this address is unusable, try the next one.
            last_exc = exc
            continue
        if _pinned_ip != candidate:
            _pinned_ip = candidate
            log(f"Telegram reachable via {candidate or 'default DNS'}")
        return result
    raise last_exc if last_exc else urllib.error.URLError("no Telegram address reachable")


def send_ack(token, chat_id):
    try:
        tg_call(token, "sendMessage", {
            "chat_id": chat_id,
            "text": "⚡ Mo AI is waking up…",
        }, timeout=10)
    except Exception as exc:  # noqa: BLE001 - ack is best-effort
        log(f"ack failed (non-fatal): {exc}")


def send_start_failure(token, chat_id):
    try:
        tg_call(token, "sendMessage", {
            "chat_id": chat_id,
            "text": (
                "تعذّر تشغيل Mo AI على الكمبيوتر. افتح Mo AI ← الإعدادات "
                "لفحص المحرك.\n"
                "Mo AI could not start on the computer. Open Mo AI → Settings "
                "to check the engine."
            ),
        }, timeout=10)
    except Exception as exc:  # noqa: BLE001 - reporting is best-effort
        log(f"start-failure notice failed (non-fatal): {exc}")


def poll_until_wake(token, allow_ids):
    """Long-poll Telegram until an allowlisted user speaks, then wake OpenClaw.

    Returns when OpenClaw has been started (connection handed over). Confirms and
    drops non-allowlisted updates; never confirms the update that triggers a wake.
    """
    offset = None
    backoff = 1
    while True:
        # If OpenClaw came up by any other path, yield the connection immediately.
        if gateway_active():
            return
        params = {"timeout": LONG_POLL, "allowed_updates": json.dumps(["message"])}
        if offset is not None:
            params["offset"] = offset
        try:
            res = tg_call(token, "getUpdates", params, timeout=LONG_POLL + 10)
            backoff = 1
        except urllib.error.HTTPError as exc:
            if exc.code == 409:
                # Another consumer (OpenClaw) is polling — stand down.
                log("409 conflict: OpenClaw owns Telegram; standing down")
                return
            log(f"getUpdates HTTP {exc.code}; backoff {backoff}s")
            time.sleep(backoff); backoff = min(backoff * 2, BACKOFF_MAX); continue
        except Exception as exc:  # noqa: BLE001 - network hiccups
            log(f"getUpdates error: {exc}; backoff {backoff}s")
            time.sleep(backoff); backoff = min(backoff * 2, BACKOFF_MAX); continue

        if not res.get("ok"):
            time.sleep(backoff); backoff = min(backoff * 2, BACKOFF_MAX); continue

        for upd in res.get("result", []):
            uid = upd.get("update_id")
            msg = upd.get("message") or {}
            frm = str((msg.get("from") or {}).get("id", ""))
            chat_id = (msg.get("chat") or {}).get("id")
            if frm and frm in allow_ids:
                # Authorised: wake first. Only claim success and hand off the
                # unconfirmed update after systemd proves the gateway is active.
                # A failed start is reported and consumed, otherwise the wake
                # receiver would retry the same update forever while claiming
                # that a dead service is waking.
                log(f"authorised message from {frm}; waking")
                if start_gateway():
                    if chat_id is not None:
                        send_ack(token, chat_id)
                    return
                if chat_id is not None:
                    send_start_failure(token, chat_id)
                if uid is not None:
                    offset = uid + 1
                continue
            # Not on the allowlist (or a non-message update): confirm past it so it
            # neither wakes the box nor is seen again. Never wake for a stranger.
            if uid is not None:
                offset = uid + 1


def main():
    log("started (Telegram wake receiver; no model loaded)")
    backoff = 1
    while True:
        token, allow_ids = load_telegram()
        if not token or not allow_ids:
            # Not configured yet (no bot token / empty allowlist). Wait quietly;
            # the Agent panel writes these, then this picks them up.
            time.sleep(min(BACKOFF_MAX, backoff * 5))
            backoff = min(backoff + 1, 12)
            continue
        backoff = 1
        if gateway_active():
            # OpenClaw owns the Telegram connection. Idle here until it sleeps.
            time.sleep(IDLE_RECHECK)
            continue
        poll_until_wake(token, allow_ids)
        # After a wake, give OpenClaw a moment to grab the connection before we
        # consider polling again.
        time.sleep(IDLE_RECHECK)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
