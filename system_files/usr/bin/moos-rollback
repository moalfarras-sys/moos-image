#!/usr/bin/python3
"""MoOS Recovery — go back to the version that worked.

THIN UX ONLY — no new recovery logic (MOOS_ARCHITECTURE.md §9 non-goals). This is still a thin
front-end over `bootc rollback`; it invents nothing.

What changed is the front. It was a numbered menu launched with Terminal=true, which does not open
YOUR app — it opens KONSOLE and runs you inside it. So the window in the dock wore Konsole's icon
and Konsole's name, next to a "MoOS Recovery" launcher that never lit up. The owner reported it as
"the app opens with two different icons"; there were two, and neither was Recovery.

Recovery is also the one screen a person reaches when they are already having a bad day. It has to
be the calmest thing in the OS, not a wall of shell output: which version you are on, which one
you would go back to, one button, and a plain sentence about what that button does.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/moos")

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk  # noqa: E402

from moos_ui2 import MoOSApp, local_text, logical_start  # noqa: E402


def deployments():
    """(booted, rollback_target, already_queued), or (None, None, False) if we cannot tell.

    Read from rpm-ostree's JSON, never scraped from its pretty output: the pretty output is for
    people, it is localised, and it is allowed to change shape. Recovery is the last screen in the
    system that may ever guess.

    EVERY return here is a 3-tuple, and that is load-bearing. The call site unpacks three names
    (`booted, target, queued = deployments()`), so a 2-tuple is not a degraded answer — it is a
    ValueError that stops Recovery from drawing at all. The `already_queued` element was added
    later, and these two failure paths kept returning pairs: `rpm-ostree status` exiting non-zero,
    and it failing to run or emitting unparseable JSON. Both describe a system whose rpm-ostree is
    unwell, which is the one condition under which somebody opens Recovery — so the screen crashed
    exactly when it was needed and worked perfectly whenever it was not.
    """
    try:
        r = subprocess.run(["rpm-ostree", "status", "--json"],
                           capture_output=True, text=True, timeout=25)
        if r.returncode != 0:
            return None, None, False
        deps = json.loads(r.stdout).get("deployments", [])
    except (OSError, subprocess.SubprocessError, ValueError):
        return None, None, False

    # WHAT ROLLBACK ACTUALLY DOES, quoting `man rpm-ostree` (bootc behaves the same way):
    #
    #   "The entry at index 0 is the default bootloader entry. ... This command then changes
    #    the default bootloader entry. If the current default is booted, then set the default
    #    to the previous entry. Otherwise, make the currently booted tree the default."
    #
    # So there are two states and the button means something different in each:
    #
    #   booted IS index 0   -> pressing it QUEUES a return to the next non-staged entry.
    #   booted is NOT index 0 -> a return is ALREADY queued, and pressing it CANCELS that
    #                            and makes the running system the default again.
    #
    # Two earlier versions got this wrong. "First deployment that is not booted" named a
    # STAGED UPDATE as the thing rollback returns to — a version NEWER than the one running,
    # the exact opposite of what the button does. Replacing that with "the entry after
    # booted" fixed the staged case and broke the second state: once a rollback was queued,
    # booted is no longer index 0 and there is nothing after it, so Recovery told a user in
    # the middle of a rescue "no previous version on this machine" and greyed out its only
    # button.
    #
    # A staged deployment is excluded by its own flag. That flag IS present in this
    # rpm-ostree's JSON — every deployment carries "staged": true/false (an earlier commit
    # message claimed otherwise; it was reading a probe that hid false values).
    #
    # Returns (booted_label, target_label, already_queued).
    def label_of(d):
        version = d.get("version")
        short = (d.get("checksum") or "")[:12]
        # Layered packages do not change the base version, so two deployments can report the
        # SAME version string and the two cards would read identically. Disambiguate with the
        # commit when that happens — the user needs to see that these are different systems.
        if version and short:
            same = [x for x in deps if x.get("version") == version]
            if len(same) > 1:
                return f"{version} ({short})"
        return version or short or "?"

    booted_at = next((i for i, d in enumerate(deps) if d.get("booted")), None)
    if booted_at is None:
        return None, None, False

    # What sits AHEAD of booted decides which of the two states we are in — but only a
    # NON-STAGED entry counts. A staged deployment is a pending upgrade that also sorts
    # ahead of booted, and it is not a queued rollback: with only staged entries ahead,
    # booted is still the deployment rollback moves away from.
    ahead = [d for d in deps[:booted_at] if not d.get("staged")]
    if ahead:
        # A previous deployment is already the default. The machine will come back on it,
        # and pressing the button now makes the RUNNING system the default again.
        return label_of(deps[booted_at]), label_of(ahead[0]), True

    target = next((d for d in deps[booted_at + 1:] if not d.get("staged")), None)
    return label_of(deps[booted_at]), (label_of(target) if target else None), False


class Recovery(MoOSApp):
    APP_ID = "org.moos.recovery"     # == org.moos.recovery.desktop — see MoOSApp's docstring
    TITLE = local_text("استرداد MoOS", "MoOS Recovery")
    SIZE = (760, 590)

    def build(self, page):
        booted, target, queued = deployments()
        # Keep the state that gives `bootc rollback` its meaning.  The command is
        # a toggle: when a rollback is already queued it CANCELS that rollback,
        # rather than queueing another one.  Every sentence before and after the
        # action must branch on the same value as the button label.
        self.booted_label = booted
        self.target_label = target
        self.rollback_queued = queued

        page.append(self.title(local_text("استرداد MoOS", "MoOS Recovery")))
        page.append(self.subtitle(local_text(
            "إذا عطّل التحديث الأخير شيئاً، ارجع إلى النسخة السابقة. "
            "لن تتغيّر ملفاتك أو إعداداتك.",
            "If the last update broke something, return to the previous version. "
            "Your files and settings are not touched.",
        )))

        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        icon_plate = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        icon_plate.add_css_class("ui2-icon-plate")
        icon = Gtk.Image.new_from_icon_name("moos-repair-symbolic")
        icon.set_pixel_size(34)
        icon_plate.append(icon)
        hero.append(icon_plate)
        hero_copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3,
                            hexpand=True, valign=Gtk.Align.CENTER)
        hero_kicker = Gtk.Label(
            label=local_text("مسار عودة آمن", "Safe return path"),
            xalign=logical_start(),
        )
        hero_kicker.add_css_class("ui2-kicker")
        hero_value = Gtk.Label(
            label=local_text(
                "غيّر قرار الإقلاع، وليس ملفاتك",
                "Change the boot choice, never your files",
            ),
            xalign=logical_start(),
            wrap=True,
        )
        hero_value.add_css_class("ui2-value")
        hero_copy.append(hero_kicker)
        hero_copy.append(hero_value)
        hero.append(hero_copy)
        page.append(self.card(hero, spacing=0))

        now = Gtk.Label(xalign=logical_start(), wrap=True)
        now.set_markup(f"<b>{GLib.markup_escape_text(booted or '—')}</b>")
        now.add_css_class("ui2-value")
        current_heading = Gtk.Label(
            label=local_text("تعمل الآن على", "You are running"),
            xalign=logical_start(),
        )
        current_heading.add_css_class("ui2-kicker")

        back = Gtk.Label(xalign=logical_start(), wrap=True)
        if target:
            back.set_markup(f"<b>{GLib.markup_escape_text(target)}</b>")
        else:
            back.set_markup(
                "<span alpha='65%'>"
                + local_text(
                    "لا توجد نسخة سابقة على هذا الجهاز",
                    "No previous version exists on this machine",
                )
                + "</span>"
            )
        # The heading has to match the state, or it says the opposite of what will happen.
        self.target_heading = Gtk.Label(
            label=(
                local_text(
                    "سيقلع الجهاز على",
                    "Your next restart will use",
                )
                if queued
                else local_text(
                    "سيعيدك الرجوع إلى",
                    "Rollback would return you to",
                )
            ),
            xalign=logical_start(),
        )
        self.target_heading.add_css_class("ui2-kicker")
        self.target_version = back
        back.add_css_class("ui2-value")
        version_path = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        version_path.append(current_heading)
        version_path.append(now)
        version_path.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))
        version_path.append(self.target_heading)
        version_path.append(back)
        page.append(self.card(version_path, spacing=0))

        self.status = Gtk.Label(xalign=logical_start(), wrap=True)
        self.status.add_css_class("ui2-status")
        self.status.set_text(
            local_text(
                "الرجوع مُجهَّز بالفعل. أعد التشغيل لتطبيقه، أو ألغِه "
                "للبقاء على النسخة الحالية.",
                "A rollback is already queued. Restart to apply it, or cancel it "
                "to stay on the version you are running.",
            )
            if queued
            else local_text(
                "الرجوع ليس فورياً؛ يُطبَّق عند إعادة التشغيل ويمكن التراجع عنه.",
                "Rollback is not immediate. It applies on restart and is reversible.",
            )
        )

        self.log = Gtk.TextView(editable=False, monospace=True)
        self.log.add_css_class("ui2-log")
        log_scroll = Gtk.ScrolledWindow(hexpand=True)
        log_scroll.add_css_class("ui2-log-frame")
        log_scroll.set_min_content_height(120)
        log_scroll.set_child(self.log)

        self.spinner = Gtk.Spinner()
        self.spinner.set_visible(False)
        self.details = Gtk.Expander(
            label=local_text("التفاصيل التقنية", "Technical details")
        )
        self.details.add_css_class("ui2-details")
        self.details.set_child(log_scroll)
        page.append(self.card(self.status, self.spinner, self.details))

        # Same command either way (rpm-ostree/bootc rollback toggles the default entry), so
        # the LABEL must say which of the two things it is about to do.
        self.back_btn = Gtk.Button(
            label=(
                local_text(
                    "ألغِ الرجوع المُجهَّز",
                    "Cancel the queued rollback",
                )
                if queued
                else local_text(
                    "ارجع إلى النسخة السابقة",
                    "Return to the previous version",
                )
            )
        )
        self.back_btn.add_css_class("destructive-action")
        self.back_btn.set_sensitive(bool(target))
        self.back_btn.connect("clicked", self.on_rollback)

        self.reboot_btn = Gtk.Button(
            label=local_text("إعادة التشغيل الآن", "Restart now")
        )
        self.reboot_btn.add_css_class("suggested-action")
        self.reboot_btn.set_visible(False)
        self.reboot_btn.connect(
            "clicked", lambda *_: os.execvp("systemctl", ["systemctl", "reboot"]))

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, halign=Gtk.Align.END)
        row.append(self.back_btn)
        row.append(self.reboot_btn)
        page.append(row)

    def say(self, text):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), text if text.endswith("\n") else text + "\n")
        self.log.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0.0, 0.0)

    def on_rollback(self, _btn):
        # Ask first. This is the one button in MoOS that changes which operating system boots next.
        # It is reversible — and somebody who did not mean to press it should still be asked.
        dlg = Gtk.AlertDialog()
        if self.rollback_queued:
            dlg.set_message(local_text(
                "إلغاء الرجوع المُجهَّز؟",
                "Cancel the queued rollback?",
            ))
            dlg.set_detail(local_text(
                "سيبقى الجهاز على النسخة التي تعمل عليها الآن بعد إعادة التشغيل. "
                "لن تتغيّر ملفاتك أو إعداداتك.",
                "The next restart will keep the version you are running. "
                "Your files and settings are unchanged.",
            ))
            dlg.set_buttons([
                local_text("إلغاء", "Cancel"),
                local_text("ألغِ الرجوع", "Cancel rollback"),
            ])
        else:
            dlg.set_message(local_text(
                "الرجوع إلى النسخة السابقة؟",
                "Return to the previous version?",
            ))
            dlg.set_detail(local_text(
                "يُطبَّق عند إعادة التشغيل القادمة. لن تتغيّر ملفاتك أو إعداداتك.",
                "It applies on your next restart. Your files and settings are unchanged.",
            ))
            dlg.set_buttons([
                local_text("إلغاء", "Cancel"),
                local_text("ارجع", "Roll back"),
            ])
        dlg.set_cancel_button(0)
        dlg.set_default_button(0)
        dlg.choose(self.win, None, self._confirmed)

    def _confirmed(self, dlg, result):
        try:
            if dlg.choose_finish(result) != 1:
                return
        except GLib.Error:
            return

        # Preserve the meaning even if some external tool changes the deployment
        # state while pkexec is open.  This operation answers the confirmation the
        # user just saw; its completion copy must describe that same operation.
        self.action_cancels_rollback = self.rollback_queued
        self.back_btn.set_sensitive(False)
        self.say("$ bootc rollback")
        self.spinner.set_visible(True)
        self.spinner.start()
        self.run_async(["pkexec", "bootc", "rollback"], self._rollback_done)

    def run_async(self, cmd, on_done):
        """Stream bootc without blocking GTK's main loop.

        Recovery used to call subprocess.run(timeout=180) from the confirmation
        callback.  While Polkit waited, and for the whole rollback operation, the
        rescue window stopped painting and looked crashed.  The updater already
        uses this GLib pipe pattern for the same bootc/Polkit combination.
        """
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
        except OSError as exc:
            self.say(str(exc))
            on_done(127)
            return

        def complete_when_exited():
            returncode = proc.poll()
            if returncode is None:
                return True
            on_done(returncode)
            return False

        def pump(_source, _condition):
            line = proc.stdout.readline()
            if line:
                self.say(line.rstrip("\n"))
                return True
            # EOF normally arrives with process exit, but a child is allowed to
            # close stdout earlier. Never turn that unusual case into a blocking
            # wait on GTK's callback: poll it at a low duty cycle instead.
            if proc.poll() is None:
                GLib.timeout_add(50, complete_when_exited)
            else:
                on_done(proc.returncode)
            return False

        GLib.io_add_watch(
            proc.stdout,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            pump,
        )

    def _rollback_done(self, returncode):
        self.spinner.stop()
        self.spinner.set_visible(False)

        if returncode == 0:
            self.status.add_css_class("success")
            if self.action_cancels_rollback:
                self.rollback_queued = False
                self.status.set_text(local_text(
                    "✓ أُلغي الرجوع. ستبقى على النسخة الحالية بعد إعادة التشغيل.",
                    "✓ Rollback cancelled. The next restart keeps the version "
                    "you are running.",
                ))
                self.target_heading.set_label(local_text(
                    "سيبقى الجهاز على",
                    "Your next restart will keep",
                ))
                self.target_version.set_markup(
                    f"<b>{GLib.markup_escape_text(self.booted_label or '—')}</b>")
            else:
                self.rollback_queued = True
                self.status.set_text(local_text(
                    "✓ جاهز. أعد التشغيل لتعود إلى النسخة السابقة.",
                    "✓ Done. Restart to return to the previous version.",
                ))
                self.target_heading.set_label(local_text(
                    "سيقلع الجهاز على",
                    "Your next restart will use",
                ))
            self.reboot_btn.set_visible(True)
        else:
            self.status.add_css_class("error")
            if self.action_cancels_rollback:
                self.status.set_text(local_text(
                    "لم يُلغَ الرجوع المُجهَّز. لم يتغيّر اختيار الإقلاع.",
                    "The queued rollback was not cancelled. "
                    "The boot choice is unchanged.",
                ))
            else:
                self.status.set_text(local_text(
                    "لم يكتمل الرجوع. لم يتغيّر نظامك الحالي.",
                    "Rollback did not complete. Your system is unchanged.",
                ))
            self.back_btn.set_sensitive(True)


Recovery().run()
