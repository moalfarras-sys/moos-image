#!/usr/bin/env bash
# moos-theme — switch MoOS between its light and dark look.
#
#   moos-theme            show which one is active
#   moos-theme dark       MoOS UI2 Graphite — the default
#   moos-theme light      MoOS UI2 Tidal Light
#   moos-theme toggle     the other UI2 variant
#   moos-theme auto       follow sunrise/sunset, between the two UI2 themes
#   moos-theme ui1-dark   explicit rollback to MoOS UI1 Dark
#   moos-theme ui1-light  explicit rollback to MoOS UI1 Light
#
# WHY A SCRIPT AND NOT JUST SYSTEM SETTINGS
#
# Applying a Global Theme is necessary but NOT sufficient — three things it does
# not carry have to be written alongside it, and each of them has bitten this
# image before:
#
#   * Konsole. Its colour scheme is not a KDE colour scheme and does not follow
#     one, so a light desktop keeps a black terminal until konsolerc is told.
#   * GTK. gtkconfig regenerates the GTK palette from the active KDE scheme, but
#     it never sets gtk-application-prefer-dark-theme — so Firefox stays dark on
#     a light desktop, and it reads three sources, of which settings.ini is the
#     weakest (Wayland -> GSettings, X11 -> xsettingsd).
#   * The day/night switch. Plasma resolves DefaultLight/DefaultDarkLookAndFeel
#     BY NAME, and if the named package is missing it falls back to BREEZE and
#     persists that. Both targets are pinned to MoOS themes here, so the switch
#     can only ever land on MoOS.
#
# See AGENTS.md, "A theme this image ships is not a theme the user gets".
set -uo pipefail

DARK_LNF="org.moos.ui2"
LIGHT_LNF="org.moos.ui2.light"
UI1_DARK_LNF="org.moos.ui"
UI1_LIGHT_LNF="org.moos.ui.light"

usage() {
    cat <<'EOF'
moos-theme — بدّل مظهر MoOS بين الفاتح والداكن | switch MoOS light/dark

  moos-theme            الحالي | show the active theme
  moos-theme dark       داكن   | MoOS UI2 Graphite (the default)
  moos-theme light      فاتح   | MoOS UI2 Tidal Light
  moos-theme toggle     بدّل   | switch to the other UI2 variant
  moos-theme auto       تلقائي | follow sunrise/sunset with UI2
  moos-theme ui1-dark   رجوع  | rollback to MoOS UI1 Dark
  moos-theme ui1-light  رجوع  | rollback to MoOS UI1 Light
EOF
}

current() {
    kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null
}

switch_dashboard() {
    command -v gdbus >/dev/null 2>&1 || return 1
    command -v timeout >/dev/null 2>&1 || return 1

    local target="$1" other x=80 y=70 width height result migration_failed=0
    if [ "$target" = "org.moos.ui2.dashboard" ]; then
        other="org.moos.nova.deskclock"
        width=560; height=220
    else
        other="org.moos.ui2.dashboard"
        width=430; height=400
    fi

    # Instantiate the destination first. Only after a second scan proves that
    # its QML loaded do we remove the other family's dashboard.
    result="$(timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var TARGET = "'"$target"'";
            var OTHER = "'"$other"'";
            var swapped = false;
            var ds = desktops();
            for (var i = 0; i < ds.length; i++) {
                var d = ds[i];
                var ws = d.widgets();
                var ready = false;
                var old = [];
                for (var j = 0; j < ws.length; j++) {
                    if (ws[j].type == TARGET) { ready = true; }
                    if (ws[j].type == OTHER) { old.push(ws[j]); }
                }
                if (!ready) {
                    d.addWidget(TARGET, '"$x"', '"$y"', '"$width"', '"$height"');
                    var after = d.widgets();
                    for (var n = 0; n < after.length; n++) {
                        if (after[n].type == TARGET) { ready = true; break; }
                    }
                }
                if (ready && old.length > 0) {
                    for (var k = 0; k < old.length; k++) { old[k].remove(); }
                    swapped = true;
                }
            }
            print(swapped ? "dashboard-swapped" : "dashboard-ready");
        ' 2>/dev/null)" || return 1

    # The first add collision-avoids the still-present old card. Once that card
    # has left Folder View's geometry map, recreate the proven target at its
    # intended inset. Separate D-Bus turns are required; one turn sees a phantom
    # collision and snaps UI2 to 0,0.
    if [[ "$result" == *dashboard-swapped* ]]; then
        sleep 2
        timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var TARGET = "'"$target"'";
                var OTHER = "'"$other"'";
                var ds = desktops();
                for (var i = 0; i < ds.length; i++) {
                    var ws = ds[i].widgets();
                    var blocked = false;
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == OTHER) { blocked = true; }
                    }
                    if (blocked) { continue; }
                    for (var k = 0; k < ws.length; k++) {
                        if (ws[k].type == TARGET) { ws[k].remove(); }
                    }
                }
            ' >/dev/null 2>&1 || migration_failed=1
        sleep 2
        timeout 8s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.kde.PlasmaShell.evaluateScript '
                var TARGET = "'"$target"'";
                var OTHER = "'"$other"'";
                var ds = desktops();
                for (var i = 0; i < ds.length; i++) {
                    var ws = ds[i].widgets();
                    var blocked = false;
                    for (var j = 0; j < ws.length; j++) {
                        if (ws[j].type == TARGET || ws[j].type == OTHER) { blocked = true; }
                    }
                    if (!blocked) {
                        ds[i].addWidget(TARGET, '"$x"', '"$y"', '"$width"', '"$height"');
                    }
                }
            ' >/dev/null 2>&1 || migration_failed=1
    fi
    [ "$migration_failed" -eq 0 ]
}

load_profile() {
    local lnf="$1"
    case "$lnf" in
        "$LIGHT_LNF")
            scheme=MoOSUI2Light
            style=MoOSUI2Light
            konsole_profile=MoOSUI2Light.profile
            icons=MoOSUI2Light
            adw_css=/usr/share/moos/gtk/moos-ui2-light.css
            cursor=NovaShadow
            deco=__aurorae__svg__MoOSUI2Light
            wallpaper_package=/usr/share/wallpapers/MoOSUI2Tide
            wallpaper=${wallpaper_package}/contents/images/3840x2160.jpg
            widget=org.moos.ui2.dashboard
            prefer_dark=false
            label="MoOS UI2: فاتح | light"
            ;;
        "$DARK_LNF")
            scheme=MoOSUI2Dark
            style=MoOSUI2
            konsole_profile=MoOSUI2.profile
            icons=MoOSUI2
            adw_css=/usr/share/moos/gtk/moos-ui2-dark.css
            cursor=NovaIce
            deco=__aurorae__svg__MoOSUI2
            wallpaper_package=/usr/share/wallpapers/MoOSUI2Graphite
            wallpaper=${wallpaper_package}/contents/images_dark/3840x2160.jpg
            widget=org.moos.ui2.dashboard
            prefer_dark=true
            label="MoOS UI2: داكن | dark"
            ;;
        "$UI1_LIGHT_LNF")
            scheme=MoOSUILight
            style=MoOSUILight
            konsole_profile=MoOSUILight.profile
            icons=NovaLight
            adw_css=
            cursor=NovaIce
            deco=__aurorae__svg__MoOSUILight
            wallpaper_package=/usr/share/wallpapers/MoOSUIAtmosphere
            wallpaper=${wallpaper_package}/contents/images/3840x2160.png
            widget=org.moos.nova.deskclock
            prefer_dark=false
            label="MoOS UI1 rollback: فاتح | light"
            ;;
        "$UI1_DARK_LNF")
            scheme=MoOSUIDark
            style=MoOSUI
            konsole_profile=MoOSUI.profile
            icons=Nova
            adw_css=
            cursor=NovaIce
            deco=__aurorae__svg__MoOSUI
            wallpaper_package=/usr/share/wallpapers/MoOSUIAtmosphere
            wallpaper=${wallpaper_package}/contents/images_dark/3840x2160.png
            widget=org.moos.nova.deskclock
            prefer_dark=true
            label="MoOS UI1 rollback: داكن | dark"
            ;;
        *)
            echo "moos-theme: unknown MoOS look-and-feel: $lnf" >&2
            return 2
            ;;
    esac
}

run_with_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 8s "$@"
    else
        "$@"
    fi
}

# The pieces LookAndFeelManager does not reliably carry. Keep this separate from
# `apply` because Plasma's built-in sunrise/sunset switch changes the LNF package
# itself; the path-activated sync service calls this after that transition so
# Konsole, GTK, wallpaper, lock screen and the dashboard land on the same half.
# Deliberately do not write kdeglobals here: that is the file watched by the path
# unit, and touching it would turn a one-shot reconciliation into a feedback loop.
apply_supplements() {
    local include_widget="${1:-true}" ini xs v supplement_failed=0

    # The wallpaper is NOT reliably carried by the Global Theme — measured:
    # applying a light LNF left the previous dark wallpaper in place.
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1 && [ -f "$wallpaper" ]; then
        run_with_timeout plasma-apply-wallpaperimage "$wallpaper" >/dev/null 2>&1 \
            || supplement_failed=1
    else
        supplement_failed=1
    fi

    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kscreenlockerrc --group Greeter \
            --key WallpaperPlugin org.kde.image || supplement_failed=1
        kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
            --group org.kde.image --group General --key Image "$wallpaper_package" \
            || supplement_failed=1

        # Konsole profiles are independent from KDE colour schemes.
        kwriteconfig6 --file konsolerc --group "Desktop Entry" \
            --key DefaultProfile "$konsole_profile" || supplement_failed=1

        # settings.ini is GTK's fallback; Wayland and X11 sources follow below.
        # A missing file is CREATED, not skipped: a fresh user whose gtkconfig
        # has not materialised these yet used to keep an empty GTK theme name,
        # which means Adwaita — the exact failure AGENTS.md documents. And the
        # stylesheet NAME is pinned when absent (Breeze: Plasma's gtkconfig
        # feeds the active KDE palette into that stylesheet; only the name was
        # ever missing).
        for ini in "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"; do
            if [ ! -f "$ini" ]; then
                mkdir -p "$(dirname "$ini")" && printf '[Settings]\n' >"$ini" \
                    || { supplement_failed=1; continue; }
            fi
            kwriteconfig6 --file "$ini" --group Settings \
                --key gtk-application-prefer-dark-theme "$prefer_dark" \
                || supplement_failed=1
            if [ -z "$(kreadconfig6 --file "$ini" --group Settings \
                        --key gtk-theme-name 2>/dev/null)" ]; then
                kwriteconfig6 --file "$ini" --group Settings \
                    --key gtk-theme-name Breeze || supplement_failed=1
            fi
        done
    else
        supplement_failed=1
    fi

    # libadwaita ignores gtk-theme-name entirely, so Bazaar — MoOS's own app
    # store — and every Flathub app rendered stock Adwaita blue on a turquoise
    # desktop. Flatpaks read the fix through the xdg-config/gtk-4.0:ro hole
    # seeded by moos-gtk-overrides.conf.
    #
    # gtk.css is NOT ours to own: Plasma's gtkconfig writes it at login
    # (`@import 'colors.css';`) before this script ever runs — verified live
    # on the 2026-07-14 ISO, where a replace-with-marker approach simply never
    # installed anything. So MoOS keeps its palette in its own file,
    # moos-ui2.css, and only APPENDS one import line to gtk.css. Appended
    # after gtkconfig's import, its @define-color values win. UI1 sets
    # adw_css empty: the file and the import line are then removed, and stock
    # Adwaita returns, because UI1's palette never included libadwaita.
    css_dir="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
    css_ours="$css_dir/moos-ui2.css"
    css_gtk="$css_dir/gtk.css"
    if [ -z "$adw_css" ]; then
        rm -f "$css_ours" || supplement_failed=1
        if [ -f "$css_gtk" ] && grep -q "moos-ui2.css" "$css_gtk" 2>/dev/null; then
            sed -i '/moos-ui2\.css/d' "$css_gtk" || supplement_failed=1
        fi
    else
        mkdir -p "$css_dir" \
            && cp -f "$adw_css" "$css_ours" || supplement_failed=1
        if [ ! -f "$css_gtk" ] || ! grep -q "moos-ui2.css" "$css_gtk" 2>/dev/null; then
            printf "@import 'moos-ui2.css';\n" >>"$css_gtk" || supplement_failed=1
        fi
    fi

    # Wayland GTK/libadwaita apps.
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface color-scheme \
            "$([ "$prefer_dark" = true ] && echo prefer-dark || echo prefer-light)" \
            2>/dev/null || supplement_failed=1
    else
        supplement_failed=1
    fi

    # X11/XWayland GTK apps.
    xs="${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
    if [ -f "$xs" ]; then
        v=0; [ "$prefer_dark" = true ] && v=1
        if grep -q '^Net/PreferDarkTheme ' "$xs" 2>/dev/null; then
            sed -i "s|^Net/PreferDarkTheme .*|Net/PreferDarkTheme ${v}|" "$xs" \
                || supplement_failed=1
        else
            echo "Net/PreferDarkTheme ${v}" >>"$xs" || supplement_failed=1
        fi
        pkill -HUP -x xsettingsd 2>/dev/null || true
    fi

    if [ "$include_widget" = true ]; then
        switch_dashboard "$widget" || supplement_failed=1
    fi
    [ "$supplement_failed" -eq 0 ]
}

auto_wallpapers_complete() {
    local expected="$1" result desktops matching
    command -v gdbus >/dev/null 2>&1 || return 1
    command -v timeout >/dev/null 2>&1 || return 1
    result="$(timeout 4s gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
        -m org.kde.PlasmaShell.evaluateScript '
            var expected = "'"$expected"'";
            var ds = desktops();
            var matching = 0;
            for (var i = 0; i < ds.length; i++) {
                ds[i].currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
                var image = String(ds[i].readConfig("Image", ""));
                if (ds[i].wallpaperPlugin == "org.kde.image"
                        && image.indexOf(expected) >= 0) { matching++; }
            }
            print("desktops=" + ds.length + ";matching=" + matching);
        ' 2>/dev/null)" || return 1
    result="$(printf '%s\n' "$result" \
        | grep -oE 'desktops=[1-9][0-9]*;matching=[0-9]+' | head -n1)"
    [ -n "$result" ] || return 1
    desktops="${result#desktops=}"
    desktops="${desktops%%;*}"
    matching="${result##*matching=}"
    [ "$desktops" = "$matching" ]
}

automatic_supplements_complete() {
    local expected_color lock_plugin lock_image konsole_actual gtk_actual ini xs

    [ "$(current)" = "$lnf" ] || return 1
    auto_wallpapers_complete "$wallpaper_package" || return 1

    lock_plugin="$(kreadconfig6 --file kscreenlockerrc --group Greeter \
        --key WallpaperPlugin 2>/dev/null)"
    lock_image="$(kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group org.kde.image --group General --key Image 2>/dev/null)"
    [ "$lock_plugin" = org.kde.image ] || return 1
    case "$lock_image" in *"$wallpaper_package"*) ;; *) return 1 ;; esac

    konsole_actual="$(kreadconfig6 --file konsolerc --group "Desktop Entry" \
        --key DefaultProfile 2>/dev/null)"
    [ "$konsole_actual" = "$konsole_profile" ] || return 1

    expected_color=prefer-light
    [ "$prefer_dark" = true ] && expected_color=prefer-dark
    gtk_actual="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null \
        | tr -d "'[:space:]")"
    [ "$gtk_actual" = "$expected_color" ] || return 1

    for ini in "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" \
               "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"; do
        [ -f "$ini" ] || continue
        [ "$(kreadconfig6 --file "$ini" --group Settings \
            --key gtk-application-prefer-dark-theme 2>/dev/null)" = "$prefer_dark" ] \
            || return 1
    done

    xs="${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
    if [ -f "$xs" ]; then
        if [ "$prefer_dark" = true ]; then
            grep -q '^Net/PreferDarkTheme 1$' "$xs" || return 1
        else
            grep -q '^Net/PreferDarkTheme 0$' "$xs" || return 1
        fi
    fi
    return 0
}

apply() {
    local lnf="$1" scheme style konsole_profile prefer_dark icons adw_css cursor deco wallpaper wallpaper_package widget label
    load_profile "$lnf" || return

    plasma-apply-lookandfeel -a "$lnf" >/dev/null 2>&1 \
        || { echo "moos-theme: could not apply $lnf" >&2; return 1; }

    # The Global Theme carries the colour scheme, but applying it again directly is
    # cheap and closes the window where LookAndFeelManager skips it.
    plasma-apply-colorscheme "$scheme" >/dev/null 2>&1 || true

    # Each half gets the pointer that reads against ITS canvas: NovaIce on
    # graphite, NovaShadow on Tidal Light's mint (a white pointer there is a
    # low-contrast pointer). The LNF defaults say the same; applying directly
    # closes the window where LookAndFeelManager skips the cursor kcm.
    if command -v plasma-apply-cursortheme >/dev/null 2>&1; then
        plasma-apply-cursortheme "$cursor" >/dev/null 2>&1 || true
    fi

    # The icon theme is not colour-scheme aware: Nova's symbolics are drawn light so
    # they read on a dark panel, and they disappear on porcelain.
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$lnf"
        kwriteconfig6 --file kdeglobals --group General --key ColorScheme "$scheme"
        kwriteconfig6 --file plasmarc --group Theme --key name "$style"
        kwriteconfig6 --file kdeglobals --group Icons --key Theme "$icons"
        kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
        kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$deco"
        kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft XIA
        kwriteconfig6 --file ksplashrc --group KSplash --key Theme "$lnf"
        kwriteconfig6 --file ksplashrc --group KSplash --key Engine KSplashQML
        kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme "$cursor"
    fi

    if ! apply_supplements; then
        echo "moos-theme: $lnf applied, but one or more full-theme supplements failed" >&2
        return 1
    fi

    # KWin has to be told, or the new decoration only appears at the next login and
    # the switch reads as broken.
    command -v gdbus >/dev/null 2>&1 && \
        run_with_timeout gdbus call --session -d org.kde.KWin -o /KWin \
            -m org.kde.KWin.reconfigure >/dev/null 2>&1 || true

    echo "$label"
}

sync_auto() {
    local automatic lnf automatic_after lnf_after scheme style konsole_profile prefer_dark icons deco wallpaper wallpaper_package widget label

    command -v kreadconfig6 >/dev/null 2>&1 || return 1
    automatic="$(kreadconfig6 --file kdeglobals --group KDE \
        --key AutomaticLookAndFeel 2>/dev/null)"
    [ "$automatic" = true ] || return 0

    lnf="$(current)"
    case "$lnf" in
        "$DARK_LNF"|"$LIGHT_LNF") ;;
        *) return 0 ;;
    esac

    # KConfig may emit several path events during one LNF transaction. Read the
    # selector twice and only act on a stable pair; a racing transition returns
    # failure so systemd performs its bounded retry against the final state.
    sleep 1
    automatic_after="$(kreadconfig6 --file kdeglobals --group KDE \
        --key AutomaticLookAndFeel 2>/dev/null)"
    lnf_after="$(current)"
    [ "$automatic_after" = "$automatic" ] && [ "$lnf_after" = "$lnf" ] || return 1
    [ -d "/usr/share/plasma/look-and-feel/$lnf" ] || return 1
    load_profile "$lnf" || return 1

    # UI2 Dark and Light intentionally share one adaptive dashboard. Do not
    # remove/recreate it at sunrise and sunset; only the variant supplements move.
    if apply_supplements false && automatic_supplements_complete; then
        echo "MoOS automatic theme supplements synced for ${lnf}"
        return 0
    fi
    echo "moos-theme: automatic supplement sync failed for ${lnf}" >&2
    return 1
}

# Both automatic targets are the complete UI2 themes. That is the entire safety
# property: Plasma resolves these by name when the switch fires, and a name it
# cannot resolve sends it to Breeze — permanently, in the user's own kdeglobals.
# UI1 remains installed and is reachable only through the explicit rollback
# commands; `auto` always returns to the current UI2 family.
pin_switch_targets() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel "$LIGHT_LNF"
    kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel "$DARK_LNF"
}

acquire_theme_lock() {
    command -v flock >/dev/null 2>&1 || return 0
    local lock_dir="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}}"
    mkdir -p "$lock_dir" 2>/dev/null || return 1
    exec 9>"${lock_dir}/moos-theme.lock" || return 1
    flock -w 30 9
}

command_name="${1:-status}"
case "$command_name" in
    dark|light|toggle|auto|sync-auto|ui1-dark|ui1-light)
        acquire_theme_lock \
            || { echo "moos-theme: another theme transition is still running" >&2; exit 1; }
        ;;
esac

case "$command_name" in
    dark)
        pin_switch_targets
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false 2>/dev/null || true
        apply "$DARK_LNF"
        ;;
    light)
        pin_switch_targets
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false 2>/dev/null || true
        apply "$LIGHT_LNF"
        ;;
    toggle)
        pin_switch_targets
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false 2>/dev/null || true
        case "$(current)" in
            "$LIGHT_LNF"|"$UI1_LIGHT_LNF") apply "$DARK_LNF" ;;
            *) apply "$LIGHT_LNF" ;;
        esac
        ;;
    auto)
        command -v systemctl >/dev/null 2>&1 && \
            systemctl --user start moos-theme-sync.path >/dev/null 2>&1 || true
        pin_switch_targets
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel true \
            || { echo "moos-theme: could not enable automatic switching" >&2; exit 1; }
        sync_auto || exit 1
        echo "MoOS UI2: تلقائي | auto (Tidal by day, Graphite by night)"
        ;;
    sync-auto)
        # Internal entry point for moos-theme-sync.service. It is intentionally
        # harmless when automatic switching is off or UI1 rollback is active.
        sync_auto
        ;;
    ui1-dark)
        pin_switch_targets
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false 2>/dev/null || true
        apply "$UI1_DARK_LNF"
        ;;
    ui1-light)
        pin_switch_targets
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false 2>/dev/null || true
        apply "$UI1_LIGHT_LNF"
        ;;
    status)
        active="$(current)"
        case "$active" in
            "$LIGHT_LNF")     echo "MoOS UI2 فاتح | light  ($LIGHT_LNF)" ;;
            "$DARK_LNF")      echo "MoOS UI2 داكن | dark   ($DARK_LNF)" ;;
            "$UI1_LIGHT_LNF") echo "MoOS UI1 rollback فاتح | light  ($UI1_LIGHT_LNF)" ;;
            "$UI1_DARK_LNF")  echo "MoOS UI1 rollback داكن | dark   ($UI1_DARK_LNF)" ;;
            "")               echo "غير محدّد | unset (default: MoOS UI2)" ;;
            *)                echo "ليس MoOS | not a MoOS theme: $active" ;;
        esac
        ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
esac
