#!/usr/bin/env python3
"""Trusted, non-interactive backend for Mo Store.

The UI never constructs commands.  It passes app IDs to this process, and this
process validates every dynamic Flatpak ID, resolves curated recipes from the
shipped catalog, and exposes one atomic JSON job document for the UI to poll.

Flatpak installs, removals and updates use libflatpak transactions.  In
particular, progress comes from FlatpakTransactionProgress; indeterminate work
is represented as JSON null instead of a timer or invented percentage.

Every kind of app has one verb set here (docs/MO_STORE.md, "Kinds of app"):
Flatpak, web app, App Drop (a pinned AppImage or archive, or a file the person
dropped), a pinned portable Windows program, a publisher's own signed Linux
package (usr/lib/moos/moos_vendor_rpm.py), Android, npm and a publisher page.
Pinned downloads share one helper: the publisher's HTTPS URL, its exact size and
SHA-256 from the signed catalogue, every redirect hop HTTPS, saved on disk under
~/.cache/moos-store/downloads/ — never in the RAM-backed /tmp.
"""

from __future__ import annotations

import argparse
import configparser
import contextlib
import dataclasses
import datetime as dt
import fcntl
import hashlib
import http.client
import json
import os
import platform
from pathlib import Path, PurePosixPath
import pwd
import re
