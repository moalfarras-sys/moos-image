def running_arch() -> str:
    """The Flatpak architecture name for this machine.

    Flatpak's spelling, not uname's: aarch64 and x86_64 agree, but 32-bit ARM is
    "arm" to Flatpak and "armv7l" to uname. An unrecognised machine is returned
    unchanged, so it sees the whole catalogue rather than an empty store.
    """
    machine = platform.machine()
    return {"armv7l": "arm", "armv8l": "arm", "i686": "i386"}.get(machine, machine)
