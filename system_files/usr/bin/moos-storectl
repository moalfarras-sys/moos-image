# Flatpak IDs are reverse-DNS names.  Keep this stricter than the Flatpak CLI:
# no refs/triples, empty labels, leading/trailing punctuation, control chars, or
# two-component aliases.  Hyphens in the product component and underscores
# used for domain demangling are both present in real Flathub IDs.
_FLATPAK_ID_RE = re.compile(
    r"^[A-Za-z_][A-Za-z0-9_-]*(?:\.[A-Za-z_][A-Za-z0-9_-]*)+$"
)
_CURATED_ID_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$")
_NPM_PACKAGE_RE = re.compile(
    r"^(?:@[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?/"
    r")?[a-z0-9](?:[a-z0-9._-]{0,212}[a-z0-9])?$"
)
_BIN_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$")
_ANDROID_PACKAGE_RE = re.compile(
    r"^[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*){1,}$"
)
_SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")
_ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
_VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z.+_~-]{0,63}$")
# A Windows program's window class is its exe name ("notepad++.exe"), so + and () are
# legitimate; nothing here can break a desktop-file line (control characters never pass).
_WM_CLASS_RE = re.compile(r"^[A-Za-z0-9._+() -]{1,80}$")
_REVIEW_RISKS = {
    "developer-tool",  # accepted during upgrades from the first catalog draft
    "downloaded-executable",
    "external-download",
    "runs-package-scripts",
    "web-app",
}
_UNSET = object()


class StoreError(RuntimeError):
    """A user-visible, expected store failure.

    `message_key`, when set, is the stable key the window renders in the person's language
    instead of the English text (tests/test_store_job_language.py holds both sides to it).
    """

    def __init__(self, message: object = "", *, message_key: str | None = None):
        super().__init__(message)
        self.message_key = message_key


class BusyError(StoreError):
    """Another store operation owns the global lock."""


class CancelledError(StoreError):
    """The current job was cancelled."""


def utc_now() -> str:
    return (
        dt.datetime.now(dt.timezone.utc)
        .isoformat(timespec="milliseconds")
        .replace("+00:00", "Z")
    )


def clean_message(value: object, limit: int = 600) -> str:
    text = _ANSI_RE.sub("", str(value)).replace("\x00", " ")
    text = " ".join(text.split())
    return text[:limit] or "Operation failed"


def display_text(value: object, limit: int) -> str:
    """One line of catalogue text for a launcher or a record: no control characters, bounded."""
    if not isinstance(value, str):
        return ""
    text = "".join(ch for ch in value if ch >= " " and ch != "\x7f" and ch not in "\u2028\u2029")
    return " ".join(text.split())[:limit]


def desktop_value(value: str) -> str:
    """A Desktop Entry string value: one line, backslashes escaped."""
    return display_text(value, 400).replace("\\", "\\\\")


def validate_flatpak_id(app_id: str) -> bool:
    """Return whether *app_id* is a canonical, unqualified reverse-DNS ID."""

    if not isinstance(app_id, str) or not 3 <= len(app_id) <= 255:
        return False
    parts = app_id.split(".")
    # Flatpak has real canonical IDs such as org.telegram.desktop,
    # com.mattermost.Desktop and com.VK.Messenger. Do not confuse suffixes or
    # case conventions with syntax: use the same grammar as the AppStream
    # indexer, while still requiring a three-part reverse-DNS-style name.
    return len(parts) >= 3 and bool(_FLATPAK_ID_RE.fullmatch(app_id))


def validate_curated_id(app_id: str) -> bool:
    return bool(isinstance(app_id, str) and _CURATED_ID_RE.fullmatch(app_id))


def continue_after_transaction_error(
    details: object, nonfatal_flag: int, cancelled: bool
) -> bool:
    """Return true only when libflatpak marks an error as non-fatal.

    PyGObject exposes bit 1 as ``TransactionErrorDetails.FATAL`` on the image,
    while the underlying C API defines that bit as
    ``FLATPAK_TRANSACTION_ERROR_DETAILS_NON_FATAL``.  Naming the argument by
    its real semantics prevents that introspection quirk from inverting the
    transaction policy.
    """

    return not cancelled and bool(int(details) & nonfatal_flag)


def dedupe(values: Iterable[str]) -> list[str]:
    return list(dict.fromkeys(values))


def cache_dir() -> Path:
    configured = os.environ.get("XDG_CACHE_HOME")
    if configured and Path(configured).is_absolute():
        base = Path(configured)
    else:
        base = Path.home() / ".cache"
    return base / "moos-store"


def _xdg_dir(variable: str, fallback: str) -> Path:
    configured = os.environ.get(variable)
    if configured and Path(configured).is_absolute():
        return Path(configured)
    return Path.home() / fallback


def data_home() -> Path:
    return _xdg_dir("XDG_DATA_HOME", ".local/share")


def state_home() -> Path:
    return _xdg_dir("XDG_STATE_HOME", ".local/state")


def config_home() -> Path:
    return _xdg_dir("XDG_CONFIG_HOME", ".config")


def downloads_dir() -> Path:
    """Where pinned downloads land: on disk, and inside HOME.

    Inside HOME because App Drop installs only files from the person's own folders, and on disk
    because /tmp is a RAM disk on MoOS. A cache directory configured outside HOME is not used.
    """
    home = Path.home()
    candidate = cache_dir() / "downloads"
    try:
        candidate.resolve().relative_to(home.resolve())
        return candidate
    except (OSError, ValueError):
        return home / ".cache" / "moos-store" / "downloads"


def sweep_downloads() -> None:
    """Delete what an interrupted job left in the downloads folders: partial downloads
    (`.<id>.<random>.part`), whole ones (`<id><suffix>`, finished_download()) and
    moos_vendor_rpm's work folders (`vendor-<id>-<random>`).

    Every job removes its own on the way out, but a reboot or a logout ends it with no exception to
    clean up after: mid-download, each attempt left a new random name; after the last byte, while
    unpacking or installing, the whole verified file (1.29 GB for LM Studio) stayed until that same
    app was installed again. Only a job that holds the lock calls this, so no job can be writing
    there. A link is never followed, and nothing named otherwise is touched. The module keeps its
    work folders under the cache directory itself, which differs from downloads_dir() only when
    that lies outside HOME.
    """
    folders: list[Path] = []
    for folder in (downloads_dir(), cache_dir() / "downloads"):
        if folder not in folders:
            folders.append(folder)
    for folder in folders:
        try:
            if folder.is_symlink() or not folder.is_dir():
                continue
            entries = list(os.scandir(folder))
        except OSError:
            continue
        for entry in entries:
            try:
                if (((entry.name.startswith(".") and entry.name.endswith(".part"))
                        or finished_download(entry.name))
                        and entry.is_file(follow_symlinks=False)):
                    os.unlink(entry.path)
                elif entry.name.startswith("vendor-") and entry.is_dir(follow_symlinks=False):
                    shutil.rmtree(entry.path)
            except OSError:
                pass


def sweep_staging(applications: Path, slug: re.Pattern[str]) -> None:
    """Delete the staging folders an interrupted App Drop install left in ~/Applications:
    `.<slug>.installing`, which the new version is unpacked into, and `.<slug>.inner`, which an
    archive's single top folder passes through.

    Each holds only the new version, unfinished. The version that worked waits in
    `.<slug>.previous` during the swap and may be the only copy left, so it stays, with everything
    else in the person's folder. Only a job that holds the lock calls this, and every App Drop
    install runs as a job (moos-app-drop's too, through `install-file`). A link is never followed.
    """
    try:
        if applications.is_symlink() or not applications.is_dir():
            return
        entries = list(os.scandir(applications))
    except OSError:
        return
    for entry in entries:
        name = entry.name
        if not any(name.startswith(".") and name.endswith(suffix)
                   and slug.fullmatch(name[1:-len(suffix)]) for suffix in (".installing", ".inner")):
            continue
        try:
            if entry.is_dir(follow_symlinks=False):
                shutil.rmtree(entry.path)
        except OSError:
            pass


def store_settings_path() -> Path:
    return config_home() / "moos" / "store.json"


def auto_updates_enabled() -> bool:
    """The owner's choice in Mo Store; absent or unreadable means on, the default."""
    try:
        value = json.loads(store_settings_path().read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return True
    return not (isinstance(value, dict) and value.get("auto_updates") is False)


@dataclasses.dataclass(frozen=True)
class WindowsPaths:
    """Everything one catalogue Windows program owns, recomputed from its id — never stored."""

    base: Path
    app: Path
    prefix: Path
    icon: Path
    record: Path
    launcher: Path
    state: Path
    log: Path


def windows_paths(app_id: str) -> WindowsPaths:
    if not validate_curated_id(app_id):
        raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
    root = data_home() / "moos" / "windows-apps"
    base = root / app_id
    foreign = state_home() / "moos-foreign"
    return WindowsPaths(
        base=base,
        app=base / "app",
        prefix=base / "prefix",
        icon=base / "icon.png",
        record=root / f"{app_id}.json",
        launcher=data_home() / "applications" / f"org.moos.windows.{app_id}.desktop",
        state=foreign / app_id,
        log=foreign / f"{app_id}.log",
    )


@dataclasses.dataclass(frozen=True)
class WindowsTemplate:
    """The one settings folder every Windows program's own folder starts as a copy of.

    Each program still gets its own folder and its own registry; only their starting point is
    shared. Wine copies its libraries into every new folder, so making each one from scratch cost
    917.6 MB and 12-20 s per program. A copy made with `cp --reflink=auto` shares the template's
    extents on btrfs, MoOS's default: measured on the station (Wine 11.0), 0 bytes of data, about
    0.65 MiB of metadata and 0.17 s per program. Elsewhere it is a full copy (917.6 MB, 1.9 s).
    Rebuilt when the Windows runtime's version changes.
    """

    root: Path
    prefix: Path
    staging: Path
    record: Path


def windows_template() -> WindowsTemplate:
    root = data_home() / "moos" / "windows-apps"
    # Program ids are slugs, so a dot-name can never be a program's folder or record.
    return WindowsTemplate(root=root, prefix=root / ".template", staging=root / ".template.new",
                           record=root / ".template.json")


def android_record_path(package: str) -> Path:
    return data_home() / "moos" / "android" / f"{package}.json"


def _remove_tree(path: Path) -> bool:
    """Delete a directory this backend owns, never following a link to somewhere else."""
    if path.is_symlink():
        path.unlink()
        return True
    if path.is_dir():
        shutil.rmtree(path)
        return True
    return False


def _read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def _write_json(path: Path, document: dict[str, Any], mode: int = 0o600, *,
                private_parent: bool = True) -> None:
    payload = json.dumps(document, ensure_ascii=False, sort_keys=True,
                         separators=(",", ":")).encode("utf-8") + b"\n"
    _atomic_bytes(path, payload, mode, private_parent=private_parent)


# ── Presence for the MoOS Island ─────────────────────────────────────────────
# job.json is for the Store and Welcome windows, whose launchers export
# QML_XHR_ALLOW_FILE_READ=1. The Island lives inside plasmashell, where Qt 6 refuses a local
# XMLHttpRequest ("Using GET on a local file is disabled by default"; measured on Qt 6.11.2).
# Wave W5 read job.json that way inside a try/catch, so Store jobs never appeared in the Island on
# any machine while every gate stayed green.
#
# The Island's Remote chip has always worked, because it carries its whole state in a FILE NAME
# that a FolderListModel reports (`presence-active-2`). Store jobs now speak the same way:
#
#     $XDG_RUNTIME_DIR/moos-store/job-<action>-<state>-<progress>-<id>
#
# Only work a person WAITS for is published. `run`, `refresh-index` and `open-engine` also open a
# job, and W5 showed each of them as "Installing …".
PRESENCE_ACTIONS = frozenset({"install", "remove", "update"})
PRESENCE_STATES = frozenset({"starting", "running", "success", "failed", "cancelled"})


def presence_dir() -> Path | None:
    configured = os.environ.get("XDG_RUNTIME_DIR")
    if not configured or not Path(configured).is_absolute():
        return None
    return Path(configured) / "moos-store"


def presence_name(document: dict[str, Any]) -> str | None:
    """The token for *document*, or None when it is not something to show in the Island."""

    action = document.get("action")
    state = document.get("state")
    if action not in PRESENCE_ACTIONS or state not in PRESENCE_STATES:
        return None
    progress = document.get("progress")
    if isinstance(progress, (int, float)) and not isinstance(progress, bool):
        # Five-point steps: a rename per percent would wake the shell a hundred times.
        step = str(max(0, min(100, int(progress) // 5 * 5)))
    else:
        step = "x"          # indeterminate is a fact, not zero
    current = document.get("current_id")
    if not isinstance(current, str) or not current:
        items = document.get("items") or []
        current = items[0].get("id", "") if len(items) == 1 and isinstance(items[0], dict) else ""
    # "-" separates the fields, so it may not survive inside the id; "/" and NUL cannot be in a
    # file name at all. quote() leaves "-", "." and "_" alone, hence the explicit replacement.
    encoded = urllib.parse.quote(str(current)[:120], safe="").replace("-", "%2D")
    return f"job-{action}-{state}-{step}-{encoded}"


def _atomic_bytes(path: Path, data: bytes, mode: int = 0o600, *, private_parent: bool = True) -> None:
    """Replace *path* atomically with bytes created in the same directory.

    `private_parent` makes the directory owner-only; a shared folder such as ~/.config/moos keeps
    the permissions its other owners gave it.
    """

    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if private_parent:
        try:
            path.parent.chmod(0o700)
        except OSError:
            pass
    temporary = path.with_name(
        f".{path.name}.{os.getpid()}.{secrets.token_hex(6)}.tmp"
    )
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    fd = os.open(temporary, flags, mode)
    try:
        with os.fdopen(fd, "wb", closefd=True) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        try:
            directory_fd = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except OSError:
            pass
    finally:
        with contextlib.suppress(FileNotFoundError):
            temporary.unlink()


class JobStore:
    def __init__(self, directory: Path | None = None):
        self.directory = directory or cache_dir()
        self.path = self.directory / "job.json"
        self.lock_path = self.directory / "job.lock"
        self.cancel_path = self.directory / "cancel"
        # Pending updates live in their OWN document. Writing them into job.json
        # would make a read-only check indistinguishable from a transaction, and
        # the UI correlates job.json against a request it made.
        self.updates_path = self.directory / "updates.json"
        self._presence: str | None = None

    def prepare(self) -> None:
        self.directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            self.directory.chmod(0o700)
        except OSError:
            pass

    def write(self, document: dict[str, Any]) -> None:
        payload = json.dumps(
            document,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8") + b"\n"
        _atomic_bytes(self.path, payload)
        self._publish_presence(document)

    def _publish_presence(self, document: dict[str, Any]) -> None:
        """Best effort: the Island is a view, and a view may never fail a transaction."""

        directory = presence_dir()
        name = presence_name(document)
        if directory is None or name == self._presence:
            return
        try:
            if name is not None:
                directory.mkdir(mode=0o700, parents=True, exist_ok=True)
                token = directory / name
                # Create the new name BEFORE removing the old one: a watcher that reads the
                # directory between the two sees two tokens (it picks the newest), never none.
                fd = os.open(token, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
                os.close(fd)
            if directory.is_dir():
                for stale in directory.glob("job-*"):
                    if stale.name != name:
                        with contextlib.suppress(OSError):
                            stale.unlink()
            self._presence = name
        except OSError:
            pass

    def write_updates(self, document: dict[str, Any]) -> None:
        payload = json.dumps(
            document,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8") + b"\n"
        _atomic_bytes(self.updates_path, payload)

    def read(self) -> dict[str, Any] | None:
        try:
            value = json.loads(self.path.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return None
        return value if isinstance(value, dict) else None

    def request_cancel(self, job_id: str) -> None:
        _atomic_bytes(self.cancel_path, (job_id + "\n").encode("ascii"))

    def clear_cancel(self) -> None:
        with contextlib.suppress(FileNotFoundError):
            self.cancel_path.unlink()

    def cancel_requested(self, job_id: str) -> bool:
        try:
            return self.cancel_path.read_text(encoding="ascii").strip() == job_id
        except (FileNotFoundError, OSError, UnicodeError):
            return False


class BesideJobStore(JobStore):
    """job.json for a job that runs while another process holds the lock. Only opening an app
    does, and only while job.json reports no other live job (Controller._begin_run): the
    scheduled updater holds the lock and writes none, so the window still gets its document.

    It never writes over another live job (publish_refusal's rule): a job that starts while the
    app is opening keeps its document and its window.
    """

    def write(self, document: dict[str, Any]) -> None:
        current = self.read()
        if current and current.get("job_id") != document.get("job_id") and reports_live_job(current):
            return
        super().write(document)


class GlobalLock:
    def __init__(self, store: JobStore):
        self.store = store
        self.fd: int | None = None

    def acquire(self) -> "GlobalLock":
        self.store.prepare()
        flags = os.O_RDWR | os.O_CREAT
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        self.fd = os.open(self.store.lock_path, flags, 0o600)
        os.fchmod(self.fd, 0o600)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            os.close(self.fd)
            self.fd = None
            raise BusyError("Another Mo Store operation is already running") from error
        return self

    def release(self) -> None:
        if self.fd is not None:
            with contextlib.suppress(OSError):
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None

    def __enter__(self) -> "GlobalLock":
        return self if self.fd is not None else self.acquire()

    def __exit__(self, *_args: object) -> None:
        self.release()


@dataclasses.dataclass
class Job:
    store: JobStore
    action: str
    item_ids: Sequence[str]
    job_id: str = dataclasses.field(default_factory=lambda: secrets.token_hex(16))
    _lock: Any = dataclasses.field(init=False, repr=False)
    _last_persist: float = dataclasses.field(init=False, repr=False)

    def __post_init__(self) -> None:
        self._lock = threading.RLock()
        self._last_persist = time.monotonic()
        now = utc_now()
        self.document: dict[str, Any] = {
            "schema": SCHEMA,
            "job_id": self.job_id,
            "action": self.action,
            "state": "starting",
            "progress": None,
            "current_id": None,
            "message": "Starting",
            "items": [
                {
                    "id": item_id,
                    "state": "queued",
                    "progress": None,
                    "message": "Queued",
                }
                for item_id in self.item_ids
            ],
            "started_at": now,
            "updated_at": now,
        }
        self._items = {item["id"]: item for item in self.document["items"]}
        self.store.write(self.document)

    def snapshot(self) -> dict[str, Any]:
        with self._lock:
            return json.loads(json.dumps(self.document))

    def heartbeat(self) -> None:
        """Keep an active, possibly indeterminate operation observably alive."""

        with self._lock:
            if self.document["state"] not in {"starting", "running"}:
                return
            now = time.monotonic()
            if now - self._last_persist < 10:
                return
            self.document["updated_at"] = utc_now()
            self.store.write(self.document)
            self._last_persist = now

    def replace_items(self, item_ids: Sequence[str]) -> None:
        """Replace a late-resolved operation plan without exposing torn state."""

        with self._lock:
            self.document["items"] = [
                {
                    "id": item_id,
                    "state": "queued",
                    "progress": None,
                    "message": "Queued",
                }
                for item_id in item_ids
            ]
            self._items = {
                item["id"]: item for item in self.document["items"]
            }
            self.document["updated_at"] = utc_now()
            self.store.write(self.document)
            self._last_persist = time.monotonic()

    def update(
        self,
        *,
        state: str | object = _UNSET,
        progress: int | None | object = _UNSET,
        current_id: str | None | object = _UNSET,
        message: str | object = _UNSET,
        message_key: str | object = _UNSET,
    ) -> None:
        with self._lock:
            changed = False
            for key, value in (
                ("state", state),
                ("progress", progress),
                ("current_id", current_id),
                ("message", message),
                ("message_key", message_key),
            ):
                if value is not _UNSET and self.document.get(key) != value:
                    self.document[key] = value
                    changed = True
            if changed:
                self.document["updated_at"] = utc_now()
                self.store.write(self.document)
                self._last_persist = time.monotonic()

    def update_item(
        self,
        item_id: str,
        *,
        state: str | object = _UNSET,
        progress: int | None | object = _UNSET,
        message: str | object = _UNSET,
        message_key: str | object = _UNSET,
    ) -> None:
        with self._lock:
            item = self._items.get(item_id)
            if item is None:
                return
            changed = False
            for key, value in (
                ("state", state),
                ("progress", progress),
                ("message", message),
                ("message_key", message_key),
            ):
                if value is not _UNSET and item.get(key) != value:
                    item[key] = value
                    changed = True
            if changed:
                self.document["updated_at"] = utc_now()
                self.store.write(self.document)
                self._last_persist = time.monotonic()

    def fail(self, message: object, item_ids: Iterable[str] | None = None) -> None:
        with self._lock:
            reason = clean_message(message)
            # A failure keeps its real words. Only an error that deliberately carries a key (a
            # refusal the window can say in the person's language) brings one; any other clears
            # the last step's key, so its progress line can never stand over the error.
            key = getattr(message, "message_key", None)
            targets = set(item_ids if item_ids is not None else self._items)
            for item_id, item in self._items.items():
                if item_id in targets and item["state"] in {"queued", "running"}:
                    item.update(state="failed", message=reason,
                                message_key=key)
            states = [item["state"] for item in self._items.values()]
            has_success = any(state in {"done", "opened", "skipped"} for state in states)
            has_failure = any(state == "failed" for state in states)
            state = "partial" if has_success and has_failure else "failed"
            self.update(
                state=state,
                progress=100 if state == "partial" else self.document["progress"],
                current_id=None,
                message=reason,
                message_key=key,
            )

    def cancelled(self) -> None:
        with self._lock:
            for item in self._items.values():
                if item["state"] == "running":
                    item.update(state="failed", message="Cancelled",
                                message_key="cancelled")
                elif item["state"] == "queued":
                    item.update(state="skipped", message="Cancelled before starting",
                                message_key="cancelled_before_start")
            self.update(state="cancelled", current_id=None, message="Cancelled",
                        message_key="cancelled")

    def finish_from_items(
        self,
        success_message: str = "Completed",
        success_key: str | None = None,
    ) -> None:
        with self._lock:
            states = [item["state"] for item in self.document["items"]]
            failed = sum(state == "failed" for state in states)
            succeeded = sum(state in {"done", "opened", "skipped"} for state in states)
            if failed and succeeded:
                state, message = "partial", f"Completed with {failed} failure(s)"
            elif failed:
                state, message = "failed", f"{failed} operation(s) failed"
            else:
                state, message = "success", success_message
            # The partial/failed lines embed counts, so they stay prose; only a
            # clean success has a phrase the UI can render in either language.
            key = success_key if state == "success" else None
            self.update(
                state=state,
                progress=100 if state in {"success", "partial"} else self.document["progress"],
                current_id=None,
                message=message,
                message_key=key,
            )


@dataclasses.dataclass(frozen=True)
class CommandResult:
    returncode: int
    reason: str = ""
    cancelled: bool = False
    output: str = ""


class CommandRunner:
    """Subprocess boundary: every invocation receives a fixed argv list."""

    def spawn(self, argv: Sequence[str]) -> None:
        subprocess.Popen(
            list(argv),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )

    def gpu_guard(self) -> None:
        if not Path(GPU_GUARD).is_file():
            return
        try:
            subprocess.run(
                [GPU_GUARD],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
                timeout=20,
            )
        except (OSError, subprocess.TimeoutExpired):
            pass

    def capture(self, argv: Sequence[str], timeout: int = 30) -> CommandResult:
        """Run a fixed read-only probe without involving a shell."""
        try:
            result = subprocess.run(
                list(argv),
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                check=False,
                timeout=timeout,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            return CommandResult(127, clean_message(error))
        return CommandResult(
            result.returncode,
            clean_message(result.stderr) if result.stderr else "",
            False,
            result.stdout,
        )

    def run_cancellable(
        self, argv: Sequence[str], should_cancel: Callable[[], bool]
    ) -> CommandResult:
        with tempfile.TemporaryFile() as errors:
            try:
                process = subprocess.Popen(
                    list(argv),
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=errors,
                    close_fds=True,
                    start_new_session=True,
                )
            except OSError as error:
                return CommandResult(127, clean_message(error))
            cancelled = False
            while process.poll() is None:
                if should_cancel():
                    cancelled = True
                    with contextlib.suppress(ProcessLookupError):
                        os.killpg(process.pid, signal.SIGTERM)
                    try:
                        process.wait(timeout=4)
                    except subprocess.TimeoutExpired:
                        with contextlib.suppress(ProcessLookupError):
                            os.killpg(process.pid, signal.SIGKILL)
                        process.wait()
                    break
                time.sleep(0.15)
            errors.seek(0, os.SEEK_END)
            length = errors.tell()
            errors.seek(max(0, length - 4096))
            raw_reason = errors.read().decode("utf-8", "replace")
            # Empty stderr is the ordinary success case. clean_message() has a
            # user-facing fallback ("Operation failed") for exception paths;
            # feeding an empty stream through it fabricated that failure text.
            # Android CLIs sometimes also return zero after logging a real error,
            # so callers inspect non-empty stderr -- they must be able to tell it
            # apart from silence.
            reason = clean_message(raw_reason) if raw_reason.strip() else ""
            return CommandResult(process.returncode or 0, reason, cancelled)


def _https_url_ok(url: object) -> bool:
    if not isinstance(url, str) or len(url) > 2048 or any(ch <= " " or ch == "\x7f" for ch in url):
        return False
    parsed = urllib.parse.urlsplit(url)
    return (parsed.scheme == "https" and bool(parsed.hostname)
            and parsed.username is None and parsed.password is None)


class HttpsOnlyRedirects(urllib.request.HTTPRedirectHandler):
    """Follow a redirect only to another HTTPS address.

    The pinned SHA-256 already protects what arrives; this keeps the route honest too, so a
    publisher mirror that bounces through plain HTTP fails the job instead of being followed.
    """

    max_redirections = 10

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: D401 - urllib API
        if not _https_url_ok(newurl):
            with contextlib.suppress(Exception):
                fp.close()
            raise StoreError("The download was redirected to an address that is not secure")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def build_opener() -> urllib.request.OpenerDirector:
    return urllib.request.build_opener(HttpsOnlyRedirects())


@dataclasses.dataclass(frozen=True)
class PinnedArtifact:
    url: str
    sha256: str
    size: int | None


def pinned_artifact(app_id: str, install: dict[str, Any], *, size_required: bool = True) -> PinnedArtifact:
    """The download the signed catalogue pins for THIS machine's architecture.

    `install.downloads[<arch>]` = {url, sha256, size}. The older Android recipes carry url and
    sha256 at the top of `install` and may omit the size; they are still capped.
    """
    downloads = install.get("downloads")
    if downloads is not None:
        if not isinstance(downloads, dict):
            raise StoreError(f"Catalog has invalid downloads for {app_id}")
        entry = downloads.get(running_arch())
        if not isinstance(entry, dict):
            raise StoreError(f"{app_id} has no download for this computer", message_key="unsupported_arch")
    else:
        entry = install
    url = entry.get("url")
    digest = entry.get("sha256")
    size = entry.get("size")
    if not _https_url_ok(url) or not isinstance(digest, str) or not _SHA256_RE.fullmatch(digest):
        raise StoreError(f"Recipe for {app_id} is not pinned to a valid SHA-256")
    if size is None and not size_required:
        return PinnedArtifact(url, digest.lower(), None)
    if isinstance(size, bool) or not isinstance(size, int) or not 0 < size <= MAX_PINNED_BYTES:
        raise StoreError(f"Recipe for {app_id} does not pin a valid size")
    return PinnedArtifact(url, digest.lower(), size)


# Every suffix file_suffix() gives; a verified download is saved as `<item id><suffix>`.
DOWNLOAD_SUFFIXES = (".apk", ".AppImage", ".zip", ".exe", ".tar.gz", ".tar.xz", ".tar.bz2",
                     ".tar.zst", ".tar", ".download")


def finished_download(name: str) -> bool:
    """Whether `name` is one _download_pinned() gives a verified download: a catalogue id or an
    Android package, then one of DOWNLOAD_SUFFIXES."""
    for suffix in DOWNLOAD_SUFFIXES:
        stem = name[: -len(suffix)] if name.endswith(suffix) else ""
        if stem and (validate_curated_id(stem) or _ANDROID_PACKAGE_RE.fullmatch(stem)):
            return True
    return False


def file_suffix(head: bytes, kind: str) -> str:
    """The name a verified download is saved under, from what it IS.

    App Drop treats compressed data as an archive only under an archive name, and the Android
    container wants `.apk`, so the suffix matters — but it follows the bytes, not the URL.
    """
    if kind == "android":
        return ".apk"
    if head[:4] == b"\x7fELF" and head[8:10] == b"AI":
        return ".AppImage"
    if head[:4] == b"PK\x03\x04":
        return ".zip"
    if head[:2] == b"MZ":
        return ".exe"
    if head[:2] == b"\x1f\x8b":
        return ".tar.gz"
    if head[:6] == b"\xfd7zXZ\x00":
        return ".tar.xz"
    if head[:3] == b"BZh":
        return ".tar.bz2"
    if head[:4] == b"\x28\xb5\x2f\xfd":
        return ".tar.zst"
    if head[257:262] == b"ustar":
        return ".tar"
    return ".download"


def _relative_inside(value: object, *, limit: int = 255) -> str | None:
    """A catalogue path relative to an app folder: no root, no `..`, no control characters."""
    if not isinstance(value, str) or not value or len(value) > limit:
        return None
    if value.startswith("/") or "\\" in value or any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        return None
    parts = value.split("/")
    if any(part in ("", ".", "..") for part in parts):
        return None
    return value


def parse_keyfile(text: str) -> dict[str, dict[str, str]]:
    """A Flatpak metadata/permissions key file as {group: {key: value}}; first value wins."""
    groups: dict[str, dict[str, str]] = {}
    current: dict[str, str] | None = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            current = groups.setdefault(line[1:-1], {})
        elif current is not None and "=" in line:
            key, _, value = line.partition("=")
            current.setdefault(key.strip(), value.strip())
    return groups


def _keyfile_list(value: str) -> set[str]:
    return {item.strip() for item in value.split(";") if item.strip()}


def flatpak_grants(text: str) -> dict[str, bool]:
    """What an app may do, in Mo Store's closed words, from a [Context] key file.

    `flatpak info --show-permissions` prints the effective set (the app's metadata with the
    person's overrides merged); a remote ref's metadata is what the app asks for. A `!` entry
    is a revocation and grants nothing.
    """
    groups = parse_keyfile(text)
    context = groups.get("Context", {})
    shared = _keyfile_list(context.get("shared", ""))
    sockets = _keyfile_list(context.get("sockets", ""))
    devices = _keyfile_list(context.get("devices", ""))
    features = _keyfile_list(context.get("features", ""))
    filesystems = {entry.split(":", 1)[0].rstrip("/")
                   for entry in _keyfile_list(context.get("filesystems", ""))
                   if not entry.startswith("!")}
    host = "host" in filesystems
    home = host or "home" in filesystems or "~" in filesystems
    return {
        "network": "network" in shared,
        "files-home": home,
        "files-all": host,
        "downloads": home or "xdg-download" in filesystems,
        "devices": "all" in devices,
        "sound": "pulseaudio" in sockets,
        "bluetooth": "bluetooth" in features,
        "host-commands": groups.get("Session Bus Policy", {}).get("org.freedesktop.Flatpak") == "talk",
        "x11": "x11" in sockets,
        "wayland": "wayland" in sockets,
    }


def flatpak_permission_rows(effective: str, background: str | None) -> list[dict[str, Any]]:
    """The permissions document's rows for a Flatpak app.

    A toggle is not changeable when a broader grant already includes it: the home folder while
    every file is shared, Downloads while the home folder is. `background` is the portal's
    answer ("yes"/"no"/"ask") or None when the person was never asked, which lets the app run
    in the background and tells the person when it does.
    """
    grants = flatpak_grants(effective)
    granted_home = grants["files-home"]
    rows = []
    for key in FLATPAK_PERMISSION_KEYS:
        if key == "background":
            state = "deny" if background == "no" else "allow"
            changeable = True
        else:
            state = "allow" if grants[key] else "deny"
            changeable = not ((key == "files-home" and grants["files-all"])
                              or (key == "downloads" and granted_home))
        rows.append({"key": key, "state": state, "changeable": changeable})
    return rows


def background_answer(permission_show: str, app_id: str) -> str | None:
    """The background portal's stored answer for `app_id` in `flatpak permission-show` output."""
    for line in permission_show.splitlines():
        fields = line.split("\t")
        if len(fields) >= 4 and fields[:3] == ["background", "background", app_id]:
            return fields[3].split(",")[0].strip() or None
    return None


def ref_facts(metadata: str, download: int, installed: int, eol: str | None,
              eol_rebase: str | None) -> dict[str, Any]:
    """One Flathub app's facts for facts.json, from its cached remote metadata."""
    grants = flatpak_grants(metadata)
    return {
        "download": int(download or 0),
        "installed": int(installed or 0),
        "eol": display_text(eol, 300) or None,
        "eol_rebase": eol_rebase if eol_rebase and validate_flatpak_id(eol_rebase) else None,
        "permissions": [key for key in FACT_PERMISSION_KEYS if grants[key]],
        "x11_only": grants["x11"] and not grants["wayland"],
        "extra_data": "Extra Data" in parse_keyfile(metadata),
    }


class TransactionEvents:
    """Translate libflatpak operation signals into the stable job schema."""

    def __init__(self, job: Job, requested_ids: Sequence[str]):
        self.job = job
        self.requested = set(requested_ids)

    @staticmethod
    def ref_id(ref: str) -> str:
        fields = ref.split("/")
        if len(fields) >= 2 and fields[0] in {"app", "runtime"}:
            return fields[1]
        return fields[0]

    def plan(self, operation_count: int) -> None:
        self.job.update(
            state="running",
            message=f"Resolved {operation_count} Flatpak operation(s)",
            message_key=None,
        )

    def started(self, ref: str, status: str = "Starting") -> None:
        app_id = self.ref_id(ref)
        if app_id in self.requested:
            self.job.update_item(
                app_id, state="running", progress=None, message=clean_message(status),
                message_key=None,
            )
            current: str | None = app_id
        else:
            current = self.job.document.get("current_id")
        self.job.update(
            state="running",
            current_id=current,
            message=clean_message(status or f"Processing {app_id}"),
            message_key=None,
        )

    def progress(
        self,
        ref: str,
        percent: int | None,
        status: str,
        overall_percent: int | None,
    ) -> None:
        app_id = self.ref_id(ref)
        message = clean_message(status or f"Processing {app_id}")
        if app_id in self.requested:
            self.job.update_item(
                app_id, state="running", progress=percent, message=message,
                message_key=None,
            )
        self.job.update(
            state="running",
            progress=overall_percent,
            current_id=app_id if app_id in self.requested else self.job.document["current_id"],
            message=message,
            message_key=None,
        )

    def done(self, ref: str) -> None:
        app_id = self.ref_id(ref)
        if app_id in self.requested:
            self.job.update_item(
                app_id, state="done", progress=100, message="Completed",
                message_key="completed"
            )

    def error(self, ref: str, error: object) -> None:
        app_id = self.ref_id(ref)
        message = clean_message(error)
        if app_id in self.requested:
            self.job.update_item(
                app_id, state="failed", progress=None, message=message,
                message_key=None
            )
        self.job.update(message=message, message_key=None)


class FlatpakAdapter:
    """Thin, test-replaceable adapter around PyGObject libflatpak."""

    def __init__(self):
        try:
            import gi

            gi.require_version("Flatpak", "1.0")
            from gi.repository import Flatpak, Gio, GLib
        except (ImportError, ValueError) as error:
            raise StoreError(f"libflatpak Python bindings are unavailable: {error}") from error
        self.Flatpak = Flatpak
        self.Gio = Gio
        self.GLib = GLib
        try:
            self.user = Flatpak.Installation.new_user(None)
            self.system = Flatpak.Installation.new_system(None)
        except Exception as error:
            raise StoreError(f"Could not open Flatpak installations: {error}") from error

    def _installed(self, installation: Any, app_id: str) -> bool:
        try:
            installation.get_current_installed_app(app_id, None)
            return True
        except self.GLib.Error as error:
            if error.matches(
                self.Flatpak.error_quark(), self.Flatpak.Error.NOT_INSTALLED
            ):
                return False
            raise StoreError(
                f"Could not inspect whether {app_id} is installed: {error}"
            ) from error

    def is_user_installed(self, app_id: str) -> bool:
        return self._installed(self.user, app_id)

    def is_system_installed(self, app_id: str) -> bool:
        return self._installed(self.system, app_id)

    @staticmethod
    def _official_remote(remote: Any) -> bool:
        try:
            url = (remote.get_url() or "").rstrip("/") + "/"
            return (
                url == FLATHUB_REPO_BASE
                and bool(remote.get_gpg_verify())
                and not bool(remote.get_disabled())
                and not bool(remote.get_nodeps())
            )
        except Exception:
            return False

    @staticmethod
    def _safe_remote_definition(remote: Any) -> bool:
        """Validate properties libflatpak exposes before adding a repo file.

        Flatpak.Remote.new_from_file() reports get_gpg_verify() as false even
        when the parsed .flatpakrepo contains a valid GPGKey.  The raw file is
        already pinned and key-validated by _repo_data(); require libflatpak's
        effective GPG setting after add_remote() instead.
        """

        try:
            url = (remote.get_url() or "").rstrip("/") + "/"
            return (
                url == FLATHUB_REPO_BASE
                and not bool(remote.get_disabled())
                and not bool(remote.get_nodeps())
            )
        except Exception:
            return False

    def _repo_data(self) -> bytes:
        if FLATHUB_REPO_FILE.is_file():
            data = FLATHUB_REPO_FILE.read_bytes()
        else:
            request = urllib.request.Request(
                FLATHUB_REPO_URL,
                headers={"User-Agent": "MoOS-Store/1"},
                method="GET",
            )
            with urllib.request.urlopen(request, timeout=20) as response:
                if urllib.parse.urlsplit(response.geturl()).scheme != "https":
                    raise StoreError("Flathub repository metadata used an insecure redirect")
                data = response.read(1024 * 1024 + 1)
            if len(data) > 1024 * 1024:
                raise StoreError("Flathub repository metadata is unexpectedly large")

        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read_string(data.decode("utf-8"))
            section = parser["Flatpak Repo"]
            url = section.get("Url", "").rstrip("/") + "/"
            key = "".join(section.get("GPGKey", "").split())
        except (UnicodeError, configparser.Error, KeyError) as error:
            raise StoreError(f"Invalid Flathub repository metadata: {error}") from error
        if url != FLATHUB_REPO_BASE or len(key) < 100:
            raise StoreError("Flathub repository metadata failed URL/GPG validation")
        return data

    def ensure_flathub(self) -> str:
        """Return a verified user remote, never trusting the name alone."""

        try:
            remotes = list(self.user.list_remotes(None))
        except Exception as error:
            raise StoreError(f"Could not inspect Flatpak remotes: {error}") from error
        for remote in remotes:
            if self._official_remote(remote):
                return remote.get_name()

        occupied = {remote.get_name() for remote in remotes}
        remote_name = next(
            (name for name in ("flathub", "moos-flathub") if name not in occupied),
            None,
        )
        if remote_name is None:
            raise StoreError(
                "Remote names flathub and moos-flathub are occupied by untrusted sources"
            )
        data = self._repo_data()
        try:
            remote = self.Flatpak.Remote.new_from_file(
                remote_name, self.GLib.Bytes.new(data)
            )
            if not self._safe_remote_definition(remote):
                raise StoreError("Parsed Flathub remote failed URL/GPG validation")
            self.user.add_remote(remote, True, None)
            installed = self.user.get_remote_by_name(remote_name, None)
        except StoreError:
            raise
        except Exception as error:
            raise StoreError(f"Could not add the verified Flathub remote: {error}") from error
        if not self._official_remote(installed):
            raise StoreError("Installed Flathub remote failed URL/GPG validation")
        return remote_name

    def _transaction(
        self,
        configure: Callable[[Any], None],
        events: TransactionEvents,
        should_cancel: Callable[[], bool],
    ) -> None:
        cancellable = self.Gio.Cancellable()
        try:
            transaction = self.Flatpak.Transaction.new_for_installation(
                self.user, cancellable
            )
            transaction.set_no_interaction(True)
            configure(transaction)
        except Exception as error:
            raise StoreError(f"Could not prepare Flatpak transaction: {error}") from error

        completed: set[int] = set()
        total_operations = 0

        def operation_key(operation: Any) -> int:
            try:
                return int(operation.__gpointer__)
            except Exception:
                return id(operation)

        def on_ready(tx: Any) -> bool:
            nonlocal total_operations
            total_operations = len(tx.get_operations())
            events.plan(total_operations)
            return not should_cancel()

        def on_new_operation(_tx: Any, operation: Any, progress: Any) -> None:
            ref = operation.get_ref()
            progress.set_update_frequency(200)
            events.started(ref, progress.get_status() or "Starting")

            def changed(value: Any) -> None:
                if should_cancel():
                    cancellable.cancel()
                estimating = bool(value.get_is_estimating())
                percent = None if estimating else max(0, min(100, value.get_progress()))
                if estimating or total_operations <= 0:
                    overall = None
                else:
                    overall = max(
                        0,
                        min(
                            100,
                            int(
                                (
                                    len(completed)
                                    + (percent if percent is not None else 0) / 100.0
                                )
                                * 100
                                / total_operations
                            ),
                        ),
                    )
                events.progress(
                    ref,
                    percent,
                    value.get_status() or "Working",
                    overall,
                )

            progress.connect("changed", changed)
            changed(progress)

        def on_done(
            _tx: Any, operation: Any, _commit: str | None, _details: object
        ) -> None:
            completed.add(operation_key(operation))
            events.done(operation.get_ref())

        def on_error(
            _tx: Any, operation: Any, error: object, details: object
        ) -> bool:
            events.error(operation.get_ref(), error)
            # PyGObject currently calls the C API's NON_FATAL bit ``FATAL``.
            # The helper names and tests the actual semantics so a fatal error
            # cannot be accidentally continued and a recoverable one aborted.
            nonfatal_flag = int(self.Flatpak.TransactionErrorDetails.FATAL)
            return continue_after_transaction_error(
                details, nonfatal_flag, should_cancel()
            )

        transaction.connect("ready", on_ready)
        transaction.connect("new-operation", on_new_operation)
        transaction.connect("operation-done", on_done)
        transaction.connect("operation-error", on_error)

        watcher_stop = threading.Event()

        def watch_cancel() -> None:
            while not watcher_stop.wait(0.2):
                if should_cancel():
                    cancellable.cancel()
                    return

        watcher = threading.Thread(
            target=watch_cancel, name="moos-store-cancel", daemon=True
        )
        watcher.start()
        try:
            if should_cancel():
                raise CancelledError("Cancelled")
            result = transaction.run(cancellable)
            if should_cancel() or cancellable.is_cancelled():
                raise CancelledError("Cancelled")
            if not result:
                raise StoreError("Flatpak transaction did not complete")
        except CancelledError:
            raise
        except self.GLib.Error as error:
            if should_cancel() or cancellable.is_cancelled():
                raise CancelledError("Cancelled") from error
            raise StoreError(f"Flatpak transaction failed: {error}") from error
        finally:
            watcher_stop.set()
            watcher.join(timeout=1)

    def install_many(
        self,
        app_ids: Sequence[str],
        events: TransactionEvents,
        should_cancel: Callable[[], bool],
    ) -> None:
        remote = self.ensure_flathub()
        try:
            available = list(self.user.list_remote_refs_sync(remote, None))
        except Exception as error:
            raise StoreError(
                f"Could not resolve applications from the verified remote: {error}"
            ) from error

        default_arch = self.Flatpak.get_default_arch()
        choices: dict[str, list[Any]] = {app_id: [] for app_id in app_ids}
        for ref in available:
            try:
                name = ref.get_name()
                if (
                    name in choices
                    and ref.get_kind() == self.Flatpak.RefKind.APP
                    and ref.get_arch() == default_arch
                ):
                    choices[name].append(ref)
            except Exception:
                continue

        resolved: list[tuple[str, str]] = []
        unavailable: list[str] = []
        for app_id in app_ids:
            candidates = choices[app_id]
            if not candidates:
                # One app with no build for this computer fails alone (a bare id is its own ref
                # to TransactionEvents); the rest of the batch still installs.
                reason = f"{app_id} is not available from Flathub for this computer"
                unavailable.append(reason)
                events.error(app_id, reason)
                continue
            candidates.sort(
                key=lambda ref: (
                    ref.get_branch() != "stable",
                    ref.get_branch() or "",
                    ref.format_ref(),
                )
            )
            resolved.append((app_id, candidates[0].format_ref()))
        if unavailable and not resolved:
            # Nothing to install fails the call: open-engine asks for one app, then opens it.
            raise StoreError("; ".join(unavailable))

        def configure(transaction: Any) -> None:
            for app_id, full_ref in resolved:
                if not transaction.add_install(remote, full_ref, None):
                    raise StoreError(f"Flatpak refused to queue {app_id}")

        self._transaction(configure, events, should_cancel)

    def remove(
        self,
        app_id: str,
        events: TransactionEvents,
        should_cancel: Callable[[], bool],
    ) -> None:
        try:
            installed_ref = self.user.get_current_installed_app(app_id, None)
            full_ref = installed_ref.format_ref()
        except self.GLib.Error as error:
            if error.matches(
                self.Flatpak.error_quark(), self.Flatpak.Error.NOT_INSTALLED
            ):
                raise StoreError(f"{app_id} is not installed for this user") from error
            raise StoreError(
                f"Could not resolve the installed Flatpak ref for {app_id}: {error}"
            ) from error
        except Exception as error:
            raise StoreError(
                f"Could not resolve the installed Flatpak ref for {app_id}: {error}"
            ) from error

        def configure(transaction: Any) -> None:
            if not transaction.add_uninstall(full_ref):
                raise StoreError(f"Flatpak refused to queue removal of {app_id}")

        self._transaction(
            configure,
            events,
            should_cancel,
        )

    def update_refs(self) -> list[tuple[str, str]]:
        try:
            refs = self.user.list_installed_refs_for_update(None)
        except Exception as error:
            raise StoreError(f"Could not resolve Flatpak updates: {error}") from error
        result: list[tuple[str, str]] = []
        seen: set[str] = set()
        for ref in refs:
            name = ref.get_name()
            formatted = ref.format_ref()
            if formatted not in seen:
                seen.add(formatted)
                result.append((name, formatted))
        return result

    def update_candidates(self) -> list[dict[str, Any]]:
        """Describe every installed ref that has a pending update.

        Read-only: this asks libflatpak what `update` would act on and adds
        nothing of its own.  Runtimes are reported alongside apps and marked as
        such — an app update usually drags a runtime with it, and hiding that
        would make the size the user sees disagree with the download they get.
        """

        try:
            refs = self.user.list_installed_refs_for_update(None)
        except Exception as error:
            raise StoreError(f"Could not resolve Flatpak updates: {error}") from error
        candidates: list[dict[str, Any]] = []
        seen: set[str] = set()
        for ref in refs:
            formatted = ref.format_ref()
            if formatted in seen:
                continue
            seen.add(formatted)
            try:
                is_app = ref.get_kind() == self.Flatpak.RefKind.APP
            except Exception:
                is_app = True
            entry: dict[str, Any] = {
                "id": ref.get_name(),
                "ref": formatted,
                "kind": "app" if is_app else "runtime",
                "branch": ref.get_branch(),
                "arch": ref.get_arch(),
                "origin": ref.get_origin(),
                "name": ref.get_appdata_name() or ref.get_name(),
                "version": ref.get_appdata_version() or None,
                # Bytes already on disk. libflatpak exposes no reliable size for
                # the pending download here, so report what is knowable rather
                # than estimating a number the download will not match.
                "installed_size": int(ref.get_installed_size() or 0),
            }
            candidates.append(entry)
        candidates.sort(key=lambda item: (item["kind"] != "app", item["name"].casefold()))
        return candidates

    def update_many(
        self,
        refs: Sequence[tuple[str, str]],
        events: TransactionEvents,
        should_cancel: Callable[[], bool],
    ) -> None:
        def configure(transaction: Any) -> None:
            for name, ref in refs:
                if not transaction.add_update(ref, None, None):
                    raise StoreError(f"Flatpak refused to queue update of {name}")

        self._transaction(configure, events, should_cancel)

    def refresh_index(
        self,
        events: TransactionEvents,
        should_cancel: Callable[[], bool],
    ) -> None:
        remote = self.ensure_flathub()
        cancellable = self.Gio.Cancellable()
        watcher_stop = threading.Event()

        def watch_cancel() -> None:
            while not watcher_stop.wait(0.2):
                if should_cancel():
                    cancellable.cancel()
                    return

        def progress(
            status: str, percentage: int, estimating: bool, *_data: object
        ) -> None:
            if should_cancel():
                cancellable.cancel()
            measured = None if estimating else max(0, min(100, int(percentage)))
            events.progress(
                "app/flathub/current/index",
                measured,
                status or "Refreshing app index",
                measured,
            )

        events.plan(1)
        events.started("app/flathub/current/index", "Refreshing app index")
        watcher = threading.Thread(
            target=watch_cancel, name="moos-store-index-cancel", daemon=True
        )
        watcher.start()
        try:
            self.user.update_appstream_full_sync(
                remote, None, progress, None, None, cancellable
            )
            if should_cancel() or cancellable.is_cancelled():
                raise CancelledError("Cancelled")
            events.done("app/flathub/current/index")
        except self.GLib.Error as error:
            if should_cancel() or cancellable.is_cancelled():
                raise CancelledError("Cancelled") from error
            raise StoreError(f"Could not refresh the app index: {error}") from error
        finally:
            watcher_stop.set()
            watcher.join(timeout=1)

    def remote_facts(self) -> dict[str, dict[str, Any]]:
        """Offline facts for every Flathub app: sizes, end of life and what it may do.

        Read-only and network-free: ONLY_CACHED reads the summary the installation already
        has. Only the verified Flathub remotes are read; the person's own installation wins
        where both list an app, and the stable branch wins over others.
        """
        facts: dict[str, dict[str, Any]] = {}
        arch = self.Flatpak.get_default_arch()
        trusted = False
        for installation in (self.user, self.system):
            try:
                remotes = list(installation.list_remotes(None))
            except Exception:
                continue
            for remote in remotes:
                if not self._official_remote(remote):
                    continue
                trusted = True
                try:
                    refs = installation.list_remote_refs_sync_full(
                        remote.get_name(), self.Flatpak.QueryFlags.ONLY_CACHED, None)
                except Exception:
                    continue
                chosen: dict[str, Any] = {}
                for ref in refs:
                    try:
                        if ref.get_kind() != self.Flatpak.RefKind.APP or ref.get_arch() != arch:
                            continue
                        name = ref.get_name()
                        branch = ref.get_branch()
                    except Exception:
                        continue
                    if name in facts or not validate_flatpak_id(name):
                        continue
                    current = chosen.get(name)
                    if current is None or (branch == "stable" and current.get_branch() != "stable"):
                        chosen[name] = ref
                for name, ref in chosen.items():
                    try:
                        metadata = ref.get_metadata()
                        text = bytes(metadata.get_data()).decode("utf-8", "replace") if metadata else ""
                        facts[name] = ref_facts(text, ref.get_download_size(), ref.get_installed_size(),
                                                ref.get_eol(), ref.get_eol_rebase())
                    except Exception:
                        continue
        if not trusted:
            raise StoreError("No verified app source is configured")
        return facts

    def launch(self, app_id: str) -> None:
        installation = self.user if self.is_user_installed(app_id) else self.system
        try:
            # Flatpak.Installation.launch() does not resolve a missing branch
            # to the app's current deployment: on this image, passing None made
            # it try `master` even when the installed ref was `stable`.  Resolve
            # the deployment first and launch that exact arch/branch, otherwise
            # a Store "Open" button can fail for a correctly installed app.
            installed_ref = installation.get_current_installed_app(app_id, None)
            arch = installed_ref.get_arch()
            branch = installed_ref.get_branch()
            if not installation.launch(app_id, arch, branch, None, None):
                raise StoreError(f"Flatpak did not launch {app_id}")
        except StoreError:
            raise
        except Exception as error:
            raise StoreError(f"Could not launch {app_id}: {error}") from error


class Controller:
    def __init__(
        self,
        store: JobStore,
        adapter_factory: Callable[[], Any] = FlatpakAdapter,
        runner: CommandRunner | None = None,
        catalog_path: Path = DEFAULT_CATALOG,
        opener: Any | None = None,
    ):
        self.store = store
        self.adapter_factory = adapter_factory
        self.runner = runner or CommandRunner()
        self.catalog_path = catalog_path
        self._adapter: Any | None = None
        # The HTTPS opener for pinned downloads; tests hand in one that trusts their own server.
        self.opener = opener
        # moos_vendor_rpm.install()'s tool seams (run, convert, proc_sys); empty means the
        # image's own rpmkeys/rpm/rpm2cpio and /proc/sys.
        self.vendor_options: dict[str, Any] = {}

    @property
    def adapter(self) -> Any:
        if self._adapter is None:
            self._adapter = self.adapter_factory()
        return self._adapter

    def _begin(self, action: str, item_ids: Sequence[str]) -> tuple[GlobalLock, Job]:
        lock = GlobalLock(self.store).acquire()
        try:
            self.store.clear_cancel()
            job = Job(self.store, action, item_ids)
            # Holding the lock, no job can be writing a download or unpacking one: what an
            # interrupted one left goes now, or nothing would ever remove it.
            sweep_downloads()
            self._sweep_appdrop_staging()
            return lock, job
        except Exception:
            lock.release()
            raise

    def _sweep_appdrop_staging(self) -> None:
        """sweep_staging() by App Drop's own folder and slug rule. Best effort: a job that has
        nothing to do with App Drop must not fail because its module cannot be loaded."""
        try:
            appdrop = self._appdrop()
            applications, slug = appdrop.applications_dir(), appdrop.SLUG
        except Exception:                                # noqa: BLE001
            return
        sweep_staging(applications, slug)

    def _begin_beside(self, action: str, item_ids: Sequence[str]) -> tuple[Any, Job]:
        """A job beside the one that holds the lock (only `run`): no lock, no sweep, the holder's
        cancel request left alone, and job.json written only while it holds no other live job."""
        return contextlib.nullcontext(), Job(BesideJobStore(self.store.directory), action, item_ids)

    def _may_open_beside(self) -> bool:
        """Whether an app may open while another process holds the lock: only while job.json
        reports no other live job (reports_live_job).

        The window learns how its Open ended only from a run document in job.json, and a live job
        keeps that file. Mo Store 2 then reads the live job as "our request was refused" and says
        Mo Store is busy; the old window says the operation did not start. Opened anyway, the app
        appeared while the window said it had not.
        """
        return not reports_live_job(self.store.read())

    def _begin_run(self, app_id: str) -> tuple[Any, Job]:
        """Opening an app is a job like any other while the lock is free. Held by the scheduled
        updater for a whole `flatpak update` (it writes no job.json), or by a job that stopped
        reporting, the app still opens, beside it: refusing answered the person's Open with
        "Mo Store is busy" for the whole update, and moos-control and moos:// links called it
        "not installed". Held by another request's live job, BusyError: busy is then the truth."""
        try:
            return self._begin("run", [app_id])
        except BusyError:
            if not self._may_open_beside():
                raise
            return self._begin_beside("run", [app_id])

    @staticmethod
    def _busy_document(action: str, item_ids: Sequence[str]) -> dict[str, Any]:
        now = utc_now()
        return {
            "schema": SCHEMA,
            "job_id": secrets.token_hex(16),
            "action": action,
            "state": "busy",
            "progress": None,
            "current_id": None,
            "message": "Another Mo Store operation is already running",
            "message_key": "busy",
            "items": [
                {
                    "id": item_id,
                    "state": "skipped",
                    "progress": None,
                    "message": "Another Mo Store operation is already running",
                    "message_key": "busy",
                }
                for item_id in item_ids
            ],
            "started_at": now,
            "updated_at": now,
        }

    def _refuse_busy(self, action: str, item_ids: Sequence[str]) -> tuple[int, dict[str, Any]]:
        """Busy is an answer too: publish it where the window looks, unless that is a live job."""
        document = self._busy_document(action, item_ids)
        publish_refusal(self.store, document)
        return 75, document

    @staticmethod
    def _library(name: str) -> Any:
        import importlib
        library = str(Path(__file__).resolve().parent.parent / "lib/moos")
        if library not in sys.path:
            sys.path.insert(0, library)
        return importlib.import_module(name)

    @classmethod
    def _webapp_policy(cls) -> Any:
        return cls._library("moos_webapp_policy")

    @staticmethod
    def _app_engine() -> Any:
        """moos-app-engine's PE reader: one reading of a Windows header for the whole system."""
        name = "moos_app_engine_for_storectl"
        loaded = sys.modules.get(name)
        if loaded is None:
            import importlib.machinery
            import importlib.util
            path = Path(__file__).resolve().parent.parent / "libexec/moos-app-engine"
            loader = importlib.machinery.SourceFileLoader(name, str(path))
            spec = importlib.util.spec_from_loader(name, loader)
            if spec is None:
                raise StoreError("The Windows program reader is unavailable")
            loaded = importlib.util.module_from_spec(spec)
            loader.exec_module(loaded)
            sys.modules[name] = loaded
        return loaded

    def _catalog(self) -> dict[str, dict[str, Any]]:
        try:
            data = json.loads(self.catalog_path.read_text(encoding="utf-8"))
            apps = data["apps"]
        except (OSError, UnicodeError, json.JSONDecodeError, KeyError, TypeError) as error:
            raise StoreError(f"Could not read store catalog: {error}") from error
        if not isinstance(apps, list):
            raise StoreError("Store catalog apps must be a list")
        result: dict[str, dict[str, Any]] = {}
        here = running_arch()
        for app in apps:
            if not isinstance(app, dict) or not isinstance(app.get("id"), str):
                raise StoreError("Store catalog contains an invalid app entry")
            if app["id"] in result:
                raise StoreError(f"Store catalog repeats app ID {app['id']}")
            # An app that names architectures exists on those and nowhere else.
            # The index builder hides these, and this makes the backend agree:
            # a stale index, a bundle recipe or an install-by-id must not be a
            # way round it. Measured on the A1: eleven of the catalogue's
            # thirty-three Flathub apps have no aarch64 build, and
            # `flatpak remote-info flathub com.spotify.Client --arch=aarch64`
            # answers "Can't find ref" -- so the install could only ever fail.
            declared = app.get("arch")
            if isinstance(declared, list) and declared and here not in declared:
                continue
            result[app["id"]] = app
        return result

    def _cancelled(self, job: Job) -> bool:
        job.heartbeat()
        return self.store.cancel_requested(job.job_id)

    @staticmethod
    def _review_note(recipe: dict[str, Any]) -> str:
        install = recipe.get("install")
        metadata = install if isinstance(install, dict) else {}
        # Current catalogs keep trust metadata beside the install mechanism.
        # The top-level fallback lets an older signed image upgrade cleanly.
        requires_review = metadata.get(
            "requires_review", recipe.get("requires_review", False)
        )
        risk_value = metadata.get("risk", recipe.get("risk"))
        if requires_review is not True or risk_value not in _REVIEW_RISKS:
            raise StoreError("Curated recipe is missing required review metadata")
        risk = clean_message(risk_value, 80)
        return f"reviewed risk: {risk}"

    @staticmethod
    def _curated_id_is_valid(app_id: str, recipe: dict[str, Any]) -> bool:
        """Validate the public Store id according to the recipe it selects.

        Most first-party recipes use short MoOS slugs. Android is deliberately
        different: its package name is already the canonical application id and
        is what the runtime, launcher and Store must agree on. Treating every
        curated id as a slug made every dotted Android entry impossible to
        install even though it appeared in the catalogue.
        """
        install = recipe.get("install")
        if isinstance(install, dict) and install.get("kind") == "android":
            package = install.get("package")
            return bool(
                isinstance(package, str)
                and package == app_id
                and _ANDROID_PACKAGE_RE.fullmatch(package)
            )
        return validate_curated_id(app_id)

    @staticmethod
    def _android_package(app_id: str, recipe: dict[str, Any]) -> str:
        install = recipe.get("install")
        package = install.get("package") if isinstance(install, dict) else None
        if (
            not isinstance(install, dict)
            or install.get("kind") != "android"
            or not isinstance(package, str)
            or package != app_id
            or not _ANDROID_PACKAGE_RE.fullmatch(package)
        ):
            raise StoreError(f"Catalog has an invalid Android package for {app_id}")
        return package

    @staticmethod
    def _android_running(result: CommandResult) -> bool:
        return bool(re.search(r"(?im)^Session:\s*RUNNING\s*$", result.output))

    def _android_session_up(self) -> bool:
        return self._android_running(self.runner.capture([WAYDROID, "status"]))

    @staticmethod
    def _android_not_running() -> StoreError:
        return StoreError("Android app support is not running right now; open this app from Mo Store",
                          message_key="android_not_running")

    def _ensure_android_session(self, job: Job, *, start: bool = True) -> None:
        """Make the already-configured user runtime ready for one explicit job.

        Opening, installing or removing an app is the person's intent to use
        the runtime, so starting its user session here needs no second dialog.
        The system image is never downloaded here; one-time setup remains the
        separately confirmed `moai-do setup-waydroid` action. With `start`
        false (a moos: link, or an open beside another job) a session that is
        not running is refused, never started.
        """
        status = self.runner.capture([WAYDROID, "status"])
        words = f"{status.output}\n{status.reason}".lower()
        if status.returncode == 127:
            raise StoreError(status.reason or "Could not inspect Android app support")
        if "not initialized" in words:
            raise StoreError("Android apps need the one-time MoOS setup first")
        if self._android_running(status):
            return
        if not start:
            raise self._android_not_running()
        self.runner.spawn([WAYDROID, "session", "start"])
        for _ in range(20):
            if self._cancelled(job):
                raise CancelledError("Cancelled")
            time.sleep(1)
            status = self.runner.capture([WAYDROID, "status"])
            if self._android_running(status):
                return
        raise StoreError("Android app support did not become ready")

    def _install_npm(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        install = recipe.get("install")
        package = install.get("pkg") if isinstance(install, dict) else None
        binary = install.get("bin") if isinstance(install, dict) else None
        if not isinstance(package, str) or not _NPM_PACKAGE_RE.fullmatch(package):
            raise StoreError(f"Catalog has an invalid npm package for {app_id}")
        if not isinstance(binary, str) or not _BIN_RE.fullmatch(binary):
            raise StoreError(f"Catalog has an invalid npm executable for {app_id}")
        prefix = Path.home() / ".local"
        prefix.mkdir(mode=0o700, parents=True, exist_ok=True)
        note = self._review_note(recipe)
        message = "Installing developer tool"
        if note:
            message += f" ({note})"
        job.update_item(app_id, state="running", progress=None, message=message, message_key=None)
        job.update(
            state="running", progress=None, current_id=app_id, message=message,
            message_key=None,
        )
        result = self.runner.run_cancellable(
            [
                NPM,
                "install",
                "--global",
                "--prefix",
                str(prefix),
                "--no-audit",
                "--no-fund",
                "--",
                package,
            ],
            lambda: self._cancelled(job),
        )
        if result.cancelled:
            raise CancelledError("Cancelled")
        if result.returncode:
            raise StoreError(result.reason or f"npm exited with {result.returncode}")
        done = "Installed"
        if note:
            done += f" ({note})"
        job.update_item(app_id, state="done", progress=100, message=done, message_key=None)

    def _install_web(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        install = recipe.get("install")
        url = install.get("url") if isinstance(install, dict) else None
        if not isinstance(url, str):
            raise StoreError(f"Catalog has no download URL for {app_id}")
        if not isinstance(install, dict) or install.get("external") is not True:
            raise StoreError(f"External download metadata is missing for {app_id}")
        parsed = urllib.parse.urlsplit(url)
        if (
            parsed.scheme != "https"
            or not parsed.hostname
            or parsed.username is not None
            or parsed.password is not None
        ):
            raise StoreError(f"Catalog has an unsafe download URL for {app_id}")
        note = self._review_note(recipe)
        self.runner.spawn([XDG_OPEN, url])
        message = "Opened the official download page"
        if note:
            message += f" ({note})"
        # Opened, never installed: nothing of this app is on the machine until the person installs
        # it from the publisher's page, so the item says "opened" in either language.
        job.update_item(app_id, state="opened", progress=100, message=message, message_key="opened")
        job.update(
            state="running", current_id=app_id, message=message,
            message_key=None,
        )

    # ── Pinned downloads: one helper for every kind that fetches a file ────────────────────────
    def _download_progress(self, job: Job, item_id: str, downloaded: int, size: int | None,
                           message: str, message_key: str) -> None:
        percent = min(99, int(downloaded * 100 / size)) if size else None
        job.update_item(item_id, state="running", progress=percent, message=message,
                        message_key=message_key)
        job.update(state="running", progress=percent, current_id=item_id, message=message,
                   message_key=message_key)

    def _download_pinned(self, job: Job, item_id: str, pin: PinnedArtifact, *, kind: str,
                         message: str, message_key: str) -> Path:
        """Fetch a pinned artifact from its publisher and return the verified file on disk.

        Refused: a Content-Length or a body larger than the pinned size, a body of any other
        size, a digest that differs, and any redirect hop that is not HTTPS. Checked for
        cancellation between blocks, which also keeps the job's heartbeat. The caller deletes
        the file once it has been handed on. Its progress `message` never says "verified": the
        size and digest are compared only after the last byte, and "Verified" is the word the
        window keeps for Flathub's own flag (docs/MO_STORE.md).
        """
        directory = downloads_dir()
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        limit = pin.size if pin.size is not None else UNSIZED_DOWNLOAD_CAP
        fd, partial_name = tempfile.mkstemp(prefix=f".{item_id}.", suffix=".part", dir=directory)
        partial = Path(partial_name)
        hasher = hashlib.sha256()
        downloaded = 0
        opener = self.opener or build_opener()
        try:
            request = urllib.request.Request(
                pin.url, headers={"User-Agent": "MoOS-Store/1"}, method="GET"
            )
            try:
                with os.fdopen(fd, "wb") as output, opener.open(request, timeout=30) as response:
                    if not _https_url_ok(response.geturl()):
                        raise StoreError("The download was redirected to an address that is not secure")
                    declared = (response.headers.get("Content-Length") or "").strip()
                    if declared.isdigit() and int(declared) > limit:
                        raise StoreError("The download is larger than the catalogue says it is")
                    self._download_progress(job, item_id, 0, pin.size, message, message_key)
                    reader = getattr(response, "read1", None) or response.read
                    last = -1
                    while True:
                        if self._cancelled(job):
                            raise CancelledError("Cancelled")
                        block = reader(DOWNLOAD_BLOCK)
                        if not block:
                            break
                        downloaded += len(block)
                        if downloaded > limit:
                            raise StoreError("The download is larger than the catalogue says it is")
                        output.write(block)
                        hasher.update(block)
                        step = int(downloaded * 100 / pin.size) if pin.size else downloaded >> 24
                        if step != last:
                            last = step
                            self._download_progress(job, item_id, downloaded, pin.size, message,
                                                    message_key)
                    output.flush()
                    os.fsync(output.fileno())
            except (StoreError, CancelledError):
                raise
            except (OSError, ValueError, http.client.HTTPException) as error:
                # URLError, HTTPError, timeouts and TLS failures are OSErrors; a connection that
                # ends early is an IncompleteRead.
                raise StoreError(f"Download failed: {clean_message(error, 300)}") from error
            if pin.size is not None and downloaded != pin.size:
                raise StoreError(
                    f"The download is {downloaded} bytes; the catalogue pins {pin.size}"
                )
            if hasher.hexdigest() != pin.sha256:
                raise StoreError("SHA-256 verification failed")
            with partial.open("rb") as handle:
                head = handle.read(600)
            final = directory / f"{item_id}{file_suffix(head, kind)}"
            os.chmod(partial, 0o600)
            os.replace(partial, final)
            return final
        except BaseException:
            with contextlib.suppress(FileNotFoundError):
                partial.unlink()
            raise

    @staticmethod
    def _recipe_version(app_id: str, install: dict[str, Any], *, required: bool = True) -> str:
        version = install.get("version")
        if version is None and not required:
            return ""
        if not isinstance(version, str) or not _VERSION_RE.fullmatch(version):
            raise StoreError(f"Catalog has an invalid version for {app_id}")
        return version

    @staticmethod
    def _menu_categories(app_id: str, install: dict[str, Any], allowed: Iterable[str]) -> list[str]:
        value = install.get("categories")
        if value is None:
            return []
        allowed = set(allowed)
        if (not isinstance(value, list) or not value or len(value) > 8
                or any(not isinstance(item, str) or item not in allowed for item in value)):
            raise StoreError(f"Catalog has invalid menu categories for {app_id}")
        return list(value)

    # ── App Drop: a pinned AppImage or archive from the catalogue ──────────────────────────────
    def _appdrop_progress(self, job: Job, item_id: str) -> Callable[[str, int | None], None]:
        def stage(percent: int | None, message: str, message_key: str) -> None:
            job.update_item(item_id, state="running", progress=percent,
                            message=message, message_key=message_key)
            job.update(state="running", progress=percent, current_id=item_id,
                       message=message, message_key=message_key)

        def progress(name: str, percent: int | None) -> None:
            # Literal keys, so tests/test_store_job_language.py can hold the UI to them.
            if name == "inspecting_file":
                stage(percent, "Reading the file", message_key="inspecting_file")
            elif name == "extracting_file":
                stage(percent, "Unpacking the application", message_key="extracting_file")
            else:
                stage(percent, "Adding it to the launcher", message_key="integrating_app")

        return progress

    def _appdrop_pins(self, app_id: str, recipe: dict[str, Any]) -> dict[str, Any]:
        """The launcher facts a reviewed recipe states, each checked before App Drop sees it."""
        appdrop = self._appdrop()
        install = recipe.get("install") or {}
        pinned: dict[str, Any] = {
            "name": display_text(recipe.get("en"), 80) or app_id,
            "name_ar": display_text(recipe.get("ar"), 80),
        }
        for key in ("exec", "icon"):
            if key in install:
                if _relative_inside(install[key]) is None:
                    raise StoreError(f"Catalog has an invalid {key} path for {app_id}")
                pinned[key] = install[key]
        if "wm_class" in install:
            value = install["wm_class"]
            if not isinstance(value, str) or not _WM_CLASS_RE.fullmatch(value):
                raise StoreError(f"Catalog has an invalid window class for {app_id}")
            pinned["wm_class"] = value
        if "desktop_id" in install:
            value = install["desktop_id"]
            if not isinstance(value, str) or len(value) > 200 or not appdrop.DESKTOP_ID.fullmatch(value):
                raise StoreError(f"Catalog has an invalid desktop id for {app_id}")
            pinned["desktop_id"] = value
        categories = self._menu_categories(app_id, install, appdrop.MAIN_CATEGORIES)
        if categories:
            pinned["categories"] = categories
        return pinned

    def _install_appdrop(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        """Download the pinned file, then let App Drop install it under the catalogue's id.

        One job and one lock, like any other install. App Drop extracts it (an AppImage only
        inside its sandbox), writes the launcher and the record, and swaps an update in only
        once the new version is complete.
        """
        install = recipe.get("install")
        if not isinstance(install, dict):
            raise StoreError(f"Catalog has no App Drop recipe for {app_id}")
        note = self._review_note(recipe)
        if install.get("external") is not True:
            raise StoreError(f"External download metadata is missing for {app_id}")
        artifact = install.get("artifact")
        if artifact not in ("appimage", "archive"):
            raise StoreError(f"Catalog has an invalid artifact for {app_id}")
        appdrop = self._appdrop()
        if not appdrop.SLUG.fullmatch(app_id):
            raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
        version = self._recipe_version(app_id, install)
        pin = pinned_artifact(app_id, install)
        pinned = self._appdrop_pins(app_id, recipe)
        download = self._download_pinned(job, app_id, pin, kind=artifact,
                                         message="Downloading from the publisher",
                                         message_key="downloading_file")
        try:
            try:
                plan = appdrop.plan_for(download, pinned["name"], app_id)
                if plan.kind != artifact:
                    raise StoreError(f"The download for {app_id} is not the kind of file the catalogue names")
                appdrop.install(plan, progress=self._appdrop_progress(job, app_id),
                                cancelled=lambda: self._cancelled(job), pinned=pinned,
                                record_extra={"catalog_id": app_id, "version": version, "url": pin.url})
            except appdrop.DropError as failure:
                if failure.code == "cancelled":
                    raise CancelledError("Cancelled") from failure
                raise StoreError(f"{failure.code}: {failure.detail or failure.code}") from failure
        finally:
            with contextlib.suppress(FileNotFoundError):
                download.unlink()
        job.update_item(app_id, state="done", progress=100, message=f"Installed ({note})",
                        message_key="installed")

    # ── Web apps: a website as an app, drawn by moos-webapp ────────────────────────────────────
    def _webapp(self, app_id: str, recipe: dict[str, Any]) -> Any:
        policy = self._webapp_policy()
        try:
            return policy.parse_entry(recipe)
        except policy.WebAppError as error:
            raise StoreError(f"Catalog web app {app_id} is invalid: {error.code}") from error

    def _install_webapp(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        self._review_note(recipe)
        app = self._webapp(app_id, recipe)
        job.update_item(app_id, state="running", progress=None,
                        message="Adding it to the launcher", message_key="integrating_app")
        job.update(state="running", progress=None, current_id=app_id,
                   message="Adding it to the launcher", message_key="integrating_app")
        self._webapp_policy().install(app)
        self._appdrop().refresh_menu()
        job.update_item(app_id, state="done", progress=100, message="Installed",
                        message_key="installed")

    # ── Windows programs: a pinned portable 64-bit program with its own prefix ─────────────────
    @staticmethod
    def _wine_argv(prefix: Path, command: Sequence[str], *, seconds: int = 300) -> list[str]:
        """A Windows-runtime command that cannot open a window.

        A clean environment: no display, no compositor socket and no session bus, so neither
        graphics driver can connect, and both are disabled as well. The person's language
        passes through, because a new prefix takes its locale from it.
        """
        user = pwd.getpwuid(os.getuid()).pw_name
        environment = [
            f"HOME={Path.home()}", "PATH=/usr/bin:/bin", f"USER={user}", f"LOGNAME={user}",
            f"WINEPREFIX={prefix}",
            f"WINEDLLOVERRIDES={WINE_OVERRIDES};winex11.drv,winewayland.drv=d",
            "WINEDEBUG=-all", "DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent",
        ]
        for name in ("LANG", "LC_ALL", "LC_CTYPE", "LC_MESSAGES"):
            value = os.environ.get(name, "")
            if value and re.fullmatch(r"[A-Za-z0-9_.@-]{1,64}", value):
                environment.append(f"{name}={value}")
        return [TIMEOUT_TOOL, "--kill-after=10", str(seconds), ENV_TOOL, "-i", *environment,
                *command]

    def _display_dpi(self) -> int:
        """The desktop density, clamped like moos-run-foreign's wine_display_dpi: 96..192."""
        result = self.runner.capture([XRDB, "-query"], timeout=10) if Path(XRDB).is_file() else None
        dpi = 96.0
        if result is not None and result.returncode == 0:
            for line in result.output.splitlines():
                fields = line.split()
                if len(fields) >= 2 and fields[0] == "Xft.dpi:":
                    with contextlib.suppress(ValueError):
                        dpi = float(fields[1])
                    break
        return int(f"{min(192.0, max(96.0, dpi)):.0f}")

    def _run_step(self, job: Job, argv: Sequence[str], failure: str) -> None:
        result = self.runner.run_cancellable(argv, lambda: self._cancelled(job))
        if result.cancelled:
            raise CancelledError("Cancelled")
        if result.returncode:
            raise StoreError(f"{failure}: {result.reason}" if result.reason else failure)

    def _wine_version(self, template: WindowsTemplate) -> str:
        """The Windows runtime's own version line ("wine-11.0 (Staging)"); "" when it cannot say.

        An unreadable version still installs: the template is then rebuilt the first time the
        runtime names itself, which is the cost of not knowing, never a wrong program."""
        result = self.runner.capture(
            self._wine_argv(template.prefix, [WINE, "--version"], seconds=30), timeout=40)
        lines = result.output.strip().splitlines() if result.returncode == 0 else []
        version = lines[0].strip() if lines else ""
        return version if re.fullmatch(r"[A-Za-z0-9 ._()+~:-]{1,80}", version) else ""

    def _windows_preparing(self, job: Job, item_id: str) -> None:
        job.update_item(item_id, state="running", progress=None,
                        message="Preparing the Windows program", message_key="preparing_windows")
        job.update(state="running", progress=None, current_id=item_id,
                   message="Preparing the Windows program", message_key="preparing_windows")

    def _ensure_windows_template(self, job: Job, item_id: str) -> dict[str, Any]:
        """The template settings folder for this runtime version, made once, headless.

        Built in a staging folder and swapped in only when complete, so an interrupted build
        never counts; its record (runtime version, density) is written last. Programs installed
        earlier keep their own folders: an older template is only replaced, never theirs."""
        template = windows_template()
        for owned in (template.root, template.prefix, template.staging, template.record):
            if owned.is_symlink():
                raise StoreError(f"{owned.name} is a link; Mo Store does not install through links")
        version = self._wine_version(template)
        record = _read_json(template.record)
        if (record.get("schema") == 1 and record.get("wine") == version
                and (template.prefix / "system.reg").is_file()):
            return record
        self._windows_preparing(job, item_id)
        template.root.mkdir(mode=0o700, parents=True, exist_ok=True)
        _remove_tree(template.staging)
        template.staging.mkdir(mode=0o700)
        try:
            self._run_step(job, self._wine_argv(template.staging, [WINE, "wineboot", "--init"]),
                           "The Windows program's settings folder could not be prepared")
            dpi = self._display_dpi()
            self._run_step(job, self._wine_argv(template.staging, [
                WINE, "reg", "add", "HKCU\\Control Panel\\Desktop", "/v", "LogPixels",
                "/t", "REG_DWORD", "/d", str(dpi), "/f"], seconds=120),
                "The Windows program's display density could not be set")
            # The registry reaches the disk when the runtime's server stops; wait for that.
            self._run_step(job, self._wine_argv(template.staging, [WINESERVER, "--wait"], seconds=120),
                           "The Windows program's settings folder did not finish")
            if not (template.staging / "system.reg").is_file():
                raise StoreError("The Windows program's settings folder could not be prepared")
            # The old template stops counting before it goes, then the new one takes its name.
            template.record.unlink(missing_ok=True)
            _remove_tree(template.prefix)
            template.staging.rename(template.prefix)
            record = {"schema": 1, "wine": version, "dpi": dpi, "created_at": int(time.time())}
            _write_json(template.record, record)
        except BaseException:
            with contextlib.suppress(Exception):
                self._stop_prefix(None, template.staging)
            with contextlib.suppress(OSError):
                _remove_tree(template.staging)
            raise
        return record

    def _init_windows_prefix(self, job: Job, paths: WindowsPaths) -> None:
        """The program's own prefix: a copy of the template, then the template's density stamp.

        `cp -a --reflink=auto` shares the template's extents where the filesystem can (btrfs)
        and makes a full copy where it cannot. The copy is the program's alone from then on:
        its registry and settings never reach the template or another program."""
        record = self._ensure_windows_template(job, paths.base.name)
        self._windows_preparing(job, paths.base.name)
        _remove_tree(paths.prefix)
        self._run_step(job, [CP_TOOL, "-a", "--reflink=auto", "--no-target-directory", "--",
                             str(windows_template().prefix), str(paths.prefix)],
                       "The Windows program's settings folder could not be prepared")
        if paths.prefix.is_symlink() or not (paths.prefix / "system.reg").is_file():
            raise StoreError("The Windows program's settings folder could not be prepared")
        # moos-run-foreign --app re-applies the density only when it changes.
        dpi = record.get("dpi")
        paths.state.mkdir(mode=0o700, parents=True, exist_ok=True)
        if isinstance(dpi, int) and not isinstance(dpi, bool) and 96 <= dpi <= 192:
            (paths.state / "windows-dpi").write_text(f"{dpi}\n", encoding="utf-8")

    def _stop_prefix(self, job: Job | None, prefix: Path) -> None:
        """End every Windows process of one settings folder, so it can be removed."""
        if not prefix.is_dir() or prefix.is_symlink() or not Path(WINESERVER).is_file():
            return
        result = self.runner.run_cancellable(
            self._wine_argv(prefix, [WINESERVER, "--kill"], seconds=30),
            (lambda: self._cancelled(job)) if job is not None else (lambda: False))
        if result.cancelled:
            raise CancelledError("Cancelled")
        # A non-zero answer here only says that nothing was running.

    def _stop_windows_prefix(self, job: Job | None, paths: WindowsPaths) -> None:
        """End every Windows process of this one program, so its folders can be removed."""
        self._stop_prefix(job, paths.prefix)

    @staticmethod
    def _retire_windows_template_if_unused() -> None:
        """The template is MoOS's own cache for the programs it installs: once the last one is
        gone, so is it (on btrfs it then owns its extents alone, a full 0.9 GB)."""
        template = windows_template()
        try:
            names = [entry.name for entry in template.root.iterdir()]
        except OSError:
            return
        if any(not name.startswith(".") for name in names):
            return
        for folder in (template.prefix, template.staging):
            with contextlib.suppress(OSError):
                _remove_tree(folder)
        with contextlib.suppress(OSError):
            template.record.unlink(missing_ok=True)

    def _windows_icon(self, program: Path, destination: Path, work_parent: Path) -> bool:
        """The program's own icon as a PNG, read inside the sandbox; False when there is none."""
        appdrop = self._appdrop()
        if not all(Path(tool).is_file() for tool in (appdrop.BWRAP, WRESTOOL, ICOTOOL)):
            return False
        with tempfile.TemporaryDirectory(prefix=".icon.", dir=work_parent) as raw:
            work = Path(raw)
            groups = work / "groups"
            images = work / "images"
            groups.mkdir()
            images.mkdir()
            self.runner.capture(appdrop.tool_sandbox_argv(
                {"app.exe": program}, groups,
                [WRESTOOL, "--extract", "--type=14", "--output=/out", "/in/app.exe"]), timeout=60)

            def order(path: Path) -> tuple[int, Any]:
                # Windows shows the first icon group: named entries, then numeric ids, ascending.
                match = re.search(r"_14_([^_]+)(?:_\d+)?\.ico$", path.name)
                name = match.group(1) if match else path.name
                return (1, int(name)) if name.isdigit() else (0, name.upper())

            found = sorted((p for p in groups.iterdir()
                            if p.suffix.lower() == ".ico" and p.is_file() and not p.is_symlink()),
                           key=order)
            if not found:
                return False
            self.runner.capture(appdrop.tool_sandbox_argv(
                {"icon.ico": found[0]}, images,
                [ICOTOOL, "--extract", "--output=/out", "/in/icon.ico"]), timeout=60)
            best: Path | None = None
            best_area = 0
            for image in images.iterdir():
                if image.is_symlink() or not image.is_file() or image.stat().st_size > 4 * 1024 * 1024:
                    continue
                with image.open("rb") as handle:
                    head = handle.read(24)
                if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR":
                    continue
                width, height = int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")
                if 0 < width <= 1024 and 0 < height <= 1024 and width * height > best_area:
                    best, best_area = image, width * height
            if best is None:
                return False
            temporary = destination.with_name(f".{destination.name}.new")
            shutil.copyfile(best, temporary)
            os.chmod(temporary, 0o644)
            os.replace(temporary, destination)
            return True

    @staticmethod
    def _windows_launcher(app_id: str, name_en: str, name_ar: str, icon: str, wm_class: str,
                          categories: Sequence[str]) -> str:
        lines = ["[Desktop Entry]", "Type=Application", f"Name={desktop_value(name_en)}"]
        if name_ar:
            lines.append(f"Name[ar]={desktop_value(name_ar)}")
        lines += [
            f"Exec={RUN_FOREIGN} --app {app_id}",
            f"TryExec={RUN_FOREIGN}",
            f"Icon={desktop_value(icon)}",
            "Terminal=false",
            "Categories=" + ";".join(categories or ["Utility"]) + ";",
            f"StartupWMClass={wm_class}",
            "StartupNotify=true",
            f"X-MoOS-WindowsApp={app_id}",
            "",
        ]
        return "\n".join(lines)

    def _install_windows_portable(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        """A portable 64-bit Windows program: its own folder, its own prefix, a MoOS launcher.

        ~/.local/share/moos/windows-apps/<id>/{app,prefix,icon.png}, a record beside it and
        org.moos.windows.<id>.desktop, whose only instruction is `moos-run-foreign --app <id>`.
        The prefix is created once, without a display, and kept across updates.
        """
        install = recipe.get("install")
        if not isinstance(install, dict):
            raise StoreError(f"Catalog has no Windows program recipe for {app_id}")
        note = self._review_note(recipe)
        if install.get("external") is not True:
            raise StoreError(f"External download metadata is missing for {app_id}")
        if running_arch() != "x86_64":
            raise StoreError("Windows programs run on 64-bit PC (x86_64) computers only",
                             message_key="unsupported_arch")
        program_path = _relative_inside(install.get("exe"))
        if program_path is None or not program_path.lower().endswith(".exe"):
            raise StoreError(f"Catalog has an invalid program path for {app_id}")
        version = self._recipe_version(app_id, install)
        wm_class = install.get("wm_class", PurePosixPath(program_path).name.lower())
        if not isinstance(wm_class, str) or not _WM_CLASS_RE.fullmatch(wm_class):
            raise StoreError(f"Catalog has an invalid window class for {app_id}")
        appdrop = self._appdrop()
        categories = self._menu_categories(app_id, install, appdrop.MAIN_CATEGORIES)
        if not all(Path(tool).is_file() for tool in (WINE, WINESERVER, TIMEOUT_TOOL, ENV_TOOL, CP_TOOL)):
            raise StoreError("This MoOS edition cannot run Windows programs")
        pin = pinned_artifact(app_id, install)
        paths = windows_paths(app_id)
        for owned in (paths.base, paths.app, paths.prefix):
            if owned.is_symlink():
                raise StoreError(f"{owned.name} is a link; Mo Store does not install through links")
        had_record = paths.record.is_file()
        fresh_prefix = not (paths.prefix / "system.reg").is_file()
        created_base = not paths.base.exists()
        download = self._download_pinned(job, app_id, pin, kind="windows",
                                         message="Downloading from the publisher",
                                         message_key="downloading_file")
        staging = paths.base / ".app.installing"
        previous = paths.base / ".app.previous"
        swapped = committed = False
        try:
            paths.base.mkdir(mode=0o700, parents=True, exist_ok=True)
            _remove_tree(staging)
            staging.mkdir(mode=0o755)
            self._appdrop_progress(job, app_id)("extracting_file", None)
            with download.open("rb") as handle:
                head = handle.read(8)
            if head[:4] == b"PK\x03\x04":
                budget = appdrop._Budget(download.stat().st_size, lambda: self._cancelled(job),
                                         lambda _done: None)
                try:
                    appdrop.extract_zip(download, staging, budget)
                except appdrop.DropError as failure:
                    if failure.code == "cancelled":
                        raise CancelledError("Cancelled") from failure
                    raise StoreError(f"{failure.code}: {failure.detail or failure.code}") from failure
                except (zipfile.BadZipFile, EOFError) as error:
                    raise StoreError(f"The download for {app_id} is not a valid archive") from error
            elif head[:2] == b"MZ":
                if "/" in program_path:
                    raise StoreError(f"Catalog names a folder inside a single program for {app_id}")
                shutil.copyfile(download, staging / program_path)
            else:
                raise StoreError(f"The download for {app_id} is not a Windows program")
            try:
                program = (staging / program_path).resolve(strict=True)
                program.relative_to(staging.resolve())
            except (OSError, ValueError) as error:
                raise StoreError(f"The catalogue's program {program_path} is not in the download") from error
            if not program.is_file():
                raise StoreError(f"The catalogue's program {program_path} is not in the download")
            architecture = self._app_engine().pe_architecture(program)
            if architecture == "x86":
                raise StoreError(
                    "This is a 32-bit Windows program; Mo Store installs 64-bit Windows programs",
                    message_key="windows_legacy_program")
            if architecture != "x86_64":
                raise StoreError(f"{program_path} is not a 64-bit Windows program")
            if fresh_prefix:
                self._init_windows_prefix(job, paths)
            self._appdrop_progress(job, app_id)("integrating_app", None)
            try:
                has_icon = self._windows_icon(program, paths.icon, paths.base)
            except (OSError, StoreError):
                has_icon = False                         # an icon is cosmetic; the glyph stands in
            has_icon = has_icon or paths.icon.is_file()
            _remove_tree(previous)
            if paths.app.exists():
                paths.app.rename(previous)
            staging.rename(paths.app)
            swapped = True
            launcher = self._windows_launcher(
                app_id, display_text(recipe.get("en"), 80) or app_id,
                display_text(recipe.get("ar"), 80),
                str(paths.icon) if has_icon else WINDOWS_FALLBACK_ICON, wm_class, categories)
            _atomic_bytes(paths.launcher, launcher.encode("utf-8"), 0o644, private_parent=False)
            _write_json(paths.record, {
                "schema": 1, "id": app_id, "name": display_text(recipe.get("en"), 80) or app_id,
                "version": version, "sha256": pin.sha256, "url": pin.url, "exe": program_path,
                "wm_class": wm_class, "launcher": paths.launcher.name,
                "installed_at": int(time.time()),
            })
            committed = True
            with contextlib.suppress(OSError):
                _remove_tree(previous)
            appdrop.refresh_menu()
        except BaseException:
            with contextlib.suppress(OSError):
                _remove_tree(staging)
            if not committed:
                if swapped:
                    with contextlib.suppress(OSError):
                        _remove_tree(paths.app)
                        if previous.exists():
                            previous.rename(paths.app)
                if not had_record:
                    # A first install that did not finish leaves nothing of itself behind.
                    with contextlib.suppress(Exception):
                        self._stop_windows_prefix(None, paths)
                    with contextlib.suppress(OSError):
                        if created_base:
                            _remove_tree(paths.base)
                        elif fresh_prefix:
                            _remove_tree(paths.prefix)
                        if self._windows_launcher_is_ours(paths, app_id):
                            paths.launcher.unlink()
                        if fresh_prefix:
                            _remove_tree(paths.state)
                    self._retire_windows_template_if_unused()
            raise
        finally:
            with contextlib.suppress(FileNotFoundError):
                download.unlink()
        job.update_item(app_id, state="done", progress=100, message=f"Installed ({note})",
                        message_key="installed")

    @staticmethod
    def _windows_launcher_is_ours(paths: WindowsPaths, app_id: str) -> bool:
        if paths.launcher.is_symlink() or not paths.launcher.is_file():
            return False
        try:
            text = paths.launcher.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return False
        return f"X-MoOS-WindowsApp={app_id}" in text.splitlines()

    def _remove_windows(self, job: Job, app_id: str, delete_data: bool) -> None:
        paths = windows_paths(app_id)
        if not (paths.record.is_file() or paths.base.exists() or self._windows_launcher_is_ours(paths, app_id)):
            job.update_item(app_id, state="skipped", progress=100, message="App is not installed",
                            message_key="not_installed")
            return
        job.update_item(app_id, state="running", progress=None,
                        message="Removing application", message_key=None)
        job.update(state="running", progress=None, current_id=app_id,
                   message="Removing application", message_key=None)
        self._stop_windows_prefix(job, paths)
        # The program, its prefix (its settings and registry) and MoOS's own traces of it.
        _remove_tree(paths.base)
        if self._windows_launcher_is_ours(paths, app_id):
            paths.launcher.unlink()
        paths.record.unlink(missing_ok=True)
        _remove_tree(paths.state)
        paths.log.unlink(missing_ok=True)
        self._retire_windows_template_if_unused()
        self._appdrop().refresh_menu()
        if delete_data:
            job.update_item(app_id, state="done", progress=100, message="Removed with its data",
                            message_key="removed_with_data")
        else:
            job.update_item(app_id, state="done", progress=100, message="Removed",
                            message_key="removed")

    # ── A publisher's own signed Linux package, run from the home ──────────────────────────────
    # The logic is usr/lib/moos/moos_vendor_rpm.py: the newest build from the publisher's own
    # repository, a pinned download, the publisher's signature by the one key the image trusts,
    # only the app's folder unpacked into ~/Applications/<id>, nothing from the package run, a
    # launcher MoOS writes (org.moos.vendor.<id>.desktop) and a record. It runs HERE so that it is
    # a Mo Store job like any other: one lock, one job document, one progress feed for the Island.
    @staticmethod
    def _vendor() -> Any:
        return Controller._library("moos_vendor_rpm")

    def _vendor_progress(self, job: Job, item_id: str) -> Callable[[str, int | None], None]:
        def stage(percent: int | None, message: str, message_key: str) -> None:
            job.update_item(item_id, state="running", progress=percent, message=message,
                            message_key=message_key)
            job.update(state="running", progress=percent, current_id=item_id, message=message,
                       message_key=message_key)

        def progress(name: str, percent: int | None) -> None:
            # Literal keys, so tests/test_store_job_language.py can hold the UI to them.
            if name == "resolving":
                stage(None, "Finding the newest version", message_key="vendor_resolving")
            elif name == "downloading":
                stage(percent, "Downloading from the publisher", message_key="vendor_downloading")
            elif name == "verifying":
                stage(None, "Checking the publisher's signature", message_key="vendor_verifying")
            elif name == "extracting":
                # None while the payload is being written out: nothing measures that step.
                stage(percent, "Unpacking the application", message_key="extracting_file")
            else:
                stage(percent, "Adding it to the launcher", message_key="integrating_app")

        return progress

    @staticmethod
    def _vendor_failure(failure: Any) -> StoreError:
        """A moos_vendor_rpm refusal in the Store's words: a stable key, the details for a log."""
        code = getattr(failure, "code", "")
        if code == "cancelled":
            return CancelledError("Cancelled")
        key = VENDOR_FAILURE_KEYS.get(code)
        words = VENDOR_FAILURE_WORDS.get(key or "", "The app could not be installed")
        detail = clean_message(getattr(failure, "detail", "") or code, 300)
        return StoreError(f"{words} ({code}: {detail})", message_key=key)

    def _vendor_spec(self, app_id: str, recipe: dict[str, Any]) -> tuple[Any, Any, str]:
        """(module, checked catalogue entry, this machine's architecture) for one vendor app."""
        install = recipe.get("install")
        if not isinstance(install, dict):
            raise StoreError(f"Catalog has no publisher package recipe for {app_id}")
        self._review_note(recipe)
        if install.get("external") is not True:
            raise StoreError(f"External download metadata is missing for {app_id}")
        # It is a program downloaded from its publisher and run unsandboxed: the label says so.
        if install.get("risk") != "downloaded-executable":
            raise StoreError("Curated recipe is missing required review metadata")
        vendor = self._vendor()
        try:
            vendor.check_id(app_id)
            return vendor, vendor.parse_entry(install), vendor.check_arch(vendor.machine_arch())
        except vendor.VendorError as failure:
            raise self._vendor_failure(failure) from failure

    def _install_vendor(self, job: Job, app_id: str, recipe: dict[str, Any]) -> bool:
        """Install or update one vendor app; False when what is here is already the newest build.

        The module swaps an update in only once the new version is complete and integrated, and
        brings the version that worked back after any failure. An install that is no longer
        whole (its launcher or folder gone) is installed again, which repairs it."""
        vendor, entry, arch = self._vendor_spec(app_id, recipe)
        progress = self._vendor_progress(job, app_id)
        try:
            progress("resolving", None)
            info = self._vendor_resolve(vendor, entry, arch, job=job)
            if vendor.intact(app_id) and not vendor.update_available(app_id, info):
                return False
            vendor.install(app_id, entry, arch=arch, info=info,
                           display_name=display_text(recipe.get("en"), 80) or app_id,
                           progress=progress, cancelled=lambda: self._cancelled(job),
                           opener=self.opener, **self.vendor_options)
        except vendor.VendorError as failure:
            raise self._vendor_failure(failure) from failure
        return True

    def _install_vendor_app(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        if self._install_vendor(job, app_id, recipe):
            job.update_item(app_id, state="done", progress=100,
                            message=f"Installed ({self._review_note(recipe)})", message_key="installed")
        else:
            job.update_item(app_id, state="skipped", progress=100,
                            message="Already installed for this user", message_key="already_installed_user")

    def _vendor_record(self, app_id: str) -> dict[str, Any]:
        """What a vendor app's record says, or {} when there is none (or the id cannot be one)."""
        if not validate_curated_id(app_id):
            return {}
        vendor = self._vendor()
        try:
            return vendor.installed(app_id) or {}
        except vendor.VendorError:
            return {}

    def _vendor_intact(self, app_id: str) -> bool:
        vendor = self._vendor()
        try:
            return bool(vendor.intact(app_id))
        except vendor.VendorError:
            return False

    def _remove_vendor(self, job: Job, app_id: str, delete_data: bool) -> None:
        """Only what MoOS wrote: the unpacked folder, its launcher and its record.

        The program keeps its own settings and sign-in wherever it chose in the home folder;
        they are the person's, never MoOS's to delete, and the result says so honestly."""
        vendor = self._vendor()
        job.update_item(app_id, state="running", progress=None,
                        message="Removing application", message_key=None)
        job.update(state="running", progress=None, current_id=app_id,
                   message="Removing application", message_key=None)
        try:
            removed = vendor.remove(app_id)
        except vendor.VendorError as failure:
            raise self._vendor_failure(failure) from failure
        if not removed:
            job.update_item(app_id, state="skipped", progress=100, message="App is not installed",
                            message_key="not_installed")
            return
        self._removed_untracked(job, app_id, delete_data)

    def _remove_vendor_record(self, app_id: str, delete_data: bool) -> tuple[int, dict[str, Any]]:
        """A vendor app the catalogue no longer offers stays removable by its id."""
        try:
            lock, job = self._begin("remove", [app_id])
        except BusyError:
            return self._refuse_busy("remove", [app_id])
        with lock:
            try:
                self._remove_vendor(job, app_id, delete_data)
                job.finish_from_items("App removed", "app_removed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    def _vendor_resolve(self, vendor: Any, entry: Any, arch: str, *, job: Job | None = None,
                        seconds: float | None = None) -> dict[str, Any]:
        """moos_vendor_rpm.resolve() in a worker thread.

        Inside a job the wait keeps the job's heartbeat and its cancel button (the module allows
        each metadata document up to two minutes, the window calls a silent job stale after
        120 s); for an update check it simply stops waiting after `seconds`. A worker left
        behind is a daemon that only reads; it ends with its own network timeouts."""
        answer: dict[str, Any] = {}

        def ask() -> None:
            try:
                answer["info"] = vendor.resolve(entry, arch, opener=self.opener)
            except BaseException as error:              # noqa: BLE001 - handed to the caller
                answer["error"] = error

        worker = threading.Thread(target=ask, name="vendor-resolve", daemon=True)
        worker.start()
        deadline = None if seconds is None else time.monotonic() + seconds
        while worker.is_alive():
            worker.join(0.25)
            if worker.is_alive() and job is not None and self._cancelled(job):
                raise CancelledError("Cancelled")
            if worker.is_alive() and deadline is not None and time.monotonic() > deadline:
                raise vendor.VendorError("network_error", "the publisher did not answer in time")
        if "error" in answer:
            raise answer["error"]
        return answer["info"]

    def _vendor_newest(self, app_id: str, recipe: dict[str, Any]) -> dict[str, Any] | None:
        """The publisher's newest build for an update check, or None when it cannot be asked.

        Offline, refused or slower than VENDOR_CHECK_SECONDS is "no answer": no update row and
        no failure — an update check never waits on one publisher's server for long."""
        try:
            vendor, entry, arch = self._vendor_spec(app_id, recipe)
            return self._vendor_resolve(vendor, entry, arch, seconds=VENDOR_CHECK_SECONDS)
        except Exception:                                # noqa: BLE001 - advisory, never a failure
            return None

    # ── Android ─────────────────────────────────────────────────────────────────────────────────
    def _android_packages(self) -> set[str] | None:
        """The packages the Android container reports, or None when it could not say."""
        result = self.runner.capture([WAYDROID, "app", "list"], timeout=60)
        if result.returncode:
            return None
        return set(re.findall(
            r"(?m)^\s*packageName:\s*([A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*)+)\s*$",
            result.output))

    @staticmethod
    def _write_android_record(package: str, *, sha256: str, source: str, catalog_id: str = "",
                              version: str = "", file_name: str = "") -> None:
        _write_json(android_record_path(package), {
            "schema": 1, "id": package, "package": package, "catalog_id": catalog_id,
            "version": version, "sha256": sha256, "source": source, "file": file_name,
            "installed_at": int(time.time()),
        })

    def _install_pinned_android(
        self, job: Job, app_id: str, recipe: dict[str, Any]
    ) -> None:
        """An Android app from the catalogue: pinned URL, verified digest, one job.

        The same shape as every pinned kind, because the risk is the same: MoOS is fetching a
        binary from the internet and then running it. https only, no credentials in the URL,
        no insecure redirect hop, a size cap, and a SHA-256 that must match before anything is
        handed to the container. A catalogue entry that is not pinned is refused.

        The Android runtime must already be ready. The store does not silently pull
        a ~1 GB system image behind an install button: `moos-app-engine` reports
        needs_setup for that, and the owner is asked by the setup action.
        """
        install = recipe.get("install")
        if not isinstance(install, dict):
            raise StoreError(f"Catalog has no Android recipe for {app_id}")
        note = self._review_note(recipe)
        if install.get("external") is not True:
            raise StoreError(f"External download metadata is missing for {app_id}")
        package = self._android_package(app_id, recipe)
        pin = pinned_artifact(app_id, install, size_required=False)
        version = self._recipe_version(app_id, install, required=False)
        self._ensure_android_session(job)
        download = self._download_pinned(job, app_id, pin, kind="android",
                                         message="Downloading the Android app",
                                         message_key="downloading_android")
        try:
            job.update_item(
                app_id, state="running", progress=None,
                message="Installing application", message_key="integrating_app",
            )
            result = self.runner.run_cancellable(
                [WAYDROID, "app", "install", str(download)],
                lambda: self._cancelled(job),
            )
            if result.cancelled:
                raise CancelledError("Cancelled")
            if result.returncode or re.search(
                r"\b(?:error|failed)\b", result.reason, re.IGNORECASE
            ):
                raise StoreError(result.reason or "Android installation failed")
            self._write_android_record(package, sha256=pin.sha256, source="catalog",
                                       catalog_id=app_id, version=version)
            job.update_item(
                app_id, state="done", progress=100,
                message=f"Installed ({note})", message_key="installed",
            )
        finally:
            with contextlib.suppress(FileNotFoundError):
                download.unlink()

    def _offered_elsewhere(self, app_ids: Sequence[str],
                           here: dict[str, dict[str, Any]]) -> set[str]:
        """The requested ids the catalogue offers on other kinds of computer only.

        `_catalog()` leaves those entries out, so nothing installs them here. Named, each one
        is refused alone in words the window can say, instead of reaching Flathub as an unknown
        id (or failing as an invalid one) and taking the rest of the batch down with it.
        """
        wanted = {app_id for app_id in app_ids if app_id not in here}
        if not wanted:
            return set()
        try:
            apps = json.loads(self.catalog_path.read_text(encoding="utf-8"))["apps"]
        except (OSError, UnicodeError, json.JSONDecodeError, KeyError, TypeError):
            return set()
        if not isinstance(apps, list):
            return set()
        machine = running_arch()
        return {app["id"] for app in apps if isinstance(app, dict)
                and isinstance(app.get("id"), str) and app["id"] in wanted
                and isinstance(app.get("arch"), list) and app["arch"] and machine not in app["arch"]}

    def install(self, raw_ids: Sequence[str]) -> tuple[int, dict[str, Any]]:
        if not raw_ids or len(raw_ids) > MAX_BATCH:
            raise StoreError(f"install accepts between 1 and {MAX_BATCH} app IDs")
        if any(
            not isinstance(app_id, str)
            or not 1 <= len(app_id) <= 255
            or "\x00" in app_id
            for app_id in raw_ids
        ):
            raise StoreError("App IDs must be non-empty text of at most 255 characters",
                             message_key="invalid_id")
        app_ids = dedupe(raw_ids)
        try:
            lock, job = self._begin("install", app_ids)
        except BusyError:
            return self._refuse_busy("install", app_ids)
        with lock:
            try:
                catalog = self._catalog()
                elsewhere = self._offered_elsewhere(app_ids, catalog)
                flatpak_ids: list[str] = []
                curated: list[tuple[str, dict[str, Any]]] = []
                invalid: list[str] = []
                for app_id in app_ids:
                    recipe = catalog.get(app_id)
                    if recipe is None:
                        if app_id in elsewhere:
                            job.update_item(
                                app_id,
                                state="failed",
                                progress=None,
                                message=f"{app_id} is not available for this kind of computer",
                                message_key="unsupported_arch",
                            )
                        elif validate_flatpak_id(app_id):
                            flatpak_ids.append(app_id)
                        else:
                            invalid.append(app_id)
                        continue
                    source = recipe.get("source")
                    if source == "flathub":
                        if validate_flatpak_id(app_id):
                            flatpak_ids.append(app_id)
                        else:
                            invalid.append(app_id)
                    elif source == "moos" and self._curated_id_is_valid(app_id, recipe):
                        curated.append((app_id, recipe))
                    else:
                        invalid.append(app_id)
                if invalid:
                    raise StoreError(
                        "Invalid or unsupported app ID(s): " + ", ".join(invalid)
                    )

                for app_id, recipe in curated:
                    if self._cancelled(job):
                        raise CancelledError("Cancelled")
                    kind = (recipe.get("install") or {}).get("kind")
                    try:
                        if kind == "npm":
                            self._install_npm(job, app_id, recipe)
                        elif kind == "web":
                            self._install_web(job, app_id, recipe)
                        elif kind == "webapp":
                            self._install_webapp(job, app_id, recipe)
                        elif kind == "appdrop":
                            self._install_appdrop(job, app_id, recipe)
                        elif kind == "windows-portable":
                            self._install_windows_portable(job, app_id, recipe)
                        elif kind == "vendor-rpm":
                            self._install_vendor_app(job, app_id, recipe)
                        elif kind == "android":
                            self._install_pinned_android(job, app_id, recipe)
                        else:
                            raise StoreError(
                                f"Unsupported curated install kind for {app_id}: {kind}",
                                message_key="unsupported_kind",
                            )
                    except CancelledError:
                        raise
                    except Exception as error:
                        job.update_item(
                            app_id,
                            state="failed",
                            progress=None,
                            message=clean_message(error),
                            message_key=getattr(error, "message_key", None),
                        )

                pending_flatpaks: list[str] = []
                for app_id in flatpak_ids:
                    if self.adapter.is_user_installed(app_id):
                        job.update_item(
                            app_id,
                            state="skipped",
                            progress=100,
                            message="Already installed for this user", message_key="already_installed_user",
                        )
                    elif self.adapter.is_system_installed(app_id):
                        job.update_item(
                            app_id,
                            state="skipped",
                            progress=100,
                            message="Already installed system-wide", message_key="already_installed_system",
                        )
                    else:
                        pending_flatpaks.append(app_id)

                if pending_flatpaks:
                    events = TransactionEvents(job, pending_flatpaks)
                    try:
                        self.adapter.install_many(
                            pending_flatpaks,
                            events,
                            lambda: self._cancelled(job),
                        )
                        for app_id in pending_flatpaks:
                            if job._items[app_id]["state"] in {"queued", "running"}:
                                job.update_item(
                                    app_id,
                                    state="done",
                                    progress=100,
                                    message="Installed",
                                    message_key="installed",
                                )
                    except CancelledError:
                        raise
                    except StoreError as error:
                        for app_id in pending_flatpaks:
                            if job._items[app_id]["state"] in {"queued", "running"}:
                                job.update_item(
                                    app_id,
                                    state="failed",
                                    progress=None,
                                    message=clean_message(error),
                                    message_key=None,
                                )
                # A publisher page that was opened is not an app that is ready: say which.
                states = [item["state"] for item in job.document["items"]]
                if states and all(state == "opened" for state in states):
                    job.finish_from_items("Opened the publisher's page", "publisher_page_opened")
                elif "opened" in states:
                    job.finish_from_items("Completed", "completed")
                else:
                    job.finish_from_items("All requested apps are ready", "all_ready")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error)
            return exit_code(job.document["state"]), job.snapshot()

    def _remove_curated(
        self, app_id: str, recipe: dict[str, Any], delete_data: bool = False
    ) -> tuple[int, dict[str, Any]]:
        """Reverse a curated (non-Flatpak) install. Install is kind-aware, so
        removal has to be too: an npm tool installed with `npm install --global
        --prefix ~/.local` is removed with the symmetric uninstall, a pinned
        App Drop app through App Drop, a web app's launcher (and with
        --delete-data its sign-in and storage) through its policy, a Windows
        program with its own prefix, a publisher's signed package through
        moos_vendor_rpm (only what MoOS wrote), and a `web` entry only ever
        opened a vendor page — there is nothing of ours to remove. Without this, `moos-storectl
        remove claude-code` hit the Flatpak-ID validator and failed, so the tool
        showed as installed for ever with no way back."""
        install = recipe.get("install") or {}
        kind = install.get("kind")
        try:
            lock, job = self._begin("remove", [app_id])
        except BusyError:
            return self._refuse_busy("remove", [app_id])
        with lock:
            try:
                if kind == "npm":
                    self._remove_npm(job, app_id, install, delete_data)
                elif kind == "appimage":
                    self._remove_appimage(job, app_id, install)
                elif kind == "android":
                    self._remove_android(job, app_id, recipe, delete_data)
                elif kind == "webapp":
                    self._remove_webapp(job, app_id, delete_data)
                elif kind == "appdrop":
                    self._remove_appdrop(job, app_id, delete_data)
                elif kind == "windows-portable":
                    self._remove_windows(job, app_id, delete_data)
                elif kind == "vendor-rpm":
                    self._remove_vendor(job, app_id, delete_data)
                elif kind == "web":
                    job.update_item(
                        app_id,
                        state="skipped",
                        progress=100,
                        message="Nothing to remove — this app is downloaded from "
                        "its official website, outside Mo Store",
                        message_key="nothing_to_remove",
                    )
                else:
                    raise StoreError(
                        f"Unsupported curated install kind for {app_id}: {kind}",
                        message_key="unsupported_kind",
                    )
                job.finish_from_items("App removed", "app_removed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    @staticmethod
    def _removed_untracked(job: Job, app_id: str, delete_data: bool) -> None:
        """App Drop, npm and publishers' own apps keep their settings and their sign-in wherever
        they chose (ChatGPT's in its config folder, Claude Code's in ~/.claude); say so, honestly.
        Someone removing an app with its data to sign out of it must not be told only settings
        stayed."""
        if delete_data:
            job.update_item(
                app_id, state="done", progress=100,
                message=("Removed. What the app saved elsewhere in your home folder, including its "
                         "settings and any sign-in, was kept"),
                message_key="removed_data_untracked",
            )
        else:
            job.update_item(app_id, state="done", progress=100, message="Removed",
                            message_key="removed")

    def _remove_npm(self, job: Job, app_id: str, install: dict[str, Any],
                    delete_data: bool = False) -> None:
        package = install.get("pkg")
        if not isinstance(package, str) or not _NPM_PACKAGE_RE.fullmatch(package):
            raise StoreError(f"Catalog has an invalid npm package for {app_id}")
        prefix = Path.home() / ".local"
        message = "Removing developer tool"
        job.update_item(app_id, state="running", progress=None, message=message, message_key=None)
        job.update(
            state="running", progress=None, current_id=app_id, message=message,
            message_key=None,
        )
        # Symmetric with _install_npm: same global user prefix, same no-shell
        # argv, `--` before the name so a package that starts with a dash can
        # never be read as a flag.
        result = self.runner.run_cancellable(
            [
                NPM,
                "uninstall",
                "--global",
                "--prefix",
                str(prefix),
                "--no-audit",
                "--no-fund",
                "--",
                package,
            ],
            lambda: self._cancelled(job),
        )
        if result.cancelled:
            raise CancelledError("Cancelled")
        if result.returncode:
            raise StoreError(result.reason or f"npm exited with {result.returncode}")
        self._removed_untracked(job, app_id, delete_data)

    def _remove_appimage(
        self, job: Job, app_id: str, install: dict[str, Any]
    ) -> None:
        # The retired `appimage` kind wrote one bare file in ~/.local/bin. No catalogue entry
        # installs it any more; removing a copy an older Store left behind stays possible.
        binary = install.get("bin")
        if not isinstance(binary, str) or not _BIN_RE.fullmatch(binary):
            raise StoreError(f"Catalog has an invalid AppImage executable for {app_id}")
        target = Path.home() / ".local" / "bin" / f"{binary}.AppImage"
        try:
            target.unlink()
        except FileNotFoundError:
            job.update_item(
                app_id, state="skipped", progress=100, message="App is not installed",
                message_key="not_installed"
            )
            return
        job.update_item(
            app_id, state="done", progress=100, message="Removed",
            message_key="removed",
        )

    def _remove_appdrop(self, job: Job, app_id: str, delete_data: bool, slug: str | None = None) -> None:
        """`slug` is App Drop's name for the app when the Store's id differs (`appdrop-<slug>`)."""
        appdrop = self._appdrop()
        try:
            removed = appdrop.remove(slug or app_id)
        except appdrop.DropError as failure:
            raise StoreError(f"{failure.code}: {failure.detail or failure.code}") from failure
        if not removed:
            job.update_item(app_id, state="skipped", progress=100, message="App is not installed",
                            message_key="not_installed")
            return
        self._removed_untracked(job, app_id, delete_data)

    def _remove_webapp(self, job: Job, app_id: str, delete_data: bool) -> None:
        policy = self._webapp_policy()
        try:
            was_installed = policy.is_installed(app_id)
            removed = policy.remove(app_id, delete_data=delete_data)
        except policy.WebAppError as error:
            raise StoreError(f"Could not remove {app_id}: {error.code}") from error
        if not was_installed and not removed:
            job.update_item(app_id, state="skipped", progress=100, message="App is not installed",
                            message_key="not_installed")
            return
        self._appdrop().refresh_menu()
        if delete_data:
            job.update_item(app_id, state="done", progress=100, message="Removed with its data",
                            message_key="removed_with_data")
        else:
            job.update_item(app_id, state="done", progress=100, message="Removed",
                            message_key="removed")

    def _remove_android(
        self, job: Job, app_id: str, recipe: dict[str, Any], delete_data: bool = False
    ) -> None:
        self._remove_android_package(job, app_id, self._android_package(app_id, recipe), delete_data)

    def _remove_android_package(self, job: Job, item_id: str, package: str,
                                delete_data: bool = False) -> None:
        self._ensure_android_session(job)
        job.update_item(
            item_id, state="running", progress=None,
            message="Removing application", message_key=None,
        )
        job.update(
            state="running", progress=None, current_id=item_id,
            message="Removing application", message_key=None,
        )
        result = self.runner.run_cancellable(
            [WAYDROID, "app", "remove", package],
            lambda: self._cancelled(job),
        )
        if result.cancelled:
            raise CancelledError("Cancelled")
        if result.returncode or re.search(
            r"\b(?:error|failed)\b|session is stopped",
            result.reason,
            re.IGNORECASE,
        ):
            raise StoreError(result.reason or "Could not remove the application")
        android_record_path(package).unlink(missing_ok=True)
        # Android deletes an app's own data when the app is removed.
        if delete_data:
            job.update_item(item_id, state="done", progress=100, message="Removed with its data",
                            message_key="removed_with_data")
        else:
            job.update_item(
                item_id, state="done", progress=100, message="Removed",
                message_key="removed",
            )

    def _remove_dropped(self, app_id: str, delete_data: bool, slug: str) -> tuple[int, dict[str, Any]]:
        """An app installed from a file the person dropped: App Drop's own record, no recipe. The
        job names it by the id the window sent, which may be `appdrop-<slug>`."""
        try:
            lock, job = self._begin("remove", [app_id])
        except BusyError:
            return self._refuse_busy("remove", [app_id])
        with lock:
            try:
                self._remove_appdrop(job, app_id, delete_data, slug)
                job.finish_from_items("App removed", "app_removed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    def _remove_android_record(self, package: str, delete_data: bool) -> tuple[int, dict[str, Any]]:
        """An Android app installed from a file: the record MoOS wrote names its package."""
        try:
            lock, job = self._begin("remove", [package])
        except BusyError:
            return self._refuse_busy("remove", [package])
        with lock:
            try:
                self._remove_android_package(job, package, package, delete_data)
                job.finish_from_items("App removed", "app_removed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [package])
            return exit_code(job.document["state"]), job.snapshot()

    def _dropped_slug(self, app_id: str) -> str | None:
        """App Drop's slug for an app installed from a file, by the id the index lists it under.

        That is the slug itself, or `appdrop-<slug>` when a catalogue app of another kind already
        has the slug as its id (moos-store-index's apply_lifecycle): a dropped
        `figma-linux_0.11.5_linux_x86_64.AppImage` is `figma`, and so is the catalogue's Figma web
        app. Only a record the person dropped (no `catalog_id`) answers to the second name, and
        only by a slug App Drop itself would accept; a catalogue install keeps its catalogue id.
        """
        appdrop = self._appdrop()
        if validate_curated_id(app_id) and appdrop.read_record(app_id):
            return app_id
        prefix = "appdrop-"
        slug = app_id[len(prefix):] if app_id.startswith(prefix) else ""
        if appdrop.SLUG.fullmatch(slug):
            record = appdrop.read_record(slug)
            if record and not record.get("catalog_id"):
                return slug
        return None

    def _dropped_android(self, app_id: str) -> bool:
        """An Android app installed from a file: MoOS wrote a record naming its package.

        When a Flatpak with the same reverse-DNS id is installed, that id keeps meaning the
        Flatpak, as it always did; the Android copy is then reached only from Android's own menu.
        """
        return bool(
            _ANDROID_PACKAGE_RE.fullmatch(app_id)
            and android_record_path(app_id).is_file()
            and not (validate_flatpak_id(app_id)
                     and (self.adapter.is_user_installed(app_id)
                          or self.adapter.is_system_installed(app_id)))
        )

    def _delete_flatpak_data(self, job: Job, app_id: str) -> None:
        """What `flatpak uninstall --delete-data` removes, plus the person's changed permissions."""
        if not validate_flatpak_id(app_id):
            raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
        _remove_tree(Path.home() / ".var" / "app" / app_id)
        for argv in ([FLATPAK_CLI, "override", "--user", "--reset", app_id],
                     [FLATPAK_CLI, "permission-reset", app_id]):
            self._run_step(job, argv, "Could not reset the app's permissions")

    def remove(self, app_id: str, delete_data: bool = False) -> tuple[int, dict[str, Any]]:
        # A curated (source="moos") app is not a Flatpak, so it must be handled
        # before the Flatpak-ID validator that would otherwise reject it.
        recipe = self._catalog().get(app_id)
        if (
            recipe is not None
            and recipe.get("source") == "moos"
            and self._curated_id_is_valid(app_id, recipe)
        ):
            return self._remove_curated(app_id, recipe, delete_data)
        # An app installed from a file is removable from the Store too, by the id the index gives it.
        slug = self._dropped_slug(app_id)
        if slug is not None:
            return self._remove_dropped(app_id, delete_data, slug)
        # So is a publisher's app the catalogue stopped offering: MoOS's record still names it.
        if self._vendor_record(app_id):
            return self._remove_vendor_record(app_id, delete_data)
        if self._dropped_android(app_id):
            return self._remove_android_record(app_id, delete_data)
        if not validate_flatpak_id(app_id):
            raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
        try:
            lock, job = self._begin("remove", [app_id])
        except BusyError:
            return self._refuse_busy("remove", [app_id])
        with lock:
            try:
                if not self.adapter.is_user_installed(app_id):
                    if self.adapter.is_system_installed(app_id):
                        raise StoreError(
                            "This app is installed system-wide; Mo Store only removes "
                            "user installations"
                        )
                    if delete_data and (Path.home() / ".var" / "app" / app_id).exists():
                        # Gone already, but its data was left behind: the person asked for that too.
                        self._delete_flatpak_data(job, app_id)
                        job.update_item(app_id, state="done", progress=100,
                                        message="Removed with its data",
                                        message_key="removed_with_data")
                    else:
                        job.update_item(
                            app_id,
                            state="skipped",
                            progress=100,
                            message="App is not installed", message_key="not_installed",
                        )
                else:
                    events = TransactionEvents(job, [app_id])
                    self.adapter.remove(
                        app_id, events, lambda: self._cancelled(job)
                    )
                    if delete_data:
                        self._delete_flatpak_data(job, app_id)
                        job.update_item(app_id, state="done", progress=100,
                                        message="Removed with its data",
                                        message_key="removed_with_data")
                    else:
                        job.update_item(
                            app_id, state="done", progress=100, message="Removed",
                            message_key="removed",
                        )
                job.finish_from_items("App removed", "app_removed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    # ── App Drop: an application that arrived as a FILE ────────────────────────
    # The logic is usr/lib/moos/moos_appdrop.py. It runs HERE so that a dropped AppImage is a Mo
    # Store job like any other: one lock, one job document, one progress feed for the Island.
    @staticmethod
    def _appdrop() -> Any:
        return Controller._library("moos_appdrop")

    def inspect_file(self, raw_path: str) -> tuple[int, dict[str, Any]]:
        """Read-only: what this file is and what installing it would do. Writes no job."""
        appdrop = self._appdrop()
        try:
            plan = appdrop.inspect(raw_path)
        except appdrop.DropError as refusal:
            return 2, {"schema": SCHEMA, "action": "inspect-file", "state": "failed",
                       "code": refusal.code, "message": clean_message(refusal.detail or refusal.code)}
        return 0, {"schema": SCHEMA, "action": "inspect-file", "state": "success", "plan": plan.to_json()}

    def install_file(self, raw_path: str) -> tuple[int, dict[str, Any]]:
        appdrop = self._appdrop()
        try:
            plan = appdrop.inspect(raw_path)
        except appdrop.DropError as refusal:
            raise StoreError(f"{refusal.code}: {refusal.detail or refusal.code}") from refusal
        if plan.kind == "flatpakref":
            # A Flathub ref is an app id with a file around it: the ordinary verified path.
            return self.install([plan.flatpak_id])
        if not plan.supported and plan.kind != "android":
            raise StoreError(f"{plan.refusal or 'not_installable_here'}: {plan.kind} files are not installed here")
        try:
            lock, job = self._begin("install", [plan.slug])
        except BusyError:
            return self._refuse_busy("install", [plan.slug])
        with lock:
            code = ""
            try:
                progress = self._appdrop_progress(job, plan.slug)
                if plan.kind == "android":
                    # The same container readiness and the same honest result as a catalogue
                    # install; mutation, locking, cancellation and publication belong here.
                    self._ensure_android_session(job)
                    before = self._android_packages()
                    progress("integrating_app", None)
                    result = self.runner.run_cancellable(
                        ["/usr/bin/waydroid", "app", "install", str(plan.path)],
                        lambda: self._cancelled(job))
                    if result.cancelled:
                        raise appdrop.DropError("cancelled")
                    if result.returncode or re.search(
                        r"\b(?:error|failed)\b", result.reason, re.IGNORECASE
                    ):
                        raise appdrop.DropError("failed", result.reason or "Android installation failed")
                    after = self._android_packages()
                    # The package a file adds is named only inside the file; the container's own
                    # list before and after says which one it was. Anything less certain writes
                    # no record rather than a wrong one.
                    if before is not None and after is not None and len(after - before) == 1:
                        digest = hashlib.sha256()
                        with plan.path.open("rb") as handle:
                            for block in iter(lambda: handle.read(4 * 1024 * 1024), b""):
                                digest.update(block)
                        self._write_android_record((after - before).pop(), sha256=digest.hexdigest(),
                                                   source="file", file_name=plan.path.name[:255])
                else:
                    appdrop.install(plan, progress=progress, cancelled=lambda: self._cancelled(job))
                job.update_item(plan.slug, state="done", progress=100, message="Installed",
                                message_key="installed")
                job.finish_from_items("All requested apps are ready", "all_ready")
            except appdrop.DropError as failure:
                code = failure.code
                if failure.code == "cancelled":
                    job.cancelled()
                else:
                    job.fail(f"{failure.code}: {failure.detail or failure.code}", [plan.slug])
            except CancelledError:
                code = "cancelled"
                job.cancelled()
            except Exception as error:                   # noqa: BLE001 - reported to the person
                job.fail(error, [plan.slug])
            document = job.snapshot()
            if code:
                document["code"] = code                  # a stable key: the dialog owns the words
            return exit_code(job.document["state"]), document

    def remove_file(self, slug: str) -> tuple[int, dict[str, Any]]:
        appdrop = self._appdrop()
        try:
            lock, job = self._begin("remove", [slug])
        except BusyError:
            return self._refuse_busy("remove", [slug])
        with lock:
            try:
                if appdrop.remove(slug):
                    job.update_item(slug, state="done", progress=100, message="Removed",
                                    message_key="removed")
                else:
                    job.update_item(slug, state="skipped", progress=100,
                                    message="App is not installed", message_key="not_installed")
                job.finish_from_items("App removed", "app_removed")
            except appdrop.DropError as failure:
                job.fail(f"{failure.code}: {failure.detail or failure.code}", [slug])
            except Exception as error:                   # noqa: BLE001
                job.fail(error, [slug])
            return exit_code(job.document["state"]), job.snapshot()

    def _run_android(
        self, app_id: str, recipe: dict[str, Any] | None, *, start_android: bool = True
    ) -> tuple[int, dict[str, Any]]:
        # A catalogue entry names its package; a dropped APK's record was written for it.
        package = self._android_package(app_id, recipe) if recipe is not None else app_id
        if not _ANDROID_PACKAGE_RE.fullmatch(package):
            raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
        # A moos: link (any web page can hand the router one) opens an Android app only into
        # support that is already running: starting the whole container is for the person to ask,
        # in Mo Store or of Mo AI. Refused before anything else is asked of the machine.
        if not start_android and not self._android_session_up():
            raise self._android_not_running()
        try:
            lock, job = self._begin("run", [app_id])
        except BusyError:
            # Beside the lock's holder as any app opens (_may_open_beside), and only into a session
            # that is already up: starting one is that job's business (it may be starting it right
            # now), never a race to run beside it.
            if not self._may_open_beside() or not self._android_session_up():
                return self._refuse_busy("run", [app_id])
            lock, job = self._begin_beside("run", [app_id])
            start_android = False
        with lock:
            try:
                job.update_item(
                    app_id, state="running", progress=None,
                    message="Opening app", message_key="opening",
                )
                job.update(
                    state="running", current_id=app_id, progress=None,
                    message="Preparing GPU headroom", message_key="preparing_gpu",
                )
                self.runner.gpu_guard()
                self._ensure_android_session(job, start=start_android)
                result = self.runner.run_cancellable(
                    [WAYDROID, "app", "launch", package],
                    lambda: self._cancelled(job),
                )
                if result.cancelled:
                    raise CancelledError("Cancelled")
                if result.returncode or re.search(
                    r"\b(?:error|failed)\b", result.reason, re.IGNORECASE
                ):
                    raise StoreError(result.reason or "Could not open the application")
                job.update_item(
                    app_id, state="done", progress=100,
                    message="Opened", message_key="opened",
                )
                job.finish_from_items("App opened", "app_opened")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    def _launcher_for(self, app_id: str, kind: str, slug: str | None = None) -> str:
        """The MoOS-written launcher that opens this app, by file name; refused when it is gone."""
        if kind == "windows":
            paths = windows_paths(app_id)
            if paths.record.is_file() and self._windows_launcher_is_ours(paths, app_id):
                return paths.launcher.name
        elif kind == "vendor":
            # org.moos.vendor.<id>.desktop, and only while its folder and record are whole.
            if self._vendor_intact(app_id):
                return self._vendor().launcher_name(app_id)
        else:
            entry = self._appdrop_launcher(slug or app_id)
            if entry is not None:
                return entry.name
        raise StoreError("App is not installed", message_key="not_installed")

    def _appdrop_launcher(self, slug: str) -> Path | None:
        """App Drop's launcher for `slug`, while what it opens is still there.

        The record and the marked launcher are not enough. Deleting ~/Applications/<slug> in the
        file manager is a natural way to remove an app, and the menu's loader (GIO, which
        gtk-launch uses) then refuses the launcher because its TryExec program is gone, while the
        detached gtk-launch was reported as "opened". As for a publisher's app (_vendor_intact),
        the app's folder and the launcher's program must both still be there.
        """
        appdrop = self._appdrop()
        entry = appdrop.launcher_path(slug)
        folder = appdrop.applications_dir() / slug
        if entry is None or folder.is_symlink() or not folder.is_dir():
            return None
        try:
            with entry.open("rb") as handle:
                text = handle.read(65536).decode("utf-8", "replace")
        except OSError:
            return None
        program = parse_keyfile(text).get("Desktop Entry", {}).get("TryExec", "")
        if program:
            found = program if os.path.isabs(program) else shutil.which(program)
            if not found or not os.path.isfile(found) or not os.access(found, os.X_OK):
                return None
        return entry

    def _run_installed(self, app_id: str, kind: str, slug: str | None = None) -> tuple[int, dict[str, Any]]:
        """Open a web app, an App Drop app, a Windows program or a publisher's own app the way
        its launcher would."""
        try:
            lock, job = self._begin_run(app_id)
        except BusyError:
            return self._refuse_busy("run", [app_id])
        with lock:
            try:
                if kind == "webapp":
                    if not self._webapp_policy().is_installed(app_id):
                        raise StoreError("App is not installed", message_key="not_installed")
                    argv = [WEBAPP_RUNTIME, app_id]
                else:
                    argv = [GTK_LAUNCH, self._launcher_for(app_id, kind, slug)]
                job.update_item(app_id, state="running", progress=None, message="Opening app",
                                message_key="opening")
                job.update(state="running", current_id=app_id, progress=None,
                           message="Preparing GPU headroom", message_key="preparing_gpu")
                self.runner.gpu_guard()
                self.runner.spawn(argv)
                job.update_item(app_id, state="done", progress=100, message="Opened",
                                message_key="opened")
                job.finish_from_items("App opened", "app_opened")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    def run(self, app_id: str, start_android: bool = True) -> tuple[int, dict[str, Any]]:
        """Open an installed app of any kind. `start_android` false (`--no-android-start`, what a
        moos: link asks for) opens an Android app only into Android app support already running."""
        recipe = self._catalog().get(app_id)
        if (
            recipe is not None
            and recipe.get("source") == "moos"
            and isinstance(recipe.get("install"), dict)
            and self._curated_id_is_valid(app_id, recipe)
        ):
            kind = recipe["install"].get("kind")
            if kind == "android":
                return self._run_android(app_id, recipe, start_android=start_android)
            if kind == "webapp":
                return self._run_installed(app_id, "webapp")
            if kind == "appdrop":
                return self._run_installed(app_id, "appdrop")
            if kind == "windows-portable":
                return self._run_installed(app_id, "windows")
            if kind == "vendor-rpm":
                return self._run_installed(app_id, "vendor")
            if kind == "npm":
                # A command-line tool has no window. Installed, it is said to be one; missing, it is
                # not installed: "not installed" for a tool that is there was the false answer.
                binary = recipe["install"].get("bin")
                if not isinstance(binary, str) or not _BIN_RE.fullmatch(binary):
                    raise StoreError(f"Catalog has an invalid npm executable for {app_id}")
                if not (Path.home() / ".local" / "bin" / binary).exists():
                    raise StoreError("App is not installed", message_key="not_installed")
                raise StoreError(f"{app_id} is a command-line tool: it has no window to open; run it "
                                 "in a terminal", message_key="unsupported_kind")
            raise StoreError(f"Mo Store cannot open {app_id}", message_key="unsupported_kind")
        slug = self._dropped_slug(app_id)
        if slug is not None:
            return self._run_installed(app_id, "appdrop", slug)
        if self._vendor_record(app_id):
            return self._run_installed(app_id, "vendor")
        if self._dropped_android(app_id):
            return self._run_android(app_id, None, start_android=start_android)
        if not validate_flatpak_id(app_id):
            raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
        try:
            lock, job = self._begin_run(app_id)
        except BusyError:
            return self._refuse_busy("run", [app_id])
        with lock:
            try:
                if not (
                    self.adapter.is_user_installed(app_id)
                    or self.adapter.is_system_installed(app_id)
                ):
                    raise StoreError("App is not installed as a Flatpak", message_key="not_installed")
                job.update_item(
                    app_id, state="running", progress=None, message="Opening app",
                    message_key="opening"
                )
                job.update(
                    state="running",
                    current_id=app_id,
                    progress=None,
                    message="Preparing GPU headroom", message_key="preparing_gpu",
                )
                self.runner.gpu_guard()
                self.adapter.launch(app_id)
                job.update_item(
                    app_id, state="done", progress=100, message="Opened",
                    message_key="opened"
                )
                job.finish_from_items("App opened", "app_opened")
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    # ── Updates: Flatpaks and catalogue pins together ──────────────────────────────────────────
    def _pinned_record(self, app_id: str, recipe: dict[str, Any]) -> dict[str, Any]:
        """What the Store installed of a pinned catalogue app, as its record says; {} when nothing.

        check-updates, Update all and `update <id>` share this rule, and moos-store-index's
        update_available has to give the same answer, or the app page and the Updates page
        disagree (docs/MO_STORE.md):
          appdrop  only a record naming this catalogue id is the Store's own install. A file the
                   person dropped into the app's slot has no catalog_id (the index calls it
                   adopted); it is theirs, and the pin, which may be older, never replaces it.
          windows  the record, while the program's folder is there.
          android  installed while Android keeps the package's data directory. An APK the person
                   installed from a file has a record without catalog_id: adopted, like a dropped
                   file. An app an earlier Mo Store installed has no record (it wrote none) and
                   is returned without one; moos_android_apk.pin_is_update() then decides from
                   the APK Android keeps (_pin_update_row).
        """
        kind = (recipe.get("install") or {}).get("kind")
        if kind == "appdrop":
            record = self._appdrop().read_record(app_id)
            return record if record.get("catalog_id") == app_id else {}
        if kind == "windows-portable":
            paths = windows_paths(app_id)
            return _read_json(paths.record) if paths.app.is_dir() else {}
        if kind == "android":
            if not (data_home() / "waydroid" / "data" / "data" / app_id).is_dir():
                return {}
            record = _read_json(android_record_path(app_id))
            if record and record.get("catalog_id") != app_id:
                return {}
            return record or {"id": app_id, "package": app_id}
        if kind == "vendor-rpm":
            return self._vendor_record(app_id)
        return {}

    def _adopted(self, app_id: str, recipe: dict[str, Any]) -> bool:
        """An app the person installed from a file into this catalogue app's place: App Drop's
        record, or the record install-file wrote for an APK, with no catalog_id. It is theirs: a
        newer file updates it, and the pin never replaces it."""
        kind = (recipe.get("install") or {}).get("kind")
        if kind == "appdrop":
            record = self._appdrop().read_record(app_id)
        elif kind == "android" and (data_home() / "waydroid" / "data" / "data" / app_id).is_dir():
            record = _read_json(android_record_path(app_id))
        else:
            return False
        return bool(record) and not record.get("catalog_id")

    @staticmethod
    def _android_apk() -> Any:
        """usr/lib/moos/moos_android_apk.py: what the APK Android keeps says, and the one update
        rule moos-store-index shares."""
        return Controller._library("moos_android_apk")

    def _android_kept(self, package: str, pin: PinnedArtifact) -> Any:
        """The one APK Android keeps for `package` (moos_android_apk.ApkFacts), read through no
        link, its digest only at the pin's size; None when that cannot be read."""
        return self._android_apk().kept(data_home() / "waydroid" / "data", package, pin.size,
                                        unsized_limit=UNSIZED_DOWNLOAD_CAP)

    def _android_keeps_pin(self, package: str, pin: PinnedArtifact) -> bool | None:
        """True when the one APK Android keeps for `package` is the pin byte for byte; False for
        another build, two copies or none; None when Android's app folder cannot be read."""
        apk = self._android_apk()
        folders = apk.kept_apk_dirs(data_home() / "waydroid" / "data", package)
        if folders is None:
            return None
        if len(folders) != 1:
            return False
        facts = apk.read_apk(folders[0] / "base.apk", pin.size, unsized_limit=UNSIZED_DOWNLOAD_CAP)
        return facts is not None and facts.sha256 == pin.sha256

    def _android_update_landed(self, job: Job, app_id: str, recipe: dict[str, Any],
                               before: bytes | None) -> None:
        """Hold an Android update to what Android keeps after it.

        waydroid's `app install` exits 0 when Android refuses the APK (signed by another key,
        made for a newer Android, older than the build it keeps): its install() drops the
        container's answer. _install_pinned_android then records the pin and says Installed. So an
        update reads back the APK Android keeps: the pin is an update done; anything else puts the
        record back as it was (`before`, None when there was none) and fails in words the window
        can say. When Android's app folder cannot be read (another account owns it), waydroid's
        exit status is all there is to go by, as before.
        """
        package = self._android_package(app_id, recipe)
        pin = pinned_artifact(app_id, recipe.get("install") or {}, size_required=False)
        kept = self._android_keeps_pin(package, pin)
        if kept is False:
            # Not yet, or not at all: the item is not done while Android is asked again.
            job.update_item(app_id, state="running", progress=None,
                            message="Installing application", message_key="integrating_app")
            deadline = time.monotonic() + ANDROID_READBACK_SECONDS
            while kept is False and time.monotonic() < deadline:
                time.sleep(ANDROID_READBACK_STEP)
                kept = self._android_keeps_pin(package, pin)
        if kept is not False:
            return
        record = android_record_path(package)
        if before is None:
            record.unlink(missing_ok=True)
        else:
            _atomic_bytes(record, before)
        reason = "Android did not accept this update; the app was left as it was"
        job.update_item(app_id, state="failed", progress=None, message=reason,
                        message_key="android_update_refused")
        raise StoreError(reason, message_key="android_update_refused")

    def _vendor_update_row(self, app_id: str, recipe: dict[str, Any],
                           record: dict[str, Any]) -> dict[str, Any] | None:
        """A vendor app pins no bytes: its publisher's repository names the newest build, asked
        over the network. Offline, refused or slow is no row, never a failed check."""
        info = self._vendor_newest(app_id, recipe)
        if info is None:
            return None
        vendor = self._vendor()
        try:
            if not vendor.update_available(app_id, info):
                return None
        except vendor.VendorError:
            return None
        def readable(build: dict[str, Any]) -> str:
            # version-release, as the index shows an installed build; the epoch is not for people.
            version, release = str(build.get("version") or ""), str(build.get("release") or "")
            return f"{version}-{release}" if release else version

        return {"id": app_id, "kind": "pin", "name": display_text(recipe.get("en"), 80) or app_id,
                "version": readable(info), "installed_version": readable(record)}

    def _pin_update_row(self, app_id: str, recipe: dict[str, Any]) -> dict[str, Any] | None:
        """An update row when the installed bytes differ from what the catalogue now pins.

        For Android, "differ" is what Android itself would take as an update of the APK it keeps
        (moos_android_apk.pin_is_update()): never an older build than that one, never one signed
        by another key, and nothing for an app without a record of the Store's whose APK cannot
        be read.
        """
        install = recipe.get("install")
        if not isinstance(install, dict) or install.get("kind") not in (
                "appdrop", "windows-portable", "android", "vendor-rpm"):
            return None
        record = self._pinned_record(app_id, recipe)
        if not record:
            return None
        if install.get("kind") == "vendor-rpm":
            return self._vendor_update_row(app_id, recipe, record)
        try:
            pin = pinned_artifact(app_id, install, size_required=install.get("kind") != "android")
        except StoreError:
            return None
        installed = record.get("version") if isinstance(record.get("version"), str) else None
        if install.get("kind") == "android":
            apk = self._android_apk()
            kept = self._android_kept(app_id, pin)
            if not apk.pin_is_update(pin_sha256=pin.sha256,
                                     pin_code=apk.pin_version_code(pin.url, app_id),
                                     pin_signer=install.get("signer"), kept=kept,
                                     recorded_sha256=record.get("sha256")):
                return None
            # What Android keeps is the version installed, whoever put it there.
            installed = (display_text(kept.version_name, 64) if kept is not None else "") \
                or installed
        elif str(record.get("sha256", "")).lower() == pin.sha256:
            return None
        version = install.get("version") if isinstance(install.get("version"), str) else None
        return {"id": app_id, "kind": "pin", "name": display_text(recipe.get("en"), 80) or app_id,
                "version": version, "installed_version": installed or None}

    def _pin_update_rows(self) -> list[tuple[dict[str, Any], dict[str, Any]]]:
        """(row, recipe) for every pinned app with a newer pin. Never raises: it is advisory."""
        try:
            catalog = self._catalog()
        except StoreError:
            return []
        rows = []
        for app_id, recipe in catalog.items():
            if recipe.get("source") != "moos" or not self._curated_id_is_valid(app_id, recipe):
                continue
            try:
                row = self._pin_update_row(app_id, recipe)
            except (StoreError, OSError):
                row = None
            if row is not None:
                rows.append((row, recipe))
        rows.sort(key=lambda pair: pair[0]["name"].casefold())
        return rows

    def _reinstall_pin(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        kind = (recipe.get("install") or {}).get("kind")
        if kind == "appdrop":
            self._install_appdrop(job, app_id, recipe)
        elif kind == "windows-portable":
            self._install_windows_portable(job, app_id, recipe)
        elif kind == "android":
            # In place: Android keeps the app's data. Its answer is read back before Updated.
            record = android_record_path(self._android_package(app_id, recipe))
            try:
                before = record.read_bytes()
            except FileNotFoundError:
                before = None
            self._install_pinned_android(job, app_id, recipe)
            self._android_update_landed(job, app_id, recipe, before)
        elif kind == "vendor-rpm":
            # Resolved again inside the job: the publisher may have moved on since the check.
            if not self._install_vendor(job, app_id, recipe):
                job.update_item(app_id, state="skipped", progress=100,
                                message="This app is up to date", message_key="app_up_to_date")
                return
        else:
            raise StoreError(f"Mo Store cannot update {app_id}", message_key="unsupported_kind")
        job.update_item(app_id, state="done", progress=100, message="Updated", message_key="updated")

    def check_updates(self) -> tuple[int, dict[str, Any]]:
        """Report what `update` would act on, changing nothing.

        Deliberately takes NO global lock and never touches job.json: it must
        stay answerable while an install is running, and the UI correlates
        job.json against a request it made.  A failure here is reported in the
        document rather than raised, so an offline machine gets an honest "could
        not check" instead of a Store that looks broken.  Catalogue pins whose
        installed bytes differ from the pin are listed beside the Flatpaks, and
        the owner's automatic-update choice rides along for the Updates page.
        """

        now = utc_now()
        pins = [row for row, _recipe in self._pin_update_rows()]
        document: dict[str, Any] = {
            "schema": SCHEMA,
            "action": "check-updates",
            "state": "success",
            "checked_at": now,
            "count": len(pins),
            "app_count": len(pins),
            "items": pins,
            "message": "Apps are up to date",
            "auto_updates": auto_updates_enabled(),
        }
        try:
            candidates = self.adapter.update_candidates()
        except StoreError as error:
            document["state"] = "failed"
            document["message"] = clean_message(error)
            self.store.prepare()
            self.store.write_updates(document)
            return 2, document
        apps = [item for item in candidates if item["kind"] == "app"]
        document["items"] = candidates + pins
        document["count"] = len(candidates) + len(pins)
        document["app_count"] = len(apps) + len(pins)
        if document["items"]:
            document["message"] = (
                f"{document['app_count']} app update(s) available"
                if document["app_count"]
                else f"{len(candidates)} component update(s) available"
            )
        self.store.prepare()
        self.store.write_updates(document)
        return 0, document

    def update(self, app_id: str | None = None) -> tuple[int, dict[str, Any]]:
        if app_id is not None:
            return self._update_one(app_id)
        try:
            lock, job = self._begin("update", [])
        except BusyError:
            return self._refuse_busy("update", [])
        with lock:
            try:
                refs = self.adapter.update_refs()
                pins = self._pin_update_rows()
                if not refs and not pins:
                    job.update(
                        state="success",
                        progress=100,
                        current_id=None,
                        message="Apps are up to date", message_key="up_to_date",
                    )
                else:
                    # The update list is discovered after job creation.  Rebuild the
                    # exact schema before the transaction starts.
                    names = dedupe(name for name, _ref in refs)
                    pin_ids = [row["id"] for row, _recipe in pins if row["id"] not in names]
                    job.replace_items([*names, *pin_ids])
                    if refs:
                        events = TransactionEvents(job, names)
                        try:
                            self.adapter.update_many(
                                refs, events, lambda: self._cancelled(job)
                            )
                            for name in names:
                                if job._items[name]["state"] in {"queued", "running"}:
                                    job.update_item(
                                        name,
                                        state="done",
                                        progress=100,
                                        message="Updated",
                                        message_key="updated",
                                    )
                        except CancelledError:
                            raise
                        except StoreError as error:
                            # One failed transaction must not cost the pinned apps their turn.
                            for name in names:
                                if job._items[name]["state"] in {"queued", "running"}:
                                    job.update_item(name, state="failed", progress=None,
                                                    message=clean_message(error), message_key=None)
                    for row, recipe in pins:
                        if row["id"] not in pin_ids:
                            continue
                        if self._cancelled(job):
                            raise CancelledError("Cancelled")
                        try:
                            self._reinstall_pin(job, row["id"], recipe)
                        except CancelledError:
                            raise
                        except Exception as error:      # noqa: BLE001 - one app's failure
                            job.update_item(row["id"], state="failed", progress=None,
                                            message=clean_message(error),
                                            message_key=getattr(error, "message_key", None))
                    job.finish_from_items("Apps updated", "apps_updated")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error)
            return exit_code(job.document["state"]), job.snapshot()

    def _update_one(self, app_id: str) -> tuple[int, dict[str, Any]]:
        """Update one app of any kind; an app with nothing newer says so instead of failing."""
        recipe = self._catalog().get(app_id)
        curated = (recipe is not None and recipe.get("source") == "moos"
                   and self._curated_id_is_valid(app_id, recipe))
        kind = (recipe.get("install") or {}).get("kind") if curated else None
        if curated and kind not in ("appdrop", "windows-portable", "android", "webapp", "npm",
                                    "vendor-rpm"):
            raise StoreError(f"Mo Store cannot update {app_id}", message_key="unsupported_kind")
        if not curated:
            if self._dropped_slug(app_id) is not None:
                raise StoreError("This app was installed from a file; install a newer file of it to update it",
                                 message_key="update_by_file")
            if self._vendor_record(app_id):
                # Without its catalogue entry there is no reviewed repository to ask.
                raise StoreError("Mo Store no longer offers this app, so it cannot update it; it can be removed",
                                 message_key="unsupported_kind")
            if not validate_flatpak_id(app_id):
                raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")
        try:
            lock, job = self._begin("update", [app_id])
        except BusyError:
            return self._refuse_busy("update", [app_id])
        with lock:
            try:
                if curated:
                    self._update_curated(job, app_id, recipe)
                else:
                    self._update_flatpak(job, app_id)
                job.finish_from_items("Apps updated", "apps_updated")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    def _update_curated(self, job: Job, app_id: str, recipe: dict[str, Any]) -> None:
        install = recipe.get("install") or {}
        kind = install.get("kind")
        if kind == "webapp":
            if not self._webapp_policy().is_installed(app_id):
                raise StoreError("App is not installed", message_key="not_installed")
            # A web app is always the publisher's current site; refreshing its launcher is the update.
            self._webapp_policy().install(self._webapp(app_id, recipe))
            job.update_item(app_id, state="done", progress=100, message="Updated",
                            message_key="updated")
            return
        if kind == "npm":
            binary = install.get("bin")
            if not isinstance(binary, str) or not _BIN_RE.fullmatch(binary):
                raise StoreError(f"Catalog has an invalid npm executable for {app_id}")
            if not (Path.home() / ".local" / "bin" / binary).exists():
                raise StoreError("App is not installed", message_key="not_installed")
            self._install_npm(job, app_id, recipe)
            job.update_item(app_id, state="done", progress=100, message="Updated",
                            message_key="updated")
            return
        if not self._pinned_record(app_id, recipe):
            if self._adopted(app_id, recipe):
                # The person's own file in this app's place: a newer file updates it, never the pin.
                raise StoreError("This app was installed from a file; install a newer file of it to update it",
                                 message_key="update_by_file")
            raise StoreError("App is not installed", message_key="not_installed")
        if kind == "vendor-rpm":
            # One resolve inside the job decides; the module swaps the new build in atomically.
            self._reinstall_pin(job, app_id, recipe)
            return
        if self._pin_update_row(app_id, recipe) is None:
            job.update_item(app_id, state="skipped", progress=100, message="This app is up to date",
                            message_key="app_up_to_date")
            return
        self._reinstall_pin(job, app_id, recipe)

    def _update_flatpak(self, job: Job, app_id: str) -> None:
        refs = [(name, ref) for name, ref in self.adapter.update_refs() if name == app_id]
        if not refs:
            if self.adapter.is_user_installed(app_id):
                job.update_item(app_id, state="skipped", progress=100,
                                message="This app is up to date", message_key="app_up_to_date")
                return
            if self.adapter.is_system_installed(app_id):
                raise StoreError("This app is installed system-wide; Mo Store updates only your own apps")
            raise StoreError("App is not installed", message_key="not_installed")
        events = TransactionEvents(job, [app_id])
        self.adapter.update_many(refs, events, lambda: self._cancelled(job))
        if job._items[app_id]["state"] in {"queued", "running"}:
            job.update_item(app_id, state="done", progress=100, message="Updated",
                            message_key="updated")

    def refresh_index(self) -> tuple[int, dict[str, Any]]:
        item_id = "flathub"
        try:
            lock, job = self._begin("refresh-index", [item_id])
        except BusyError:
            return self._refuse_busy("refresh-index", [item_id])
        with lock:
            try:
                events = TransactionEvents(job, [item_id])
                self.adapter.refresh_index(
                    events, lambda: self._cancelled(job)
                )
                job.update_item(
                    item_id,
                    state="running",
                    progress=None,
                    message="Rebuilding the unified app index", message_key="refreshing_index",
                )
                job.update(
                    state="running",
                    progress=None,
                    current_id=item_id,
                    message="Rebuilding the unified app index", message_key="refreshing_index",
                )
                result = self.runner.run_cancellable(
                    [
                        STORE_INDEX,
                        "--catalog",
                        str(self.catalog_path),
                        "--output",
                        str(self.store.directory / "index.json"),
                    ],
                    lambda: self._cancelled(job),
                )
                if result.cancelled:
                    raise CancelledError("Cancelled")
                if result.returncode:
                    raise StoreError(
                        result.reason
                        or f"App indexer exited with {result.returncode}"
                    )
                job.update_item(
                    item_id, state="done", progress=100, message="Index refreshed",
                    message_key="index_refreshed"
                )
                job.finish_from_items("App index refreshed", "index_refreshed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error)
            return exit_code(job.document["state"]), job.snapshot()

    def open_engine(self, name: str) -> tuple[int, dict[str, Any]]:
        command = ENGINE_COMMANDS.get(name)
        if command is None:
            raise StoreError(f"Unknown engine: {name}")
        try:
            lock, job = self._begin("open-engine", [name])
        except BusyError:
            return self._refuse_busy("open-engine", [name])
        with lock:
            try:
                job.update_item(
                    name, state="running", progress=None, message="Opening",
                    message_key="opening"
                )
                job.update(
                    state="running",
                    progress=None,
                    current_id=name,
                    message=f"Opening {name}",
                    message_key=None,
                )
                if name == "bazaar":
                    if not (
                        self.adapter.is_user_installed(BAZAAR_ID)
                        or self.adapter.is_system_installed(BAZAAR_ID)
                    ):
                        events = TransactionEvents(job, [BAZAAR_ID])
                        self.adapter.install_many(
                            [BAZAAR_ID],
                            events,
                            lambda: self._cancelled(job),
                        )
                    hidden = self.runner.run_cancellable(
                        [ONE_STORE], lambda: self._cancelled(job)
                    )
                    if hidden.cancelled:
                        raise CancelledError("Cancelled")
                    if hidden.returncode:
                        raise StoreError(
                            hidden.reason
                            or "Could not prepare the optional Bazaar engine"
                        )
                    self.adapter.launch(BAZAAR_ID)
                elif name == "permissions" and not (
                    self.adapter.is_user_installed("com.github.tchx84.Flatseal")
                    or self.adapter.is_system_installed("com.github.tchx84.Flatseal")
                ):
                    raise StoreError(
                        "Flatseal is not installed; install it from Mo Store first"
                    )
                else:
                    self.runner.spawn(command)
                job.update_item(
                    name, state="opened", progress=100, message="Opened",
                    message_key="opened"
                )
                job.finish_from_items(f"Opened {name}")
            except Exception as error:
                job.fail(error, [name])
            return exit_code(job.document["state"]), job.snapshot()

    # ── Permissions: what an app may do, and the person's changes to it ────────────────────────
    def _permission_subject(self, app_id: str) -> tuple[str, dict[str, Any] | None]:
        """(kind, recipe) for an app whose permissions Mo Store can describe."""
        recipe = self._catalog().get(app_id)
        if recipe is not None and recipe.get("source") == "moos" and self._curated_id_is_valid(app_id, recipe):
            kind = (recipe.get("install") or {}).get("kind")
            return ("webapp" if kind == "webapp" else "android" if kind == "android"
                    else "unsandboxed"), recipe
        if self._dropped_slug(app_id) is not None:
            return "unsandboxed", None
        if self._vendor_record(app_id):
            return "unsandboxed", None
        if validate_flatpak_id(app_id):
            return "flatpak", recipe
        if _ANDROID_PACKAGE_RE.fullmatch(app_id) and android_record_path(app_id).is_file():
            return "android", None
        raise StoreError(f"Invalid app ID: {app_id}", message_key="invalid_id")

    def _flatpak_scope(self, app_id: str) -> list[str] | None:
        """--user or --system for the installation that holds the app; None when neither does."""
        try:
            if self.adapter.is_user_installed(app_id):
                return ["--user"]
            if self.adapter.is_system_installed(app_id):
                return ["--system"]
        except StoreError:
            return []
        return None

    def _permission_document(self, app_id: str) -> dict[str, Any]:
        kind, recipe = self._permission_subject(app_id)
        document: dict[str, Any] = {"schema": 1, "id": app_id, "kind": kind, "generated_at": utc_now()}
        if kind == "flatpak":
            scope = self._flatpak_scope(app_id)
            shown = self.runner.capture(
                [FLATPAK_CLI, "info", *(scope or []), "--show-permissions", app_id], timeout=30
            ) if scope is not None else None
            if shown is None or shown.returncode:
                document.update(sandboxed=True, installed=False, rows=[], note_key="not_installed")
                return document
            portal = self.runner.capture([FLATPAK_CLI, "permission-show", app_id], timeout=30)
            background = background_answer(portal.output, app_id) if portal.returncode == 0 else None
            document.update(sandboxed=True, installed=True,
                            rows=flatpak_permission_rows(shown.output, background))
            return document
        if kind == "webapp":
            policy = self._webapp_policy()
            app = self._webapp(app_id, recipe or {})
            store = policy.PermissionStore(app, policy.paths(app_id).permissions)
            rows = []
            for name in app.permissions:
                decision = store.decision(name)
                # Unanswered is not granted: the app asks the person the first time it needs it.
                rows.append({"key": name, "state": "allow" if decision == "allow" else "deny",
                             "changeable": True, "ask": decision == "ask"})
            document.update(sandboxed=True, installed=policy.is_installed(app_id), rows=rows)
            return document
        if kind == "android":
            # Each Android app's permissions live in its own Android settings, inside the container.
            document.update(sandboxed=True, rows=[], note_key="android_managed")
            return document
        # App Drop, Windows programs, publishers' own packages, npm tools and publisher downloads
        # run as the person, honestly.
        document.update(sandboxed=False, rows=[], note_key="full_access")
        return document

    def _publish_permissions(self, app_id: str) -> dict[str, Any]:
        document = self._permission_document(app_id)
        _write_json(self.store.directory / "permissions" / f"{app_id}.json", document)
        return document

    def permissions(self, app_id: str) -> tuple[int, dict[str, Any]]:
        """Read-only, no lock: ~/.cache/moos-store/permissions/<id>.json for the app's page."""
        self.store.prepare()
        return 0, self._publish_permissions(app_id)

    def set_permission(self, app_id: str, key: str, value: str) -> tuple[int, dict[str, Any]]:
        """Change one permission through a fixed command per key, as a job the window can follow."""
        kind, recipe = self._permission_subject(app_id)
        if value not in PERMISSION_VALUES:
            raise StoreError(f"Unknown permission value: {value}", message_key="invalid_permission")
        if kind == "flatpak":
            if key not in FLATPAK_PERMISSION_KEYS:
                raise StoreError(f"Unknown permission: {key}", message_key="invalid_permission")
        elif kind == "webapp":
            if key not in self._webapp(app_id, recipe or {}).permissions:
                raise StoreError(f"{app_id} does not use {key}", message_key="invalid_permission")
        else:
            raise StoreError(f"Mo Store cannot change permissions of {app_id}",
                             message_key="unsupported_kind")
        try:
            lock, job = self._begin("set-permission", [app_id])
        except BusyError:
            return self._refuse_busy("set-permission", [app_id])
        with lock:
            try:
                job.update_item(app_id, state="running", progress=None, message="Changing permissions",
                                message_key=None)
                if kind == "flatpak":
                    self._set_flatpak_permission(job, app_id, key, value)
                else:
                    policy = self._webapp_policy()
                    app = self._webapp(app_id, recipe or {})
                    policy.PermissionStore(app, policy.paths(app_id).permissions).set(
                        key, None if value == "reset" else value)
                self._publish_permissions(app_id)
                if value == "reset":
                    job.update_item(app_id, state="done", progress=100, message="Permissions reset",
                                    message_key="permissions_reset")
                    job.finish_from_items("Permissions reset", "permissions_reset")
                else:
                    job.update_item(app_id, state="done", progress=100, message="Permission changed",
                                    message_key="permission_changed")
                    job.finish_from_items("Permission changed", "permission_changed")
            except CancelledError:
                job.cancelled()
            except Exception as error:
                job.fail(error, [app_id])
            return exit_code(job.document["state"]), job.snapshot()

    def _set_flatpak_permission(self, job: Job, app_id: str, key: str, value: str) -> None:
        if not self._flatpak_scope(app_id):
            raise StoreError("App is not installed", message_key="not_installed")
        failure = "Could not change the app's permission"
        if value == "reset":
            self._run_step(job, [FLATPAK_CLI, "override", "--user", "--reset", app_id], failure)
            self._run_step(job, [FLATPAK_CLI, "permission-reset", app_id], failure)
        elif key == "background":
            self._run_step(job, [FLATPAK_CLI, "permission-set", "background", "background", app_id,
                                 "yes" if value == "allow" else "no"], failure)
        else:
            allow, deny = FLATPAK_OVERRIDES[key]
            self._run_step(job, [FLATPAK_CLI, "override", "--user",
                                 allow if value == "allow" else deny, app_id], failure)

    # ── Facts and settings ──────────────────────────────────────────────────────────────────────
    def facts(self) -> tuple[int, dict[str, Any]]:
        """Read-only, no lock, no network: facts.json from the cached Flathub summary."""
        document: dict[str, Any] = {"schema": 1, "generated_at": utc_now(), "state": "success",
                                    "apps": {}}
        code = 0
        try:
            document["apps"] = self.adapter.remote_facts()
        except StoreError as error:
            document["state"] = "failed"
            document["message"] = clean_message(error)
            code = 2
        self.store.prepare()
        _write_json(self.store.directory / "facts.json", document)
        summary = {key: value for key, value in document.items() if key != "apps"}
        summary.update(action="facts", count=len(document["apps"]))
        return code, summary

    def set_auto_updates(self, enabled: bool) -> tuple[int, dict[str, Any]]:
        """The owner's choice for the scheduled updater; a setting, so it waits for no job."""
        path = store_settings_path()
        document = _read_json(path)
        document.update(schema=1, auto_updates=enabled)
        _write_json(path, document, 0o600, private_parent=False)
        return 0, {"schema": SCHEMA, "action": "auto-updates", "state": "success",
                   "auto_updates": enabled}

    def cancel(self, requested_job_id: str | None) -> tuple[int, dict[str, Any]]:
        current = self.store.read()
        if not current or not isinstance(current.get("job_id"), str):
            raise StoreError("There is no active Mo Store job")
        job_id = requested_job_id or current["job_id"]
        if job_id != current["job_id"]:
            raise StoreError("Job ID does not match the active Mo Store job")
        if current.get("state") not in {"starting", "running"}:
            return 0, current
        self.store.request_cancel(job_id)
        response = json.loads(json.dumps(current))
        response["action"] = "cancel"
        response["message"] = "Cancellation requested"
        response["updated_at"] = utc_now()
        return 0, response


def exit_code(state: str) -> int:
    if state == "success":
        return 0
    if state == "cancelled":
        return 130
    if state == "busy":
        return 75
    return 1


def _parse_time(value: object) -> float | None:
    if not isinstance(value, str):
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def reports_live_job(document: dict[str, Any] | None) -> bool:
    """A job another process is still reporting in: starting or running, and written within the
    window's own 120 s staleness rule."""
    if not document or document.get("state") not in {"starting", "running"}:
        return False
    updated = _parse_time(document.get("updated_at"))
    return updated is not None and time.time() - updated < 120


def publish_refusal(store: JobStore, document: dict[str, Any]) -> bool:
    """Publish a job that never started as a terminal job document, so the window can say why.

    The window starts moos-storectl detached and cannot read its output; until this existed an
    invalid id or a busy refusal reached the person as "the operation did not start". It is
    never written over a live job another process is still reporting in (reports_live_job):
    that job's window keeps its document.
    """
    if reports_live_job(store.read()):
        return False
    try:
        store.prepare()
        store.write(document)
    except OSError:
        return False
    return True


# Commands whose refusals the window waits for in job.json, and the ids it expects there.
JOB_COMMANDS = {"install", "remove", "run", "update", "refresh-index", "open-engine",
                "set-permission", "remove-file"}


def refusal_document(command: str, item_ids: Sequence[str], error: StoreError) -> dict[str, Any]:
    now = utc_now()
    message = clean_message(error)
    key = getattr(error, "message_key", None)
    document: dict[str, Any] = {
        "schema": SCHEMA,
        "job_id": secrets.token_hex(16),
        "action": "remove" if command == "remove-file" else command,
        "state": "failed",
        "progress": None,
        "current_id": None,
        "message": message,
        "items": [
            {"id": item_id, "state": "failed", "progress": None, "message": message,
             "message_key": key}
            for item_id in item_ids
        ],
        "started_at": now,
        "updated_at": now,
    }
    document["message_key"] = key
    return document


def requested_ids(options: argparse.Namespace) -> list[str]:
    """The ids a refused command named, as the window expects them back in job.json."""
    if options.command == "install":
        return [value[:255] for value in dedupe(options.ids)][:MAX_BATCH]
    if options.command == "refresh-index":
        return ["flathub"]
    if options.command == "open-engine":
        return [options.name]
    value = getattr(options, "id", None)
    return [value[:255]] if isinstance(value, str) else []


def extract_catalog_argument(argv: Sequence[str]) -> tuple[list[str], Path]:
    """Accept --catalog before or after the subcommand without widening the API."""

    result: list[str] = []
    catalog: str | None = None
    index = 0
    while index < len(argv):
        value = argv[index]
        if value == "--catalog":
            if catalog is not None or index + 1 >= len(argv):
                raise StoreError("--catalog requires exactly one path")
            catalog = argv[index + 1]
            index += 2
            continue
        if value.startswith("--catalog="):
            if catalog is not None:
                raise StoreError("--catalog may be specified only once")
            catalog = value.split("=", 1)[1]
            index += 1
            continue
        result.append(value)
        index += 1
    path = Path(catalog) if catalog is not None else DEFAULT_CATALOG
    return result, path


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="moos-storectl",
        description="Trusted non-interactive backend for Mo Store",
    )
    commands = result.add_subparsers(dest="command", required=True)
    install = commands.add_parser("install", help="install one or more apps")
    install.add_argument("ids", nargs="+")
    remove = commands.add_parser("remove", help="remove a user app")
    remove.add_argument(
        "--delete-data", action="store_true",
        help="also delete the app's own data and the permissions changed for it")
    remove.add_argument("id")
    run = commands.add_parser("run", help="run an installed app")
    run.add_argument(
        "--no-android-start", action="store_true",
        help="open an Android app only into Android app support that is already running "
             "(a moos: link may not start it)")
    run.add_argument("id")
    update = commands.add_parser(
        "update", help="update user Flatpaks and catalogue apps, or one app by id")
    update.add_argument("id", nargs="?")
    commands.add_parser(
        "check-updates", help="report pending updates without changing anything"
    )
    permissions = commands.add_parser(
        "permissions", help="describe what an app may do; changes nothing")
    permissions.add_argument("id")
    set_permission = commands.add_parser(
        "set-permission", help="allow, deny or reset one permission of an app")
    set_permission.add_argument("id")
    set_permission.add_argument("key")
    set_permission.add_argument("value")
    commands.add_parser(
        "facts", help="describe every Flathub app from the cached summary; no network")
    auto_updates = commands.add_parser(
        "auto-updates", help="turn the scheduled app updates on or off")
    auto_updates.add_argument("state", choices=("on", "off"))
    commands.add_parser("refresh-index", help="refresh the Flathub app index")
    engine = commands.add_parser("open-engine", help="open a store engine")
    engine.add_argument("name", choices=tuple(ENGINE_COMMANDS))
    cancel = commands.add_parser("cancel", help="cancel the active job")
    cancel.add_argument("job_id", nargs="?")
    install_file = commands.add_parser(
        "install-file", help="install an AppImage, a portable archive or a Flathub ref from a file")
    install_file.add_argument("path")
    inspect_file = commands.add_parser(
        "inspect-file", help="report what a file is and what installing it would do; changes nothing")
    inspect_file.add_argument("path")
    remove_file = commands.add_parser("remove-file", help="remove an app that install-file installed")
    remove_file.add_argument("id")
    return result


def main(
    argv: Sequence[str] | None = None,
    *,
    store: JobStore | None = None,
    adapter_factory: Callable[[], Any] = FlatpakAdapter,
    runner: CommandRunner | None = None,
) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    options: argparse.Namespace | None = None
    try:
        arguments, catalog_path = extract_catalog_argument(arguments)
        options = parser().parse_args(arguments)
        controller = Controller(
            store or JobStore(),
            adapter_factory=adapter_factory,
            runner=runner,
            catalog_path=catalog_path,
        )
        if options.command == "install":
            code, document = controller.install(options.ids)
        elif options.command == "remove":
            code, document = controller.remove(options.id, options.delete_data)
        elif options.command == "run":
            code, document = controller.run(options.id, start_android=not options.no_android_start)
        elif options.command == "update":
            code, document = controller.update(options.id)
        elif options.command == "permissions":
            code, document = controller.permissions(options.id)
        elif options.command == "set-permission":
            code, document = controller.set_permission(options.id, options.key, options.value)
        elif options.command == "facts":
            code, document = controller.facts()
        elif options.command == "auto-updates":
            code, document = controller.set_auto_updates(options.state == "on")
        elif options.command == "check-updates":
            code, document = controller.check_updates()
        elif options.command == "refresh-index":
            code, document = controller.refresh_index()
        elif options.command == "open-engine":
            code, document = controller.open_engine(options.name)
        elif options.command == "install-file":
            code, document = controller.install_file(options.path)
        elif options.command == "inspect-file":
            code, document = controller.inspect_file(options.path)
        elif options.command == "remove-file":
            code, document = controller.remove_file(options.id)
        else:
            code, document = controller.cancel(options.job_id)
    except StoreError as error:
        command = options.command if options is not None else ""
        if command in JOB_COMMANDS:
            # Refused before a job began: the window waits for job.json, so the reason goes there.
            document = refusal_document(command, requested_ids(options), error)
            publish_refusal(store or JobStore(), document)
        else:
            now = utc_now()
            document = {
                "schema": SCHEMA,
                "job_id": secrets.token_hex(16),
                "action": arguments[0] if arguments else "invalid",
                "state": "failed",
                "progress": None,
                "current_id": None,
                "message": clean_message(error),
                "items": [],
                "started_at": now,
                "updated_at": now,
            }
            if getattr(error, "message_key", None):
                document["message_key"] = error.message_key
        code = 2
    print(json.dumps(document, ensure_ascii=False, separators=(",", ":")))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
