#!/usr/bin/env bash
# Compatibility entry point for older local callers.
#
# Mo Store and Welcome no longer use this helper or the public moos: scheme.
# Keep the historical command name as a narrow forwarding shim so a saved
# shortcut cannot fall back to the retired fake-progress/AppImage downloader.
# All validation, source policy, locking and atomic job reporting live in the
# trusted backend.
set -euo pipefail

if [ "$#" -ne 1 ] || [ -z "${1:-}" ]; then
    echo "usage: moos-install APP_ID" >&2
    exit 64
fi

exec /usr/bin/moos-storectl install "$1"
