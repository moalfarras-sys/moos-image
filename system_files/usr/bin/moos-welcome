#!/usr/bin/env bash
# moos-welcome — launch the MoOS Welcome onboarding (replaces plasma-welcome).
# A smart first-run wizard: pick a look, pick the system's direction (gaming /
# development / study / office), pick the optional apps, watch them install —
# then it hands over to Mo Store (/usr/bin/moos-store), which is a SEPARATE app.
# Pure-QML script app; tries the available Qt QML runner names in order.
set -euo pipefail
QML="/usr/share/moos/apps/welcome/main.qml"
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-Basic}"

# QML disk cache, kept WARM — content-hashed so it drops exactly once per real UI
# change and every later open is warm. OSTree's frozen mtimes make Qt's mtime-keyed
# qmlcache never invalidate across a `bootc upgrade`, so a plain mtime cache would
# freeze the wizard at its first look; deleting the cache every launch (the old
# fix) recompiled the whole wizard on every open. Same seam as /usr/bin/moai.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
if command -v sha256sum >/dev/null 2>&1 && [ -r "$QML" ]; then
    _stamp="${CACHE}/moos-welcome.qmlstamp"
    _cur="$(sha256sum "$QML" 2>/dev/null | cut -c1-32)"
    if [ -n "$_cur" ] && [ "$(cat "$_stamp" 2>/dev/null)" != "$_cur" ]; then
        rm -rf "${CACHE}/qmlcache" 2>/dev/null || true
        mkdir -p "$CACHE" 2>/dev/null || true
        printf '%s\n' "$_cur" > "$_stamp" 2>/dev/null || true
    fi
else
    export QML_DISABLE_DISK_CACHE=1
fi

# The Welcome installs from the same catalog and private backend as Mo Store,
# then polls their shared atomic job document via QML's XMLHttpRequest.
export QML_XHR_ALLOW_FILE_READ=1
CACHEDIR="${XDG_CACHE_HOME:-$HOME/.cache}/moos-store"
mkdir -p "$CACHEDIR" 2>/dev/null || true

# Live-session detection. When MoOS is booted from the live USB (not yet installed),
# the Welcome shows an "Install MoOS on this computer" call-to-action on its hero
# that opens the installer (moos://installer/open). Passed to the QML as --live=1
# (pure QML can't read /proc/cmdline). Same signal the installer helper self-guards
# on, so the two always agree on what "live" means.
LIVE=0
if grep -q 'rd.live.image' /proc/cmdline 2>/dev/null || [ -d /run/initramfs/live ]; then
    LIVE=1
fi

# moos-qml-shell, not the bare runtime: qml-qt6 names every window it hosts
# org.qt-project.qml-qt6, so Plasma cannot match this window to
# org.moos.welcome.desktop and shows the generic green Qt icon. The shell sets the
# real app_id. (Same fix as /usr/bin/moai — see build_files/moos-qml-shell.cpp.)
if [ -x /usr/bin/moos-qml-shell ]; then
    exec /usr/bin/moos-qml-shell \
        --app-id org.moos.welcome --icon moos-welcome --qml "$QML" \
        -- --cache="$CACHEDIR" --live="$LIVE"
fi

# Fallback: wrong icon beats no window.
for runner in qml-qt6 /usr/lib64/qt6/bin/qml qml6 qml; do
    if command -v "$runner" >/dev/null 2>&1 || [ -x "$runner" ]; then
        exec "$runner" "$QML" -- --cache="$CACHEDIR" --live="$LIVE"
    fi
done
echo "MoOS Welcome: no Qt6 QML runtime found (install qt6-qtdeclarative-devel). | لا يوجد محرّك QML." >&2
exit 127
