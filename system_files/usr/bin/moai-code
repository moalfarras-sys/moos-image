#!/usr/bin/env bash
# moai-code — open an AI coding agent (Claude Code / Codex) from Mo AI.
#
# Mo AI's Developer panel launches this so the user can program apps — or MoOS
# itself — with an agentic coder in a real terminal. Nothing privileged: the
# agent runs as the user, in a project folder, exactly as if they had typed it.
#
#   moai-code                      pick an agent (asks if both are installed)
#   moai-code --agent claude       run a specific one (Mo AI's Run buttons)
#   moai-code --agent codex ~/src  …in a specific folder
set -uo pipefail

agent=""
workdir=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --agent)
            agent="${2:-}"; shift 2 || shift ;;
        --agent=*)
            agent="${1#--agent=}"; shift ;;
        *)
            workdir="$1"; shift ;;
    esac
done

# Only ever run one of the two agents we ship a path for. `--agent` reaches this
# script from the moos:// handler, which any web page can invoke, so it must not
# become a way to exec an arbitrary binary name.
case "$agent" in
    claude|codex|opencode|"") : ;;
    *)
        echo "moai-code: وكيل غير معروف | unknown agent: ${agent}" >&2
        exit 2 ;;
esac

if [ -z "$workdir" ]; then
    [ -d "$HOME/Projects" ] && workdir="$HOME/Projects" || workdir="$HOME"
fi
cd "$workdir" 2>/dev/null || cd "$HOME"

have() { command -v "$1" >/dev/null 2>&1; }
notify() { command -v kdialog >/dev/null 2>&1 && kdialog --title "Mo AI — Code" --msgbox "$1" >/dev/null 2>&1 || echo "$1"; }

# An explicit --agent that is not installed is a real error, not a reason to
# silently run another one: Mo AI only shows "Run X" when X is present, so if we
# get here it means the state changed underneath.
if [ -n "$agent" ]; then
    if ! have "$agent"; then
        notify "الوكيل '${agent}' غير مثبّت.
The '${agent}' agent is not installed.

ثبّته من Mo AI ← المطوّر | install it from Mo AI → Developer"
        exit 1
    fi
else
    # No agent named: offer the ones that are actually here. The menu is BUILT from
    # what is installed rather than hardcoded — a picker that lists an agent the user
    # does not have is a picker that hands them an error.
    menu=()
    have opencode && menu+=(opencode "OpenCode — عقلك المحلي | your local brain")
    have claude   && menu+=(claude   "Claude Code")
    have codex    && menu+=(codex    "Codex")

    case "${#menu[@]}" in
        0)
            notify $'لا يوجد مساعد برمجة مثبّت.\nNo coding agent installed.\n\nثبّته بضغطة من Mo AI ← المطوّر.\nInstall one in a click from Mo AI → Developer.'
            exit 1 ;;
        2)
            agent="${menu[0]}" ;;   # exactly one installed — do not ask a question with one answer
        *)
            agent=$(kdialog --title "Mo AI — Code" \
                --menu "اختر مساعد البرمجة | Choose a coding agent:" "${menu[@]}" 2>/dev/null) || exit 0 ;;
    esac
fi

echo "Mo AI — starting ${agent} in ${workdir}"
exec "$agent"
