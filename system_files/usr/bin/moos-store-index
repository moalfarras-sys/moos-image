ACCENT_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z._+~-]{0,63}$")
SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")
# A window class becomes a launcher's StartupWMClass= line: one line, no `=`/`;`
# games. A Windows program's class is its file name (notepad++.exe).
WM_CLASS_RE = re.compile(r"^[A-Za-z0-9._+() -]{1,80}$")
DESKTOP_CATEGORY_RE = re.compile(r"^[A-Za-z][A-Za-z0-9-]{0,63}$")
APPDROP_ARTIFACTS = frozenset({"appimage", "archive"})
MAX_PINNED_DOWNLOAD = 16 * 1024 ** 3
MAX_KEYWORDS = 12

