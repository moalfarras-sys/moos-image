#!/usr/bin/env python3
"""Build Mo Store's offline, unified application index.

The indexer deliberately reads files only: it never contacts a service and it
never invokes flatpak (or any other command).  Flatpak AppStream indexes and
deployed refs are both already present on disk, which also makes this helper
usable while the machine is offline and straightforward to test.
"""

from __future__ import annotations

import argparse
import configparser
import contextlib
import datetime as dt
import glob
