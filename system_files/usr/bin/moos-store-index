# icon or sandbox; catalogue downloads go through App Drop (`appdrop`) now.
RETIRED_INSTALL_KINDS = frozenset({"appimage"})
CATALOG_SOURCES = frozenset({"flathub", "flatpak", "moos"})
# A web app's id is its launcher's file name and its window's app id
# (usr/lib/moos/moos_webapp_policy.py holds the same rules and is the authority).
WEBAPP_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,62}$")
WEBAPP_HOST_RE = re.compile(
    r"^(\*\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$"
)
WEBAPP_IDENTITY = ("google", "microsoft", "apple", "github")
WEBAPP_PERMISSIONS = (
    "notifications",
