# The old 14-value `category` key the current Store window groups by, for a curated
# entry with no AppStream data. droid and win have no counterpart there and stay
# "other"; the Store category below is what places them.
CURATED_CATEGORY_FALLBACK = {
    "ess": "utilities",
    "fun": "games",
    "dev": "development",
    "work": "office",
    "ai": "ai",
    "comm": "communication",
    "art": "graphics",
    "media": "audio-video",
    "edu": "education",
    "util": "utilities",
}

# ── The Store category, `cat` ────────────────────────────────────────────────
# Every app in the index carries one of the catalogue's twelve category ids as
# `cat` (docs/MO_STORE.md, catalogue `categories[]`). A curated app keeps the
# catalogue's own `cat`; any other Flathub app is placed by its freedesktop
# categories, first matching rule wins. A game is a game even when it also says
# Network or AudioVideo, and an IDE is development even when it also says
# Utility, so the specific rules come first. `ai` is editorial only: no metadata
# rule leads there. Nothing lands in a catch-all: an app no rule places is a
# utility, and Android and Windows apps are always `droid` and `win`.
STORE_CATEGORIES = (
    "ess", "comm", "work", "art", "media", "fun", "dev", "ai", "edu", "util", "droid", "win",
)
STORE_CATEGORY_RULES = (
    ("fun", frozenset({
        "game", "actiongame", "adventuregame", "arcadegame", "blocksgame", "boardgame",
        "cardgame", "kidsgame", "logicgame", "roleplaying", "shooter", "sportsgame",
        "strategygame", "emulator",
    })),
    ("dev", frozenset({"development", "ide"})),
    ("comm", frozenset({
        "instantmessaging", "chat", "email", "videoconference", "ircclient", "telephony",
    })),
    ("ess", frozenset({"webbrowser"})),
    ("work", frozenset({"office"})),
    ("art", frozenset({"graphics", "photography"})),
    ("media", frozenset({"audiovideo", "audio", "video", "player"})),
    ("edu", frozenset({"education", "science"})),
    ("util", frozenset({"system", "utility", "security", "settings"})),
)
DEFAULT_STORE_CATEGORY = "util"


def store_category_from_freedesktop(categories: list[str]) -> str:
    folded = {category.casefold() for category in categories}
    for store_category, names in STORE_CATEGORY_RULES:
        if folded & names:
            return store_category
    return DEFAULT_STORE_CATEGORY


def store_category(app: dict) -> str:
    """The Store category of a finished index entry (see STORE_CATEGORY_RULES)."""

    declared = app.get("cat")
    if app.get("curated") and declared in STORE_CATEGORIES:
        return declared
    install = app.get("install") if isinstance(app.get("install"), dict) else {}
    kind = app.get("kind")
    if kind == "android" or app.get("engine") == "android" or install.get("kind") == "android":
        return "droid"
    if kind == "windows" or app.get("engine") == "windows":
        return "win"
    if declared in STORE_CATEGORIES:
        return declared
    return store_category_from_freedesktop(app.get("categories") or [])


# ── Search ───────────────────────────────────────────────────────────────────
# `search` is ONE folded string per app. The Store window and MoOS Search fold
# what a person types with the same rules and match against it:
#   1. lowercase (String.prototype.toLowerCase / str.lower);
#   2. remove Arabic marks U+0610-061A, U+064B-065F, U+0670, U+06D6-06ED, the
#      tatweel U+0640, zero-width and bidi marks U+200B-200F, U+202A-202E,
#      U+2066-2069, U+061C and U+FEFF;
#   3. أ إ آ ٱ -> ا, ى ئ -> ي, ؤ -> و, ة -> ه, Arabic-Indic and Persian digits -> 0-9;
#   4. runs of whitespace and  _ . - + / ( ) | ·  become one space; trim.
# The same rules as usr/libexec/moos-store-krunner's fold().
SEARCH_MARKS = re.compile(
    "[ؐ-ًؚ-ٰٟۖ-ۭـ"
    "​-‏‪-‮⁦-⁩؜﻿]"
)
SEARCH_FOLD = str.maketrans(
    {
        "أ": "ا", "إ": "ا", "آ": "ا", "ٱ": "ا", "ى": "ي", "ئ": "ي", "ؤ": "و", "ة": "ه",
        **{chr(0x0660 + digit): str(digit) for digit in range(10)},
        **{chr(0x06F0 + digit): str(digit) for digit in range(10)},
    }
)
SEARCH_SPACE = re.compile(r"[\s_.\-+/()|·]+")
SEARCH_LIMIT = 600


def fold_search_text(value: object) -> str:
    if not isinstance(value, str):
        return ""
    text = SEARCH_MARKS.sub("", value.lower()).translate(SEARCH_FOLD)
    return SEARCH_SPACE.sub(" ", text).strip()


def search_string(terms: list) -> str:
    """Fold every term, keep each once, join with spaces, bounded at a word."""

    seen: list[str] = []
    for term in terms:
        folded = fold_search_text(term)
        if folded and folded not in seen:
            seen.append(folded)
    text = " ".join(seen)
    if len(text) > SEARCH_LIMIT:
        text = text[:SEARCH_LIMIT].rsplit(" ", 1)[0]
    return text


def id_tail(app_id: str) -> str:
    """What an id is called by people: org.gimp.GIMP -> GIMP, notepad-plus-plus as is."""

    return app_id.rsplit(".", 1)[-1] if "." in app_id and not app_id.startswith(".") else app_id


def app_search_string(app: dict, extra_terms: list | None = None) -> str:
    terms: list = [app.get("name"), app.get("name_en"), app.get("en"), app.get("ar")]
    terms.extend(extra_terms or [])
    terms.extend(app.get("keywords_en") or [])
    terms.extend(app.get("keywords_ar") or [])
    terms.append(app.get("developer"))
    terms.append(id_tail(app.get("id", "")))
    return search_string(terms)


class IndexErrorBase(Exception):
    """Expected input error with a concise user-facing message."""


class CatalogError(IndexErrorBase):
    """The curated catalog is absent or unsafe."""


class XmlLimitError(IndexErrorBase):
    """A decompressed AppStream file exceeded its safety limit."""


class LimitedReader:
    """Small read proxy that caps decompressed XML, including gzip streams."""

    def __init__(self, stream, limit: int = MAX_XML_BYTES):
        self.stream = stream
        self.limit = limit
        self.seen = 0

    def read(self, size: int = -1) -> bytes:
        if size < 0 or size > self.limit - self.seen + 1:
            size = self.limit - self.seen + 1
        data = self.stream.read(size)
        self.seen += len(data)
        if self.seen > self.limit:
            raise XmlLimitError("AppStream XML exceeds the decompressed size limit")
        return data


def local_name(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def direct_children(element: ET.Element, name: str):
    for child in element:
        if local_name(child.tag) == name:
            yield child


def first_child(element: ET.Element, name: str) -> ET.Element | None:
    return next(direct_children(element, name), None)


def clean_text(value: str | None, limit: int) -> str:
    if not value:
        return ""
    value = unicodedata.normalize("NFKC", value)
    value = " ".join(value.split())
    value = "".join(
        char for char in value if unicodedata.category(char) not in {"Cc", "Cs"}
    )
    if len(value) <= limit:
        return value
    return value[: max(1, limit - 1)].rstrip() + "…"


def element_text(element: ET.Element | None, limit: int) -> str:
    if element is None:
        return ""
    return clean_text(" ".join(element.itertext()), limit)


def normalized_locale(value: str | None) -> str:
    if not value:
        return ""
    value = value.split(".", 1)[0].split("@", 1)[0].replace("_", "-").strip()
    if not value or not re.fullmatch(r"[A-Za-z]{1,8}(?:-[A-Za-z0-9]{1,8})*", value):
        return ""
    return value.casefold()


def locale_preferences(requested: str | None) -> list[str]:
    raw_values: list[str] = []
    if requested:
        raw_values.append(requested)
    else:
        for key in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
            value = os.environ.get(key, "")
            if value:
                raw_values.extend(value.split(":"))
                break

    result: list[str] = []
    for raw in raw_values:
        locale = normalized_locale(raw)
        if not locale:
            continue
        for candidate in (locale, locale.split("-", 1)[0]):
            if candidate and candidate not in result:
                result.append(candidate)
    for fallback in ("", "en"):
        if fallback not in result:
            result.append(fallback)
    return result


def localized_values(
    element: ET.Element, child_name: str, limit: int
) -> dict[str, str]:
    values: dict[str, str] = {}
    for child in direct_children(element, child_name):
        lang = normalized_locale(child.attrib.get(XML_LANG))
        if child.attrib.get(XML_LANG) and not lang:
            continue
        value = element_text(child, limit)
        if value and lang not in values:
            values[lang] = value
    return values


def appstream_description_values(
    component: ET.Element, limit: int = 2048
) -> dict[str, str]:
    """Render localized AppStream paragraphs/lists as bounded plain text.

    Real AppStream metadata commonly keeps every language inside one
    ``<description>`` by putting ``xml:lang`` on each ``<p>``/``<ul>``; some
    producers instead emit one localized description container per language.
    Treating the container like an ordinary text field mixed those languages
    and flattened lists. Keep only text, preserve useful block structure, and
    cap the final value before it enters the Store index.
    """

    blocks: dict[str, list[str]] = {}

    def append(language: str, value: str) -> None:
        if value:
            blocks.setdefault(language, []).append(value)

    for description in direct_children(component, "description"):
        raw_container_lang = description.attrib.get(XML_LANG)
        container_lang = normalized_locale(raw_container_lang)
        if raw_container_lang and not container_lang:
            continue
        children = list(description)
        if not children:
            append(container_lang, element_text(description, limit))
            continue
        for child in children:
            raw_child_lang = child.attrib.get(XML_LANG)
            child_lang = normalized_locale(raw_child_lang)
            if raw_child_lang and not child_lang:
                continue
            language = child_lang or container_lang
            kind = local_name(child.tag)
            if kind in {"ul", "ol"}:
                per_language: dict[str, list[str]] = {}
                for item in direct_children(child, "li"):
                    raw_item_lang = item.attrib.get(XML_LANG)
                    item_lang = normalized_locale(raw_item_lang)
                    if raw_item_lang and not item_lang:
                        continue
                    item_language = item_lang or language
                    value = element_text(item, limit)
                    if value:
                        per_language.setdefault(item_language, []).append(value)
                for item_language, lines in per_language.items():
                    if kind == "ol":
                        rendered = "\n".join(
                            f"{index}. {line}"
                            for index, line in enumerate(lines, start=1)
                        )
                    else:
                        rendered = "\n".join(f"• {line}" for line in lines)
                    append(item_language, rendered)
            else:
                append(language, element_text(child, limit))

    result: dict[str, str] = {}
    for language, language_blocks in blocks.items():
        value = "\n\n".join(language_blocks).strip()
        if len(value) > limit:
            value = value[: max(1, limit - 1)].rstrip() + "…"
        if value:
            result[language] = value
    return result


def pick_localized(values: dict[str, str], preferences: list[str]) -> str:
    for wanted in preferences:
        if wanted in values:
            return values[wanted]
        if wanted:
            regional = next(
                (
                    value
                    for language, value in values.items()
                    if language.startswith(wanted + "-")
                ),
                "",
            )
            if regional:
                return regional
    return next(iter(values.values()), "")


def valid_flatpak_id(value: object) -> bool:
    return (
        isinstance(value, str)
        and len(value) <= 255
        and bool(FLATPAK_ID_RE.fullmatch(value))
    )


def valid_generic_id(value: object) -> bool:
    return isinstance(value, str) and bool(GENERIC_ID_RE.fullmatch(value))


def parse_flatpak_ref(value: str | None) -> tuple[str, str, str, str] | None:
    if not value or len(value) > 512:
        return None
    parts = value.strip().split("/")
    if len(parts) != 4 or parts[0] != "app":
        return None
    app_id, arch, branch = parts[1:]
    if not valid_flatpak_id(app_id):
        return None
    if not REF_PART_RE.fullmatch(arch) or not REF_PART_RE.fullmatch(branch):
        return None
    return app_id, arch, branch, "/".join(parts)


def safe_https_url(value: str | None) -> str:
    """Return a safe public HTTPS URL, or an empty string."""

    value = clean_text(value, 2048)
    if not value or "\\" in value:
        return ""
    try:
        parsed = urlsplit(value)
        port = parsed.port
    except ValueError:
        return ""
    if (
        parsed.scheme.casefold() != "https"
        or not parsed.netloc
        or parsed.username is not None
        or parsed.password is not None
        or parsed.fragment
        or port not in (None, 443)
    ):
        return ""

    hostname = parsed.hostname
    if not hostname:
        return ""
    try:
        address = ipaddress.ip_address(hostname.strip("[]"))
    except ValueError:
        try:
            ascii_host = hostname.encode("idna").decode("ascii")
        except UnicodeError:
            return ""
        labels = ascii_host.rstrip(".").split(".")
        if (
            len(labels) < 2
            or any(
                not label
                or len(label) > 63
                or label.startswith("-")
                or label.endswith("-")
                or not re.fullmatch(r"[A-Za-z0-9-]+", label)
                for label in labels
            )
        ):
            return ""
    else:
        if not address.is_global:
            return ""

    decoded = unquote(parsed.path + parsed.query)
    if any(ord(char) < 32 or ord(char) == 127 for char in decoded):
        return ""
    return value


def is_within(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def cached_icon_uri(component: ET.Element, index_path: Path) -> str:
    candidates: list[tuple[int, ET.Element]] = []
    for icon in direct_children(component, "icon"):
        if icon.attrib.get("type", "").casefold() != "cached":
            continue
        name = element_text(icon, 256)
        if not ICON_NAME_RE.fullmatch(name):
            continue
        try:
            width = int(icon.attrib.get("width", "0"))
            height = int(icon.attrib.get("height", "0"))
        except ValueError:
            continue
        if not (1 <= width <= 1024 and 1 <= height <= 1024):
            continue
        score = 10_000 - abs(128 - min(width, height))
        candidates.append((score, icon))

    # Keep `active` in the published URI. Flatpak stores AppStream metadata in
    # content-addressed revision directories and repoints the `active` symlink
    # during a refresh, then removes the old revision. Resolving that symlink
    # here made a perfectly fresh cached Store index point at files that no
    # longer existed after the next refresh. Resolve only for containment and
    # existence checks; publish the stable path through `active`.
    base = index_path.parent.absolute()
    resolved_base = base.resolve()
    for _score, icon in sorted(candidates, key=lambda item: item[0], reverse=True):
        name = element_text(icon, 256)
        width = int(icon.attrib["width"])
        height = int(icon.attrib["height"])
        candidate = base / "icons" / f"{width}x{height}" / name
        resolved_candidate = candidate.resolve()
        if (
            is_within(resolved_candidate, resolved_base)
            and resolved_candidate.is_file()
        ):
            return candidate.as_uri()
    return ""


def remote_icon_uri(component: ET.Element) -> str:
    candidates: list[tuple[int, str]] = []
    for icon in direct_children(component, "icon"):
        if icon.attrib.get("type", "").casefold() != "remote":
            continue
        url = safe_https_url(element_text(icon, 2048))
        if not url:
            continue
        try:
            width = int(icon.attrib.get("width", "0"))
            height = int(icon.attrib.get("height", "0"))
        except ValueError:
            width = height = 0
        score = 10_000 - abs(128 - min(width, height)) if width and height else 0
        candidates.append((score, url))
    return max(candidates, default=(0, ""), key=lambda item: item[0])[1]


def first_screenshot_uri(component: ET.Element) -> str:
    screenshots = first_child(component, "screenshots")
    if screenshots is None:
        return ""
    screenshot = first_child(screenshots, "screenshot")
    if screenshot is None:
        return ""
    images: list[tuple[int, str]] = []
    for image in direct_children(screenshot, "image"):
        url = safe_https_url(element_text(image, 2048))
        if not url:
            continue
        image_type = image.attrib.get("type", "").casefold()
        score = 2 if image_type == "source" else 1
        images.append((score, url))
    return max(images, default=(0, ""), key=lambda item: item[0])[1]


def developer_name(component: ET.Element, preferences: list[str]) -> str:
    developer = first_child(component, "developer")
    if developer is not None:
        value = pick_localized(localized_values(developer, "name", 160), preferences)
        if value:
            return value
    return pick_localized(
        localized_values(component, "developer_name", 160), preferences
    )


def component_categories(component: ET.Element) -> list[str]:
    parent = first_child(component, "categories")
    if parent is None:
        return []
    categories: list[str] = []
    for item in direct_children(parent, "category"):
        category = element_text(item, 80)
        if (
            category
            and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+_.-]{0,79}", category)
            and category not in categories
        ):
            categories.append(category)
    return categories


def normalized_category(categories: list[str]) -> str:
    folded = {category.casefold() for category in categories}
    for primary, aliases in CATEGORY_GROUPS:
        if folded.intersection(alias.casefold() for alias in aliases):
            return primary
    return "other"


def latest_version(component: ET.Element) -> str:
    releases = first_child(component, "releases")
    if releases is None:
        return ""
    for release in direct_children(releases, "release"):
        version = clean_text(release.attrib.get("version"), 120)
        if version:
            return version
    return ""


def component_verified(component: ET.Element) -> bool:
    custom = first_child(component, "custom")
    if custom is None:
        return False
    for value in direct_children(custom, "value"):
        if value.attrib.get("key") == "flathub::verification::verified":
            return element_text(value, 16).casefold() in {"1", "true", "yes"}
    return False


def untranslated_value(values: dict[str, str]) -> str:
    """The metadata's own (English) text: no xml:lang, else en, else en-*."""

    if values.get(""):
        return values[""]
    if values.get("en"):
        return values["en"]
    return next((value for language, value in values.items()
                 if language.startswith("en-") and value), "")


def arabic_value(values: dict[str, str]) -> str:
    if values.get("ar"):
        return values["ar"]
    return next((value for language, value in values.items()
                 if language.startswith("ar-") and value), "")


HEX_COLOR_RE = re.compile(r"^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{3})$")


def normalized_hex(value: str) -> str:
    value = value.strip()
    if not HEX_COLOR_RE.fullmatch(value):
        return ""
    if len(value) == 4:
        value = "#" + "".join(char * 2 for char in value[1:])
    return value.lower()


def branding_colors(component: ET.Element) -> dict | None:
    """{light, dark} from <branding><color type="primary" scheme_preference=…>.

    A colour with no scheme preference serves both schemes; a scheme with no
    colour of its own is null rather than borrowing the other scheme's (a pale
    light-scheme accent is unreadable as a dark-scheme surface).
    """

    branding = first_child(component, "branding")
    if branding is None:
        return None
    found: dict[str, str] = {}
    for color in direct_children(branding, "color"):
        if color.attrib.get("type", "primary").casefold() != "primary":
            continue
        value = normalized_hex(element_text(color, 16))
        if not value:
            continue
        scheme = color.attrib.get("scheme_preference", "").casefold()
        key = scheme if scheme in {"light", "dark"} else "any"
        found.setdefault(key, value)
    light = found.get("light") or found.get("any")
    dark = found.get("dark") or found.get("any")
    if not light and not dark:
        return None
    return {"light": light, "dark": dark}


def content_rating(component: ET.Element) -> str | None:
    """OARS: any `intense` -> mature, any `moderate` -> teen, otherwise all.

    None when the component carries no rating at all: "unrated" is not "all ages".
    """

    rating = None
    for element in direct_children(component, "content_rating"):
        rating = rating or "all"
        for attribute in direct_children(element, "content_attribute"):
            value = element_text(attribute, 16).casefold()
            if value == "intense":
                return "mature"
            if value == "moderate":
                rating = "teen"
    return rating


def appstream_keywords(component: ET.Element, preferences: list[str], limit: int = 24) -> list[str]:
    """Search words: the untranslated ones, the session language's, and Arabic."""

    wanted = {"", "en", "ar", *preferences}
    words: list[str] = []
    for keywords in direct_children(component, "keywords"):
        container_lang = normalized_locale(keywords.attrib.get(XML_LANG))
        for keyword in direct_children(keywords, "keyword"):
            language = normalized_locale(keyword.attrib.get(XML_LANG)) or container_lang
            if language not in wanted and language.split("-", 1)[0] not in wanted:
                continue
            word = element_text(keyword, 40)
            if word and word not in words:
                words.append(word)
            if len(words) >= limit:
                return words
    return words


# <requires>/<recommends> (AppStream "relations"). display_length is in logical
# pixels against the screen's shortest side unless side="longest"; the older named
# sizes map to their documented minimums.
DISPLAY_LENGTH_NAMES = {"xsmall": 360, "small": 420, "medium": 760, "large": 900,
                        "xlarge": 1200}
DISPLAY_COMPARES = {"ge", "gt", "le", "lt", "eq", "ne"}
INTERNET_NEEDS = {"always", "offline-only", "first-run"}
CONTROL_KINDS = {"pointing", "keyboard", "console", "tablet", "touch", "gamepad",
                 "tv-remote", "voice", "vision"}


def component_relations(component: ET.Element, relation: str) -> dict:
    """{memory (MiB), display_length {px, compare, side}, internet, controls[]}."""

    result: dict = {}
    controls: list[str] = []
    for element in direct_children(component, relation):
        for child in element:
            name = local_name(child.tag)
            text = element_text(child, 64).casefold()
            if name == "memory" and text.isdigit() and "memory" not in result:
                result["memory"] = min(int(text), 1 << 30)
            elif name == "display_length" and "display_length" not in result:
                compare = child.attrib.get("compare", "ge").strip().casefold() or "ge"
                side = child.attrib.get("side", "shortest").strip().casefold() or "shortest"
                pixels = DISPLAY_LENGTH_NAMES.get(text) or (int(text) if text.isdigit() else 0)
                if 0 < pixels < 100_000 and compare in DISPLAY_COMPARES and side in {
                        "shortest", "longest"}:
                    result["display_length"] = {"px": pixels, "compare": compare,
                                                "side": side}
            elif name == "internet" and text in INTERNET_NEEDS and "internet" not in result:
                result["internet"] = text
            elif name == "control" and text in CONTROL_KINDS and text not in controls:
                controls.append(text)
    result["controls"] = controls
    return result


def component_size(component: ET.Element) -> int | None:
    """Download plus installed bytes when AppStream states them (Flathub does not)."""

    total = 0
    for size in direct_children(component, "size"):
        kind = size.attrib.get("type", "").casefold()
        text = element_text(size, 32)
        if kind in {"download", "installed"} and text.isdigit():
            total += int(text)
    return total or None


def component_needs(component: ET.Element) -> dict:
    """What the compatibility verdict reads, kept in the index entry (see compat_verdict)."""

    requires = component_relations(component, "requires")
    needs: dict = {}
    if "memory" in requires:
        needs["memory"] = requires["memory"]
    if "display_length" in requires:
        needs["display"] = requires["display_length"]
    if requires.get("internet") in {"always", "first-run"}:
        needs["internet"] = requires["internet"]
    size = component_size(component)
    if size:
        needs["size"] = size
    return needs


def parse_component(
    component: ET.Element,
    index_path: Path,
    origin: str,
    scope: str,
    preferences: list[str],
) -> dict | None:
    flatpak_ref = component_bundle_ref(component)
    if flatpak_ref is None:
        return None

    app_id, arch, branch, canonical_ref = flatpak_ref
    names = localized_values(component, "name", 160)
    name = pick_localized(names, preferences)
    summary = pick_localized(
        localized_values(component, "summary", 240), preferences
    )
    description = pick_localized(
        appstream_description_values(component), preferences
    )
    categories = component_categories(component)
    license_value = element_text(first_child(component, "project_license"), 160)
    icon = cached_icon_uri(component, index_path) or remote_icon_uri(component)
    fallback_name = app_id.rsplit(".", 1)[-1]

    return {
        "id": app_id,
        "source": "flatpak",
        "kind": "flatpak",
        "origin": origin,
        "scope": scope,
        "installable": True,
        "listed": True,
        "flatpak_ref": canonical_ref,
        "arch": arch,
        "branch": branch,
        "name": name or fallback_name,
        # The English name whatever the index locale: an Arabic index must still
        # find "VS Code", and an English window over an Arabic index must not
        # show Arabic names.
        "name_en": untranslated_value(names) or name or fallback_name,
        "summary": summary,
        "description": description or summary,
        "developer": developer_name(component, preferences),
        "license": license_value,
        "category": normalized_category(categories),
        "categories": categories,
        "icon": icon or None,
        "screenshot": first_screenshot_uri(component) or None,
        "verified": component_verified(component),
        "installed": False,
        "version": latest_version(component),
        "curated": False,
        "branding": branding_colors(component),
        "content_rating": content_rating(component),
        "needs": component_needs(component),
        # Build-time only: removed by finish_app() once `search` is written.
        "_search_terms": [arabic_value(names), *appstream_keywords(component, preferences)],
        "origins": [
            {
                "origin": origin,
                "scope": scope,
                "arch": arch,
                "branch": branch,
                "ref": canonical_ref,
            }
        ],
    }


# AppStream component types that describe something other than an application a
# person opens. They can still carry an `app/` bundle (Flathub ships 63 console
# tools, the Nautilus previewer add-on and five PySide BaseApps that way), and
# the Store used to list them as apps: "Wine" under More, "PySide6 BaseApp", a
# file-manager plugin. Offering one is a dead end at best.
NOT_APP_TYPES = frozenset(
    {
        "runtime",
        "addon",
        "console-application",
        "localization",
        "font",
        "codec",
        "inputmethod",
        "input-method",
        "firmware",
        "driver",
        "icon-theme",
        "operating-system",
        "repository",
        "service",
    }
)
# Types that may be an app or not; such a component counts as an app only when it
# declares a desktop launcher (Flathub's `generic` egui picross does, the
# MasterPassword CLI does not).
AMBIGUOUS_APP_TYPES = frozenset({"", "generic"})
# Ids that are machinery even though their metadata says otherwise. Wine on
# Flathub is a BaseApp other apps build on, published as a console application
# in nine branches; MoOS runs Windows programs through its own engine registry.
NOT_APP_IDS = frozenset({"org.winehq.Wine"})


def component_bundle_ref(component: ET.Element) -> tuple[str, str, str, str] | None:
    for bundle in direct_children(component, "bundle"):
        if bundle.attrib.get("type", "").casefold() != "flatpak":
            continue
        parsed = parse_flatpak_ref(element_text(bundle, 512))
        if parsed:
            return parsed
    return None


def not_an_app_reason(component: ET.Element, app_id: str) -> str:
    """Why a component with an app bundle is still not an app to offer, or ""."""

    kind = component.attrib.get("type", "").strip().casefold()
    if app_id.endswith(".BaseApp"):
        return "base-app"
    if app_id in NOT_APP_IDS:
        return "runtime-tool"
    if kind in NOT_APP_TYPES:
        return kind
    if kind in AMBIGUOUS_APP_TYPES and not any(
        launchable.attrib.get("type", "").casefold() == "desktop-id"
        and element_text(launchable, 255)
        for launchable in direct_children(component, "launchable")
    ):
        return "no-launcher"
    return ""


def rejected_component_is_invalid(component: ET.Element) -> bool:
    """Distinguish an unsafe app ref from a normal runtime/add-on component."""

    for bundle in direct_children(component, "bundle"):
        if bundle.attrib.get("type", "").casefold() != "flatpak":
            continue
        value = element_text(bundle, 512)
        if value == "app" or value.startswith("app/"):
            return True
    return False


@contextlib.contextmanager
def open_appstream(path: Path):
    raw = path.open("rb")
    try:
        if path.name.endswith(".gz"):
            compressed = gzip.GzipFile(fileobj=raw, mode="rb")
            try:
                yield LimitedReader(compressed)
            finally:
                compressed.close()
        else:
            yield LimitedReader(raw)
    finally:
        raw.close()


def iter_components(path: Path):
    with open_appstream(path) as stream:
        context = ET.iterparse(stream, events=("start", "end"))
        try:
            _event, root = next(context)
        except StopIteration:
            return
        for event, element in context:
            if event == "end" and local_name(element.tag) == "component":
                yield element
                element.clear()
                root.clear()


def source_rank(app: dict, installed_refs: list[dict]) -> tuple:
    installed_match = any(
        item["origin"] == app["origin"]
        and item["arch"] == app["arch"]
        and item["branch"] == app["branch"]
        for item in installed_refs
    )
    scope_rank = {"user": 3, "system": 2, "custom": 1}.get(app["scope"], 0)
    completeness = sum(
        bool(app.get(field))
        for field in (
            "name",
            "summary",
            "description",
            "developer",
            "license",
            "icon",
            "screenshot",
            "version",
        )
    )
    # An app published in several branches (QGIS: `lts` and `stable`) is one
    # entry. The installed branch wins so Open and Remove act on what is there;
    # otherwise the stable branch is the one offered, which is also the branch
    # moos-storectl installs.
    stable = app.get("branch") == "stable"
    return installed_match, stable, scope_rank, bool(app["verified"]), completeness


def merge_duplicate(current: dict, candidate: dict, installed_refs: list[dict]) -> dict:
    if source_rank(candidate, installed_refs) > source_rank(current, installed_refs):
        primary, secondary = candidate, current
    else:
        primary, secondary = current, candidate

    for field in (
        "summary",
        "description",
        "developer",
        "license",
        "icon",
        "screenshot",
        "version",
        "branding",
        "content_rating",
        "needs",
    ):
        if not primary.get(field) and secondary.get(field):
            primary[field] = secondary[field]

    primary["categories"] = list(
        dict.fromkeys(primary["categories"] + secondary["categories"])
    )
    primary["_search_terms"] = list(
        dict.fromkeys(primary.get("_search_terms", []) + secondary.get("_search_terms", []))
    )
    if primary["category"] == "other":
        primary["category"] = normalized_category(primary["categories"])

    seen = {
        (item["origin"], item["scope"], item["ref"]) for item in primary["origins"]
    }
    for item in secondary["origins"]:
        marker = item["origin"], item["scope"], item["ref"]
        if marker not in seen:
            primary["origins"].append(item)
            seen.add(marker)
    primary["origins"].sort(
        key=lambda item: (item["origin"], item["scope"], item["ref"])
    )
    return primary


def clone_app_for_source(template: dict, source: dict) -> dict:
    """Clone cached metadata while recording this remote installation's scope."""

    app = dict(template)
    app["origin"] = source["origin"]
    app["scope"] = source["scope"]
    app["categories"] = list(template["categories"])
    app["origins"] = [
        {
            "origin": source["origin"],
            "scope": source["scope"],
            "arch": template["arch"],
            "branch": template["branch"],
            "ref": template["flatpak_ref"],
        }
    ]
    return app


def scope_for_path(
    path: Path, user_installation: Path, system_installation: Path
) -> str:
    resolved = path.resolve()
    if is_within(resolved, user_installation.resolve()):
        return "user"
    if is_within(resolved, system_installation.resolve()):
        return "system"
    return "custom"


def flatpak_locations() -> tuple[Path, Path]:
    xdg_data_home = Path(
        os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))
    )
    user = Path(os.environ.get("FLATPAK_USER_DIR", str(xdg_data_home / "flatpak")))
    system = Path(os.environ.get("FLATPAK_SYSTEM_DIR", "/var/lib/flatpak"))
    return user, system


def extra_system_installations() -> list[Path]:
    paths: list[Path] = []
    config_dirs = [Path("/etc/flatpak/installations.d")]
    for entry in os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":"):
        if entry:
            config_dirs.append(Path(entry) / "flatpak/installations.d")

    seen_configs: set[Path] = set()
    for directory in config_dirs:
        try:
            files = sorted(directory.glob("*.conf"))
        except OSError:
            continue
        for config_path in files:
            try:
                resolved_config = config_path.resolve()
            except OSError:
                continue
            if resolved_config in seen_configs:
                continue
            seen_configs.add(resolved_config)
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                with config_path.open(encoding="utf-8") as handle:
                    parser.read_file(handle)
            except (OSError, UnicodeError, configparser.Error):
                continue
            for section in parser.sections():
                if not section.casefold().startswith("installation "):
                    continue
                value = parser.get(section, "Path", fallback="").strip()
                candidate = Path(os.path.expandvars(value))
                if candidate.is_absolute():
                    paths.append(candidate)
    return paths


def unique_locations(items: list[tuple[Path, str]]) -> list[tuple[Path, str]]:
    result: list[tuple[Path, str]] = []
    seen: set[Path] = set()
    for path, scope in items:
        try:
            marker = path.resolve()
        except OSError:
            marker = path.absolute()
        if marker not in seen:
            result.append((path, scope))
            seen.add(marker)
    return result


def discover_roots(
    requested_appstream: list[str] | None,
    requested_installations: list[str] | None,
) -> tuple[list[tuple[Path, str]], list[tuple[Path, str]]]:
    user_installation, system_installation = flatpak_locations()

    if requested_appstream:
        appstream_roots = [
            (
                Path(value),
                scope_for_path(
                    Path(value), user_installation, system_installation
                ),
            )
            for value in requested_appstream
        ]
    else:
        appstream_roots = [
            (user_installation / "appstream", "user"),
            (system_installation / "appstream", "system"),
        ]
        appstream_roots.extend(
            (path / "appstream", "system") for path in extra_system_installations()
        )

    if requested_installations:
        installation_roots = [
            (
                Path(value),
                scope_for_path(
                    Path(value), user_installation, system_installation
                ),
            )
            for value in requested_installations
        ]
    elif requested_appstream:
        installation_roots = [
            (Path(value).parent, scope) for value, (_path, scope) in zip(
                requested_appstream, appstream_roots
            )
        ]
    else:
        installation_roots = [
            (user_installation, "user"),
            (system_installation, "system"),
        ]
        installation_roots.extend(
            (path, "system") for path in extra_system_installations()
        )

    return unique_locations(appstream_roots), unique_locations(installation_roots)


def appstream_sources(
    roots: list[tuple[Path, str]],
    *,
    official_only: bool = False,
) -> list[dict]:
    sources: list[dict] = []
    for root, scope in roots:
        if not root.is_dir():
            continue
        remote_urls = official_flatpak_remotes(root) if official_only else None
        allowed_origins = set(remote_urls) if remote_urls is not None else None
        try:
            root_resolved = root.resolve()
            remote_dirs = sorted(root.iterdir(), key=lambda path: path.name)
        except OSError:
            continue
        for remote_dir in remote_dirs:
            origin = remote_dir.name
            if (
                not remote_dir.is_dir()
                or not REMOTE_RE.fullmatch(origin)
                or remote_dir.is_symlink()
                or (allowed_origins is not None and origin not in allowed_origins)
            ):
                continue
            try:
                arch_dirs = sorted(remote_dir.iterdir(), key=lambda path: path.name)
            except OSError:
                continue
            for arch_dir in arch_dirs:
                arch = arch_dir.name
                if not arch_dir.is_dir() or not REF_PART_RE.fullmatch(arch):
                    continue
                candidates: list[Path] = []
                try:
                    # Prefer Flatpak's active revision explicitly. pathlib's
                    # recursive walk intentionally does not descend through
                    # that symlink, so add its two supported filenames first.
                    for filename in ("appstream.xml", "appstream.xml.gz"):
                        active_candidate = arch_dir / "active" / filename
                        if (
                            active_candidate.is_file()
                            and is_within(active_candidate.resolve(), root_resolved)
                        ):
                            candidates.append(active_candidate)
                    for candidate in arch_dir.rglob("*"):
                        if (
                            candidate.is_file()
                            and candidate.name in {"appstream.xml", "appstream.xml.gz"}
                        ):
                            resolved = candidate.resolve()
                            if is_within(resolved, root_resolved):
                                candidates.append(candidate)
                except OSError:
                    continue
                if not candidates:
                    continue

                by_parent: dict[Path, list[Path]] = {}
                for candidate in candidates:
                    by_parent.setdefault(
                        candidate.parent.resolve(), []
                    ).append(candidate)
                revisions: list[Path] = []
                for siblings in by_parent.values():
                    plain = next(
                        (item for item in siblings if item.name == "appstream.xml"),
                        None,
                    )
                    revisions.append(plain or siblings[0])

                def candidate_key(path: Path):
                    try:
                        modified = path.stat().st_mtime_ns
                    except OSError:
                        modified = 0
                    active = "active" in path.parts
                    return active, modified, str(path)

                chosen = max(revisions, key=candidate_key)
                revision_dir = chosen.parent.resolve()
                revision_name = revision_dir.name
                revision = (
                    revision_name
                    if re.fullmatch(r"[0-9a-f]{64}", revision_name)
                    else None
                )
                # When this revision was checked out. The plain appstream.xml
                # is an OSTree checkout whose mtime is the epoch, so the file
                # cannot say which installation holds the newer catalogue; the
                # revision directory is created at checkout and can.
                try:
                    revision_mtime_ns = revision_dir.stat().st_mtime_ns
                except OSError:
                    revision_mtime_ns = 0
                sources.append(
                    {
                        "kind": "flatpak-appstream",
                        "origin": origin,
                        "scope": scope,
                        "arch": arch,
                        "revision": revision,
                        "path": chosen,
                        "url": (remote_urls or {}).get(origin),
                        "revision_mtime_ns": revision_mtime_ns,
                    }
                )
    return sources


FLATHUB_REPO_URL = "https://dl.flathub.org/repo/"


def official_flatpak_remotes(appstream_root: Path) -> dict[str, str]:
    """Return {remote name: URL} for enabled remotes backed by the official Flathub repo.

    AppStream directories can survive remote removal.  Treating every leftover
    directory as live metadata lets an orphan/custom remote claim verification,
    shadow a real app ID, and advertise apps the backend will not install from
    that source.  Production auto-discovery therefore reads the installation's
    own repo config and keeps only remotes whose URL/GPG policy matches the
    backend. Explicit --appstream-root fixtures remain available for tests.

    GPG verification is OSTree's DEFAULT: a remote section with no
    `gpg-verify` line verifies. `flatpak remote-add --user` writes no such
    line, so reading a missing key as "false" (as this function did until
    2026-10-14) silently threw away the person's own user-scope Flathub
    AppStream — the one `moos-storectl refresh-index` refreshes — and the Store
    could only ever show the system copy. An implicit default is accepted only
    together with the remote's trusted keyring in the same repo, which is where
    `remote-add` stores the key verification uses; an explicit
    `gpg-verify=false` is still refused.
    """

    repo = appstream_root.parent / "repo"
    config = repo / "config"
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        with config.open(encoding="utf-8") as handle:
            parser.read_file(handle)
    except (OSError, UnicodeError, configparser.Error):
        return {}
    result: dict[str, str] = {}
    for section in parser.sections():
        match = re.fullmatch(r'remote "([^"]+)"', section)
        if not match:
            continue
        name = match.group(1)
        if not REMOTE_RE.fullmatch(name):
            continue
        url = parser.get(section, "url", fallback="").strip().rstrip("/") + "/"
        try:
            if parser.has_option(section, "gpg-verify"):
                gpg = parser.getboolean(section, "gpg-verify")
            else:
                keyring = repo / f"{name}.trustedkeys.gpg"
                gpg = keyring.is_file() and keyring.stat().st_size > 0
            disabled = parser.getboolean(section, "xa.disable", fallback=False)
        except (ValueError, OSError):
            continue
        if url == FLATHUB_REPO_URL and gpg and not disabled:
            result[name] = url
    return result


def official_flatpak_origins(appstream_root: Path) -> set[str]:
    """The names of the trusted Flathub remotes (see official_flatpak_remotes)."""

    return set(official_flatpak_remotes(appstream_root))


def supersede_older_sources(sources: list[dict]) -> tuple[list[dict], list[dict]]:
    """Keep only the newest AppStream revision of each remote URL and architecture.

    The user and the system installation usually both carry Flathub. Their
    AppStream checkouts are two revisions of ONE catalogue, so parsing both
    doubled a cold build (measured 3.2 s -> 6.2 s) to produce the same apps
    twice. A source with a known URL is compared with every other source of
    that URL: the revision checked out last wins (Flathub's AppStream only
    moves forward), and a tie goes to the user installation, which is where
    Mo Store installs. A source with no known URL (an explicit
    --appstream-root fixture) is never merged away. Returns (kept, superseded);
    each superseded source names the path that replaced it.
    """

    groups: dict[tuple[str, str], list[dict]] = {}
    kept: list[dict] = []
    for source in sources:
        url = source.get("url")
        if not url:
            kept.append(source)
            continue
        groups.setdefault((url, source["arch"]), []).append(source)
    superseded: list[dict] = []
    for members in groups.values():
        ordered = sorted(
            members,
            key=lambda item: (
                item.get("revision_mtime_ns") or 0,
                item["scope"] == "user",
                str(item["path"]),
            ),
            reverse=True,
        )
        winner = ordered[0]
        kept.append(winner)
        for loser in ordered[1:]:
            superseded.append(dict(loser, superseded_by=str(winner["path"])))
    order = {id(source): index for index, source in enumerate(sources)}
    kept.sort(key=lambda item: order.get(id(item), 0))
    return kept, superseded


def deployed_origin(active: Path) -> str:
    deploy = active / "deploy"
    try:
        if not deploy.is_file() or not is_within(deploy.resolve(), active.resolve()):
            return ""
        with deploy.open("rb") as handle:
            prefix = handle.read(256).split(b"\0", 1)[0]
        value = prefix.decode("ascii")
    except (OSError, UnicodeError):
        return ""
    return value if REMOTE_RE.fullmatch(value) else ""


def scan_installed(roots: list[tuple[Path, str]]) -> dict[str, list[dict]]:
    installed: dict[str, list[dict]] = {}
    for root, scope in roots:
        app_root = root / "app"
        if not app_root.is_dir():
            continue
        try:
            ids = sorted(app_root.iterdir(), key=lambda path: path.name)
        except OSError:
            continue
        for id_dir in ids:
            app_id = id_dir.name
            if not id_dir.is_dir() or not valid_flatpak_id(app_id):
                continue
            try:
                arch_dirs = id_dir.iterdir()
            except OSError:
                continue
            for arch_dir in arch_dirs:
                if not arch_dir.is_dir() or not REF_PART_RE.fullmatch(arch_dir.name):
                    continue
                try:
                    branches = arch_dir.iterdir()
                except OSError:
                    continue
                for branch_dir in branches:
                    if (
                        not branch_dir.is_dir()
                        or not REF_PART_RE.fullmatch(branch_dir.name)
                    ):
                        continue
                    active = branch_dir / "active"
                    try:
                        resolved_active = active.resolve()
                        is_deployed = active.exists() and is_within(
                            resolved_active, branch_dir.resolve()
                        )
                    except OSError:
                        is_deployed = False
                    if not is_deployed:
                        continue
                    installed.setdefault(app_id, []).append(
                        {
                            "origin": deployed_origin(active),
                            "scope": scope,
                            "arch": arch_dir.name,
                            "branch": branch_dir.name,
                            # The deployed commit: what is installed changes with
                            # it (an update), and everything under it is immutable.
                            "commit": resolved_active.name,
                            "path": str(active),
                        }
                    )
    return installed


def installed_scopes_for_refs(refs: list[dict]) -> list[str]:
    """Return each installed Flatpak scope once, in stable lifecycle order."""

    return [
        scope
        for scope in ("user", "system")
        if any(item.get("scope") == scope for item in refs)
    ]


def safe_catalog_text(entry: dict, key: str, limit: int) -> str:
    value = entry.get(key, "")
    if value is None:
        return ""
    if not isinstance(value, str):
        raise CatalogError(f"catalog field {key!r} must be text")
    return clean_text(value, limit)


def catalog_string(raw: dict, key: str, limit: int, app_id: object, pattern=None) -> str:
    """One bounded text field; a wrong type or a pattern mismatch rejects the entry."""

    value = safe_catalog_text(raw, key, limit)
    if value and pattern is not None and not pattern.fullmatch(value):
        raise CatalogError(f"catalog {key} for {app_id!r} is invalid")
    return value


def catalog_text_list(raw: dict, key: str, app_id: object, *, limit: int,
                      count: int, pattern=None) -> list[str]:
    value = raw.get(key)
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise CatalogError(f"catalog {key} for {app_id!r} must be a list of text")
    result: list[str] = []
    for item in value:
        clean = clean_text(item, limit)
        if not clean:
            continue
        if pattern is not None and not pattern.fullmatch(clean):
            raise CatalogError(f"catalog {key} entry {clean!r} for {app_id!r} is invalid")
        if clean not in result:
            result.append(clean)
    return result[:count]


def safe_relative_path(value: object, field: str, app_id: object) -> str:
    """A path inside an unpacked download: relative, no `..`, nothing a shell or a
    launcher could misread. The backend joins it to a directory it created itself."""

    if not isinstance(value, str) or not value or len(value) > 255 or value != value.strip():
        raise CatalogError(f"catalog {field} for {app_id!r} is invalid")
    if any(unicodedata.category(char) in {"Cc", "Cf", "Cs", "Zl", "Zp"} for char in value):
        raise CatalogError(f"catalog {field} for {app_id!r} is invalid")
    if value.startswith("/") or any(char in value for char in '\\:*?"<>|'):
        raise CatalogError(f"catalog {field} for {app_id!r} is invalid")
    if any(part in {"", ".", ".."} for part in value.split("/")):
        raise CatalogError(f"catalog {field} for {app_id!r} is invalid")
    return value


def sanitize_downloads(raw: dict, app_id: object, *, only: set[str] | None = None) -> dict:
    """{arch: {url, sha256, size}}: the publisher's own HTTPS file, pinned."""

    value = raw.get("downloads")
    if not isinstance(value, dict) or not value:
        raise CatalogError(f"catalog downloads for {app_id!r} must be a non-empty object")
    result: dict[str, dict] = {}
    for arch, item in value.items():
        if not isinstance(arch, str) or not REF_PART_RE.fullmatch(arch):
            raise CatalogError(f"catalog download architecture for {app_id!r} is invalid")
        if only is not None and arch not in only:
            raise CatalogError(f"catalog download architecture {arch!r} for {app_id!r} "
                               "is not supported")
        if not isinstance(item, dict):
            raise CatalogError(f"catalog download for {app_id!r} must be an object")
        url = safe_https_url(safe_catalog_text(item, "url", 2048))
        if not url:
            raise CatalogError(f"catalog URL for {app_id!r} is not safe HTTPS")
        digest = safe_catalog_text(item, "sha256", 64)
        if not SHA256_RE.fullmatch(digest):
            raise CatalogError(f"catalog SHA-256 for {app_id!r} is invalid")
        size = item.get("size")
        if (isinstance(size, bool) or not isinstance(size, int)
                or not 0 < size <= MAX_PINNED_DOWNLOAD):
            raise CatalogError(f"catalog download size for {app_id!r} is invalid")
        result[arch] = {"url": url, "sha256": digest.lower(), "size": size}
    return dict(sorted(result.items()))


def webapp_host_matches(host: str, patterns: list[str]) -> bool:
    """`*.example.com` matches every subdomain of example.com, not example.com itself."""

    host = host.lower().rstrip(".")
    for pattern in patterns:
        if pattern.startswith("*."):
            suffix = pattern[1:]
            if host.endswith(suffix) and len(host) > len(suffix):
                return True
        elif host == pattern:
            return True
    return False


def webapp_url_ok(url: object) -> bool:
    """moos_webapp_policy.parse_entry's address rule: HTTPS, a host, no credentials,
    port 443 at most, no backslash, no whitespace or control character."""

    if not isinstance(url, str) or len(url) > 2048:
        return False
    try:
        parts = urlsplit(url)
        port = parts.port
    except ValueError:
        return False
    return (parts.scheme == "https" and bool(parts.hostname) and not parts.username
            and not parts.password and port in (None, 443) and "\\" not in url
            and not any(char <= " " or char == "\x7f" for char in url))


def sanitize_webapp_install(raw: dict, app_id: object, url: str) -> dict:
    """The fields of a web app, by the rules of usr/lib/moos/moos_webapp_policy.py."""

    if not url:
        raise CatalogError(f"catalog web app {app_id!r} has no HTTPS address")
    hosts = catalog_text_list(raw, "hosts", app_id, limit=253, count=1000)
    if not hosts or len(hosts) > 24:
        raise CatalogError(f"catalog hosts for {app_id!r} must list 1 to 24 hosts")
    hosts = [host.lower() for host in hosts]
    if not all(WEBAPP_HOST_RE.fullmatch(host) for host in hosts):
        raise CatalogError(f"catalog hosts for {app_id!r} are invalid")
    start_host = urlsplit(url).hostname or ""
    if not webapp_host_matches(start_host, hosts):
        raise CatalogError(f"catalog web app {app_id!r} starts outside its hosts")
    identity = catalog_text_list(raw, "identity", app_id, limit=16, count=8)
    if any(item not in WEBAPP_IDENTITY for item in identity):
        raise CatalogError(f"catalog identity for {app_id!r} is invalid")
    raw_permissions = raw.get("permissions", [])
    if isinstance(raw_permissions, list) and len(set(map(str, raw_permissions))) != len(
        raw_permissions
    ):
        raise CatalogError(f"catalog permissions for {app_id!r} repeat")
    permissions = catalog_text_list(raw, "permissions", app_id, limit=16, count=8)
    if any(item not in WEBAPP_PERMISSIONS for item in permissions):
        raise CatalogError(f"catalog permissions for {app_id!r} are invalid")
    result: dict = {"hosts": hosts, "identity": identity, "permissions": permissions}
    accent = catalog_string(raw, "accent", 7, app_id, ACCENT_RE)
    if accent:
        result["accent"] = accent.lower()
    return result


def sanitize_appdrop_install(raw: dict, app_id: object) -> dict:
    artifact = catalog_string(raw, "artifact", 16, app_id)
    if artifact not in APPDROP_ARTIFACTS:
        raise CatalogError(f"catalog artifact for {app_id!r} must be appimage or archive")
    result: dict = {"artifact": artifact, "downloads": sanitize_downloads(raw, app_id)}
    desktop_id = catalog_string(raw, "desktop_id", 255, app_id)
    if desktop_id:
        if not valid_flatpak_id(desktop_id):
            raise CatalogError(f"catalog desktop_id for {app_id!r} is invalid")
        result["desktop_id"] = desktop_id
    wm_class = catalog_string(raw, "wm_class", 80, app_id, WM_CLASS_RE)
    if wm_class:
        result["wm_class"] = wm_class
    for field in ("exec", "icon"):
        if raw.get(field) is not None:
            result[field] = safe_relative_path(raw.get(field), field, app_id)
    categories = raw.get("categories")
    if isinstance(categories, str):
        categories = [item for item in categories.split(";") if item.strip()]
        raw = dict(raw, categories=categories)
    names = catalog_text_list(raw, "categories", app_id, limit=64, count=8,
                              pattern=DESKTOP_CATEGORY_RE)
    if names:
        result["categories"] = names
    return result


def sanitize_windows_install(raw: dict, app_id: object) -> dict:
    result: dict = {"downloads": sanitize_downloads(raw, app_id, only={"x86_64"})}
    exe = safe_relative_path(raw.get("exe"), "exe", app_id)
    if not exe.casefold().endswith(".exe"):
        raise CatalogError(f"catalog exe for {app_id!r} must name a .exe program")
    result["exe"] = exe
    wm_class = catalog_string(raw, "wm_class", 80, app_id, WM_CLASS_RE)
    if wm_class:
        result["wm_class"] = wm_class
    return result


def sanitize_install(entry: dict, app_id: str) -> dict:
    raw = entry.get("install")
    if raw is None:
        return {}
    if not isinstance(raw, dict):
        raise CatalogError(f"catalog install recipe for {app_id!r} must be an object")
    kind = safe_catalog_text(raw, "kind", 32)
    if not SLUG_RE.fullmatch(kind):
        raise CatalogError(f"catalog install kind for {app_id!r} is invalid")
    if kind in RETIRED_INSTALL_KINDS:
        raise CatalogError(f"catalog install kind {kind!r} for {app_id!r} is retired")
    if kind not in INSTALL_KIND_INDEX:
        raise CatalogError(f"catalog install kind {kind!r} for {app_id!r} is not supported")

    result = {"kind": kind}
    if kind == "webapp":
        # A web app's start address is checked by moos_webapp_policy.parse_entry's
        # own rules, byte for byte as the catalogue holds it (a `#/route` start is
        # legitimate there), and must lie inside the app's hosts (below).
        url_value = raw.get("url")
        if not webapp_url_ok(url_value):
            raise CatalogError(f"catalog URL for {app_id!r} is not safe HTTPS")
        result["url"] = url_value
    else:
        url_value = safe_catalog_text(raw, "url", 2048)
        if url_value:
            safe_url = safe_https_url(url_value)
            if not safe_url:
                raise CatalogError(f"catalog URL for {app_id!r} is not safe HTTPS")
            result["url"] = safe_url

    package = safe_catalog_text(raw, "pkg", 180)
    if package:
        if not NPM_PACKAGE_RE.fullmatch(package):
            raise CatalogError(f"catalog package for {app_id!r} is invalid")
        result["pkg"] = package

    android_package = safe_catalog_text(raw, "package", 255)
    if android_package:
        if not ANDROID_PACKAGE_RE.fullmatch(android_package):
            raise CatalogError(
                f"catalog Android package for {app_id!r} is invalid"
            )
        result["package"] = android_package

    binary = safe_catalog_text(raw, "bin", 128)
    if binary:
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", binary):
            raise CatalogError(f"catalog binary for {app_id!r} is invalid")
        result["bin"] = binary

    name = safe_catalog_text(raw, "name", 160)
    if name:
        result["name"] = name
    version = safe_catalog_text(raw, "version", 80)
    if version:
        if kind in {"appdrop", "windows-portable", "android"} and not VERSION_RE.fullmatch(
            version
        ):
            raise CatalogError(f"catalog version for {app_id!r} is invalid")
        result["version"] = version
    digest = safe_catalog_text(raw, "sha256", 64)
    if digest:
        if not SHA256_RE.fullmatch(digest):
            raise CatalogError(f"catalog SHA-256 for {app_id!r} is invalid")
        result["sha256"] = digest.lower()
    risk = safe_catalog_text(raw, "risk", 64)
    if risk:
        if not SLUG_RE.fullmatch(risk):
            raise CatalogError(f"catalog risk for {app_id!r} is invalid")
        result["risk"] = risk
    for key in ("requires_review", "external"):
        if key in raw:
            if not isinstance(raw[key], bool):
                raise CatalogError(
                    f"catalog install field {key!r} for {app_id!r} is invalid"
                )
            result[key] = raw[key]

    if kind == "webapp":
        result.update(sanitize_webapp_install(raw, app_id, result.get("url", "")))
    elif kind == "appdrop":
        result.update(sanitize_appdrop_install(raw, app_id))
    elif kind == "windows-portable":
        result.update(sanitize_windows_install(raw, app_id))
    elif kind == "android" and raw.get("size") is not None:
        size = raw.get("size")
        if (isinstance(size, bool) or not isinstance(size, int)
                or not 0 < size <= MAX_PINNED_DOWNLOAD):
            raise CatalogError(f"catalog size for {app_id!r} is invalid")
        result["size"] = size
    return result


def sanitize_catalog_app(entry: object) -> dict:
    if not isinstance(entry, dict):
        raise CatalogError("every catalog app must be an object")
    app_id = entry.get("id")
    source = safe_catalog_text(entry, "source", 32)
    if not SLUG_RE.fullmatch(source):
        raise CatalogError(f"catalog source for {app_id!r} is invalid")
    if source not in CATALOG_SOURCES:
        raise CatalogError(f"catalog source {source!r} for {app_id!r} is not supported")
    if source in {"flathub", "flatpak"}:
        if not valid_flatpak_id(app_id):
            raise CatalogError(f"catalog Flatpak id {app_id!r} is invalid")
    elif not valid_generic_id(app_id):
        raise CatalogError(f"catalog app id {app_id!r} is invalid")

    result: dict = {"id": app_id, "source": source}
    # OPTIONAL "arch": the architectures on which this app actually EXISTS.
    # Absent means "everywhere", which is the ordinary case and keeps every
    # existing entry valid. It is a whitelist, not a hint: an app that names
    # architectures is offered on those and nowhere else.
    raw_arch = entry.get("arch")
    if raw_arch is not None:
        if not isinstance(raw_arch, list) or not raw_arch:
            raise CatalogError(f"catalog arch for {app_id!r} must be a non-empty list")
        arches = []
        for item in raw_arch:
            if not isinstance(item, str) or not REF_PART_RE.fullmatch(item):
                raise CatalogError(f"catalog arch entry for {app_id!r} is invalid")
            arches.append(item)
        result["arch"] = arches
    for key, limit in (
        ("cat", 64),
        ("engine", 64),
        ("glyph", 64),
        ("en", 160),
        ("ar", 160),
        ("desc_en", 420),
        ("desc_ar", 420),
        ("reviews", 64),
        ("developer", 80),
    ):
        value = safe_catalog_text(entry, key, limit)
        if value:
            if key in {"cat", "engine"} and not SLUG_RE.fullmatch(value):
                raise CatalogError(f"catalog field {key!r} for {app_id!r} is invalid")
            if key == "glyph" and not GLYPH_RE.fullmatch(value):
                raise CatalogError(f"catalog glyph for {app_id!r} is invalid")
            result[key] = value
    # Short search words a person types for this app (PhotoCraft: photoshop, psd,
    # فوتوشوب); they feed the index's folded `search` string.
    for key in ("keywords_en", "keywords_ar"):
        words = catalog_text_list(entry, key, app_id, limit=40, count=MAX_KEYWORDS)
        if words:
            result[key] = words
    accent = catalog_string(entry, "accent", 7, app_id, ACCENT_RE)
    if accent:
        result["accent"] = accent.lower()

    rating = entry.get("rating")
    if rating is not None:
        if (
            isinstance(rating, bool)
            or not isinstance(rating, (int, float))
            or not 0 <= rating <= 5
        ):
            raise CatalogError(f"catalog rating for {app_id!r} is invalid")
        result["rating"] = rating
    for key in ("popular", "preselect"):
        if key in entry:
            if not isinstance(entry[key], bool):
                raise CatalogError(f"catalog field {key!r} for {app_id!r} is invalid")
            result[key] = entry[key]

    install = sanitize_install(entry, app_id)
    if source == "moos":
        if not install:
            raise CatalogError(f"catalog app {app_id!r} has no install recipe")
        if install["kind"] == "webapp":
            if not WEBAPP_ID_RE.fullmatch(app_id):
                raise CatalogError(f"catalog web app id {app_id!r} is invalid")
            if not result.get("en"):
                raise CatalogError(f"catalog web app {app_id!r} has no English name")
    if install:
        result["install"] = install
    return result


def sanitize_catalog_group(entry: object, kind: str) -> dict:
    if not isinstance(entry, dict):
        raise CatalogError(f"every catalog {kind} must be an object")
    group_id = safe_catalog_text(entry, "id", 64)
    if not SLUG_RE.fullmatch(group_id):
        raise CatalogError(f"catalog {kind} id {group_id!r} is invalid")
    result = {"id": group_id}
    for key, limit in (
        ("en", 160),
        ("ar", 160),
        ("glyph", 64),
        ("desc_en", 420),
        ("desc_ar", 420),
    ):
        value = safe_catalog_text(entry, key, limit)
        if value:
            if key == "glyph" and not GLYPH_RE.fullmatch(value):
                raise CatalogError(f"catalog glyph for {group_id!r} is invalid")
            result[key] = value
    if kind in {"bundle", "collection"}:
        raw_apps = entry.get("apps", [])
        if not isinstance(raw_apps, list) or not all(
            valid_generic_id(item) for item in raw_apps
        ):
            raise CatalogError(f"catalog {kind} apps for {group_id!r} are invalid")
        result["apps"] = list(dict.fromkeys(raw_apps))
    if kind == "collection":
        if not result.get("en") or not result.get("ar"):
            raise CatalogError(f"catalog collection {group_id!r} needs both names")
        result["apps"] = result["apps"][:24]
    return result


def sanitize_featured(entry: object) -> dict:
    """One hero card: {app, title_en, title_ar, tagline_en, tagline_ar, accent?}."""

    if not isinstance(entry, dict):
        raise CatalogError("every featured entry must be an object")
    app_id = entry.get("app")
    if not valid_generic_id(app_id):
        raise CatalogError(f"featured app {app_id!r} is invalid")
    result: dict = {"app": app_id}
    for key, limit in (("title_en", 120), ("title_ar", 120), ("tagline_en", 240),
                       ("tagline_ar", 240)):
        value = safe_catalog_text(entry, key, limit)
        if value:
            result[key] = value
    if not result.get("title_en") or not result.get("title_ar"):
        raise CatalogError(f"featured entry for {app_id!r} needs both titles")
    accent = catalog_string(entry, "accent", 7, app_id, ACCENT_RE)
    if accent:
        result["accent"] = accent.lower()
    return result


def running_arch() -> str:
    """The Flatpak architecture name for this machine.

    Flatpak's own spelling, not uname's: aarch64 and x86_64 agree, but 32-bit ARM
    is "arm" to Flatpak and "armv7l" to uname. Anything unrecognised is returned
    unchanged, which makes an unknown machine offer the whole catalogue rather
    than an empty store.
    """
    machine = platform.machine()
    return {"armv7l": "arm", "armv8l": "arm", "i686": "i386"}.get(machine, machine)


DEFAULT_ENGINES = Path("/usr/share/moos/app-engines.json")

# Where a Flatpak runtime shows up once it is installed, for either scope.
FLATPAK_EXPORTS = (
    Path("/var/lib/flatpak/exports/share/applications"),
    Path.home() / ".local/share/flatpak/exports/share/applications",
)


def engine_runtime_available(runtime: dict) -> bool:
    """Is this ONE runtime actually present on this machine?

    The registry already describes how to tell: `probe` names a binary, and a
    Flatpak carrier is present when its export exists. Probing beats hardcoding
    an architecture, because it also becomes true on its own the day an edition
    starts shipping the runtime.
    """
    probe = runtime.get("probe")
    if isinstance(probe, str) and probe:
        return shutil.which(probe) is not None
    if runtime.get("carrier") == "flatpak":
        app_id = runtime.get("id")
        if not isinstance(app_id, str) or not app_id:
            return False
        return any((directory / f"{app_id}.desktop").is_file()
                   for directory in FLATPAK_EXPORTS)
    return False


def available_engines(path: Path = DEFAULT_ENGINES) -> set[str] | None:
    """Engine ids with at least one runtime this machine can actually use.

    Returns None — not an empty set — when the registry cannot be read. The
    caller must then filter NOTHING. An empty set would be indistinguishable
    from "this machine runs nothing" and would silently empty whole Store
    categories; offering one thing too many is the far better failure, and it is
    the one the owner can see.
    """
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
        engines = document["engines"]
    except (OSError, UnicodeError, json.JSONDecodeError, KeyError, TypeError):
        return None
    if not isinstance(engines, list):
        return None
    ready = set()
    for engine in engines:
        if not isinstance(engine, dict) or not isinstance(engine.get("id"), str):
            continue
        runtimes = engine.get("runtimes")
        if not isinstance(runtimes, list) or not runtimes:
            continue
        if any(isinstance(item, dict) and engine_runtime_available(item)
               for item in runtimes):
            ready.add(engine["id"])
    return ready


def catalog_app_engine(entry: dict) -> str:
    """The engine an entry needs, declared or implied by how it installs."""
    declared = entry.get("engine")
    if isinstance(declared, str) and declared:
        return declared
    install = entry.get("install")
    kind = install.get("kind") if isinstance(install, dict) else None
    if kind == "android":
        return "android"
    if kind == "windows-portable":
        return "windows"
    return ""


def catalog_kind(entry: dict) -> str:
    """The index `kind` of a catalogue entry (docs/MO_STORE.md, "Kinds of app")."""

    if entry.get("source") in {"flathub", "flatpak"}:
        return "flatpak"
    install = entry.get("install")
    kind = install.get("kind") if isinstance(install, dict) else None
    return INSTALL_KIND_INDEX.get(kind, "") if isinstance(kind, str) else ""


def catalog_app_runs_here(entry: dict, arch: str) -> bool:
    """An entry with no declared arch runs everywhere; otherwise it must name this one."""
    declared = entry.get("arch")
    if not declared:
        return True
    return arch in declared


def log(message: str) -> None:
    """One line on stderr; the launcher keeps it in ~/.cache/moos-store/index.log."""

    print(f"moos-store-index: {message}", file=sys.stderr)


def catalog_entry_label(item: object, position: int) -> str:
    if isinstance(item, dict):
        for key in ("id", "app"):
            value = item.get(key)
            if isinstance(value, str) and value:
                return clean_text(value, 80)
    return f"#{position}"


def sanitize_catalog_section(
    raw: dict, section: str, sanitize, skipped: list[dict]
) -> list[dict]:
    """Sanitise every entry of one catalogue list, skipping a bad one with a reason.

    One malformed or unsafe entry used to raise CatalogError out of the whole
    load, so a single typo in a signed catalogue update meant no index at all:
    every Flathub app vanished with it. An entry that fails its checks is now
    left out, the reason is logged, and everything else is offered. The build
    gate (build_files/verify_store_catalog.py) still refuses such a catalogue
    before it ships; this is the runtime's defence in depth, never a substitute.
    """

    items = raw.get(section, [])
    if items is None:
        return []
    if not isinstance(items, list):
        log(f"catalogue {section} is not a list; ignored")
        skipped.append({"section": section, "id": "", "reason": "not a list"})
        return []
    result: list[dict] = []
    seen: set[str] = set()
    for position, item in enumerate(items):
        label = catalog_entry_label(item, position)
        try:
            clean = sanitize(item)
        except CatalogError as error:
            reason = clean_text(str(error), 240)
            log(f"skipped catalogue {section} entry {label}: {reason}")
            skipped.append({"section": section, "id": label, "reason": reason})
            continue
        key = clean.get("id") or clean.get("app") or ""
        if key in seen:
            log(f"skipped catalogue {section} entry {label}: duplicate id")
            skipped.append({"section": section, "id": label, "reason": "duplicate id"})
            continue
        seen.add(key)
        result.append(clean)
    return result


def load_catalog(path: Path, arch: str | None = None,
                 engines: set[str] | None = None) -> dict:
    """Read the curated catalogue, keeping only what a machine can actually use.

    PURE ON PURPOSE. It probes nothing: `arch` and `engines` describe the target
    machine and both default to None, which filters nothing. main() is what asks
    the real machine, through running_arch() and available_engines().

    An earlier draft probed here instead, and `just check` caught it within the
    hour: tests/test_moos_store_index.py passed inside the Flatpak SDK sandbox
    (no /usr/share/moos, so no engines could be read) and failed on the host
    (aarch64, no wine or waydroid, so the Android recipe was filtered away). A
    library function whose result depends on the developer's own machine cannot
    be tested, and CI would only have agreed with it by luck -- the x86 runners
    happen to have both engines.

    Only a catalogue that cannot be read at all (missing, not JSON, not an
    object, no apps list) raises CatalogError. A bad ENTRY is skipped and listed
    in the result's `skipped` (see sanitize_catalog_section).
    """
    try:
        with path.open(encoding="utf-8") as handle:
            raw = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise CatalogError(f"cannot read catalog {path}: {error}") from error
    if not isinstance(raw, dict):
        raise CatalogError("catalog root must be an object")
    raw_apps = raw.get("apps")
    if not isinstance(raw_apps, list):
        raise CatalogError("catalog apps must be a list")

    skipped: list[dict] = []
    apps = sanitize_catalog_section(raw, "apps", sanitize_catalog_app, skipped)
    # Drop what this machine cannot install, ONCE, so every later pass over
    # catalog["apps"] agrees: the fallback that invents an index entry, the
    # overlay that decorates a real one, and the non-Flatpak lifecycle scan.
    #
    # THE DEFECT, measured on the Oracle A1 on 2026-09-21: eleven of the
    # thirty-three Flathub apps this catalogue offers have no aarch64 build at
    # all, and two of them (Steam, Spotify) carry "popular": true. Because
    # apps_by_id is built from the running architecture's AppStream, those
    # eleven never matched, so catalog_fallback_app() MANUFACTURED an index
    # entry for each one. All eleven appeared in the ARM Store's index of 2941
    # apps, and `flatpak remote-info flathub com.spotify.Client --arch=aarch64`
    # answers "Can't find ref". Eleven dead buttons, two of them promoted.
    if arch:
        apps = [item for item in apps if catalog_app_runs_here(item, arch)]
    # AND what this machine has an ENGINE for. app-engines.json is MoOS's single
    # source of truth for what it can run, and it already says how to tell: each
    # runtime carries a `probe`. Measured on the A1 2026-09-21: neither wine nor
    # waydroid is in the ARM image (`rpm -q` says not installed and neither is on
    # PATH), so the windows and android engines have NO runtime there -- while the
    # Store still offered 8 Windows programs and 7 Android apps, and
    # `moai-do setup-windows` refuses on ARM outright while `setup-waydroid`
    # dead-ends with "waydroid not found". Probing beats naming architectures: the
    # day an edition ships the runtime, its apps come back on their own.
    if engines is not None:
        apps = [item for item in apps
                if catalog_app_engine(item) in ("", *engines)]
    offered = {item["id"] for item in apps}
    categories = sanitize_catalog_section(
        raw, "categories", lambda item: sanitize_catalog_group(item, "category"), skipped
    )
    bundles = sanitize_catalog_section(
        raw, "bundles", lambda item: sanitize_catalog_group(item, "bundle"), skipped
    )
    # A bundle is a curated SET, so it has to be re-checked against what survived.
    # On aarch64 "Gaming Starter" lost five of its six apps (Steam, Bottles,
    # Lutris, Heroic, Discord), which would have left a gaming bundle offering
    # one compatibility tool. Fewer than two members is no longer the thing that
    # was curated, so it is not offered — which is also what MoOS already does
    # elsewhere on ARM, where `moai-do` refuses PC-gaming setup outright.
    for bundle in bundles:
        members = bundle.get("apps")
        if isinstance(members, list):
            bundle["apps"] = [app_id for app_id in members if app_id in offered]
    bundles = [
        bundle for bundle in bundles
        if not isinstance(bundle.get("apps"), list) or len(bundle["apps"]) >= 2
    ]
    # Discover's editorial rows and hero cards. They may name any app, including
    # Flathub apps the catalogue does not curate, so membership is settled by
    # build_index() against the finished index, not here.
    collections = sanitize_catalog_section(
        raw, "collections", lambda item: sanitize_catalog_group(item, "collection"), skipped
    )
    featured = sanitize_catalog_section(raw, "featured", sanitize_featured, skipped)
    return {"apps": apps, "categories": categories, "bundles": bundles,
            "collections": collections, "featured": featured,
            "engines_ready": engines, "arch": arch, "skipped": skipped}


def catalog_localized(entry: dict, preferences: list[str], prefix: str = "") -> str:
    values = {}
    for language in ("en", "ar"):
        key = f"{prefix}{language}"
        value = entry.get(key, "")
        if value:
            values[language] = value
    return pick_localized(values, preferences)


def catalog_installable(entry: dict, arch: str | None = None) -> bool:
    """Can the backend carry out this entry's recipe here? `arch` None: anywhere."""

    if entry["source"] in {"flathub", "flatpak"}:
        return True
    install = entry.get("install", {})
    kind = install.get("kind")
    if kind == "npm":
        return bool(install.get("pkg") and install.get("bin"))
    if kind == "web":
        return bool(install.get("url"))
    if kind == "android":
        return bool(
            install.get("url")
            and install.get("sha256")
            and install.get("package") == entry.get("id")
        )
    if kind == "webapp":
        return bool(install.get("url") and install.get("hosts"))
    if kind in {"appdrop", "windows-portable"}:
        downloads = install.get("downloads") or {}
        if kind == "windows-portable" and not install.get("exe"):
            return False
        if kind == "appdrop" and install.get("artifact") not in APPDROP_ARTIFACTS:
            return False
        return bool(downloads) and (arch is None or arch in downloads)
    return False


# ── What is installed, for every kind ────────────────────────────────────────
# All of it is read from files the installers write, never by running anything:
#   flatpak   deployments under <installation>/app (both scopes) and flatpak's own
#             deploy data (installed version, end of life) beside each one;
#   webapp    ~/.local/share/applications/org.moos.webapp.<id>.desktop holding
#             X-MoOS-WebApp=<id> (usr/lib/moos/moos_webapp_policy.is_installed);
#   appdrop   the App Drop record ~/.local/share/moos/appdrop/<id>.json, which a
#             catalogue install marks with catalog_id=<id>;
#   windows   the record ~/.local/share/moos/windows-apps/<id>.json;
#   android   the per-package data directory the Android runtime creates;
#   npm       the command in ~/.local/bin;
#   web       never installed: it opens the publisher's page.
# An App Drop record with no catalogue id is an app of its own, kind "dropped";
# a Flatpak that no listed entry covers (AppStream dropped it, or it is not an
# app the Store offers) is listed as installed so it can still be found and
# removed. Both carry listed=false and installable=false.

RECORD_LIMIT = 64 * 1024
TEXT_FILE_LIMIT = 256 * 1024
DROP_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,63}$")
ICON_SUFFIXES = (".png", ".svg", ".svgz", ".jpg", ".jpeg", ".webp", ".xpm")
EXPORTED_ICON_SIZES = ("128x128", "256x256", "scalable", "512x512", "96x96", "64x64",
                       "48x48")


def home_dir() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def data_home() -> Path:
    """$XDG_DATA_HOME when absolute, else ~/.local/share: where App Drop and the web
    app runtime write (usr/lib/moos/moos_appdrop.py, moos_webapp_policy.py)."""

    configured = os.environ.get("XDG_DATA_HOME", "")
    return Path(configured) if configured and Path(configured).is_absolute() \
        else home_dir() / ".local/share"


def read_small_text(path: Path, limit: int = TEXT_FILE_LIMIT) -> str:
    try:
        with path.open("rb") as handle:
            data = handle.read(limit + 1)
    except OSError:
        return ""
    if len(data) > limit:
        return ""
    return data.decode("utf-8", errors="replace")


def read_record(path: Path) -> dict | None:
    text = read_small_text(path, RECORD_LIMIT)
    if not text:
        return None
    try:
        value = json.loads(text)
    except ValueError:
        return None
    return value if isinstance(value, dict) else None


def record_text(record: dict, key: str, limit: int) -> str:
    value = record.get(key)
    return clean_text(value, limit) if isinstance(value, str) else ""


def desktop_entry_fields(text: str) -> dict[str, str]:
    """The [Desktop Entry] keys of a launcher (first value wins), unescaped."""

    fields: dict[str, str] = {}
    section = ""
    for line in text.splitlines()[:2000]:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            section = line
            continue
        if section != "[Desktop Entry]" or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        if key and key not in fields:
            fields[key] = (value.strip().replace("\\s", " ").replace("\\n", " ")
                           .replace("\\t", " ").replace("\\r", " ").replace("\\\\", "\\"))
    return fields


def desktop_localized(fields: dict[str, str], key: str, preferences: list[str],
                      limit: int) -> tuple[str, str]:
    """(localized value, untranslated value) of a launcher key such as Name."""

    values: dict[str, str] = {}
    for field, value in fields.items():
        if field == key:
            language = ""
        elif field.startswith(key + "[") and field.endswith("]"):
            language = normalized_locale(field[len(key) + 1:-1])
            if not language:
                continue
        else:
            continue
        clean = clean_text(value, limit)
        if clean and language not in values:
            values[language] = clean
    return pick_localized(values, preferences), values.get("", "")


def home_file_icon(value: str) -> str | None:
    """A launcher's Icon= that is an image file under the person's home, as file://."""

    if not value or not value.startswith("/") or "\n" in value:
        return None
    try:
        resolved = Path(value).resolve(strict=True)
        home = home_dir().resolve()
    except (OSError, RuntimeError):
        return None
    if (not is_within(resolved, home) or not resolved.is_file()
            or resolved.suffix.casefold() not in ICON_SUFFIXES):
        return None
    return Path(value).as_uri()


def launcher_for_record(record: dict, slug: str) -> Path | None:
    """The launcher App Drop wrote for a record, inside the person's applications."""

    applications = data_home() / "applications"
    candidates = []
    stored = record.get("desktop")
    if isinstance(stored, str) and stored.endswith(".desktop"):
        candidates.append(Path(stored))
    candidates.append(applications / f"appdrop-{slug}.desktop")
    try:
        base = applications.resolve()
    except (OSError, RuntimeError):
        return None
    for candidate in candidates:
        try:
            resolved = candidate.resolve(strict=True)
        except (OSError, RuntimeError):
            continue
        if is_within(resolved, base) and resolved.is_file():
            return candidate
    return None


def version_parts(value: str) -> list:
    return [int(part) if part.isdigit() else part.casefold()
            for part in re.findall(r"\d+|[A-Za-z]+", value)]


def version_newer(candidate: str, installed: str) -> bool:
    """Is `candidate` a later version than `installed`? 1.10 > 1.9; 1.0 > 1.0-beta."""

    left, right = version_parts(candidate), version_parts(installed)
    for a, b in zip(left, right):
        if a == b:
            continue
        if isinstance(a, int) and isinstance(b, int):
            return a > b
        if isinstance(a, int):
            return True
        if isinstance(b, int):
            return False
        return a > b
    if len(left) == len(right):
        return False
    longer_is_candidate = len(left) > len(right)
    first_extra = (left if longer_is_candidate else right)[min(len(left), len(right))]
    # 1.0.1 is after 1.0, but 1.0-beta is before 1.0.
    return longer_is_candidate if isinstance(first_extra, int) else not longer_is_candidate


def catalog_install_state(entry: dict, arch: str | None = None) -> dict:
    """{installed, version, update, icon, adopted} of one catalogue entry, from files."""

    kind = catalog_kind(entry)
    install = entry.get("install") or {}
    app_id = entry["id"]
    state = {"installed": False, "version": None, "update": False, "icon": None,
             "adopted": False}
    if kind == "webapp":
        launcher = data_home() / "applications" / f"org.moos.webapp.{app_id}.desktop"
        if f"\nX-MoOS-WebApp={app_id}\n" in read_small_text(launcher):
            state["installed"] = True
            folder = data_home() / "moos/webapps" / app_id
            for name in ("icon.png", "icon.svg"):
                icon = home_file_icon(str(folder / name))
                if icon:
                    state["icon"] = icon
                    break
    elif kind == "appdrop":
        record = read_record(data_home() / "moos/appdrop" / f"{app_id}.json")
        if record is not None and record.get("id") == app_id:
            catalog_id = record.get("catalog_id")
            pinned = (install.get("downloads") or {}).get(arch or "", {})
            if catalog_id == app_id:
                state["installed"] = True
                state["version"] = record_text(record, "version", 64) or None
            elif not catalog_id:
                # Dropped by hand into the slot this catalogue app installs to
                # (~/Applications/<id>): the same app. The pinned digest names the
                # exact version when the file matches it byte for byte.
                state["installed"] = True
                state["adopted"] = True
                if pinned and record.get("sha256") == pinned.get("sha256"):
                    state["version"] = install.get("version")
            if state["installed"]:
                launcher = launcher_for_record(record, app_id)
                if launcher is not None:
                    fields = desktop_entry_fields(read_small_text(launcher))
                    state["icon"] = home_file_icon(fields.get("Icon", ""))
    elif kind == "windows":
        record = read_record(data_home() / "moos/windows-apps" / f"{app_id}.json")
        if record is not None and record.get("id", app_id) == app_id \
                and record.get("catalog_id", app_id) == app_id:
            state["installed"] = True
            state["version"] = record_text(record, "version", 64) or None
            icon = record.get("icon")
            if isinstance(icon, str):
                state["icon"] = home_file_icon(icon)
    elif kind == "android":
        package = install.get("package")
        # The runtime creates this per-package data directory only after the
        # package manager commits an installation, and removes it on uninstall.
        # Reading this local state keeps the indexer offline and avoids calling
        # (or exposing) the compatibility runtime for every Store refresh.
        if isinstance(package, str) and ANDROID_PACKAGE_RE.fullmatch(package):
            state["installed"] = (
                home_dir() / ".local/share/waydroid/data/data" / package
            ).is_dir()
    elif kind == "npm":
        binary = install.get("bin")
        if isinstance(binary, str) and binary:
            state["installed"] = (home_dir() / ".local/bin" / binary).is_file()
        package = install.get("pkg")
        if state["installed"] and isinstance(package, str) and NPM_PACKAGE_RE.fullmatch(package):
            manifest = read_record(home_dir() / ".local/lib/node_modules" / package
                                   / "package.json")
            if manifest is not None:
                state["version"] = record_text(manifest, "version", 64) or None
    pinned_version = install.get("version")
    if state["installed"] and state["version"] and isinstance(pinned_version, str):
        state["update"] = version_newer(pinned_version, state["version"])
    return state


def nonflatpak_installed(entry: dict) -> bool:
    return catalog_install_state(entry)["installed"]


def dropped_records(claimed: set[str]) -> list[dict]:
    """App Drop installs that no listed catalogue entry accounts for.

    `claimed` holds the ids of the catalogue entries in this index that own their
    App Drop record. A record whose catalogue entry is not offered here any more
    (dropped from the catalogue, or not for this machine) is still listed, so the
    app stays findable and removable.
    """

    folder = data_home() / "moos/appdrop"
    try:
        paths = sorted(folder.glob("*.json"))
    except OSError:
        return []
    found = []
    for path in paths:
        slug = path.stem
        if not DROP_SLUG_RE.fullmatch(slug) or slug in claimed:
            continue
        record = read_record(path)
        if record is None or record.get("id") != slug:
            continue
        launcher = launcher_for_record(record, slug)
        fields = desktop_entry_fields(read_small_text(launcher)) if launcher else {}
        categories = [item for item in fields.get("Categories", "").split(";")
                      if item and re.fullmatch(r"[A-Za-z0-9+_.-]{1,80}", item)]
        found.append({
            "slug": slug,
            "name": record_text(record, "name", 80) or clean_text(fields.get("Name", ""), 80)
            or slug,
            "comment": clean_text(fields.get("Comment", ""), 240),
            "icon": home_file_icon(fields.get("Icon", "")),
            "categories": categories[:8],
            "version": record_text(record, "version", 64) or None,
            "catalog_id": record_text(record, "catalog_id", 255) or None,
        })
    return found


def lifecycle_snapshot(catalog: dict) -> dict:
    """Every installed-state fact about non-Flatpak apps, read once per run.

    It is digested into the index's installed_token, so a change to any of it is
    noticed on the next run without parsing AppStream again.
    """

    arch = catalog.get("arch")
    states: dict[str, dict] = {}
    claimed: set[str] = set()
    for entry in catalog["apps"]:
        if entry["source"] in {"flathub", "flatpak"}:
            continue
        state = catalog_install_state(entry, arch)
        states[entry["id"]] = state
        if state["installed"] and catalog_kind(entry) == "appdrop":
            claimed.add(entry["id"])
    return {"catalog": states, "dropped": dropped_records(claimed)}


# ── flatpak's deploy data ────────────────────────────────────────────────────
# <deployment>/deploy is the GVariant (ssasta{sv}) flatpak writes when it deploys
# a commit: origin, commit, subpaths, installed size (big-endian by flatpak's own
# convention) and a metadata dictionary whose string values include appdata-name,
# appdata-summary, appdata-version, appdata-license and, for a retired app, eol or
# eolr. Read with a bounded, defensive reader: any surprise yields {}.

DEPLOY_DATA_LIMIT = 256 * 1024


def gvariant_offset_size(size: int) -> int:
    if size > 0xFFFFFFFF:
        return 8
    if size > 0xFFFF:
        return 4
    if size > 0xFF:
        return 2
    return 1 if size > 0 else 0


def gvariant_offset(data: bytes, position: int, size: int) -> int:
    if position < 0 or position + size > len(data):
        raise ValueError("GVariant offset outside its container")
    return int.from_bytes(data[position:position + size], "little")


def gvariant_align(position: int, alignment: int) -> int:
    return (position + alignment - 1) // alignment * alignment


def gvariant_string(data: bytes) -> str:
    if not data or data[-1] != 0 or 0 in data[:-1]:
        raise ValueError("GVariant string is not NUL-terminated")
    return data[:-1].decode("utf-8")


def gvariant_variable_array(data: bytes, alignment: int) -> list[bytes]:
    if not data:
        return []
    size = gvariant_offset_size(len(data))
    end_of_items = gvariant_offset(data, len(data) - size, size)
    if end_of_items > len(data) or (len(data) - end_of_items) % size:
        raise ValueError("GVariant array framing is invalid")
    count = (len(data) - end_of_items) // size
    items = []
    start = 0
    for number in range(count):
        end = gvariant_offset(data, end_of_items + number * size, size)
        start = gvariant_align(start, alignment)
        if not start <= end <= end_of_items:
            raise ValueError("GVariant array item is out of order")
        items.append(data[start:end])
        start = end
    return items


def parse_deploy_data(data: bytes) -> dict:
    size = len(data)
    framing = gvariant_offset_size(size)
    if framing == 0 or size < 3 * framing + 8:
        raise ValueError("deploy data is too short")
    origin_end = gvariant_offset(data, size - framing, framing)
    commit_end = gvariant_offset(data, size - 2 * framing, framing)
    subpaths_end = gvariant_offset(data, size - 3 * framing, framing)
    body_end = size - 3 * framing
    if not 0 < origin_end <= commit_end <= subpaths_end <= body_end:
        raise ValueError("deploy data framing is invalid")
    result: dict = {
        "origin": gvariant_string(data[:origin_end]),
        "commit": gvariant_string(data[origin_end:commit_end]),
    }
    size_at = gvariant_align(subpaths_end, 8)
    if size_at + 8 > body_end:
        raise ValueError("deploy data has no installed size")
    result["installed_size"] = int.from_bytes(data[size_at:size_at + 8], "big")
    metadata: dict[str, str] = {}
    for entry in gvariant_variable_array(data[gvariant_align(size_at + 8, 8):body_end], 8):
        entry_framing = gvariant_offset_size(len(entry))
        key_end = gvariant_offset(entry, len(entry) - entry_framing, entry_framing)
        if not 0 < key_end <= len(entry) - entry_framing:
            raise ValueError("deploy data entry is invalid")
        key = gvariant_string(entry[:key_end])
        variant = entry[gvariant_align(key_end, 8):len(entry) - entry_framing]
        separator = variant.rfind(b"\0")
        if separator < 0:
            raise ValueError("deploy data value has no type")
        if variant[separator + 1:] == b"s":
            metadata[key] = gvariant_string(variant[:separator])
    result["metadata"] = metadata
    return result


def read_deploy_data(active: Path) -> dict:
    """Parsed deploy data of one deployment, or {} when it cannot be read."""

    try:
        deploy = active / "deploy"
        if deploy.stat().st_size > DEPLOY_DATA_LIMIT:
            return {}
        return parse_deploy_data(deploy.read_bytes())
    except (OSError, ValueError, UnicodeDecodeError):
        return {}


def deploy_text(deploy: dict, key: str, limit: int) -> str:
    value = (deploy.get("metadata") or {}).get(key, "")
    return clean_text(value, limit) if isinstance(value, str) else ""


def deploy_localized(deploy: dict, key: str, preferences: list[str],
                     limit: int) -> tuple[str, str]:
    """(localized, untranslated) of appdata-name / appdata-summary; flatpak keeps
    every translation as `<key>@<lang>`."""

    values: dict[str, str] = {}
    for field, value in (deploy.get("metadata") or {}).items():
        if not isinstance(value, str):
            continue
        if field == key:
            language = ""
        elif field.startswith(key + "@"):
            language = normalized_locale(field[len(key) + 1:])
            if not language:
                continue
        else:
            continue
        clean = clean_text(value, limit)
        if clean and language not in values:
            values[language] = clean
    return pick_localized(values, preferences), values.get("", "")


def deploy_end_of_life(deploy: dict) -> bool:
    metadata = deploy.get("metadata") or {}
    return bool(metadata.get("eol") or metadata.get("eolr"))


def preferred_ref(refs: list[dict]) -> dict:
    return sorted(refs, key=lambda item: (item.get("scope") != "user",
                                          item.get("branch") != "stable",
                                          item.get("branch", "")))[0]


def exported_icon(active: Path, names: list[str]) -> str | None:
    """The deployment's own exported icon (hicolor), as a file:// URI through `active`."""

    base = active / "export/share/icons/hicolor"
    try:
        resolved_active = active.resolve()
    except (OSError, RuntimeError):
        return None
    for size in EXPORTED_ICON_SIZES:
        for name in names:
            if not name or not ICON_NAME_RE.fullmatch(name):
                continue
            for suffix in (".png", ".svg"):
                candidate = base / size / "apps" / f"{name}{suffix}"
                try:
                    resolved = candidate.resolve(strict=True)
                except (OSError, RuntimeError):
                    continue
                if is_within(resolved, resolved_active) and resolved.is_file():
                    return candidate.absolute().as_uri()
    return None


def installed_flatpak_entry(app_id: str, refs: list[dict], preferences: list[str]) -> dict:
    """An installed Flatpak no listed entry covers, from its own deployment."""

    ref = preferred_ref(refs)
    active = Path(ref.get("path", ""))
    deploy = read_deploy_data(active) if ref.get("path") else {}
    fields = desktop_entry_fields(
        read_small_text(active / "export/share/applications" / f"{app_id}.desktop")
    ) if ref.get("path") else {}
    # The deployment's own metadata first (AppStream's words, every language),
    # then its launcher, then the id.
    appdata_name, appdata_name_en = deploy_localized(deploy, "appdata-name", preferences, 160)
    appdata_summary, _ = deploy_localized(deploy, "appdata-summary", preferences, 240)
    desktop_name, desktop_name_en = desktop_localized(fields, "Name", preferences, 160)
    comment, _ = desktop_localized(fields, "Comment", preferences, 240)
    tail = app_id.rsplit(".", 1)[-1]
    categories = [item for item in fields.get("Categories", "").split(";")
                  if item and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+_.-]{0,79}", item)][:16]
    version = deploy_text(deploy, "appdata-version", 120)
    icon_name = fields.get("Icon", "").strip()
    summary = appdata_summary or comment
    return {
        "id": app_id,
        "source": "flatpak",
        "kind": "flatpak",
        "origin": ref.get("origin") or "",
        "scope": ref.get("scope", "user"),
        "installable": False,
        "listed": False,
        "flatpak_ref": f"app/{app_id}/{ref['arch']}/{ref['branch']}",
        "arch": ref["arch"],
        "branch": ref["branch"],
        "name": appdata_name or desktop_name or tail,
        "name_en": appdata_name_en or desktop_name_en or appdata_name or desktop_name or tail,
        "summary": summary,
        "description": summary,
        "developer": "",
        "license": deploy_text(deploy, "appdata-license", 160),
        "category": normalized_category(categories),
        "categories": categories,
        "icon": exported_icon(active, [icon_name, app_id]) if ref.get("path") else None,
        "screenshot": None,
        "verified": False,
        "installed": True,
        "version": version,
        "curated": False,
        "branding": None,
        "content_rating": None,
        "details": None,
        "origins": [],
    }


def dropped_entry(record: dict, app_id: str) -> dict:
    categories = record["categories"]
    return {
        "id": app_id,
        "slug": record["slug"],
        "source": "local",
        "kind": "dropped",
        "origin": "local",
        "scope": "user",
        "installable": False,
        "listed": False,
        "flatpak_ref": None,
        "arch": None,
        "branch": None,
        "name": record["name"],
        "name_en": record["name"],
        "summary": record["comment"],
        "description": record["comment"],
        "developer": "",
        "license": "",
        "category": normalized_category(categories),
        "categories": categories,
        "icon": record["icon"],
        "screenshot": None,
        "verified": False,
        "installed": True,
        "version": record["version"] or "",
        "curated": False,
        "branding": None,
        "content_rating": None,
        "details": None,
        "origins": [],
        "catalog_id": record["catalog_id"],
    }


LIFECYCLE_KEYS = ("installed_origin", "installed_scope", "installed_scopes")


def apply_lifecycle(apps: list[dict], *, installed: dict[str, list[dict]],
                    snapshot: dict, catalog: dict, preferences: list[str],
                    machine: dict | None = None, facts: dict | None = None) -> list[dict]:
    """Write what is installed into a list of index entries; return the new list.

    The ONE place installed state is decided, for a fresh build and for a cached
    index whose AppStream is unchanged alike, so the two can never disagree.
    Entries from an earlier pass that exist only because something was installed
    (listed=false) are rebuilt from scratch. End of life and the compatibility
    verdict are written here too, because both depend on what is installed.
    """

    listed = [app for app in apps if app.get("listed", True)]
    by_id = {app["id"]: app for app in listed}
    catalog_by_id = {entry["id"]: entry for entry in catalog["apps"]}
    states = snapshot.get("catalog", {})
    for app in listed:
        for key in LIFECYCLE_KEYS:
            app.pop(key, None)
        app["update_available"] = False
        app["installed_version"] = None
        if app.get("kind") == "flatpak" or app.get("source") == "flatpak":
            refs = installed.get(app["id"], [])
            app["installed"] = bool(refs)
            app["eol"] = False
            if not refs:
                continue
            app["installed_scopes"] = installed_scopes_for_refs(refs)
            matching = next(
                (item for item in refs
                 if item["origin"] == app.get("origin") and item["arch"] == app.get("arch")
                 and item["branch"] == app.get("branch")),
                None,
            ) or next((item for item in refs if item["origin"] == app.get("origin")),
                      refs[0])
            app["installed_origin"] = matching["origin"] or app.get("origin", "")
            app["installed_scope"] = matching["scope"]
            deploy = read_deploy_data(Path(matching["path"])) if matching.get("path") else {}
            app["installed_version"] = deploy_text(deploy, "appdata-version", 120) or None
            app["eol"] = deploy_end_of_life(deploy)
        else:
            state = states.get(app["id"])
            entry = catalog_by_id.get(app["id"])
            if state is None and entry is not None:
                state = catalog_install_state(entry, catalog.get("arch"))
            state = state or {}
            app["installed"] = bool(state.get("installed"))
            app["installed_version"] = state.get("version") if app["installed"] else None
            app["update_available"] = bool(state.get("update")) and app["installed"]
            app["icon"] = state.get("icon") if app["installed"] else None
            app["eol"] = False
    extra: list[dict] = []
    for app_id, refs in sorted(installed.items()):
        if app_id in by_id or not refs:
            continue
        entry = installed_flatpak_entry(app_id, refs, preferences)
        entry["installed_scopes"] = installed_scopes_for_refs(refs)
        ref = preferred_ref(refs)
        entry["installed_origin"] = ref.get("origin") or ""
        entry["installed_scope"] = ref.get("scope", "user")
        deploy = read_deploy_data(Path(ref["path"])) if ref.get("path") else {}
        entry["installed_version"] = entry["version"] or None
        entry["update_available"] = False
        entry["eol"] = deploy_end_of_life(deploy)
        extra.append(finish_app(entry))
    taken = set(by_id) | {app["id"] for app in extra}
    for record in snapshot.get("dropped", []):
        app_id = record["slug"]
        if app_id in taken:
            # A catalogue app with this id is something else (a web app, say):
            # the drop stays visible under a name of its own.
            app_id = f"appdrop-{record['slug']}"
            if app_id in taken:
                continue
        entry = dropped_entry(record, app_id)
        entry["installed_version"] = entry["version"] or None
        entry["update_available"] = False
        entry["eol"] = False
        extra.append(finish_app(entry))
        taken.add(app_id)
    result = sorted(listed + extra,
                    key=lambda app: (app["name"].casefold(), app["id"].casefold()))
    for app in result:
        if app.get("kind") == "flatpak" and (facts or {}).get(app["id"], {}).get("eol"):
            # Flathub's summary marks it end-of-life (moos-storectl facts).
            app["eol"] = True
        app["compat"] = compat_verdict(app, machine, facts)
    return result


def lifecycle_stats(apps: list[dict]) -> dict:
    return {
        "total_apps": len(apps),
        "flatpak_apps": sum(app["source"] == "flatpak" for app in apps),
        "non_flatpak_apps": sum(app["source"] != "flatpak" for app in apps),
        "curated_apps": sum(bool(app.get("curated")) for app in apps),
        "installed_apps": sum(bool(app.get("installed")) for app in apps),
        "verified_apps": sum(bool(app.get("verified")) for app in apps),
        "installable_apps": sum(bool(app.get("installable")) for app in apps),
        "unlisted_installed_apps": sum(
            not app.get("listed", True) and app.get("kind") != "dropped" for app in apps
        ),
        "dropped_apps": sum(app.get("kind") == "dropped" for app in apps),
        "updates_known": sum(bool(app.get("update_available")) for app in apps),
        "eol_apps": sum(bool(app.get("eol")) for app in apps),
        "compat_blocked": sum((app.get("compat") or {}).get("verdict") == "blocked"
                              for app in apps),
        "compat_warn": sum((app.get("compat") or {}).get("verdict") == "warn"
                           for app in apps),
    }


# ── Compatibility: can this app work well on THIS machine? ────────────────────
# A pure function of (index entry, machine.json, facts.json) — docs/MO_STORE.md
# "Compatibility reason keys". `blocked` stops an install that cannot work: no
# build for this architecture, the engine is missing, the pinned download does not
# fit, the app reached its end of life. `warn` is something to know before
# installing. An installed app is never "blocked" (it is already here); its
# blocking reasons are reported as warnings. The window owns every word.

COMPAT_ORDER = (
    "arch",
    "engine_missing",
    "android_setup",
    "android_software_graphics",
    "low_disk",
    "low_memory",
    "small_screen",
    "needs_internet",
    "x11_only_scaled",
    "eol",
    "broad_permissions",
    "vendor_download",
    "not_verified",
)
BLOCKING_REASONS = frozenset({"arch", "engine_missing", "low_disk", "eol"})
BROAD_PERMISSIONS = frozenset({"files-all", "devices"})
FACTS_LIMIT = 64 * 1024 * 1024
MIB = 1024 * 1024


def read_facts(path: Path | None) -> dict | None:
    """facts.json (moos-storectl facts) reduced to what a verdict reads, or None.

    {<id>: {eol, x11_only, extra_data, broad}} — `broad` when the app may see every
    file or every device. A missing or unreadable document is None: no verdict
    then claims anything the facts would have said.
    """

    if path is None:
        return None
    try:
        if path.stat().st_size > FACTS_LIMIT:
            return None
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError):
        return None
    apps = document.get("apps") if isinstance(document, dict) else None
    if not isinstance(apps, dict):
        return None
    result: dict[str, dict] = {}
    for app_id, value in apps.items():
        if not valid_flatpak_id(app_id) or not isinstance(value, dict):
            continue
        permissions = value.get("permissions")
        permissions = {item for item in permissions if isinstance(item, str)} \
            if isinstance(permissions, list) else set()
        result[app_id] = {
            "eol": bool(value.get("eol")),
            "x11_only": value.get("x11_only") is True,
            "extra_data": bool(value.get("extra_data")),
            "broad": bool(permissions & BROAD_PERMISSIONS),
        }
    return result


def app_engine(app: dict) -> str:
    declared = app.get("engine")
    if isinstance(declared, str) and declared:
        return declared
    return {"android": "android", "windows": "windows"}.get(app.get("kind"), "")


def screen_too_small(display: dict, screen: dict) -> bool:
    try:
        scale = float(screen["scale"]) or 1.0
        width, height = float(screen["width"]) / scale, float(screen["height"]) / scale
        pixels = int(display["px"])
    except (KeyError, TypeError, ValueError, ZeroDivisionError):
        return False
    side = max(width, height) if display.get("side") == "longest" else min(width, height)
    compare = display.get("compare", "ge")
    if compare == "ge":
        return side < pixels
    if compare == "gt":
        return side <= pixels
    return False                        # an upper bound is not "too small"


def compat_verdict(app: dict, machine: dict | None, facts: dict | None) -> dict:
    """{verdict: ok|warn|blocked, reasons: [keys in COMPAT_ORDER order]}."""

    machine = machine if isinstance(machine, dict) else {}
    reasons: set[str] = set()
    installed = bool(app.get("installed"))
    kind = app.get("kind")
    machine_arch = machine.get("arch")
    declared = app.get("arch")
    if isinstance(machine_arch, str) and machine_arch:
        if isinstance(declared, list) and declared and machine_arch not in declared:
            reasons.add("arch")
        elif isinstance(declared, str) and kind == "flatpak" and declared != machine_arch:
            reasons.add("arch")
    engine = app_engine(app)
    engines = machine.get("engines")
    if engine and isinstance(engines, list) and engine not in engines:
        reasons.add("engine_missing")
    android = machine.get("android") if isinstance(machine.get("android"), dict) else {}
    if engine == "android" and "engine_missing" not in reasons:
        if android.get("ready") is not False and android.get("initialized") is False:
            reasons.add("android_setup")
        if android.get("graphics") == "software":
            reasons.add("android_software_graphics")
    needs = app.get("needs") if isinstance(app.get("needs"), dict) else {}
    free = (machine.get("free_bytes") or {}).get("apps") if isinstance(
        machine.get("free_bytes"), dict) else None
    size = needs.get("size")
    if not installed and isinstance(size, int) and isinstance(free, int) and size > free:
        reasons.add("low_disk")
    memory = machine.get("memory_bytes")
    if isinstance(needs.get("memory"), int) and isinstance(memory, int) \
            and needs["memory"] * MIB > memory:
        reasons.add("low_memory")
    screen = machine.get("screen") if isinstance(machine.get("screen"), dict) else None
    if isinstance(needs.get("display"), dict) and screen and screen_too_small(
            needs["display"], screen):
        reasons.add("small_screen")
    if needs.get("internet") in {"always", "first-run"} or kind == "webapp":
        reasons.add("needs_internet")
    fact = (facts or {}).get(app.get("id")) if kind == "flatpak" else None
    if fact:
        scale = screen.get("scale") if screen else None
        fractional = isinstance(scale, (int, float)) and abs(scale - round(scale)) > 0.01
        if fact.get("x11_only") and fractional and machine.get("session") in (None, "wayland"):
            reasons.add("x11_only_scaled")
        if fact.get("broad"):
            reasons.add("broad_permissions")
        if fact.get("extra_data"):
            reasons.add("vendor_download")
    if app.get("eol"):
        reasons.add("eol")
    if kind == "flatpak" and not app.get("verified"):
        reasons.add("not_verified")
    ordered = [reason for reason in COMPAT_ORDER if reason in reasons]
    if not installed and reasons & BLOCKING_REASONS:
        verdict = "blocked"
    else:
        verdict = "warn" if ordered else "ok"
    return {"verdict": verdict, "reasons": ordered}


def context_state(machine: dict | None, facts: dict | None) -> dict:
    """What compat_verdict() reads beyond the index, for the context token.

    Free space enters as a power-of-two bucket of GiB, so the index is rewritten
    when the disk crosses 1, 2, 4, 8… GiB free rather than at every byte.
    """

    machine = machine if isinstance(machine, dict) else {}
    free = (machine.get("free_bytes") or {}).get("apps") if isinstance(
        machine.get("free_bytes"), dict) else None
    bucket = None
    if isinstance(free, int):
        gib = free / 1024 ** 3
        bucket = 0 if gib < 1 else int(math.log2(gib)) + 1
    memory = machine.get("memory_bytes")
    return {
        "arch": machine.get("arch"),
        "engines": machine.get("engines"),
        "memory": memory // (64 * MIB) if isinstance(memory, int) else None,
        "screen": machine.get("screen"),
        "session": machine.get("session"),
        "android": machine.get("android"),
        "windows": machine.get("windows"),
        "free_bucket": bucket,
        "facts": facts,
    }


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def digest_json(value: object) -> str:
    return hashlib.sha256(
        json.dumps(
            value,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    ).hexdigest()


def input_tokens(
    catalog_path: Path,
    catalog: dict,
    sources: list[dict],
    installed: dict[str, list[dict]],
    preferences: list[str],
    snapshot: dict | None = None,
    context: dict | None = None,
) -> dict[str, str]:
    """Fingerprint every input that can change the generated application state.

    `context` is context_state(): the machine facts and facts.json the
    compatibility verdicts read; a change to it refreshes the cached index
    without parsing AppStream.

    `metadata` covers what needs AppStream parsed again (the generator, the
    catalogue and the machine it is filtered for, the locale, every AppStream
    source); `installed` covers what apply_lifecycle() reads (deployed refs with
    their commits, and the non-Flatpak `snapshot`).
    """

    if snapshot is None:
        snapshot = lifecycle_snapshot(catalog)
    source_state = []
    for source in sources:
        path = source["path"]
        try:
            stat_result = path.stat()
            size = stat_result.st_size
            modified = stat_result.st_mtime_ns
        except OSError:
            size = modified = None
        source_state.append(
            {
                "origin": source["origin"],
                "scope": source["scope"],
                "arch": source["arch"],
                "revision": source.get("revision"),
                # mtime/size also protect injected non-content-addressed fixtures
                # and catch an unexpectedly rewritten revision on a damaged host.
                "size": size,
                "mtime_ns": modified,
                "revision_mtime_ns": source.get("revision_mtime_ns"),
            }
        )

    installed_refs_state = sorted(
        (
            app_id,
            item["origin"],
            item["scope"],
            item["arch"],
            item["branch"],
            item.get("commit", ""),
        )
        for app_id, refs in installed.items()
        for item in refs
    )
    engines = catalog.get("engines_ready")
    metadata_state = {
        "schema_version": SCHEMA_VERSION,
        "generator": sha256_file(Path(__file__)),
        "catalog": sha256_file(catalog_path),
        "locale_preferences": preferences,
        # What the catalogue was filtered for: the same file offers a different
        # set of apps to a machine that gained or lost an engine.
        "arch": catalog.get("arch"),
        "engines": None if engines is None else sorted(engines),
        "sources": sorted(
            source_state,
            key=lambda item: (
                item["origin"],
                item["scope"],
                item["arch"],
                item["revision"] or "",
            ),
        ),
    }
    installed_state = {
        "installed": installed_refs_state,
        "lifecycle": snapshot,
    }
    metadata_digest = digest_json(metadata_state)
    installed_digest = digest_json(installed_state)
    context_digest = digest_json(context)
    return {
        "metadata": metadata_digest,
        "installed": installed_digest,
        "context": context_digest,
        "input": digest_json(
            {"metadata": metadata_digest, "installed": installed_digest,
             "context": context_digest}
        ),
    }


def input_token(
    catalog_path: Path,
    catalog: dict,
    sources: list[dict],
    installed: dict[str, list[dict]],
    preferences: list[str],
) -> str:
    """Compatibility helper for callers that need only the combined token."""

    return input_tokens(
        catalog_path, catalog, sources, installed, preferences
    )["input"]


def existing_output_tokens(path: Path) -> dict[str, str] | None:
    """Read generation tokens without materializing the multi-megabyte app list."""

    try:
        size = path.stat().st_size
        if not path.is_file() or not 128 <= size <= 64 * 1024 * 1024:
            return None
        with path.open("rb") as handle:
            head = handle.read(8192)
            handle.seek(-2, os.SEEK_END)
            tail = handle.read(2)
    except OSError:
        return None
    if (
        f'"schema_version":{SCHEMA_VERSION}'.encode("ascii") not in head
        or tail != b"}\n"
    ):
        return None
    tokens: dict[str, str] = {}
    for output_key, json_key in (
        ("input", "input_token"),
        ("metadata", "metadata_token"),
        ("installed", "installed_token"),
        ("context", "context_token"),
    ):
        match = re.search(
            rb'"' + json_key.encode("ascii") + rb'":"([0-9a-f]{64})"',
            head,
        )
        if match is None:
            return None
        tokens[output_key] = match.group(1).decode("ascii")
    return tokens


def existing_output_matches(path: Path, token: str) -> bool:
    """Cheaply recognize an atomically-written index for the current inputs."""

    existing = existing_output_tokens(path)
    return existing is not None and existing["input"] == token


def load_refreshable_output(path: Path, metadata_token: str) -> dict | None:
    try:
        with path.open(encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not (
        isinstance(payload, dict)
        and payload.get("schema_version") == SCHEMA_VERSION
        and isinstance(payload.get("generation"), dict)
        and payload["generation"].get("metadata_token") == metadata_token
        and isinstance(payload.get("stats"), dict)
        and isinstance(payload.get("categories"), list)
        and isinstance(payload.get("bundles"), list)
        and isinstance(payload.get("apps"), list)
    ):
        return None
    return payload


def refresh_installed_flags(
    payload: dict,
    installed: dict[str, list[dict]],
    catalog: dict,
    snapshot: dict | None = None,
    preferences: list[str] | None = None,
    machine: dict | None = None,
    facts: dict | None = None,
) -> bool:
    """Refresh lifecycle state in a cached metadata index without reparsing XML."""

    if not all(isinstance(app, dict) and valid_generic_id(app.get("id"))
               and isinstance(app.get("name"), str) for app in payload["apps"]):
        return False
    if snapshot is None:
        snapshot = lifecycle_snapshot(catalog)
    if preferences is None:
        preferences = locale_preferences(payload["generation"].get("locale"))
    payload["apps"] = apply_lifecycle(
        payload["apps"], installed=installed, snapshot=snapshot, catalog=catalog,
        preferences=preferences, machine=machine, facts=facts,
    )
    payload["stats"].update(lifecycle_stats(payload["apps"]))
    return True


def content_generation_id(payload: dict) -> str:
    return digest_json(
        {
            "categories": payload["categories"],
            "bundles": payload["bundles"],
            "collections": payload.get("collections", []),
            "featured": payload.get("featured", []),
            "apps": payload["apps"],
        }
    )[:20]


def editorial_groups(catalog: dict, apps_by_id: dict[str, dict]) -> tuple[list, list]:
    """Discover's collections and hero cards, as far as this machine can offer them.

    A collection keeps the apps the finished index lists here and is dropped when
    fewer than three are left (a "row" of one or two is not the row that was
    curated). A hero card is dropped when its app is not installable here; at most
    eight are kept, in catalogue order.
    """

    collections = []
    for collection in catalog.get("collections", []):
        members = [
            app_id for app_id in collection.get("apps", [])
            if app_id in apps_by_id and apps_by_id[app_id].get("listed", True)
        ]
        if len(members) < 3:
            continue
        collections.append(dict(collection, apps=members))
    featured = [
        card for card in catalog.get("featured", [])
        if card["app"] in apps_by_id and apps_by_id[card["app"]].get("installable")
        and apps_by_id[card["app"]].get("listed", True)
    ][:8]
    return collections, featured


def catalog_fallback_app(
    entry: dict, preferences: list[str], arch: str | None = None
) -> dict:
    flatpak = entry["source"] in {"flathub", "flatpak"}
    name = catalog_localized(entry, preferences) or entry["id"]
    description = catalog_localized(entry, preferences, "desc_")
    category = CURATED_CATEGORY_FALLBACK.get(entry.get("cat", ""), "other")
    if category not in PRIMARY_CATEGORIES:
        category = "other"
    install = entry.get("install") or {}
    app = {
        "id": entry["id"],
        "source": "flatpak" if flatpak else entry["source"],
        "kind": catalog_kind(entry),
        "origin": "flathub" if entry["source"] == "flathub" else entry["source"],
        "scope": "user" if flatpak or install.get("kind") != "web"
        else "external",
        "installable": catalog_installable(entry, arch),
        "listed": True,
        # A curated fallback has a validated app id but no AppStream bundle,
        # so inventing an arch/branch ref here would violate the ref contract.
        "flatpak_ref": None,
        "arch": None,
        "branch": None,
        "name": name,
        "name_en": entry.get("en") or name,
        "branding": None,
        "content_rating": None,
        "summary": description,
        "description": description,
        "developer": "",
        "license": "",
        "category": category,
        "categories": [],
        "icon": None,
        "screenshot": None,
        "verified": False,
        # Decided by apply_lifecycle(), like every other entry's.
        "installed": False,
        # The version a pinned recipe installs (App Drop, Windows, Android).
        "version": install.get("version", "") if not flatpak else "",
        "curated": True,
        "origins": (
            [
                {
                    "origin": "flathub",
                    "scope": "user",
                    "arch": None,
                    "branch": None,
                    "ref": None,
                }
            ]
            if flatpak
            else []
        ),
    }
    app.update(entry)
    app["source"] = "flatpak" if flatpak else entry["source"]
    # A pinned download states its exact size: the least free space the job needs.
    pinned = (install.get("downloads") or {}).get(arch or "") or {}
    size = pinned.get("size") or install.get("size")
    if isinstance(size, int) and not isinstance(size, bool) and size > 0:
        app["needs"] = {"size": size}
    return app


def overlay_catalog(app: dict, entry: dict, preferences: list[str]) -> None:
    app["curated"] = True
    app["catalog_category"] = entry.get("cat")
    curated_name = catalog_localized(entry, preferences)
    curated_description = catalog_localized(entry, preferences, "desc_")
    if curated_name:
        app["name"] = curated_name
    if entry.get("en"):
        app["name_en"] = entry["en"]
    if curated_description:
        previous_summary = app.get("summary", "")
        previous_description = app.get("description", "")
        app["summary"] = curated_description
        # The curated catalogue copy is a reviewed CARD summary, not a replacement for the
        # richer local AppStream details. Preserve a real long description; only move the new
        # summary into `description` when metadata had no distinct description of its own.
        if not previous_description or previous_description == previous_summary:
            app["description"] = curated_description
    for key in (
        "cat",
        "glyph",
        "en",
        "ar",
        "desc_en",
        "desc_ar",
        "rating",
        "reviews",
        "popular",
        "preselect",
        # A reviewed publisher name outranks the metadata's own spelling.
        "developer",
        "keywords_en",
        "keywords_ar",
        "accent",
    ):
        if key in entry:
            app[key] = entry[key]
    if entry.get("cat") == "ai":
        app["category"] = "ai"


def finish_app(app: dict) -> dict:
    """Write the keys derived from a finished entry; drop build-time helpers."""

    terms = app.pop("_search_terms", [])
    app["cat"] = store_category(app)
    app["search"] = app_search_string(app, terms)
    if not app.get("needs"):
        # Most apps state no requirement; an absent key keeps the index small.
        app.pop("needs", None)
    return app


def generation_time() -> str:
    epoch = os.environ.get("SOURCE_DATE_EPOCH", "")
    try:
        moment = dt.datetime.fromtimestamp(int(epoch), tz=dt.timezone.utc)
    except (ValueError, OverflowError, OSError):
        moment = dt.datetime.now(tz=dt.timezone.utc)
    return moment.isoformat(timespec="seconds").replace("+00:00", "Z")


def build_index(
    catalog_path: Path,
    appstream_roots: list[tuple[Path, str]],
    installation_roots: list[tuple[Path, str]],
    requested_locale: str | None,
    *,
    catalog_data: dict | None = None,
    installed_data: dict[str, list[dict]] | None = None,
    source_data: list[dict] | None = None,
    cache_tokens: dict[str, str] | None = None,
    lifecycle: dict | None = None,
    machine: dict | None = None,
    facts: dict | None = None,
) -> dict:
    preferences = locale_preferences(requested_locale)
    catalog = catalog_data if catalog_data is not None else load_catalog(catalog_path)
    installed = (
        installed_data
        if installed_data is not None
        else scan_installed(installation_roots)
    )
    discovered_sources = (
        source_data if source_data is not None else appstream_sources(appstream_roots)
    )
    if lifecycle is None:
        lifecycle = lifecycle_snapshot(catalog)
    if cache_tokens is None:
        cache_tokens = input_tokens(
            catalog_path, catalog, discovered_sources, installed, preferences, lifecycle,
            context_state(machine, facts),
        )

    apps_by_id: dict[str, dict] = {}
    sources_output: list[dict] = []
    metadata_cache: dict[tuple[str, str, str], dict] = {}
    duplicate_count = 0
    invalid_count = 0
    source_error_count = 0
    component_count = 0
    accepted_count = 0
    skipped_count = 0
    excluded_count = 0
    metadata_indexes_parsed = 0
    metadata_indexes_reused = 0

    def add_app(app: dict) -> None:
        nonlocal duplicate_count
        refs = installed.get(app["id"], [])
        if app["id"] in apps_by_id:
            duplicate_count += 1
            apps_by_id[app["id"]] = merge_duplicate(
                apps_by_id[app["id"]], app, refs
            )
        else:
            apps_by_id[app["id"]] = app

    parsed_sources, superseded_sources = supersede_older_sources(discovered_sources)
    for source in parsed_sources:
        source_components = 0
        source_accepted = 0
        source_invalid = 0
        source_skipped = 0
        source_excluded = 0
        source_error = None
        metadata_reused = False
        reused_from = None
        path = source["path"]
        revision = source.get("revision")
        metadata_key = (
            (source["origin"], source["arch"], revision) if revision else None
        )
        cached = metadata_cache.get(metadata_key) if metadata_key else None
        if cached is not None:
            metadata_reused = True
            metadata_indexes_reused += 1
            reused_from = cached["path"]
            source_components = cached["components"]
            source_accepted = cached["accepted"]
            source_invalid = cached["invalid"]
            source_skipped = cached["skipped"]
            source_excluded = cached["excluded"]
            for template in cached["apps"]:
                add_app(clone_app_for_source(template, source))
        else:
            metadata_indexes_parsed += 1
            parsed_apps: list[dict] = []
            try:
                for component in iter_components(path):
                    source_components += 1
                    bundle = component_bundle_ref(component)
                    if bundle is not None and not_an_app_reason(component, bundle[0]):
                        source_excluded += 1
                        continue
                    app = parse_component(
                        component,
                        path,
                        source["origin"],
                        source["scope"],
                        preferences,
                    )
                    if app is None:
                        if rejected_component_is_invalid(component):
                            source_invalid += 1
                        else:
                            source_skipped += 1
                        continue
                    source_accepted += 1
                    # Keep an unmerged template for another installation that
                    # exposes this exact content-addressed metadata revision.
                    parsed_apps.append(clone_app_for_source(app, source))
                    add_app(app)
            except (OSError, EOFError, ET.ParseError, IndexErrorBase) as error:
                source_error_count += 1
                source_error = clean_text(str(error), 240) or type(error).__name__
            if metadata_key is not None and source_error is None:
                metadata_cache[metadata_key] = {
                    "path": str(path),
                    "components": source_components,
                    "accepted": source_accepted,
                    "invalid": source_invalid,
                    "skipped": source_skipped,
                    "excluded": source_excluded,
                    "apps": parsed_apps,
                }

        component_count += source_components
        accepted_count += source_accepted
        invalid_count += source_invalid
        skipped_count += source_skipped
        excluded_count += source_excluded

        sources_output.append(
            {
                "kind": source["kind"],
                "origin": source["origin"],
                "scope": source["scope"],
                "arch": source["arch"],
                "revision": revision,
                "path": str(path),
                "components": source_components,
                "accepted": source_accepted,
                "skipped": source_skipped,
                "excluded": source_excluded,
                "invalid": source_invalid,
                "error": source_error,
                "metadata_reused": metadata_reused,
                "metadata_reused_from": reused_from,
                "superseded_by": None,
            }
        )

    for source in superseded_sources:
        sources_output.append(
            {
                "kind": source["kind"],
                "origin": source["origin"],
                "scope": source["scope"],
                "arch": source["arch"],
                "revision": source.get("revision"),
                "path": str(source["path"]),
                "components": 0,
                "accepted": 0,
                "skipped": 0,
                "excluded": 0,
                "invalid": 0,
                "error": None,
                "metadata_reused": False,
                "metadata_reused_from": None,
                "superseded_by": source["superseded_by"],
            }
        )

    catalog_fallbacks = 0
    for entry in catalog["apps"]:
        current = apps_by_id.get(entry["id"])
        if current is None:
            current = catalog_fallback_app(entry, preferences, catalog.get("arch"))
            apps_by_id[entry["id"]] = current
            catalog_fallbacks += 1
        else:
            overlay_catalog(current, entry, preferences)

    for app in apps_by_id.values():
        finish_app(app)
    # Discover's groups name only listed apps, so they are settled before the
    # lifecycle pass adds what is installed but not offered.
    collections, featured = editorial_groups(catalog, apps_by_id)
    apps = apply_lifecycle(
        list(apps_by_id.values()), installed=installed, snapshot=lifecycle,
        catalog=catalog, preferences=preferences, machine=machine, facts=facts,
    )
    catalog_skipped = catalog.get("skipped", [])
    catalog_invalid_apps = [item for item in catalog_skipped if item["section"] == "apps"]
    sources_output.append(
        {
            "kind": "curated-catalog",
            "origin": "moos",
            "scope": "system",
            "arch": None,
            "revision": None,
            "path": str(catalog_path),
            "components": len(catalog["apps"]) + len(catalog_invalid_apps),
            "accepted": len(catalog["apps"]),
            "skipped": 0,
            "excluded": 0,
            "invalid": len(catalog_invalid_apps),
            "error": None,
            "metadata_reused": False,
            "metadata_reused_from": None,
            "superseded_by": None,
        }
    )

    stats = {
        **lifecycle_stats(apps),
        "appstream_components": component_count,
        "appstream_entries": accepted_count,
        "duplicates_merged": duplicate_count,
        "skipped_components": skipped_count,
        "excluded_components": excluded_count,
        "invalid_components": invalid_count,
        "source_errors": source_error_count,
        "catalog_fallback_apps": catalog_fallbacks,
        "catalog_skipped_entries": len(catalog_skipped),
        "metadata_indexes_parsed": metadata_indexes_parsed,
        "metadata_indexes_reused": metadata_indexes_reused,
        "metadata_indexes_superseded": len(superseded_sources),
    }

    payload = {
        "schema_version": SCHEMA_VERSION,
        "generation": {
            "id": "",
            "input_token": cache_tokens["input"],
            "metadata_token": cache_tokens["metadata"],
            "installed_token": cache_tokens["installed"],
            "context_token": cache_tokens["context"],
            "generated_at": generation_time(),
            "locale": preferences[0] if preferences else "en",
            "offline": True,
        },
        "sources": sources_output,
        "stats": stats,
        # Which engines this machine actually has a runtime for. The Store's
        # capability strip used to list every engine the registry DESCRIBES,
        # so an ARM desktop -- which ships neither wine nor waydroid -- told the
        # owner it runs Windows programs and Android apps. QML cannot probe a
        # PATH; the index already did the work, so it writes the answer down.
        # null means "could not tell", and the strip then shows the registry as
        # before rather than claiming the machine runs nothing.
        "engines": (None if catalog.get("engines_ready") is None
                    else sorted(catalog["engines_ready"])),
        "categories": catalog["categories"],
        "bundles": catalog["bundles"],
        "collections": collections,
        "featured": featured,
        "apps": apps,
    }
    payload["generation"]["id"] = content_generation_id(payload)
    return payload


def atomic_write_json(path: Path, payload: dict) -> None:
    parent = path.parent
    parent.mkdir(parents=True, exist_ok=True)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=parent,
            prefix=f".{path.name}.",
            suffix=".tmp",
            delete=False,
        ) as handle:
            temporary = Path(handle.name)
            # The index includes the local installed-app inventory and source
            # paths.  It belongs to the current user, not every local account.
            os.fchmod(handle.fileno(), 0o600)
            json.dump(payload, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        temporary = None
        try:
            directory_fd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        except OSError:
            return
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    default_output = (
        Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
        / "moos-store/index.json"
    )
    parser = argparse.ArgumentParser(
        description="Build Mo Store's local, unified application index"
    )
    parser.add_argument("--output", type=Path, default=default_output)
    parser.add_argument("--print-machine", action="store_true",
                        help="write the machine profile as JSON and exit (read-only)")
    parser.add_argument("--engines", default=None,
                        help="build the index for these engine ids instead of the ones "
                             "probed here: a comma-separated list, or 'all' to filter by "
                             "none. Lets an index be built for a different machine, and "
                             "keeps tests independent of what the developer has installed")
    parser.add_argument("--catalog", type=Path, default=DEFAULT_CATALOG)
    parser.add_argument(
        "--appstream-root",
        action="append",
        metavar="PATH",
        help=(
            "AppStream root to scan; repeat for multiple installations. "
            "Providing one replaces automatic discovery."
        ),
    )
    parser.add_argument(
        "--installation-root",
        action="append",
        metavar="PATH",
        help=(
            "Flatpak installation root used to detect deployed apps; repeatable. "
            "Defaults to roots corresponding to --appstream-root."
        ),
    )
    parser.add_argument(
        "--locale",
        help="preferred AppStream locale (for example ar or en_US)",
    )
    parser.add_argument(
        "--machine",
        type=Path,
        default=None,
        help="judge compatibility against this machine document (the --print-machine "
             "shape) instead of this machine",
    )
    parser.add_argument(
        "--facts",
        type=Path,
        default=None,
        help="Flathub facts document (moos-storectl facts); default: facts.json next "
             "to --output",
    )
    return parser.parse_args(argv)


def machine_profile() -> dict:
    """What this machine is, for the surfaces that cannot probe it themselves.

    QML cannot read a PATH, and the Store paints the curated catalogue BEFORE
    the index exists (Component.onCompleted calls loadCurated() first, and on a
    first run the index is still building for ~30 s). Without this the very
    first frame on an ARM desktop showed eleven apps with no ARM build and
    fifteen more whose engine is not in the image. `engines: null` means "could
    not tell", and every surface then filters nothing.

    These two keys are what the catalogue is FILTERED by; machine_document()
    adds the hardware facts the compatibility verdicts read.
    """
    ready = available_engines()
    return {"arch": running_arch(),
            "engines": None if ready is None else sorted(ready)}


# ── machine.json: the facts a compatibility verdict needs ─────────────────────
# docs/MO_STORE.md "machine.json". File reads only, each fact on its own: one that
# cannot be read is null and never fails the document (the launcher writes it
# synchronously before the first frame; budget 0.15 s, measured ~0.06 s). Free
# space is measured where apps install, under ~/.local/share, never on `/`: on
# MoOS `/` is a read-only composefs that always reads 100% full.

GPU_VENDOR_IDS = {
