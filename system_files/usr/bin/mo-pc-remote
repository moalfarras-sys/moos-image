#!/usr/bin/python3
"""Native MoOS control panel for Mo PC Remote. Never embeds or opens a browser."""
import json, os, socket, subprocess, urllib.request
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk, GLib

UNIT = "mo-remote-personal.service"
PORT = 8765

# MoOS UI2 semantic colours.  Keep this panel on the same Graphite/Tidal rails as
# the phone controller instead of letting ad-hoc Nova/purple colours creep into
# first-party cards.  GTK's preference selects the variant; service behaviour is
# deliberately independent from this presentation layer.
UI2_DARK = {
    "canvas": "#14191C", "surface": "#1D2529", "card": "#232D32",
    "raised": "#2C383E", "primary": "#4ED7C8", "secondary": "#78AFFF", "luminous": "#A8F1E8",
    "positive": "#69D9A5", "warning": "#F4C56A", "negative": "#FF7D88",
    "text": "#E8F1EF", "muted": "#9CAFAC", "outline": "#415158",
    "on_accent": "#102522", "shadow": "rgba(4, 10, 12, 0.42)",
}
UI2_LIGHT = {
    "canvas": "#D8EBE7", "surface": "#C9E2DD", "card": "#E1F0EC",
    "raised": "#B8D8D2", "primary": "#006D67", "secondary": "#1D6278", "luminous": "#0B6965",
    "positive": "#086B4B", "warning": "#7B520F", "negative": "#A52F3F",
    "text": "#17302E", "muted": "#466360", "outline": "#527F79",
    "on_accent": "#E8F1EF", "shadow": "rgba(23, 48, 46, 0.16)",
}

def ui2_css(p):
    return f"""
@define-color ui2_canvas {p['canvas']};
@define-color ui2_surface {p['surface']};
@define-color ui2_card {p['card']};
@define-color ui2_raised {p['raised']};
@define-color ui2_primary {p['primary']};
@define-color ui2_secondary {p['secondary']};
@define-color ui2_luminous {p['luminous']};
@define-color ui2_positive {p['positive']};
@define-color ui2_warning {p['warning']};
@define-color ui2_negative {p['negative']};
@define-color ui2_text {p['text']};
@define-color ui2_muted {p['muted']};
@define-color ui2_outline {p['outline']};
@define-color ui2_on_accent {p['on_accent']};

window.moos-ui2 {{
  background-color: @ui2_canvas;
  color: @ui2_text;
}}
window.moos-ui2 .remote-shell {{
  background-color: transparent;
  color: @ui2_text;
}}
window.moos-ui2 .title-1,
window.moos-ui2 .heading {{ color: @ui2_text; }}
window.moos-ui2 .dim-label {{ color: @ui2_muted; }}
window.moos-ui2 .ui2-card {{
  background-color: @ui2_card;
  color: @ui2_text;
  border: 1px solid @ui2_outline;
  border-radius: 18px;
  padding: 14px;
  box-shadow: 0 10px 28px {p['shadow']};
}}
window.moos-ui2 button {{
  background-color: @ui2_raised;
  color: @ui2_text;
  border: 1px solid @ui2_outline;
  border-radius: 12px;
  padding: 10px 16px;
}}
window.moos-ui2 button:hover,
window.moos-ui2 button:focus-visible {{
  border-color: @ui2_primary;
  outline-color: @ui2_luminous;
}}
window.moos-ui2 button:active {{ background-color: @ui2_surface; }}
window.moos-ui2 button.suggested-action {{
  background-image: linear-gradient(to bottom right, @ui2_primary, @ui2_secondary);
  color: @ui2_on_accent;
  border-color: transparent;
}}
window.moos-ui2 button.destructive-action {{
  background-color: @ui2_negative;
  color: @ui2_on_accent;
  border-color: transparent;
}}
window.moos-ui2 .success {{ color: @ui2_positive; }}
window.moos-ui2 .error {{ color: @ui2_negative; }}
window.moos-ui2 .ui2-log,
window.moos-ui2 .ui2-log text {{
  background-color: @ui2_surface;
  color: @ui2_text;
}}
window.moos-ui2 selection {{
  background-color: @ui2_primary;
  color: @ui2_on_accent;
}}
window.moos-ui2 scrollbar slider {{
  background-color: @ui2_outline;
  border-radius: 999px;
}}
"""

def gtk_prefers_dark():
    settings = Gtk.Settings.get_default()
    if settings is None:
        return True
    try:
        if settings.get_property("gtk-application-prefer-dark-theme"):
            return True
        return "dark" in (settings.get_property("gtk-theme-name") or "").lower()
    except (TypeError, AttributeError):
        return True

def run(*args):
    return subprocess.run(args, text=True, capture_output=True, timeout=5)

def active(unit):
    return run("systemctl", "--user", "is-active", "--quiet", unit).returncode == 0

def lan_ip():
    try:
        s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.connect(("192.0.2.1",9))
        value=s.getsockname()[0]; s.close(); return value
    except OSError: return "unavailable"


# --- the address that still works once the phone leaves the house ---------------------------
#
# Mo PC Remote was already reachable from anywhere — Tailscale is a mesh, not a LAN thing, and
# NetworkGuard has always allowed the tailnet's 100.64.0.0/10. The only thing standing between
# the user and remote access was the address this panel handed them: it took the *default
# route's* source IP, which is the LAN, printed http://192.168.x.x:8765, and that address stops
# existing the moment the phone is on cellular.
#
# `tailscale serve` gives the machine a real HTTPS name instead. That fixes two things at once:
#
#   - it works from anywhere on the tailnet, with no port and no IP to remember, and
#   - it is a SECURE CONTEXT, which is what the browser demands before it will hand Mo PC Remote
#     WebCodecs (hardware video decode), the clipboard, or a properly installable PWA. Over plain
#     http none of those exist, no matter how good the stream is.
#
# Nothing is published to the public internet: serve is tailnet-only. (`tailscale funnel` is the
# public one. MoOS does not use it.)
def tailscale_url():
    """The MagicDNS HTTPS address, but only if serve is really proxying to our port."""
    try:
        st = json.loads(run("tailscale", "status", "--json").stdout or "{}")
    except (ValueError, OSError, subprocess.SubprocessError):
        return None
    if st.get("BackendState") != "Running":
        return None
    name = ((st.get("Self") or {}).get("DNSName") or "").rstrip(".")
    if not name:
        return None
    # Claim "from anywhere" only when it is true — a name with no proxy behind it is a dead link.
    try:
        served = run("tailscale", "serve", "status").stdout or ""
    except (OSError, subprocess.SubprocessError):
        return None
    if f"127.0.0.1:{PORT}" not in served and f"localhost:{PORT}" not in served:
        return None
    return f"https://{name}/"


def enable_anywhere():
    """Point serve at the agent. Needs no root once the user is Tailscale's operator."""
    r = run("tailscale", "serve", "--bg", "--https=443", f"http://127.0.0.1:{PORT}")
    return (r.returncode == 0, (r.stderr or r.stdout or "").strip())


def qr_png(url, path):
    """A code the phone can scan beats an address it has to be told over the phone."""
    try:
        r = run("qrencode", "-o", path, "-s", "8", "-m", "2", "-t", "PNG", url)
        return r.returncode == 0 and os.path.exists(path)
    except (OSError, subprocess.SubprocessError):
        return False

class App(Gtk.Application):
    def __init__(self): super().__init__(application_id="org.moos.MoPCRemote")
    def do_activate(self):
        self.win=Gtk.ApplicationWindow(application=self,title="Mo PC Remote")
        self.win.add_css_class("moos-ui2")
        self.style_provider=Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.apply_ui2_style()
        settings=Gtk.Settings.get_default()
        if settings:
            settings.connect("notify::gtk-application-prefer-dark-theme",self.apply_ui2_style)
            settings.connect("notify::gtk-theme-name",self.apply_ui2_style)
        self.win.set_default_size(720,620)
        outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14,margin_top=22,margin_bottom=22,margin_start=24,margin_end=24)
        outer.add_css_class("remote-shell")
        title=Gtk.Label(label="Mo PC Remote",xalign=0); title.add_css_class("title-1"); outer.append(title)
        sub=Gtk.Label(label="Native MoOS control center · مركز تحكم MoOS الأصلي",xalign=0); sub.add_css_class("dim-label"); outer.append(sub)
        self.status=Gtk.Label(xalign=0); self.status.set_wrap(True); self.status.add_css_class("ui2-card"); outer.append(self.status)
        buttons=Gtk.Box(spacing=8)
        for label,cb,style in (("Start / تشغيل",self.start,"suggested-action"),("Stop / إيقاف",self.stop,"destructive-action"),("Refresh / تحديث",self.refresh,None)):
            b=Gtk.Button(label=label); b.connect("clicked",cb)
            if style:b.add_css_class(style)
            buttons.append(b)
        outer.append(buttons)

        # Address block: the one that works anywhere first, the house-only one second, and a QR
        # so the phone never has to be told an address at all.
        addr=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=16)
        addr.add_css_class("ui2-card")
        addr_text=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4,hexpand=True)
        self.address=Gtk.Label(xalign=0,selectable=True); self.address.set_wrap(True); self.address.set_selectable(True)
        addr_text.append(self.address)
        self.anywhere_btn=Gtk.Button(label="Enable access from anywhere / تفعيل الوصول من أي مكان")
        self.anywhere_btn.add_css_class("suggested-action")
        self.anywhere_btn.connect("clicked",self.on_enable_anywhere); self.anywhere_btn.set_visible(False)
        addr_text.append(self.anywhere_btn)
        addr.append(addr_text)
        self.qr=Gtk.Picture(); self.qr.set_size_request(168,168); self.qr.set_visible(False)
        addr.append(self.qr)
        outer.append(addr)

        self.grid=Gtk.Grid(column_spacing=18,row_spacing=10)
        self.grid.add_css_class("ui2-card")
        outer.append(self.grid)
        log_title=Gtk.Label(label="Recent errors / آخر الأخطاء",xalign=0); log_title.add_css_class("heading"); outer.append(log_title)
        scroll=Gtk.ScrolledWindow(vexpand=True); self.log=Gtk.TextView(editable=False,monospace=True,wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll.add_css_class("ui2-card"); self.log.add_css_class("ui2-log")
        scroll.set_child(self.log); outer.append(scroll)
        self.win.set_child(outer); self.win.present(); self.refresh()
        GLib.timeout_add_seconds(3,self.refresh)
    def apply_ui2_style(self,*_):
        self.style_provider.load_from_data(ui2_css(UI2_DARK if gtk_prefers_dark() else UI2_LIGHT))
    def row(self,n,label,value,ok):
        a=Gtk.Label(label=label,xalign=0); b=Gtk.Label(label=("● " if ok else "○ ")+value,xalign=0)
        b.add_css_class("success" if ok else "error"); self.grid.attach(a,0,n,1,1); self.grid.attach(b,1,n,1,1)
    def start(self,*_): run("systemctl","--user","enable","--now",UNIT); self.refresh()
    def stop(self,*_): run("systemctl","--user","disable","--now",UNIT); self.refresh()

    def on_enable_anywhere(self,*_):
        ok,err=enable_anywhere()
        if not ok:
            # The only thing serve needs that the user may not have is Tailscale's operator
            # bit, and that is a privileged change — so it goes through moai-do, not through us.
            self.address.set_markup(
                "<b>Could not enable it from here / تعذّر التفعيل من هنا</b>\n"
                +GLib.markup_escape_text(err[:200])
                +"\n\nRun once in a terminal / نفّذ مرة واحدة:  <tt>moai-do remote-anywhere</tt>")
        self.refresh()

    def refresh(self,*_):
        on=active(UNIT)
        ip=lan_ip()
        far=tailscale_url() if on else None
        home=f"http://{ip}:{PORT}/"
        self.status.set_markup(f"<b>Service:</b> {'Running' if on else 'Stopped'}    <b>Device:</b> {GLib.markup_escape_text(socket.gethostname())}")

        if not on:
            self.address.set_text("Remote control is off. Press Start to enable it.\nالتحكم عن بُعد متوقف. اضغط تشغيل.")
            self.anywhere_btn.set_visible(False); self.qr.set_visible(False)
        elif far:
            # The address that survives leaving the house. Say so plainly — the whole failure
            # mode here was a user who had one address and did not know it was the wrong one.
            self.address.set_markup(
                "<b>From anywhere / من أي مكان</b>  ·  works on mobile data\n"
                f"<tt>{GLib.markup_escape_text(far)}</tt>\n\n"
                "<small>Home network only / الشبكة المنزلية فقط\n"
                f"<tt>{GLib.markup_escape_text(home)}</tt></small>")
            self.anywhere_btn.set_visible(False)
            path=os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",f"mo-remote-qr-{os.getuid()}.png")
            if qr_png(far,path):
                self.qr.set_filename(path); self.qr.set_visible(True)
            else:
                self.qr.set_visible(False)
        else:
            self.address.set_markup(
                f"<b>Home network only / الشبكة المنزلية فقط</b>\n<tt>{GLib.markup_escape_text(home)}</tt>\n\n"
                "<small>This address stops working once the phone leaves the house.\n"
                "هذا العنوان يتوقف عن العمل فور خروج الجوال من البيت.</small>")
            self.anywhere_btn.set_visible(True)
            self.qr.set_visible(False)
        while c:=self.grid.get_first_child(): self.grid.remove(c)
        portal=active("xdg-desktop-portal.service")
        pipe=active("pipewire.service")
        sock=os.path.exists(f"/run/user/{os.getuid()}/.ydotool_socket")
        fw=run("systemctl","is-active","--quiet","firewalld.service").returncode==0
        self.row(0,"Firewall", "active" if fw else "inactive",fw)
        self.row(1,"PipeWire", "active" if pipe else "inactive",pipe)
        self.row(2,"Desktop portal", "active" if portal else "inactive",portal)
        self.row(3,"Input permission", "private user socket" if sock else "not ready",sock)
        self.row(4,"MoPC backend", "touch/keyboard/desktop service" if on else "stopped",on)
        path=os.path.expanduser("~/.local/share/MoRemotePersonal/log.txt")
        try: lines=open(path,errors="replace").read().splitlines()[-30:]; self.log.get_buffer().set_text("\n".join(lines))
        except OSError: self.log.get_buffer().set_text("No log yet.")
        return True

App().run()
