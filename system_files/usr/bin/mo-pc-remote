#!/usr/bin/python3
"""Native MoOS control panel for Mo PC Remote. Never embeds or opens a browser."""
import json, os, pwd, re, socket, subprocess, sys, threading, urllib.request

sys.path.insert(0, "/usr/lib/moos")

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk, GLib

# The palette and the CSS live in ONE place now — /usr/lib/moos/moos_ui2.py. They used to live
# here, and then MoOS grew two more GTK apps (the updater and Recovery); three copies of a palette
# is three chances for MoOS to be three slightly different shades of itself.
from moos_ui2 import UI2_DARK, UI2_LIGHT, ui2_css, gtk_prefers_dark

UNIT = "mo-remote-personal.service"
PORT = 8765

# MoOS UI2 semantic colours.  Keep this panel on the same Graphite/Tidal rails as
# the phone controller instead of letting ad-hoc Nova/purple colours creep into
# first-party cards.  GTK's preference selects the variant; service behaviour is
# deliberately independent from this presentation layer.
def run(*args):
    return subprocess.run(args, text=True, capture_output=True, timeout=5)

def active(unit):
    return run("systemctl", "--user", "is-active", "--quiet", unit).returncode == 0

def lan_ip():
    try:
        s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.connect(("192.0.2.1",9))
        value=s.getsockname()[0]; s.close(); return value
    except OSError: return "unavailable"


# --- the address that still works once the phone leaves the house ---------------------------
#
# Mo PC Remote was already reachable from anywhere — Tailscale is a mesh, not a LAN thing, and
# NetworkGuard has always allowed the tailnet's 100.64.0.0/10. The only thing standing between
# the user and remote access was the address this panel handed them: it took the *default
# route's* source IP, which is the LAN, printed http://192.168.x.x:8765, and that address stops
# existing the moment the phone is on cellular.
#
# `tailscale serve` gives the machine a real HTTPS name instead. That fixes two things at once:
#
#   - it works from anywhere on the tailnet, with no port and no IP to remember, and
#   - it is a SECURE CONTEXT, which is what the browser demands before it will hand Mo PC Remote
#     WebCodecs (hardware video decode), the clipboard, or a properly installable PWA. Over plain
#     http none of those exist, no matter how good the stream is.
#
# Nothing is published to the public internet: serve is tailnet-only. (`tailscale funnel` is the
# public one. MoOS does not use it.)
def tailscale_url():
    """The MagicDNS HTTPS address, but only if serve is really proxying to our port."""
    try:
        st = json.loads(run("tailscale", "status", "--json").stdout or "{}")
    except (ValueError, OSError, subprocess.SubprocessError):
        return None
    if st.get("BackendState") != "Running":
        return None
    name = ((st.get("Self") or {}).get("DNSName") or "").rstrip(".")
    if not name:
        return None
    # Claim "from anywhere" only when it is true — a name with no proxy behind it is a dead link.
    try:
        served = run("tailscale", "serve", "status").stdout or ""
    except (OSError, subprocess.SubprocessError):
        return None
    if f"127.0.0.1:{PORT}" not in served and f"localhost:{PORT}" not in served:
        return None
    # Self-heal in the OTHER direction: tear the /audio mount DOWN if it is still there.
    #
    # This block used to create that mount, and re-create it on every panel open. What it was
    # publishing is a service with no authentication of any kind — moos-cloud-audio says so in
    # its own header — on the same hostname, port and certificate as a desktop that demands a
    # 6-digit PIN. Measured on the maintainer's machine on 2026-07-29:
    #
    #     POST /api/login  (wrong PIN)        -> 401
    #     GET  /audio/stream.webm (no creds)  -> 200 audio/webm, a live Opus stream
    #
    # Every device on the tailnet could listen to every call, meeting and video this machine
    # played, silently, with nothing on the desktop to say it was happening.
    #
    # The sound now goes through the agent at /api/audio/stream.webm, which is behind the same
    # network guard and the same session token as the clipboard and the input channel. Nothing
    # needs a separate mount any more, so the only correct thing to do with an existing one is
    # remove it — and to keep removing it, because a machine that was exposed once stays exposed
    # until something takes it down. Opening this panel is that something.
    if "/audio" in served:
        unmount_audio(443)
    return f"https://{name}/"


def enable_anywhere():
    """Point serve at the agent. Needs no root once the user is Tailscale's operator."""
    r = run("tailscale", "serve", "--bg", "--https=443", f"http://127.0.0.1:{PORT}")
    ok = r.returncode == 0
    if ok:
        # One mount, one door. The sound rides the agent's own authenticated route now; see
        # unmount_audio() below for what used to be here and why it had to go.
        unmount_audio(443)
    return (ok, (r.stderr or r.stdout or "").strip())


# WHAT USED TO BE HERE, AND WHY IT IS NOT COMING BACK.
#
# The desktop stream carries no audio and never has. The machine's sound is a separate service —
# moos-cloud-audio, the default sink's monitor as Opus-in-WebM on PORT+10 — and it was only
# reachable on its own PLAIN-HTTP port, which a browser on an https page is forbidden to fetch.
# The fix at the time was to mount it as a path on the same HTTPS listener:
#
#     tailscale serve --bg --https=443 --set-path=/audio http://127.0.0.1:8775
#
# That solved the mixed-content problem and created a much worse one. `tailscale serve` re-publishes
# a loopback socket to the WHOLE TAILNET, and moos-cloud-audio has no authentication — no PIN, no
# token, no session; its own header states this in as many words. So the result was:
#
#     https://moos-3.tailab78a5.ts.net/            -> PIN required (401 without one)
#     https://moos-3.tailab78a5.ts.net/audio/...   -> 200, a live Opus stream of the machine
#
# Same host, same port, same certificate, and the user's mental model is set by the front door:
# they typed a PIN, so they believe the URL is behind it. Four devices were enrolled on this
# tailnet — a phone, a Windows box, a VPS. Any of them, or anything running on them, could listen
# to every call and every meeting, silently.
#
# The right shape was never a second mount. The agent already owns authentication, so the sound now
# goes through it at /api/audio/stream.webm (moremote/agent/Web/WebApi.cs), inheriting
# UseNetworkGuard and the session token exactly like the clipboard and the input channel. One
# origin, one certificate, one URL — and one door.
#
# This function is the counterpart: it REMOVES the old mount, and tailscale_url() calls it on every
# panel open, because a machine that was exposed once stays exposed until something takes it down.
def unmount_audio(https_port):
    """Remove the legacy unauthenticated /audio mount from this HTTPS listener. Best-effort.

    The `off` target is the documented way to retract one path without disturbing the others;
    verified against tailscale 1.98.10 on the maintainer's machine, which went from

        |-- /      proxy http://127.0.0.1:8765
        |-- /audio proxy http://127.0.0.1:8775
    to
        |-- / proxy http://127.0.0.1:8765

    with the desktop mount untouched, and GET /audio/stream.webm going 200 -> 404.
    """
    try:
        r = run("tailscale", "serve", f"--https={https_port}", "--set-path=/audio", "off")
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def qr_png(url, path):
    """A code the phone can scan beats an address it has to be told over the phone."""
    try:
        r = run("qrencode", "-o", path, "-s", "8", "-m", "2", "-t", "PNG", url)
        return r.returncode == 0 and os.path.exists(path)
    except (OSError, subprocess.SubprocessError):
        return False

class App(Gtk.Application):
    def __init__(self): super().__init__(application_id="org.moos.MoPCRemote")
    def do_activate(self):
        # Clicking Mo PC Remote while Mo PC Remote is open shows you the window you already have.
        #
        # The uniqueness was never the problem: GApplication is unique by default, so the second
        # launch correctly handed off to the running process. What it handed off TO was this
        # method — which built a WHOLE NEW WINDOW every time it was called. So the user clicked the
        # icon twice and got two Mo PC Remotes, each polling systemd and Tailscale on its own timer,
        # inside one process. Reported on the maintainer's machine, 2026-07-14.
        #
        # Same shape as MoPlayer's and the QML shell's: the app was unique and its activation still
        # duplicated the window. Uniqueness is only half of "open it once".
        existing=self.get_active_window()
        if existing is not None:
            existing.present()
            return
        self.win=Gtk.ApplicationWindow(application=self,title="Mo PC Remote")
        self.win.add_css_class("moos-ui2")
        self.style_provider=Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.apply_ui2_style()
        settings=Gtk.Settings.get_default()
        if settings:
            settings.connect("notify::gtk-application-prefer-dark-theme",self.apply_ui2_style)
            settings.connect("notify::gtk-theme-name",self.apply_ui2_style)
        self.win.set_default_size(720,620)
        outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14,margin_top=22,margin_bottom=22,margin_start=24,margin_end=24)
        outer.add_css_class("remote-shell")
        title=Gtk.Label(label="Mo PC Remote",xalign=0); title.add_css_class("title-1"); outer.append(title)
        sub=Gtk.Label(label="Native MoOS control center · مركز تحكم MoOS الأصلي",xalign=0); sub.add_css_class("dim-label"); outer.append(sub)
        self.status=Gtk.Label(xalign=0); self.status.set_wrap(True); self.status.add_css_class("ui2-card"); outer.append(self.status)
        buttons=Gtk.Box(spacing=8)
        for label,cb,style in (("Start / تشغيل",self.start,"suggested-action"),("Stop / إيقاف",self.stop,"destructive-action"),("Refresh / تحديث",self.refresh,None)):
            b=Gtk.Button(label=label); b.connect("clicked",cb)
            if style:b.add_css_class(style)
            buttons.append(b)
        outer.append(buttons)

        # Fast Remote — folded in from what used to be a SECOND dock icon. MoOS ships one
        # remote icon now; the speed control lives here, where the connection does. One
        # switch pauses everything that makes the stream feel slow (the live wallpaper, KWin
        # blur/slide, and the Mo AI brain's VRAM) so the encoder has the machine to itself.
        # It is safe to flip mid-session — nothing restarts the compositor, so the phone does
        # not disconnect. Backed by the same /usr/bin/moos-fast-remote the Meta+R shortcut and
        # the launcher's right-click actions use: one feature, one code path, three doors.
        fast=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=16)
        fast.add_css_class("ui2-card")
        fast_text=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=2,hexpand=True)
        fast_title=Gtk.Label(label="Fast Remote · الوضع السريع",xalign=0); fast_title.add_css_class("heading")
        self.fast_sub=Gtk.Label(xalign=0); self.fast_sub.set_wrap(True); self.fast_sub.add_css_class("dim-label")
        fast_text.append(fast_title); fast_text.append(self.fast_sub)
        fast.append(fast_text)
        self.fast_switch=Gtk.Switch(valign=Gtk.Align.CENTER)
        self.fast_switch.connect("state-set",self.on_fast_toggled)
        fast.append(self.fast_switch)
        outer.append(fast)

        # Address block: the one that works anywhere first, the house-only one second, and a QR
        # so the phone never has to be told an address at all.
        addr=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=16)
        addr.add_css_class("ui2-card")
        addr_text=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4,hexpand=True)
        self.address=Gtk.Label(xalign=0,selectable=True); self.address.set_wrap(True); self.address.set_selectable(True)
        addr_text.append(self.address)
        self.anywhere_btn=Gtk.Button(label="Enable access from anywhere / تفعيل الوصول من أي مكان")
        self.anywhere_btn.add_css_class("suggested-action")
        self.anywhere_btn.connect("clicked",self.on_enable_anywhere); self.anywhere_btn.set_visible(False)
        addr_text.append(self.anywhere_btn)
        addr.append(addr_text)
        self.qr=Gtk.Picture(); self.qr.set_size_request(168,168); self.qr.set_visible(False)
        addr.append(self.qr)
        outer.append(addr)

        self.grid=Gtk.Grid(column_spacing=18,row_spacing=10)
        self.grid.add_css_class("ui2-card")
        outer.append(self.grid)
        log_title=Gtk.Label(label="Recent errors / آخر الأخطاء",xalign=0); log_title.add_css_class("heading"); outer.append(log_title)
        scroll=Gtk.ScrolledWindow(vexpand=True); self.log=Gtk.TextView(editable=False,monospace=True,wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll.add_css_class("ui2-card"); self.log.add_css_class("ui2-log")
        scroll.set_child(self.log); outer.append(scroll)
        self.win.set_child(outer); self.win.present(); self.refresh()
        GLib.timeout_add_seconds(3,self.refresh)
    def apply_ui2_style(self,*_):
        self.style_provider.load_from_data(ui2_css(UI2_DARK if gtk_prefers_dark() else UI2_LIGHT))
    def row(self,n,label,value,ok):
        a=Gtk.Label(label=label,xalign=0); b=Gtk.Label(label=("● " if ok else "○ ")+value,xalign=0)
        b.add_css_class("success" if ok else "error"); self.grid.attach(a,0,n,1,1); self.grid.attach(b,1,n,1,1)
    def start(self,*_): run("systemctl","--user","enable","--now",UNIT); self.refresh()
    def stop(self,*_): run("systemctl","--user","disable","--now",UNIT); self.refresh()

    # Fast Remote toggle. The switch drives the ONE moos-fast-remote script; refresh() reads
    # its status back so the panel always reflects the real mode (e.g. if it was flipped by
    # Meta+R or the launcher's right-click action). The _fast_syncing guard stops that
    # read-back from re-firing the script — set_active() also emits "state-set".
    def fast_status(self): return run("moos-fast-remote","status").stdout.strip()=="on"
    def on_fast_toggled(self,_switch,state):
        if getattr(self,"_fast_syncing",False): return False
        run("moos-fast-remote","on" if state else "off"); self.refresh()
        return False

    def on_enable_anywhere(self,*_):
        # This used to call `tailscale serve` immediately. On a fresh MoOS install Tailscale is
        # in NeedsLogin and the user is not its operator, so the promised one-click button could
        # only fail and tell the owner to open a terminal. Do the complete first-run flow here:
        # Polkit asks for the local password, `tailscale up` prints the private login URL, and
        # after authentication the same worker enables HTTPS serve. Keep it off GTK's main
        # thread because `tailscale up` deliberately waits for the browser/QR login to finish.
        if getattr(self,"_setup_running",False): return
        self._setup_running=True
        self.anywhere_btn.set_sensitive(False)
        self._show_setup(
            "<b>Starting secure sign-in… / جارٍ بدء تسجيل الدخول الآمن…</b>\n"
            "Approve the local administrator prompt once.\n"
            "وافق على طلب صلاحية المسؤول مرة واحدة.")
        threading.Thread(target=self._setup_anywhere,daemon=True).start()

    def _show_setup(self,markup,url=None):
        self._setup_markup=markup
        self.address.set_markup(markup)
        if url:
            path=os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",f"mo-remote-login-{os.getuid()}.png")
            if qr_png(url,path): self.qr.set_filename(path); self.qr.set_visible(True)
        return False

    def _setup_anywhere(self):
        output=[]
        try:
            state=json.loads(run("tailscale","status","--json").stdout or "{}").get("BackendState")
            if state != "Running":
                user=pwd.getpwuid(os.getuid()).pw_name
                proc=subprocess.Popen(
                    ["/usr/bin/pkexec","/usr/bin/tailscale","up","--operator",user],
                    text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
                for line in proc.stdout or ():
                    output.append(line.strip())
                    match=re.search(r"https://[^\s]+",line)
                    if match:
                        url=match.group(0).rstrip(".,)")
                        markup=(
                            "<b>Finish Tailscale sign-in / أكمل تسجيل دخول Tailscale</b>\n"
                            "Scan this QR code or open the address, then return here.\n"
                            "امسح الرمز أو افتح العنوان، ثم ارجع هنا.\n\n"
                            f"<tt>{GLib.markup_escape_text(url)}</tt>")
                        GLib.idle_add(self._show_setup,markup,url)
                if proc.wait() != 0:
                    raise RuntimeError("\n".join(output[-4:]) or "Tailscale sign-in was cancelled.")
            else:
                # Existing installations can be logged in but still lack the operator bit.
                user=pwd.getpwuid(os.getuid()).pw_name
                elevated=subprocess.run(
                    ["/usr/bin/pkexec","/usr/bin/tailscale","set",f"--operator={user}"],
                    text=True,capture_output=True)
                if elevated.returncode != 0:
                    raise RuntimeError(elevated.stderr or elevated.stdout or "Administrator approval was cancelled.")
            ok,err=enable_anywhere()
            if not ok: raise RuntimeError(err or "tailscale serve failed")
            GLib.idle_add(self._setup_done,None)
        except (OSError,ValueError,subprocess.SubprocessError,RuntimeError) as exc:
            GLib.idle_add(self._setup_done,str(exc))

    def _setup_done(self,error):
        self._setup_running=False
        self._setup_markup=None
        self.anywhere_btn.set_sensitive(True)
        if error:
            self.address.set_markup(
                "<b>Setup did not finish / لم يكتمل الإعداد</b>\n"
                +GLib.markup_escape_text(error[:400])
                +"\n\nTry the button again. / حاول الزر مرة أخرى.")
            return False
        self.refresh()
        return False

    def refresh(self,*_):
        on=active(UNIT)
        far=tailscale_url() if on else None
        self.status.set_markup(f"<b>Service:</b> {'Running' if on else 'Stopped'}    <b>Device:</b> {GLib.markup_escape_text(socket.gethostname())}")

        if getattr(self,"_setup_markup",None):
            # Do not let the three-second status poll erase the login URL while the owner is
            # authenticating in Tailscale.
            self.address.set_markup(self._setup_markup)
        elif not on:
            self.address.set_text("Remote control is off. Press Start to enable it.\nالتحكم عن بُعد متوقف. اضغط تشغيل.")
            self.anywhere_btn.set_visible(False); self.qr.set_visible(False)
        elif far:
            # The address that survives leaving the house. Say so plainly — the whole failure
            # mode here was a user who had one address and did not know it was the wrong one.
            self.address.set_markup(
                "<b>From anywhere / من أي مكان</b>  ·  works on mobile data\n"
                f"<tt>{GLib.markup_escape_text(far)}</tt>\n\n"
                "<small>Scan the code or open the link on your phone, then enter your PIN.\n"
                "امسح الرمز أو افتح الرابط على جوالك، ثم أدخل الـPIN.</small>")
            self.anywhere_btn.set_visible(False)
            path=os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",f"mo-remote-qr-{os.getuid()}.png")
            if qr_png(far,path):
                self.qr.set_filename(path); self.qr.set_visible(True)
            else:
                self.qr.set_visible(False)
        else:
            # Direct LAN access is off by design (AllowLan=false, most secure): the
            # agent accepts only the Tailscale tailnet + loopback, so we do NOT dangle
            # the blocked LAN address here — we point the user at the path that works.
            self.address.set_markup(
                "<b>Enable remote access / فعّل الوصول عن بُعد</b>\n"
                "<small>For your security, MoOS reaches this PC over your private Tailscale "
                "network — encrypted, and it works from anywhere — not a plain LAN address. "
                "Press the button below once to set it up.\n"
                "لأمانك، يصل MoOS لهذا الجهاز عبر شبكة Tailscale الخاصة — مشفّرة وتعمل من أي "
                "مكان — لا عبر عنوان شبكة محلية مكشوف. اضغط الزر بالأسفل مرة واحدة.</small>")
            self.anywhere_btn.set_visible(True)
            self.qr.set_visible(False)
        while c:=self.grid.get_first_child(): self.grid.remove(c)
        portal=active("xdg-desktop-portal.service")
        pipe=active("pipewire.service")
        sock=os.path.exists(f"/run/user/{os.getuid()}/.ydotool_socket")
        fw=run("systemctl","is-active","--quiet","firewalld.service").returncode==0
        self.row(0,"Firewall", "active" if fw else "inactive",fw)
        self.row(1,"PipeWire", "active" if pipe else "inactive",pipe)
        self.row(2,"Desktop portal", "active" if portal else "inactive",portal)
        self.row(3,"Input permission", "private user socket" if sock else "not ready",sock)
        self.row(4,"MoPC backend", "touch/keyboard/desktop service" if on else "stopped",on)
        # Reflect the real Fast Remote mode without re-triggering it.
        try: fast_on=self.fast_status()
        except (OSError, subprocess.SubprocessError): fast_on=False
        self._fast_syncing=True
        self.fast_switch.set_active(fast_on)
        self._fast_syncing=False
        self.fast_sub.set_text(
            "On — the connection is prioritised: live wallpaper, effects and Mo AI are paused.\n"
            "مفعّل — الاتصال في الأولوية: الخلفية الحية والتأثيرات وMo AI موقوفة."
            if fast_on else
            "Off. Turn it on when the remote feels slow — it frees the machine for the stream.\n"
            "متوقف. شغّله عندما يبطؤ الاتصال — يفرّغ الجهاز لصالح البث.")
        path=os.path.expanduser("~/.local/share/MoRemotePersonal/log.txt")
        try: lines=open(path,errors="replace").read().splitlines()[-30:]; self.log.get_buffer().set_text("\n".join(lines))
        except OSError: self.log.get_buffer().set_text("No log yet.")
        return True

App().run()
