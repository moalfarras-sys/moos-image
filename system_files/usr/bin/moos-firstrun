#!/usr/bin/env bash
# moos-firstrun — one-shot first-login welcome (installed systems AND live).
# Launched by /etc/xdg/autostart/org.moos.firstrun.desktop (OnlyShowIn=KDE).
# Shows the premium MoOS Welcome (moos-welcome) whose buttons install the
# essential apps, open Mo AI, and open the Compatibility Hub for real (via the
# moos:// handler). Falls back to a small kdialog only if the QML Welcome or its
# runtime is unavailable. Runs at most once per user (~/.config/moos-firstrun-done).
# The live user sees it too — intentional (doubles as a demo; live home is
# ephemeral). Docs: MOOS_APP_CENTER_PLAN.md (AC-1) / MOOS_COMPATIBILITY_PLAN.md
set -uo pipefail

marker_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
marker="${marker_dir}/moos-firstrun-done"

# Already ran once for this user — never prompt again.
[ -e "$marker" ] && exit 0

# Mark done BEFORE showing any UI, so a crash/logout mid-dialog can never turn
# this into a nag loop.
mkdir -p "$marker_dir" 2>/dev/null || true
touch "$marker" 2>/dev/null || true

# Wait for the Plasma shell so the Welcome opens onto a ready, Nova-themed
# desktop (not a half-drawn session). Use busctl/gdbus — never a plain `qdbus`
# (absent on Plasma 6). Mirrors moos-apply-theme's probe.
plasma_ready() {
    if command -v busctl >/dev/null 2>&1; then
        busctl --user call org.kde.plasmashell /PlasmaShell \
            org.freedesktop.DBus.Peer Ping >/dev/null 2>&1 && return 0
    fi
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session -d org.kde.plasmashell -o /PlasmaShell \
            -m org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 && return 0
    fi
    for q in qdbus6 qdbus-qt6 qdbus; do
        command -v "$q" >/dev/null 2>&1 \
            && "$q" org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0
    done
    return 1
}
for _ in $(seq 1 40); do plasma_ready && break; sleep 1; done

# Read the machine WHILE the Welcome opens, never before it. moos-device-plan
# shells out to lspci/fwupdmgr/flatpak and takes tens of seconds; running it
# inline would hold the first screen of a brand-new system hostage to a
# hardware probe. The Welcome polls for this file and shows its "we read your
# device" card only if an important, one-action gap is found (today: an NVIDIA
# GPU running without the NVIDIA image). Written atomically so the Welcome can
# never parse half a document, and entirely best-effort: every failure here
# just means the card does not appear.
if command -v moos-device-plan >/dev/null 2>&1; then
    (
        _cache="${XDG_CACHE_HOME:-$HOME/.cache}/moos"
        mkdir -p "$_cache" 2>/dev/null || exit 0
        _tmp="${_cache}/device-plan.json.partial.$$"
        if timeout 120 moos-device-plan --compact >"$_tmp" 2>/dev/null \
                && [ -s "$_tmp" ]; then
            mv -f "$_tmp" "${_cache}/device-plan.json" 2>/dev/null || true
        fi
        rm -f "$_tmp" 2>/dev/null || true
    ) &
fi

# Preferred: the premium Welcome. moos-welcome has its own QML-runtime fallback
# chain and logs; if it can't launch it exits non-zero and we fall back below.
if command -v moos-welcome >/dev/null 2>&1; then
    moos-welcome && exit 0
fi

# Fallback: a minimal kdialog that offers the curated app setup in a terminal.
command -v kdialog >/dev/null 2>&1 || exit 0
msg=$'أهلاً بك في MoOS! هل تريد تثبيت التطبيقات الأساسية الآن؟ (Steam, Bottles, Firefox...)\nWelcome to MoOS! Install the essential apps now?'
if kdialog \
    --title "أهلاً بك في MoOS | Welcome to MoOS" \
    --icon moos-logo \
    --yes-label "تثبيت | Install" \
    --no-label "لاحقاً | Later" \
    --yesno "$msg"; then
    if command -v konsole >/dev/null 2>&1; then
        konsole --hold -e moos-setup
    else
        kdialog --sorry $'لتثبيت التطبيقات شغّل moos-setup من أي طرفية.\nTo install the apps, run moos-setup from any terminal.' || true
    fi
fi
exit 0
