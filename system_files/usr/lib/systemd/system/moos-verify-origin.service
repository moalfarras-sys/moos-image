[Unit]
Description=Put this MoOS install back on the signed update train
Documentation=file:///usr/libexec/moos-verify-origin

# WHY AT BOOT AND NOT IN THE INSTALLER
#
# Because the machines with this problem have already been installed. The cloud
# conversion path runs `system-reinstall-bootc`, which cannot be told to enforce
# the signature policy (1.16.4 has no such flag), so every server converted that
# way is running unverified right now. A fix that only lands in the converter
# repairs future installs and abandons the existing ones.
#
# The check is a local rpm-ostree status read plus one origin-file read. It is
# started by a timer, so even a legacy origin that needs the network can never
# hold graphical.target or the login screen.
ConditionPathExists=/usr/bin/bootc
ConditionPathIsDirectory=/ostree/deploy

# Only the repair branch pulls from the registry, so it needs a route. Because
# the timer starts this unit independently, this ordering does not put the
# network target on the desktop's critical path.
Wants=network-online.target
After=network-online.target

# Do not race the updater. If uupd or rpm-ostreed-automatic is mid-stage, let it
# finish — `bootc switch` and a running stage both write the deployment set.
After=uupd.service rpm-ostreed-automatic.service bootc-fetch-apply-updates.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/moos-verify-origin
RemainAfterExit=no

# The script's own retry loop is ~90s at worst; give it room without letting a
# hung registry hold the boot transaction open indefinitely.
TimeoutStartSec=300
