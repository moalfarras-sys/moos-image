[Unit]
Description=Nightly MoOS signed-image update

[Timer]
# After uupd's 04:00 window so the two never contend for rpm-ostreed; the
# script additionally skips when a transaction is already in progress.
# Persistent=true catches machines that were off at 04:30 — combined with the
# service's idle scheduling, a morning boot stages quietly in the background.
OnCalendar=04:30
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
