[Unit]
Description=MoOS nightly signed-image update
Documentation=file:///usr/libexec/moos-image-update
# uupd owns Flatpak/distrobox refreshes only. moos-image-update is the sole OS
# deployment writer and advances digest-pinned signed origins safely.
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/ostree/deploy

[Service]
Type=oneshot
ExecStart=/usr/libexec/moos-image-update auto
# Same background manners as uupd's MoOS drop-in: a staged update is never
# worth a stuttering session. An idle machine finishes at full speed anyway.
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=1800
