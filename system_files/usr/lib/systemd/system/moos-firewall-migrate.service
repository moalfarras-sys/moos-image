[Unit]
Description=Migrate the inherited desktop firewall to the least-exposed MoOS policy
Documentation=file:///usr/libexec/moos-firewall-migrate
ConditionPathExists=/run/ostree-booted
Requires=firewalld.service
After=firewalld.service
Before=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/moos-firewall-migrate
TimeoutStartSec=15s

[Install]
WantedBy=network-pre.target
