[Unit]
Description=Bless a successful MoOS boot shortly after it completes
Documentation=file:///usr/libexec/moos-boot-assess

[Timer]
# Late enough that a normal desktop has reached its default target, early enough
# that a user who reboots quickly still gets the boot counted as good. The
# script itself waits for the target, so this only decides when to start looking.
OnBootSec=90s
AccuracySec=5s
Unit=moos-boot-assess-bless.service

[Install]
WantedBy=timers.target
