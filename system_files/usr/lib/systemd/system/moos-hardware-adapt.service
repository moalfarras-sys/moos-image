[Unit]
Description=MoOS hardware adaptation (safe, idempotent, re-runnable)
Documentation=https://github.com/moalfarras-sys/moos-image
# Only on a real installed MoOS deployment — never in a build container.
ConditionPathExists=/run/ostree-booted
# Hardware probing and live zram reconfiguration are explicitly post-desktop.
# graphical.target does not want this service; the timer starts it independently,
# so a slow DDC probe can never hold the login/desktop critical path.
After=graphical.target local-fs.target systemd-sysctl.service
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/moos-hardware-adapt
# The script is idempotent and best-effort; a failure must never block boot.
SuccessExitStatus=0
# Nothing orders after this unit: its timer starts it 45 s after the desktop, so this bound only
# has to stop a real hang, never protect boot. 90 s was too short for an emulated ARM first boot:
# on the qcow2 boot proof (run 34717090843) re-activating zram took 43 s (daemon-reload + one
# start) and enabling fwupd-refresh.timer 30 s (enable reloads systemd again), and systemd killed
# the pass at exactly 90 s with no success stamp written. UTM without a JIT is slower still.
# tests/verify_arm_runtime.sh waits longer than the timer delay plus this bound.
TimeoutStartSec=10min
