[Unit]
Description=Prepare the MoOS application store on first boot
After=local-fs.target
Before=display-manager.service flatpak-system-helper.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/moos-flatpak-init
TimeoutStartSec=30
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
