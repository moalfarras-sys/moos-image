[Unit]
Description=MoOS UTM installer menu
After=NetworkManager.service cloud-final.service
Wants=NetworkManager.service
ConditionPathExists=!/etc/moos-utm-install-complete

[Service]
Type=simple
Environment=TERM=linux
ExecStart=/usr/libexec/moos-utm-installer-menu
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
