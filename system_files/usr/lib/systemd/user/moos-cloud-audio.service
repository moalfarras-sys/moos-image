[Unit]
Description=MoOS Cloud audio stream (this account's sound, over HTTP)
Documentation=file:///usr/bin/moos-cloud-audio

# The capture target is the audio server's default sink monitor, so there has to
# be an audio server first. On a VPS with no sound card that is still true —
# WirePlumber invents a null sink, and its monitor is what carries what the
# desktop is playing.
Wants=pipewire-pulse.service
After=pipewire-pulse.service pipewire.service

# A genuinely broken setup should fail loudly rather than spin. The unit restarts
# once per listener by design (see below), so the window has to be long enough to
# tell "somebody closed the tab five times" apart from "this can never start" —
# and short enough that a real fault is still visible in `systemctl --failed`.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/moos-cloud-audio

# ffmpeg's built-in HTTP server (-listen 1) serves exactly one client and exits
# when that client disconnects. That suits one-person-per-desktop, but it means
# the unit MUST come back by itself or sound works once per boot and never again.
# `always`, not `on-failure`: a listener leaving is a clean exit as often as not.
Restart=always
RestartSec=2

# Idle cost measured on the real server: 0.2% of a core, 66 MB RSS — ffmpeg waits
# in accept() before opening the capture, so nothing is encoded until somebody is
# actually listening. The cap is a backstop, not a working limit.
MemoryMax=512M

[Install]
WantedBy=default.target
