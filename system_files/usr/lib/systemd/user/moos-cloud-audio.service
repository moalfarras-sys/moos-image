[Unit]
Description=MoOS Cloud audio stream (this account's sound, over HTTP)
Documentation=file:///usr/bin/moos-cloud-audio

# The capture target is the audio server's default sink monitor, so there has to
# be an audio server first. On a VPS with no sound card that is still true —
# WirePlumber invents a null sink, and its monitor is what carries what the
# desktop is playing.
Wants=pipewire-pulse.service
After=pipewire-pulse.service pipewire.service

# This is a long-lived server now, not a one-shot that exits per listener, so a
# restart loop means something is genuinely broken rather than "somebody closed
# the tab". Five in a minute is generous for a real fault and still lands the unit
# in `systemctl --failed` instead of letting it spin.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/moos-cloud-audio

# The HTTP server stays up for the life of the session; the GStreamer pipeline
# behind it is what comes and goes — one per listener, spawned on request and
# killed when they leave. So the port answers immediately after login and a
# reconnecting listener never waits for a unit restart, which is exactly what the
# old ffmpeg `-listen 1` shape forced: ffmpeg's HTTP server serves one client and
# then exits, so sound worked once per restart and the unit churned to keep up.
Restart=always
RestartSec=2

# Idle cost is nothing at all: no encoder is started until somebody actually
# requests /stream.webm, and it is killed when they disconnect. The cap covers the
# Python server plus up to MAX_LISTENERS (4) concurrent Opus encoders and is a
# backstop, not a working limit.
MemoryMax=768M

[Install]
WantedBy=default.target
