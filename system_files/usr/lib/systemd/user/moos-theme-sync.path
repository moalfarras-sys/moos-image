[Unit]
Description=Watch automatic light/dark theme transitions for MoOS supplements
PartOf=plasma-workspace.target
# Do not watch the separate system greeter's palette as a desktop theme.
ConditionUser=!@system

[Path]
# KConfig atomically rewrites this file when AutomaticLookAndFeel switches its
# target at sunrise/sunset. The paired service never writes kdeglobals, so this
# watch cannot trigger itself.
PathChanged=%h/.config/kdeglobals
# The existing shell filters actual image changes into this inert event hash.
# Applet moves/geometry writes must never wake the reconciliation service.
PathChanged=%h/.config/moos-wallpaper-intent.conf
Unit=moos-theme-sync.service

[Install]
WantedBy=plasma-workspace.target
