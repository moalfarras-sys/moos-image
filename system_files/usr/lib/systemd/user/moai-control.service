# Mo AI control API — always-on tiny localhost service that backs the in-app
# Settings page (read/write brain config, switch local/cloud model services).
# Enabled by default for every user (build.sh: systemctl --global enable).
[Unit]
Description=Mo AI control API (in-app settings backend)
After=graphical-session.target
# A port clash or syntax regression must become a visible failed unit, not a tiny but
# permanent five-second fork loop. Six attempts still give transient session startup
# failures half a minute to recover.
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
# Must match moai-gateway.service.  setup-brain changes one per-user file, not
# two unrelated drop-ins that can drift and make a healthy brain look offline.
Environment=MOAI_LOCAL_UNIT=moai.service
Environment=MOAI_LOCAL_BACKEND=ramalama
Environment=MOAI_LOCAL_PORT=8081
Environment=MOAI_LOCAL_MODEL=ollama://qwen2.5:7b-instruct
EnvironmentFile=-%h/.config/moos/moai-local.env
ExecStart=/usr/bin/moai-control
Restart=on-failure
RestartSec=5
TimeoutStopSec=15s

[Install]
WantedBy=default.target
