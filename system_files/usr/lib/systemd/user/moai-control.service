# Mo AI control API — always-on tiny localhost service that backs the in-app
# Settings page (read/write brain config, switch local/cloud model services).
# Enabled by default for every user (build.sh: systemctl --global enable).
[Unit]
Description=Mo AI control API (in-app settings backend)
After=graphical-session.target
# A port clash or syntax regression must become a visible failed unit, not a tiny but
# permanent five-second fork loop. Six attempts still give transient session startup
# failures half a minute to recover.
StartLimitIntervalSec=120
StartLimitBurst=6

# Mo AI belongs to a HUMAN, and root is not one. The port generator
# (60-moai-ports) only prints an offset for uid >= 1000, so a system account —
# root above all — falls back to the built-in 8080/8079/8077, which ARE uid
# 1000's ports. On the Cloud host root has a real login session, so its user
# manager started these: measured there as moai-agent-api failing "[Errno 98]
# Address already in use" in a restart loop. The failure is the benign outcome.
# The other outcome is the dangerous one: whoever binds first wins, so a root
# session that starts before the desktop user's would own uid 1000's front door
# — a root-privileged loopback API that shells out to `openclaw` and
# `systemctl --user`, reachable by every local account, since X-Moai-* are
# guards against web pages and not against another user on the same machine.
# ConditionUser closes it at the only place that is airtight: the unit never
# starts for a system user at all.
ConditionUser=!@system

[Service]
Type=simple
# Must match moai-gateway.service.  setup-brain changes one per-user file, not
# two unrelated drop-ins that can drift and make a healthy brain look offline.
Environment=MOAI_LOCAL_UNIT=moai.service
Environment=MOAI_LOCAL_BACKEND=ramalama
Environment=MOAI_LOCAL_PORT=8081
Environment=MOAI_LOCAL_MODEL=ollama://qwen2.5:7b-instruct
EnvironmentFile=-%h/.config/moos/moai-local.env
ExecStart=/usr/bin/moai-control
Restart=on-failure
RestartSec=5
TimeoutStopSec=15s

[Install]
WantedBy=default.target
