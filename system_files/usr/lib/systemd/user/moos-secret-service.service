[Unit]
Description=MoOS Secret Service compatibility for application credentials
PartOf=plasma-workspace.target
After=plasma-kwallet-pam.service
ConditionFileIsExecutable=/usr/bin/ksecretd

[Service]
Type=simple
ExecStart=/usr/bin/ksecretd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
