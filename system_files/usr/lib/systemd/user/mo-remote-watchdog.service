[Unit]
Description=Recover Mawj if it crashed out of its start limit
Documentation=file:/usr/libexec/mo-remote-watchdog
# Mo AI's units use this to keep a root login session from starting a user
# service that belongs to a human; the same reasoning applies here.
ConditionUser=!@system
# THE MARKER IS THE WAYLAND SOCKET, NOT THE BUS.
#
# The $HOME ancestor of this unit originally had its ConditionPathExists in the
# [Service] section, where systemd ignores Condition* entirely: it logged
# "Unknown key ... ignoring" on every firing and the guard never applied. The
# timer then fired 12.65s into the session, before the graphical session
# existed, started mo-remote-personal, whose Wants= pulled up
# xdg-desktop-portal; xdg-desktop-portal-kde is a QApplication, so with no
# platform plugin it hit qFatal and SIGABRT, and systemd logged "Dependency
# failed for xdg-desktop-portal.service" at 13.18s. That happened on every boot.
#
# %t/bus is not the right marker either -- the bus exists at 12.5s, before the
# session.
#
# NOR IS A FIXED SOCKET NAME. This unit used ConditionPathExists=%t/wayland-0
# until 2026-11-24, when the V3 station's KWin was measured listening on
# wayland-1 with no wayland-0 at all: the watchdog was skipped 792 times in
# one boot and a crashed Remote would never have come back on that machine.
# Plasma publishes the compositor it actually started by importing
# WAYLAND_DISPLAY into this manager's environment; that is the session marker.
# The manager can keep that value after a logout, so the script additionally
# asks the shared resolver for a compositor that answers before it restarts
# anything (mo-remote-start resolves the same way).
ConditionEnvironment=WAYLAND_DISPLAY
After=plasma-workspace.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/mo-remote-watchdog
# The recovery is a couple of systemctl calls; if it ever hangs, the timer's
# next firing is the retry.
TimeoutStartSec=30
# Once a minute for the whole session, the manager's own Starting/Finished lines
# were 2,880 journal entries a day saying nothing, in a journal capped at 500 MB
# that already fails to reach back one boot. Keep this script's own messages (a
# recovery, or a missing compositor) by logging them at notice, and drop the
# manager's info-level chatter about the unit. Measured 2026-11-24 on the V3 user
# manager with transient units: the echo survived, Starting/Finished did not.
# A timeout or failure is logged above notice and still appears.
SyslogLevel=notice
LogLevelMax=notice

# NO [Install] SECTION ON PURPOSE — mo-remote-watchdog.timer starts this.
