[Unit]
Description=Keep Mo Remote's HTTPS certificate current
ConditionUser=!@system

[Timer]
# Tailscale certificates last ~90 days and are re-issued as expiry approaches, so a daily check is
# far more often than strictly needed — and that is the point. The failure this prevents is the
# one where the certificate quietly expires, the phone refuses to connect, and nobody remembers
# that a certificate was ever involved.
OnStartupSec=2min
OnUnitActiveSec=24h
Persistent=true

[Install]
WantedBy=timers.target
