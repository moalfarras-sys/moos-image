[Unit]
Description=Reconcile Mo AI's brain shortly after login, without delaying the session

# WHY A TIMER AND NOT WantedBy=default.target.
#
# The service is Type=oneshot with RemainAfterExit, so anything that Wants it must
# WAIT for it to exit before that target is considered reached. Pulling it in from
# default.target therefore put it directly on the session's critical path, which is
# the one thing its own unit file says must not happen ("never let it block the
# session"). Measured on the maintainer's machine:
#
#     systemd-analyze --user critical-chain
#     default.target @9.440s
#     └─moos-ensure-brain.service @1.490s +7.949s
#
# — 7.9 of the session's 9.4 seconds, spent to log "brain already correct for this
# machine — nothing to do". It queries the model backend, and that query is slow
# whether or not there is any work to do, so the cost was paid at EVERY login.
#
# Nothing about the reconcile needs to happen before the desktop appears: it is
# idempotent, failure-tolerant, and the gateway starts the brain on demand anyway.
# Running it a few seconds into the session keeps the same guarantee and gives the
# user their desktop ~8 seconds sooner.
[Timer]
# Relative to the user manager starting. Late enough to be off the login path,
# early enough that the reconcile has happened long before anyone opens Mo AI.
OnStartupSec=15s
AccuracySec=5s
# One-shot per session; the brain does not drift while the machine is running, and
# `moai-control` restarts the service explicitly when the user changes the model.
Persistent=false

[Install]
WantedBy=timers.target
