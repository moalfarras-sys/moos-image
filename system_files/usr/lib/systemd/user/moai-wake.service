[Unit]
Description=Mo AI Telegram wake receiver (lightweight; starts OpenClaw on demand)
Documentation=file:///usr/bin/moai-wake
# Only needs the network for the Telegram long-poll — NOT the AI stack. It must
# stay up whether or not Ollama/OpenClaw are running, so it depends on neither.
Wants=network-online.target
After=network-online.target
# Network failures are handled inside the process with bounded backoff. Reaching systemd
# therefore means a real crash; five crashes in five minutes must stay failed and visible.
StartLimitIntervalSec=300
StartLimitBurst=5

# Mo AI belongs to a HUMAN, and root is not one. The port generator
# (60-moai-ports) only prints an offset for uid >= 1000, so a system account —
# root above all — falls back to the built-in 8080/8079/8077, which ARE uid
# 1000's ports. On the Cloud host root has a real login session, so its user
# manager started these: measured there as moai-agent-api failing "[Errno 98]
# Address already in use" in a restart loop. The failure is the benign outcome.
# The other outcome is the dangerous one: whoever binds first wins, so a root
# session that starts before the desktop user's would own uid 1000's front door
# — a root-privileged loopback API that shells out to `openclaw` and
# `systemctl --user`, reachable by every local account, since X-Moai-* are
# guards against web pages and not against another user on the same machine.
# ConditionUser closes it at the only place that is airtight: the unit never
# starts for a system user at all.
ConditionUser=!@system

[Service]
Type=simple
ExecStart=/usr/bin/moai-wake
Restart=always
RestartSec=5
TimeoutStopSec=10s
# This is the ONLY piece of Mo AI that is always resident. Keep it tiny: pure
# Python stdlib, no model, no Node, no podman — a few MB. The cap is a backstop.
MemoryMax=128M
CPUWeight=20
Nice=10
# Light hardening — it only reads ~/.openclaw/openclaw.json and shells
# `systemctl --user`. Kept conservative so nothing blocks the user D-Bus it needs
# to start openclaw-gateway (ProtectHome/aggressive filters are deliberately omitted).
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
