[Unit]
Description=Refresh Mo Remote's HTTPS certificate
Documentation=file:///usr/lib/mo-remote/refresh-cert.sh
ConditionUser=!@system
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/mo-remote/refresh-cert.sh
# The script exits 0 on every "nothing to do" path (no tailnet, no Mo Remote setup, tailnet
# without HTTPS), so a non-zero exit here means something genuinely unexpected.
