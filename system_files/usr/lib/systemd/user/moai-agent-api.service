[Unit]
Description=Mo AI agent API (settings, sessions and status for the Agent panel)
Documentation=https://github.com/moalfarras-sys/moos-image
After=network-online.target
Wants=network-online.target

# If 127.0.0.1:8077 is already held by ANOTHER app (e.g. a user's own console),
# the bind fails "Address already in use" on every start — and because each
# start first runs the ExecStartPre bootstrap (which shells out to `openclaw
# config validate`, a heavy Node process), an uncapped Restart=on-failure turns
# a benign port clash into a permanent CPU fire. Cap it: after 4 failures in
# 2 min systemd gives up and the unit rests in failed state (recover with
# `systemctl --user reset-failed moai-agent-api && systemctl --user start` once
# the port is free). These live in [Unit], not [Service] — systemd moved them
# in v229. (These sit in front of MOAI_AGENT_PORT, which can also be overridden
# to sidestep a clash entirely.)
StartLimitIntervalSec=120
StartLimitBurst=4

# Mo AI belongs to a HUMAN, and root is not one. The port generator
# (60-moai-ports) only prints an offset for uid >= 1000, so a system account —
# root above all — falls back to the built-in 8080/8079/8077, which ARE uid
# 1000's ports. On the Cloud host root has a real login session, so its user
# manager started these: measured there as moai-agent-api failing "[Errno 98]
# Address already in use" in a restart loop. The failure is the benign outcome.
# The other outcome is the dangerous one: whoever binds first wins, so a root
# session that starts before the desktop user's would own uid 1000's front door
# — a root-privileged loopback API that shells out to `openclaw` and
# `systemctl --user`, reachable by every local account, since X-Moai-* are
# guards against web pages and not against another user on the same machine.
# ConditionUser closes it at the only place that is airtight: the unit never
# starts for a system user at all.
ConditionUser=!@system

[Service]
Type=simple
# ~/.local/node/bin carries the Node that OpenClaw needs (>= 22.22.3); the image
# ships 22.22.2, one patch below the engine floor, so `moai-do install-openclaw`
# puts a newer one in the user's home rather than layering onto /usr.
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/bin:/bin
Environment=OLLAMA_API_KEY=ollama-local
# Existing installations pass through the same preserving, schema-validating
# migration as a fresh install. The leading '-' keeps the status/repair panel
# available when a user-owned config needs manual attention.
ExecStartPre=-/usr/libexec/moai-openclaw-bootstrap --existing-only
ExecStart=/usr/bin/moai-agent-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=15s
UMask=0077

# ── Hardening, and what is deliberately absent ─────────────────────────
# This service writes the API key and the Telegram bot token, and shells out to
# `openclaw` and `systemctl --user`. It binds 127.0.0.1 only. Never expose it,
# never place it behind a reverse proxy.
#
# The following are NOT set because each one, alone, breaks rootless podman —
# which this service reaches indirectly through `openclaw agent` (sandboxed tool
# calls) and `podman exec` (model status):
#
#   ProtectKernelTunables  ProtectKernelModules  ProtectClock  ProtectKernelLogs
#   PrivateUsers           PrivateTmp            NoNewPrivileges
#   CapabilityBoundingSet  RestrictSUIDSGID      ProtectControlGroups
#   KeyringMode=private    InaccessiblePaths
#
# They all fail with the same message, which blames podman and suggests
# `podman system migrate` — that never helps, the cause is always a directive
# here. Measured individually with `systemd-run --user` on 2026-07-20.
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=default.target
