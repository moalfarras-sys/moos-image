[Unit]
Description=Mo Remote
ConditionUser=!@system
After=plasma-workspace.target network-online.target ydotoold-moremote.service mo-remote-cert.service
# The certificate must exist BEFORE we start: Kestrel loads it once, at startup, so a cert that
# arrives afterwards leaves the phone on plain http — no H.264, no clipboard — until the next
# restart. Ordering it ahead of us costs a few seconds on a cold boot and nothing after that.
Wants=network-online.target ydotoold-moremote.service mo-remote-cert.service
PartOf=plasma-workspace.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(basename "$(find "%t" -maxdepth 1 -type s -name "wayland-*" -print -quit)")}"; exec /usr/bin/systemd-inhibit --what=sleep:idle --who=MoRemotePersonal --why=Remote-access-availability --mode=block /usr/lib/mo-remote/MoRemotePersonal'
Restart=on-failure
RestartSec=3
Environment=DOTNET_EnableDiagnostics=0
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=QT_QPA_PLATFORM=wayland

[Install]
WantedBy=plasma-workspace.target
