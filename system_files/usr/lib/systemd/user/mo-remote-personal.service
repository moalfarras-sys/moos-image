[Unit]
Description=Mo Remote
ConditionUser=!@system
After=plasma-workspace.target network-online.target ydotoold-moremote.service
Wants=network-online.target ydotoold-moremote.service
PartOf=plasma-workspace.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=MoRemotePersonal --why=Remote-access-availability --mode=block /usr/lib/mo-remote/MoRemotePersonal
Restart=on-failure
RestartSec=3
Environment=DOTNET_EnableDiagnostics=0
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=plasma-workspace.target
