[Unit]
Description=Mo AI local brain (RamaLama)
Documentation=https://github.com/moalfarras-sys/moos-image
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 8081, NOT 8080. 8080 belongs to moai-gateway — the single always-on front door,
# which routes each request and starts THIS unit on demand when a conversation
# picks the local brain. Both brains sharing 8080 is the architecture this
# replaced: it made the choice of brain a global setting that could only be
# changed by bouncing systemd units.
#
# ~/.config/moos/moai.env is read AFTER these lines and therefore OUTRANKS them.
# Every machine that has ever run `moai-start` carries one that says 8080, so
# correcting the unit alone changes nothing — moai-control's ensure_front_door()
# rewrites that file on every start. Fix the file that decides, not the one we ship.
Environment=MOAI_PORT=8081
Environment=MOAI_MODEL=ollama://qwen3:4b-instruct
# Cap the context so llama.cpp cannot project a KV cache bigger than the GPU has —
# the documented SIGABRT-out-of-VRAM that, on an 8 GB card shared with the Wayland
# compositor, could take the desktop down with it. --ngl auto offloads as many
# layers as fit and is a harmless no-op on CPU-only hardware (verified via
# `ramalama --dryrun serve …`: same runtime image, GPU passed through when present).
Environment=MOAI_CTX=4096
EnvironmentFile=-%h/.config/moos/moai.env
ExecStart=/usr/bin/ramalama serve --ctx-size ${MOAI_CTX} --ngl auto --port ${MOAI_PORT} ${MOAI_MODEL}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# The model server is unprivileged and bound to localhost by RamaLama. Rootless
# Podman needs the normal user mount namespace plus container config/storage;
# systemd filesystem/mount namespace sandbox directives break that backend.

# [Install] exists so `moai-start` can enable the brain for a user who wants it
# warm at login. The IMAGE never enables it (no `systemctl --global enable` for
# this unit in build.sh): it is on demand. A machine whose owner only ever talks
# to the cloud must not load 2.5 GB of weights into VRAM at every login — on this
# hardware the local model already holds 6 of 8 GB.
[Install]
WantedBy=default.target
