[Unit]
Description=Ensure Mo AI runs the fast instruct brain (not a slow thinking model)
# Only one of these two allowlisted Quadlets is selected. After= does not pull
# either service in; it merely ensures that, when the selected one is also in
# the boot transaction, its container reaches active state before this oneshot.
After=network-online.target ollama.service moai-brain.service
Wants=network-online.target
# Do not fail the session if the brain isn't installed on this edition.
ConditionPathExists=/usr/bin/moos-ensure-brain

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/moos-ensure-brain
# Idempotent + failure-tolerant by design; never let it block the session.
TimeoutStartSec=900

# NO [Install] SECTION ON PURPOSE — moos-ensure-brain.timer starts this.
#
# It used to carry `WantedBy=default.target`, and because this is a Type=oneshot
# with RemainAfterExit, systemd holds default.target until it EXITS. That put it on
# the session's critical path and contradicted the line above: measured on the
# maintainer's machine it was 7.949s of the session's 9.440s, and its own log for
# that run reads "brain already correct for this machine — nothing to do". The model
# query behind it is slow whether or not there is work, so every login paid it.
#
# The timer runs it 15s into the session instead: same reconcile, same guarantees,
# off the path between the user logging in and their desktop appearing.
