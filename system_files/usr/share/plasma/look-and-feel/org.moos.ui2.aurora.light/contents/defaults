# MoOS Aurora Light matched Global Theme defaults. Generated file.
[kdeglobals][General]
ColorScheme=MoOSUI2AuroraLight

[plasmarc][Theme]
name=MoOSUI2AuroraLight

[ksplashrc][KSplash]
Theme=org.moos.ui2.aurora.light
Engine=KSplashQML

[kdeglobals][Icons]
Theme=MoOSUI2Light

[kdeglobals][Sounds]
Enable=true
Theme=moos

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2AuroraLight

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

[kcminputrc][Mouse]
cursorTheme=MoOSDark
