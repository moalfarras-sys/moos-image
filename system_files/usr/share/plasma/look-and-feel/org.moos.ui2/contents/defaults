# MoOS UI matched Global Theme defaults. Generated file.
[kdeglobals][General]
ColorScheme=MoOSUI2Dark

[kdeglobals][KDE]
widgetStyle=Breeze

[plasmarc][Theme]
name=MoOSUI2

[ksplashrc][KSplash]
Theme=org.moos.ui2
Engine=KSplashQML

[kdeglobals][Icons]
Theme=MoOSUI2

[kdeglobals][Sounds]
Enable=true
Theme=moos

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=15
NoiseStrength=3

[kcminputrc][Mouse]
cursorTheme=MoOS
