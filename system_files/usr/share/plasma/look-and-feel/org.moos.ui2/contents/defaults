# MoOS UI2 matched Global Theme defaults. Generated file.
[kdeglobals][General]
ColorScheme=MoOSUI2Dark

[plasmarc][Theme]
name=MoOSUI2

[Wallpaper]
Image=MoOSUI2Graphite

[ksplashrc][KSplash]
Theme=org.moos.ui2
Engine=KSplashQML

[kdeglobals][Icons]
Theme=MoOSUI2

[kdeglobals][Sounds]
Enable=true
Theme=moos-nova

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

[kcminputrc][Mouse]
cursorTheme=NovaIce
