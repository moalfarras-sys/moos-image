# MoOS Arena matched Global Theme defaults. Generated file.
[kdeglobals][General]
ColorScheme=MoOSUI2Arena

[plasmarc][Theme]
name=MoOSUI2Arena

[ksplashrc][KSplash]
Theme=org.moos.ui2.gaming
Engine=KSplashQML

[kdeglobals][Icons]
Theme=MoOSUI2

[kdeglobals][Sounds]
Enable=true
Theme=moos

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2Arena

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

[kcminputrc][Mouse]
cursorTheme=MoOS
