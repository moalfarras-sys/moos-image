# org.moos.nova — Look-and-Feel defaults
# NovaDark color scheme + Nova Horizon wallpaper ship in this image already.
# Nova icon theme is generated from Colloid in build.sh (c5); NovaIce
# cursors are generated from Bibata-Modern-Ice in build.sh (c6).
# KConfig group syntax: [file][group] followed by key=value lines.

[kdeglobals][General]
ColorScheme=NovaDark

# Plasma Style (desktoptheme) = Nova — restyles notifications, the volume/
# brightness OSD, and dialogs to MoOS navy glass. The Nova desktoptheme ships
# original identity glyphs and selected safe FrameSvg states; all remaining
# paths fall back through breeze-dark to Breeze geometry while retaining Nova
# colors. LookAndFeelManager writes this into ~/.config/plasmarc [Theme] name.
[plasmarc][Theme]
name=Nova

[Wallpaper]
Image=NovaHorizon

[ksplashrc][KSplash]
Theme=org.moos.nova
Engine=KSplashQML

# Nova icon theme — generated at image build time from Colloid in
# build.sh section (c5). Inherits Colloid-Dark -> Papirus-Dark ->
# breeze-dark -> hicolor, so every icon name still resolves.
[kdeglobals][Icons]
Theme=Nova

# Nova event sounds (original MoOS sound theme, /usr/share/sounds/moos-nova).
# Mirrors the /etc/xdg/kdeglobals system default so re-applying the Global
# Theme restores it too.
[kdeglobals][Sounds]
Enable=true
Theme=moos-nova

# --- KWin blur ---------------------------------------------------------------
# Key names VERIFIED against kwin master src/plugins/blur/blur.kcfg (config
# group "Effect-blur", Int entries BlurStrength / NoiseStrength) and the
# standard kwinrc [Plugins] <effectId>Enabled toggle (effect id: "blur").
# NOTE: Plasma 6's LookAndFeelManager applies only a hardcoded set of entries
# from a defaults file (upstream org.kde.breeze ships exactly that set) —
# arbitrary [kwinrc] groups like these are currently IGNORED by it. They stay
# here as theme documentation; the *operative* system default ships in
# /etc/xdg/kwinrc (plain KConfig cascade), see that file in this repo.
[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

# Lock screen wallpaper: when applying an L&F package, LookAndFeelManager only
# writes kscreenlockerrc [Greeter] Theme= — nested groups like
# [kscreenlockerrc][Greeter][Wallpaper][org.kde.image][General] in a defaults
# file are NOT applied. The NovaHorizon lock screen wallpaper therefore ships
# as /etc/xdg/kscreenlockerrc instead (same KConfig cascade as kwinrc above).

# NovaIce cursor theme — built at image build time from Bibata-Modern-Ice
# (GPL-3.0) in build.sh section (c6). Unlike the arbitrary [kwinrc] groups
# above, [kcminputrc][Mouse] cursorTheme IS part of the entry set
# LookAndFeelManager applies (upstream org.kde.breeze ships exactly
# "cursorTheme=breeze_cursors" in its defaults). The system-wide fallback
# additionally ships in /etc/xdg/kcminputrc (plain KConfig cascade).
[kcminputrc][Mouse]
cursorTheme=NovaIce
