# MoOS UI2 matched Global Theme defaults. Generated file.
[kdeglobals][General]
ColorScheme=MoOSUI2Light

[plasmarc][Theme]
name=MoOSUI2Light

[Wallpaper]
Image=MoOSUI2Tide

[ksplashrc][KSplash]
Theme=org.moos.ui2.light
Engine=KSplashQML

[kdeglobals][Icons]
Theme=MoOSUI2Light

[kdeglobals][Sounds]
Enable=true
Theme=moos-nova

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2Light

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

[kcminputrc][Mouse]
cursorTheme=NovaIce
