# org.moos.nova.light — Look-and-Feel defaults (the LIGHT half of MoOS Nova).
#
# org.moos.nova is MoOS's default and stays the default. This is its twin, and the
# two are a MATCHED PAIR: moos-apply-theme sets them as Plasma's
# DefaultDarkLookAndFeel and DefaultLightLookAndFeel.
#
# That pairing is the point. The day/night switch used to be defused outright,
# because its targets pointed at Fedora look-and-feel packages MoOS had removed —
# and Plasma's fallback for a missing target is not the configured theme, it is
# Breeze, which it then writes into the user's kdeglobals for good. Pointing both
# targets at MoOS themes fixes that at the root: whichever way the switch fires,
# it lands on MoOS.
#
# Everything below mirrors org.moos.nova/contents/defaults key for key. Read that
# file first — its comments explain WHY each entry has to be here. Short version:
# LookAndFeelManager applies only a hardcoded SUBSET of a defaults file, and what
# it does apply it writes into ~/.config/kdedefaults, which outranks /etc/xdg.
#
# KConfig group syntax: [file][group] followed by key=value lines.

[kdeglobals][General]
ColorScheme=NovaLight

# Plasma Style = NovaLight. It ships no SVGs at all: its plasmarc sets
# FallbackTheme=Nova, so it borrows the dark theme's artwork and repaints it from
# its own `colors` file. Every Nova SVG is written against Plasma's ColorScheme
# stylesheet, which is what makes that work — and what stops the two styles from
# drifting apart the next time one of them is touched.
[plasmarc][Theme]
name=NovaLight

# NovaAurora, not NovaHorizonII. The Horizon wallpaper is navy in BOTH variants —
# measured: its images/ and images_dark/ differ by roughly 3% luminance — so a
# light desktop wearing it just looks like the theme failed to apply. NovaAurora's
# light variant is a genuine porcelain.
[Wallpaper]
Image=NovaAurora

[ksplashrc][KSplash]
Theme=org.moos.nova
Engine=KSplashQML

# The icon theme needs a light twin for the same reason the decoration does: Nova's
# icons inherit Colloid-Dark, whose outlines are drawn to sit on a dark surface and
# vanish on a light one. NovaLight inherits Colloid-Light. Both are generated in
# build.sh section (c5).
[kdeglobals][Icons]
Theme=NovaLight

[kdeglobals][Sounds]
Enable=true
Theme=moos-nova

# The window decoration. Aurorae has no ColorScheme stylesheet, so unlike the
# Plasma style this one really does need its own artwork — generated from the dark
# decoration by artwork/generate_nova_light.py so the two cannot diverge.
#
# This group MUST live in a defaults file and nowhere else. It is in the set
# LookAndFeelManager actually applies, and applying is the only thing that
# overwrites ~/.config/kdedefaults/kwinrc — which outranks /etc/xdg for good.
[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSNovaLight

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

[kcminputrc][Mouse]
cursorTheme=NovaIce
