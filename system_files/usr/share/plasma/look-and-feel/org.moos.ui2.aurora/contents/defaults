# MoOS Aurora matched Global Theme defaults. Generated file.
[kdeglobals][General]
ColorScheme=MoOSUI2Aurora

[plasmarc][Theme]
name=MoOSUI2Aurora

[ksplashrc][KSplash]
Theme=org.moos.ui2.aurora
Engine=KSplashQML

[kdeglobals][Icons]
Theme=MoOSUI2

[kdeglobals][Sounds]
Enable=true
Theme=moos

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2Aurora

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=2

[kcminputrc][Mouse]
cursorTheme=MoOS
