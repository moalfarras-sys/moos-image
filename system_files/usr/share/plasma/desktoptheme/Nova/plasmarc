# MoOS Nova — Plasma Style per-theme config.
#
# [Settings] FallbackTheme is the VERIFIED inheritance mechanism: Plasma's
# ThemePrivate::setThemeName() (plasma/libplasma src/plasma/private/theme_p.cpp)
# reads configForTheme(<theme>) -> desktoptheme/<theme>/plasmarc, group
# [Settings] key FallbackTheme, and follows the chain, then always appends the
# built-in "default" theme (= Breeze). Nova now owns its identity-bearing
# branding and start glyphs; the fallback chain supplies only elements that do
# not yet have a Nova SVG. Lookup order remains:
#   Nova SVGs/colors -> breeze-dark colors -> default geometry fallback
[Settings]
FallbackTheme=breeze-dark

# Default wallpaper hint for this Plasma Style (matches the MoOS Nova Horizon
# wallpaper shipped under /usr/share/wallpapers/NovaHorizon). This is only a
# hint; the operative wallpaper is set by the org.moos.nova Look-and-Feel.
[Wallpaper]
defaultWallpaperTheme=NovaHorizon
defaultFileSuffix=.png
defaultWidth=1920
defaultHeight=1080

# Panels/dialogs go opaque when a window is maximised behind them (upstream
# Breeze default). Floating popups (notifications, OSD) keep the translucent
# blurred glass look from the inherited Breeze translucent dialog SVG + KWin blur.
[AdaptiveTransparency]
enabled=true
