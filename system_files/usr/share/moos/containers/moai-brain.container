[Unit]
Description=Ollama LLM server (rootless podman, hardware-safe)
Documentation=https://github.com/ollama/ollama
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=moai-brain
Image=docker.io/ollama/ollama:latest
AutoUpdate=registry

# ── Hardware acceleration ──────────────────────────────────────────
# CPU-safe by default: this same template ships in both MoOS editions and must
# also start on Intel/AMD systems and in virtual machines. setup-brain inserts
# the two NVIDIA CDI directives immediately below this marker only after both
# nvidia-smi and nvidia-ctk prove the CDI device exists.
# MOOS_NVIDIA_CDI_INSERT

# ── Networking ─────────────────────────────────────────────────────
# 0.0.0.0 is the bind INSIDE the container namespace only. PublishPort
# pins the host side to loopback, so nothing is reachable off-machine.
Environment=OLLAMA_HOST=0.0.0.0:11434
PublishPort=127.0.0.1:11434:11434
# MoOS's brain is offline-first — the local model serves Mo AI, and any cloud
# route goes through moai-gateway with its own key, never Ollama's cloud. Turn
# off Ollama's own ollama.com probing so a fresh boot (network not yet up) stops
# logging "cloud cache hydration failed" / "recommendations refresh failed".
Environment=OLLAMA_NO_CLOUD=true

# ── Performance ────────────────────────────────────────────────────
# Both of the next two are required together: setting KV_CACHE_TYPE
# without FLASH_ATTENTION is a silent no-op.
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
# Ollama's default context is 4096 tokens with SILENT truncation — a single
# agent loop can burn that and the model just "forgets" its task with no
# error. Note a Modelfile `PARAMETER num_ctx` overrides this; verify the
# effective value with /show info inside `ollama run`.
# 22528 is the MEASURED ceiling on this box: it keeps qwen3-vl:4b at "100% GPU"
# (4.8GB) while 24576 spills 17% to CPU and collapses throughput. Re-measure with
# `ollama ps` after any change to desktop VRAM usage or model.
Environment=OLLAMA_CONTEXT_LENGTH=22528
# One model resident at a time: 8GB VRAM cannot hold two ~5GB models, and
# letting Ollama try causes swap thrashing.
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=15m

Volume=%h/.ollama:/root/.ollama:Z

[Service]
# Rootless podman does NOT create the source directory of a bind mount —
# it fails with "statfs ...: no such file or directory" and restart-loops.
ExecStartPre=/usr/bin/mkdir -p %h/.ollama
Restart=always
RestartSec=5
# The first model pull is several GB. systemd's default 90s start timeout
# would kill it mid-pull and leave a confusing failed state.
TimeoutStartSec=900

# Deliberately no [Install]: OpenClaw preflight/moai-gateway start this engine
# only when a request actually selects the local primary.
