[Desktop Entry]
Type=Application
Name=MoOS Themes
Name[ar]=ثيمات MoOS
Comment=Choose a MoOS look, its desktop canvas, glass clarity and wallpaper motion
Comment[ar]=اختر مظهر MoOS وصورة مساحة العمل ووضوح الزجاج وحركة الخلفية
Exec=moos-settings --section=appearance
Icon=moos-themes
Terminal=false
NoDisplay=true
StartupWMClass=systemsettings
Categories=Settings;DesktopSettings;
Keywords=theme;appearance;colors;wallpaper;dark;light;
Keywords[ar]=ثيم;مظهر;ألوان;خلفية;داكن;فاتح;
