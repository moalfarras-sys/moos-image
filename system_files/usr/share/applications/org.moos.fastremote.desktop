[Desktop Entry]
Type=Application
Name=Fast Remote
Name[ar]=اتصال سريع
Comment=Toggle a low-overhead mode that speeds up Mo PC Remote
Comment[ar]=يشغّل/يوقف وضعاً خفيفاً يسرّع الاتصال عن بُعد
Exec=moos-fast-remote toggle
Icon=preferences-system-network-remote
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;fast;speed;stream;موس;سريع;
X-KDE-GlobalAccel=Meta+R
# Fast Remote is no longer a standalone icon — it is merged into Mo PC Remote (the
# panel toggle + the launcher's right-click actions). This entry is kept ONLY so the
# Meta+R global shortcut has a target; NoDisplay keeps it out of the menu and dock so
# the feature is never shown twice. kglobalaccel still registers the shortcut for a
# NoDisplay entry.
NoDisplay=true
