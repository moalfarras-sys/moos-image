[Desktop Entry]
Type=Application
Name=Fast Remote
Name[ar]=اتصال سريع
Comment=Toggle a low-overhead mode that speeds up Mo PC Remote
Comment[ar]=يشغّل/يوقف وضعاً خفيفاً يسرّع الاتصال عن بُعد
Exec=moos-fast-remote toggle
Icon=moos-pc-remote
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;fast;speed;stream;موس;سريع;
# Fast Remote is not a standalone icon: it is a switch inside Mo PC Remote.
# NoDisplay keeps this toggle entry out of the menu and dock. It used to
# promise a Meta+R global shortcut through X-KDE-GlobalAccel, a key kglobalaccel
# never reads (measured: no such component registered), and Meta+R is Spectacle's
# stock "record region" binding, so the key is gone.
NoDisplay=true
