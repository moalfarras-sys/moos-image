[Desktop Entry]
Type=Application
Name=Mo PC Remote
Name[ar]=تحكم Mo PC عن بعد
Comment=Control MoOS securely from your phone
Comment[ar]=تحكم بنظام MoOS بأمان من هاتفك
Exec=/usr/bin/mo-pc-remote
Icon=moos-pc-remote
# The window and this file must agree, or the dock draws the app TWICE.
#
# Plasma matches a running window to its launcher by app_id. Mo PC Remote is a GTK application
# whose GApplication id is org.moos.MoPCRemote, so that is the Wayland app_id it hands KWin — and
# this file is called org.moos.remote.desktop. The two never matched, so the task manager saw a
# pinned launcher called org.moos.remote AND an unrelated window called org.moos.MoPCRemote, and
# it drew both: the app open, with two different icons, side by side. Reported on the maintainer's
# machine 2026-07-15.
#
# StartupWMClass is the declaration that they are the same program. Renaming the file to match
# the app id would work too, and would break every dock, favourite and pin that already points at
# org.moos.remote.desktop — including the ones in MoOS's own layout.
StartupWMClass=org.moos.MoPCRemote
Terminal=false
Categories=Network;RemoteAccess;
StartupNotify=true

# Fast Remote lives here now, not as a second dock icon. Right-clicking the Mo PC
# Remote launcher (in the dock or the menu) offers to speed the connection up or
# restore the full experience — both call the ONE /usr/bin/moos-fast-remote, the
# same script the toggle inside the panel and the Meta+R shortcut use. One feature,
# one code path, reachable three convenient ways.
Actions=FastOn;FastOff;

[Desktop Action FastOn]
Name=Speed up the connection (Fast Remote)
Name[ar]=تسريع الاتصال (الوضع السريع)
Exec=/usr/bin/moos-fast-remote on
Icon=moos-pc-remote

[Desktop Action FastOff]
Name=Restore full quality
Name[ar]=استعادة الجودة الكاملة
Exec=/usr/bin/moos-fast-remote off
Icon=moos-pc-remote
