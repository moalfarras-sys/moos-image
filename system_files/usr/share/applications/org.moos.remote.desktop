[Desktop Entry]
Type=Application
Name=Mo PC Remote
Name[ar]=تحكم Mo PC عن بعد
Comment=Control MoOS securely from your phone
Comment[ar]=تحكم بنظام MoOS بأمان من هاتفك
TryExec=mo-pc-remote
Exec=mo-pc-remote
Icon=moos-pc-remote
# The dock pin opens the Mo PC Remote app itself, whose window app id is
# org.moos.remote: pin and window are one dock icon. Its switches (on, off, restart,
# Fast Remote) live in System Settings → MoOS → Mo PC Remote; the menu keeps one
# entry for all of it there, so this one stays hidden.
StartupWMClass=org.moos.remote
Terminal=false
Categories=Network;RemoteAccess;
StartupNotify=true
NoDisplay=true

# Right-clicking the pin offers Fast Remote on and off. Both run the ONE
# /usr/bin/moos-fast-remote that the Fast Remote switch in System Settings and the
# app's own switch use: one feature, one code path.
Actions=FastOn;FastOff;

[Desktop Action FastOn]
Name=Speed up the connection (Fast Remote)
Name[ar]=تسريع الاتصال (الوضع السريع)
Exec=/usr/bin/moos-fast-remote on
Icon=moos-pc-remote

[Desktop Action FastOff]
Name=Restore full quality
Name[ar]=استعادة الجودة الكاملة
Exec=/usr/bin/moos-fast-remote off
Icon=moos-pc-remote
