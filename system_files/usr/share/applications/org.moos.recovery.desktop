[Desktop Entry]
Type=Application
Name=MoOS Recovery
Name[ar]=استعادة MoOS
GenericName=Rollback & recovery
GenericName[ar]=الرجوع والاستعادة
Comment=Roll back to a previous version or pin a known-good one — /home is untouched
Comment[ar]=ارجع إلى نسخة سابقة أو ثبّت نسخة سليمة — مجلد /home يبقى كما هو
TryExec=moos-settings
Exec=moos-settings --section=recovery
Icon=moos-recovery
StartupWMClass=org.kde.systemsettings
Terminal=false
Categories=System;
NoDisplay=true
Keywords=rollback;recovery;pin;bootc;ostree;
Keywords[ar]=رجوع;استعادة;تثبيت;
