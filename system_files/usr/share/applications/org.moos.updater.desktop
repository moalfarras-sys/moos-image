Exec=moos-settings --section=update
Icon=moos-updater
StartupWMClass=org.moos.settings
Terminal=false
Categories=System;
NoDisplay=true
Keywords=update;upgrade;bootc;ostree;uupd;
Keywords[ar]=تحديث;ترقية;
