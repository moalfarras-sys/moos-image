[Desktop Entry]
Type=Application
Name=Mo AI
Name[ar]=مساعد Mo AI
GenericName=AI Assistant & Device Centre
GenericName[ar]=المساعد الذكي ومركز الجهاز
Comment=Fix drivers, update MoOS, install any app, and control this PC — with a local or cloud AI
Comment[ar]=أصلح التعريفات، حدّث MoOS، ثبّت أي تطبيق، وتحكّم بجهازك — بذكاء محلي أو سحابي
Exec=moai
TryExec=moai
Icon=moos-moai
Terminal=false
# Ties the running window to this launcher so the dock shows ONE Mo AI icon, not a
# pinned icon plus a second entry. moai sets this Wayland app_id via moos-qml-shell;
# this is the XWayland/fallback safety net (must equal that id).
StartupWMClass=org.moos.moai
Categories=Utility;System;
Keywords=AI;assistant;chat;local;llm;drivers;hardware;update;install;apps;remote;compatibility;
Keywords[ar]=ذكاء;مساعد;محادثة;محلي;تعريفات;أجهزة;تحديث;تثبيت;تطبيقات;توافق;
Actions=Device;Apps;Remote;StartBrain;

[Desktop Action Device]
Name=My device
Name[ar]=جهازي
Exec=moai --panel device

[Desktop Action Apps]
Name=Install apps
Name[ar]=تثبيت التطبيقات
Exec=moai --panel apps

# NOT "Mo PC Remote": there must be exactly one launcher by that name
# (org.moos.remote.desktop), and verify_user_experience.py enforces it. This is a
# shortcut into Mo AI's Remote panel, not a second launcher for the app.
[Desktop Action Remote]
Name=Remote control
Name[ar]=التحكّم عن بعد
Exec=moai --panel remote

[Desktop Action StartBrain]
Name=Start local brain
Name[ar]=تشغيل العقل المحلي
Exec=konsole -e moai-start
