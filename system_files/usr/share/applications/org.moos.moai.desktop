[Desktop Entry]
Type=Application
Name=Mo AI
Name[ar]=مساعد Mo AI
GenericName=AI Assistant & Device Centre
GenericName[ar]=المساعد الذكي ومركز الجهاز
Comment=Fix drivers, update MoOS, install apps, and control this PC — with free cloud AI by default
Comment[ar]=أصلح التعريفات، حدّث MoOS، ثبّت التطبيقات، وتحكّم بجهازك — بذكاء سحابي مجاني افتراضياً
Exec=moai
TryExec=moai
Icon=moos-moai
Terminal=false
# Global shortcut, read by kglobalaccel through /usr/share/kglobalaccel (rebindable
# in System Settings); tests/test_moos_shortcuts.py keeps it off stock bindings.
X-KDE-Shortcuts=Meta+Space
# Ties the running window to this launcher so the dock shows ONE Mo AI icon, not a
# pinned icon plus a second entry. moai sets this Wayland app_id via moos-qml-shell;
# this is the XWayland/fallback safety net (must equal that id).
StartupWMClass=org.moos.moai
Categories=Utility;
Keywords=AI;assistant;chat;cloud;llm;drivers;hardware;update;install;apps;remote;compatibility;
Keywords[ar]=ذكاء;مساعد;محادثة;سحابي;تعريفات;أجهزة;تحديث;تثبيت;تطبيقات;توافق;
Actions=Device;Apps;Remote;

[Desktop Action Device]
Name=My device
Name[ar]=جهازي
Exec=moai --panel device

[Desktop Action Apps]
Name=Install apps
Name[ar]=تثبيت التطبيقات
Exec=moai --panel apps

# NOT "Mo PC Remote": there must be exactly one launcher by that name
# (org.moos.remote.desktop), and verify_user_experience.py enforces it. This is a
# shortcut into Mo AI's Remote panel, not a second launcher for the app.
[Desktop Action Remote]
Name=Remote control
Name[ar]=التحكّم عن بعد
Exec=moai --panel remote
