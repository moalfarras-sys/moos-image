[Desktop Entry]
Type=Application
Name=Mira
Name[ar]=ميرا
GenericName=MoOS assistant & device centre
GenericName[ar]=مساعد MoOS الذكي ومركز الجهاز
Comment=Talk to Mira: fix drivers, update MoOS, install apps and control this PC — with free cloud AI by default, and every system change waits for your approval
Comment[ar]=تحدّث مع ميرا: تصلح التعريفات، تحدّث MoOS، تثبّت التطبيقات وتتحكّم بجهازك — بذكاء سحابي مجاني افتراضياً، وكل تغيير في النظام ينتظر موافقتك
# `moai` opens Mira when the image carries her (see /usr/bin/moai), so every older caller of the
# Mo AI launcher reaches the same assistant this entry names.
Exec=moai
TryExec=moai
Icon=moos-moai
Terminal=false
# Global shortcut, read by kglobalaccel through /usr/share/kglobalaccel (rebindable
# in System Settings); tests/test_moos_shortcuts.py keeps it off stock bindings.
X-KDE-Shortcuts=Meta+Space
# Ties the running window to this launcher so the dock shows ONE Mo AI icon, not a
# pinned icon plus a second entry. moai sets this Wayland app_id via moos-qml-shell;
# this is the XWayland/fallback safety net (must equal that id).
StartupWMClass=org.moos.moai
Categories=Utility;
Keywords=AI;assistant;Mira;Mo AI;voice;chat;cloud;drivers;hardware;update;install;apps;remote;compatibility;
Keywords[ar]=ميرا;ذكاء;مساعد;صوت;محادثة;سحابي;تعريفات;أجهزة;تحديث;تثبيت;تطبيقات;توافق;
Actions=Device;Settings;Apps;Remote;

# The assistant's own check of this computer: the verdict, the daily check and the fixed repairs.
[Desktop Action Device]
Name=Check this device
Name[ar]=افحص هذا الجهاز
Exec=moai --panel device

# The brain, the key, the phone channels and the permissions: the assistant page of System Settings.
[Desktop Action Settings]
Name=Mira settings
Name[ar]=إعدادات ميرا
Exec=moos-settings --section=assistant

# Apps are Mo Store's: the one store. Mo AI still installs and removes one when asked in chat.
[Desktop Action Apps]
Name=Install apps
Name[ar]=تثبيت التطبيقات
Exec=moos-store

# NOT "Mo PC Remote": there must be exactly one launcher by that name
# (org.moos.remote.desktop), and verify_user_experience.py enforces it. This opens
# Mo PC Remote's switches in System Settings, not a second launcher for the app.
[Desktop Action Remote]
Name=Remote control
Name[ar]=التحكّم عن بعد
Exec=moos-settings --section=remote
