[Desktop Entry]
Type=Application
Name=Mo Store
Name[ar]=متجر MoOS
GenericName=App Store
GenericName[ar]=متجر التطبيقات
Comment=Pick your apps — one tap, no terminal
Comment[ar]=اختر تطبيقاتك — وثبّتها بنقرة، بلا طرفية
Exec=moos-store %U
TryExec=moos-store
Icon=moos-store
Terminal=false
# Ties the running window to this launcher so the dock shows ONE Store icon, not a
# pinned icon plus a second entry. moos-store sets this Wayland app_id via
# moos-qml-shell; this is the XWayland/fallback safety net (must equal that id).
StartupWMClass=org.moos.store
Categories=System;
# Plasma's "Uninstall or Manage Add-ons…" action and appstream:// links open the app's page
# here, not in a second store (see /etc/xdg/mimeapps.list).
MimeType=x-scheme-handler/appstream;
Keywords=store;apps;install;moos;shop;
Keywords[ar]=متجر;تطبيقات;تثبيت;
# The pinned dock icon's right-click list: straight to updates or to everything installed.
Actions=updates;library;

[Desktop Action updates]
Name=Updates
Name[ar]=التحديثات
Exec=moos-store --page=updates

[Desktop Action library]
Name=My apps
Name[ar]=تطبيقاتي
Exec=moos-store --page=library
