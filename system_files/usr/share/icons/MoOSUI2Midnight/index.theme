[Icon Theme]
Name=MoOS UI · Midnight Symbols
Comment=Palette-matched MoOS Tidal Cut interface symbols
Inherits=MoOSUI2
# Normal QIcon rendering can receive the application's QPalette rather than
# the Plasma surface's Kirigami color set. That produced dark symbols on the
# live dark Launcher. Owned QML controls use explicit masks for live accent
# states; this overlay keeps its WCAG-checked palette fallback deterministic.
FollowsColorScheme=false
Directories=moos/actions/scalable

[moos/actions/scalable]
Size=24
Context=Actions
Type=Scalable
MinSize=16
MaxSize=512
