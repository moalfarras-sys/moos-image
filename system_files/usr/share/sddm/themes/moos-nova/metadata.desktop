[SddmGreeterTheme]
Name=MoOS Nova
Type=sddm-theme
Description=Premium Nova login screen for MoOS — dark navy, electric-blue accents, virtual keyboard with Arabic input. Based on SilentSDDM.
License=GPL-3.0-or-later
Version=1.5.0-moos.1
Theme-Id=moos-nova
Theme-API=2.0
MainScript=Main.qml
Screenshot=backgrounds/nova-dark.png
TranslationsDirectory=translations
QtVersion=6

ConfigFile=configs/moos-nova.conf
