# CHANGELOG 2026-07-09: audited key-by-key against plymouth 24.004.60
# (themes/spinner/spinner.plymouth.desktop + src/plugins/splash/two-step/plugin.c).
# All keys/sections confirmed valid for this generation; watermark.png and
# throbber-NNNN.png are picked up implicitly by filename (no keys needed).
# Added UseEndAnimation=false to updates/upgrade/reset modes: we ship no
# animation-*.png, so the plugin's compat path would otherwise consume
# throbber-*.png as the end animation and free the spinner (plugin.c:346-353).
[Plymouth Theme]
Name=MoOS Nova
Description=MoOS branded flicker-free boot splash: Nova comet spinner on deep navy with the MoOS emblem watermark.
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 30
ImageDir=/usr/share/plymouth/themes/moos-nova
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.96
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x050A14
BackgroundEndColor=0x050A14
ProgressBarBackgroundColor=0x111A2E
ProgressBarForegroundColor=0x2E7BFF
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
UseEndAnimation=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
UseEndAnimation=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading MoOS...
SubTitle=Do not turn off your computer

[firmware-upgrade]
UseEndAnimation=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
UseEndAnimation=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
