// MoOS UI — Graphite Horizon. A single approved rendered mark, not a movie.
// No minimum display time, fake percentage, perpetual orbit or full-screen blur.
// Decode one hero; scale it once. The short opacity entrance finishes in 360 ms;
// shutdown and quit immediately present the resting composition.
Window.SetBackgroundTopColor(0.078, 0.098, 0.110);      // #14191C UI2 canvas
Window.SetBackgroundBottomColor(0.078, 0.098, 0.110);   // #14191C — flat, no seam

sw = Window.GetWidth(0);
sh = Window.GetHeight(0);
cx = sw / 2;
cy = sh / 2;

PI = 3.14159265;

fun fmin(a, b) { if (a < b) return a; return b; }
fun fmax(a, b) { if (a > b) return a; return b; }
fun clamp01(v) { return fmax(0, fmin(1, v)); }

// Cover the screen without stretching. Scaling happens once during theme
// setup, never in refresh(), and the 1080p source keeps initramfs decode cost
// bounded while retaining the reviewed 4K wallpaper's composition.
BACKDROP_W = 1920;
BACKDROP_H = 1080;
backdrop_scale = fmax(sw / BACKDROP_W, sh / BACKDROP_H);
backdrop_w = BACKDROP_W * backdrop_scale;
backdrop_h = BACKDROP_H * backdrop_scale;
backdrop_sprite = Sprite(Image("boot-backdrop.png").Scale(backdrop_w, backdrop_h));
backdrop_sprite.SetX(cx - backdrop_w / 2);
backdrop_sprite.SetY(cy - backdrop_h / 2);
backdrop_sprite.SetZ(0);


INTRO_COUNT = 1;
INTRO_ASPECT = 1.5396;
stage_w = fmin(sw * 0.70, sh * 0.62 * INTRO_ASPECT);
stage_h = stage_w / INTRO_ASPECT;
stage_x = cx - stage_w / 2;
stage_y = cy - stage_h / 2;
OVERLAY_MAX_W = sw * 0.78;
frames[1] = Image("intro1.png");
hero = frames[INTRO_COUNT].Scale(stage_w, stage_h);
intro_sprite = Sprite(hero);
intro_sprite.SetX(stage_x);
intro_sprite.SetY(stage_y);
intro_sprite.SetZ(5);
intro_sprite.SetOpacity(1);

// Only a finite entrance. Pre-login has no desktop Reduced Motion preference;
// use a still composition after nine ticks and during password entry/quit.
tick = 0;
finished = 0;
mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot") { finished = 1; }
if (finished == 0) { intro_sprite.SetOpacity(0.70); }
Plymouth.SetRefreshRate(25);
fun refresh() {
    if (finished == 0) {
        tick++;
        intro_sprite.SetOpacity(0.70 + 0.30 * clamp01(tick / 9.0));
        if (tick >= 9) {
            finished = 1;
            Plymouth.SetRefreshRate(1);
        }
    }
}
Plymouth.SetRefreshFunction(refresh);
fun quit_callback() {
    finished = 1;
    intro_sprite.SetImage(hero);
    intro_sprite.SetOpacity(1);
    Plymouth.SetRefreshRate(1);
}
Plymouth.SetQuitFunction(quit_callback);

// Event-driven status and encrypted-volume prompts. Never delay handoff.
message_sprite = Sprite();
message_sprite.SetZ(20);
fun message_callback(text) {
    img = Image.Text(text, 0.612, 0.686, 0.675);   // muted #9CAFAC
    if (img.GetWidth() > OVERLAY_MAX_W) {
        img = img.Scale(OVERLAY_MAX_W, img.GetHeight() * OVERLAY_MAX_W / img.GetWidth());
    }
    message_sprite.SetImage(img);
    message_sprite.SetX(cx - img.GetWidth() / 2);
    message_sprite.SetY(sh * 0.90);
    message_sprite.SetOpacity(1);
}
fun hide_message() { message_sprite.SetOpacity(0); }
Plymouth.SetMessageFunction(message_callback);

// ── LUKS / login passphrase prompt (only appears on encrypted systems) ───────
prompt_sprite = Sprite();
prompt_sprite.SetZ(20);
bullets_sprite = Sprite();
bullets_sprite.SetZ(20);
fun display_password(prompt, bullets) {
    quit_callback();
    hide_message();
    pimg = Image.Text(prompt, 0.910, 0.945, 0.937);   // text #E8F1EF
    if (pimg.GetWidth() > OVERLAY_MAX_W) {
        pimg = pimg.Scale(OVERLAY_MAX_W, pimg.GetHeight() * OVERLAY_MAX_W / pimg.GetWidth());
    }
    prompt_sprite.SetImage(pimg);
    prompt_sprite.SetX(cx - pimg.GetWidth() / 2);
    prompt_sprite.SetY(sh * 0.80);
    prompt_sprite.SetOpacity(1);
    dots = "";
    n = 0;
    while (n < bullets) { dots = dots + "*"; n++; }
    if (dots == "") { dots = " "; }
    bimg = Image.Text(dots, 0.306, 0.843, 0.784);   // primary #4ED7C8
    if (bimg.GetWidth() > OVERLAY_MAX_W) {
        bimg = bimg.Scale(OVERLAY_MAX_W, bimg.GetHeight() * OVERLAY_MAX_W / bimg.GetWidth());
    }
    bullets_sprite.SetImage(bimg);
    bullets_sprite.SetX(cx - bimg.GetWidth() / 2);
    bullets_sprite.SetY(sh * 0.85);
    bullets_sprite.SetOpacity(1);
}
fun clear_password() {
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password);

// On a normal display (no prompt/message), clear both overlays — the mark and
// its wordmark are all that should remain.
fun display_normal() {
    hide_message();
    clear_password();
}
Plymouth.SetDisplayNormalFunction(display_normal);
