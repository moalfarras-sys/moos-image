# MoOS system default applications (KConfig/XDG cascade).
#
# Why this file exists: MoOS shipped no image viewer and no image/* default, so
# the association fell to whatever the user installed. A browser's desktop file
# claims image/png, image/jpeg and image/webp — so photos opened in Chrome, in a
# tab, with no zoom, no next/previous, and no way to rotate. Nothing in MoOS was
# contesting the claim.
#
# A user's ~/.config/mimeapps.list OUTRANKS this file, and Plasma writes to that
# file the first time anyone picks "Open With". So this is only half the fix:
# moos-apply-theme pins the same defaults into the user's own config for people
# who already have a browser recorded there. Shipping the default is not the
# same as the user getting it (AGENTS.md).
#
# Viewers installed in build_files/build.sh section (c8): gwenview, haruna.

[Default Applications]
x-scheme-handler/moos=org.moos.urlhandler.desktop

# Double-click a Windows .exe or an Android .apk and it RUNS (moos-run-foreign).
#
# All four types are needed, and none of them is guesswork — this is what the mime database
# on this image actually says (`/usr/share/mime/globs2`, `aliases`, `subclasses`):
#   *.exe wins on x-msdownload (weight 50), of which x-ms-dos-executable — the type Bottles
#   itself claims — is only an ALIAS, while vnd.microsoft.portable-executable is a SUBCLASS
#   that a real PE binary sniffs as and that NOTHING on the image handled: that .exe opened
#   in a text editor.
# The .apk type already had a handler (waydroid.app.install.desktop) and it is worse than
# nothing: it shells out to `waydroid app install` with no window, so on a machine where
# Android was never initialised the double-click silently does nothing at all. Ours explains,
# offers the one-time setup, starts the container, and shows the install in a real terminal.
application/x-msdownload=org.moos.runforeign.desktop
application/x-ms-dos-executable=org.moos.runforeign.desktop
application/vnd.microsoft.portable-executable=org.moos.runforeign.desktop
application/x-msi=org.moos.runforeign.desktop
application/vnd.android.package-archive=org.moos.runforeign.desktop

image/png=org.kde.gwenview.desktop
image/jpeg=org.kde.gwenview.desktop
image/gif=org.kde.gwenview.desktop
image/webp=org.kde.gwenview.desktop
image/tiff=org.kde.gwenview.desktop
image/bmp=org.kde.gwenview.desktop
image/svg+xml=org.kde.gwenview.desktop
image/avif=org.kde.gwenview.desktop
image/heif=org.kde.gwenview.desktop
image/jxl=org.kde.gwenview.desktop
image/x-icon=org.kde.gwenview.desktop

video/mp4=org.kde.haruna.desktop
video/x-matroska=org.kde.haruna.desktop
video/webm=org.kde.haruna.desktop
video/quicktime=org.kde.haruna.desktop
video/x-msvideo=org.kde.haruna.desktop
video/mpeg=org.kde.haruna.desktop
video/x-flv=org.kde.haruna.desktop
video/3gpp=org.kde.haruna.desktop
audio/mpeg=org.kde.haruna.desktop
audio/flac=org.kde.haruna.desktop
audio/x-wav=org.kde.haruna.desktop
