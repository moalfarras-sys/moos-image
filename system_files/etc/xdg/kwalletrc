# MoOS does not start KWallet or advertise it as a Secret portal. It previously
# did both to support MoPlayer and Mo AI, which made a password prompt appear at
# login even though the owner had never enabled a wallet. Those first-party apps
# now use private app-owned XDG storage with non-fatal startup.
#
# KDE libraries remain installed because core Plasma components link them; this
# default keeps both native providers off without removing those dependencies.
# User Settings can explicitly enable both; PAM integration stays masked.
[Wallet]
Enabled=false
First Use=false

[KSecretD]
Enabled=false

[org.freedesktop.secrets]
apiEnabled=false
