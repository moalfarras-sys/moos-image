# MoOS — system-wide input defaults.
# KConfig cascade: /etc/xdg/kcminputrc is the lowest-priority layer; a user's
# ~/.config/kcminputrc always overrides it (same pattern as the kwinrc and
# kscreenlockerrc files next to this one).
# MoOS = Bibata-Modern-Ice (ful1e5, GPL-3.0) rebranded at image build time
# in build_files/build.sh section (c6).
[Keyboard]
# KWin's startup enum is 0=on, 1=off, 2=leave unchanged. This is deliberately
# a STARTUP preference, not a key-forcing service: both Plasma Login Manager's
# KWin and the user's session start with the numeric keypad active, while the
# physical Num Lock key remains free to turn it off or on at any time.
NumLock=0

[Mouse]
cursorTheme=MoOS

# Mo PC Remote's fallback pointer: ydotoold's uinput device (vendor 0x2333, product 0x6666).
# Remote uses it only while KDE's RemoteDesktop grant is missing, e.g. while its approval dialog
# is waiting. uinput moves are relative, so the agent tracks the cursor by adding its own deltas,
# and that only works 1:1. KWin gave this device the adaptive profile: measured on the station on
# 2026-10-01, one 40-unit event moved the cursor 20 px and the 40-unit move back moved it 38, so
# the phone's cursor and the desktop's drifted apart ("two arrows") exactly when the owner had to
# click the approval. Flat at speed 0 measured 40 -> 40 px and 300 -> 300 px, back to the start.
[Libinput][9011][26214][ydotoold virtual device]
PointerAccelerationProfile=1
PointerAcceleration=0
