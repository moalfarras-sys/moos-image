# MoOS system defaults for the KDE lock screen (KConfig cascade — a user's
# ~/.config/kscreenlockerrc always wins over this file).
#
# Why here and not in org.moos.nova contents/defaults: Plasma 6's
# LookAndFeelManager only writes kscreenlockerrc [Greeter] Theme= when an
# L&F package is applied; nested wallpaper groups inside a look-and-feel
# defaults file are not supported/applied.
#
# The nested-group header below is standard KConfig syntax — identical to
# what this command produces:
#   kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
#     --group org.kde.image --group General --key Image <value>
#
# Image points at the NovaHorizon wallpaper *package* directory: the
# org.kde.image plugin normalizes schemeless absolute paths via
# QUrl::fromUserInput, detects the directory as a kpackage, and automatically
# prefers contents/images_dark/ under dark color schemes (NovaDark).

[Greeter]
WallpaperPlugin=org.kde.image

[Greeter][Wallpaper][org.kde.image][General]
Image=/usr/share/wallpapers/NovaHorizon
