# MoOS system defaults for the KDE lock screen (KConfig cascade — a user's
# ~/.config/kscreenlockerrc always wins over this file).
#
# Why here and not in org.moos.ui2 contents/defaults: Plasma 6's
# LookAndFeelManager only writes kscreenlockerrc [Greeter] Theme= when an
# L&F package is applied; nested wallpaper groups inside a look-and-feel
# defaults file are not supported/applied.
#
# The nested-group header below is standard KConfig syntax — identical to
# what this command produces:
#   kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
#     --group org.kde.image --group General --key Image <value>
#
# Image points at the MoOSUI2Graphite wallpaper *package* directory: the
# org.kde.image plugin normalizes schemeless absolute paths via
# QUrl::fromUserInput, detects the directory as a kpackage, and automatically
# prefers contents/images_dark/ under dark color schemes (MoOSUI2Dark).

[Greeter]
# Theme names the look-and-feel package whose contents/lockscreen/LockScreen.qml
# the greeter draws. Without it, kscreenlocker falls back to the plasma-desktop
# shell's default lockscreen (Breeze clock, field and typography) — which is
# exactly why the lock screen used to look un-MoOS even with the right wallpaper.
# org.moos.ui2 ships a premium MoOS lockscreen; moos-theme rewrites this per
# variant (…ui2 / …ui2.light) on a dark/light switch. A package without a
# lockscreen (UI1 rollback) falls back to the shell default, safely.
Theme=org.moos.ui2
WallpaperPlugin=org.kde.image

[Greeter][Wallpaper][org.kde.image][General]
Image=/usr/share/wallpapers/MoOSUI2Graphite
