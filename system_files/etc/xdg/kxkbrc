# MoOS default keyboard layouts — bilingual out of the box.
#
# US (English) + Arabic, toggled with Alt+Shift (the switch every user already has
# in their fingers). This matches what the MoOS installer actually plants on every
# install (xkbForLang() -> "us,ara" / "us", localeForLang() -> en_US.UTF-8 /
# ar_SA.UTF-8): the system speaks English/Arabic, so its keyboard must too.
#
# This used to be de,ara (German + Arabic). That was wrong for a MoOS user: it put a
# German physical layout under an English/Arabic system — every 'z'/'y' swapped and
# every umlaut in the wrong place — and it did it silently, because a layout mismatch
# produces wrong characters, never an error. It also contradicted the installer,
# which never offers or plants German. That contradiction is gone now.
#
# System default via the KConfig cascade (/etc/xdg). A user's own ~/.config/kxkbrc
# still outranks this, so System Settings > Keyboard keeps working as the last word.
[Layout]
Use=true
LayoutList=us,ara
VariantList=,
DisplayNames=US,ع
Options=grp:alt_shift_toggle
SwitchMode=Global
ResetOldOptions=true
