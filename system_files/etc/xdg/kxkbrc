# Arabic first, German second; Alt+Shift switches between them.
# Keyboard layout is independent of the interface language. User settings win
# over these image defaults; migration updates only known stock legacy shadows.
[Layout]
Use=true
LayoutList=ara,de
VariantList=,
DisplayNames=ع,DE
Options=grp:alt_shift_toggle
SwitchMode=Global
ResetOldOptions=true
