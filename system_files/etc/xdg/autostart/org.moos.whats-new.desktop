[Desktop Entry]
Type=Application
Name=What's new in MoOS
Name[ar]=ما الجديد في MoOS
Comment=Says once, after an update, what it brought
Comment[ar]=يخبرك مرة واحدة بعد كل تحديث بما أضافه
Exec=/usr/libexec/moos-whats-new-notify
Icon=moos-logo
Terminal=false
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-StartupNotify=false
X-KDE-autostart-phase=2
