[Desktop Entry]
Type=Application
Name=MoOS Apply UI2 Theme
Name[ar]=تطبيق سمة MoOS UI2
Comment=Applies the complete MoOS UI2 Global Theme on first login (once per user)
Comment[ar]=يطبّق سمة MoOS UI2 المتكاملة عند أول تسجيل دخول
Exec=/usr/bin/moos-apply-theme
Icon=moos-logo
Terminal=false
OnlyShowIn=KDE;
X-KDE-StartupNotify=false
X-KDE-autostart-phase=2
