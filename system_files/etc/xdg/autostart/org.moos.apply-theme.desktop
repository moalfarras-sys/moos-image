[Desktop Entry]
Type=Application
Name=Apply MoOS Theme
Name[ar]=تطبيق سمة MoOS
Comment=Applies the complete MoOS Global Theme after an upgrade
Comment[ar]=يطبّق سمة MoOS المتكاملة بعد الترقية
Exec=/usr/bin/moos-apply-theme
Icon=moos-logo
Terminal=false
OnlyShowIn=KDE;
X-KDE-StartupNotify=false
X-KDE-autostart-phase=2
