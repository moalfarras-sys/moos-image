[Desktop Entry]
Type=Application
Name=MoOS Apply Nova Theme
Name[ar]=تطبيق سمة MoOS Nova
Comment=Applies the MoOS Nova Global Theme on first login (once per user)
Comment[ar]=يطبّق سمة MoOS Nova عند أول تسجيل دخول
Exec=/usr/bin/moos-apply-theme
Icon=moos-logo
Terminal=false
OnlyShowIn=KDE;
X-KDE-StartupNotify=false
X-KDE-autostart-phase=2
