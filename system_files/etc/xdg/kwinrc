# ============================================================================
#  MoOS — "Nova Motion System"  (KWin system defaults)
# ============================================================================
# This is a KConfig cascade default. A user's ~/.config/kwinrc ALWAYS wins over
# this file, so nothing here clobbers a user's own choices.
#
# GOAL: a cohesive, premium, macOS-caliber motion system that stays LIGHT.
# Every effect below is a stock KWin plugin. KWin only loads an effect when the
# active backend passes the effect's supported() check, so on weak GPUs or
# software rendering the GPU-touching effects are simply skipped — no boot or
# compositing risk. Users who want minimal motion can drop
# [Compositing] AnimationDurationFactor toward 0, uncheck "Desktop Effects", or
# toggle individual effects in System Settings; their cascade always wins.
#
# ---------------------------------------------------------------------------
#  HOW KWIN TOGGLES EFFECTS  (verified in kwin master, 2026-07-10)
# ---------------------------------------------------------------------------
# src/effect/effecthandler.cpp EffectsHandler::configChanged() reads keys from
# the [Plugins] group, strips the "Enabled" suffix, and treats the remainder as
# the plugin id: key "<id>Enabled" -> findEffect("<id>"). It also UNLOADS
# effects before loading, "to ensure that switching between mutually exclusive
# effects works as expected" — so exclusive-group siblings never double up.
#
#  EXCLUSIVE SLOTS (only one member of each group ever runs). Verified via each
#  plugin's metadata "X-KWin-Exclusive-Category" / "exclusiveGroup":
#    minimize                       : squash(default on) vs magiclamp(default off)
#    toplevel-open-close-animation  : scale(default on) vs glide/fade(default off)
#    desktop-animations             : slide(default on) vs fadedesktop(default off)
#  MoOS keeps EXACTLY ONE per slot enabled (magiclamp / scale / slide), so there
#  is never a conflicting double animation.
#
# ---------------------------------------------------------------------------
#  THE SYSTEM, EFFECT BY EFFECT  (id | source | GPU cost | what it does)
# ---------------------------------------------------------------------------
#  blur          | plugins/blur/metadata.json (C++)         | MODERATE | the one
#                  frosted-glass pass behind panels/menus. Tuned calm below.
#  magiclamp     | plugins/magiclamp/metadata.json (C++)    | LIGHT    | genie
#                  minimize toward the task manager — the signature premium move.
#                  Replaces squash (both are the "minimize" slot).
#  scale         | plugins/scale/package/metadata.json (JS) | LIGHT    | gentle
#                  scale+fade on window open/close. The one open/close animation.
#  slide         | plugins/slide/metadata.json (C++)        | LIGHT    | smooth
#                  virtual-desktop switch.
#  slidingpopups | plugins/slidingpopups/metadata.json (C++)| LIGHT    | menus /
#                  tooltips / notifications slide in from their screen edge.
#  fadingpopups  | plugins/fadingpopups/package (JS)        | LIGHT    | fades the
#                  popups slidingpopups doesn't slide (combo boxes, etc.).
#                  Complementary — different targets, so both stay on.
#  dimscreen     | plugins/dimscreen/package (JS)           | LIGHT    | on a
#                  polkit/kdesu/pinentry auth prompt, smoothly dims + desaturates
#                  everything EXCEPT the auth window (brightness/saturation 0.67,
#                  250ms). The macOS-style "spotlight the password box" moment.
#  dialogparent  | plugins/dialogparent/package (JS)        | LIGHT    | darkens a
#                  parent window while its modal child dialog is open. Subtle
#                  focus cue. Different trigger from dimscreen, so both coexist.
#  fullscreen    | plugins/fullscreen/package (JS)          | LIGHT    | soft scale
#                  as a window enters/leaves full screen.
#  startupfeedback| plugins/startupfeedback (C++)           | LIGHT    | busy-cursor
#                  launch feedback — "the click registered" responsiveness.
#  overview      | plugins/overview (C++/QML)               | ON-DEMAND| macOS
#                  Mission-Control: desktops + windows grid. Stock shortcut Meta+W.
#                  Costs nothing until invoked. No hot corner set (user choice).
#  windowview    | plugins/windowview (C++/QML)             | ON-DEMAND| the
#                  Present-Windows-style "expose all windows" grid (stock, default
#                  on). Left at upstream default; noted here for completeness.
#
#  DELIBERATELY OFF (cheap-looking or heavy — do not enable):
#    translucency (per-window live blending, expensive), glide/fade (would fight
#    scale), squash/fadedesktop (exclusive-slot losers), wobbly/cube/fall-apart.
# ============================================================================

[Plugins]
# --- Frosted glass ---------------------------------------------------------
# blur: id "blur", default-on (plugins/blur/metadata.json EnabledByDefault=true).
blurEnabled=true

# --- Minimize slot (exactly one) ------------------------------------------
# magiclamp is default-OFF upstream (metadata EnabledByDefault=false); MoOS opts
# in for the premium genie minimize and turns squash (the default) off so the
# "minimize" exclusive slot holds exactly one animation.
magiclampEnabled=true
squashEnabled=false

# --- Open/close slot (exactly one) ----------------------------------------
# scale is already the upstream default open/close (EnabledByDefault=true) and is
# a scripted (GPU-light) effect. Listed to document intent and survive a future
# upstream default flip. glide + fade share scale's exclusive group and are left
# OFF (both EnabledByDefault=false) so there is no competing open/close animation.
scaleEnabled=true

# --- Desktop switch slot (exactly one) ------------------------------------
slideEnabled=true

# --- Popups / menus (complementary, both default-on) ----------------------
slidingpopupsEnabled=true
fadingpopupsEnabled=true

# --- Focus / auth polish (scripted, GPU-light, both default-on) -----------
# dimscreen: spotlight-the-auth-prompt dim. dialogparent: dim parent behind a
# modal dialog. Both default-on upstream; pinned here so MoOS's premium auth/
# modal feel is explicit and stays on if an upstream default ever flips.
dimscreenEnabled=true
dialogparentEnabled=true

# --- Responsiveness feedback (light, default-on) --------------------------
fullscreenEnabled=true
startupfeedbackEnabled=true

# --- Mission-Control (on-demand, default-on; NO hot corner set) -----------
overviewEnabled=true

# --- Heavy / conflicting effects pinned OFF -------------------------------
# translucency has NO EnabledByDefault key -> off by default; pinned off because
# live per-window blending is expensive and un-macOS. (Verified
# plugins/translucency/package/metadata.json.)
translucencyEnabled=false

[Effect-blur]
# Keys verified against plugins/blur/blur.kcfg (group "Effect-blur"):
#   BlurStrength (Int, upstream default 15)
#   NoiseStrength (Int, upstream default 5)
#   Saturation    (Int, upstream default 150)  <- left at default; not set here.
# Nova uses a gentler blur so glass over the navy palette reads calm, not muddy;
# a touch of noise suppresses banding on large blurred fills. Saturation stays at
# the upstream 150 (keeps colors crisp behind glass rather than washing to grey).
# Note: there is NO separate background-contrast plugin in kwin master — blur's
# own Saturation is the only "contrast"-style control, hence nothing more to set.
BlurStrength=8
NoiseStrength=2

[Compositing]
# Nova timing: a hair snappier than stock (1.0) without feeling rushed. macOS
# window motion is quick (~200-250ms); this shortens KWin's base durations
# uniformly. 0.75 is the shipped value (well-tested/safe). 0.70 is a slightly
# snappier alternative worth trying on-device — both are low-risk (they only
# scale duration, never geometry). Read from [Compositing] AnimationDurationFactor
# by Options::animationTimeFactor(). Users override in System Settings > General
# Behavior (their value wins).
AnimationDurationFactor=0.75

# --- Window decoration: macOS-style traffic-light buttons on the LEFT ------
# VERIFIED against kwin master (2026-07-10):
#   src/decorations/decorationbridge.cpp — the config GROUP is still
#   "org.kde.kdecoration2" in Plasma 6.7 (the plugin namespace moved to
#   kdecoration3, but s_configKeyName = "org.kde.kdecoration2" is kept for
#   backward compat); default plugin s_defaultPlugin = "org.kde.breeze".
#   src/decorations/settings.cpp:140 — ButtonsOnLeft / ButtonsOnRight are read
#   from that same "org.kde.kdecoration2" group.
#   src/kcms/decoration/utils.cpp + settings.cpp — single-letter button codes:
#     X=Close  I=Minimize  A=Maximize  M=Menu  N=ApplicationMenu
#     S=OnAllDesktops  H=ContextHelp  F=KeepAbove  B=KeepBelow  _=Spacer
# Close/min/max at the LEFT, nothing at the right -> XIA / (empty).
# An empty ButtonsOnRight= is read as "no buttons" (readEntry returns the empty
# string when the key is present-but-empty, so the built-in HIAX default does
# NOT apply). Users' ~/.config/kwinrc still overrides this system default.
#
# ---------------------------------------------------------------------------
#  DECORATION: MoOS UI2 (Aurorae), not Breeze
# ---------------------------------------------------------------------------
# This used to be library=org.kde.breeze, so MoOS windows were Breeze windows
# with a Nova palette poured over them and Breeze's X / v / ^ glyphs in the title
# bar — one of the loudest "this is just KDE" tells left on the desktop.
#
# MoOS UI2 derives its proven Aurorae geometry from UI1 through the isolated
# artwork/generate_moos_ui2.py generator and ships at
# /usr/share/aurorae/themes/MoOSUI2: graphite glass title bar, 12px rounded
# corners, centred title, soft drop shadow, and circular window controls painted
# in Nova's OWN semantic colours (NovaDark negative/neutral/positive), so the
# familiar red/amber/green idiom stays MoOS rather than a 1:1 copy of anyone's
# branding.
#
# Aurorae is the right engine here and costs the image nothing: the plugin is
# already installed (aurorae-6.7.2, org.kde.kwin.aurorae.so) and Fedora 44
# packages no richer C++ decoration (klassy / lightly / sierrabreeze are all
# absent from the repos), so the alternative would have been putting a compiler
# on the build path for a cosmetic gain.
#
# The theme name must be spelled `__aurorae__svg__<ThemeDirName>` — that prefix
# is how KWin routes the decoration to the Aurorae SVG engine.
#
# Corners and shadows were both VERIFIED on this hardware, not assumed: KWin
# clips the client to the decoration shape, so all four corners round (checked by
# screenshotting the bottom-left corner against a magenta backdrop), and the drop
# shadow is drawn by the theme itself into its Padding* region — Qt's SVG
# renderer has no feGaussianBlur, so it is built from linear + radial gradients.
# A decoration with no shadow would have looked FLATTER than the Breeze it
# replaces, which is why the shadow is part of the art and not an afterthought.
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MoOSUI2
ButtonsOnLeft=XIA
ButtonsOnRight=
