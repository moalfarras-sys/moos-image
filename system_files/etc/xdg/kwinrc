# MoOS system defaults for KWin (KConfig cascade — a user's ~/.config/kwinrc
# always wins over this file, so user choices are never clobbered).
#
# Nova polish: enable + tune the blur effect for the "calm glass" look.
# Key names verified against kwin master src/plugins/blur/blur.kcfg
# (config group "Effect-blur", Int entries BlurStrength / NoiseStrength);
# effects are toggled via [Plugins] <effectId>Enabled, blur's id is "blur".
#
# Safety: blur is enabled by default upstream anyway, and KWin only loads the
# effect when the backend supports it (effect supported() check) — on weak
# GPUs / software rendering this is simply ignored. No boot/compositing risk.

[Plugins]
blurEnabled=true
# Nova motion set (MOOS_DESIGN_SYSTEM.md §6: expressive but light):
# - magiclamp: signature minimize animation (GPU-cheap deformation, the
#   "premium" touch); replaces the default squash effect.
# - slide: smooth desktop switching.
# All are stock KWin effects — unsupported backends simply skip them.
magiclampEnabled=true
squashEnabled=false
slideEnabled=true
# Smooth window open/close: the "scale" effect (windows gently scale in and out
# when shown/hidden). Id "scale" + Category "Window Open/Close Animation" +
# EnabledByDefault=true VERIFIED against kwin master
# src/plugins/scale/package/metadata.json (2026-07-10). It is a SCRIPTED effect
# (X-Plasma-API=javascript) → GPU-light and degrades on weak HW (KWin skips it on
# unsupported/soft-rendered backends). It is already the modern default open/close
# animation in Plasma 6.7 — the settings UI moved these into a dedicated
# "Animation" category (KDE Discuss #37407), the effect itself still ships. Listed
# explicitly to document intent and keep it on if a future upstream default flips.
# CONFLICT NOTE: "scale" and "glide" are BOTH "Window Open/Close Animation"
# effects — only ONE may run at a time. We keep glide OFF (VERIFIED
# EnabledByDefault=false in src/plugins/glide/metadata.json) so there is no
# double open/close animation. magiclamp above is a MINIMIZE effect, so it pairs
# with scale (open/close) without conflict; squash (the other minimize effect) is
# already off above, so the minimize slot has exactly one animation too.
scaleEnabled=true
# Heavy effects pinned OFF for the light, GPU-friendly Nova feel:
# - translucency: Id "translucency", Category "Appearance", VERIFIED in
#   src/plugins/translucency/package/metadata.json — it has NO EnabledByDefault
#   key, so it is OFF by default; we pin it OFF anyway (per-window live blending
#   is expensive). "dimscreen" deliberately NOT enabled either (it only dims the
#   screen behind modal prompts — not wanted, and off by default).
translucencyEnabled=false
# Premium popup/menu transitions. Effect ids + EnabledByDefault=true VERIFIED
# against kwin master: src/plugins/slidingpopups/metadata.json (id "slidingpopups")
# and src/plugins/fadingpopups/package/metadata.json (id "fadingpopups"). Both
# are stock, default-on effects — listed here to document intent and to keep
# them on even if a future upstream default flips. Unsupported backends skip
# them. Wobbly windows deliberately NOT enabled (too much for a premium feel).
slidingpopupsEnabled=true
fadingpopupsEnabled=true

[Effect-blur]
# Upstream defaults: BlurStrength=15, NoiseStrength=5 (see blur.kcfg).
# Nova uses a gentler blur with just a hint of noise banding suppression.
BlurStrength=8
NoiseStrength=2

[Compositing]
# Nova motion timing: slightly snappier than stock (1.0) without feeling
# rushed — "fast and smooth" per the design system. Users change this in
# System Settings > General Behavior (their value wins over this default).
AnimationDurationFactor=0.75

# --- Window decoration: macOS-style traffic-light buttons on the LEFT ------
# VERIFIED against kwin master (2026-07-10):
#   src/decorations/decorationbridge.cpp — the config GROUP is still
#   "org.kde.kdecoration2" in Plasma 6.7 (the plugin namespace moved to
#   kdecoration3, but s_configKeyName = "org.kde.kdecoration2" is kept for
#   backward compat); default plugin s_defaultPlugin = "org.kde.breeze".
#   src/decorations/settings.cpp:140 — ButtonsOnLeft / ButtonsOnRight are read
#   from that same "org.kde.kdecoration2" group.
#   src/kcms/decoration/utils.cpp + settings.cpp — single-letter button codes:
#     X=Close  I=Minimize  A=Maximize  M=Menu  N=ApplicationMenu
#     S=OnAllDesktops  H=ContextHelp  F=KeepAbove  B=KeepBelow  _=Spacer
# macOS puts close/min/max at the LEFT, nothing at the right → XIA / (empty).
# An empty ButtonsOnRight= is read as "no buttons" (readEntry returns the empty
# string when the key is present-but-empty, so the built-in HIAX default does
# NOT apply). Users' ~/.config/kwinrc still overrides this system default.
#
# Rounded window corners: NO key needed — Plasma 6.5+ rounds Breeze windows by
# default (top corners from the Breeze decoration, bottom corners drawn by KWin
# automatically). Keeping library=org.kde.breeze preserves that premium look;
# window shadows are on by default too.
[org.kde.kdecoration2]
library=org.kde.breeze
ButtonsOnLeft=XIA
ButtonsOnRight=
