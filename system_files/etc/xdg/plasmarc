# MoOS system default Plasma Style (desktoptheme). KConfig cascade — a user's
# ~/.config/plasmarc always wins over this file, so user choices are preserved.
#
# VERIFIED (plasma/libplasma src/plasma/private/theme_p.cpp): Plasma reads the
# active Plasma Style from KSharedConfig "plasmarc", KConfigGroup "Theme", key
# "name" (default "default"). Setting it to "MoOSUI2" makes the Graphite Plasma
# Style the system-wide default, so panels, dialogs, notifications and OSDs use
# the same mineral-glass language instead of stock Breeze.
#
# When the org.moos.ui2.aurora Look-and-Feel package is applied, Plasma's
# LookAndFeelManager writes [Theme] name=<value> from that package's
# contents/defaults into the USER's ~/.config/plasmarc, overriding this system
# default. org.moos.ui2.aurora/contents/defaults carries [plasmarc][Theme]
# name=MoOSUI2Aurora, so both paths agree. This /etc/xdg default still covers
# sessions/greeters where the L&F was never applied.
#
# The header below was commented out by accident on 2026-08-28 (a6527c83): a key before
# any group belongs to no group, so this file set nothing and those sessions drew
# Plasma's default style. tests/test_kconfig_group_headers.py keeps it.
[Theme]
name=MoOSUI2Aurora
