# MoOS system default Plasma Style (desktoptheme). KConfig cascade — a user's
# ~/.config/plasmarc always wins over this file, so user choices are preserved.
#
# VERIFIED (plasma/libplasma src/plasma/private/theme_p.cpp): Plasma reads the
# active Plasma Style from KSharedConfig "plasmarc", KConfigGroup "Theme", key
# "name" (default "default"). Setting it to "Nova" makes the MoOS Nova Plasma
# Style the system-wide default, so panels, dialogs, notification popups and the
# volume/brightness OSD render as Nova navy glass instead of stock Breeze.
#
# IMPORTANT — see NEEDS-CLAUDE-WIRING: when the org.moos.nova Look-and-Feel
# package is applied, Plasma's LookAndFeelManager writes [Theme] name=<value>
# from that package's contents/defaults into the USER's ~/.config/plasmarc,
# which then overrides this system default. org.moos.nova/contents/defaults
# currently carries [plasmarc][Theme] name=default, so it must be changed to
# name=Nova for Nova to actually win after the Global Theme is applied. This
# /etc/xdg default still covers sessions/greeters where the L&F was not applied.
[Theme]
name=Nova
