# MoOS launch feedback — a calm, unmistakable acknowledgement that a click landed.
#
# An earlier revision turned this "up to Windows-like": the icon BOUNCED beside the
# cursor AND a launching-state task button appeared on every launch. Applied as a
# system default (/etc/xdg) it hit EVERY app, not just the browser — so opening the
# terminal or any pinned app flashed a bouncing icon and a second task button, which
# read as "it opened a new window every time I click". That was noise, not polish.
#
# Now: keep the busy cursor (subtle, immediate, universally understood) and drop the
# bounce and the extra task-manager button. The click is acknowledged without the
# surface flashing. A user can still turn feedback up in System Settings → Launch
# Feedback.
[BusyCursorSettings]
Bouncing=false

[FeedbackStyle]
BusyCursor=true
TaskbarButton=false
