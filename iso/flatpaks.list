# =============================================================================
# MoOS live/preinstall Flatpak set — one Flathub ref per line.
# Consumed by the Titanoboa action (see .github/workflows/build-iso.yml).
# Flatpak/Flathub is the ONLY promoted app source in MoOS; the app store is
# Bazaar (MoOS App Center). Keep this list small: it inflates the ISO size.
# =============================================================================
org.mozilla.firefox
org.videolan.VLC
org.libreoffice.LibreOffice
io.github.kolunmi.Bazaar
org.kde.kcalc
