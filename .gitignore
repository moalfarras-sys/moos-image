# NEVER commit the cosign private key (public key cosign.pub IS committed)
cosign.key

# Build artifacts
*.iso
output/

# Mo Remote's .NET build output. The agent is COMPILED IN THE IMAGE (Containerfile
# stage `moremote-build`), so a local `dotnet build` leaves 4 MB of binaries in the
# tree that must never reach a commit — they would be stale the moment the source
# changed, and nothing in the image ever reads them.
moremote/agent-linux/bin/
moremote/agent-linux/obj/

# Local artwork tooling cache
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

# Local agent settings (Claude Code) — machine-local, never shipped
.claude/

# Controller dev deps — the SHIPPED UI is the built output in moremote/agent/wwwroot,
# which IS committed (MoRemoteLinux.csproj copies it into the image). These are not.
node_modules/
