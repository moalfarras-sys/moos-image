# NEVER commit the cosign private key (public key cosign.pub IS committed)
cosign.key

# Build artifacts
*.iso
output/

# Mo Remote's .NET build output. The agent is COMPILED IN THE IMAGE (Containerfile
# stage `moremote-build`), so a local `dotnet build` leaves 4 MB of binaries in the
# tree that must never reach a commit — they would be stale the moment the source
# changed, and nothing in the image ever reads them.
moremote/agent-linux/bin/
moremote/agent-linux/obj/

# Local artwork tooling cache
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

# Local agent settings (Claude Code) — machine-local, never shipped.
# EXCEPTION: .claude/skills/ is committed — it is a symlink into skills/, so the
# mandatory moos-engineering skill is auto-discovered by Claude Code sessions.
.claude/*
!.claude/skills/

# Local editor workspace settings — machine-local, never shipped
.vscode/

# Controller dev deps — the SHIPPED UI is the built output in moremote/agent/wwwroot,
# which IS committed (MoRemoteLinux.csproj copies it into the image). These are not.
node_modules/

# ── Not part of MoOS — keep the repo (and `git status`) about the OS ──────────
# Scaffolding dropped in by a local agent framework (openclaw); unrelated to the
# image. Ignored so none of it can be committed and `git status` stays clean.
# These files are left on disk (delete them yourself if you don't use that tool).
HEARTBEAT.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md
openclaw-workspace-state.json
memory/
# Voice notes and images the Telegram assistant staged locally. Private user
# content that has nothing to do with the image — never commit it.
media/

# Local test evidence: screenshots and live-run logs. Useful locally, not source.
test-results/

# Mo Remote local .NET publish output — regenerable; the image builds its own in
# the Containerfile `moremote-build` stage and never reads these bytes.
moremote/dist-linux/
