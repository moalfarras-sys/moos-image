# Finish and verify native input before the plugin's unchanged MD5 reader.
# file(DOWNLOAD) alone can return an error page/partial file without failing
# configuration. Both locations below must still produce the same SHA-256.
function(moos_verified_archive destination digest)
  if(IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Native archive destination is a symlink")
  endif()
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" existing_digest)
    if(existing_digest STREQUAL digest)
      return()
    endif()
  endif()
  set(temporary "${destination}.moos-download")
  if(EXISTS "${temporary}" OR IS_SYMLINK "${temporary}")
    message(FATAL_ERROR "Native archive has an unfinished download; preserve it for review")
  endif()
  foreach(url IN LISTS ARGN)
    file(DOWNLOAD "${url}" "${temporary}" STATUS transfer TLS_VERIFY ON
      TIMEOUT 30 INACTIVITY_TIMEOUT 15)
    list(GET transfer 0 transfer_exit)
    if(transfer_exit EQUAL 0)
      file(SHA256 "${temporary}" actual_digest)
      if(actual_digest STREQUAL digest)
        file(RENAME "${temporary}" "${destination}")
        message(STATUS "MoOS native archive verified: ${digest}")
        return()
      endif()
    endif()
    file(REMOVE "${temporary}")
    message(STATUS "Native archive transfer refused; trying the next upstream location")
  endforeach()
  message(FATAL_ERROR "Native archive unavailable or SHA-256 mismatch")
endfunction()
