+            or record.get("id") != package or record.get("package") != package:
+        return None
+    digest = record.get("sha256")
+    if not isinstance(digest, str) or not SHA256_RE.fullmatch(digest):
+        return None
+    source, catalog_id = record.get("source"), record.get("catalog_id")
+    if source == "catalog":
+        if catalog_id != package:
+            return None
+    elif source == "file":
+        if catalog_id != "":
