+def appdrop_record(slug: str) -> dict | None:
+    """The same schema/id/kind receipt App Drop accepts, never a linked receipt."""
+
+    if not DROP_SLUG_RE.fullmatch(slug):
+        return None
+    path = data_home() / "moos/appdrop" / f"{slug}.json"
+    if path.is_symlink() or not path.is_file():
+        return None
+    record = read_record(path)
+    return (record if record and record.get("schema") == 1 and record.get("id") == slug
+            and record.get("kind") in ("appimage", "archive") else None)
+
