+// SPDX-License-Identifier: LGPL-2.0-or-later
+import QtQuick
+
+Item {
+    id: root
+    visible: false
+    property bool available: false
+    property bool uiVisible: false
+    property bool passwordEmpty: true
+    property bool busy: false
+    property string username
+    property var claim: function(user) { return false; }
+    property bool ready: false
+    readonly property bool eligible: ready && available && uiVisible && passwordEmpty && !busy && username.length > 0
+    signal requested()
+
+    function schedule() {
+        attempt.stop();
+        if (eligible) attempt.start();
+    }
+    onEligibleChanged: schedule()
+    onUsernameChanged: schedule()
+    Component.onCompleted: { ready = true; schedule(); }
+    Timer {
+        id: attempt
+        interval: 150
+        repeat: false
+        onTriggered: {
+            if (root.eligible && root.claim(root.username) === true) root.requested();
+        }
+    }
+}
