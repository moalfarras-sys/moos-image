@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: LGPL-2.0-or-later
+#pragma once
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSet>
+#include <QString>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// Availability only. Authentication and account checks remain in native PAM.
+inline QSet<QString> moosFingerprintUsers(const QString &path = QStringLiteral("/run/moos-login/fingerprint-users.json"))
+{
+    const int fd = ::open(QFile::encodeName(path).constData(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) return {};
+    struct stat info{};
+    if (::fstat(fd, &info) || !S_ISREG(info.st_mode) || info.st_uid != 0 || (info.st_mode & 0022)
+        || info.st_size < 2 || info.st_size > 16384) {
+        ::close(fd);
+        return {};
+    }
+    QFile input;
+    if (!input.open(fd, QIODevice::ReadOnly, QFileDevice::AutoCloseHandle)) {
+        ::close(fd);
+        return {};
+    }
+    const auto object = QJsonDocument::fromJson(input.readAll()).object();
+    QFile boot(QStringLiteral("/proc/sys/kernel/random/boot_id"));
+    if (!boot.open(QIODevice::ReadOnly) || object.value(QStringLiteral("schema")).toInt() != 1
+        || object.value(QStringLiteral("boot_id")).toString().toUtf8() != boot.readAll().trimmed()
+        || !object.value(QStringLiteral("users")).isArray()) return {};
+    QSet<QString> users;
+    const auto array = object.value(QStringLiteral("users")).toArray();
+    if (array.size() > 32) return {};
+    for (const auto &entry : array) {
+        if (!entry.isString() || entry.toString().isEmpty() || entry.toString().size() > 256) return {};
+        users.insert(entry.toString());
+    }
+    return users;
+}
