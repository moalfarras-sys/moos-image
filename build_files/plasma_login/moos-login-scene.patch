@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: 2026 Moalfarras
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <KAuth/Action>
+#include <KConfig>
+#include <KConfigGroup>
+#include <QDir>
+#include <QFile>
+#include <QPair>
+#include <QTemporaryFile>
+#include <optional>
+
+// Leave time for the native administrator prompt. The default D-Bus25s
+// expires while the owner is authenticating; keep a finite five-minute bound.
+inline void moosLoginAppearanceTimeout(KAuth::Action &action)
+{
+    action.setTimeout(5 * 60 * 1000);
+}
+
+// Look-and-feel stores these selectors in kdedefaults while the user file
+// contains partial overrides. Preserve the native raw export, filling only
+// the two effective appearance selectors that would otherwise be omitted.
+inline std::optional<QString> moosLoginAppearanceSnapshot(const QString &contents, const QString &temporaryRoot = QDir::tempPath())
+{
+    QTemporaryFile temporary(temporaryRoot + QStringLiteral("/moos-login-appearance-XXXXXX"));
+    if (!temporary.open()) {
+        return std::nullopt;
+    }
+    const QByteArray original = contents.toUtf8();
+    if (temporary.write(original) != original.size() || !temporary.flush()) {
+        return std::nullopt;
+    }
+    KConfig effective(QStringLiteral("kdeglobals"), KConfig::NoGlobals);
+    KConfig exported(temporary.fileName(), KConfig::SimpleConfig);
+    const QPair<QString, QString> selectors[] = {
+        {QStringLiteral("General"), QStringLiteral("ColorScheme")},
+        {QStringLiteral("Icons"), QStringLiteral("Theme")},
+    };
+    for (const auto &selector : selectors) {
+        const QString value = KConfigGroup(&effective, selector.first).readEntry(selector.second, QString());
+        if (!value.isEmpty()) {
+            KConfigGroup(&exported, selector.first).writeEntry(selector.second, value);
+        }
+    }
+    if (!exported.sync()) {
+        return std::nullopt;
+    }
+    // KConfig writes atomically. Reopen its path rather than reading the old
+    // QTemporaryFile descriptor, which may refer to the replaced inode.
+    QFile result(temporary.fileName());
+    if (!result.open(QIODevice::ReadOnly)) {
+        return std::nullopt;
+    }
+    return QString::fromUtf8(result.readAll());
+}
