From 83d091dcb160d3f0c4a8bc9df8b8a9a934ac82a1 Mon Sep 17 00:00:00 2001
From: Vladimir Belyavsky <belyavskyv@gmail.com>
Date: Thu, 24 Sep 2026 12:06:00 +0300
Subject: [PATCH] QQuickItemView: don't leave dangling entries in unrequestedItems

Backport the production hunk from Qt upstream QTBUG-150769 to the exact
6.11.2-2 source. Preserve the vendor spec, other patches and native owners.
The upstream regression fixture is retained separately for mandatory native
old/fixed and packaged-library checks.

https://github.com/qt/qtdeclarative/commit/83d091dcb160d3f0c4a8bc9df8b8a9a934ac82a1
Fixes: QTBUG-150769
Change-Id: Ide32473f3fea373749197c969eaff6d13869c32d
Reviewed-by: Mitch Curtis <mitch.curtis@qt.io>
Reviewed-by: Richard Moe Gustavsen <richard.gustavsen@qt.io>
---
 src/quick/items/qquickitemview.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/quick/items/qquickitemview.cpp b/src/quick/items/qquickitemview.cpp
--- a/src/quick/items/qquickitemview.cpp
+++ b/src/quick/items/qquickitemview.cpp
@@ -2681,8 +2681,10 @@ bool QQuickItemViewPrivate::releaseItem(FxViewItem *item, QQmlInstanceModel::Reu
             }
         }
 
-        if (removeItemChangeListener)
+        if (removeItemChangeListener) {
+            unrequestedItems.remove(quickItem);
             QQuickItemPrivate::get(quickItem)->removeItemChangeListener(this, itemChangeListenerTypes);
+        }
 #if QT_CONFIG(quick_viewtransitions)
         delete item->transitionableItem;
         item->transitionableItem = nullptr;
