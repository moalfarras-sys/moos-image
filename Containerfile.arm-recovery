# =============================================================================
# MoOS ARM Recovery — slim UTM net-installer boot environment (NOT full desktop)
# =============================================================================
# Produces a small aarch64 bootc image used ONLY as installer.qcow2 inside
# MoOS-UTM-Installer. The full MoOS desktop is downloaded at install time from
# the signed ghcr.io/moalfarras-sys/moos-arm digest in arm-latest.json.
#
# BUILD (native arm64 or emulated — slow on x86):
#   podman build --platform linux/arm64 -f Containerfile.arm-recovery -t moos-arm-recovery .
#   bootc-image-builder --type qcow2 --build-dir /var/tmp/bib moos-arm-recovery
# =============================================================================

FROM quay.io/fedora/fedora-bootc:44 AS base

# Use the same pristine native base transaction as full ARM before the slim
# recovery package stage. Build helpers never enter the delivered runtime.
COPY build_files/plasma_stable/runtime_state.py /moos-arm-compose/
COPY build_files/prepare_arm_compose_base.py build_files/arm-runtime-rules.json \
     build_files/finalize_image_state.py build_files/finalize_canary_base.py \
     build_files/finalize_root_home.py /moos-arm-compose/
RUN python3 /moos-arm-compose/prepare_arm_compose_base.py \
    && ostree container commit \
    && rm -rf /moos-arm-compose

# Recovery boots the same splash engine as the desktop. Reuse the reviewed
# native producer and package admission so recovery carries the same fix.
FROM base AS plymouth-build
RUN dnf5 -y install --setopt=install_weak_deps=False gcc libasan rpm-build cpio patch \
    'dnf5-command(builddep)' python3 plymouth-core-libs
COPY build_files/build_plymouth_fix.sh build_files/plymouth_rpms.py /src/
COPY build_files/plymouth/frame-lifetime.patch /src/frame-lifetime.patch
COPY build_files/plymouth/frame-lifetime-native.c /src/frame-lifetime-native.c
COPY build_files/verify_plymouth_package.py /src/verify_plymouth_package.py
COPY scripts/review/plymouth-frame-lifetime.py /src/plymouth-frame-lifetime.py
RUN bash /src/build_plymouth_fix.sh
COPY build_files/plymouth/script-parser.c build_files/verify_plymouth_script.py /src/
COPY system_files/usr/share/plymouth/themes/moos/moos.script /src/moos.script
RUN python3 /src/verify_plymouth_script.py

FROM scratch AS ctx
COPY build_files /

FROM scratch AS system-files
COPY system_files /

FROM base
COPY --from=ctx /build-arm-recovery.sh /usr/libexec/moos-build-arm-recovery.sh
COPY --from=ctx /install_cosign_arm.sh /usr/libexec/moos-install-cosign-arm.sh
COPY --from=system-files / /
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=plymouth-build,source=/out,target=/plymouth-rpms \
    bash /usr/libexec/moos-build-arm-recovery.sh \
    && rm -f /usr/libexec/moos-build-arm-recovery.sh /usr/libexec/moos-install-cosign-arm.sh
